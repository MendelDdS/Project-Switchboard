[resource]
script = ExtResource("1_rule")
id = "b2_bloqueados"
title = "B2 · Números bloqueados"
severity = 2
fault_text = "FAULT_BLOCKED"
tests = Array[ExtResource("2_call")]([SubResource("Test_bloq"), SubResource("Test_bar"), SubResource("Test_urgente"), SubResource("Test_codigo"), SubResource("Test_semcodigo"), SubResource("Test_acordo"), SubResource("Test_sinal"), SubResource("Test_semsinal")])
blocked = PackedStringArray("355", "327", "399")
free_until = PackedStringArray("327 21:00")
code_frees = PackedStringArray("399")
