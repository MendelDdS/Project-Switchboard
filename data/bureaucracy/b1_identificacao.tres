[sub_resource type="Resource" id="Test_recado"]
resource_name = "Recado anônimo"
script = ExtResource("2_call")
voice = "w"
caller = "TESTE B1 (recado)"
opening = PackedStringArray("[TESTE] Não precisa ligar pra ninguém. Só quero deixar um recado pro Bar do Zé.", "[TESTE] Diz pra eles que a encomenda chega amanhã cedo.")
repeat = "[TESTE] Um recado pro Bar do Zé."
target = ""
destination = "Recado"
thanks = "[TESTE] Obrigado. Boa noite."
caller_name = "Teste Anônimo"
identify = 1
refuse_line = "[TESTE] Nome eu não dou. É só um recado."
refuse_again_line = "[TESTE] Já falei que não."
message = "[TESTE] A encomenda chega amanhã cedo."
message_to = "327"
message_reply = "[TESTE] Resposta ao recado da encomenda."
refused_line = "[TESTE] Que serviço é esse, que nem recado anota? Passar bem."

