[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="2_call"]

[sub_resource type="Resource" id="Test_sozinho"]
resource_name = "Diz o nome sozinho"
script = ExtResource("2_call")
voice = "f"
caller = "TESTE B1 (diz sozinha)"
opening = PackedStringArray("[TESTE] O Hotel Estrela, por favor.")
repeat = "[TESTE] O Hotel Estrela."
target = "305"
destination = "Hotel Estrela"
thanks = "[TESTE] Obrigada."
caller_name = "Teste Sozinha"
name_line = "[TESTE] Boa noite, aqui é Teste Sozinha."

