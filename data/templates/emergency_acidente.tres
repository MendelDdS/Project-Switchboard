[resource]
script = ExtResource("1_1y200")
opening = "Central, teve uma batida feia aqui na {street}!"
questions = PackedStringArray("Qual é o endereço?", "Tem feridos?", "A rua está bloqueada?")
answers = PackedStringArray("{address}, na esquina!", "O rapaz da moto. Tá no chão, mas mexe as pernas.", "Tá. A moto e o carro tão no meio da rua.")
occurrence = "Acidente de trânsito"
units = PackedStringArray("pol", "amb")
after = "Tá bom. Eu fico aqui esperando."
stage_sec = Vector3(45, 22, 22)
worsening = "Tá juntando gente em volta, os carros não passam mais!"
worsening_units = PackedStringArray("pol")
critical = "Tá saindo fumaça do motor do carro!"
critical_units = PackedStringArray("bomb")
lost = "O carro pegou fogo! Por que demorou tanto?!"
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2"), SubResource("Case_3"), SubResource("Case_4")])
