[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_tr1dg"]

[resource]
script = ExtResource("1_tr1dg")
opening = "Central! Tá pegando fogo numa casa aqui na {street}!"
questions = PackedStringArray("Qual é o endereço?", "Tem alguém dentro da casa?", "O fogo está grande?")
answers = PackedStringArray("{address}! Vem logo!", "Acho que não. Os vizinhos já saíram.", "Tá subindo pelo telhado!")
occurrence = "Incêndio"
units = PackedStringArray("bomb")
after = "Tá bom. A gente vai se afastar."
