[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_uweeg"]
[ext_resource type="Script" path="res://scripts/data/emergency_case.gd" id="2_case"]

[sub_resource type="Resource" id="Case_1"]
script = ExtResource("2_case")
units = PackedStringArray("pol")

[sub_resource type="Resource" id="Case_2"]
script = ExtResource("2_case")
answers = PackedStringArray("", "", "Um caiu e bateu a cabeça na guia! Tá sangrando!")
units = PackedStringArray("pol", "amb")

[resource]
script = ExtResource("1_uweeg")
opening = "Central, tem uma briga feia no meio da {street}!"
questions = PackedStringArray("Qual é o endereço?", "Alguém está armado?", "Alguém se machucou?")
answers = PackedStringArray("{address}! Dá pra ver daqui de casa!", "Um tá com um pedaço de pau!", "Ainda não, mas vai acabar mal!")
occurrence = "Outro"
units = PackedStringArray("pol")
after = "Tá. Vou entrar e trancar a porta."
stage_sec = Vector3(50, 20, 20)
worsening = "Chegou mais gente! Agora são uns dez!"
worsening_question = "Alguém está armado agora?"
worsening_answer = "Apareceu um com uma faca!"
critical = "Derrubaram um no chão e tão chutando! Ele não se mexe!"
critical_units = PackedStringArray("amb")
critical_question = "Ele está respirando?"
critical_answer = "Acho que sim... mas tá com o rosto todo machucado!"
lost = "Fugiram todos... e o rapaz continua no chão. Ninguém veio."
lost_answer = "O rapaz continua no chão, sangrando muito pela cabeça!"
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2")])
