[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_7hmqy"]

[resource]
script = ExtResource("1_7hmqy")
opening = "(baixinho) Central, tem alguém tentando abrir a porta dos fundos."
questions = PackedStringArray("Qual é o endereço?", "Tem mais alguém em casa?", "Você viu a pessoa?")
answers = PackedStringArray("{address}. Rápido, por favor.", "Não, só eu.", "Só a sombra pela janela.")
occurrence = "Invasão / roubo"
units = PackedStringArray("pol")
after = "Tá. Não vou fazer barulho."
