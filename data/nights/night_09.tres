[ext_resource type="Script" path="res://scripts/data/street_event.gd" id="2_event"]
[ext_resource type="Script" path="res://scripts/data/story_text.gd" id="x0_story_text"]
[ext_resource type="Script" path="res://scripts/data/story_call.gd" id="x1_story_call"]
[ext_resource type="Resource" path="res://data/calls/story_09_sebastiao.tres" id="x2_story_09_sebastiao"]
[ext_resource type="Resource" path="res://data/calls/story_09_policia_radio.tres" id="x3_story_09_policia_radio"]
[ext_resource type="Resource" path="res://data/calls/story_09_cupula_radio.tres" id="x4_story_09_cupula_radio"]
[ext_resource type="Resource" path="res://data/calls/story_09_cupula_radio_caiu.tres" id="x4c_story_09_cupula_radio_caiu"]
[ext_resource type="Resource" path="res://data/calls/story_09_policia_cancao.tres" id="x5_story_09_policia_cancao"]
[ext_resource type="Resource" path="res://data/calls/story_09_policia_cancao_caiu.tres" id="x5c_story_09_policia_cancao_caiu"]
[ext_resource type="Resource" path="res://data/calls/story_09_carro_fogo.tres" id="x0_story_09_carro_fogo"]
[ext_resource type="Resource" path="res://data/calls/story_09_baleado.tres" id="x1_story_09_baleado"]
[ext_resource type="Resource" path="res://data/calls/story_09_mae_atropelado.tres" id="x2_story_09_atropelada"]
[ext_resource type="Resource" path="res://data/calls/story_09_briga.tres" id="x3_story_09_briga"]
[ext_resource type="Resource" path="res://data/calls/noite_09_toque.tres" id="j_toque"]

[sub_resource type="Resource" id="ev_0"]
script = ExtResource("2_event")
kind = "lookout"
at = 60.0
every = 60.0

[sub_resource type="Resource" id="ev_1"]
script = ExtResource("2_event")
kind = "curfew"
at = 180.0

[sub_resource type="Resource" id="News_grupos"]
script = ExtResource("x0_story_text")
text = "Polícia ocupa a estação e a praça da Matriz\nDesde a madrugada, viaturas guardam a estação, a praça da Matriz e as saídas do Alto da Serra. A Alta Cúpula fala em \"prevenção\" e não dá detalhes."
requires = PackedStringArray("fita_grupos_entregue")
photo = "viatura"
caption = "A viatura na praça da Matriz."

[sub_resource type="Resource" id="News_comandante"]
script = ExtResource("x0_story_text")
text = "Cerco a armazém na Rua do Moinho\nA polícia cercou nesta madrugada um armazém da Rua do Moinho onde estaria escondido o chefe dos rebeldes. Houve tiros. A Alta Cúpula não confirma prisões."
requires = PackedStringArray("fita_comandante_entregue")
photo = "viatura"
caption = "A barreira na Rua do Moinho."

[sub_resource type="Resource" id="S_seb"]
script = ExtResource("x1_story_call")
at = 10.0
call = ExtResource("x2_story_09_sebastiao")
if_dropped = PackedStringArray("cumpriu_9")
again = false

[sub_resource type="Resource" id="S_aut0"]
script = ExtResource("x1_story_call")
at = 70.0
call = ExtResource("x3_story_09_policia_radio")
authority = true
if_connected = PackedStringArray("!cumpriu_9")
if_elsewhere = PackedStringArray("!cumpriu_9")
again = false

[sub_resource type="Resource" id="S_aut1"]
script = ExtResource("x1_story_call")
at = 245.0
call = ExtResource("x4_story_09_cupula_radio")
requires = PackedStringArray("!tomada_caiu")
authority = true
if_connected = PackedStringArray("!cumpriu_9")
if_elsewhere = PackedStringArray("!cumpriu_9")
again = false

[sub_resource type="Resource" id="S_aut1a"]
script = ExtResource("x1_story_call")
at = 245.0
call = ExtResource("x4c_story_09_cupula_radio_caiu")
requires = PackedStringArray("tomada_caiu")
authority = true
if_connected = PackedStringArray("!cumpriu_9")
if_elsewhere = PackedStringArray("!cumpriu_9")
again = false

[sub_resource type="Resource" id="S_aut2"]
script = ExtResource("x1_story_call")
at = 270.0
call = ExtResource("x5_story_09_policia_cancao")
requires = PackedStringArray("!tomada_caiu")
authority = true
if_connected = PackedStringArray("!cumpriu_9")
if_elsewhere = PackedStringArray("!cumpriu_9")
again = false

[sub_resource type="Resource" id="S_aut2a"]
script = ExtResource("x1_story_call")
at = 270.0
call = ExtResource("x5c_story_09_policia_cancao_caiu")
requires = PackedStringArray("tomada_caiu")
authority = true
if_connected = PackedStringArray("!cumpriu_9")
if_elsewhere = PackedStringArray("!cumpriu_9")
again = false

[sub_resource type="Resource" id="E_car"]
script = ExtResource("x1_story_call")
at = 50.0
call = ExtResource("x0_story_09_carro_fogo")
again = false

[sub_resource type="Resource" id="E_bal"]
script = ExtResource("x1_story_call")
at = 125.0
call = ExtResource("x1_story_09_baleado")
again = false

[sub_resource type="Resource" id="E_atr"]
script = ExtResource("x1_story_call")
at = 205.0
call = ExtResource("x2_story_09_atropelada")
again = false

[sub_resource type="Resource" id="E_bri"]
script = ExtResource("x1_story_call")
at = 290.0
call = ExtResource("x3_story_09_briga")
again = false

[sub_resource type="Resource" id="J_call_toque"]
script = ExtResource("x1_story_call")
call = ExtResource("j_toque")

[sub_resource type="Resource" id="T_0"]
script = ExtResource("dt_diary_task")
text = "Não passar a delegacia nem a Alta Cúpula"
requires = PackedStringArray("cumpriu_9")
done = PackedStringArray("cumpriu_9")
at_close = true

[sub_resource type="Resource" id="T_1"]
script = ExtResource("dt_diary_task")
text = "Passar as autoridades, como manda o supervisor"
requires = PackedStringArray("cumpriu_9")
done = PackedStringArray("!cumpriu_9")
at_close = true

[sub_resource type="Resource" id="N_0"]
script = ExtResource("dl_diary_line")
text = "O Sebastião: hoje nenhuma ligação pra delegacia ou pra Alta Cúpula pode passar pela mesa."
call = SubResource("S_seb")

[sub_resource type="Resource" id="N_1"]
script = ExtResource("dl_diary_line")
text = "A polícia pediu a delegacia. Passei."
call = SubResource("S_aut0")
outcomes = PackedStringArray("connected")

[sub_resource type="Resource" id="N_2"]
script = ExtResource("dl_diary_line")
text = "A polícia pediu a delegacia. Não passei."
call = SubResource("S_aut0")
outcomes = PackedStringArray("dropped", "elsewhere")

[sub_resource type="Resource" id="N_3"]
script = ExtResource("dl_diary_line")
text = "A polícia chamou, e eu deixei tocar."
call = SubResource("S_aut0")
outcomes = PackedStringArray("missed")

[sub_resource type="Resource" id="N_4"]
script = ExtResource("dl_diary_line")
text = "Briga na rua por causa da rádio. Uns gritavam viva, outros batiam."
call = SubResource("E_bri")

[sub_resource type="Resource" id="N_5"]
script = ExtResource("dl_diary_line")
text = "Fiz o que ele pediu. Espero que valha alguma coisa."
call = SubResource("S_seb")
requires = PackedStringArray("cumpriu_9")
at_close = true

[sub_resource type="Resource" id="N_6"]
script = ExtResource("dl_diary_line")
text = "Não fiz o que ele pediu. Não sei se quero ficar do lado deles."
call = SubResource("S_seb")
requires = PackedStringArray("!cumpriu_9")
at_close = true

[resource]
script = ExtResource("1_night")
note = "O supervisor deixou um recado: \"Com o toque de recolher, a noite promete: emergência vem primeiro.\""
street_events = Array[ExtResource("2_event")]([SubResource("ev_0"), SubResource("ev_1")])
news_if = Array[ExtResource("x0_story_text")]([SubResource("News_grupos"), SubResource("News_comandante")])
story = Array[ExtResource("x1_story_call")]([SubResource("S_seb"), SubResource("S_aut0"), SubResource("S_aut1"), SubResource("S_aut1a"), SubResource("S_aut2"), SubResource("S_aut2a"), SubResource("E_car"), SubResource("E_bal"), SubResource("E_atr"), SubResource("E_bri")])
news_stories = PackedStringArray("Toque de recolher às nove da noite\nA partir de hoje, ninguém fica na rua depois das 21h sem salvo-conduto, por ordem da Alta Cúpula. Bares e cinemas fecham às oito e meia. Quem for pego na rua responde na delegacia.")
calls = Array[ExtResource("x1_story_call")]([SubResource("J_call_toque")])
news_photo = "rua"
news_caption = "Rua do Centro às nove e cinco."
tasks = Array[ExtResource("dt_diary_task")]([SubResource("T_0"), SubResource("T_1")])
diary = Array[ExtResource("dl_diary_line")]([SubResource("N_0"), SubResource("N_1"), SubResource("N_2"), SubResource("N_3"), SubResource("N_4"), SubResource("N_5"), SubResource("N_6")])
