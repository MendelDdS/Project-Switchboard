[gd_resource type="Resource" script_class="Night" format=3]

[ext_resource type="Script" path="res://scripts/data/night.gd" id="1_night"]
[ext_resource type="Script" path="res://scripts/data/street_event.gd" id="2_event"]

[sub_resource type="Resource" id="ev_0"]
script = ExtResource("2_event")
kind = "curfew"
at = 180.0

[sub_resource type="Resource" id="ev_1"]
script = ExtResource("2_event")
kind = "moving"
at = 120.0

[sub_resource type="Resource" id="ev_2"]
script = ExtResource("2_event")
kind = "stone"
at = 300.0
requires = PackedStringArray("!chance_alta")

[sub_resource type="Resource" id="ev_3"]
script = ExtResource("2_event")
kind = "stranger"
at = 240.0

[resource]
script = ExtResource("1_night")
note = "O supervisor deixou um recado: \"Amanhã é sua última noite deste período. Capriche.\""
street_events = Array[ExtResource("2_event")]([SubResource("ev_0"), SubResource("ev_1"), SubResource("ev_2"), SubResource("ev_3")])
