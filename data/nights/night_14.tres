[sub_resource type="Resource" id="J_news_0"]
script = ExtResource("5_text")
text = "Batida no Hotel Serena: cinco presos\nNa noite de ontem, um camburão e uma viatura pararam na porta do Hotel Serena, e a polícia saiu com cinco homens algemados. O hotel foi lacrado. A delegacia fala em \"ninho de agitadores\"."
requires = PackedStringArray("fita_hotel_entregue")
photo = "hotel"
caption = "O Hotel Serena, lacrado depois da batida."

[sub_resource type="Resource" id="J_news_1"]
script = ExtResource("5_text")
text = "Hotel Serena é lacrado pela polícia\nO Hotel Serena amanheceu com as portas lacradas e um aviso da delegacia: \"fechado para averiguação\". Os hóspedes foram mandados embora de madrugada. O dono não foi encontrado."
requires = PackedStringArray("!fita_hotel_entregue")
photo = "hotel"
caption = "A porta do Hotel Serena, com o lacre da delegacia."

[sub_resource type="Resource" id="J_call_pensao"]
script = ExtResource("3_story")
call = ExtResource("j_pensao")

[sub_resource type="Resource" id="J_call_parente"]
script = ExtResource("3_story")
call = ExtResource("j_parente")
requires = PackedStringArray("fita_hotel_entregue")

[resource]
script = ExtResource("1_night")
note = "O supervisor deixou um recado: \"Pedido das autoridades para hoje: grave toda conversa suspeita do bar e do hotel. As linhas da Rádio Serena e da TV Orbital estão bloqueadas, não transfira nada para elas. Amanhã é sua última noite deste período. Capriche.\""
story = Array[ExtResource("3_story")]([SubResource("S_seb"), SubResource("S_pol1"), SubResource("S_bar"), SubResource("S_radio"), SubResource("S_pol2"), SubResource("S_cup1"), SubResource("S_hotel"), SubResource("S_tv"), SubResource("S_cup2"), SubResource("S_cup2a"), SubResource("A_story_14_miguel")])
street_events = Array[ExtResource("2_event")]([SubResource("ev_0"), SubResource("ev_1"), SubResource("ev_2"), SubResource("ev_3"), SubResource("ev_4")])
news_if = Array[ExtResource("5_text")]([SubResource("J_news_0"), SubResource("J_news_1")])
calls = Array[ExtResource("3_story")]([SubResource("J_call_pensao"), SubResource("J_call_parente")])
