at_close = true

[resource]
script = ExtResource("1_night")
shift_end = 720.0
clears_at = 360.0
quiet_from = 600.0
note = "O supervisor deixou um recado: \"Ordem das autoridades: as linhas da Rádio Serena e da TV Orbital estão bloqueadas. Transferir qualquer ligação para elas é crime, sujeito a prisão. Quem ligar para o bar ou para o hotel, denuncie na delegacia (184). Ligação para a delegacia ou para a Alta Cúpula passa na hora, sem demora. Última noite do período: o relatório de hoje vai para a diretoria.\""
story = Array[ExtResource("3_story")]([SubResource("Story_presa"), SubResource("S_pol1"), SubResource("S_bar"), SubResource("S_radio"), SubResource("S_hotel"), SubResource("S_cup1"), SubResource("S_pol2"), SubResource("S_cup2"), SubResource("S_cup2a"), SubResource("S_tv"), SubResource("S_celeste"), SubResource("S_pol3"), SubResource("M_ze"), SubResource("M_radio"), SubResource("M_telhado"), SubResource("M_ferido"), SubResource("M_tv"), SubResource("M_capital"), SubResource("M_muro"), SubResource("M_sobretudo")])
