[gd_resource type="Resource" script_class="Night" format=3]

[ext_resource type="Script" path="res://scripts/data/night.gd" id="1_night"]
[ext_resource type="Script" path="res://scripts/data/street_event.gd" id="2_event"]
[ext_resource type="Script" path="res://scripts/data/story_text.gd" id="x0_story_text"]
[ext_resource type="Script" path="res://scripts/data/story_call.gd" id="x1_story_call"]
[ext_resource type="Resource" path="res://data/calls/story_08_sebastiao.tres" id="x2_story_08_sebastiao"]
[ext_resource type="Resource" path="res://data/calls/story_08_sebastiao_volta.tres" id="x3_story_08_sebastiao_volta"]
[ext_resource type="Resource" path="res://data/calls/story_08_bar.tres" id="x4_story_08_bar"]
[ext_resource type="Resource" path="res://data/calls/story_08_bar_avisado.tres" id="x5_story_08_bar_avisado"]
[ext_resource type="Resource" path="res://data/calls/story_08_hotel_grupos.tres" id="x6_story_08_hotel_grupos"]
[ext_resource type="Resource" path="res://data/calls/story_08_hotel_grupos_armas.tres" id="x7a_story_08_hotel_grupos_armas"]
[ext_resource type="Resource" path="res://data/calls/story_08_hotel_grupos_avisado.tres" id="x7_story_08_hotel_grupos_avisado"]
[ext_resource type="Resource" path="res://data/calls/story_08_hotel_comandante.tres" id="x8_story_08_hotel_comandante"]
[ext_resource type="Resource" path="res://data/calls/story_08_hotel_comandante_avisado.tres" id="x9_story_08_hotel_comandante_avisado"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="x10_prank_step"]
[ext_resource type="Script" path="res://scripts/data/dial_call.gd" id="x11_dial_call"]

[sub_resource type="Resource" id="ev_0"]
script = ExtResource("2_event")
kind = "chase"
at = 80.0

[sub_resource type="Resource" id="News_armas"]
script = ExtResource("x0_story_text")
text = "Polícia apreende armas em armazém\nDoze caixas de armas foram encontradas nesta madrugada no fundo de um armazém do Alto da Serra, escondidas sob sacos de café. A polícia agradece a colaboração de cidadãos."
requires = PackedStringArray("fita_armas_entregue")

[sub_resource type="Resource" id="News_grupo_c"]
script = ExtResource("x0_story_text")
text = "Batida em porão termina com sete presos\nNa Rua das Acácias, a polícia surpreendeu uma reunião clandestina num porão. Os presos não tiveram os nomes divulgados. A família de um deles procura notícias desde a madrugada."
requires = PackedStringArray("fita_grupo_c_entregue")

[sub_resource type="Resource" id="S_seb"]
script = ExtResource("x1_story_call")
at = 20.0
call = ExtResource("x2_story_08_sebastiao")
if_dropped = PackedStringArray("sebastiao_hospital_8")
again = false

[sub_resource type="Resource" id="S_seb2"]
script = ExtResource("x1_story_call")
at = 260.0
call = ExtResource("x3_story_08_sebastiao_volta")
requires = PackedStringArray("sebastiao_hospital_8")
again = false

[sub_resource type="Resource" id="S_bar"]
script = ExtResource("x1_story_call")
at = 110.0
call = ExtResource("x4_story_08_bar")
requires = PackedStringArray("!avisou_bar_7")
if_delivered = PackedStringArray("fita_radio_entregue")
again = false

[sub_resource type="Resource" id="S_barw"]
script = ExtResource("x1_story_call")
at = 110.0
call = ExtResource("x5_story_08_bar_avisado")
requires = PackedStringArray("avisou_bar_7")
again = false

[sub_resource type="Resource" id="S_hot1"]
script = ExtResource("x1_story_call")
at = 200.0
call = ExtResource("x6_story_08_hotel_grupos")
requires = PackedStringArray("!avisou_hotel_8", "!fita_armas_entregue")
if_delivered = PackedStringArray("fita_grupos_entregue")
again = false

[sub_resource type="Resource" id="S_hot1a"]
script = ExtResource("x1_story_call")
at = 200.0
call = ExtResource("x7a_story_08_hotel_grupos_armas")
requires = PackedStringArray("!avisou_hotel_8", "fita_armas_entregue")
if_delivered = PackedStringArray("fita_grupos_entregue")
again = false

[sub_resource type="Resource" id="S_hot1w"]
script = ExtResource("x1_story_call")
at = 200.0
call = ExtResource("x7_story_08_hotel_grupos_avisado")
requires = PackedStringArray("avisou_hotel_8")
again = false

[sub_resource type="Resource" id="S_hot2"]
script = ExtResource("x1_story_call")
at = 300.0
call = ExtResource("x8_story_08_hotel_comandante")
requires = PackedStringArray("!avisou_hotel_8")
if_delivered = PackedStringArray("fita_comandante_entregue")
