[sub_resource type="Resource" id="S_hot2w"]
script = ExtResource("x1_story_call")
at = 300.0
call = ExtResource("x9_story_08_hotel_comandante_avisado")
requires = PackedStringArray("avisou_hotel_8")
again = false

[sub_resource type="Resource" id="D_joana_00"]
script = ExtResource("x10_prank_step")
text = "Hospital São Lucas, boa noite."

[sub_resource type="Resource" id="D_joana_01"]
script = ExtResource("x10_prank_step")
kind = 1
options = PackedStringArray("A Enfermeira Joana, por favor.", "Desculpe, foi engano.")
sets = PackedStringArray("joana_8", "")

[sub_resource type="Resource" id="D_joana_02"]
script = ExtResource("x10_prank_step")
text = "Um momento."
requires = PackedStringArray("joana_8")

[sub_resource type="Resource" id="D_joana_03"]
script = ExtResource("x10_prank_step")
kind = 2
seconds = 2.0
requires = PackedStringArray("joana_8")

[sub_resource type="Resource" id="D_joana_04"]
script = ExtResource("x10_prank_step")
text = "Joana falando."
requires = PackedStringArray("joana_8")

[sub_resource type="Resource" id="D_joana_05"]
script = ExtResource("x10_prank_step")
kind = 1
options = PackedStringArray("A ala 3C precisa de suprimentos.", "Desculpe, liguei errado.")
sets = PackedStringArray("hospital_8", "")
requires = PackedStringArray("joana_8")

[sub_resource type="Resource" id="D_joana_06"]
script = ExtResource("x10_prank_step")
text = "...Entendi. Diga a quem mandou que amanhã cedo chega tudo. Obrigada."
requires = PackedStringArray("hospital_8")

[sub_resource type="Resource" id="D_joana_07"]
script = ExtResource("x10_prank_step")
text = "Boa noite."
requires = PackedStringArray("!hospital_8")

[sub_resource type="Resource" id="D_joana_08"]
script = ExtResource("x10_prank_step")
kind = 3

[sub_resource type="Resource" id="D_joana"]
script = ExtResource("x11_dial_call")
number = "213"
from = 0.0
to = 359.0
requires = PackedStringArray("sebastiao_hospital_8")
voice = "f"
steps = Array[ExtResource("x10_prank_step")]([SubResource("D_joana_00"), SubResource("D_joana_01"), SubResource("D_joana_02"), SubResource("D_joana_03"), SubResource("D_joana_04"), SubResource("D_joana_05"), SubResource("D_joana_06"), SubResource("D_joana_07"), SubResource("D_joana_08")])

[sub_resource type="Resource" id="D_hotel_00"]
script = ExtResource("x10_prank_step")
text = "Hotel Serena, boa noite."

[sub_resource type="Resource" id="D_hotel_01"]
script = ExtResource("x10_prank_step")
kind = 1
options = PackedStringArray("Cuidado: a polícia está gravando as ligações para o hotel.", "Desculpe, foi engano.")
sets = PackedStringArray("avisou_hotel_8", "")

[sub_resource type="Resource" id="D_hotel_02"]
script = ExtResource("x10_prank_step")
kind = 2
seconds = 1.2
requires = PackedStringArray("avisou_hotel_8")

[sub_resource type="Resource" id="D_hotel_03"]
script = ExtResource("x10_prank_step")
text = "...Obrigado por avisar. A gente fala de outro jeito, então."
requires = PackedStringArray("avisou_hotel_8")

[sub_resource type="Resource" id="D_hotel_04"]
script = ExtResource("x10_prank_step")
text = "Boa noite."
requires = PackedStringArray("!avisou_hotel_8")

[sub_resource type="Resource" id="D_hotel_05"]
script = ExtResource("x10_prank_step")
kind = 3

[sub_resource type="Resource" id="D_hotel"]
script = ExtResource("x11_dial_call")
number = "305"
from = 0.0
to = 195.0
voice = "m"
steps = Array[ExtResource("x10_prank_step")]([SubResource("D_hotel_00"), SubResource("D_hotel_01"), SubResource("D_hotel_02"), SubResource("D_hotel_03"), SubResource("D_hotel_04"), SubResource("D_hotel_05")])

[resource]
script = ExtResource("1_night")
note = "O supervisor deixou um recado: \"Pedido da polícia: grave as ligações para o Bar do Zé e para o Hotel Serena e entregue as fitas a eles no fim do turno.\""
street_events = Array[ExtResource("2_event")]([SubResource("ev_0")])
news_if = Array[ExtResource("x0_story_text")]([SubResource("News_armas"), SubResource("News_grupo_c")])
story = Array[ExtResource("x1_story_call")]([SubResource("S_seb"), SubResource("S_seb2"), SubResource("S_bar"), SubResource("S_barw"), SubResource("S_hot1"), SubResource("S_hot1a"), SubResource("S_hot1w"), SubResource("S_hot2"), SubResource("S_hot2w")])
dial = Array[ExtResource("x11_dial_call")]([SubResource("D_joana"), SubResource("D_hotel")])
