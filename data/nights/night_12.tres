[gd_resource type="Resource" script_class="Night" format=3]

[ext_resource type="Script" path="res://scripts/data/story_text.gd" id="j_story_text"]
[ext_resource type="Script" path="res://scripts/data/diary_line.gd" id="dl_diary_line"]
[ext_resource type="Script" path="res://scripts/data/night.gd" id="1_night"]
[ext_resource type="Script" path="res://scripts/data/diary_task.gd" id="dt_diary_task"]
[ext_resource type="Script" path="res://scripts/data/street_event.gd" id="2_event"]
[ext_resource type="Script" path="res://scripts/data/story_call.gd" id="x0_story_call"]
[ext_resource type="Resource" path="res://data/calls/story_12_sebastiao.tres" id="x1_story_12_sebastiao"]
[ext_resource type="Resource" path="res://data/calls/story_12_cupula_telefonista.tres" id="x2_story_12_cupula_telefonista"]
[ext_resource type="Resource" path="res://data/calls/story_12_cupula_telefonista_denuncia.tres" id="x2d_story_12_cupula_telefonista_denuncia"]
[ext_resource type="Resource" path="res://data/calls/story_12_cupula_telefonista_homem.tres" id="x2h_story_12_cupula_telefonista_homem"]
[ext_resource type="Resource" path="res://data/calls/story_12_cupula_ronda.tres" id="x3_story_12_cupula_ronda"]
[ext_resource type="Resource" path="res://data/calls/story_12_supervisor.tres" id="x0_story_12_supervisor"]
[ext_resource type="Resource" path="res://data/calls/story_12_miguel.tres" id="a_story_12_miguel"]
[ext_resource type="Resource" path="res://data/calls/story_12_generosa_radio.tres" id="a_story_12_generosa_radio"]
[ext_resource type="Resource" path="res://data/calls/noite_12_recompensa.tres" id="j_recompensa"]
[ext_resource type="Resource" path="res://data/calls/noite_12_parente.tres" id="j_parente"]
[ext_resource type="Resource" path="res://data/calls/noite_12_doutor.tres" id="j_doutor"]

[sub_resource type="Resource" id="ev_0"]
script = ExtResource("2_event")
kind = "curfew"
at = 180.0

[sub_resource type="Resource" id="ev_1"]
script = ExtResource("2_event")
kind = "newsstand"
at = 20.0

[sub_resource type="Resource" id="S_seb"]
script = ExtResource("x0_story_call")
at = 15.0
call = ExtResource("x1_story_12_sebastiao")
if_dropped = PackedStringArray("sebastiao_pediu_fita_12")
again = false

[sub_resource type="Resource" id="S_cup1"]
script = ExtResource("x0_story_call")
at = 120.0
call = ExtResource("x2_story_12_cupula_telefonista")
requires = PackedStringArray("!denunciou_bar_4")
authority = true
if_sebastiao = PackedStringArray("fita_sebastiao_12")
again = false

[sub_resource type="Resource" id="S_cup1d"]
script = ExtResource("x0_story_call")
at = 120.0
call = ExtResource("x2d_story_12_cupula_telefonista_denuncia")
requires = PackedStringArray("denunciou_bar_4", "!denunciou_homem_4")
authority = true
if_sebastiao = PackedStringArray("fita_sebastiao_12")
again = false

[sub_resource type="Resource" id="S_cup1h"]
script = ExtResource("x0_story_call")
at = 120.0
call = ExtResource("x2h_story_12_cupula_telefonista_homem")
requires = PackedStringArray("denunciou_homem_4")
authority = true
if_sebastiao = PackedStringArray("fita_sebastiao_12")
again = false

[sub_resource type="Resource" id="S_cup2"]
script = ExtResource("x0_story_call")
at = 240.0
call = ExtResource("x3_story_12_cupula_ronda")
authority = true
if_sebastiao = PackedStringArray("fita_sebastiao_12")
again = false

[sub_resource type="Resource" id="S_sup"]
script = ExtResource("x0_story_call")
at = 5.0
call = ExtResource("x0_story_12_supervisor")
requires = PackedStringArray("cumpriu_9")
again = false
if_dropped = PackedStringArray("advertencia_cupula_12")
if_missed = PackedStringArray("advertencia_cupula_12")

[sub_resource type="Resource" id="A_story_12_miguel"]
script = ExtResource("x0_story_call")
at = 60.0
call = ExtResource("a_story_12_miguel")
if_hung_up = PackedStringArray("!miguel_amigo")
again = false

[sub_resource type="Resource" id="A_story_12_generosa_radio"]
script = ExtResource("x0_story_call")
at = 180.0
call = ExtResource("a_story_12_generosa_radio")
again = false

[sub_resource type="Resource" id="J_call_recompensa"]
script = ExtResource("x0_story_call")
call = ExtResource("j_recompensa")

[sub_resource type="Resource" id="J_call_parente"]
script = ExtResource("x0_story_call")
call = ExtResource("j_parente")

[sub_resource type="Resource" id="J_call_doutor"]
script = ExtResource("x0_story_call")
call = ExtResource("j_doutor")

[sub_resource type="Resource" id="T_0"]
script = ExtResource("dt_diary_task")
text = "Gravar a Alta Cúpula e dar as fitas ao Sebastião"
requires = PackedStringArray("sebastiao_pediu_fita_12")
done = PackedStringArray("fita_sebastiao_12")

[sub_resource type="Resource" id="N_0"]
script = ExtResource("dl_diary_line")
text = "O supervisor ligou: reclamação da Alta Cúpula pela noite nove. Vai ficar de olho em mim."
call = SubResource("S_sup")

[sub_resource type="Resource" id="N_1"]
script = ExtResource("dl_diary_line")
text = "O Sebastião: gravar a polícia com a Alta Cúpula e mandar as fitas pra ele, no pacote de carta."
call = SubResource("S_seb")

[sub_resource type="Resource" id="N_2"]
script = ExtResource("dl_diary_line")
text = "O Miguel está no São Lucas, de perna quebrada. Foi à praça escondido."
call = SubResource("A_story_12_miguel")

[sub_resource type="Resource" id="N_3"]
script = ExtResource("dl_diary_line")
text = "A Generosa ofereceu Luar da Serra pro Otávio, na rádio."
call = SubResource("A_story_12_generosa_radio")

[sub_resource type="Resource" id="N_4"]
script = ExtResource("dl_diary_line")
text = "Eles sabem que alguém nesta mesa ajuda. Esse alguém sou eu."
requires = PackedStringArray("sebastiao_pediu_fita_12")
at_close = true

[resource]
script = ExtResource("1_night")
note = "O supervisor deixou um recado: \"Não esqueça: tudo o que acontece vai para a ficha.\""
street_events = Array[ExtResource("2_event")]([SubResource("ev_0"), SubResource("ev_1")])
story = Array[ExtResource("x0_story_call")]([SubResource("S_seb"), SubResource("S_cup1"), SubResource("S_cup1d"), SubResource("S_cup1h"), SubResource("S_cup2"), SubResource("S_sup"), SubResource("A_story_12_miguel"), SubResource("A_story_12_generosa_radio")])
news_stories = PackedStringArray("Alta Cúpula oferece recompensa pelo chefe dos rebeldes\nQuem der notícia do paradeiro do homem que a polícia chama de \"o comandante\" recebe recompensa em dinheiro e proteção. A Alta Cúpula garante sigilo a quem colaborar.")
calls = Array[ExtResource("x0_story_call")]([SubResource("J_call_parente"), SubResource("J_call_doutor"), SubResource("J_call_recompensa")])
news_photo = "papeis"
news_caption = "Cartazes da recompensa na estação."
tasks = Array[ExtResource("dt_diary_task")]([SubResource("T_0")])
diary = Array[ExtResource("dl_diary_line")]([SubResource("N_0"), SubResource("N_1"), SubResource("N_2"), SubResource("N_3"), SubResource("N_4")])
