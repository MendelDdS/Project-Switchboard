[sub_resource type="Resource" id="Motive_25"]
script = ExtResource("97_motive")
text = "Preciso de um quarto pra esta noite."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Vocês ainda têm quarto pra hoje?", "Tenho um de solteiro, no andar de cima. Pra quantas noites?", "Só esta. Amanhã cedo eu sigo viagem.", "A diária é com café da manhã, paga na chegada.", "Pode segurar pra mim? Chego em {wait}.", "Seguro até as {hour}. Qual o nome, por favor?"), PackedStringArray("Boa noite. Perdi o último ônibus. Tem onde dormir aí hoje?", "Tem um quarto pequeno, perto da escada. É meio barulhento.", "Não faz mal, é só pra esta noite.", "Então pode vir. A porta fica aberta até as {hour}.", "Aceita pagar amanhã cedo? Hoje estou sem trocado.", "Aceito. Só deixa o documento comigo na chegada.")])

[sub_resource type="Resource" id="Motive_26"]
script = ExtResource("97_motive")
text = "Quero saber se ainda tem quarto vago pra amanhã."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Queria reservar um quarto pra amanhã. Ainda tem vago?", "Amanhã está quase cheio. Sobrou um de casal, nos fundos.", "Serve. São {nights}, a partir de amanhã.", "{nights}. Vou anotar aqui no livro.", "Chego no ônibus da tarde. Posso pagar quando chegar?", "Pode, sim. Só não passe das {hour}, que a portaria fecha."), PackedStringArray("Boa noite. Amanhã chega um parente meu de viagem. Tem quarto?", "Pra amanhã tem, sim. Quantas pessoas?", "Uma só. Fica {nights}.", "Fica no quarto da frente, com janela pra rua.", "Pode deixar no meu nome? Eu passo aí pra acertar.", "Deixo. Pode passar a qualquer hora pra acertar.")])

