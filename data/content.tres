[sub_resource type="Resource" id="Motive_49"]
script = ExtResource("97_motive")
text = "Meu pai está aí jogando e não volta pra casa."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Meu pai está aí? Um senhor de bigode, de camisa xadrez.", "Está, sim. Na mesa do fundo, ganhando de todo mundo.", "Fala pra ele que a mãe está esperando com a janta.", "Falo, mas ele disse que só sai depois da última partida.", "Diz que a janta já esfriou duas vezes.", "Esse recado eu dou. Aí ele vem rapidinho."), PackedStringArray("Boa noite. Meu pai está aí no bilhar?", "Está, sim. Jogando a dinheiro com uns rapazes.", "A dinheiro? Fala pra ele vir pra casa agora.", "Ele disse que só sai quando recuperar o que perdeu.", "Diz que a mãe está esperando acordada.", "Esse recado assusta mais. Vou falar.")])

[sub_resource type="Resource" id="Motive_50"]
script = ExtResource("97_motive")
text = "Quero deixar um recado pro meu irmão, que joga aí toda noite."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Meu irmão está aí? O magrinho, de óculos.", "Está aqui, esperando a vez dele na mesa.", "Avisa que a moto dele ficou com o farol aceso na frente de casa.", "O farol aceso? Vou falar agora, senão amanhã não pega.", "Isso. E diz que eu não vou lá apagar, não.", "Pode deixar, eu falo assim mesmo."), PackedStringArray("Boa noite. Meu irmão está aí? O de chapéu {color}.", "Está, na mesa do canto.", "Avisa que amanhã ele começa no serviço às {dawn}.", "Às {dawn}? Vou falar, mas ele não vai gostar.", "Diz que é ordem do patrão.", "Pode deixar. Falo agora mesmo.")])

