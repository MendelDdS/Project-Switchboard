emergencies = Array[ExtResource("2_l0sn3")]([ExtResource("3_v72nw"), ExtResource("4_brh46"), ExtResource("5_t6c0w"), ExtResource("6_cbrcj"), ExtResource("7_ks6ko"), ExtResource("8_ec5ew")])
pranks = Array[ExtResource("9_ev121")]([ExtResource("10_wfk0g"), ExtResource("11_pg478"), ExtResource("12_3mr8u"), ExtResource("13_4b6fe"), ExtResource("14_3w1w1")])
greetings = PackedStringArray("Central, boa noite.", "Central telefônica, pois não?", "Central, boa noite. Em que posso ajudar?", "Central, pois não?", "Central.")
smalltalk = PackedStringArray("Que chuva, hein? Não parou desde a tarde.", "Desculpe ligar tão tarde.", "A luz piscou aqui em casa agora há pouco. Aí também?", "O senhor passa a noite inteira aí sozinho?", "Essa linha está chiando, né?", "Minha mulher disse que não era pra incomodar a central a essa hora.", "O senhor não tem medo de ficar aí de noite?", "Meu marido já dormiu, mas eu não consigo pegar no sono.", "Ouvi dizer que o rio vai encher de novo.", "Faltou luz lá na Rua do Sol ontem, sabia?", "Essa central nunca dorme, né?", "Tem um barulho engraçado na linha hoje.", "Que frio, meu Deus.", "Tinha um carro parado na frente de casa, com o farol aceso. Já foi embora.")
waiting = PackedStringArray("Alô? Central?", "Ainda está aí?", "Alô? Conseguiu?", "Moço? A ligação caiu?", "Alô? Tô esperando...", "Demora muito?")
emergency_waiting = PackedStringArray("Alô?! Vocês vão mandar alguém?", "Por favor, rápido!", "Central?!")
hold_ok = PackedStringArray("Tá bom, eu espero.", "Obrigado, aguardo.", "Certo.", "Pode ser, eu fico na linha.", "Tá, mas rapidinho, tá?")
wrong_destination = PackedStringArray("Não, moço, não é aí.", "Hã? Não é com essa pessoa que eu quero falar.", "Esse não é quem eu pedi!", "Opa, acho que o senhor ligou errado.")
info_callers = PackedStringArray("f:Moradora", "m:Morador", "w:Senhor", "f:Senhora")
ask_number = PackedStringArray("Boa noite. Pode me dar o número %s?", "Central, o senhor sabe o número %s?", "Queria só o número %s, pra anotar aqui.", "Perdi a caderneta. Qual é o número %s?")
ask_time = PackedStringArray("Moço, que horas são? O relógio lá de casa parou.", "Desculpe incomodar. O senhor tem as horas certas?", "Central, que horas são agora? Faltou luz e o relógio apagou.")
info_thanks = PackedStringArray("Anotado. Obrigada, boa noite.", "Isso, obrigado.", "Ah, tá certo. Obrigado.", "Muito obrigada. Boa noite.")
info_doubt = PackedStringArray("Hum. Tem certeza? Bom... obrigado.", "Isso tudo? Tá bom, obrigado.", "Vou tentar esse então.")
