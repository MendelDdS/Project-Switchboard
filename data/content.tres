[sub_resource type="Resource" id="Reply_00_0"]
script = ExtResource("98_reply")
text = "Imagina, é pra isso que a central existe."
follow = "Ah, que bom. Eu fico sem jeito, sabe?"
tone = 1

[sub_resource type="Resource" id="Reply_00_1"]
script = ExtResource("98_reply")
text = "Tudo bem."
follow = "Ah... tá. Desculpe de novo."
tone = 2

[sub_resource type="Resource" id="Topic_00"]
script = ExtResource("99_chat")
unprompted_only = true
line = "Desculpe incomodar, o senhor deve estar cheio de ligação."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_00_0"), SubResource("Reply_00_1")])

[sub_resource type="Resource" id="Reply_01_0"]
script = ExtResource("98_reply")
text = "Eu e os cabos."
follow = "Hehe, pelo menos eles não reclamam, né?"
tone = 1

[sub_resource type="Resource" id="Reply_01_1"]
script = ExtResource("98_reply")
text = "Passo, sim."
follow = "Ah... tá. Não vou atrapalhar, então."
tone = 2

[sub_resource type="Resource" id="Topic_01"]
script = ExtResource("99_chat")
line = "O senhor passa a noite inteira aí sozinho?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_01_0"), SubResource("Reply_01_1")])

[sub_resource type="Resource" id="Reply_02_0"]
script = ExtResource("98_reply")
text = "Não incomoda, não."
follow = "Vou contar pra ela que o senhor disse isso."
tone = 1

[sub_resource type="Resource" id="Reply_02_1"]
script = ExtResource("98_reply")
text = "Ela tem razão."
follow = "Ah... tá certo. Desculpe."
tone = 2

[sub_resource type="Resource" id="Topic_02"]
script = ExtResource("99_chat")
voices = PackedStringArray("m", "w")
line = "Minha mulher disse que não era pra incomodar a central a essa hora."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_02_0"), SubResource("Reply_02_1")])

[sub_resource type="Resource" id="Reply_03_0"]
script = ExtResource("98_reply")
text = "Um chá de camomila ajuda."
follow = "Já tomei dois, moço. Nem fez cócegas."
tone = 1

[sub_resource type="Resource" id="Reply_03_1"]
script = ExtResource("98_reply")
text = "Hum."
follow = "Ah... tá. Eu espero aqui."
tone = 2

[sub_resource type="Resource" id="Topic_03"]
script = ExtResource("99_chat")
voices = PackedStringArray("f")
line = "Meu marido já dormiu, mas eu não consigo pegar no sono."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_03_0"), SubResource("Reply_03_1")])

[sub_resource type="Resource" id="Reply_04_0"]
script = ExtResource("98_reply")
text = "Cem anos! Que bênção."
follow = "Teve bolo na praça e banda. Ele dançou com a bisneta!"
tone = 1

[sub_resource type="Resource" id="Reply_04_1"]
script = ExtResource("98_reply")
text = "Que bom pra ele."
follow = "...É. E lúcido, viu? Melhor que eu."
tone = 2

[sub_resource type="Resource" id="Topic_04"]
script = ExtResource("99_chat")
line = "O seu Geraldo, da Rua da Matriz, fez cem anos hoje, sabia?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_04_0"), SubResource("Reply_04_1")])

[sub_resource type="Resource" id="Reply_05_0"]
script = ExtResource("98_reply")
text = "Nunca. Alguém tem que ficar acordado."
follow = "Ainda bem, viu? A gente se sente mais seguro."
tone = 1

[sub_resource type="Resource" id="Reply_05_1"]
script = ExtResource("98_reply")
text = "Pois é."
follow = "É... bom, eu espero."
tone = 2

[sub_resource type="Resource" id="Topic_05"]
script = ExtResource("99_chat")
line = "Essa central nunca dorme, né?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_05_0"), SubResource("Reply_05_1")])

[sub_resource type="Resource" id="Reply_06_0"]
script = ExtResource("98_reply")
text = "Pega um casaco."
follow = "Já tô com dois, moço!"
tone = 1

[sub_resource type="Resource" id="Reply_06_1"]
script = ExtResource("98_reply")
text = "Aham."
follow = "...Bom, deixa pra lá."
tone = 2

[sub_resource type="Resource" id="Topic_06"]
script = ExtResource("99_chat")
line = "Que frio, meu Deus."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_06_0"), SubResource("Reply_06_1")])

[sub_resource type="Resource" id="Reply_07_0"]
script = ExtResource("98_reply")
text = "É sim, amanhã cedo."
follow = "Vou ver se ainda tem aquele queijo da serra."
tone = 1

[sub_resource type="Resource" id="Reply_07_1"]
script = ExtResource("98_reply")
text = "Não sei."
follow = "Ah... tá. Eu vejo amanhã, então."
tone = 2

[sub_resource type="Resource" id="Topic_07"]
script = ExtResource("99_chat")
line = "Amanhã é dia de feira, né?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_07_0"), SubResource("Reply_07_1")])

[sub_resource type="Resource" id="Reply_08_0"]
script = ExtResource("98_reply")
text = "Digo, sim. O relógio da central é o certo da cidade."
follow = "Então eu acerto o meu pelo seu. Pronto, agora vai."
tone = 1

[sub_resource type="Resource" id="Reply_08_1"]
script = ExtResource("98_reply")
text = "Leva no relojoeiro."
follow = "Tá, tá. Vou levar amanhã."
tone = 2

[sub_resource type="Resource" id="Topic_08"]
script = ExtResource("99_chat")
line = "Meu relógio adiantou de novo. O senhor me diz a hora certa?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_08_0"), SubResource("Reply_08_1")])

[sub_resource type="Resource" id="Reply_09_0"]
script = ExtResource("98_reply")
text = "Nem eu, e olha que é meu trabalho."
follow = "Hehe, o senhor tem desculpa, eu não."
tone = 1

[sub_resource type="Resource" id="Reply_09_1"]
script = ExtResource("98_reply")
text = "Entendi."
follow = "...Desculpa, tá? Eu espero."
tone = 2

[sub_resource type="Resource" id="Topic_09"]
script = ExtResource("99_chat")
unprompted_only = true
line = "Desculpa ficar puxando conversa, é que eu não consigo dormir."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_09_0"), SubResource("Reply_09_1")])

[sub_resource type="Resource" id="Reply_10_0"]
script = ExtResource("98_reply")
text = "Eu lembro da sua voz."
follow = "Lembra? Que memória, hein!"
tone = 1

[sub_resource type="Resource" id="Reply_10_1"]
script = ExtResource("98_reply")
text = "Ah, é?"
follow = "É... faz tempo mesmo."
tone = 2

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("99_chat")
line = "Faz tempo que eu não ligo pra central."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_10_0"), SubResource("Reply_10_1")])

[sub_resource type="Resource" id="Reply_11_0"]
script = ExtResource("98_reply")
text = "Pra que horas?"
follow = "Agora é às sete. Cedo demais pra mim."
tone = 1

[sub_resource type="Resource" id="Reply_11_1"]
script = ExtResource("98_reply")
text = "Não vou à missa."
follow = "Ah... cada um com sua fé, né?"
tone = 2

[sub_resource type="Resource" id="Topic_11"]
script = ExtResource("99_chat")
line = "O padre mudou o horário da missa de domingo, viu?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_11_0"), SubResource("Reply_11_1")])

[sub_resource type="Resource" id="Reply_12_0"]
script = ExtResource("98_reply")
text = "De novo?"
follow = "Duas horas! Minha irmã chegou morta de cansaço."
tone = 1

[sub_resource type="Resource" id="Reply_12_1"]
script = ExtResource("98_reply")
text = "É sempre assim."
follow = "É... pois é."
tone = 2

[sub_resource type="Resource" id="Topic_12"]
script = ExtResource("99_chat")
line = "O ônibus da capital atrasou de novo hoje."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_12_0"), SubResource("Reply_12_1")])

[sub_resource type="Resource" id="Reply_13_0"]
script = ExtResource("98_reply")
text = "Que beleza! Parabéns!"
follow = "Ah, que orgulho! Vai ser o primeiro doutor da família."
tone = 1

[sub_resource type="Resource" id="Reply_13_1"]
script = ExtResource("98_reply")
text = "Hum, que bom."
follow = "...É. Ele se esforçou, viu?"
tone = 2

[sub_resource type="Resource" id="Topic_13"]
script = ExtResource("99_chat")
line = "Meu neto passou no vestibular, sabia?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_13_0"), SubResource("Reply_13_1")])

[sub_resource type="Resource" id="Reply_14_0"]
script = ExtResource("98_reply")
text = "De novo? Não acredito."
follow = "Vou ter que voltar a fazer pão em casa."
tone = 1

[sub_resource type="Resource" id="Reply_14_1"]
script = ExtResource("98_reply")
text = "Normal."
follow = "Normal pro senhor, né..."
tone = 2

[sub_resource type="Resource" id="Topic_14"]
script = ExtResource("99_chat")
line = "O preço do pão subiu de novo."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_14_0"), SubResource("Reply_14_1")])

[sub_resource type="Resource" id="Reply_15_0"]
script = ExtResource("98_reply")
text = "Pelo menos é festa, e não briga."
follow = "Isso é! E ela ainda me mandou um prato de salgadinho."
tone = 1

[sub_resource type="Resource" id="Reply_15_1"]
script = ExtResource("98_reply")
text = "Paciência."
follow = "Paciência eu tenho. Sono é que não."
tone = 2

[sub_resource type="Resource" id="Topic_15"]
script = ExtResource("99_chat")
line = "A vizinha tá dando festa de aniversário, a música vai até tarde."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_15_0"), SubResource("Reply_15_1")])

[sub_resource type="Resource" id="Reply_16_0"]
script = ExtResource("98_reply")
text = "Daqui eu ouço no telhado."
follow = "Aqui pinga até na cozinha."
tone = 1

[sub_resource type="Resource" id="Reply_16_1"]
script = ExtResource("98_reply")
text = "É chuva."
follow = "...É, né."
tone = 2

[sub_resource type="Resource" id="Topic_16"]
script = ExtResource("99_chat")
weather = "rain"
line = "Que chuva, hein? Não parou desde a tarde."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_16_0"), SubResource("Reply_16_1")])

[sub_resource type="Resource" id="Reply_17_0"]
script = ExtResource("98_reply")
text = "Tomara que não."
follow = "Da última vez a água chegou na praça."
tone = 1

[sub_resource type="Resource" id="Reply_17_1"]
script = ExtResource("98_reply")
text = "Boato."
follow = "Tomara que seja, moço."
tone = 2

[sub_resource type="Resource" id="Topic_17"]
script = ExtResource("99_chat")
weather = "rain"
line = "Ouvi dizer que o rio vai encher de novo."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_17_0"), SubResource("Reply_17_1")])

[sub_resource type="Resource" id="Reply_18_0"]
script = ExtResource("98_reply")
text = "Cuidado por aí."
follow = "Pode deixar, moço. Aqui é alto."
tone = 1

[sub_resource type="Resource" id="Reply_18_1"]
script = ExtResource("98_reply")
text = "Hum."
follow = "...Bom, aqui é alto, pelo menos."
tone = 2

[sub_resource type="Resource" id="Topic_18"]
script = ExtResource("99_chat")
weather = "rain"
line = "O rio subiu bastante com essa chuva."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_18_0"), SubResource("Reply_18_1")])

[sub_resource type="Resource" id="Reply_19_0"]
script = ExtResource("98_reply")
text = "Não sai de casa, hein."
follow = "Nem pensar, moço. Daqui não saio."
tone = 1

[sub_resource type="Resource" id="Reply_19_1"]
script = ExtResource("98_reply")
text = "Aqui também."
follow = "Ah... tá."
tone = 2

[sub_resource type="Resource" id="Topic_19"]
script = ExtResource("99_chat")
weather = "rain"
line = "Tá caindo um toró aqui, a rua virou rio."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_19_0"), SubResource("Reply_19_1")])

[sub_resource type="Resource" id="Reply_20_0"]
script = ExtResource("98_reply")
text = "Só quem precisa."
follow = "É, coitado de quem tá na estrada."
tone = 1

[sub_resource type="Resource" id="Reply_20_1"]
script = ExtResource("98_reply")
text = "Melhor assim."
follow = "É, noite de ficar debaixo das cobertas."
tone = 2

[sub_resource type="Resource" id="Topic_20"]
script = ExtResource("99_chat")
weather = "rain"
line = "Com essa chuva ninguém sai de casa, né?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_20_0"), SubResource("Reply_20_1")])

[sub_resource type="Resource" id="Reply_21_0"]
script = ExtResource("98_reply")
text = "Daqui também não vejo nada."
follow = "Parece algodão na janela."
tone = 1

[sub_resource type="Resource" id="Reply_21_1"]
script = ExtResource("98_reply")
text = "Fique em casa hoje."
follow = "Pode deixar, não ponho o pé lá fora."
tone = 2

[sub_resource type="Resource" id="Topic_21"]
script = ExtResource("99_chat")
weather = "fog"
line = "Que neblina, hein? Não dá pra ver o outro lado da rua."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_21_0"), SubResource("Reply_21_1")])

[sub_resource type="Resource" id="Reply_22_0"]
script = ExtResource("98_reply")
text = "Verdade, é perigoso."
follow = "Meu cunhado quase errou a entrada da cidade uma vez."
tone = 1

[sub_resource type="Resource" id="Reply_22_1"]
script = ExtResource("98_reply")
text = "Tomara que ninguém precise."
follow = "Deus queira."
tone = 2

[sub_resource type="Resource" id="Topic_22"]
script = ExtResource("99_chat")
weather = "fog"
line = "Com essa cerração, é melhor ninguém pegar a estrada."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_22_0"), SubResource("Reply_22_1")])

[sub_resource type="Resource" id="Reply_23_0"]
script = ExtResource("98_reply")
text = "Amanhã ela volta."
follow = "Hehe, tomara. Com a padaria e tudo."
tone = 1

[sub_resource type="Resource" id="Reply_23_1"]
script = ExtResource("98_reply")
text = "Exagero."
follow = "Hehe... é, talvez."
tone = 2

[sub_resource type="Resource" id="Topic_23"]
script = ExtResource("99_chat")
weather = "fog"
line = "Parece que a cidade sumiu na névoa hoje."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_23_0"), SubResource("Reply_23_1")])

[sub_resource type="Resource" id="Reply_24_0"]
script = ExtResource("98_reply")
text = "Tá bonita mesmo."
follow = "Fiquei um tempão na varanda olhando."
tone = 1

[sub_resource type="Resource" id="Reply_24_1"]
script = ExtResource("98_reply")
text = "Daqui eu só vejo a mesa."
follow = "Ah, coitado. Depois dá uma espiada na janela."
tone = 2

[sub_resource type="Resource" id="Topic_24"]
script = ExtResource("99_chat")
weather = "clear"
line = "Que noite bonita, hein? Dá pra ver todas as estrelas."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_24_0"), SubResource("Reply_24_1")])

[sub_resource type="Resource" id="Reply_25_0"]
script = ExtResource("98_reply")
text = "Lua cheia?"
follow = "Quase. Amanhã fica redondinha."
tone = 1

[sub_resource type="Resource" id="Reply_25_1"]
script = ExtResource("98_reply")
text = "Não reparei."
follow = "Ah... depois dá uma olhada."
tone = 2

[sub_resource type="Resource" id="Topic_25"]
script = ExtResource("99_chat")
weather = "clear"
line = "Tá uma lua bonita hoje."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_25_0"), SubResource("Reply_25_1")])

[sub_resource type="Resource" id="Reply_26_0"]
script = ExtResource("98_reply")
text = "Depois do calor de ontem..."
follow = "Nem me fale, ontem não dava nem pra dormir."
tone = 1

[sub_resource type="Resource" id="Reply_26_1"]
script = ExtResource("98_reply")
text = "Aproveite."
follow = "Tô aproveitando, com um cafezinho."
tone = 2

[sub_resource type="Resource" id="Topic_26"]
script = ExtResource("99_chat")
weather = "clear"
line = "Noite fresquinha, né? Até dá gosto de ficar na janela."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_26_0"), SubResource("Reply_26_1")])

[sub_resource type="Resource" id="Reply_27_0"]
script = ExtResource("98_reply")
text = "Não perco um capítulo."
follow = "Pois é! Aposto que amanhã descobrem quem é o pai da menina."
tone = 1

[sub_resource type="Resource" id="Reply_27_1"]
script = ExtResource("98_reply")
text = "Não tenho tempo pra novela."
follow = "Ah, é verdade, o senhor trabalha de noite..."
tone = 2

[sub_resource type="Resource" id="Topic_27"]
script = ExtResource("99_chat")
line = "A novela das oito tá boa demais. O senhor tem acompanhado?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_27_0"), SubResource("Reply_27_1")])

[sub_resource type="Resource" id="Reply_28_0"]
script = ExtResource("98_reply")
text = "Vi no jornal! Que jogão."
follow = "O goleiro pegou um pênalti no fim. O povo invadiu o campo de alegria."
tone = 1

[sub_resource type="Resource" id="Reply_28_1"]
script = ExtResource("98_reply")
text = "Não acompanho futebol."
follow = "Ah, então o senhor é dos poucos aqui."
tone = 2

[sub_resource type="Resource" id="Topic_28"]
script = ExtResource("99_chat")
voices = PackedStringArray("m", "w")
line = "O time da cidade ganhou domingo, viu? Três a um."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_28_0"), SubResource("Reply_28_1")])

[sub_resource type="Resource" id="Reply_29_0"]
script = ExtResource("98_reply")
text = "Que notícia boa! Parabéns."
follow = "Obrigada! O vestido tá sendo feito aqui em casa mesmo."
tone = 1

[sub_resource type="Resource" id="Reply_29_1"]
script = ExtResource("98_reply")
text = "Parabéns."
follow = "Obrigada... É, tem muita coisa pra arrumar ainda."
tone = 2

[sub_resource type="Resource" id="Topic_29"]
script = ExtResource("99_chat")
line = "Minha filha vai casar mês que vem."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_29_0"), SubResource("Reply_29_1")])

[sub_resource type="Resource" id="Reply_30_0"]
script = ExtResource("98_reply")
text = "Vi! Tem até elefante, é verdade?"
follow = "Tem um só, velhinho, coitado. Mas as crianças tão encantadas."
tone = 1

[sub_resource type="Resource" id="Reply_30_1"]
script = ExtResource("98_reply")
text = "Não vi, não."
follow = "É lá no campo perto da estação. Tá uma festa."
tone = 2

[sub_resource type="Resource" id="Topic_30"]
script = ExtResource("99_chat")
line = "O circo chegou na cidade. O senhor viu o cartaz?"
replies = Array[ExtResource("98_reply")]([SubResource("Reply_30_0"), SubResource("Reply_30_1")])

[sub_resource type="Resource" id="Reply_31_0"]
script = ExtResource("98_reply")
text = "Deve ser puxado pra vocês dois."
follow = "É, mas a gente se acostuma. Ele chega de manhã com o pão."
tone = 1

[sub_resource type="Resource" id="Reply_31_1"]
script = ExtResource("98_reply")
text = "Entendo."
follow = "Pois é... a casa fica quieta demais."
tone = 2

[sub_resource type="Resource" id="Topic_31"]
script = ExtResource("99_chat")
voices = PackedStringArray("f")
line = "Meu marido tá de plantão no hospital, por isso eu fico acordada até tarde."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_31_0"), SubResource("Reply_31_1")])

[sub_resource type="Resource" id="Reply_32_0"]
script = ExtResource("98_reply")
text = "Que delícia. Deu até fome aqui."
follow = "Se desse, eu mandava um pedaço pela linha!"
tone = 1

[sub_resource type="Resource" id="Reply_32_1"]
script = ExtResource("98_reply")
text = "Hum."
follow = "Tá quase pronto... o cheiro já tomou a casa toda."
tone = 2

[sub_resource type="Resource" id="Topic_32"]
script = ExtResource("99_chat")
line = "Tô com um bolo de fubá no forno enquanto espero."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_32_0"), SubResource("Reply_32_1")])

[sub_resource type="Resource" id="Reply_33_0"]
script = ExtResource("98_reply")
text = "Que bom! E ele está bem?"
follow = "Tá ótimo! E diz que vem pro Natal."
tone = 1

[sub_resource type="Resource" id="Reply_33_1"]
script = ExtResource("98_reply")
text = "Que bom."
follow = "É... ele escreve pouco, mas escreve."
tone = 2

[sub_resource type="Resource" id="Topic_33"]
script = ExtResource("99_chat")
line = "Chegou carta do meu irmão hoje, depois de dois anos. Tô tão contente que precisava contar pra alguém."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_33_0"), SubResource("Reply_33_1")])

[sub_resource type="Resource" id="Reply_34_0"]
script = ExtResource("98_reply")
text = "Que bom. Essa cidade tem muita fé."
follow = "Tem! O padre Anselmo até pediu mais bancos pra prefeitura."
tone = 1

[sub_resource type="Resource" id="Reply_34_1"]
script = ExtResource("98_reply")
text = "Hum."
follow = "Tava bonita, mas comprida que só."
tone = 2

[sub_resource type="Resource" id="Topic_34"]
script = ExtResource("99_chat")
line = "Acabei de chegar da novena. A igreja tava cheia."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_34_0"), SubResource("Reply_34_1")])

[sub_resource type="Resource" id="Reply_35_0"]
script = ExtResource("98_reply")
text = "Vai dar tudo certo."
follow = "Deus queira. É só exame, mas ela tá nervosa, e eu mais ainda."
tone = 1

[sub_resource type="Resource" id="Reply_35_1"]
script = ExtResource("98_reply")
text = "Boa viagem."
follow = "Obrigada. A estrada é longa, mas a gente vai."
tone = 2

[sub_resource type="Resource" id="Topic_35"]
script = ExtResource("99_chat")
line = "Amanhã cedo eu levo minha mãe no médico, na capital. Nem sei se vou conseguir dormir."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_35_0"), SubResource("Reply_35_1")])

[sub_resource type="Resource" id="Reply_36_0"]
script = ExtResource("98_reply")
text = "Quem sabe dessa vez sai."
follow = "Deus te ouça! Toda eleição é a mesma promessa."
tone = 1

[sub_resource type="Resource" id="Reply_36_1"]
script = ExtResource("98_reply")
text = "Promessa é promessa."
follow = "Pois é, e buraco é buraco."
tone = 2

[sub_resource type="Resource" id="Topic_36"]
script = ExtResource("99_chat")
line = "A prefeitura prometeu calçar a minha rua de novo."
replies = Array[ExtResource("98_reply")]([SubResource("Reply_36_0"), SubResource("Reply_36_1")])

[sub_resource type="Resource" id="Reply_37_0"]
script = ExtResource("98_reply")
text = "Que bonito! Já fez alguma peça?"
follow = "Um paninho de bandeja. Torto, mas é meu."
tone = 1

[sub_resource type="Resource" id="Reply_37_1"]
script = ExtResource("98_reply")
text = "Hum."
follow = "É um passatempo. A noite fica mais curta."
tone = 2

[sub_resource type="Resource" id="Topic_37"]
