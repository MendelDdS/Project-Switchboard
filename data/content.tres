[sub_resource type="Resource" id="ChatTopic_26"]
script = ExtResource("99_chat")
weather = "clear"
line = "Tá uma lua bonita hoje."
replies = PackedStringArray("Lua cheia?", "Vi pela janela.")
follow = PackedStringArray("Quase. Amanhã fica redondinha.", "Bonita, né? Parece que tá mais perto.")

[sub_resource type="Resource" id="ChatTopic_27"]
