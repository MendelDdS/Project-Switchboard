greetings = PackedStringArray("Central, boa noite.", "Central telefônica, pois não?", "Central, boa noite. Em que posso ajudar?", "Central, pois não?", "Central.", "Central telefônica, boa noite.", "Central de São Sotero, pois não?")
smalltalk = PackedStringArray("Desculpe ligar tão tarde.", "A luz piscou aqui em casa agora há pouco. Aí também?", "O senhor passa a noite inteira aí sozinho?", "Essa linha está chiando, né?", "Minha mulher disse que não era pra incomodar a central a essa hora.", "O senhor não tem medo de ficar aí de noite?", "Meu marido já dormiu, mas eu não consigo pegar no sono.", "Faltou luz lá na Rua do Sol ontem, sabia?", "Essa central nunca dorme, né?", "Tem um barulho engraçado na linha hoje.", "Que frio, meu Deus.", "Tinha um carro parado na frente de casa, com o farol aceso. Já foi embora.", "O cachorro não para de latir hoje.", "Amanhã é dia de feira, né?", "Meu relógio adiantou de novo.", "Desculpa, é que eu não consigo dormir.", "Faz tempo que eu não ligo pra central.")
smalltalk_rain = PackedStringArray("Que chuva, hein? Não parou desde a tarde.", "Ouvi dizer que o rio vai encher de novo.", "O rio subiu bastante com essa chuva.", "Tá caindo um toró aqui, a rua virou rio.", "Com essa chuva ninguém sai de casa, né?")
smalltalk_fog = PackedStringArray("Que neblina, hein? Não dá pra ver o outro lado da rua.", "Com essa cerração, é melhor ninguém pegar a estrada.", "Parece que a cidade sumiu na névoa hoje.")
smalltalk_clear = PackedStringArray("Que noite bonita, hein? Dá pra ver todas as estrelas.", "Tá uma lua bonita hoje.", "Noite fresquinha, né? Até dá gosto de ficar na janela.")
waiting = PackedStringArray("Alô? Central?", "Ainda está aí?", "Alô? Conseguiu?", "Moço? A ligação caiu?", "Alô? Tô esperando...", "Demora muito?", "Central? Tá me ouvindo?", "Ainda tô aqui, viu?", "Alô? Caiu?")
emergency_waiting = PackedStringArray("Alô?! Vocês vão mandar alguém?", "Por favor, rápido!", "Central?!", "Alô! Tá demorando!", "Central, ainda tá aí?", "Manda alguém, pelo amor de Deus!")
