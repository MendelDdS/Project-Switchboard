[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_emerg"]
[ext_resource type="Script" path="res://scripts/data/emergency_case.gd" id="2_case"]

[sub_resource type="Resource" id="Case_1"]
script = ExtResource("2_case")
units = PackedStringArray("bomb")

[sub_resource type="Resource" id="Case_2"]
script = ExtResource("2_case")
answers = PackedStringArray("", "", "O patrão tentou tirar o cavalo e se queimou todo nos braços!")
units = PackedStringArray("bomb", "amb")

[resource]
script = ExtResource("1_emerg")
voice = "m"
caller = "Caseiro"
opening = "Central! O paiol do sítio tá pegando fogo! O vento tá levando pro pasto!"
questions = PackedStringArray("Qual é o endereço?", "Tem alguém dentro?", "Alguém se machucou?")
answers = PackedStringArray("Rua do Cruzeiro, 260! O Sítio Boa Esperança, no fim da rua!", "Não, só o milho e as ferramentas.", "Não. Tô jogando água com o balde.")
street = "cruzeiro"
block = 2
address = "Rua do Cruzeiro, 260"
occurrence = "Incêndio"
units = PackedStringArray("bomb")
after = "Tá. Vou soltar os bichos do curral."
stage_sec = Vector3(35, 18, 18)
worsening = "O fogo pegou no pasto e tá indo pra casa!"
worsening_units = PackedStringArray()
worsening_question = "Tem gente na casa?"
worsening_answer = "A patroa e as duas meninas. Já mandei sair."
critical = "A menina menor voltou pra buscar o cachorro e não saiu!"
critical_units = PackedStringArray("amb")
critical_question = "Onde ela está?"
critical_answer = "No quarto dos fundos! A fumaça tá saindo pela janela!"
lost = "A casa queimou... a gente perdeu tudo. Ninguém subiu a serra."
lost_answer = "Eu tirei a menina pela janela, mas ela tá tossindo sem parar e com o braço queimado."
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2")])
