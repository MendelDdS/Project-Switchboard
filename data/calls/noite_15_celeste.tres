thanks = "Obrigada, moça."
overheard = PackedStringArray("Nair? Tá ouvindo?", "Tô. Abri a janela, como eu disse.", "A rua inteira abriu. Tem gente cantando na calçada.", "O papai ia cantar alto, dessa vez.", "Ia. Alto mesmo.")
