[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
group = 1
voice = "m"
caller = "Seu Raimundo"
caller_name = "Raimundo Teles"
opening = PackedStringArray("Moça, sou eu de novo. O pai do José, o do baile.", "A ligação caiu antes de eu falar com a delegacia. Me liga de novo, por favor?")
repeat = "A delegacia do Centro."
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigado, moça."
overheard = PackedStringArray("Boa noite. O meu filho, José Teles, está aí desde o baile. Liguei mais cedo e caiu.", "José Teles... Está sendo ouvido. Sai quando acabar.", "Acabar o quê? Ninguém me diz nada!", "Volte amanhã, senhor. De dia.", "Ele tem dezessete anos!", "Boa noite, senhor. Não insista.")
