[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_axf2e"]

[resource]
script = ExtResource("1_axf2e")
group = 1
caller = "Dona Elza"
caller_name = "Elza Machado"
opening = PackedStringArray("Preciso falar com o Doutor Almeida.", "O médico. A pressão do meu marido subiu e ele mandou ligar se isso acontecesse.")
repeat = "O Doutor Almeida, o médico."
target = "214"
destination = "Dr. Augusto Almeida"
thanks = "Obrigada. Rápido, viu?"
overheard = PackedStringArray("Doutor, é a Elza. A pressão do meu marido subiu.", "Quanto deu?", "Dezessete por dez. Ele está com dor de cabeça.", "Dá o comprimido de baixo da língua que eu deixei.", "E se não baixar?", "Mede de novo em meia hora e me liga. Eu vou aí.")
