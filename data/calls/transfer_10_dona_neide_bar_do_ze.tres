[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_45pmb"]

[resource]
script = ExtResource("1_45pmb")
caller = "Dona Neide"
caller_name = "Neide Mattos"
opening = PackedStringArray("Me liga com o Bar do Zé.", "Meu marido disse que ia ficar só uma hora. Já faz três.")
repeat = "O Bar do Zé! Na Rua da Estação."
target = "327"
destination = "Bar do Zé"
thanks = "Ah, ele vai ver só."
overheard = PackedStringArray("Zé, é a Neide. O meu marido ainda está aí?", "Está, Dona Neide. No dominó, com os amigos.", "Ele disse uma hora. Já faz três!", "Quer que eu chame ele no telefone?", "Não precisa. Fala que a janta está no fogão, fria.", "Falo, sim. E fecho a conta dele agora mesmo.")
