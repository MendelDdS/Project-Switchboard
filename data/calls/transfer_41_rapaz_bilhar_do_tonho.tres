[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_tr"]

[resource]
script = ExtResource("1_tr")
group = 2
voice = "m"
caller = "Rapaz"
caller_name = "Mário Gomes"
opening = PackedStringArray("Ô, central. Me liga com o Bilhar do Tonho?", "Esqueci meu chapéu lá e minha mãe vai brigar comigo.")
repeat = "O bilhar do Tonho, na Rua do Comércio."
target = "355"
destination = "Bilhar do Tonho"
thanks = "Valeu! A senhora é das boas."
overheard = PackedStringArray("Tonho? Esqueci meu chapéu aí.", "Um de palha, com fita preta?", "Esse! Era do meu avô. Minha mãe vai me matar.", "Está pendurado atrás do balcão. Vem buscar amanhã.", "Não dá pra ser hoje? Por favor.", "Vem rápido, que eu fecho às onze.")
