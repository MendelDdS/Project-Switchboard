[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Maria! É o Miguel!"
requires = PackedStringArray("miguel_maria")

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
text = "Moça da central! É o Miguel!"
requires = PackedStringArray("!miguel_maria")

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
text = "O meu irmão saiu ontem de noite e ainda não voltou. Ele ligou aí? Ele disse que, quando acabasse, ligava."
requires = PackedStringArray("final_sucesso", "!fita_grupo_c_entregue")

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
text = "Disseram no rádio que soltaram todo mundo da cadeia hoje cedo. A mãe foi buscar o meu irmão. Ele ligou aí?"
requires = PackedStringArray("final_sucesso", "fita_grupo_c_entregue")

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
text = "O meu irmão saiu ontem de noite e não voltou. Ele ligou aí?"
requires = PackedStringArray("final_fracasso")

[sub_resource type="Resource" id="Step_05"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Ainda não. Mas vai ligar.", "Não ligou, Miguel.")
requires = PackedStringArray("final_sucesso")

[sub_resource type="Resource" id="Step_06"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Não, Miguel. Ninguém ligou.", "[Ficar em silêncio]")
requires = PackedStringArray("final_fracasso")

[sub_resource type="Resource" id="Step_07"]
script = ExtResource("2_step")
text = "A rádio disse que acabou, que agora pode tudo. Então ele vai ligar, né?"
requires = PackedStringArray("final_sucesso", "!fita_grupo_c_entregue")

[sub_resource type="Resource" id="Step_08"]
script = ExtResource("2_step")
text = "Ó! Bateram na porta! Deve ser ele!"
requires = PackedStringArray("final_sucesso", "!fita_grupo_c_entregue")

[sub_resource type="Resource" id="Step_09"]
script = ExtResource("2_step")
text = "Quando ele chegar, eu mando ele ligar pra você agradecer!"
requires = PackedStringArray("final_sucesso", "fita_grupo_c_entregue")

[sub_resource type="Resource" id="Step_10"]
script = ExtResource("2_step")
text = "E não esquece do gesso! Amanhã de manhã, no São Lucas!"
requires = PackedStringArray("final_sucesso", "miguel_gesso")

[sub_resource type="Resource" id="Step_11"]
script = ExtResource("2_step")
text = "Tchau!"
requires = PackedStringArray("final_sucesso")

[sub_resource type="Resource" id="Step_12"]
script = ExtResource("2_step")
text = "A rádio só fala que acabou a baderna. A mãe não sai da janela."
requires = PackedStringArray("final_fracasso")

[sub_resource type="Resource" id="Step_13"]
script = ExtResource("2_step")
text = "Se ele ligar, você me avisa? Eu fico aqui do lado do telefone."
requires = PackedStringArray("final_fracasso")

[sub_resource type="Resource" id="Step_14"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "k"
caller = "Menino"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04"), SubResource("Step_05"), SubResource("Step_06"), SubResource("Step_07"), SubResource("Step_08"), SubResource("Step_09"), SubResource("Step_10"), SubResource("Step_11"), SubResource("Step_12"), SubResource("Step_13"), SubResource("Step_14")])
