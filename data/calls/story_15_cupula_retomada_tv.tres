[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
group = 2
voice = "m"
caller = "Assessor"
opening = PackedStringArray("A delegacia de novo! Depressa!")
repeat = "A delegacia! Anda, moça!"
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigado."
overheard = PackedStringArray("Valadares de novo. E a rádio?", "Não passamos da barricada. Perdi mais [number:três].", "Então esquece a rádio. Pega a [place:TV Orbital], pela [street:Rua da Matriz].", "Com o quê? Não tenho mais gente.", "Solta os presos comuns e dá uma arma pra cada um. É uma ordem.")
caller_name = "Henrique Valadares"
name_line = "Henrique Valadares, da residência oficial."
code_line = "Autorização {code}."
