[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_em"]

[resource]
script = ExtResource("1_em")
voice = "f"
caller = "Senhora"
opening = "Central! Caiu uma coisa do céu no telhado da vizinha! Tá pegando fogo e ela tá lá dentro!"
