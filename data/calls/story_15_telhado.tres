worsening = "Caiu um pedaço do telhado! Ela parou de gritar!"
worsening_question = "Ela ainda responde?"
worsening_answer = "Bate na porta! Fraquinho, mas bate!"
critical = "A fumaça tá saindo pela janela toda! Pelo amor de Deus!"
critical_units = PackedStringArray("bomb")
critical_question = "Tem alguém tentando entrar?"
critical_answer = "Os vizinhos, com pano molhado na cara!"
lost = "Desabou. O telhado todo desabou."
