[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
voice = "f"
caller = "Dona Glória"
caller_name = "Glória Fontes"
opening = PackedStringArray("Boa noite. A delegacia, por favor.", "Meu marido estava no porão da Rua das Acácias. Saiu no jornal.")
repeat = "A delegacia, moça. É sobre os sete presos."
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigada, moça. Ninguém me diz nada."
overheard = PackedStringArray("Boa noite. O meu marido, Renato Fontes, é um dos sete do porão.", "A senhora é parente? Os nomes não serão divulgados.", "Eu não quero o nome no jornal. Quero saber se ele está vivo.", "Os presos estão sendo ouvidos. Estão bem.", "Posso levar um cobertor? Uma comida?", "Não. E não ligue mais pra cá, senhora.")
