[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Central 3. Aqui fala a Alta Cúpula."

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
kind = 2
seconds = 1.0

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
text = "Temos as gravações desta mesa. Da noite sete em diante."

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
text = "Inclusive das ligações que foram derrubadas daí, nas duas últimas noites."

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Eu só cumpri o meu turno.", "[Ficar em silêncio]")

[sub_resource type="Resource" id="Step_05"]
script = ExtResource("2_step")
kind = 2
seconds = 1.4

[sub_resource type="Resource" id="Step_06"]
script = ExtResource("2_step")
text = "Permaneça no posto. Ninguém sai da central esta noite."

[sub_resource type="Resource" id="Step_07"]
script = ExtResource("2_step")
text = "Já tem gente nossa a caminho."

[sub_resource type="Resource" id="Step_08"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "m"
caller = "Alta Cúpula"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04"), SubResource("Step_05"), SubResource("Step_06"), SubResource("Step_07"), SubResource("Step_08")])
