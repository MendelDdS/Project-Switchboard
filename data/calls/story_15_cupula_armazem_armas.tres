[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
group = 2
voice = "m"
caller = "Investigador"
opening = PackedStringArray("A Alta Cúpula, por favor. É urgente.")
repeat = "A Alta Cúpula."
target = "296"
destination = "Alta Cúpula"
thanks = "Obrigado."
overheard = PackedStringArray("Vilela falando. Achamos a casa do Ferreira.", "Onde?", "Na [street:Rua da Estação]. Mas chegamos tarde: saíram pela [street:Rua do Moinho].", "Pra onde?", "Pro Centro, pela [street:Rua Tiradentes]. Mandem tudo o que tiverem pra lá.", "Vamos fechar a Tiradentes nas duas pontas.")
caller_name = "Nestor Vilela"
name_line = "Nestor Vilela, da investigação."
code_line = "Autorização {code}."
