[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Telefonista? É o Zé, do bar. Fala baixo."

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
text = "A rádio e a TV ainda são nossas, mas a Cúpula não largou o osso. Tão brigando rua por rua."

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
text = "O Sebastião mandou dizer: se você ouvir qualquer coisa sobre ele, qualquer coisa, liga aqui. Três, dois, sete."

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Pode deixar, Zé.", "Ele está bem?")
sets = PackedStringArray("", "pergunta_ze_15")

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
text = "Tava, da última vez que passou aqui. Agora ninguém sabe onde ninguém tá."
requires = PackedStringArray("pergunta_ze_15")

[sub_resource type="Resource" id="Step_05"]
script = ExtResource("2_step")
text = "Se a gente segurar a cidade até as quatro, acabou. Aguenta firme, moça."

[sub_resource type="Resource" id="Step_06"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "m"
caller = "Zé"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04"), SubResource("Step_05"), SubResource("Step_06")])
