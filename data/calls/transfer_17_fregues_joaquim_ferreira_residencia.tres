[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_ncdxd"]

[resource]
script = ExtResource("1_ncdxd")
group = 1
voice = "m"
caller = "Freguês"
opening = PackedStringArray("O seu Joaquim Ferreira, por favor.", "Na casa dele. O armazém já fechou a essa hora.")
repeat = "Na casa do Joaquim Ferreira. Não no armazém."
target = "291"
destination = "Joaquim Ferreira (residência)"
thanks = "Tá certo."
overheard = PackedStringArray("Seu Joaquim? Desculpa ligar na sua casa.", "Tudo bem. O que foi?", "Amanhã eu preciso de dez sacos de cimento logo cedo.", "Dez? Eu só tenho seis. O resto chega na quinta.", "Então separa os seis. A obra não pode parar.", "Abro às sete. Pode mandar a carroça.")
