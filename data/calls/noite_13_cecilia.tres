[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
group = 1
voice = "f"
caller = "Dona Ruth"
caller_name = "Ruth Andrade"
opening = PackedStringArray("Boa noite. A Laudelina Prado, por favor. Dois, oito, zero.", "Ela não vai acreditar no que eu li.")
repeat = "Laudelina Prado, moça."
target = "280"
destination = "Laudelina Prado"
thanks = "Obrigada, moça. Se cuide você também."
overheard = PackedStringArray("Laudelina? Você leu? A Cecília da central morreu.", "Li. Mal súbito, diz o jornal. Ela subia a serra a pé toda semana.", "Trinta anos atendendo a gente. Sabia a voz de cada um.", "Agora vão ouvir as telefonistas, dizem. Por causa de vazamento.", "Vazamento de quê?", "Não sei. E acho melhor a gente desligar.")
