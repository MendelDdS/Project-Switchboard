[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_dyan4"]

[resource]
script = ExtResource("1_dyan4")
group = 2
caller = "Dona Tereza"
caller_name = "Tereza Ribeiro"
opening = PackedStringArray("Me conecta com o 223, por favor?", "É da minha comadre.")
repeat = "Dois, dois, três. A Marta."
target = "223"
destination = "Marta Costa"
thanks = "Obrigada, querida."
overheard = PackedStringArray("Comadre? É a Tereza.", "Tereza! Que surpresa boa a essa hora.", "Amanhã é o aniversário do nosso afilhado. Você lembrou?", "Lembrei! Já comprei uma bola pra ele.", "Eu fiz um bolo de chocolate. A gente vai junto?", "Vamos. Passo aí às três.")
