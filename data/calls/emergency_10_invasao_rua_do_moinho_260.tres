[sub_resource type="Resource" id="Case_2"]
script = ExtResource("2_case")
answers = PackedStringArray("", "Tô no quarto, trancado. Mas cortei a mão feio no vidro quando fugi... tá sangrando muito.", "")
units = PackedStringArray("pol", "amb")

[resource]
script = ExtResource("1_nwtnb")
voice = "w"
caller = "Senhor"
opening = "(sussurrando) Central... tem alguém dentro da minha casa."
questions = PackedStringArray("Qual é o endereço?", "O senhor está em segurança?", "A pessoa está armada?")
answers = PackedStringArray("Rua do Moinho, 260. A última casa.", "Tô trancado no quarto. Ouvi quebrarem o vidro da cozinha.", "Não sei. Não vi. Só ouço os passos.")
street = "moinho"
block = 2
address = "Rua do Moinho, 260"
occurrence = "Invasão / roubo"
units = PackedStringArray("pol")
after = "Tá. Eu vou ficar quieto aqui."
stage_sec = Vector3(40, 20, 20)
worsening = "(sussurrando) Tão mexendo nas gavetas da sala..."
worsening_question = "Quantas pessoas você ouve?"
worsening_answer = "(sussurrando) Duas vozes. Homens."
critical = "(sussurrando) Tão tentando abrir a porta do quarto!"
critical_question = "Tem alguma saída no quarto?"
critical_answer = "(sussurrando) A janela... mas é do segundo andar."
lost = "(chorando) Eles foram embora... levaram tudo. Ninguém veio."
lost_answer = "(chorando) Pulei a janela pra fugir... acho que quebrei o pé."
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2")])
