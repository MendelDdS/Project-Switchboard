[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_d0x3r"]

[resource]
script = ExtResource("1_d0x3r")
group = 2
caller = "Vizinha"
caller_name = "Irene Fagundes"
opening = PackedStringArray("Central, me liga com o seu Benedito Souza?", "Sou vizinha dele. A luz da casa tá acesa e ele não atende a porta.")
repeat = "O seu Benedito Souza, da Rua do Sol."
target = "271"
destination = "Benedito Souza"
thanks = "Obrigada. Deve estar dormindo, né?"
overheard = PackedStringArray("Seu Benedito? É a vizinha. A luz está acesa e o senhor não atende.", "Ah, minha filha, eu estava no banho.", "Que susto! Achei que o senhor tinha caído.", "Não, não. Estou firme. Mas obrigado por cuidar de mim.", "Amanhã eu levo uma sopa pro senhor.")
