[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_tr"]

[resource]
script = ExtResource("1_tr")
group = 1
voice = "m"
caller = "Afilhado"
caller_name = "Fernando Assis"
opening = PackedStringArray("Boa noite. Queria falar com o meu padrinho, o seu Geraldo.", "Geraldo Martins. Ele mora na Rua da Matriz.")
repeat = "Geraldo Martins, da Rua da Matriz."
target = "155"
destination = "Geraldo Martins"
thanks = "Obrigado, moço. Ele vai gostar da notícia."
overheard = PackedStringArray("Padrinho? Boa noite. É o seu afilhado.", "Rapaz! Que saudade. Está tudo bem?", "Tudo. Passei no concurso do banco!", "Eu sabia! Sua madrinha vai chorar de alegria.", "Domingo eu levo um vinho pra gente comemorar.")
