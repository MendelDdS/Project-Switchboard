worsening_question = "Ele ainda responde?"
worsening_answer = "Responde, mas bem fraquinho!"
critical = "O carro voltou! Tão atirando de novo pra cá!"
critical_units = PackedStringArray("pol")
critical_question = "Tem mais alguém ferido?"
critical_answer = "Não sei, eu me escondi atrás do muro!"
lost = "Ele parou de falar... Ninguém veio."
