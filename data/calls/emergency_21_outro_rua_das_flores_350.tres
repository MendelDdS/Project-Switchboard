[resource]
script = ExtResource("1_emerg")
voice = "f"
caller = "Vizinha do prédio"
opening = "Central, tá um cheiro forte de gás no corredor do prédio! Vem do apartamento da Dona Ilda!"
questions = PackedStringArray("Qual é o endereço?", "Ela atende a porta?", "Alguém acendeu alguma luz ou fósforo?")
answers = PackedStringArray("Rua das Flores, 350! O prédio de três andares!", "Não! A gente bate e nada! Ela deve ter passado mal com o gás!", "Não, ninguém. Abri as janelas do corredor.")
street = "flores"
block = 3
address = "Rua das Flores, 350"
occurrence = "Outro"
units = PackedStringArray("bomb", "amb")
after = "Tá. Vou tirar todo mundo do prédio."
stage_sec = Vector3(35, 18, 18)
worsening = "O cheiro tá chegando no andar de baixo! Tem criança lá!"
worsening_units = PackedStringArray()
worsening_question = "As crianças já saíram?"
worsening_answer = "Já! A mãe levou elas pra calçada."
critical = "O vizinho de baixo tá com dor de cabeça e vomitando!"
critical_units = PackedStringArray("amb")
critical_question = "Ele consegue andar?"
critical_answer = "Consegue, apoiado. Tá sentado no meio-fio."
lost = "Teve um estouro no apartamento dela! Quebrou as janelas todas!"
lost_answer = "A Dona Ilda ainda tá lá dentro, e o vizinho levou um corte de vidro no rosto!"
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2")])
