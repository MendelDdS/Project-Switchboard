[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
group = 2
voice = "m"
caller = "Assessor"
opening = PackedStringArray("A delegacia! Urgente!")
repeat = "A delegacia, moça! Rápido!"
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigado."
overheard = PackedStringArray("Plantão? É o Valadares, da residência. Quantos homens você ainda tem?", "Uns [number:doze]. Metade ferida.", "Junta os inteiros e retoma a [place:Rádio Serena]. Enquanto ela falar, a cidade não para.", "Pela [street:Rua do Sol] não dá, tem barricada.", "Então pelos fundos. Vai agora.")
caller_name = "Henrique Valadares"
name_line = "Henrique Valadares, da residência oficial."
code_line = "Autorização {code}."
