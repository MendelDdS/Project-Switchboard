[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
group = 1
voice = "f"
caller = "Dona Marlene"
caller_name = "Marlene Duarte"
opening = PackedStringArray("Boa noite. O Alberto Ramos, por favor. Um, seis, oito.", "É o meu cunhado.")
repeat = "Alberto Ramos, moça."
target = "168"
destination = "Alberto Ramos"
thanks = "Obrigada, moça."
overheard = PackedStringArray("Alberto? É a Marlene. Levaram o Tadeu. Estava no Bar do Zé.", "Eu li no jornal. Quatro presos. Ele é um deles?", "É. Disseram que gravaram ele falando ao telefone.", "Gravaram? Quem grava telefone?", "Não sei. Mas alguém ouviu, Alberto. Alguém ouviu.", "Então desliga. Desliga agora, Marlene.")
