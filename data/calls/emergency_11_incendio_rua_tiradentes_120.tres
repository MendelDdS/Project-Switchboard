[sub_resource type="Resource" id="Case_3"]
script = ExtResource("2_case")
answers = PackedStringArray("", "", "Ele saiu, mas queimou as mãos tentando apagar!")
units = PackedStringArray("bomb", "amb")

[resource]
script = ExtResource("1_emerg")
voice = "w"
caller = "Senhor"
opening = "Central! A papelaria aqui da Rua Tiradentes tá pegando fogo!"
questions = PackedStringArray("Qual é o número?", "O que está queimando?", "Tem alguém lá dentro?")
answers = PackedStringArray("Cento e vinte! Do lado dos Correios!", "A loja toda! Sai fumaça preta pela porta!", "Não, o seu Osório fechou às seis e foi pra casa.")
street = "tiradentes"
block = 1
address = "Rua Tiradentes, 120"
occurrence = "Incêndio"
units = PackedStringArray("bomb")
after = "Graças a Deus. Vou avisar os vizinhos pra saírem de casa."
stage_sec = Vector3(35, 18, 18)
worsening = "A fumaça tá cobrindo a rua, os carros tão parando no meio!"
worsening_question = "Os carros conseguem passar?"
worsening_answer = "Não, parou tudo. Tem gente buzinando no meio da fumaça."
worsening_units = PackedStringArray("pol")
critical = "O fogo passou pro sobrado do lado! Tem uma senhora na janela pedindo socorro!"
critical_units = PackedStringArray("amb")
critical_question = "Ela consegue sair?"
critical_answer = "Não! A escada é por dentro e tá cheia de fumaça!"
lost = "O telhado da papelaria caiu... ninguém chegou a tempo!"
lost_answer = "Tiraram a senhora do sobrado pela janela, mas ela respirou muita fumaça!"
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2"), SubResource("Case_3")])
