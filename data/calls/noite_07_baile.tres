[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
group = 1
voice = "f"
caller = "Dona Dalva"
caller_name = "Dalva Moreira"
opening = PackedStringArray("Boa noite. Me liga com a Lúcia Pereira?", "Ela é minha amiga, mora no Centro.")
repeat = "Lúcia Pereira. Um, quatro, sete."
target = "147"
destination = "Lúcia Pereira"
thanks = "Obrigada, moça!"
overheard = PackedStringArray("Lúcia? É a Dalva. Você chegou bem em casa ontem?", "Cheguei. Saí antes da revista, por sorte. E você?", "Me revistaram a bolsa inteira. Até o batom abriram.", "E o Zeca? Vi levarem ele.", "Estava sem documento. Passou a noite lá. A mãe dele está desesperada.", "Nunca mais vou a baile na praça. Nunca mais.")
