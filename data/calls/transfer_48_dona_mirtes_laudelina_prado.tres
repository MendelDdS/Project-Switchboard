[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_tr"]

[resource]
script = ExtResource("1_tr")
group = 1
voice = "f"
caller = "Dona Mirtes"
caller_name = "Mirtes Barros"
opening = PackedStringArray("Boa noite. A Dona Laudelina, por favor.", "Laudelina Prado. Ela me emprestou a forma de pudim e eu quero devolver amanhã cedo.")
repeat = "Laudelina Prado. Da Bela Vista."
target = "280"
destination = "Laudelina Prado"
thanks = "Obrigada, meu bem."
overheard = PackedStringArray("Dona Laudelina? É a Mirtes. Da forma de pudim.", "Ah, Mirtes! E o pudim, deu certo?", "Ficou lindo. Todo mundo pediu a receita.", "Que bom. A forma pode trazer quando quiser.", "Levo amanhã cedo, com um pedaço do pudim.")
