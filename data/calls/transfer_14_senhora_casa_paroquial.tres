[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_2y5ys"]

[resource]
script = ExtResource("1_2y5ys")
group = 1
caller = "Senhora"
caller_name = "Laura Lacerda"
opening = PackedStringArray("Boa noite. Preciso falar com o Padre Anselmo.", "É sobre a missa de sétimo dia. Ele deve estar em casa.")
repeat = "O Padre Anselmo. Na casa dele, não na igreja."
target = "120"
destination = "Casa Paroquial"
thanks = "Obrigada, minha filha."
overheard = PackedStringArray("Boa noite, padre. É sobre a missa de sétimo dia do meu marido.", "Meus pêsames, minha filha. Quer pra quando?", "Pra sexta. Ele gostava da missa da tarde.", "Sexta, às cinco. Eu mesmo celebro.", "Obrigada, padre. Ele ia ficar contente.")
