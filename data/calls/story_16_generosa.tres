[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Boa noite! Aqui é a Generosa Prates. A da fita amarela, lembra?"

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
text = "O Otávio está bem! O médico disse que ele tem alta na semana que vem."

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
text = "Ele pediu pra eu ligar e agradecer. Disse que a moça da central é a madrinha da gente."

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Madrinha? Que honra.", "Fico feliz, Generosa.")

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
text = "Quando ele sair, a primeira música é por nossa conta. Boa noite!"

[sub_resource type="Resource" id="Step_05"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "f"
caller = "Moça"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04"), SubResource("Step_05")])
