[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
group = 2
voice = "m"
caller = "Policial"
opening = PackedStringArray("A delegacia! Pelo amor de Deus, a delegacia!")
repeat = "A delegacia!"
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigado."
overheard = PackedStringArray("Plantão? Rubens. Perdemos a ferrovia.", "Como, perdemos?", "Eram muitos. Estou na [street:Rua da Matriz], atrás da [place:igreja], com dois feridos.", "Fica aí. Vou mandar a ambulância e o que sobrou de viatura.", "Manda logo. Eles estão vindo pra cá.")
caller_name = "Rubens Moura"
name_line = "Rubens Moura, da polícia."
code_line = "Autorização {code}."
