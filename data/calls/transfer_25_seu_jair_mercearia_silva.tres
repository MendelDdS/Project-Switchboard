[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_tsdyx"]

[resource]
script = ExtResource("1_tsdyx")
voice = "w"
caller = "Seu Jair"
opening = PackedStringArray("Boa noite.", "A Mercearia Silva ainda atende? O Silva mora nos fundos. Acabou a vela aqui em casa.")
repeat = "A Mercearia Silva, na Rua do Cruzeiro."
target = "262"
destination = "Mercearia Silva"
thanks = "Obrigado. Tá um breu aqui."
overheard = PackedStringArray("Silva, boa noite. É o Jair. Acabou a vela aqui.", "Faltou luz aí também, seu Jair?", "Faltou. E eu não enxergo nada no escuro.", "Mando meu filho levar meia dúzia aí.", "Deus te pague. Ele bate na janela, que eu escuto.")
