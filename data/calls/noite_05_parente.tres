[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
voice = "f"
caller = "Dona Rosa"
caller_name = "Rosa Medeiros"
opening = PackedStringArray("Boa noite. A delegacia do Centro, por favor.", "É sobre o meu filho. Ele foi preso no protesto.")
repeat = "A delegacia, moça. Pelo amor de Deus."
target = "184"
destination = "Delegacia de Polícia"
thanks = "Obrigada. Reza por ele, moça."
overheard = PackedStringArray("Boa noite. Meu filho, Luís Medeiros, foi preso ontem na praça.", "Medeiros... Não consta nada aqui, senhora.", "Os vizinhos viram ele entrar no camburão. Dezoito anos, de camisa azul.", "Senhora, se não consta, não está aqui.", "Então onde ele está?", "Procure amanhã de dia. De noite não damos informação.")
