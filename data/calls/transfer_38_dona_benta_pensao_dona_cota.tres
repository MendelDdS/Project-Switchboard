[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_tr"]

[resource]
script = ExtResource("1_tr")
voice = "w"
caller = "Dona Benta"
caller_name = "Benta Rangel"
opening = PackedStringArray("Boa noite, moça.", "Me liga com a Pensão Dona Cota? Meu filho chegou de viagem e ficou lá.")
repeat = "A pensão da Dona Cota, na Rua da Estação."
target = "312"
destination = "Pensão Dona Cota"
thanks = "Obrigada, minha filha. Boa noite."
alt_target = "305"
alt_destination = "Hotel Serena"
alt_ask = "A pensão não atende. Quer que eu tente o Hotel Serena?"
alt_yes = "Tenta, sim. Vai ver ele foi pra lá."
overheard = PackedStringArray("Boa noite, moço. Meu filho chegou de viagem e ficou aí.", "Como ele se chama, senhora?", "Rogério. Um moço alto, de bigode.", "Chegou, sim. Está jantando lá na sala.", "Diz pra ele vir almoçar comigo amanhã.", "Digo, sim. Boa noite, senhora.")
