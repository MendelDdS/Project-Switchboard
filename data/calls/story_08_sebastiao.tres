[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Maria, é o Sebastião."

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
text = "Você tem me ajudado mais do que imagina. Hoje é mais uma."
requires = PackedStringArray("sebastiao_5")

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
text = "Faz tempo. Eu sumi porque achei que você não queria ouvir. Mas agora não tenho mais a quem pedir."
requires = PackedStringArray("!sebastiao_5")

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
text = "Ligue para o Hospital São Lucas pelo seu discador e peça a Enfermeira Joana."

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
text = "Diga a ela: \"A ala 3C precisa de suprimentos.\" Só isso. Ela entende."

[sub_resource type="Resource" id="Step_05"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("E o que tem na ala 3C?", "Está bem.")
sets = PackedStringArray("ala_8", "")

[sub_resource type="Resource" id="Step_06"]
script = ExtResource("2_step")
text = "Gente nossa que não pode aparecer num hospital da polícia. Quanto menos você souber, melhor."
requires = PackedStringArray("ala_8")

[sub_resource type="Resource" id="Step_07"]
script = ExtResource("2_step")
text = "Hoje, Maria. Amanhã pode ser tarde pra eles."

[sub_resource type="Resource" id="Step_09"]
script = ExtResource("2_step")
text = "E o hotel: se as autoridades estão de olho nele, ligue pra lá e avise. Antes das nove."

[sub_resource type="Resource" id="Step_08"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "m"
caller = "Sebastião Falcão"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04"), SubResource("Step_05"), SubResource("Step_06"), SubResource("Step_07"), SubResource("Step_09"), SubResource("Step_08")])
