[resource]
script = ExtResource("1_emerg")
voice = "m"
caller = "Tipógrafo"
opening = "Central! A oficina da gráfica tá pegando fogo! O papel todo tá queimando!"
questions = PackedStringArray("Qual é o endereço?", "Tem alguém dentro?", "Alguém se machucou?")
answers = PackedStringArray("Rua Sete de Setembro, 60! Atrás da Gazeta!", "Não, a gente saiu tudo pela frente.", "Não, graças a Deus. Só a fumaça.")
street = "sete"
block = 0
address = "Rua Sete de Setembro, 60"
occurrence = "Incêndio"
units = PackedStringArray("bomb")
after = "Tá bom. A gente vai molhar a parede do vizinho enquanto isso."
stage_sec = Vector3(35, 18, 18)
worsening = "A fumaça tá entrando no sobrado do lado! Mora gente lá em cima!"
worsening_units = PackedStringArray()
worsening_question = "Quem mora no sobrado?"
worsening_answer = "Um casal de velhinhos. Eles já desceram pra calçada."
critical = "A velhinha desmaiou na calçada! Respirou muita fumaça!"
critical_units = PackedStringArray("amb")
critical_question = "Ela está respirando?"
critical_answer = "Tá, mas tossindo muito e chiando no peito."
lost = "O teto da gráfica caiu... e o fogo pegou o sobrado. Ninguém veio!"
lost_answer = "A velhinha não acorda, e o marido dela tá com o rosto queimado!"
lost_units = PackedStringArray("amb")
cases = Array[ExtResource("2_case")]([SubResource("Case_1"), SubResource("Case_2")])
