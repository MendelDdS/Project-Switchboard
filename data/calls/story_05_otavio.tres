[gd_resource type="Resource" script_class="PrankCall" format=3]

[ext_resource type="Script" path="res://scripts/data/prank_call.gd" id="1_call"]
[ext_resource type="Script" path="res://scripts/data/prank_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_00"]
script = ExtResource("2_step")
text = "Boa noite, moça. É o Otávio, lembra? O da Generosa."

[sub_resource type="Resource" id="Step_01"]
script = ExtResource("2_step")
text = "Liguei pra ela, conversamos até a ficha acabar. Agora eu quero levar ela no Cine Odeon. Mas e se ela achar que é cedo demais?"

[sub_resource type="Resource" id="Step_02"]
script = ExtResource("2_step")
kind = 1
options = PackedStringArray("Convida. Ela vai gostar.", "Vai com calma, Otávio.")

[sub_resource type="Resource" id="Step_03"]
script = ExtResource("2_step")
text = "É... Vou convidar pra sessão de sábado. Se ela disser não, eu ofereço outra música! Boa noite!"

[sub_resource type="Resource" id="Step_04"]
script = ExtResource("2_step")
kind = 3

[resource]
script = ExtResource("1_call")
voice = "m"
caller = "Rapaz"
steps = Array[ExtResource("2_step")]([SubResource("Step_00"), SubResource("Step_01"), SubResource("Step_02"), SubResource("Step_03"), SubResource("Step_04")])
