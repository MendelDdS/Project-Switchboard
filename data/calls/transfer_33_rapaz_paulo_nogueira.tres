[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_cbsiw"]

[resource]
script = ExtResource("1_cbsiw")
group = 2
voice = "m"
caller = "Rapaz"
caller_name = "Caio Salgado"
opening = PackedStringArray("Boa noite.", "Me liga com o seu Paulo Nogueira? Ele disse que eu podia ligar a qualquer hora.")
repeat = "Paulo Nogueira."
target = "131"
destination = "Paulo Nogueira"
thanks = "Obrigado."
overheard = PackedStringArray("Seu Paulo? Boa noite. O senhor disse que eu podia ligar.", "Disse. É sobre o serviço na serraria?", "É. Quero aceitar, se a vaga ainda existir.", "Existe. Segunda, às seis, com a carteira de trabalho.", "Estarei lá. Muito obrigado, seu Paulo.")
