[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_1ftdp"]

[resource]
script = ExtResource("1_1ftdp")
group = 2
voice = "w"
caller = "Senhor"
opening = PackedStringArray("Boa noite.", "O Alberto Ramos, da Avenida Brasil. Somos sócios.")
repeat = "Alberto Ramos."
target = "168"
destination = "Alberto Ramos"
thanks = "Obrigado, central."
overheard = PackedStringArray("Alberto, boa noite. Fechei a loja agora.", "E como foi o dia?", "Bom. Vendemos os três rádios da vitrine.", "Os três? Então tem que encomendar mais.", "Por isso liguei. Você escreve pro fornecedor amanhã?", "Escrevo. E vou pedir cinco, que é Natal.")
