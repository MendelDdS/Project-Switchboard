[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_bl2n1"]

[resource]
script = ExtResource("1_bl2n1")
voice = "m"
caller = "Motorista"
caller_name = "Milton Cunha"
opening = PackedStringArray("O posto da Rua da Estação ainda está aberto?", "Me conecta lá, por favor. Tô quase sem gasolina.")
repeat = "O Posto São Cristóvão."
target = "347"
destination = "Posto São Cristóvão"
thanks = "Obrigado, central."
overheard = PackedStringArray("Ainda está aberto? Estou quase sem gasolina.", "Fecho às dez. Você está onde?", "Na saída da cidade. O ponteiro já está no vermelho.", "Dá pra chegar. Vem devagar, sem acelerar muito.", "Me espera, pelo amor de Deus.", "Espero. Deixo a luz da bomba acesa.")
