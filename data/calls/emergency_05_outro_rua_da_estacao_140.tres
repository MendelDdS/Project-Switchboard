[gd_resource type="Resource" script_class="EmergencyCall" format=3]

[ext_resource type="Script" path="res://scripts/data/emergency_call.gd" id="1_f40cv"]

[resource]
script = ExtResource("1_f40cv")
voice = "m"
caller = "Homem nervoso"
