[gd_resource type="Resource" script_class="TransferCall" format=3]

[ext_resource type="Script" path="res://scripts/data/transfer_call.gd" id="1_call"]

[resource]
script = ExtResource("1_call")
voice = "f"
caller = "Dona Filomena"
caller_name = "Filomena Prates"
opening = PackedStringArray("Boa noite. A Padaria Pão Dourado, por favor.", "Quero encomendar o pão de amanhã.")
repeat = "A padaria, moça."
target = "142"
destination = "Padaria Pão Dourado"
thanks = "Obrigada, moça. Boa noite pra você."
overheard = PackedStringArray("Padaria? É a Filomena. Separa dez pães pra amanhã cedo?", "Separo, mas não sei se abro. Tem soldado na esquina da rádio.", "Dizem que amanhã vai ter coisa.", "Dizem tanta coisa. Meu marido encheu a caixa d'água.", "O meu comprou vela e querosene.", "Então venha às seis. Se eu abrir, abro cedo.")
