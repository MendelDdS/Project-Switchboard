[gd_resource type="Resource" script_class="DirectoryEntry" format=3]

[ext_resource type="Script" path="res://scripts/data/directory_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://scripts/data/motive.gd" id="2_motive"]

[sub_resource type="Resource" id="Motive_55"]
script = ExtResource("2_motive")
text = "Ele ficou de me devolver a furadeira."
talks = Array[PackedStringArray]([PackedStringArray("Ivo, boa noite. Lembra da furadeira que eu te emprestei?", "Lembro. Desculpa, está aqui na garagem ainda.", "Preciso dela amanhã. Vou pendurar as prateleiras.", "Levo aí de manhã, antes das {hour}.", "E a broca grande, ainda está inteira?", "Quebrou. Mas eu compro outra e levo junto."), PackedStringArray("Oi, Ivo. Desculpa a hora. É a furadeira.", "Ih, eu emprestei pro meu cunhado.", "Você emprestou o que era meu?", "Foi rapidinho. Amanhã ele devolve, lá pelas {hour}.", "Então me leva assim que ele devolver.", "Levo. E de quebra te dou um vidro de mel.")])

[sub_resource type="Resource" id="Motive_56"]
script = ExtResource("2_motive")
text = "É sobre a pescaria de domingo."
talks = Array[PackedStringArray]([PackedStringArray("Ivo, boa noite. A pescaria de domingo continua de pé?", "Continua. Saímos às {dawn}, da ponte velha.", "Às {dawn}? Vou ter que dormir cedo.", "E traz minhoca, que a minha horta secou.", "Levo. E o barco, quem traz?", "O barco é do meu irmão. Ele encontra a gente lá."), PackedStringArray("Oi, Ivo. Sobre domingo: o rio subiu, viu?", "Subiu muito? Dá pra pescar?", "Na ponte, não. Mas no remanso do moinho dá.", "Então vamos pro moinho. A que horas?", "Às {dawn}. Eu levo o café e o pão.", "E eu levo as varas. Até domingo.")])

[resource]
script = ExtResource("1_entry")
name = "Ivo Teixeira"
address = "Rua das Flores, 333"
number = "184"
voice = "m"
spoken = "o seu Ivo Teixeira"
motives = Array[ExtResource("2_motive")]([SubResource("Motive_55"), SubResource("Motive_56")])
