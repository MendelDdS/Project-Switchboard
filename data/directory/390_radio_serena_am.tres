[gd_resource type="Resource" script_class="DirectoryEntry" format=3]

[ext_resource type="Script" path="res://scripts/data/directory_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://scripts/data/chat_topic.gd" id="8_chat"]
[ext_resource type="Script" path="res://scripts/data/chat_reply.gd" id="9_reply"]
[ext_resource type="Script" path="res://scripts/data/motive.gd" id="2_motive"]

[sub_resource type="Resource" id="Motive_45"]
script = ExtResource("2_motive")
text = "Quero pedir uma música."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Queria pedir uma música pro programa da noite.", "Pode pedir. Qual é a música?", "Uma valsa antiga, aquela que tocava nos bailes do clube.", "Tem várias. Sabe o nome de alguma?", "O nome eu não lembro. Mas é a que todo mundo dançava no fim.", "Já sei qual é. Toca às {hour}. Ofereço pra quem?"), PackedStringArray("Boa noite. Queria oferecer uma música pra uma pessoa especial.", "Pode falar. Qual música?", "Uma moda de viola, daquelas bem antigas.", "Tenho umas três aqui. Ofereço em nome de quem?", "Diz só que é de alguém que não esqueceu.", "Vai ao ar às {hour}, no programa dos pedidos.")])

[sub_resource type="Resource" id="Motive_46"]
script = ExtResource("2_motive")
text = "Quero mandar um recado pra um parente que trabalha na roça."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Queria mandar um recado pelo rádio.", "Recado pra quem, e de quem?", "Pro meu primo, que trabalha na colheita. Diz que a família está bem.", "Só isso? Que a família está bem?", "E que é pra ele descer no fim do mês, que a gente espera.", "Vai ao ar às {hour}, no quadro dos recados."), PackedStringArray("Boa noite. Dá pra mandar um recado pra roça pelo programa?", "Dá. Pra quem é o recado?", "Pro meu tio, que está no sítio. Diz pra ele descer na feira.", "Na feira de quando?", "Na de sábado. Tem gente esperando por ele.", "Vai ao ar às {hour}, depois das notícias.")])

[sub_resource type="Resource" id="Answer_0_0"]
script = ExtResource("9_reply")
text = "Qual é a programação de hoje?"
follow = "Depois das notícias, o programa dos pedidos. À meia-noite, a gente sai do ar."

[sub_resource type="Resource" id="Answer_0_1"]
script = ExtResource("9_reply")
text = "Posso pedir uma música?"
follow = "Pode. Deixa o nome que o locutor toca no programa das dez."

[sub_resource type="Resource" id="Answer_0_2"]
script = ExtResource("9_reply")
text = "Quem está no ar agora?"
follow = "O locutor da noite, com as modas de viola."

[sub_resource type="Resource" id="Answer_0"]
script = ExtResource("8_chat")
line = "Rádio Serena, boa noite! O que deseja?"
replies = Array[ExtResource("9_reply")]([SubResource("Answer_0_0"), SubResource("Answer_0_1"), SubResource("Answer_0_2")])

[sub_resource type="Resource" id="Answer_1_0"]
script = ExtResource("9_reply")
text = "Vai ter a previsão do tempo hoje?"
follow = "Às onze, depois do intervalo."

[sub_resource type="Resource" id="Answer_1_1"]
script = ExtResource("9_reply")
text = "Vocês recebem recado para a roça?"
follow = "Recebe, sim. Vai ao ar no quadro dos recados, depois das notícias."

[sub_resource type="Resource" id="Answer_1"]
script = ExtResource("8_chat")
line = "Serena AM, estúdio. Fala rápido, que estamos no ar."
replies = Array[ExtResource("9_reply")]([SubResource("Answer_1_0"), SubResource("Answer_1_1")])

[sub_resource type="Resource" id="Ans_radio_tomada_0"]
script = ExtResource("9_reply")
text = "A transmissão de ontem era de vocês?"
follow = "Não era o nosso locutor, é só o que eu digo. O resto saiu no jornal."

[sub_resource type="Resource" id="Ans_radio_tomada_1"]
script = ExtResource("9_reply")
text = "Vocês estão bem?"
follow = "Estamos no ar. Com gente de farda no corredor, mas no ar."

[sub_resource type="Resource" id="Ans_radio_tomada"]
script = ExtResource("8_chat")
requires = PackedStringArray("radio_conquistada")
from_night = 10
to_night = 10
line = "Rádio Serena, boa noite! O que deseja?"
replies = Array[ExtResource("9_reply")]([SubResource("Ans_radio_tomada_0"), SubResource("Ans_radio_tomada_1")])

[sub_resource type="Resource" id="Ans_radio_resistiu_0"]
script = ExtResource("9_reply")
text = "O que houve ontem?"
follow = "Tentaram entrar aqui à força, e a guarda respondeu a tiros. Levaram três presos."

[sub_resource type="Resource" id="Ans_radio_resistiu_1"]
script = ExtResource("9_reply")
text = "Ninguém se feriu aí?"
follow = "Um vidro quebrado e o susto. Do estúdio, ninguém se feriu."

[sub_resource type="Resource" id="Ans_radio_resistiu"]
script = ExtResource("8_chat")
requires = PackedStringArray("!radio_conquistada")
from_night = 10
to_night = 10
line = "Rádio Serena, boa noite! O que deseja?"
replies = Array[ExtResource("9_reply")]([SubResource("Ans_radio_resistiu_0"), SubResource("Ans_radio_resistiu_1")])

[resource]
script = ExtResource("1_entry")
wary = 1.3
name = "Rádio Serena AM"
address = "Rua do Sol, 199"
number = "390"
hello = "Rádio Serena. Quem fala, e do que se trata?"
spoken = "a Rádio Serena"
motives = Array[ExtResource("2_motive")]([SubResource("Motive_45"), SubResource("Motive_46")])
answers = Array[ExtResource("8_chat")]([SubResource("Answer_0"), SubResource("Answer_1"), SubResource("Ans_radio_tomada"), SubResource("Ans_radio_resistiu")])
bye = "Obrigado por ouvir a Serena. Boa noite!"
closes = 360.0
