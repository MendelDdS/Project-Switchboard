[gd_resource type="Resource" script_class="DirectoryEntry" format=3]

[ext_resource type="Script" path="res://scripts/data/directory_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://scripts/data/motive.gd" id="2_motive"]

[sub_resource type="Resource" id="Motive_12"]
script = ExtResource("2_motive")
text = "Ele é meu cunhado. É assunto de família."
talks = Array[PackedStringArray]([PackedStringArray("Geraldo, sou eu. Desculpa a hora, é sobre a mamãe.", "Aconteceu alguma coisa com a sogra?", "Nada grave. Mas ela quer reunir a família no domingo.", "Domingo? E a que horas?", "Almoço, ao meio-dia. E pediu pra levar a sobremesa.", "Então avisa que a gente vai. A sobremesa é com a sua irmã."), PackedStringArray("Boa noite, Geraldo. Precisamos falar da casa do sítio.", "A do seu pai? O que tem ela?", "O telhado caiu num canto. Choveu dentro a semana toda.", "Então tem que arrumar antes que piore.", "Pois é. Dá pra dividir a telha entre a família?", "Dá. Sábado eu subo lá com a escada e vejo quanto precisa.")])

[sub_resource type="Resource" id="Motive_13"]
script = ExtResource("2_motive")
text = "Ele ficou de me emprestar o carro amanhã cedo."
talks = Array[PackedStringArray]([PackedStringArray("Geraldo, boa noite. O carro amanhã ainda está de pé?", "Está. Mas o tanque está na reserva, viu?", "Eu ponho gasolina. A que horas eu pego?", "Às {dawn}. A chave fica embaixo do tapete.", "Combinado. Devolvo antes do almoço.", "E cuidado com a segunda marcha, que ela escapa."), PackedStringArray("Boa noite, Geraldo. Preciso do carro amanhã cedo pra levar a mamãe ao médico.", "Pode levar. Ele está na garagem, com a chave no contato.", "Ótimo. Devolvo de tarde, de tanque cheio.", "O pneu da frente está meio murcho. Passa no posto antes.", "Pode deixar. A consulta é às {hour}, dá tempo.", "Manda um abraço pra ela.")])

[resource]
script = ExtResource("1_entry")
name = "Geraldo Martins"
address = "Rua da Matriz, 210"
number = "155"
voice = "m"
spoken = "o seu Geraldo Martins"
motives = Array[ExtResource("2_motive")]([SubResource("Motive_12"), SubResource("Motive_13")])
