[gd_resource type="Resource" script_class="DirectoryEntry" format=3]

[ext_resource type="Script" path="res://scripts/data/directory_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://scripts/data/motive.gd" id="2_motive"]

[sub_resource type="Resource" id="Motive_1"]
script = ExtResource("2_motive")
text = "Quero fazer uma queixa."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Arrombaram o portão da minha garagem e levaram a bicicleta.", "Queixa de furto é pessoalmente, aqui no balcão.", "A esta hora? A rua está escura feito breu.", "Então venha amanhã cedo. Anote a hora em que notou.", "Notei agora há pouco, umas {hour}.", "Está certo. Amanhã cedo, com documento."), PackedStringArray("Boa noite. O vizinho de cima está batendo na parede faz uma hora.", "É briga ou é barulho?", "Barulho, eu acho. Mas não deixa ninguém dormir.", "Barulho é com o síndico. Se virar briga, ligue de novo.", "O síndico mora fora. Vou aguentar, então.", "Boa noite.")])

[sub_resource type="Resource" id="Motive_2"]
script = ExtResource("2_motive")
text = "Perdi meus documentos."
talks = Array[PackedStringArray]([PackedStringArray("Boa noite. Meu pai perdeu a carteira com os documentos no ônibus.", "Alguém entregou uma aqui hoje à tarde. Qual o nome?", "Pedro Lopes. A carteira é marrom, de couro.", "É essa mesma. Ele vem buscar, com outro documento.", "Ele vai amanhã, então. Agradeço muito.", "Boa noite."), PackedStringArray("Boa noite. Perdi a carteira de trabalho. Preciso dar parte?", "Precisa, para tirar a segunda via.", "E eu faço isso aí, à noite?", "De noite só flagrante. Venha amanhã de manhã.", "Amanhã de manhã, então.", "Traga duas testemunhas, se tiver.")])

[resource]
script = ExtResource("1_entry")
name = "Delegacia de Polícia"
note = "plantão"
address = "Avenida Brasil, 380"
number = "184"
voice = "m"
spoken = "a delegacia"
hello = "Delegacia, plantão."
motives = Array[ExtResource("2_motive")]([SubResource("Motive_1"), SubResource("Motive_2")])
