"Language: es\n"

#: data/directory/361_otavio_almeida.tres
msgid "Alô? Otávio falando."
msgstr "¿Aló? Habla Otávio."

#: data/directory/361_otavio_almeida.tres data/directory/367_celia_rocha.tres data/directory/373_celia_rocha.tres
msgid "É da central. Estamos testando a linha."
msgstr "Es la central. Estamos probando la línea."

#: data/directory/361_otavio_almeida.tres
msgid "Ah, tá. Pensei que fosse alguém da rádio."
msgstr "Ah, bueno. Pensé que era alguien de la radio."

#: data/directory/361_otavio_almeida.tres data/directory/367_celia_rocha.tres data/nights/night_04.tres
msgid "Desculpe, foi engano."
msgstr "Disculpe, número equivocado."

#: data/directory/361_otavio_almeida.tres
msgid "Tudo bem. Se for a moça de fita amarela, eu tô aqui, viu?"
msgstr "Está bien. Si es la muchacha de la cinta amarilla, aquí estoy, ¿eh?"

#: data/directory/361_otavio_almeida.tres
msgid "Alô? É a moça da fita amarela?"
msgstr "¿Aló? ¿Es la muchacha de la cinta amarilla?"

#: data/directory/361_otavio_almeida.tres
msgid "Aqui é da central, seu Otávio."
msgstr "Aquí la central, don Otávio."

#: data/directory/361_otavio_almeida.tres
msgid "Ah, é você! Pode me chamar de Otávio, que eu nem tenho trinta."
msgstr "¡Ah, es usted! Dígame Otávio, que ni treinta tengo."

#: data/directory/361_otavio_almeida.tres
msgid "O Trovão fugiu de novo?"
msgstr "¿Trovão se escapó otra vez?"

#: data/directory/361_otavio_almeida.tres
msgid "Hoje não! Tá aqui dormindo no meu pé."
msgstr "¡Hoy no! Está aquí dormido a mis pies."

#: data/directory/361_otavio_almeida.tres
msgid "Boa noite. Amanhã eu pego cedo na estação."
msgstr "Buenas noches. Mañana entro temprano en la estación."

#: data/directory/288_armazem_ferreira.tres
msgid "Joaquim Ferreira"
msgstr "Joaquim Ferreira"

#: data/directory/288_armazem_ferreira.tres
msgid "o Armazém Ferreira"
msgstr "el Armazém Ferreira"

#: data/directory/288_armazem_ferreira.tres
msgid "Quero comprar fósforo e querosene ainda hoje."
msgstr "Quiero comprar fósforos y querosén todavía hoy."

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. Ainda dá pra comprar fósforo e querosene hoje?"
msgstr "Buenas noches. ¿Todavía puedo comprar fósforos y queroseno hoy?"

#: data/directory/288_armazem_ferreira.tres
msgid "A porta já fechou, mas eu atendo pela janela do lado."
msgstr "La puerta ya cerró, pero lo atiendo por la ventana del costado."

#: data/directory/288_armazem_ferreira.tres
msgid "Ótimo. Quero um litro de querosene e duas caixas de fósforo."
msgstr "Perfecto. Quiero un litro de queroseno y dos cajas de fósforos."

#: data/directory/288_armazem_ferreira.tres
msgid "Traz a garrafa, que o querosene eu vendo a granel."
msgstr "Traiga una botella, que el queroseno lo vendo suelto."

#: data/directory/288_armazem_ferreira.tres
msgid "Chego em {wait}. Pode ser?"
msgstr "Llego en {wait}. ¿Está bien?"

#: data/directory/288_armazem_ferreira.tres
msgid "Pode. Só não passa das {hour}, que eu vou deitar."
msgstr "Sí. Pero no pase de las {hour}, que me voy a acostar."

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. Faltou luz aqui e o lampião está seco."
msgstr "Buenas noches. Se cortó la luz aquí y el farol está seco."

#: data/directory/288_armazem_ferreira.tres
msgid "Querosene eu tenho. Quanto você precisa?"
msgstr "Queroseno tengo. ¿Cuánto necesita?"

#: data/directory/288_armazem_ferreira.tres
msgid "Meio litro basta. E uma caixa de fósforo, que a minha molhou."
msgstr "Medio litro alcanza. Y una caja de fósforos, que la mía se mojó."

#: data/directory/288_armazem_ferreira.tres
msgid "Pode vir. Bate na porta dos fundos, que eu escuto."
msgstr "Venga. Golpee la puerta de atrás, que lo escucho."

#: data/directory/288_armazem_ferreira.tres
msgid "Pago amanhã? Hoje estou sem dinheiro trocado."
msgstr "¿Le pago mañana? Hoy no tengo cambio."

#: data/directory/288_armazem_ferreira.tres
msgid "Anoto na caderneta. Paga no fim do mês."
msgstr "Lo anoto en la libreta. Paga a fin de mes."

#: data/directory/288_armazem_ferreira.tres
msgid "Quero saber se amanhã chega querosene."
msgstr "Quiero saber si mañana llega el queroseno."

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. O querosene chega amanhã?"
msgstr "Buenas noches. ¿Mañana llega el queroseno?"

#: data/directory/288_armazem_ferreira.tres
msgid "O caminhão vem amanhã cedo, se a estrada deixar."
msgstr "El camión viene mañana temprano, si el camino lo permite."

#: data/directory/288_armazem_ferreira.tres
msgid "Então separa cinco litros pra mim?"
msgstr "¿Entonces me separa cinco litros?"

#: data/directory/288_armazem_ferreira.tres
msgid "Separo. Passa depois das {hour}, que até lá já descarregou."
msgstr "Se los separo. Pase después de las {hour}, que ya estará descargado."

#: data/directory/288_armazem_ferreira.tres
msgid "Levo o galão vazio. Quanto está o litro?"
msgstr "Llevo el bidón vacío. ¿A cuánto está el litro?"

#: data/directory/288_armazem_ferreira.tres
msgid "Subiu um pouco. Amanhã eu te digo o preço certo."
msgstr "Subió un poco. Mañana le digo el precio exacto."

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. O querosene já acabou aí?"
msgstr "Buenas noches. ¿Ya se acabó el queroseno ahí?"

#: data/directory/288_armazem_ferreira.tres
msgid "Acabou hoje à tarde. Chega mais amanhã, no caminhão."
msgstr "Se acabó esta tarde. Mañana llega más, en el camión."

#: data/directory/288_armazem_ferreira.tres
msgid "Que horas o caminhão costuma chegar?"
msgstr "¿A qué hora suele llegar el camión?"

#: data/directory/288_armazem_ferreira.tres
msgid "Lá pelas {dawn} da manhã. Ele sai da capital de madrugada."
msgstr "Como a las {dawn} de la mañana. Sale de la capital de madrugada."

#: data/directory/288_armazem_ferreira.tres
msgid "Então eu passo cedo, antes de ir pro serviço."
msgstr "Entonces paso temprano, antes de ir al trabajo."

#: data/directory/288_armazem_ferreira.tres
msgid "Vem, que eu guardo um galão no seu nome."
msgstr "Venga, que le guardo un bidón a su nombre."

#: data/directory/288_armazem_ferreira.tres
msgid "Armazém Ferreira, boa noite."
msgstr "Almacén Ferreira, buenas noches."

#: data/directory/288_armazem_ferreira.tres
msgid "do Armazém Ferreira"
msgstr "del Armazém Ferreira"

#: data/directory/288_armazem_ferreira.tres
msgid "pro Armazém Ferreira"
msgstr "con el Armazém Ferreira"

#: data/directory/327_bar_do_ze.tres
msgid "o Bar do Zé"
msgstr "el Bar do Zé"

#: data/directory/327_bar_do_ze.tres
msgid "Preciso dar um recado pra um amigo que tá lá."
msgstr "Necesito dejarle un recado a un amigo que está ahí."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite, Zé. O Baixinho ainda está por aí? O de boné."
msgstr "Buenas noches, Zé. ¿El Petiso sigue por ahí? El de gorra."

#: data/directory/327_bar_do_ze.tres
msgid "Está aqui no balcão. Quer que eu chame?"
msgstr "Está aquí en la barra. ¿Quiere que lo llame?"

#: data/directory/327_bar_do_ze.tres
msgid "Não precisa. Só avisa que amanhã a pescaria mudou pras {dawn}."
msgstr "No hace falta. Solo avísele que mañana la pesca pasó a las {dawn}."

#: data/directory/327_bar_do_ze.tres
msgid "Pras {dawn}. Pode deixar que eu falo."
msgstr "A las {dawn}. Déjelo, que yo le digo."

#: data/directory/327_bar_do_ze.tres
msgid "E diz pra ele não esquecer as iscas, que da outra vez esqueceu."
msgstr "Y dígale que no se olvide la carnada, que la otra vez se la olvidó."

#: data/directory/327_bar_do_ze.tres
msgid "Vou falar. Ele vai reclamar, mas eu falo."
msgstr "Le digo. Va a protestar, pero le digo."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite, Zé. O Alemão passou por aí hoje?"
msgstr "Buenas noches, Zé. ¿El Alemán pasó por ahí hoy?"

#: data/directory/327_bar_do_ze.tres
msgid "Está aqui, jogando dominó."
msgstr "Está aquí, jugando al dominó."

#: data/directory/327_bar_do_ze.tres
msgid "Diz pra ele que o carro dele está pronto, pode buscar."
msgstr "Dígale que su auto está listo, puede pasar a buscarlo."

#: data/directory/327_bar_do_ze.tres
msgid "O carro pronto. E ele paga quando?"
msgstr "El auto listo. ¿Y cuándo paga?"

#: data/directory/327_bar_do_ze.tres
msgid "Amanhã, até as {hour}, senão eu cobro juros."
msgstr "Mañana, hasta las {hour}, si no le cobro intereses."

#: data/directory/327_bar_do_ze.tres
msgid "Vou falar exatamente assim."
msgstr "Se lo digo tal cual."

#: data/directory/327_bar_do_ze.tres
msgid "Acho que esqueci meu chapéu lá."
msgstr "Creo que dejé mi sombrero ahí."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. Acho que esqueci meu chapéu aí hoje à tarde."
msgstr "Buenas noches. Creo que me olvidé el sombrero ahí esta tarde."

#: data/directory/327_bar_do_ze.tres
msgid "Chapéu de palha ou de feltro?"
msgstr "¿Sombrero de paja o de fieltro?"

#: data/directory/327_bar_do_ze.tres
msgid "De feltro, {color}, com uma fita escura."
msgstr "De fieltro, {color}, con una cinta oscura."

#: data/directory/327_bar_do_ze.tres
msgid "Tem um desses pendurado aqui atrás do balcão."
msgstr "Hay uno así colgado detrás de la barra."

#: data/directory/327_bar_do_ze.tres
msgid "É esse! Guarda pra mim, que amanhã eu passo aí."
msgstr "¡Es ese! Guárdemelo, que mañana paso."

#: data/directory/327_bar_do_ze.tres
msgid "Fica guardado. Ninguém mexe nas coisas daqui."
msgstr "Queda guardado. Aquí nadie toca nada."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. Esqueci meu chapéu aí. Alguém achou?"
msgstr "Buenas noches. Me olvidé el sombrero ahí. ¿Alguien lo encontró?"

#: data/directory/327_bar_do_ze.tres
msgid "Achou, sim. Mas tem dois aqui. Como é o seu?"
msgstr "Sí. Pero hay dos aquí. ¿Cómo es el suyo?"

#: data/directory/327_bar_do_ze.tres
msgid "Um {color}, com uma pena do lado."
msgstr "Uno {color}, con una pluma al costado."

#: data/directory/327_bar_do_ze.tres
msgid "Esse está aqui comigo. O outro é de um freguês."
msgstr "Ese lo tengo yo. El otro es de un cliente."

#: data/directory/327_bar_do_ze.tres
msgid "Guarda pra mim? Busco amanhã depois das {hour}."
msgstr "¿Me lo guarda? Lo busco mañana después de las {hour}."

#: data/directory/327_bar_do_ze.tres
msgid "Fica atrás do balcão, esperando."
msgstr "Queda detrás de la barra, esperando."

#: data/directory/327_bar_do_ze.tres
msgid "Quero saber se o jogo ainda tá passando na televisão de lá."
msgstr "Quiero saber si todavía están pasando el partido en la televisión de ahí."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. O jogo ainda está passando aí na televisão?"
msgstr "Buenas noches. ¿El partido sigue en la televisión de ahí?"

#: data/directory/327_bar_do_ze.tres
msgid "Está no segundo tempo. Todo mundo grudado na tela."
msgstr "Va por el segundo tiempo. Todos pegados a la pantalla."

#: data/directory/327_bar_do_ze.tres
msgid "E o placar, como está?"
msgstr "¿Y cómo va el marcador?"

#: data/directory/327_bar_do_ze.tres
msgid "{score}. Quase saiu um gol agora há pouco."
msgstr "{score}. Casi entra un gol hace un rato."

#: data/directory/327_bar_do_ze.tres
msgid "Guarda uma cadeira pra mim, que eu estou indo aí."
msgstr "Guárdeme una silla, que voy para allá."

#: data/directory/327_bar_do_ze.tres
msgid "Vem logo, que aqui não cabe mais ninguém."
msgstr "Venga rápido, que aquí ya no entra nadie."

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. O jogo já acabou aí?"
msgstr "Buenas noches. ¿Ya terminó el partido ahí?"

#: data/directory/327_bar_do_ze.tres
msgid "Acabou agora. Ficou {score}."
msgstr "Terminó recién. Quedó {score}."

#: data/directory/327_bar_do_ze.tres
msgid "E o pessoal, está todo mundo bravo?"
msgstr "¿Y la gente, está todo el mundo enojado?"

#: data/directory/327_bar_do_ze.tres
msgid "Uns comemorando, outros xingando o juiz."
msgstr "Unos festejando, otros insultando al árbitro."

#: data/directory/327_bar_do_ze.tres
msgid "Então nem vou aí hoje."
msgstr "Entonces hoy no voy."

#: data/directory/327_bar_do_ze.tres
msgid "Faz bem. Hoje a discussão está feia."
msgstr "Hace bien. Hoy la discusión está fea."

#: data/directory/327_bar_do_ze.tres
msgid "Bar do Zé! Fala aí, meu chapa!"
msgstr "¡Bar de Zé! ¡Diga, compadre!"

#: data/directory/327_bar_do_ze.tres
msgid "O jogo ainda está passando aí?"
msgstr "¿Todavía están pasando el partido?"

#: data/directory/327_bar_do_ze.tres
msgid "Está no segundo tempo, zero a zero. Uma tristeza."
msgstr "Va en el segundo tiempo, cero a cero. Una tristeza."

#: data/directory/327_bar_do_ze.tres
msgid "Até que horas o bar fica aberto?"
msgstr "¿Hasta qué hora abre el bar?"

#: data/directory/327_bar_do_ze.tres
msgid "Enquanto tiver freguês. Mas a polícia anda mandando fechar cedo."
msgstr "Mientras haya clientes. Pero la policía anda mandando cerrar temprano."

#: data/directory/327_bar_do_ze.tres
msgid "Está muito cheio hoje?"
msgstr "¿Está muy lleno hoy?"

#: data/directory/327_bar_do_ze.tres
msgid "Lotado. Hoje foi dia de pagamento na fábrica."
msgstr "Repleto. Hoy fue día de pago en la fábrica."

#: data/directory/327_bar_do_ze.tres
msgid "Bar do Zé. Com essa chuva, só os de sempre."
msgstr "Bar de Zé. Con esta lluvia, solo los de siempre."

#: data/directory/327_bar_do_ze.tres
msgid "Choveu muito por aí?"
msgstr "¿Llovió mucho por ahí?"

#: data/directory/327_bar_do_ze.tres
msgid "A Rua da Estação virou rio. O Tonho do bilhar chegou de galocha."
msgstr "La Rua da Estação se volvió río. Tonho, el del billar, llegó con botas de goma."

#: data/directory/327_bar_do_ze.tres
msgid "Quanto está a cerveja?"
msgstr "¿Cuánto está la cerveza?"

#: data/directory/327_bar_do_ze.tres
msgid "Três cruzeiros a garrafa. Gelada, hein."
msgstr "Tres cruzeiros la botella. Bien fría, ¿eh?"

#: data/directory/327_bar_do_ze.tres
msgid "Valeu, meu chapa! Aparece aqui qualquer dia."
msgstr "¡Gracias, compadre! Pase por aquí cualquier día."

#: data/directory/327_bar_do_ze.tres
msgid "do Bar do Zé"
msgstr "del Bar do Zé"

#: data/directory/327_bar_do_ze.tres
msgid "pro Bar do Zé"
msgstr "con el Bar do Zé"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "o Sítio Boa Esperança"
msgstr "el Sítio Boa Esperança"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quero encomendar leite e queijo pra amanhã."
msgstr "Quiero encargar leche y queso para mañana."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Queria encomendar leite e queijo pra amanhã."
msgstr "Buenas noches. Quería encargar leche y queso para mañana."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quanto de leite? A ordenha é às {dawn}."
msgstr "¿Cuánta leche? El ordeño es a las {dawn}."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Três litros. E um queijo fresco, dos grandes."
msgstr "Tres litros. Y un queso fresco, de los grandes."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "O fresco só fica pronto de tarde. Serve o curado?"
msgstr "El fresco no está listo hasta la tarde. ¿Le sirve el curado?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Serve. Vocês entregam na {street}?"
msgstr "Sirve. ¿Entregan en {street}?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Entrega a carroça, lá pelas sete. Deixo no portão."
msgstr "Reparte la carreta, como a las siete. Lo dejo en el portón."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Amanhã é aniversário lá em casa. Preciso de leite e queijo."
msgstr "Buenas noches. Mañana hay un cumpleaños en casa. Necesito leche y queso."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quanto vai ser?"
msgstr "¿Cuánto va a ser?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Cinco litros de leite e dois queijos. Vou fazer pão de queijo."
msgstr "Cinco litros de leche y dos quesos. Voy a hacer pan de queso."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Dá. Mas o queijo eu só entrego depois das {hour}."
msgstr "Se puede. Pero el queso lo entrego después de las {hour}."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está ótimo. A festa é de tarde."
msgstr "Está bien. La fiesta es a la tarde."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Então fica combinado. Acerta comigo na entrega."
msgstr "Entonces queda arreglado. Me paga en la entrega."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Meu filho trabalha lá e ainda não voltou pra casa."
msgstr "Mi hijo trabaja allí y todavía no volvió a casa."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Meu filho trabalha aí e ainda não voltou pra casa."
msgstr "Buenas noches. Mi hijo trabaja ahí y todavía no volvió a casa."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "O rapaz do curral? Ficou até mais tarde por causa de uma vaca."
msgstr "¿El muchacho del corral? Se quedó hasta tarde por una vaca."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Ai, que susto. Está tudo bem com ele?"
msgstr "Ay, qué susto. ¿Está bien?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está, sim. A vaca pariu agora há pouco e ele ajudou."
msgstr "Sí, está bien. La vaca parió hace un rato y él ayudó."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "E como ele volta a essa hora? A estrada está escura."
msgstr "¿Y cómo vuelve a esta hora? El camino está oscuro."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Levo ele de charrete daqui a {wait}."
msgstr "Lo llevo en la carreta en {wait}."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Meu filho ainda está aí no sítio?"
msgstr "Buenas noches. ¿Mi hijo sigue ahí en la granja?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está. Ficou consertando a cerca que o boi derrubou."
msgstr "Sí. Se quedó arreglando la cerca que tiró el buey."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "A janta dele está esfriando. Ele demora?"
msgstr "Se le está enfriando la cena. ¿Tarda mucho?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Falta pouco. Ele disse que chega antes das {hour}."
msgstr "Falta poco. Dijo que llega antes de las {hour}."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Pede pra ele vir pela estrada, não pelo mato."
msgstr "Dígale que venga por el camino, no por el monte."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Pode deixar. Empresto a lanterna pra ele."
msgstr "Descuide. Le presto la linterna."

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Sítio Boa Esperança, pois não?"
msgstr "Granja Boa Esperança, ¿dígame?"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "do Sítio Boa Esperança"
msgstr "del Sítio Boa Esperança"

#: data/directory/209_sitio_boa_esperanca.tres
msgid "pro Sítio Boa Esperança"
msgstr "con el Sítio Boa Esperança"

#: data/directory/193_corpo_de_bombeiros.tres data/directory/190_delegacia_de_policia.tres data/directory/192_hospital_municipal.tres
msgid "use o despacho"
msgstr "use el despacho"

#: data/directory/120_casa_paroquial.tres
msgid "Pe. Anselmo"
msgstr "Pe. Anselmo"

#: data/directory/120_casa_paroquial.tres
msgid "a Casa Paroquial"
msgstr "la Casa Paroquial"

#: data/directory/120_casa_paroquial.tres
msgid "Preciso marcar uma missa de sétimo dia."
msgstr "Necesito pedir una misa de séptimo día."

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Queria marcar uma missa de sétimo dia."
msgstr "Buenas noches. Quería encargar una misa de séptimo día."

#: data/directory/120_casa_paroquial.tres
msgid "Meus pêsames. Pra quando seria?"
msgstr "Mi más sentido pésame. ¿Para cuándo sería?"

#: data/directory/120_casa_paroquial.tres
msgid "Pra quinta-feira. Pode ser na missa das sete?"
msgstr "Para el jueves. ¿Puede ser en la misa de las siete?"

#: data/directory/120_casa_paroquial.tres
msgid "Pode. Qual o nome do falecido, pra ler no altar?"
msgstr "Sí. ¿Cuál es el nombre del difunto, para leerlo en el altar?"

#: data/directory/120_casa_paroquial.tres
msgid "Teodoro Bastos. Era meu avô."
msgstr "Teodoro Bastos. Era mi abuelo."

#: data/directory/120_casa_paroquial.tres
msgid "Anotado. Quinta, às sete, pelo Teodoro Bastos."
msgstr "Anotado. Jueves a las siete, por Teodoro Bastos."

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Minha tia faleceu e a família quer a missa de sétimo dia."
msgstr "Buenas noches. Falleció mi tía y la familia quiere la misa de séptimo día."

#: data/directory/120_casa_paroquial.tres
msgid "Sinto muito. Domingo tem missa às oito e às dez."
msgstr "Lo siento mucho. El domingo hay misa a las ocho y a las diez."

#: data/directory/120_casa_paroquial.tres
msgid "Às dez é melhor, que vem gente de fora."
msgstr "A las diez es mejor, que viene gente de afuera."

#: data/directory/120_casa_paroquial.tres
msgid "Então fica às dez. Vão querer o coral?"
msgstr "Entonces queda a las diez. ¿Van a querer el coro?"

#: data/directory/120_casa_paroquial.tres
msgid "Se puder, sim. Ela cantava no coral quando era moça."
msgstr "Si se puede, sí. Ella cantaba en el coro de joven."

#: data/directory/120_casa_paroquial.tres
msgid "Eu falo com as moças do coral amanhã cedo."
msgstr "Mañana temprano hablo con las señoras del coro."

#: data/directory/120_casa_paroquial.tres
msgid "Quero pedir uma visita do padre pra minha mãe, que está de cama."
msgstr "Quiero pedir que el padre visite a mi madre, que está en cama."

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Minha mãe está de cama e queria uma visita do padre."
msgstr "Buenas noches. Mi madre está en cama y quería una visita del padre."

#: data/directory/120_casa_paroquial.tres
msgid "Ela está muito mal?"
msgstr "¿Está muy mal?"

#: data/directory/120_casa_paroquial.tres
msgid "Não, graças a Deus. Mas não sai de casa faz um mês e sente falta da missa."
msgstr "No, gracias a Dios. Pero hace un mes que no sale y extraña la misa."

#: data/directory/120_casa_paroquial.tres
msgid "Amanhã, depois da missa das sete, alguém leva a comunhão."
msgstr "Mañana, después de la misa de las siete, alguien le lleva la comunión."

#: data/directory/120_casa_paroquial.tres
msgid "Ela mora na {street}, número {house}."
msgstr "Vive en {street}, número {house}."

#: data/directory/120_casa_paroquial.tres
msgid "Anotado. Deixa o portão aberto, por favor."
msgstr "Anotado. Deje el portón abierto, por favor."

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Dá pra pedir que o padre passe lá em casa? Minha mãe pediu."
msgstr "Buenas noches. ¿Podría el padre pasar por casa? Mi madre lo pidió."

#: data/directory/120_casa_paroquial.tres
msgid "Ela está doente?"
msgstr "¿Está enferma?"

#: data/directory/120_casa_paroquial.tres
msgid "Quebrou a perna e está de cama. Queria se confessar."
msgstr "Se quebró la pierna y está en cama. Quería confesarse."

#: data/directory/120_casa_paroquial.tres
msgid "Sábado de manhã dá. Lá pelas {hour}, depois das visitas do hospital."
msgstr "El sábado a la mañana se puede. Como a las {hour}, después del hospital."

#: data/directory/120_casa_paroquial.tres
msgid "Está ótimo. Ela vai ficar tão contente."
msgstr "Perfecto. Se va a poner tan contenta."

#: data/directory/120_casa_paroquial.tres
msgid "Diga a ela que vamos rezar por ela."
msgstr "Dígale que vamos a rezar por ella."

#: data/directory/120_casa_paroquial.tres data/nights/night_10.tres data/nights/night_15.tres
msgid "Casa Paroquial, boa noite."
msgstr "Casa parroquial, buenas noches."

#: data/directory/120_casa_paroquial.tres
msgid "da Casa Paroquial"
msgstr "de la Casa Paroquial"

#: data/directory/120_casa_paroquial.tres
msgid "pra Casa Paroquial"
msgstr "con la Casa Paroquial"

#: data/directory/344_cine_odeon.tres
msgid "o Cine Odeon"
msgstr "el Cine Odeon"

#: data/directory/344_cine_odeon.tres
msgid "Quero saber que filme passa amanhã."
msgstr "Quiero saber qué película pasan mañana."

#: data/directory/344_cine_odeon.tres
msgid "Boa noite. Que filme passa amanhã?"
msgstr "Buenas noches. ¿Qué película dan mañana?"

#: data/directory/344_cine_odeon.tres
msgid "Amanhã passa {film}, na sessão das {hour}."
msgstr "Mañana dan {film}, en la función de las {hour}."

#: data/directory/344_cine_odeon.tres
msgid "Lá em casa todo mundo vai gostar."
msgstr "En casa a todos les va a gustar."

#: data/directory/344_cine_odeon.tres
msgid "Chega cedo, que a sala enche."
msgstr "Llegue temprano, que la sala se llena."

#: data/directory/344_cine_odeon.tres
msgid "Precisa comprar o ingresso antes?"
msgstr "¿Hay que comprar la entrada antes?"

#: data/directory/344_cine_odeon.tres
msgid "A bilheteria abre meia hora antes da sessão."
msgstr "La boletería abre media hora antes de la función."

#: data/directory/344_cine_odeon.tres
msgid "Boa noite. Amanhã tem matinê?"
msgstr "Buenas noches. ¿Mañana hay matiné?"

#: data/directory/344_cine_odeon.tres
msgid "Tem, às três da tarde. É {film}."
msgstr "Sí, a las tres de la tarde. Es {film}."

#: data/directory/344_cine_odeon.tres
msgid "Criança pode entrar?"
msgstr "¿Pueden entrar los chicos?"

#: data/directory/344_cine_odeon.tres
msgid "Pode, acompanhada de um adulto."
msgstr "Sí, acompañados de un adulto."

#: data/directory/344_cine_odeon.tres
msgid "Então vou levar meus sobrinhos."
msgstr "Entonces llevo a mis sobrinos."

#: data/directory/344_cine_odeon.tres
msgid "Chega cedo, que matinê lota."
msgstr "Llegue temprano, que la matiné se llena."

#: data/directory/344_cine_odeon.tres
msgid "Esqueci meu guarda-chuva na sessão das oito."
msgstr "Dejé mi paraguas en la función de las ocho."

#: data/directory/344_cine_odeon.tres
msgid "Boa noite. Esqueci um guarda-chuva na sessão das oito."
msgstr "Buenas noches. Me olvidé un paraguas en la función de las ocho."

#: data/directory/344_cine_odeon.tres
msgid "O lanterninha recolheu uns três hoje. Como é o seu?"
msgstr "El acomodador juntó como tres hoy. ¿Cómo es el suyo?"

#: data/directory/344_cine_odeon.tres
msgid "{color}, com o cabo de madeira curvado."
msgstr "{color}, con el mango de madera curvo."

#: data/directory/344_cine_odeon.tres
msgid "Tem um assim aqui na bilheteria."
msgstr "Hay uno así aquí en la boletería."

#: data/directory/344_cine_odeon.tres
msgid "Ainda bem. Posso buscar amanhã?"
msgstr "Menos mal. ¿Puedo buscarlo mañana?"

#: data/directory/344_cine_odeon.tres
msgid "Pode. É só pedir na bilheteria."
msgstr "Sí. Solo pídalo en la boletería."

#: data/directory/344_cine_odeon.tres
msgid "Boa noite. Deixei meu guarda-chuva na poltrona, na sessão das oito."
msgstr "Buenas noches. Dejé el paraguas en la butaca, en la función de las ocho."

#: data/directory/344_cine_odeon.tres
msgid "Em que fileira você sentou?"
msgstr "¿En qué fila se sentó?"

#: data/directory/344_cine_odeon.tres
msgid "Lá no fundo, perto da porta."
msgstr "Allá al fondo, cerca de la puerta."

#: data/directory/344_cine_odeon.tres
msgid "O lanterninha achou um {color} lá atrás."
msgstr "El acomodador encontró uno {color} allá atrás."

#: data/directory/344_cine_odeon.tres
msgid "Deve ser o meu. Posso buscar amanhã?"
msgstr "Debe ser el mío. ¿Puedo buscarlo mañana?"

#: data/directory/344_cine_odeon.tres
msgid "Pode. Fica guardado na bilheteria."
msgstr "Sí. Queda guardado en la boletería."

#: data/directory/344_cine_odeon.tres
msgid "Cine Odeon, boa noite."
msgstr "Cine Odeón, buenas noches."

#: data/directory/344_cine_odeon.tres
msgid "Que filme está passando hoje?"
msgstr "¿Qué película dan hoy?"

#: data/directory/344_cine_odeon.tres
msgid "Um faroeste italiano. A última sessão começa às nove e meia."
msgstr "Un western italiano. La última función empieza a las nueve y media."

#: data/directory/344_cine_odeon.tres
msgid "Quanto é o ingresso?"
msgstr "¿Cuánto cuesta la entrada?"

#: data/directory/344_cine_odeon.tres
msgid "Quatro cruzeiros. Estudante paga meia, com a carteirinha."
msgstr "Cuatro cruzeiros. Los estudiantes pagan la mitad, con el carné."

#: data/directory/344_cine_odeon.tres
msgid "Odeon, bilheteria."
msgstr "Odeón, boletería."

#: data/directory/344_cine_odeon.tres
msgid "Ainda tem lugar na última sessão?"
msgstr "¿Todavía hay lugar en la última función?"

#: data/directory/344_cine_odeon.tres
msgid "Tem, sim. A plateia de baixo está quase vazia."
msgstr "Sí, hay. La platea de abajo está casi vacía."

#: data/directory/344_cine_odeon.tres
msgid "Alguém esqueceu alguma coisa aí hoje?"
msgstr "¿Alguien olvidó algo ahí hoy?"

#: data/directory/344_cine_odeon.tres
msgid "Um guarda-chuva preto e uma luva. Está tudo aqui na bilheteria."
msgstr "Un paraguas negro y un guante. Está todo aquí en la boletería."

#: data/directory/344_cine_odeon.tres
msgid "do Cine Odeon"
msgstr "del Cine Odeon"

#: data/directory/344_cine_odeon.tres
msgid "pro Cine Odeon"
msgstr "con el Cine Odeon"

#: data/directory/213_hospital_sao_lucas.tres
msgid "recepção"
msgstr "recepción"

#: data/directory/213_hospital_sao_lucas.tres
msgid "Hospital São Lucas, recepção."
msgstr "Hospital São Lucas, recepción."

#: data/directory/155_tv_orbital.tres
msgid "a TV Orbital"
msgstr "la TV Orbital"

#: data/directory/155_tv_orbital.tres
msgid "Quero saber qual é o filme de sábado."
msgstr "Quiero saber cuál es la película del sábado."

#: data/directory/155_tv_orbital.tres
msgid "Boa noite. É da TV Orbital? Qual é o filme de sábado?"
msgstr "Buenas noches. ¿Es la TV Orbital? ¿Cuál es la película del sábado?"

#: data/directory/155_tv_orbital.tres
msgid "É, sim. Sábado passa um faroeste, depois do jornal."
msgstr "Sí. El sábado dan un western, después del noticiero."

#: data/directory/155_tv_orbital.tres
msgid "Faroeste! Lá em casa vão gostar. Começa a que horas?"
msgstr "¡Un western! En casa les va a gustar. ¿A qué hora empieza?"

#: data/directory/155_tv_orbital.tres
msgid "Logo depois do jornal das {hour}."
msgstr "Justo después del noticiero de las {hour}."

#: data/directory/155_tv_orbital.tres
msgid "Vou avisar todo mundo. Boa noite."
msgstr "Voy a avisar a todos. Buenas noches."

#: data/directory/155_tv_orbital.tres data/content.tres
msgid "Disponha. Boa noite."
msgstr "A la orden. Buenas noches."

#: data/directory/155_tv_orbital.tres
msgid "Boa noite. Vocês já sabem o filme da sessão de sábado?"
msgstr "Buenas noches. ¿Ya saben la película de la función del sábado?"

#: data/directory/155_tv_orbital.tres
msgid "Ainda não chegou a fita. Deve ser uma comédia."
msgstr "Todavía no llegó la cinta. Debe ser una comedia."

#: data/directory/155_tv_orbital.tres
msgid "Comédia está bom. Passa no horário de sempre?"
msgstr "Una comedia está bien. ¿A la hora de siempre?"

#: data/directory/155_tv_orbital.tres
msgid "No de sempre, depois do jornal."
msgstr "A la de siempre, después del noticiero."

#: data/directory/155_tv_orbital.tres
msgid "Então está combinado. Agradeço a informação."
msgstr "Entonces queda así. Gracias por la información."

#: data/directory/155_tv_orbital.tres
msgid "Por nada. Boa noite."
msgstr "De nada. Buenas noches."

#: data/directory/155_tv_orbital.tres
msgid "A imagem do canal está chuviscando."
msgstr "La imagen del canal tiene lluvia."

#: data/directory/155_tv_orbital.tres
msgid "Boa noite. A imagem do canal está chuviscando aqui. É problema de vocês?"
msgstr "Buenas noches. La imagen del canal tiene lluvia aquí. ¿Es problema de ustedes?"

#: data/directory/155_tv_orbital.tres
msgid "Deve ser o tempo. A antena da serra anda falhando com o vento."
msgstr "Debe ser el tiempo. La antena de la sierra anda fallando con el viento."

#: data/directory/155_tv_orbital.tres
msgid "Então não adianta mexer na antena de casa?"
msgstr "¿Entonces no sirve mover la antena de casa?"

#: data/directory/155_tv_orbital.tres
msgid "Pode tentar virar um pouco para a serra. Se não melhorar, é daqui."
msgstr "Puede intentar girarla un poco hacia la sierra. Si no mejora, es de aquí."

#: data/directory/155_tv_orbital.tres
msgid "Vou tentar, então. Boa noite."
msgstr "Voy a intentar, entonces. Buenas noches."

#: data/directory/155_tv_orbital.tres data/directory/296_alta_cupula.tres data/directory/184_delegacia_plantao.tres
msgid "Boa noite."
msgstr "Buenas noches."

#: data/directory/155_tv_orbital.tres
msgid "Boa noite. Sumiu o som do canal faz meia hora."
msgstr "Buenas noches. Se fue el sonido del canal hace media hora."

#: data/directory/155_tv_orbital.tres
msgid "Estamos sabendo. O técnico já está mexendo no transmissor."
msgstr "Ya sabemos. El técnico ya está trabajando en el transmisor."

#: data/directory/155_tv_orbital.tres
msgid "Volta ainda hoje?"
msgstr "¿Vuelve todavía hoy?"

#: data/directory/155_tv_orbital.tres
msgid "Ele disse que até as {hour} resolve."
msgstr "Dijo que para las {hour} lo resuelve."

#: data/directory/155_tv_orbital.tres
msgid "Tomara. Não quero perder o fim da novela."
msgstr "Ojalá. No quiero perderme el final de la novela."

#: data/directory/155_tv_orbital.tres
msgid "Vai dar tempo. Boa noite."
msgstr "Va a dar tiempo. Buenas noches."

#: data/directory/155_tv_orbital.tres
msgid "TV Orbital, boa noite."
msgstr "TV Orbital, buenas noches."

#: data/directory/155_tv_orbital.tres
msgid "da TV Orbital"
msgstr "de la TV Orbital"

#: data/directory/155_tv_orbital.tres
msgid "pra TV Orbital"
msgstr "a la TV Orbital"

#: data/directory/223_marta_costa.tres
msgid "a Dona Marta Costa"
msgstr "Dona Marta Costa"

#: data/directory/223_marta_costa.tres
msgid "Ela é minha comadre. Quero saber como ela está."
msgstr "Es mi comadre. Quiero saber cómo está."

#: data/directory/223_marta_costa.tres
msgid "Comadre, boa noite! Liguei pra saber como você está."
msgstr "¡Comadre, buenas noches! Llamé para saber cómo estás."

#: data/directory/223_marta_costa.tres
msgid "Ah, que bom ouvir sua voz. Estou melhor da gripe."
msgstr "Ay, qué lindo oír tu voz. Ya estoy mejor de la gripe."

#: data/directory/223_marta_costa.tres
msgid "E a tosse, passou?"
msgstr "¿Y la tos, se te pasó?"

#: data/directory/223_marta_costa.tres
msgid "Quase. Estou tomando chá de limão com mel toda noite."
msgstr "Casi. Tomo té de limón con miel todas las noches."

#: data/directory/223_marta_costa.tres
msgid "Amanhã eu levo uma canja aí, lá pelas {hour}."
msgstr "Mañana te llevo un caldo de gallina, como a las {hour}."

#: data/directory/223_marta_costa.tres
msgid "Vem, sim. E traz o afilhado, que estou com saudade."
msgstr "Ven, sí. Y trae a mi ahijado, que lo extraño."

#: data/directory/223_marta_costa.tres
msgid "Boa noite, comadre. Fiquei sabendo que você caiu no quintal."
msgstr "Buenas noches, comadre. Me enteré de que te caíste en el patio."

#: data/directory/223_marta_costa.tres
msgid "Caí, mas foi só o tornozelo. Já está enfaixado."
msgstr "Sí, pero fue solo el tobillo. Ya está vendado."

#: data/directory/223_marta_costa.tres
msgid "E quem está cuidando de você?"
msgstr "¿Y quién te está cuidando?"

#: data/directory/223_marta_costa.tres
msgid "Minha sobrinha vem de manhã. De noite fico com o rádio."
msgstr "Mi sobrina viene a la mañana. De noche me acompaña la radio."

#: data/directory/223_marta_costa.tres
msgid "Amanhã eu passo aí e faço o almoço."
msgstr "Mañana paso y te hago el almuerzo."

#: data/directory/223_marta_costa.tres
msgid "Não precisa, mas eu aceito. Traz o pão da padaria."
msgstr "No hace falta, pero acepto. Trae pan de la panadería."

#: data/directory/223_marta_costa.tres
msgid "Ela ficou de me devolver uma panela."
msgstr "Quedó en devolverme una olla."

#: data/directory/223_marta_costa.tres
msgid "Boa noite, Marta. Lembra da panela de pressão que eu te emprestei?"
msgstr "Buenas noches, Marta. ¿Te acuerdas de la olla a presión que te presté?"

#: data/directory/223_marta_costa.tres
msgid "Lembro! Está aqui lavadinha, esperando você."
msgstr "¡Sí! Está aquí lavadita, esperándote."

#: data/directory/223_marta_costa.tres
msgid "Preciso dela amanhã. Vou cozinhar feijão pra festa."
msgstr "La necesito mañana. Voy a cocinar frijoles para la fiesta."

#: data/directory/223_marta_costa.tres
msgid "Eu levo aí de manhã, lá pelas {hour}."
msgstr "Te la llevo a la mañana, como a las {hour}."

#: data/directory/223_marta_costa.tres
msgid "E a borracha da tampa, ainda está boa?"
msgstr "¿Y la goma de la tapa sigue buena?"

#: data/directory/223_marta_costa.tres
msgid "Troquei. A outra estava gasta, pus uma nova."
msgstr "La cambié. La otra estaba gastada, le puse una nueva."

#: data/directory/223_marta_costa.tres
msgid "Oi, Marta. Desculpa a hora. É por causa da panela grande."
msgstr "Hola, Marta. Perdón la hora. Es por la olla grande."

#: data/directory/223_marta_costa.tres
msgid "Ai, eu esqueci! Usei no domingo e ficou aqui."
msgstr "¡Ay, me olvidé! La usé el domingo y quedó aquí."

#: data/directory/223_marta_costa.tres
msgid "Não tem pressa. Mas amanhã vou fazer doce de goiaba."
msgstr "No hay apuro. Pero mañana voy a hacer dulce de guayaba."

#: data/directory/223_marta_costa.tres
msgid "Então eu levo cedo. E quero provar o doce, viu?"
msgstr "Entonces te la llevo temprano. Y quiero probar el dulce, eh."

#: data/directory/223_marta_costa.tres
msgid "Separo um pote pra você."
msgstr "Te guardo un frasco."

#: data/directory/223_marta_costa.tres
msgid "Lá pelas {hour} eu passo aí."
msgstr "Como a las {hour} paso."

#: data/directory/223_marta_costa.tres
msgid "da Dona Marta Costa"
msgstr "de Dona Marta Costa"

#: data/directory/223_marta_costa.tres
msgid "pra Dona Marta Costa"
msgstr "con Dona Marta Costa"

#: data/directory/280_laudelina_prado.tres
msgid "a Dona Laudelina Prado"
msgstr "Dona Laudelina Prado"

#: data/directory/280_laudelina_prado.tres
msgid "Ela está costurando o vestido de noiva da minha filha."
msgstr "Ella está cosiendo el vestido de novia de mi hija."

#: data/directory/280_laudelina_prado.tres
msgid "Boa noite, Dona Laudelina. Como está o vestido da minha filha?"
msgstr "Buenas noches, doña Laudelina. ¿Cómo va el vestido de mi hija?"

#: data/directory/280_laudelina_prado.tres
msgid "Falta a barra e os botões das costas. Quase pronto."
msgstr "Faltan el dobladillo y los botones de la espalda. Casi listo."

#: data/directory/280_laudelina_prado.tres
msgid "O casamento é sábado. Dá tempo?"
msgstr "La boda es el sábado. ¿Llega a tiempo?"

#: data/directory/280_laudelina_prado.tres
msgid "Dá. Mas ela precisa vir provar amanhã, às {hour}."
msgstr "Sí. Pero tiene que venir a probárselo mañana a las {hour}."

#: data/directory/280_laudelina_prado.tres
msgid "Ela vai. E o véu, a senhora também faz?"
msgstr "Va a ir. ¿Y el velo, también lo hace usted?"

#: data/directory/280_laudelina_prado.tres
msgid "Faço, se trouxer a renda. Eu não tenho mais aqui."
msgstr "Sí, si trae el encaje. Aquí ya no me queda."

#: data/directory/280_laudelina_prado.tres
msgid "Boa noite. Desculpa ligar tarde, é sobre o vestido de noiva."
msgstr "Buenas noches. Perdón por llamar tarde, es por el vestido de novia."

#: data/directory/280_laudelina_prado.tres
msgid "Pode falar. Estou aqui mesmo com ele na máquina."
msgstr "Diga. Justo lo tengo en la máquina."

#: data/directory/280_laudelina_prado.tres
msgid "Minha filha emagreceu. Acho que vai ficar largo."
msgstr "Mi hija adelgazó. Creo que le va a quedar grande."

#: data/directory/280_laudelina_prado.tres
msgid "Então eu aperto na cintura. Ela vem provar quando?"
msgstr "Entonces lo achico en la cintura. ¿Cuándo viene a probárselo?"

#: data/directory/280_laudelina_prado.tres
msgid "Amanhã, depois do serviço. Lá pelas {hour}?"
msgstr "Mañana, después del trabajo. ¿Como a las {hour}?"

#: data/directory/280_laudelina_prado.tres
msgid "Pode vir. Deixo a luz da varanda acesa."
msgstr "Que venga. Dejo la luz del porche encendida."

#: data/directory/280_laudelina_prado.tres
msgid "Ela pediu pra eu ligar quando chegasse."
msgstr "Me pidió que la llamara cuando llegara."

#: data/directory/280_laudelina_prado.tres
msgid "Dona Laudelina? Cheguei. A senhora pediu pra eu avisar."
msgstr "¿Doña Laudelina? Llegué. Usted me pidió que le avisara."

#: data/directory/280_laudelina_prado.tres
msgid "Graças a Deus. Com essa estrada escura eu fico aflita."
msgstr "Gracias a Dios. Con ese camino oscuro me quedo preocupada."

#: data/directory/280_laudelina_prado.tres
msgid "O ônibus atrasou {wait}, mas chegou."
msgstr "El autobús se atrasó {wait}, pero llegó."

#: data/directory/280_laudelina_prado.tres
msgid "E o pacote que eu mandei, entregou?"
msgstr "¿Y el paquete que te mandé, lo entregaste?"

#: data/directory/280_laudelina_prado.tres
msgid "Entreguei, e sua irmã mandou um beijo."
msgstr "Sí, y su hermana le manda un beso."

#: data/directory/280_laudelina_prado.tres
msgid "Ah, que bom. Agora vai descansar."
msgstr "Ay, qué bueno. Ahora ve a descansar."

#: data/directory/280_laudelina_prado.tres
msgid "Boa noite, Dona Laudelina. Só pra avisar que cheguei bem."
msgstr "Buenas noches, doña Laudelina. Solo para avisarle que llegué bien."

#: data/directory/280_laudelina_prado.tres
msgid "Ah, que alívio. Choveu muito na serra?"
msgstr "Ay, qué alivio. ¿Llovió mucho en la sierra?"

#: data/directory/280_laudelina_prado.tres
msgid "Bastante. A estrada tinha barro até o meio da roda."
msgstr "Bastante. El barro llegaba a la mitad de la rueda."

#: data/directory/280_laudelina_prado.tres
msgid "E você trouxe o tecido que eu pedi?"
msgstr "¿Y trajiste la tela que te pedí?"

#: data/directory/280_laudelina_prado.tres
msgid "Trouxe. Três metros de cetim, {color}."
msgstr "Sí. Tres metros de satén, {color}."

#: data/directory/280_laudelina_prado.tres
msgid "Que maravilha. Amanhã cedo eu passo aí pra buscar."
msgstr "Qué maravilla. Mañana temprano paso a buscarla."

#: data/directory/280_laudelina_prado.tres
msgid "da Dona Laudelina Prado"
msgstr "de Dona Laudelina Prado"

#: data/directory/280_laudelina_prado.tres
msgid "pra Dona Laudelina Prado"
msgstr "con Dona Laudelina Prado"

#: data/directory/118_farmacia_central.tres
msgid "a Farmácia Central"
msgstr "la Farmácia Central"

#: data/directory/118_farmacia_central.tres
msgid "Quero saber se tem remédio pra enjoo."
msgstr "Quiero saber si tienen remedio para el mareo."

#: data/directory/118_farmacia_central.tres
msgid "Boa noite. Vocês têm remédio pra enjoo?"
msgstr "Buenas noches. ¿Tienen algo para las náuseas?"

#: data/directory/118_farmacia_central.tres
msgid "Tenho. É pra criança ou pra adulto?"
msgstr "Sí. ¿Es para un niño o para un adulto?"

#: data/directory/118_farmacia_central.tres
msgid "Pra mim. Vou viajar de ônibus amanhã e passo mal na serra."
msgstr "Para mí. Mañana viajo en autobús y en la sierra me mareo."

#: data/directory/118_farmacia_central.tres
msgid "Então toma um comprimido meia hora antes de sair."
msgstr "Entonces tome un comprimido media hora antes de salir."

#: data/directory/118_farmacia_central.tres
msgid "Posso buscar agora? Moro na {street}."
msgstr "¿Puedo ir a buscarlo ahora? Vivo en {street}."

#: data/directory/118_farmacia_central.tres
msgid "Pode. Toca a campainha, que eu estou de plantão."
msgstr "Sí. Toque el timbre, que estoy de turno."

#: data/directory/118_farmacia_central.tres
msgid "Boa noite. Meu filho está enjoado desde a janta."
msgstr "Buenas noches. Mi hijo tiene náuseas desde la cena."

#: data/directory/118_farmacia_central.tres
msgid "Ele vomitou? Tem febre?"
msgstr "¿Vomitó? ¿Tiene fiebre?"

#: data/directory/118_farmacia_central.tres
msgid "Vomitou uma vez. Febre, não."
msgstr "Una vez. Fiebre, no."

#: data/directory/118_farmacia_central.tres
msgid "Dá soro caseiro aos golinhos. E tenho um xarope que ajuda."
msgstr "Dele suero casero a sorbitos. Y tengo un jarabe que ayuda."

#: data/directory/118_farmacia_central.tres
msgid "Vou buscar. Chego em {wait}."
msgstr "Voy a buscarlo. Llego en {wait}."

#: data/directory/118_farmacia_central.tres
msgid "Estou esperando. Se a febre vier, chama o médico."
msgstr "Lo espero. Si le sube la fiebre, llame al médico."

#: data/directory/118_farmacia_central.tres data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Preciso de um remédio pra pressão."
msgstr "Necesito un remedio para la presión."

#: data/directory/118_farmacia_central.tres
msgid "Boa noite. Acabou o remédio de pressão do meu pai."
msgstr "Buenas noches. Se le acabó el remedio de la presión a mi padre."

#: data/directory/118_farmacia_central.tres
msgid "Tem a receita? É qual remédio?"
msgstr "¿Tiene la receta? ¿Qué remedio es?"

#: data/directory/118_farmacia_central.tres
msgid "Tenho a caixa vazia aqui. O médico deu receita pra seis meses."
msgstr "Tengo la caja vacía aquí. El médico le recetó para seis meses."

#: data/directory/118_farmacia_central.tres
msgid "Então traz a caixa e a receita, que eu vejo."
msgstr "Entonces traiga la caja y la receta, que lo reviso."

#: data/directory/118_farmacia_central.tres
msgid "Ele toma às {hour}. Ainda dá tempo?"
msgstr "Lo toma a las {hour}. ¿Todavía llego?"

#: data/directory/118_farmacia_central.tres
msgid "Dá. Vem logo, que eu fecho a porta e atendo pela janela."
msgstr "Sí. Venga ya, que cierro la puerta y atiendo por la ventana."

#: data/directory/118_farmacia_central.tres
msgid "Boa noite. A pressão da minha mãe subiu. Tem remédio aí?"
msgstr "Buenas noches. A mi madre le subió la presión. ¿Tiene remedio?"

#: data/directory/118_farmacia_central.tres
msgid "Tenho, mas sem receita não posso vender. Ela já toma algum?"
msgstr "Sí, pero sin receta no puedo venderlo. ¿Ya toma alguno?"

#: data/directory/118_farmacia_central.tres
msgid "Toma, mas acabou ontem. A receita está com ela."
msgstr "Sí, pero se le acabó ayer. Ella tiene la receta."

#: data/directory/118_farmacia_central.tres
msgid "Então traz a receita. E mede a pressão de novo daqui a {wait}."
msgstr "Entonces traiga la receta. Y tómele la presión de nuevo en {wait}."

#: data/directory/118_farmacia_central.tres
msgid "E se continuar alta?"
msgstr "¿Y si sigue alta?"

#: data/directory/118_farmacia_central.tres
msgid "Aí liga pro médico, ou pra central chamar o hospital."
msgstr "Entonces llame al médico, o a la central para el hospital."

#: data/directory/118_farmacia_central.tres
msgid "Farmácia Central, boa noite."
msgstr "Farmacia Central, buenas noches."

#: data/directory/118_farmacia_central.tres
msgid "da Farmácia Central"
msgstr "de la Farmácia Central"

#: data/directory/118_farmacia_central.tres
msgid "pra Farmácia Central"
msgstr "con la Farmácia Central"

#: data/directory/162_farmacia_santa_rita.tres
msgid "a Farmácia Santa Rita"
msgstr "la Farmácia Santa Rita"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Meu neto está com febre."
msgstr "Mi nieto tiene fiebre."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Meu neto está com febre desde a tarde."
msgstr "Buenas noches. Mi nieto tiene fiebre desde la tarde."

#: data/directory/162_farmacia_santa_rita.tres data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Quantos anos ele tem?"
msgstr "¿Cuántos años tiene?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Quatro. Está quente e não quer comer nada."
msgstr "Cuatro. Está caliente y no quiere comer nada."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Tenho um antitérmico em gotas. Dez gotas a cada seis horas."
msgstr "Tengo un antifebril en gotas. Diez gotas cada seis horas."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Mando o meu genro buscar em {wait}."
msgstr "Mando a mi yerno a buscarlo en {wait}."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Está bem. E põe um pano úmido na testa dele."
msgstr "Está bien. Y póngale un paño húmedo en la frente."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Meu neto acordou ardendo em febre."
msgstr "Buenas noches. Mi nieto se despertó ardiendo en fiebre."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Já mediu? Quanto deu?"
msgstr "¿Le tomó la temperatura? ¿Cuánto tiene?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Trinta e oito e meio. Ele está chorando muito."
msgstr "Treinta y ocho y medio. Está llorando mucho."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Dá um banho morno e eu separo o xarope pra febre."
msgstr "Dele un baño tibio y le separo el jarabe para la fiebre."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Moro na {street}. Vocês entregam?"
msgstr "Vivo en {street}. ¿Hacen entregas?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Meu filho leva de bicicleta. Chega em {wait}."
msgstr "Mi hijo se lo lleva en bicicleta. Llega en {wait}."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Preciso de um remédio pra dor de dente."
msgstr "Necesito un remedio para el dolor de muelas."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Estou com uma dor de dente que não aguento."
msgstr "Buenas noches. Tengo un dolor de muelas que no aguanto."

#: data/directory/162_farmacia_santa_rita.tres
msgid "É no dente de cima ou de baixo? Está inchado?"
msgstr "¿Es una muela de arriba o de abajo? ¿Está hinchada?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "De baixo, no fundo. Inchou um pouco o rosto."
msgstr "De abajo, al fondo. Se me hinchó un poco la cara."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Tenho um comprimido pra dor. Mas amanhã procura o dentista."
msgstr "Tengo una pastilla para el dolor. Pero mañana vaya al dentista."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Vou, sim. Posso passar aí agora?"
msgstr "Sí, voy. ¿Puedo pasar ahora?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Pode. E enquanto isso, compressa fria no rosto."
msgstr "Sí. Y mientras tanto, compresas frías en la cara."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Lá em casa ninguém dorme por causa de uma dor de dente."
msgstr "Buenas noches. En casa nadie duerme por un dolor de muelas."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Já tentou cravo? Põe um no dente que alivia."
msgstr "¿Probó con clavo de olor? Póngale uno en la muela, que alivia."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Já, e não adiantou. Precisa de remédio mesmo."
msgstr "Sí, y no sirvió. Hace falta un remedio de verdad."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Então eu separo um analgésico. Vem buscar até as {hour}."
msgstr "Entonces le separo un analgésico. Venga a buscarlo antes de las {hour}."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Chego em {wait}. Deus lhe pague."
msgstr "Llego en {wait}. Dios se lo pague."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Vem pela porta do lado, que a da frente já fechou."
msgstr "Venga por la puerta del costado, que la de adelante ya cerró."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Quero saber se tem xarope pra tosse."
msgstr "Quiero saber si tienen jarabe para la tos."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Vocês têm xarope pra tosse?"
msgstr "Buenas noches. ¿Tienen jarabe para la tos?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Tenho de dois tipos. É tosse seca ou com catarro?"
msgstr "Tengo de dos tipos. ¿Tos seca o con flema?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Seca. Não para nem de noite."
msgstr "Seca. No para ni de noche."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Então é o de mel e agrião. Uma colher antes de dormir."
msgstr "Entonces es el de miel y berro. Una cuchara antes de dormir."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Posso pegar amanhã cedo, antes das {hour}?"
msgstr "¿Puedo buscarlo mañana temprano, antes de las {hour}?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Pode. Deixo separado no balcão com o seu nome."
msgstr "Sí. Se lo dejo separado en el mostrador a su nombre."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Boa noite. Minha filha está tossindo a noite inteira."
msgstr "Buenas noches. Mi hija está tosiendo toda la noche."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Tem febre junto?"
msgstr "¿Tiene fiebre también?"

#: data/directory/162_farmacia_santa_rita.tres
msgid "Um pouco. Ela pegou chuva voltando da escola."
msgstr "Un poco. Se mojó volviendo de la escuela."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Tenho um xarope infantil. Uma colherinha de seis em seis horas."
msgstr "Tengo un jarabe infantil. Una cucharadita cada seis horas."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Vou buscar agora. Chego em {wait}."
msgstr "Voy a buscarlo ahora. Llego en {wait}."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Vem com casaco, que a noite esfriou."
msgstr "Traiga abrigo, que la noche refrescó."

#: data/directory/162_farmacia_santa_rita.tres
msgid "Farmácia Santa Rita, boa noite."
msgstr "Farmacia Santa Rita, buenas noches."

#: data/directory/162_farmacia_santa_rita.tres
msgid "da Farmácia Santa Rita"
msgstr "de la Farmácia Santa Rita"

#: data/directory/162_farmacia_santa_rita.tres
msgid "pra Farmácia Santa Rita"
msgstr "con la Farmácia Santa Rita"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "a Funerária Paz Eterna"
msgstr "la Funerária Paz Eterna"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Meu tio faleceu agora há pouco."
msgstr "Mi tío falleció hace un rato."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Boa noite. Meu tio faleceu agora há pouco, em casa."
msgstr "Buenas noches. Mi tío falleció hace un rato, en su casa."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Meus sentimentos. O médico já veio atestar?"
msgstr "Mi más sentido pésame. ¿Ya vino el médico a certificar?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Já veio. Disse que foi o coração."
msgstr "Ya vino. Dijo que fue el corazón."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Então eu mando o carro buscar. Qual é o endereço?"
msgstr "Entonces mando el coche a buscarlo. ¿Cuál es la dirección?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "{street}, {house}. A casa do portão {color}."
msgstr "{street}, {house}. La casa del portón {color}."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Chegamos em {wait}. Separe uma roupa pra ele."
msgstr "Llegamos en {wait}. Separe una ropa para él."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Boa noite. Minha avó faleceu agora há pouco."
msgstr "Buenas noches. Mi abuela falleció hace un rato."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Meus sentimentos. Foi em casa ou no hospital?"
msgstr "Mi más sentido pésame. ¿Fue en casa o en el hospital?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Em casa, dormindo. O médico já veio."
msgstr "En casa, dormida. El médico ya vino."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Vocês querem o velório em casa ou na capela?"
msgstr "¿Quieren el velorio en casa o en la capilla?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Em casa. Ela morava na {street}, {house}."
msgstr "En casa. Ella vivía en {street}, {house}."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Então levo as coisas pra lá em {wait}."
msgstr "Entonces llevo todo para allá en {wait}."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Preciso acertar o velório de amanhã."
msgstr "Necesito arreglar el velorio de mañana."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Boa noite. Preciso acertar as coisas do velório de amanhã."
msgstr "Buenas noches. Necesito arreglar lo del velorio de mañana."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Pois não. Vai ser na capela ou em casa?"
msgstr "Cómo no. ¿Va a ser en la capilla o en la casa?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Na capela. A família quer de manhã, cedo."
msgstr "En la capilla. La familia lo quiere temprano a la mañana."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Às oito a capela está livre. Precisa de flores?"
msgstr "A las ocho la capilla está libre. ¿Necesita flores?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Uma coroa só, simples. Com o nome da família."
msgstr "Una sola corona, sencilla. Con el nombre de la familia."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Anotado. Às sete eu abro a capela."
msgstr "Anotado. A las siete abro la capilla."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Boa noite. Queria saber o preço do caixão e do velório."
msgstr "Buenas noches. Quería saber el precio del cajón y del velorio."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Depende da madeira. Tem o simples e o envernizado."
msgstr "Depende de la madera. Está el sencillo y el barnizado."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "O simples. A família não tem muito."
msgstr "El sencillo. La familia no tiene mucho."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "O simples já vem com as velas e o pano."
msgstr "El sencillo ya viene con las velas y el paño."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "E a coroa de flores, vocês fazem também?"
msgstr "¿Y la corona de flores, también la hacen?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Faço. Passa aqui amanhã que a gente acerta tudo."
msgstr "Sí. Pase mañana y arreglamos todo."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Funerária Paz Eterna, boa noite."
msgstr "Funeraria Paz Eterna, buenas noches."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Vocês atendem a noite toda?"
msgstr "¿Atienden toda la noche?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "A noite toda. A morte não tem hora, infelizmente."
msgstr "Toda la noche. La muerte no tiene hora, por desgracia."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Onde fica a capela?"
msgstr "¿Dónde queda la capilla?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Aqui mesmo, na Rua da Estação, defronte dos trilhos."
msgstr "Aquí mismo, en la Rua da Estação, frente a las vías."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Paz Eterna. Em que posso ajudar?"
msgstr "Paz Eterna. ¿En qué puedo ayudarle?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Não é nada grave, só uma informação."
msgstr "No es nada grave, solo una consulta."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Que bom. Aqui, quase sempre é."
msgstr "Qué bueno. Aquí, casi siempre lo es."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Tem velório hoje?"
msgstr "¿Hay velorio hoy?"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Tem um, de um senhor da Vila. A família pediu silêncio."
msgstr "Hay uno, de un señor de la Vila. La familia pidió silencio."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "Boa noite. Que Deus lhe guarde."
msgstr "Buenas noches. Que Dios lo guarde."

#: data/directory/253_funeraria_paz_eterna.tres
msgid "da Funerária Paz Eterna"
msgstr "de la Funerária Paz Eterna"

#: data/directory/253_funeraria_paz_eterna.tres
msgid "pra Funerária Paz Eterna"
msgstr "con la Funerária Paz Eterna"

#: data/directory/305_hotel_estrela.tres
msgid "o Hotel Serena"
msgstr "el Hotel Serena"

#: data/directory/305_hotel_estrela.tres
msgid "Preciso de um quarto pra esta noite."
msgstr "Necesito una habitación para esta noche."

#: data/directory/305_hotel_estrela.tres
msgid "Boa noite. Vocês ainda têm quarto pra hoje?"
msgstr "Buenas noches. ¿Todavía tienen habitación para hoy?"

#: data/directory/305_hotel_estrela.tres
msgid "Tenho um de solteiro, no andar de cima. Pra quantas noites?"
msgstr "Tengo una individual, en el piso de arriba. ¿Para cuántas noches?"

#: data/directory/305_hotel_estrela.tres
msgid "Só esta. Amanhã cedo eu sigo viagem."
msgstr "Solo esta. Mañana temprano sigo viaje."

#: data/directory/305_hotel_estrela.tres
msgid "A diária é com café da manhã, paga na chegada."
msgstr "La noche incluye el desayuno, se paga al llegar."

#: data/directory/305_hotel_estrela.tres
msgid "Pode segurar pra mim? Chego em {wait}."
msgstr "¿Me la puede guardar? Llego en {wait}."

#: data/directory/305_hotel_estrela.tres
msgid "Seguro até as {hour}. Qual o nome, por favor?"
msgstr "Se la guardo hasta las {hour}. ¿A nombre de quién?"

#: data/directory/305_hotel_estrela.tres
msgid "Boa noite. Perdi o último ônibus. Tem onde dormir aí hoje?"
msgstr "Buenas noches. Perdí el último autobús. ¿Hay dónde dormir hoy?"

#: data/directory/305_hotel_estrela.tres
msgid "Tem um quarto pequeno, perto da escada. É meio barulhento."
msgstr "Hay un cuarto chico, cerca de la escalera. Es algo ruidoso."

#: data/directory/305_hotel_estrela.tres
msgid "Não faz mal, é só pra esta noite."
msgstr "No importa, es solo por esta noche."

#: data/directory/305_hotel_estrela.tres
msgid "Então pode vir. A porta fica aberta até as {hour}."
msgstr "Entonces venga. La puerta queda abierta hasta las {hour}."

#: data/directory/305_hotel_estrela.tres
msgid "Aceita pagar amanhã cedo? Hoje estou sem trocado."
msgstr "¿Le puedo pagar mañana temprano? Hoy no tengo cambio."

#: data/directory/305_hotel_estrela.tres
msgid "Aceito. Só deixa o documento comigo na chegada."
msgstr "Está bien. Solo déjeme el documento al llegar."

#: data/directory/305_hotel_estrela.tres
msgid "Quero saber se ainda tem quarto vago pra amanhã."
msgstr "Quiero saber si todavía hay una habitación libre para mañana."

#: data/directory/305_hotel_estrela.tres
msgid "Boa noite. Queria reservar um quarto pra amanhã. Ainda tem vago?"
msgstr "Buenas noches. Quería reservar una habitación para mañana. ¿Queda alguna?"

#: data/directory/305_hotel_estrela.tres
msgid "Amanhã está quase cheio. Sobrou um de casal, nos fundos."
msgstr "Mañana está casi lleno. Queda una doble, al fondo."

#: data/directory/305_hotel_estrela.tres
msgid "Serve. São {nights}, a partir de amanhã."
msgstr "Me sirve. Son {nights}, a partir de mañana."

#: data/directory/305_hotel_estrela.tres
msgid "{nights}. Vou anotar aqui no livro."
msgstr "{nights}. Lo anoto aquí en el libro."

#: data/directory/305_hotel_estrela.tres
msgid "Chego no ônibus da tarde. Posso pagar quando chegar?"
msgstr "Llego en el autobús de la tarde. ¿Puedo pagar al llegar?"

#: data/directory/305_hotel_estrela.tres
msgid "Pode, sim. Só não passe das {hour}, que a portaria fecha."
msgstr "Sí, claro. Pero no pase de las {hour}, que la portería cierra."

#: data/directory/305_hotel_estrela.tres
msgid "Boa noite. Amanhã chega um parente meu de viagem. Tem quarto?"
msgstr "Buenas noches. Mañana llega un pariente mío de viaje. ¿Hay habitación?"

#: data/directory/305_hotel_estrela.tres
msgid "Pra amanhã tem, sim. Quantas pessoas?"
msgstr "Para mañana sí hay. ¿Cuántas personas?"

#: data/directory/305_hotel_estrela.tres
msgid "Uma só. Fica {nights}."
msgstr "Una sola. Se queda {nights}."

#: data/directory/305_hotel_estrela.tres
msgid "Fica no quarto da frente, com janela pra rua."
msgstr "Va al cuarto de adelante, con ventana a la calle."

#: data/directory/305_hotel_estrela.tres
msgid "Pode deixar no meu nome? Eu passo aí pra acertar."
msgstr "¿Lo puede dejar a mi nombre? Paso a arreglarlo."

#: data/directory/305_hotel_estrela.tres
msgid "Deixo. Pode passar a qualquer hora pra acertar."
msgstr "Hecho. Pase cuando quiera a arreglarlo."

#: data/directory/305_hotel_estrela.tres data/nights/night_08.tres
msgid "Hotel Serena, boa noite."
msgstr "Hotel Serena, buenas noches."

#: data/directory/305_hotel_estrela.tres
msgid "Hotel Serena, boa noite. Em que posso ajudar?"
msgstr "Hotel Serena, buenas noches. ¿En qué puedo ayudarle?"

#: data/directory/305_hotel_estrela.tres
msgid "Tem quarto vago esta noite?"
msgstr "¿Hay cuarto libre esta noche?"

#: data/directory/305_hotel_estrela.tres
msgid "Tem dois no terceiro andar. É só chegar antes da meia-noite."
msgstr "Hay dos en el tercer piso. Basta llegar antes de la medianoche."

#: data/directory/305_hotel_estrela.tres
msgid "A portaria fecha a que horas?"
msgstr "¿A qué hora cierra la portería?"

#: data/directory/305_hotel_estrela.tres
msgid "Não fecha. Depois da meia-noite, é só tocar a campainha."
msgstr "No cierra. Después de la medianoche, basta tocar el timbre."

#: data/directory/305_hotel_estrela.tres
msgid "Quanto custa o pernoite?"
msgstr "¿Cuánto cuesta la noche?"

#: data/directory/305_hotel_estrela.tres
msgid "Quarenta cruzeiros, com café da manhã."
msgstr "Cuarenta cruzeiros, con desayuno."

#: data/directory/305_hotel_estrela.tres
msgid "Serena, recepção. Pois não?"
msgstr "Serena, recepción. ¿Diga?"

#: data/directory/305_hotel_estrela.tres
msgid "O restaurante ainda está servindo?"
msgstr "¿El restaurante todavía sirve?"

#: data/directory/305_hotel_estrela.tres
msgid "Só até as nove. Agora, só o café da recepção."
msgstr "Solo hasta las nueve. Ahora, solo el café de la recepción."

#: data/directory/305_hotel_estrela.tres
msgid "Chegou algum hóspede de fora hoje?"
msgstr "¿Llegó algún huésped de fuera hoy?"

#: data/directory/305_hotel_estrela.tres
msgid "Isso eu não posso dizer pelo telefone, desculpe."
msgstr "Eso no lo puedo decir por teléfono, disculpe."

#: data/directory/305_hotel_estrela.tres data/directory/001_morgana.tres
msgid "Tudo tranquilo por aí?"
msgstr "¿Todo tranquilo por ahí?"

#: data/directory/305_hotel_estrela.tres
msgid "Tudo calmo. Só o letreiro da fachada que anda piscando."
msgstr "Todo en calma. Solo el letrero de la fachada que anda parpadeando."

#: data/directory/305_hotel_estrela.tres
msgid "do Hotel Serena"
msgstr "del Hotel Serena"

#: data/directory/305_hotel_estrela.tres
msgid "pro Hotel Serena"
msgstr "con el Hotel Serena"

#: data/directory/124_igreja_matriz.tres
msgid "secretaria"
msgstr "secretaría"

#: data/directory/124_igreja_matriz.tres
msgid "a Igreja Matriz"
msgstr "la Igreja Matriz"

#: data/directory/124_igreja_matriz.tres
msgid "Quero saber o horário da missa de domingo."
msgstr "Quiero saber el horario de la misa del domingo."

#: data/directory/124_igreja_matriz.tres
msgid "Boa noite. Qual é o horário da missa de domingo?"
msgstr "Buenas noches. ¿A qué hora es la misa del domingo?"

#: data/directory/124_igreja_matriz.tres
msgid "Tem às sete e às nove. E a das crianças, às dez."
msgstr "Hay a las siete y a las nueve. Y la de los niños, a las diez."

#: data/directory/124_igreja_matriz.tres
msgid "E a das sete tem coral?"
msgstr "¿Y la de las siete tiene coro?"

#: data/directory/124_igreja_matriz.tres
msgid "O coral canta na das nove. A das sete é mais rezada."
msgstr "El coro canta en la de las nueve. La de las siete es rezada."

#: data/directory/124_igreja_matriz.tres
msgid "Então vou na das nove, com a família toda."
msgstr "Entonces voy a la de las nueve, con toda la familia."

#: data/directory/124_igreja_matriz.tres
msgid "Chegue cedo, que domingo os bancos enchem."
msgstr "Llegue temprano, que el domingo los bancos se llenan."

#: data/directory/124_igreja_matriz.tres
msgid "Boa noite. A missa de domingo mudou de horário?"
msgstr "Buenas noches. ¿La misa del domingo cambió de horario?"

#: data/directory/124_igreja_matriz.tres
msgid "Só neste domingo. Por causa da procissão, vai ser às {hour}."
msgstr "Solo este domingo. Por la procesión, va a ser a las {hour}."

#: data/directory/124_igreja_matriz.tres
msgid "E a procissão sai de onde?"
msgstr "¿Y de dónde sale la procesión?"

#: data/directory/124_igreja_matriz.tres
msgid "Sai da {street} e vem rezando até a praça."
msgstr "Sale de {street} y viene rezando hasta la plaza."

#: data/directory/124_igreja_matriz.tres
msgid "Posso levar vela de casa?"
msgstr "¿Puedo llevar una vela de casa?"

#: data/directory/124_igreja_matriz.tres
msgid "Pode. E um copinho de papel, pra não pingar na mão."
msgstr "Sí. Y un vasito de papel, para que no gotee en la mano."

#: data/directory/124_igreja_matriz.tres
msgid "Quero marcar o batizado do meu neto."
msgstr "Quiero programar el bautizo de mi nieto."

#: data/directory/124_igreja_matriz.tres
msgid "Boa noite. Queria marcar o batizado do meu neto."
msgstr "Buenas noches. Quería anotar el bautismo de mi nieto."

#: data/directory/124_igreja_matriz.tres
msgid "Os batizados são no segundo domingo do mês, depois da missa."
msgstr "Los bautismos son el segundo domingo del mes, después de la misa."

#: data/directory/124_igreja_matriz.tres
msgid "Serve. E os padrinhos precisam fazer o curso?"
msgstr "Está bien. ¿Y los padrinos tienen que hacer el curso?"

#: data/directory/124_igreja_matriz.tres
msgid "Precisam. É no sábado, às {hour}, aqui no salão."
msgstr "Sí. Es el sábado a las {hour}, aquí en el salón."

#: data/directory/124_igreja_matriz.tres
msgid "Vou avisar. O nome dele é Joãozinho, como o avô."
msgstr "Les aviso. Se llama Joãozinho, como el abuelo."

#: data/directory/124_igreja_matriz.tres
msgid "Traz a certidão de nascimento no dia do curso."
msgstr "Traiga el acta de nacimiento el día del curso."

#: data/directory/124_igreja_matriz.tres
msgid "Boa noite. Meu neto nasceu e a família quer batizar logo."
msgstr "Buenas noches. Nació mi nieto y la familia quiere bautizarlo pronto."

#: data/directory/124_igreja_matriz.tres
msgid "Parabéns! Quem vão ser os padrinhos?"
msgstr "¡Felicitaciones! ¿Quiénes van a ser los padrinos?"

#: data/directory/124_igreja_matriz.tres
msgid "Minha filha mais velha e o marido dela."
msgstr "Mi hija mayor y su marido."

#: data/directory/124_igreja_matriz.tres
msgid "Tem vaga no domingo que vem, às {hour}. Serve?"
msgstr "Hay lugar el domingo que viene, a las {hour}. ¿Le sirve?"

#: data/directory/124_igreja_matriz.tres
msgid "Serve. Precisa levar alguma coisa?"
msgstr "Sí. ¿Hay que llevar algo?"

#: data/directory/124_igreja_matriz.tres
msgid "A vela, a roupinha branca e a certidão."
msgstr "La vela, la ropita blanca y el acta."

#: data/directory/124_igreja_matriz.tres
msgid "Igreja Matriz, secretaria."
msgstr "Iglesia Matriz, secretaría."

#: data/directory/124_igreja_matriz.tres
msgid "da Igreja Matriz"
msgstr "de la Igreja Matriz"

#: data/directory/124_igreja_matriz.tres
msgid "pra Igreja Matriz"
msgstr "con la Igreja Matriz"

#: data/directory/296_alta_cupula.tres
msgid "a Alta Cúpula"
msgstr "la Alta Cúpula"

#: data/directory/296_alta_cupula.tres
msgid "Preciso de um salvo-conduto para viajar."
msgstr "Necesito un salvoconducto para viajar."

#: data/directory/296_alta_cupula.tres
msgid "Boa noite. Preciso de um salvo-conduto para ir à capital."
msgstr "Buenas noches. Necesito un salvoconducto para ir a la capital."

#: data/directory/296_alta_cupula.tres
msgid "O pedido é por escrito, aqui no balcão, com dois documentos."
msgstr "El pedido es por escrito, aquí en el mostrador, con dos documentos."

#: data/directory/296_alta_cupula.tres
msgid "Mas é para enterrar minha mãe. Não dá para ser mais rápido?"
msgstr "Pero es para enterrar a mi madre. ¿No puede ser más rápido?"

#: data/directory/296_alta_cupula.tres
msgid "Não depende de mim. Venha amanhã às oito, e cedo."
msgstr "No depende de mí. Venga mañana a las ocho, y temprano."

#: data/directory/296_alta_cupula.tres
msgid "Está bem. Amanhã às oito."
msgstr "Está bien. Mañana a las ocho."

#: data/directory/296_alta_cupula.tres
msgid "Boa noite. Meu salvo-conduto vence amanhã. Como faço para renovar?"
msgstr "Buenas noches. Mi salvoconducto vence mañana. ¿Cómo hago para renovarlo?"

#: data/directory/296_alta_cupula.tres
msgid "Traga o antigo e o comprovante de trabalho. Sem ele, não renova."
msgstr "Traiga el viejo y el comprobante de trabajo. Sin él, no se renueva."

#: data/directory/296_alta_cupula.tres
msgid "E se o patrão não quiser assinar?"
msgstr "¿Y si el patrón no quiere firmar?"

#: data/directory/296_alta_cupula.tres
msgid "Aí não tem viagem."
msgstr "Entonces no hay viaje."

#: data/directory/296_alta_cupula.tres
msgid "Entendi. Passo aí amanhã."
msgstr "Entiendo. Paso mañana."

#: data/directory/296_alta_cupula.tres
msgid "Passe cedo. A fila dobra a esquina."
msgstr "Venga temprano. La fila da vuelta a la esquina."

#: data/directory/296_alta_cupula.tres
msgid "Quero notícia de um parente que foi detido."
msgstr "Quiero noticias de un pariente que fue detenido."

#: data/directory/296_alta_cupula.tres
msgid "Levaram meu filho ontem, na saída da fábrica. Ninguém diz onde ele está."
msgstr "Se llevaron a mi hijo ayer, al salir de la fábrica. Nadie dice dónde está."

#: data/directory/296_alta_cupula.tres
msgid "Nome completo e idade."
msgstr "Nombre completo y edad."

#: data/directory/296_alta_cupula.tres
msgid "Paulo Ferraz, vinte anos. Por favor, ele não fez nada."
msgstr "Paulo Ferraz, veinte años. Por favor, él no hizo nada."

#: data/directory/296_alta_cupula.tres
msgid "Isso não é comigo. Se houver notícia, mandam avisar."
msgstr "Eso no es conmigo. Si hay noticias, le avisarán."

#: data/directory/296_alta_cupula.tres
msgid "E quando vão avisar?"
msgstr "¿Y cuándo van a avisar?"

#: data/directory/296_alta_cupula.tres
msgid "Quando houver notícia. Boa noite."
msgstr "Cuando haya noticias. Buenas noches."

#: data/directory/296_alta_cupula.tres
msgid "Meu irmão foi detido no toque de recolher. Posso levar roupa para ele?"
msgstr "Mi hermano fue detenido en el toque de queda. ¿Puedo llevarle ropa?"

#: data/directory/296_alta_cupula.tres
msgid "Roupa e comida, só com autorização."
msgstr "Ropa y comida, solo con autorización."

#: data/directory/296_alta_cupula.tres
msgid "E a autorização, onde eu peço?"
msgstr "¿Y la autorización, dónde la pido?"

#: data/directory/296_alta_cupula.tres
msgid "Aqui mesmo, por escrito. Demora uns dias."
msgstr "Aquí mismo, por escrito. Tarda unos días."

#: data/directory/296_alta_cupula.tres
msgid "Uns dias... Está bem. Vou pedir."
msgstr "Unos días... Está bien. Voy a pedirla."

#: data/directory/296_alta_cupula.tres
msgid "Alta Cúpula, plantão."
msgstr "Alta Cúpula, guardia."

#: data/directory/296_alta_cupula.tres
msgid "da Alta Cúpula"
msgstr "de la Alta Cúpula"

#: data/directory/296_alta_cupula.tres
msgid "pra Alta Cúpula"
msgstr "a la Alta Cúpula"

#: data/directory/262_mercearia_silva.tres
msgid "a Mercearia Silva"
msgstr "la Mercearia Silva"

#: data/directory/262_mercearia_silva.tres
msgid "Acabou a vela aqui em casa e faltou luz."
msgstr "Se acabaron las velas en casa y se cortó la luz."

#: data/directory/262_mercearia_silva.tres
msgid "Boa noite. Faltou luz aqui e acabou a vela."
msgstr "Buenas noches. Se cortó la luz y se acabaron las velas."

#: data/directory/262_mercearia_silva.tres
msgid "Aqui também está escuro. Mas vela eu tenho."
msgstr "Aquí también está oscuro. Pero velas tengo."

#: data/directory/262_mercearia_silva.tres
msgid "Me vende um pacote? E uma caixa de fósforo."
msgstr "¿Me vende un paquete? Y una caja de fósforos."

#: data/directory/262_mercearia_silva.tres
msgid "Vendo. Vem com lanterna, que a rua está um breu."
msgstr "Sí. Venga con linterna, que la calle está a oscuras."

#: data/directory/262_mercearia_silva.tres
msgid "Moro na {street}. Chego em {wait}."
msgstr "Vivo en {street}. Llego en {wait}."

#: data/directory/262_mercearia_silva.tres
msgid "Bate na porta do lado, que eu estou na cozinha."
msgstr "Golpee la puerta del costado, que estoy en la cocina."

#: data/directory/262_mercearia_silva.tres
msgid "Boa noite. Ainda dá pra comprar vela? Ficamos no escuro."
msgstr "Buenas noches. ¿Todavía puedo comprar velas? Nos quedamos a oscuras."

#: data/directory/262_mercearia_silva.tres
msgid "Dá. Tenho as grossas, que duram a noite toda."
msgstr "Sí. Tengo las gruesas, que duran toda la noche."

#: data/directory/262_mercearia_silva.tres
msgid "Quero três. Será que a luz volta hoje?"
msgstr "Quiero tres. ¿Volverá la luz hoy?"

#: data/directory/262_mercearia_silva.tres
msgid "Dizem que caiu um galho no fio da {street}."
msgstr "Dicen que cayó una rama sobre el cable de {street}."

#: data/directory/262_mercearia_silva.tres
msgid "Então vai demorar. Estou indo aí."
msgstr "Entonces va para largo. Voy para allá."

#: data/directory/262_mercearia_silva.tres
msgid "Cuidado com as poças. Eu deixo a porta encostada."
msgstr "Cuidado con los charcos. Dejo la puerta entornada."

#: data/directory/262_mercearia_silva.tres
msgid "Quero deixar uma encomenda pra amanhã cedo."
msgstr "Quiero dejar un pedido para mañana temprano."

#: data/directory/262_mercearia_silva.tres
msgid "Boa noite. Queria deixar uma encomenda pra amanhã cedo."
msgstr "Buenas noches. Quería dejar un pedido para mañana temprano."

#: data/directory/262_mercearia_silva.tres
msgid "Pode falar, que eu anoto."
msgstr "Dígame, que anoto."

#: data/directory/262_mercearia_silva.tres
msgid "Dois quilos de arroz, um de feijão e uma lata de óleo."
msgstr "Dos kilos de arroz, uno de frijoles y una lata de aceite."

#: data/directory/262_mercearia_silva.tres
msgid "Anotado. Busca ou eu mando entregar?"
msgstr "Anotado. ¿Lo busca o se lo mando?"

#: data/directory/262_mercearia_silva.tres
msgid "Pode mandar. É na {street}, número {house}."
msgstr "Mándelo. Es en {street}, número {house}."

#: data/directory/262_mercearia_silva.tres
msgid "O menino leva antes das {hour}."
msgstr "El muchacho lo lleva antes de las {hour}."

#: data/directory/262_mercearia_silva.tres
msgid "Boa noite. Amanhã cedo eu preciso de pão e leite."
msgstr "Buenas noches. Mañana temprano necesito pan y leche."

#: data/directory/262_mercearia_silva.tres
msgid "O pão chega às {dawn}. Quantos?"
msgstr "El pan llega a las {dawn}. ¿Cuántos?"

#: data/directory/262_mercearia_silva.tres
msgid "Dez pãezinhos e dois litros de leite."
msgstr "Diez panecillos y dos litros de leche."

#: data/directory/262_mercearia_silva.tres
msgid "Separo. Quer que eu ponha um queijo também?"
msgstr "Se los separo. ¿Quiere que le ponga un queso también?"

#: data/directory/262_mercearia_silva.tres
msgid "Pode pôr. Eu pago tudo amanhã."
msgstr "Póngalo. Mañana le pago todo."

#: data/directory/262_mercearia_silva.tres
msgid "Fica na caderneta. Pode vir buscar quando quiser."
msgstr "Queda en la libreta. Venga a buscarlo cuando quiera."

#: data/directory/262_mercearia_silva.tres
msgid "Mercearia Silva, boa noite."
msgstr "Tienda Silva, buenas noches."

#: data/directory/262_mercearia_silva.tres
msgid "da Mercearia Silva"
msgstr "de la Mercearia Silva"

#: data/directory/262_mercearia_silva.tres
msgid "pra Mercearia Silva"
msgstr "con la Mercearia Silva"

#: data/directory/131_paulo_nogueira.tres
msgid "o seu Paulo Nogueira"
msgstr "Seu Paulo Nogueira"

#: data/directory/131_paulo_nogueira.tres
msgid "Ele disse que eu podia ligar a qualquer hora."
msgstr "Dijo que podía llamar a cualquier hora."

#: data/directory/131_paulo_nogueira.tres
msgid "Seu Paulo? Desculpa a hora. O senhor disse que eu podia ligar."
msgstr "¿Don Paulo? Perdón la hora. Usted dijo que podía llamar."

#: data/directory/131_paulo_nogueira.tres
msgid "Disse, sim. Pode falar. É sobre o serviço?"
msgstr "Sí, lo dije. Hable. ¿Es por el trabajo?"

#: data/directory/131_paulo_nogueira.tres
msgid "É. Pensei bem e aceito a vaga no escritório."
msgstr "Sí. Lo pensé bien y acepto el puesto en la oficina."

#: data/directory/131_paulo_nogueira.tres
msgid "Que ótima notícia. Começa segunda, às {hour}."
msgstr "Qué buena noticia. Empieza el lunes a las {hour}."

#: data/directory/131_paulo_nogueira.tres
msgid "Preciso levar algum documento?"
msgstr "¿Tengo que llevar algún documento?"

#: data/directory/131_paulo_nogueira.tres
msgid "A carteira de trabalho e uma foto. O resto a gente vê lá."
msgstr "La libreta de trabajo y una foto. Lo demás lo vemos allá."

#: data/directory/131_paulo_nogueira.tres
msgid "Boa noite, seu Paulo. O senhor falou pra ligar a qualquer hora..."
msgstr "Buenas noches, don Paulo. Usted dijo que llamara a cualquier hora..."

#: data/directory/131_paulo_nogueira.tres
msgid "E falei sério. O que houve?"
msgstr "Y lo dije en serio. ¿Qué pasó?"

#: data/directory/131_paulo_nogueira.tres
msgid "A cerca do pasto caiu e as vacas foram pra estrada."
msgstr "Se cayó la cerca del pasto y las vacas salieron al camino."

#: data/directory/131_paulo_nogueira.tres
msgid "Vou aí com os rapazes. Em {wait} a gente chega."
msgstr "Voy con los muchachos. En {wait} llegamos."

#: data/directory/131_paulo_nogueira.tres
msgid "Traz arame, se tiver. O meu acabou."
msgstr "Traiga alambre, si tiene. El mío se acabó."

#: data/directory/131_paulo_nogueira.tres
msgid "Levo um rolo. Segura as vacas no curral até lá."
msgstr "Llevo un rollo. Deje las vacas en el corral hasta entonces."

#: data/directory/131_paulo_nogueira.tres
msgid "É sobre o negócio do terreno."
msgstr "Es por el asunto del terreno."

#: data/directory/131_paulo_nogueira.tres
msgid "Seu Paulo, boa noite. É sobre o terreno da {street}."
msgstr "Don Paulo, buenas noches. Es por el terreno de {street}."

#: data/directory/131_paulo_nogueira.tres
msgid "Pois não. O dono baixou o preço?"
msgstr "Dígame. ¿El dueño bajó el precio?"

#: data/directory/131_paulo_nogueira.tres
msgid "Baixou um pouco. Mas quer metade à vista."
msgstr "Un poco. Pero quiere la mitad al contado."

#: data/directory/131_paulo_nogueira.tres
msgid "Metade eu consigo. O resto em quantas vezes?"
msgstr "La mitad la consigo. ¿Y el resto en cuántas cuotas?"

#: data/directory/131_paulo_nogueira.tres
msgid "Em seis. Ele quer assinar no cartório na sexta, às {hour}."
msgstr "En seis. Quiere firmar en la notaría el viernes a las {hour}."

#: data/directory/131_paulo_nogueira.tres
msgid "Então pode marcar. Eu levo o dinheiro."
msgstr "Entonces arréglelo. Yo llevo el dinero."

#: data/directory/131_paulo_nogueira.tres
msgid "Boa noite, seu Paulo. Desculpa, mas é sobre o terreno."
msgstr "Buenas noches, don Paulo. Disculpe, pero es por el terreno."

#: data/directory/131_paulo_nogueira.tres
msgid "Fala. Apareceu outro comprador?"
msgstr "Diga. ¿Apareció otro comprador?"

#: data/directory/131_paulo_nogueira.tres
msgid "Apareceu. Um moço de fora, oferecendo mais."
msgstr "Sí. Un muchacho de afuera, que ofrece más."

#: data/directory/131_paulo_nogueira.tres
msgid "Então eu cubro a oferta. Quanto ele deu?"
msgstr "Entonces igualo la oferta. ¿Cuánto ofreció?"

#: data/directory/131_paulo_nogueira.tres
msgid "Não sei ainda. O dono vai dizer amanhã, às {hour}."
msgstr "Todavía no sé. El dueño va a decir mañana a las {hour}."

#: data/directory/131_paulo_nogueira.tres
msgid "Então me liga assim que souber. Não deixa escapar."
msgstr "Entonces llámeme apenas sepa. Que no se escape."

#: data/directory/131_paulo_nogueira.tres
msgid "do seu Paulo Nogueira"
msgstr "de Seu Paulo Nogueira"

#: data/directory/131_paulo_nogueira.tres
msgid "pro seu Paulo Nogueira"
msgstr "con Seu Paulo Nogueira"

#: data/directory/318_oficina_do_tiao.tres
msgid "a Oficina do Tião"
msgstr "la Oficina do Tião"

#: data/directory/318_oficina_do_tiao.tres
msgid "Meu carro atolou na estrada do moinho."
msgstr "Mi auto se atascó en el camino del molino."

#: data/directory/318_oficina_do_tiao.tres
msgid "Boa noite. O carro atolou na estrada do moinho. A roda afundou toda."
msgstr "Buenas noches. El auto se atascó en el camino del molino. La rueda se hundió toda."

#: data/directory/318_oficina_do_tiao.tres
msgid "Na estrada de terra? Aquele trecho depois da ponte?"
msgstr "¿En el camino de tierra? ¿Ese tramo después del puente?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Isso, logo depois da ponte. Não vai nem pra frente nem pra trás."
msgstr "Eso, justo después del puente. No va ni para adelante ni para atrás."

#: data/directory/318_oficina_do_tiao.tres
msgid "Vou ter que ir com a caminhonete e a corda. Chego em {wait}."
msgstr "Tengo que ir con la camioneta y la soga. Llego en {wait}."

#: data/directory/318_oficina_do_tiao.tres
msgid "Eu espero aqui no carro, com o pisca ligado."
msgstr "Espero aquí en el auto, con las balizas puestas."

#: data/directory/318_oficina_do_tiao.tres
msgid "Não sai de perto. Já estou pegando a lanterna."
msgstr "No se aleje. Ya estoy agarrando la linterna."

#: data/directory/318_oficina_do_tiao.tres
msgid "Boa noite. Atolei o carro na estrada do moinho."
msgstr "Buenas noches. Se me atascó el auto en el camino del molino."

#: data/directory/318_oficina_do_tiao.tres
msgid "De novo aquele barro? Em que altura?"
msgstr "¿Otra vez ese barro? ¿A qué altura?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Perto da porteira da fazenda, depois da curva grande."
msgstr "Cerca de la tranquera de la estancia, pasando la curva grande."

#: data/directory/318_oficina_do_tiao.tres
msgid "Sei onde é. Tem alguém aí com você?"
msgstr "Sé dónde es. ¿Hay alguien con usted?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Não, só eu. E está escuro demais."
msgstr "No, solo yo. Y está demasiado oscuro."

#: data/directory/318_oficina_do_tiao.tres
msgid "Fica dentro do carro. Chego em {wait}."
msgstr "Quédese dentro del auto. Llego en {wait}."

#: data/directory/318_oficina_do_tiao.tres
msgid "O caminhão não quer pegar de jeito nenhum."
msgstr "El camión no quiere arrancar de ninguna manera."

#: data/directory/318_oficina_do_tiao.tres
msgid "Boa noite. O caminhão não pega. Gira, gira e não pega."
msgstr "Buenas noches. El camión no arranca. Gira y gira y no arranca."

#: data/directory/318_oficina_do_tiao.tres
msgid "Faz barulho de quê? Estala, ou nem isso?"
msgstr "¿Qué ruido hace? ¿Chasquea, o ni eso?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Estala e morre. As luzes acendem, a bateria parece boa."
msgstr "Chasquea y se apaga. Las luces prenden, la batería parece bien."

#: data/directory/318_oficina_do_tiao.tres
msgid "Pode ser o combustível. Tem óleo no tanque?"
msgstr "Puede ser el combustible. ¿Tiene gasoil en el tanque?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Tem, enchi hoje de manhã no posto."
msgstr "Sí, lo llené hoy a la mañana."

#: data/directory/318_oficina_do_tiao.tres
msgid "Então vou aí dar uma olhada. Me diz direitinho onde você está."
msgstr "Entonces voy a echar un vistazo. Dígame bien dónde está."

#: data/directory/318_oficina_do_tiao.tres
msgid "Boa noite. Meu caminhão parou e não pega mais."
msgstr "Buenas noches. Mi camión se paró y no arranca más."

#: data/directory/318_oficina_do_tiao.tres
msgid "Parou como? Foi morrendo aos poucos?"
msgstr "¿Cómo se paró? ¿Se fue apagando de a poco?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Foi engasgando e apagou. Agora nem tenta pegar."
msgstr "Fue tosiendo y se apagó. Ahora ni intenta arrancar."

#: data/directory/318_oficina_do_tiao.tres
msgid "Pode ser a correia. Onde ele está?"
msgstr "Puede ser la correa. ¿Dónde está?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Na {street}, perto do número {house}."
msgstr "En {street}, cerca del número {house}."

#: data/directory/318_oficina_do_tiao.tres
msgid "Vou aí com a caixa de ferramentas. Chego em {wait}."
msgstr "Voy con la caja de herramientas. Llego en {wait}."

#: data/directory/318_oficina_do_tiao.tres
msgid "Oficina do Tião, boa noite."
msgstr "Taller de Tião, buenas noches."

#: data/directory/318_oficina_do_tiao.tres
msgid "Oficina. Fala logo, que eu estou com a mão suja de graxa."
msgstr "Taller. Hable rápido, que tengo las manos llenas de grasa."

#: data/directory/318_oficina_do_tiao.tres data/directory/355_bilhar_do_tonho.tres
msgid "Até que horas vocês ficam abertos?"
msgstr "¿Hasta qué hora están abiertos?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Hoje eu fico até tarde. Tem um caminhão para entregar de manhã."
msgstr "Hoy me quedo hasta tarde. Hay un camión para entregar en la mañana."

#: data/directory/318_oficina_do_tiao.tres
msgid "Vocês fazem guincho?"
msgstr "¿Ustedes tienen grúa?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Faço, mas só até a saída da cidade. Depois disso, é com o posto."
msgstr "Sí, pero solo hasta la salida de la ciudad. Después, es cosa de la gasolinera."

#: data/directory/318_oficina_do_tiao.tres
msgid "Tião falando."
msgstr "Habla Tião."

#: data/directory/318_oficina_do_tiao.tres
msgid "Dá para olhar um carro amanhã cedo?"
msgstr "¿Puede revisar un auto mañana temprano?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Pode trazer às sete. Antes do café, eu não falo com ninguém."
msgstr "Tráigalo a las siete. Antes del café, no hablo con nadie."

#: data/directory/318_oficina_do_tiao.tres
msgid "Quanto custa uma revisão?"
msgstr "¿Cuánto cuesta una revisión?"

#: data/directory/318_oficina_do_tiao.tres
msgid "Depende do carro. Fusca é barato; o resto, a gente conversa."
msgstr "Depende del auto. Un escarabajo es barato; lo demás, lo hablamos."

#: data/directory/318_oficina_do_tiao.tres
msgid "da Oficina do Tião"
msgstr "de la Oficina do Tião"

#: data/directory/318_oficina_do_tiao.tres
msgid "pra Oficina do Tião"
msgstr "con la Oficina do Tião"

#: data/directory/142_padaria_pao_dourado.tres
msgid "a Padaria Pão Dourado"
msgstr "la Padaria Pão Dourado"

#: data/directory/142_padaria_pao_dourado.tres
msgid "Quero encomendar pão pra amanhã cedo."
msgstr "Quiero encargar pan para mañana temprano."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Boa noite. Queria encomendar pão pra amanhã cedo."
msgstr "Buenas noches. Quería encargar pan para mañana temprano."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Quantos? A primeira fornada sai às {dawn}."
msgstr "¿Cuántos? La primera hornada sale a las {dawn}."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Trinta pãezinhos. É café da manhã da turma da fábrica."
msgstr "Treinta panecillos. Es el desayuno de los de la fábrica."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Trinta. Quer que corte e passe manteiga?"
msgstr "Treinta. ¿Quiere que los corte y les ponga mantequilla?"

#: data/directory/142_padaria_pao_dourado.tres
msgid "Se não der trabalho, quero."
msgstr "Si no es molestia, sí."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Trabalho nenhum. Busca na porta dos fundos."
msgstr "Ninguna molestia. Búsquelos en la puerta de atrás."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Boa noite. Amanhã tem velório na família e vem muita gente."
msgstr "Buenas noches. Mañana hay un velorio en la familia y viene mucha gente."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Sinto muito. Do que vocês precisam?"
msgstr "Lo siento mucho. ¿Qué necesitan?"

#: data/directory/142_padaria_pao_dourado.tres
msgid "Pão e uma rosca grande, pra servir com café."
msgstr "Pan y una rosca grande, para servir con café."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Faço duas roscas. Entrego na {street}?"
msgstr "Hago dos roscas. ¿Las entrego en {street}?"

#: data/directory/142_padaria_pao_dourado.tres
msgid "Isso, no número {house}. Até as {hour} está bom."
msgstr "Sí, en el número {house}. Antes de las {hour} está bien."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Chega antes. E não precisa pagar agora."
msgstr "Llega antes. Y no hace falta pagar ahora."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Esqueci o troco lá hoje de manhã."
msgstr "Esta mañana olvidé el cambio ahí."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Boa noite. Hoje de manhã eu saí sem pegar o troco."
msgstr "Buenas noches. Esta mañana me fui sin el cambio."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Foi você? A moça do caixa guardou num envelope."
msgstr "¿Fue usted? La cajera lo guardó en un sobre."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Que alívio. Era o dinheiro da feira da semana."
msgstr "Qué alivio. Era el dinero del mercado de la semana."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Está aqui na gaveta, com o seu nome."
msgstr "Está aquí en el cajón, con su nombre."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Passo amanhã cedo pra pegar."
msgstr "Paso mañana temprano a buscarlo."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Pode vir. Abrimos às {dawn}."
msgstr "Venga. Abrimos a las {dawn}."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Boa noite. Acho que esqueci o troco aí no balcão."
msgstr "Buenas noches. Creo que me olvidé el cambio en el mostrador."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Era uma nota amassada e umas moedas?"
msgstr "¿Era un billete arrugado y unas monedas?"

#: data/directory/142_padaria_pao_dourado.tres
msgid "Isso mesmo! Foi no pão das sete."
msgstr "¡Eso mismo! Fue con el pan de las siete."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Está guardado. O padeiro achou quando foi limpar."
msgstr "Está guardado. El panadero lo encontró cuando limpiaba."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Amanhã eu passo e levo um sonho de presente pra ele."
msgstr "Mañana paso y le llevo un bollo de regalo."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Sonho ele tem de sobra aqui. Mas ele vai gostar."
msgstr "Bollos aquí le sobran. Pero le va a gustar."

#: data/directory/142_padaria_pao_dourado.tres
msgid "Padaria Pão Dourado, boa noite."
msgstr "Panadería Pão Dourado, buenas noches."

#: data/directory/142_padaria_pao_dourado.tres
msgid "da Padaria Pão Dourado"
msgstr "de la Padaria Pão Dourado"

#: data/directory/142_padaria_pao_dourado.tres
msgid "pra Padaria Pão Dourado"
msgstr "con la Padaria Pão Dourado"

#: data/directory/147_lucia_pereira.tres
msgid "a Lúcia Pereira"
msgstr "Lúcia Pereira"

#: data/directory/147_lucia_pereira.tres
msgid "Ela está esperando minha ligação."
msgstr "Está esperando mi llamada."

#: data/directory/147_lucia_pereira.tres
msgid "Lúcia? Sou eu. Desculpa a demora pra ligar."
msgstr "¿Lúcia? Soy yo. Perdón por tardar en llamar."

#: data/directory/147_lucia_pereira.tres
msgid "Achei que tinha esquecido. E então, deu certo?"
msgstr "Pensé que te habías olvidado. ¿Y entonces, salió bien?"

#: data/directory/147_lucia_pereira.tres
msgid "Deu! Consegui a vaga na escola da {street}."
msgstr "¡Sí! Conseguí el puesto en la escuela de {street}."

#: data/directory/147_lucia_pereira.tres
msgid "Que maravilha! Começa quando?"
msgstr "¡Qué maravilla! ¿Cuándo empiezas?"

#: data/directory/147_lucia_pereira.tres
msgid "Segunda, às {hour}. Já estou com frio na barriga."
msgstr "El lunes a las {hour}. Ya tengo mariposas en el estómago."

#: data/directory/147_lucia_pereira.tres
msgid "Vai dar tudo certo. Sábado a gente comemora."
msgstr "Todo va a salir bien. El sábado lo festejamos."

#: data/directory/147_lucia_pereira.tres
msgid "Oi, Lúcia. Você estava esperando eu ligar, né?"
msgstr "Hola, Lúcia. Estabas esperando mi llamada, ¿no?"

#: data/directory/147_lucia_pereira.tres
msgid "Estava! Conseguiu falar com o médico?"
msgstr "¡Sí! ¿Pudiste hablar con el médico?"

#: data/directory/147_lucia_pereira.tres
msgid "Consegui. Não é nada grave, só preciso de repouso."
msgstr "Sí. No es nada grave, solo necesito reposo."

#: data/directory/147_lucia_pereira.tres
msgid "Ainda bem. Quer que eu leve a janta amanhã?"
msgstr "Menos mal. ¿Quieres que te lleve la cena mañana?"

#: data/directory/147_lucia_pereira.tres
msgid "Se não for incômodo, eu aceito."
msgstr "Si no es molestia, acepto."

#: data/directory/147_lucia_pereira.tres
msgid "Incômodo nenhum. Lá pelas {hour} eu chego."
msgstr "Ninguna molestia. Como a las {hour} llego."

#: data/directory/147_lucia_pereira.tres
msgid "Preciso dar um recado da família."
msgstr "Necesito darle un recado de la familia."

#: data/directory/147_lucia_pereira.tres
msgid "Lúcia, boa noite. Tenho um recado da sua mãe."
msgstr "Lúcia, buenas noches. Tengo un mensaje de tu mamá."

#: data/directory/147_lucia_pereira.tres
msgid "Da mamãe? Aconteceu alguma coisa?"
msgstr "¿De mamá? ¿Pasó algo?"

#: data/directory/147_lucia_pereira.tres
msgid "Nada de ruim. Ela pediu pra você ir no domingo, sem falta."
msgstr "Nada malo. Pidió que vayas el domingo, sin falta."

#: data/directory/147_lucia_pereira.tres
msgid "Domingo eu vou. Que horas ela quer?"
msgstr "El domingo voy. ¿A qué hora quiere?"

#: data/directory/147_lucia_pereira.tres
msgid "Pro almoço. E é pra levar a receita do bolo de laranja."
msgstr "Para el almuerzo. Y que lleves la receta del pastel de naranja."

#: data/directory/147_lucia_pereira.tres
msgid "Levo. Diz pra ela que eu chego cedo."
msgstr "La llevo. Dile que llego temprano."

#: data/directory/147_lucia_pereira.tres
msgid "Boa noite, Lúcia. A tia pediu pra te avisar uma coisa."
msgstr "Buenas noches, Lúcia. La tía me pidió que te avisara algo."

#: data/directory/147_lucia_pereira.tres
msgid "Pode falar. É sobre a festa?"
msgstr "Dime. ¿Es por la fiesta?"

#: data/directory/147_lucia_pereira.tres
msgid "É. Mudou pro salão da {street}."
msgstr "Sí. Se cambió al salón de {street}."

#: data/directory/147_lucia_pereira.tres
msgid "E o horário continua o mesmo?"
msgstr "¿Y el horario sigue igual?"

#: data/directory/147_lucia_pereira.tres
msgid "Mudou também. Agora começa às {hour}."
msgstr "También cambió. Ahora empieza a las {hour}."

#: data/directory/147_lucia_pereira.tres
msgid "Ainda bem que você avisou. Eu ia chegar cedo demais."
msgstr "Menos mal que avisaste. Iba a llegar demasiado temprano."

#: data/directory/147_lucia_pereira.tres
msgid "da Lúcia Pereira"
msgstr "de Lúcia Pereira"

#: data/directory/147_lucia_pereira.tres
msgid "pra Lúcia Pereira"
msgstr "con Lúcia Pereira"

#: data/directory/347_posto_sao_cristovao.tres
msgid "o Posto São Cristóvão"
msgstr "el Posto São Cristóvão"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Tô quase sem gasolina."
msgstr "Casi no me queda gasolina."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Boa noite. Vocês ainda estão abertos? Estou quase sem gasolina."
msgstr "Buenas noches. ¿Todavía están abiertos? Estoy casi sin nafta."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Até a meia-noite. De onde você está vindo?"
msgstr "Hasta la medianoche. ¿De dónde viene?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Da estrada do moinho. O ponteiro já está no fim."
msgstr "Del camino del molino. La aguja ya está en el fondo."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Então desce devagar, sem acelerar muito, que dá."
msgstr "Entonces baje despacio, sin acelerar mucho, que llega."

#: data/directory/347_posto_sao_cristovao.tres
msgid "E se não der?"
msgstr "¿Y si no llego?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Se não der, liga de novo que eu levo um galão aí."
msgstr "Si no llega, llame de nuevo y le llevo un bidón."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Boa noite. O carro está na reserva. Dá pra chegar aí?"
msgstr "Buenas noches. El auto está en reserva. ¿Llego hasta ahí?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "De onde você vem?"
msgstr "¿De dónde viene?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Da {street}, lá perto do número {house}."
msgstr "De {street}, cerca del número {house}."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Dá, é pertinho. Vem devagar."
msgstr "Llega, queda cerquita. Venga despacio."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vocês fecham que horas?"
msgstr "¿A qué hora cierran?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Hoje eu fico até as {hour}. Depois, só amanhã."
msgstr "Hoy me quedo hasta las {hour}. Después, recién mañana."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Quero saber se o posto ainda está aberto."
msgstr "Quiero saber si la gasolinera sigue abierta."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Boa noite. O posto ainda está aberto?"
msgstr "Buenas noches. ¿La gasolinera sigue abierta?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Aberto até a meia-noite, como sempre."
msgstr "Abierta hasta la medianoche, como siempre."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Ainda bem. Preciso encher o tanque pra viajar amanhã cedo."
msgstr "Menos mal. Necesito llenar el tanque para viajar mañana temprano."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vem agora, que de manhã a fila é grande."
msgstr "Venga ahora, que a la mañana la fila es larga."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vocês calibram pneu também?"
msgstr "¿También inflan las ruedas?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Tem ar, sim. Fica do lado da bomba, pode usar à vontade."
msgstr "Hay aire, sí. Está al lado del surtidor, úselo tranquila."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Boa noite. Ainda dá tempo de abastecer?"
msgstr "Buenas noches. ¿Todavía llego a cargar?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Dá. Hoje eu fecho às {hour}."
msgstr "Sí. Hoy cierro a las {hour}."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vocês trocam óleo também?"
msgstr "¿También cambian el aceite?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Troca, mas só de dia. De noite é só a bomba."
msgstr "Sí, pero solo de día. De noche es solo el surtidor."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Então amanhã eu passo pra trocar."
msgstr "Entonces mañana paso a cambiarlo."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vem cedo, que de manhã o mecânico está aqui."
msgstr "Venga temprano, que a la mañana está el mecánico."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Posto São Cristóvão, boa noite."
msgstr "Gasolinera São Cristóvão, buenas noches."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Vocês ficam abertos a noite toda?"
msgstr "¿Están abiertos toda la noche?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "A bomba fecha à meia-noite. Depois, só o frentista de plantão."
msgstr "El surtidor cierra a la medianoche. Después, solo el playero de guardia."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Quanto está a gasolina?"
msgstr "¿A cuánto está la gasolina?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Subiu de novo esta semana. Nem me pergunte."
msgstr "Subió otra vez esta semana. Ni me pregunte."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Posto, plantão."
msgstr "Gasolinera, guardia."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Tem borracheiro aí hoje?"
msgstr "¿Hay gomero ahí hoy?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Hoje, não. Fala com o Neno, na Rua das Acácias."
msgstr "Hoy no. Hable con Neno, en la Rua das Acácias."

#: data/directory/347_posto_sao_cristovao.tres
msgid "Muito movimento hoje?"
msgstr "¿Mucho movimiento hoy?"

#: data/directory/347_posto_sao_cristovao.tres
msgid "Só caminhão passando para a Capital. Carro de passeio, quase nenhum."
msgstr "Solo camiones que van a la Capital. Autos, casi ninguno."

#: data/directory/347_posto_sao_cristovao.tres
msgid "do Posto São Cristóvão"
msgstr "del Posto São Cristóvão"

#: data/directory/347_posto_sao_cristovao.tres
msgid "pro Posto São Cristóvão"
msgstr "con el Posto São Cristóvão"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "a Gazeta"
msgstr "la Gazeta"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Quero pôr um anúncio no jornal de amanhã."
msgstr "Quiero poner un anuncio en el diario de mañana."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Boa noite. Ainda dá pra pôr um anúncio no jornal de amanhã?"
msgstr "Buenas noches. ¿Todavía se puede poner un aviso en el diario de mañana?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Dá, se for rápido. A página fecha às {hour}."
msgstr "Sí, si es rápido. La página cierra a las {hour}."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "É curto. Vende-se bicicleta, quase nova, tratar na {street}."
msgstr "Es corto. Se vende bicicleta, casi nueva, tratar en {street}."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Quer pôr o número da casa também?"
msgstr "¿Quiere poner también el número de la casa?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Põe, sim. Número {house}."
msgstr "Sí, póngalo. Número {house}."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Anotado. Paga amanhã aqui no balcão."
msgstr "Anotado. Paga mañana aquí en el mostrador."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Boa noite. Queria anunciar que perdi um cachorro."
msgstr "Buenas noches. Quería poner un aviso por un perro perdido."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Pode ditar. Como ele é?"
msgstr "Dícteme. ¿Cómo es?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Pequeno, {color}, com uma mancha branca no olho."
msgstr "Chico, {color}, con una mancha blanca en el ojo."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Atende por que nome?"
msgstr "¿A qué nombre responde?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Pipoca. Quem achar, é só levar na {street}."
msgstr "Pipoca. Quien lo encuentre, que lo lleve a {street}."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Sai amanhã cedo, na página dos classificados."
msgstr "Sale mañana temprano, en la página de clasificados."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Saiu meu nome errado na edição de hoje."
msgstr "Salió mal mi nombre en la edición de hoy."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Boa noite. Meu nome saiu errado no jornal de hoje."
msgstr "Buenas noches. Mi nombre salió mal en el diario de hoy."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Em que página?"
msgstr "¿En qué página?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Na lista dos aprovados do concurso. Trocaram uma letra."
msgstr "En la lista de aprobados del concurso. Cambiaron una letra."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Peço desculpas. Amanhã sai a correção, na página dois."
msgstr "Disculpe. Mañana sale la corrección, en la página dos."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Por favor. Minha mãe já recortou a errada pra guardar."
msgstr "Por favor. Mi madre ya recortó la equivocada para guardarla."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Então ela vai ter duas pra guardar."
msgstr "Entonces va a tener dos para guardar."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Boa noite. O jornal de hoje errou meu nome na notícia da feira."
msgstr "Buenas noches. El diario de hoy se equivocó con mi nombre en la nota de la feria."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "A do concurso de abóbora?"
msgstr "¿La del concurso de calabazas?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Essa. Eu ganhei o primeiro lugar e saiu o nome do vizinho."
msgstr "Esa. Gané el primer puesto y salió el nombre del vecino."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Que vergonha. Amanhã a gente corrige com foto e tudo."
msgstr "Qué vergüenza. Mañana lo corregimos, con foto y todo."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "E o vizinho já está se gabando pela rua toda."
msgstr "Y el vecino ya anda presumiendo por toda la calle."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Amanhã ele lê a correção. Venha às {hour} pra foto."
msgstr "Mañana lee la corrección. Venga a las {hour} para la foto."

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "Gazeta, redação. Quem fala?"
msgstr "Gaceta, redacción. ¿Quién habla?"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "da Gazeta"
msgstr "de la Gazeta"

#: data/directory/101_gazeta_de_sao_sotero.tres
msgid "pra Gazeta"
msgstr "con la Gazeta"

#: data/directory/390_radio_serena_am.tres
msgid "a Rádio Serena"
msgstr "Rádio Serena"

#: data/directory/390_radio_serena_am.tres
msgid "Quero pedir uma música."
msgstr "Quiero pedir una canción."

#: data/directory/390_radio_serena_am.tres
msgid "Boa noite. Queria pedir uma música pro programa da noite."
msgstr "Buenas noches. Quería pedir una canción para el programa de la noche."

#: data/directory/390_radio_serena_am.tres
msgid "Pode pedir. Qual é a música?"
msgstr "Pida nomás. ¿Qué canción?"

#: data/directory/390_radio_serena_am.tres
msgid "Uma valsa antiga, aquela que tocava nos bailes do clube."
msgstr "Un vals antiguo, ese que tocaban en los bailes del club."

#: data/directory/390_radio_serena_am.tres
msgid "Tem várias. Sabe o nome de alguma?"
msgstr "Hay varios. ¿Sabe el nombre?"

#: data/directory/390_radio_serena_am.tres
msgid "O nome eu não lembro. Mas é a que todo mundo dançava no fim."
msgstr "El nombre no me acuerdo. Pero es la que todos bailaban al final."

#: data/directory/390_radio_serena_am.tres
msgid "Já sei qual é. Toca às {hour}. Ofereço pra quem?"
msgstr "Ya sé cuál es. Sale a las {hour}. ¿Se la dedico a quién?"

#: data/directory/390_radio_serena_am.tres
msgid "Boa noite. Queria oferecer uma música pra uma pessoa especial."
msgstr "Buenas noches. Quería dedicar una canción a una persona especial."

#: data/directory/390_radio_serena_am.tres
msgid "Pode falar. Qual música?"
msgstr "Dígame. ¿Qué canción?"

#: data/directory/390_radio_serena_am.tres
msgid "Uma moda de viola, daquelas bem antigas."
msgstr "Una canción campera, de esas bien antiguas."

#: data/directory/390_radio_serena_am.tres
msgid "Tenho umas três aqui. Ofereço em nome de quem?"
msgstr "Tengo como tres aquí. ¿De parte de quién?"

#: data/directory/390_radio_serena_am.tres
msgid "Diz só que é de alguém que não esqueceu."
msgstr "Diga solo que es de alguien que no se olvidó."

#: data/directory/390_radio_serena_am.tres
msgid "Vai ao ar às {hour}, no programa dos pedidos."
msgstr "Sale al aire a las {hour}, en el programa de pedidos."

#: data/directory/390_radio_serena_am.tres
msgid "Quero mandar um recado pra um parente que trabalha na roça."
msgstr "Quiero mandarle un recado a un pariente que trabaja en el campo."

#: data/directory/390_radio_serena_am.tres
msgid "Boa noite. Queria mandar um recado pelo rádio."
msgstr "Buenas noches. Quería mandar un mensaje por la radio."

#: data/directory/390_radio_serena_am.tres
msgid "Recado pra quem, e de quem?"
msgstr "¿Mensaje para quién, y de quién?"

#: data/directory/390_radio_serena_am.tres
msgid "Pro meu primo, que trabalha na colheita. Diz que a família está bem."
msgstr "Para mi primo, que trabaja en la cosecha. Diga que la familia está bien."

#: data/directory/390_radio_serena_am.tres
msgid "Só isso? Que a família está bem?"
msgstr "¿Nada más? ¿Que la familia está bien?"

#: data/directory/390_radio_serena_am.tres
msgid "E que é pra ele descer no fim do mês, que a gente espera."
msgstr "Y que baje a fin de mes, que lo esperamos."

#: data/directory/390_radio_serena_am.tres
msgid "Vai ao ar às {hour}, no quadro dos recados."
msgstr "Sale al aire a las {hour}, en la sección de los mensajes."

#: data/directory/390_radio_serena_am.tres
msgid "Boa noite. Dá pra mandar um recado pra roça pelo programa?"
msgstr "Buenas noches. ¿Se puede mandar un mensaje al campo por el programa?"

#: data/directory/390_radio_serena_am.tres
msgid "Dá. Pra quem é o recado?"
msgstr "Sí. ¿Para quién es el mensaje?"

#: data/directory/390_radio_serena_am.tres
msgid "Pro meu tio, que está no sítio. Diz pra ele descer na feira."
msgstr "Para mi tío, que está en la chacra. Que baje para la feria."

#: data/directory/390_radio_serena_am.tres
msgid "Na feira de quando?"
msgstr "¿La feria de cuándo?"

#: data/directory/390_radio_serena_am.tres
msgid "Na de sábado. Tem gente esperando por ele."
msgstr "La del sábado. Hay gente esperándolo."

#: data/directory/390_radio_serena_am.tres
msgid "Vai ao ar às {hour}, depois das notícias."
msgstr "Sale al aire a las {hour}, después de las noticias."

#: data/directory/390_radio_serena_am.tres
msgid "Rádio Serena. Quem fala, e do que se trata?"
msgstr "Radio Serena. ¿Quién habla y de qué se trata?"

#: data/directory/390_radio_serena_am.tres
msgid "Rádio Serena, boa noite! O que deseja?"
msgstr "¡Radio Serena, buenas noches! ¿Qué desea?"

#: data/directory/390_radio_serena_am.tres
msgid "Qual é a programação de hoje?"
msgstr "¿Cuál es la programación de hoy?"

#: data/directory/390_radio_serena_am.tres
msgid "Depois das notícias, o programa dos pedidos. À meia-noite, a gente sai do ar."
msgstr "Después de las noticias, el programa de pedidos. A la medianoche salimos del aire."

#: data/directory/390_radio_serena_am.tres
msgid "Posso pedir uma música?"
msgstr "¿Puedo pedir una canción?"

#: data/directory/390_radio_serena_am.tres
msgid "Pode. Deixa o nome que o locutor toca no programa das dez."
msgstr "Puede. Deje el nombre y el locutor la pasa en el programa de las diez."

#: data/directory/390_radio_serena_am.tres
msgid "Quem está no ar agora?"
msgstr "¿Quién está al aire ahora?"

#: data/directory/390_radio_serena_am.tres
msgid "O locutor da noite, com as modas de viola."
msgstr "El locutor de la noche, con las modas de viola."

#: data/directory/390_radio_serena_am.tres
msgid "Serena AM, estúdio. Fala rápido, que estamos no ar."
msgstr "Serena AM, estudio. Hable rápido, que estamos al aire."

#: data/directory/390_radio_serena_am.tres
msgid "Vai ter a previsão do tempo hoje?"
msgstr "¿Va a haber pronóstico del tiempo hoy?"

#: data/directory/390_radio_serena_am.tres
msgid "Às onze, depois do intervalo."
msgstr "A las once, después de la pausa."

#: data/directory/390_radio_serena_am.tres
msgid "Vocês recebem recado para a roça?"
msgstr "¿Reciben recados para el campo?"

#: data/directory/390_radio_serena_am.tres
msgid "Recebe, sim. Vai ao ar no quadro dos recados, depois das notícias."
msgstr "Sí, recibimos. Salen al aire en la sección de recados, después de las noticias."

#: data/directory/390_radio_serena_am.tres
msgid "Obrigado por ouvir a Serena. Boa noite!"
msgstr "Gracias por escuchar la Serena. ¡Buenas noches!"

#: data/directory/390_radio_serena_am.tres
msgid "da Rádio Serena"
msgstr "de Rádio Serena"

#: data/directory/390_radio_serena_am.tres
msgid "pra Rádio Serena"
msgstr "con Rádio Serena"

#: data/directory/168_alberto_ramos.tres
msgid "o seu Alberto Ramos"
msgstr "Seu Alberto Ramos"

#: data/directory/168_alberto_ramos.tres
msgid "Somos sócios. É sobre a loja."
msgstr "Somos socios. Es por la tienda."

#: data/directory/168_alberto_ramos.tres
msgid "Alberto, boa noite. É sobre a loja, não dá pra esperar."
msgstr "Alberto, buenas noches. Es por la tienda, no puede esperar."

#: data/directory/168_alberto_ramos.tres
msgid "Fala. O fornecedor deu notícia?"
msgstr "Dime. ¿El proveedor dio noticias?"

#: data/directory/168_alberto_ramos.tres
msgid "Deu. A mercadoria chega amanhã, às {hour}."
msgstr "Sí. La mercadería llega mañana a las {hour}."

#: data/directory/168_alberto_ramos.tres
msgid "Amanhã? Eu nem tenho lugar no depósito."
msgstr "¿Mañana? Ni siquiera tengo lugar en el depósito."

#: data/directory/168_alberto_ramos.tres
msgid "A gente arruma junto. Chego cedo pra ajudar."
msgstr "Lo arreglamos juntos. Llego temprano para ayudar."

#: data/directory/168_alberto_ramos.tres
msgid "Então traz o caderno das contas, que a gente confere tudo."
msgstr "Entonces trae el cuaderno de cuentas, que revisamos todo."

#: data/directory/168_alberto_ramos.tres
msgid "Boa noite, Alberto. Fechei o caixa e faltou dinheiro."
msgstr "Buenas noches, Alberto. Cerré la caja y faltó dinero."

#: data/directory/168_alberto_ramos.tres
msgid "Faltou quanto?"
msgstr "¿Cuánto faltó?"

#: data/directory/168_alberto_ramos.tres
msgid "Pouco. Acho que foi troco errado de tarde."
msgstr "Poco. Creo que fue un cambio mal dado a la tarde."

#: data/directory/168_alberto_ramos.tres
msgid "Acontece. Anota no caderno e amanhã a gente vê."
msgstr "Pasa. Anótalo en el cuaderno y mañana lo vemos."

#: data/directory/168_alberto_ramos.tres
msgid "Abro a loja às {hour}. Você vem?"
msgstr "Abro la tienda a las {hour}. ¿Vienes?"

#: data/directory/168_alberto_ramos.tres
msgid "Vou. Levo a chave da gaveta."
msgstr "Voy. Llevo la llave del cajón."

#: data/directory/168_alberto_ramos.tres
msgid "Preciso confirmar a viagem de amanhã."
msgstr "Necesito confirmar el viaje de mañana."

#: data/directory/168_alberto_ramos.tres
msgid "Alberto? A viagem de amanhã está confirmada?"
msgstr "¿Alberto? ¿El viaje de mañana está confirmado?"

#: data/directory/168_alberto_ramos.tres
msgid "Está. O ônibus sai às {dawn}, da rodoviária."
msgstr "Sí. El autobús sale a las {dawn}, de la terminal."

#: data/directory/168_alberto_ramos.tres
msgid "Às {dawn}? Achei que era mais tarde."
msgstr "¿A las {dawn}? Pensé que era más tarde."

#: data/directory/168_alberto_ramos.tres
msgid "Mudaram o horário. Leva casaco, que na capital está frio."
msgstr "Cambiaron el horario. Lleva abrigo, que en la capital hace frío."

#: data/directory/168_alberto_ramos.tres
msgid "E os papéis do banco, ficam comigo?"
msgstr "¿Y los papeles del banco, los llevo yo?"

#: data/directory/168_alberto_ramos.tres
msgid "Ficam. Não esquece a pasta, senão a viagem é perdida."
msgstr "Sí. No olvides la carpeta, si no el viaje no sirve de nada."

#: data/directory/168_alberto_ramos.tres
msgid "Boa noite, Alberto. Vamos mesmo amanhã pra capital?"
msgstr "Buenas noches, Alberto. ¿Vamos mañana a la capital, entonces?"

#: data/directory/168_alberto_ramos.tres
msgid "Vamos. Eu passo aí de carro às {dawn}."
msgstr "Sí. Paso por ti en auto a las {dawn}."

#: data/directory/168_alberto_ramos.tres
msgid "De carro? E a estrada da serra, está boa?"
msgstr "¿En auto? ¿Y el camino de la sierra, está bien?"

#: data/directory/168_alberto_ramos.tres
msgid "Melhorou. Passaram a máquina na semana passada."
msgstr "Mejoró. Pasaron la máquina la semana pasada."

#: data/directory/168_alberto_ramos.tres
msgid "Então eu levo o lanche pra viagem."
msgstr "Entonces llevo la merienda para el viaje."

#: data/directory/168_alberto_ramos.tres
msgid "Leva, e garrafa de café. Volta só de noite."
msgstr "Llévala, y un termo de café. Volvemos de noche."

#: data/directory/168_alberto_ramos.tres
msgid "do seu Alberto Ramos"
msgstr "de Seu Alberto Ramos"

#: data/directory/168_alberto_ramos.tres
msgid "pro seu Alberto Ramos"
msgstr "con Seu Alberto Ramos"

#: data/directory/367_celia_rocha.tres
msgid "Alô? Quem fala a essa hora?"
msgstr "¿Hola? ¿Quién habla a esta hora?"

#: data/directory/367_celia_rocha.tres
msgid "Ah, está funcionando, sim. Estou ouvindo bem."
msgstr "Ah, sí, está funcionando. La escucho bien."

#: data/directory/367_celia_rocha.tres
msgid "Engano a essa hora... Tudo bem, acontece."
msgstr "Equivocado a esta hora... Está bien, pasa."

#: data/directory/367_celia_rocha.tres
msgid "Alô? É o Antônio?"
msgstr "¿Hola? ¿Es Antônio?"

#: data/directory/367_celia_rocha.tres
msgid "Não, senhora. Aqui é da central."
msgstr "No, señora. Aquí es la central."

#: data/directory/367_celia_rocha.tres
msgid "Ah. Pensei que fosse meu filho. Ele ficou de ligar."
msgstr "Ah. Pensé que era mi hijo. Quedó en llamar."

#: data/directory/367_celia_rocha.tres
msgid "É a dona Célia da Rua do Sol?"
msgstr "¿Es doña Célia, la de la Rua do Sol?"

#: data/directory/367_celia_rocha.tres
msgid "Sou eu. A outra Célia mora na avenida; todo mundo confunde."
msgstr "Soy yo. La otra Célia vive en la avenida; todo el mundo nos confunde."

#: data/directory/367_celia_rocha.tres
msgid "Boa noite. E não liga mais tarde, que eu acordo cedo."
msgstr "Buenas noches. Y no llame más tarde, que me levanto temprano."

#: data/directory/373_celia_rocha.tres
msgid "Residência da Célia, boa noite."
msgstr "Casa de Célia, buenas noches."

#: data/directory/373_celia_rocha.tres
msgid "É a dona Célia da Avenida Brasil?"
msgstr "¿Es doña Célia, la de la Avenida Brasil?"

#: data/directory/373_celia_rocha.tres
msgid "Isso. Se procura a da Rua do Sol, é o outro número."
msgstr "Así es. Si busca a la de la Rua do Sol, es el otro número."

#: data/directory/373_celia_rocha.tres
msgid "Pode testar à vontade. O meu telefone vive chiando."
msgstr "Pruebe tranquila. Mi teléfono vive haciendo ruido."

#: data/directory/373_celia_rocha.tres
msgid "Alô? Pode falar, eu estava acordada."
msgstr "¿Hola? Hable, estaba despierta."

#: data/directory/373_celia_rocha.tres
msgid "Desculpe ligar tão tarde."
msgstr "Disculpe que llame tan tarde."

#: data/directory/373_celia_rocha.tres
msgid "Não faz mal. Com o movimento na rua, quem consegue dormir?"
msgstr "No importa. Con el movimiento en la calle, ¿quién puede dormir?"

#: data/directory/373_celia_rocha.tres
msgid "Está ouvindo bem?"
msgstr "¿Me escucha bien?"

#: data/directory/373_celia_rocha.tres
msgid "Com um chiadinho, mas dá para entender."
msgstr "Con un poco de ruido, pero se entiende."

#: data/directory/355_bilhar_do_tonho.tres
msgid "o Bilhar do Tonho"
msgstr "el Bilhar do Tonho"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Meu pai está aí jogando e não volta pra casa."
msgstr "Mi padre está ahí jugando y no vuelve a casa."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Boa noite. Meu pai está aí? Um senhor de bigode, de camisa xadrez."
msgstr "Buenas noches. ¿Está mi padre ahí? Un señor de bigote, de camisa a cuadros."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Está, sim. Na mesa do fundo, ganhando de todo mundo."
msgstr "Sí, está. En la mesa del fondo, ganándole a todos."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Fala pra ele que a mãe está esperando com a janta."
msgstr "Dígale que mamá lo espera con la cena."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Falo, mas ele disse que só sai depois da última partida."
msgstr "Le digo, pero dijo que no se va hasta la última partida."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Diz que a janta já esfriou duas vezes."
msgstr "Dígale que la cena ya se enfrió dos veces."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Esse recado eu dou. Aí ele vem rapidinho."
msgstr "Ese recado se lo doy. Ahí viene enseguida."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Boa noite. Meu pai está aí no bilhar?"
msgstr "Buenas noches. ¿Está mi padre ahí en el billar?"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Está, sim. Jogando a dinheiro com uns rapazes."
msgstr "Sí, está. Jugando por plata con unos muchachos."

#: data/directory/355_bilhar_do_tonho.tres
msgid "A dinheiro? Fala pra ele vir pra casa agora."
msgstr "¿Por plata? Dígale que venga a casa ya."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Ele disse que só sai quando recuperar o que perdeu."
msgstr "Dice que no se va hasta recuperar lo que perdió."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Diz que a mãe está esperando acordada."
msgstr "Dígale que mamá lo espera despierta."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Esse recado assusta mais. Vou falar."
msgstr "Ese recado asusta más. Le digo."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Quero deixar um recado pro meu irmão, que joga aí toda noite."
msgstr "Quiero dejarle un recado a mi hermano, que juega ahí todas las noches."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Boa noite. Meu irmão está aí? O magrinho, de óculos."
msgstr "Buenas noches. ¿Está mi hermano ahí? El flaquito, de anteojos."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Está aqui, esperando a vez dele na mesa."
msgstr "Está aquí, esperando su turno en la mesa."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Avisa que a moto dele ficou com o farol aceso na frente de casa."
msgstr "Avísele que dejó la moto con el faro prendido frente a la casa."

#: data/directory/355_bilhar_do_tonho.tres
msgid "O farol aceso? Vou falar agora, senão amanhã não pega."
msgstr "¿El faro prendido? Le digo ya, si no mañana no arranca."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Isso. E diz que eu não vou lá apagar, não."
msgstr "Eso. Y dígale que yo no voy a apagarlo."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Pode deixar, eu falo assim mesmo."
msgstr "Déjelo, se lo digo tal cual."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Boa noite. Meu irmão está aí? O de chapéu {color}."
msgstr "Buenas noches. ¿Está mi hermano ahí? El de sombrero {color}."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Está, na mesa do canto."
msgstr "Sí, en la mesa del rincón."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Avisa que amanhã ele começa no serviço às {dawn}."
msgstr "Avísele que mañana entra a trabajar a las {dawn}."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Às {dawn}? Vou falar, mas ele não vai gostar."
msgstr "¿A las {dawn}? Le digo, pero no le va a gustar."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Diz que é ordem do patrão."
msgstr "Dígale que es orden del patrón."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Pode deixar. Falo agora mesmo."
msgstr "Déjelo. Le digo ahora mismo."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Bilhar do Tonho! Opa, pode falar!"
msgstr "¡Billar de Tonho! ¡Epa, diga!"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Tem mesa livre?"
msgstr "¿Hay mesa libre?"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Está tudo ocupado. Hoje tem campeonato dos ferroviários."
msgstr "Está todo ocupado. Hoy hay campeonato de los ferroviarios."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Até o último perder a camisa."
msgstr "Hasta que el último pierda la camisa."

#: data/directory/355_bilhar_do_tonho.tres
msgid "Tonho. Quem fala?"
msgstr "Tonho. ¿Quién habla?"

#: data/directory/355_bilhar_do_tonho.tres
msgid "É da central. Está tudo bem aí?"
msgstr "Es la central. ¿Todo bien por ahí?"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Tudo. Só uns rapazes que não querem ir embora."
msgstr "Todo. Solo unos muchachos que no se quieren ir."

#: data/directory/355_bilhar_do_tonho.tres
msgid "O barulho aí é de briga?"
msgstr "¿Ese ruido es una pelea?"

#: data/directory/355_bilhar_do_tonho.tres
msgid "Que nada, é o pessoal comemorando uma tacada."
msgstr "Qué va, es la gente festejando una jugada."

#: data/directory/355_bilhar_do_tonho.tres
msgid "do Bilhar do Tonho"
msgstr "del Bilhar do Tonho"

#: data/directory/355_bilhar_do_tonho.tres
msgid "pro Bilhar do Tonho"
msgstr "con el Bilhar do Tonho"

#: data/directory/271_benedito_souza.tres
msgid "o seu Benedito Souza"
msgstr "Seu Benedito Souza"

#: data/directory/271_benedito_souza.tres
msgid "A luz da casa dele tá acesa e ele não atende a porta."
msgstr "La luz de su casa está encendida y no abre la puerta."

#: data/directory/271_benedito_souza.tres
msgid "Seu Benedito? Bati aí e ninguém abriu. A luz está acesa."
msgstr "¿Don Benedito? Golpeé y nadie abrió. La luz está prendida."

#: data/directory/271_benedito_souza.tres
msgid "Ah, era você? Cochilei na poltrona com o rádio ligado."
msgstr "¿Ah, era usted? Me dormí en el sillón con la radio puesta."

#: data/directory/271_benedito_souza.tres
msgid "Que susto o senhor me deu. Está tudo bem mesmo?"
msgstr "Qué susto me dio. ¿Está bien de verdad?"

#: data/directory/271_benedito_souza.tres
msgid "Tudo. Só a vista que já não é a mesma."
msgstr "Todo bien. Solo la vista ya no es la misma."

#: data/directory/271_benedito_souza.tres
msgid "Amanhã eu passo pra levar o pão, lá pelas {hour}."
msgstr "Mañana paso a llevarle el pan, como a las {hour}."

#: data/directory/271_benedito_souza.tres
msgid "Pode vir. Deixo o portão destrancado."
msgstr "Venga. Dejo el portón sin llave."

#: data/directory/271_benedito_souza.tres
msgid "Seu Benedito, boa noite. A luz aí está acesa e o senhor não abriu."
msgstr "Don Benedito, buenas noches. La luz está prendida y usted no abrió."

#: data/directory/271_benedito_souza.tres
msgid "Estava no quintal, procurando o gato."
msgstr "Estaba en el patio, buscando al gato."

#: data/directory/271_benedito_souza.tres
msgid "A essa hora? Achou ele?"
msgstr "¿A esta hora? ¿Lo encontró?"

#: data/directory/271_benedito_souza.tres
msgid "Achei. Estava no telhado do vizinho, miando."
msgstr "Sí. Estaba en el techo del vecino, maullando."

#: data/directory/271_benedito_souza.tres
msgid "Ainda bem. Quer que eu passe aí?"
msgstr "Menos mal. ¿Quiere que pase?"

#: data/directory/271_benedito_souza.tres
msgid "Não precisa. Vou fazer um chá e deitar."
msgstr "No hace falta. Me hago un té y me acuesto."

#: data/directory/271_benedito_souza.tres
msgid "Ele ficou de me emprestar a escada."
msgstr "Quedó en prestarme la escalera."

#: data/directory/271_benedito_souza.tres
msgid "Boa noite, seu Benedito. Amanhã o senhor ainda me empresta a escada?"
msgstr "Buenas noches, don Benedito. ¿Mañana todavía me presta la escalera?"

#: data/directory/271_benedito_souza.tres
msgid "Está aqui encostada no muro. Pra que é?"
msgstr "Está aquí apoyada en el muro. ¿Para qué es?"

#: data/directory/271_benedito_souza.tres
msgid "Pra trocar umas telhas que quebraram no granizo."
msgstr "Para cambiar unas tejas que rompió el granizo."

#: data/directory/271_benedito_souza.tres
msgid "Então leva a corda também, pra amarrar lá em cima."
msgstr "Entonces llévese la soga también, para atarla arriba."

#: data/directory/271_benedito_souza.tres
msgid "Passo aí às {hour} pra buscar."
msgstr "Paso a buscarla a las {hour}."

#: data/directory/271_benedito_souza.tres
msgid "E toma cuidado. Telhado molhado escorrega."
msgstr "Y tenga cuidado. El techo mojado resbala."

#: data/directory/271_benedito_souza.tres
msgid "Seu Benedito, é sobre a escada que o senhor ia me emprestar."
msgstr "Don Benedito, es por la escalera que me iba a prestar."

#: data/directory/271_benedito_souza.tres
msgid "Ih, emprestei pro Ivo. Ele ainda não devolveu."
msgstr "Uy, se la presté a Ivo. Todavía no la devolvió."

#: data/directory/271_benedito_souza.tres
msgid "E agora? Preciso dela amanhã cedo."
msgstr "¿Y ahora? La necesito mañana temprano."

#: data/directory/271_benedito_souza.tres
msgid "Eu ligo pra ele de manhã e mando levar aí."
msgstr "Lo llamo a la mañana y le pido que se la lleve."

#: data/directory/271_benedito_souza.tres
msgid "Moro na {street}, número {house}."
msgstr "Vivo en {street}, número {house}."

#: data/directory/271_benedito_souza.tres
msgid "Anotei aqui no calendário. Ele leva até as {hour}."
msgstr "Lo anoté en el calendario. Se la lleva antes de las {hour}."

#: data/directory/271_benedito_souza.tres
msgid "do seu Benedito Souza"
msgstr "de Seu Benedito Souza"

#: data/directory/271_benedito_souza.tres
msgid "pro seu Benedito Souza"
msgstr "con Seu Benedito Souza"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "o ponto de táxi da rodoviária"
msgstr "la parada de taxis de la terminal"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Preciso de um carro até a rodoviária."
msgstr "Necesito un auto hasta la terminal."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Boa noite. Preciso de um carro até a rodoviária."
msgstr "Buenas noches. Necesito un auto hasta la terminal."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Pra agora? De onde?"
msgstr "¿Para ahora? ¿Desde dónde?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Da {street}, número {house}."
msgstr "Desde {street}, número {house}."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Tem um carro livre. Chega aí em {wait}."
msgstr "Hay un auto libre. Llega en {wait}."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Tenho duas malas grandes. Cabe no porta-malas?"
msgstr "Tengo dos maletas grandes. ¿Caben en el maletero?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Cabe. O motorista ajuda a carregar."
msgstr "Caben. El chofer le ayuda a cargarlas."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Boa noite. Tem carro pra me levar até a rodoviária?"
msgstr "Buenas noches. ¿Hay un auto para llevarme a la terminal?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "A essa hora só tem um rodando. Onde você está?"
msgstr "A esta hora hay uno solo andando. ¿Dónde está?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Na praça, em frente à farmácia."
msgstr "En la plaza, frente a la farmacia."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Fica embaixo do poste, que ele te acha. Chega em {wait}."
msgstr "Espere bajo el farol, que se ve bien. Llega en {wait}."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "É um carro de que cor?"
msgstr "¿De qué color es el auto?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "{color}, com a placa de táxi no teto."
msgstr "{color}, con el cartel de taxi en el techo."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "O último ônibus sai às onze e eu não posso perder."
msgstr "El último autobús sale a las once y no lo puedo perder."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Boa noite. O último ônibus sai às onze e eu não posso perder."
msgstr "Buenas noches. El último autobús sale a las once y no lo puedo perder."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Onde você está?"
msgstr "¿Dónde está?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Na {street}. Dá tempo?"
msgstr "En {street}. ¿Llego a tiempo?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Dá, se sair já. O carro chega em {wait}."
msgstr "Sí, si sale ya. El auto llega en {wait}."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Fico esperando no portão, com a mala."
msgstr "Espero en el portón, con la maleta."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "O motorista buzina duas vezes quando chegar."
msgstr "El chofer toca la bocina dos veces al llegar."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Boa noite. Preciso pegar o ônibus das onze. É urgente."
msgstr "Buenas noches. Tengo que tomar el autobús de las once. Es urgente."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Vai pra capital?"
msgstr "¿Va a la capital?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Vou. Começo num serviço novo amanhã cedo."
msgstr "Sí. Empiezo un trabajo nuevo mañana temprano."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Então vamos correr. Qual o endereço?"
msgstr "Entonces apurémonos. ¿Cuál es la dirección?"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "{street}, {house}. A casa da esquina."
msgstr "{street}, {house}. La casa de la esquina."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Em {wait} o carro está aí. Deixa a mala no portão."
msgstr "En {wait} el auto está ahí. Deje la maleta en el portón."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "Ponto de táxi, boa noite."
msgstr "Parada de taxis, buenas noches."

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "do ponto de táxi da rodoviária"
msgstr "de la parada de taxis de la terminal"

#: data/directory/176_ponto_de_taxi_da_rodoviaria.tres
msgid "pro ponto de táxi da rodoviária"
msgstr "con la parada de taxis de la terminal"

#: data/directory/184_delegacia_plantao.tres
msgid "plantão"
msgstr "de guardia"

#: data/directory/184_delegacia_plantao.tres
msgid "a delegacia"
msgstr "la comisaría"

#: data/directory/184_delegacia_plantao.tres
msgid "Quero fazer uma queixa."
msgstr "Quiero hacer una denuncia."

#: data/directory/184_delegacia_plantao.tres
msgid "Boa noite. Arrombaram o portão da minha garagem e levaram a bicicleta."
msgstr "Buenas noches. Forzaron el portón de mi garaje y se llevaron la bicicleta."

#: data/directory/184_delegacia_plantao.tres
msgid "Queixa de furto é pessoalmente, aqui no balcão."
msgstr "Las denuncias de robo son en persona, aquí en el mostrador."

#: data/directory/184_delegacia_plantao.tres
msgid "A esta hora? A rua está escura feito breu."
msgstr "¿A esta hora? La calle está oscura como boca de lobo."

#: data/directory/184_delegacia_plantao.tres
msgid "Então venha amanhã cedo. Anote a hora em que notou."
msgstr "Entonces venga mañana temprano. Anote la hora en que lo notó."

#: data/directory/184_delegacia_plantao.tres
msgid "Notei agora há pouco, umas {hour}."
msgstr "Lo noté hace poco, a eso de las {hour}."

#: data/directory/184_delegacia_plantao.tres
msgid "Está certo. Amanhã cedo, com documento."
msgstr "Está bien. Mañana temprano, con documento."

#: data/directory/184_delegacia_plantao.tres
msgid "Boa noite. O vizinho de cima está batendo na parede faz uma hora."
msgstr "Buenas noches. El vecino de arriba lleva una hora golpeando la pared."

#: data/directory/184_delegacia_plantao.tres
msgid "É briga ou é barulho?"
msgstr "¿Es pelea o es ruido?"

#: data/directory/184_delegacia_plantao.tres
msgid "Barulho, eu acho. Mas não deixa ninguém dormir."
msgstr "Ruido, creo. Pero no deja dormir a nadie."

#: data/directory/184_delegacia_plantao.tres
msgid "Barulho é com o síndico. Se virar briga, ligue de novo."
msgstr "El ruido es cosa del administrador. Si se vuelve pelea, llame de nuevo."

#: data/directory/184_delegacia_plantao.tres
msgid "O síndico mora fora. Vou aguentar, então."
msgstr "El administrador vive afuera. Voy a aguantar, entonces."

#: data/directory/184_delegacia_plantao.tres
msgid "Perdi meus documentos."
msgstr "Perdí mis documentos."

#: data/directory/184_delegacia_plantao.tres
msgid "Boa noite. Meu pai perdeu a carteira com os documentos no ônibus."
msgstr "Buenas noches. Mi padre perdió la billetera con los documentos en el autobús."

#: data/directory/184_delegacia_plantao.tres
msgid "Alguém entregou uma aqui hoje à tarde. Qual o nome?"
msgstr "Alguien entregó una aquí esta tarde. ¿Cuál es el nombre?"

#: data/directory/184_delegacia_plantao.tres
msgid "Pedro Lopes. A carteira é marrom, de couro."
msgstr "Pedro Lopes. La billetera es marrón, de cuero."

#: data/directory/184_delegacia_plantao.tres
msgid "É essa mesma. Ele vem buscar, com outro documento."
msgstr "Es esa misma. Que venga a buscarla, con otro documento."

#: data/directory/184_delegacia_plantao.tres
msgid "Ele vai amanhã, então. Agradeço muito."
msgstr "Irá mañana, entonces. Muchas gracias."

#: data/directory/184_delegacia_plantao.tres
msgid "Boa noite. Perdi a carteira de trabalho. Preciso dar parte?"
msgstr "Buenas noches. Perdí la libreta de trabajo. ¿Tengo que hacer la denuncia?"

#: data/directory/184_delegacia_plantao.tres
msgid "Precisa, para tirar a segunda via."
msgstr "Sí, para sacar el duplicado."

#: data/directory/184_delegacia_plantao.tres
msgid "E eu faço isso aí, à noite?"
msgstr "¿Y lo hago ahí, de noche?"

#: data/directory/184_delegacia_plantao.tres
msgid "De noite só flagrante. Venha amanhã de manhã."
msgstr "De noche solo flagrantes. Venga mañana por la mañana."

#: data/directory/184_delegacia_plantao.tres
msgid "Amanhã de manhã, então."
msgstr "Mañana por la mañana, entonces."

#: data/directory/184_delegacia_plantao.tres
msgid "Traga duas testemunhas, se tiver."
msgstr "Traiga dos testigos, si tiene."

#: data/directory/184_delegacia_plantao.tres data/nights/night_04.tres data/nights/night_15.tres
msgid "Delegacia, plantão."
msgstr "Comisaría, guardia."

#: data/directory/184_delegacia_plantao.tres
msgid "da delegacia"
msgstr "de la comisaría"

#: data/directory/184_delegacia_plantao.tres
msgid "pra delegacia"
msgstr "a la comisaría"

#: data/directory/237_sonia_vieira.tres
msgid "a Dona Sônia Vieira"
msgstr "Dona Sônia Vieira"

#: data/directory/237_sonia_vieira.tres
msgid "Ela está esperando notícias minhas."
msgstr "Está esperando noticias mías."

#: data/directory/237_sonia_vieira.tres
msgid "Sônia? Sou eu. Desculpa não ter ligado antes."
msgstr "¿Sônia? Soy yo. Perdón por no llamar antes."

#: data/directory/237_sonia_vieira.tres
msgid "Até que enfim! Como foi lá no hospital?"
msgstr "¡Por fin! ¿Cómo te fue en el hospital?"

#: data/directory/237_sonia_vieira.tres
msgid "Foi tudo bem. O médico tirou o gesso hoje."
msgstr "Todo bien. El médico me sacó el yeso hoy."

#: data/directory/237_sonia_vieira.tres
msgid "Graças a Deus! E já anda direitinho?"
msgstr "¡Gracias a Dios! ¿Y ya caminas bien?"

#: data/directory/237_sonia_vieira.tres
msgid "Ainda mancando, mas sem dor."
msgstr "Todavía cojeo, pero sin dolor."

#: data/directory/237_sonia_vieira.tres
msgid "Amanhã eu passo aí com um bolo pra comemorar."
msgstr "Mañana paso con un pastel para festejar."

#: data/directory/237_sonia_vieira.tres
msgid "Boa noite, Sônia. Você queria notícias, então liguei."
msgstr "Buenas noches, Sônia. Querías noticias, así que llamé."

#: data/directory/237_sonia_vieira.tres
msgid "Queria! E a entrevista, como foi?"
msgstr "¡Sí! ¿Y la entrevista, cómo fue?"

#: data/directory/237_sonia_vieira.tres
msgid "Me chamaram. Começo na loja da {street} semana que vem."
msgstr "Me llamaron. Empiezo en la tienda de {street} la semana que viene."

#: data/directory/237_sonia_vieira.tres
msgid "Que alegria! Vai trabalhar de que horas a que horas?"
msgstr "¡Qué alegría! ¿En qué horario vas a trabajar?"

#: data/directory/237_sonia_vieira.tres
msgid "Das {hour} até as cinco, com uma hora de almoço."
msgstr "De las {hour} a las cinco, con una hora de almuerzo."

#: data/directory/237_sonia_vieira.tres
msgid "Então sábado a gente comemora aqui em casa."
msgstr "Entonces el sábado lo festejamos aquí en casa."

#: data/directory/237_sonia_vieira.tres
msgid "É sobre o aniversário da mãe dela."
msgstr "Es por el cumpleaños de su madre."

#: data/directory/237_sonia_vieira.tres
msgid "Sônia, boa noite. É sobre o aniversário da sua mãe."
msgstr "Sônia, buenas noches. Es por el cumpleaños de tu mamá."

#: data/directory/237_sonia_vieira.tres
msgid "Ah, a festa surpresa? Fala baixo, que ela está aqui."
msgstr "Ah, ¿la fiesta sorpresa? Habla bajo, que ella está aquí."

#: data/directory/237_sonia_vieira.tres
msgid "Consegui o salão da {street} pro sábado."
msgstr "Conseguí el salón de {street} para el sábado."

#: data/directory/237_sonia_vieira.tres
msgid "Que ótimo. E o bolo, quem faz?"
msgstr "Qué bien. ¿Y el pastel, quién lo hace?"

#: data/directory/237_sonia_vieira.tres
msgid "A padaria. Eu busco de manhã."
msgstr "La panadería. Lo busco a la mañana."

#: data/directory/237_sonia_vieira.tres
msgid "Então eu levo ela pra lá às {hour}, sem ela desconfiar."
msgstr "Entonces la llevo allá a las {hour}, sin que sospeche."

#: data/directory/237_sonia_vieira.tres
msgid "Oi, Sônia. O que a gente dá pra sua mãe no aniversário?"
msgstr "Hola, Sônia. ¿Qué le regalamos a tu mamá para el cumpleaños?"

#: data/directory/237_sonia_vieira.tres
msgid "Ela anda falando de uma máquina de costura nova."
msgstr "Anda hablando de una máquina de coser nueva."

#: data/directory/237_sonia_vieira.tres
msgid "É cara. A gente divide entre os irmãos?"
msgstr "Es cara. ¿La dividimos entre los hermanos?"

#: data/directory/237_sonia_vieira.tres
msgid "Divide. Eu falo com eles amanhã."
msgstr "Sí. Mañana hablo con ellos."

#: data/directory/237_sonia_vieira.tres
msgid "Tem uma na loja da {street}, de vitrine."
msgstr "Hay una en el escaparate de la tienda de {street}."

#: data/directory/237_sonia_vieira.tres
msgid "Então amanhã, às {hour}, a gente vai lá ver."
msgstr "Entonces mañana, a las {hour}, vamos a verla."

#: data/directory/237_sonia_vieira.tres
msgid "da Dona Sônia Vieira"
msgstr "de Dona Sônia Vieira"

#: data/directory/237_sonia_vieira.tres
msgid "pra Dona Sônia Vieira"
msgstr "con Dona Sônia Vieira"

#: data/directory/312_pensao_dona_cota.tres
msgid "a Pensão Dona Cota"
msgstr "la Pensão Dona Cota"

#: data/directory/312_pensao_dona_cota.tres
msgid "Preciso de um quarto barato pra esta noite."
msgstr "Necesito una habitación barata para esta noche."

#: data/directory/312_pensao_dona_cota.tres
msgid "Boa noite. Tem quarto pra hoje? Coisa simples, só pra dormir."
msgstr "Buenas noches. ¿Hay cuarto para hoy? Algo sencillo, solo para dormir."

#: data/directory/312_pensao_dona_cota.tres
msgid "Tem uma cama no quarto dos fundos. O banheiro é no corredor."
msgstr "Hay una cama en el cuarto del fondo. El baño está en el pasillo."

#: data/directory/312_pensao_dona_cota.tres
msgid "Tá ótimo. E quanto fica?"
msgstr "Está muy bien. ¿Y cuánto cuesta?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Com café é um pouco mais. Sem café sai mais em conta."
msgstr "Con desayuno es un poco más. Sin desayuno sale más barato."

#: data/directory/312_pensao_dona_cota.tres
msgid "Sem café, então. Daqui a {wait} eu chego."
msgstr "Sin desayuno, entonces. En {wait} llego."

#: data/directory/312_pensao_dona_cota.tres
msgid "Bate na janela do lado, que a porta da frente já está trancada."
msgstr "Toque en la ventana del costado, que la puerta de adelante ya está cerrada."

#: data/directory/312_pensao_dona_cota.tres
msgid "Boa noite. Tem cama pra hoje? Não posso pagar muito."
msgstr "Buenas noches. ¿Hay cama para hoy? No puedo pagar mucho."

#: data/directory/312_pensao_dona_cota.tres
msgid "Tem a do quarto coletivo. Divide com mais dois."
msgstr "Hay una en el cuarto compartido. Con otros dos."

#: data/directory/312_pensao_dona_cota.tres
msgid "Serve. Eles roncam?"
msgstr "Me sirve. ¿Roncan?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Um ronca, o outro fala dormindo. Mas são gente boa."
msgstr "Uno ronca, el otro habla dormido. Pero son buena gente."

#: data/directory/312_pensao_dona_cota.tres
msgid "Tá bom. Chego em {wait}."
msgstr "Está bien. Llego en {wait}."

#: data/directory/312_pensao_dona_cota.tres
msgid "Traz cobertor, se tiver. A noite aqui esfria."
msgstr "Traiga una manta, si tiene. Aquí la noche refresca."

#: data/directory/312_pensao_dona_cota.tres
msgid "Quero saber se tem vaga pra dois pernoitarem."
msgstr "Quiero saber si hay lugar para que dos pasen la noche."

#: data/directory/312_pensao_dona_cota.tres
msgid "Boa noite. Tem vaga pra duas pessoas? É só pra pernoitar."
msgstr "Buenas noches. ¿Hay lugar para dos? Es solo para pasar la noche."

#: data/directory/312_pensao_dona_cota.tres
msgid "Pra dois tem o quarto da frente, com duas camas."
msgstr "Para dos está el cuarto de adelante, con dos camas."

#: data/directory/312_pensao_dona_cota.tres
msgid "Ótimo. A gente chegou no último ônibus e não tem onde ficar."
msgstr "Perfecto. Llegamos en el último autobús y no tenemos dónde quedarnos."

#: data/directory/312_pensao_dona_cota.tres
msgid "Então venham logo, que a rua aqui fica escura depois das {hour}."
msgstr "Entonces vengan ya, que la calle queda oscura después de las {hour}."

#: data/directory/312_pensao_dona_cota.tres
msgid "Precisa levar alguma coisa? Documento?"
msgstr "¿Hay que llevar algo? ¿Documentos?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Só o documento, pra anotar no livro de hóspedes."
msgstr "Solo el documento, para anotarlo en el libro de huéspedes."

#: data/directory/312_pensao_dona_cota.tres
msgid "Boa noite. Tem quarto pra duas pessoas, só esta noite?"
msgstr "Buenas noches. ¿Hay cuarto para dos, solo esta noche?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Tem, mas só com uma cama de casal."
msgstr "Sí, pero solo con una cama de dos plazas."

#: data/directory/312_pensao_dona_cota.tres
msgid "Somos dois irmãos. Não tem com duas camas?"
msgstr "Somos hermanos. ¿No hay con dos camas?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Posso pôr um colchão no chão. Serve?"
msgstr "Puedo poner un colchón en el piso. ¿Le sirve?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Serve, sim. Chegamos em {wait}."
msgstr "Sí, sirve. Llegamos en {wait}."

#: data/directory/312_pensao_dona_cota.tres
msgid "Vou deixar a luz da frente acesa pra vocês."
msgstr "Les dejo la luz de adelante prendida."

#: data/directory/312_pensao_dona_cota.tres
msgid "Pensão. Quem é que fala?"
msgstr "Pensión. ¿Quién habla?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Tem vaga para hoje?"
msgstr "¿Hay lugar para hoy?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Tem um quarto nos fundos. Mas o portão fecha às dez, viu?"
msgstr "Hay un cuarto al fondo. Pero el portón cierra a las diez, ¿eh?"

#: data/directory/312_pensao_dona_cota.tres
msgid "A senhora ainda serve janta?"
msgstr "¿Usted todavía sirve la cena?"

#: data/directory/312_pensao_dona_cota.tres
msgid "A sopa já acabou. Amanhã tem feijoada, se quiser."
msgstr "La sopa ya se acabó. Mañana hay feijoada, si quiere."

#: data/directory/312_pensao_dona_cota.tres
msgid "Alô! Fala mais alto, que o rádio está ligado."
msgstr "¡Hola! Hable más alto, que la radio está prendida."

#: data/directory/312_pensao_dona_cota.tres
msgid "O que a senhora está ouvindo?"
msgstr "¿Qué está escuchando?"

#: data/directory/312_pensao_dona_cota.tres
msgid "A novela da Rádio Serena. Está bem na hora boa."
msgstr "La radionovela de Radio Serena. Justo en la mejor parte."

#: data/directory/312_pensao_dona_cota.tres
msgid "Tudo bem por aí?"
msgstr "¿Todo bien por ahí?"

#: data/directory/312_pensao_dona_cota.tres
msgid "Tudo, graças a Deus. Só a goteira da cozinha que não para."
msgstr "Todo, gracias a Dios. Solo la gotera de la cocina que no para."

#: data/directory/312_pensao_dona_cota.tres
msgid "Boa noite. E não liga depois das dez, que eu durmo cedo."
msgstr "Buenas noches. Y no llame después de las diez, que me acuesto temprano."

#: data/directory/312_pensao_dona_cota.tres
msgid "da Pensão Dona Cota"
msgstr "de la Pensão Dona Cota"

#: data/directory/312_pensao_dona_cota.tres
msgid "pra Pensão Dona Cota"
msgstr "con la Pensão Dona Cota"

#: data/directory/336_borracharia_do_neno.tres
msgid "a Borracharia do Neno"
msgstr "la Borracharia do Neno"

#: data/directory/336_borracharia_do_neno.tres
msgid "Furou o pneu do carro aqui na estrada."
msgstr "Se pinchó la rueda del auto aquí en el camino."

#: data/directory/336_borracharia_do_neno.tres
msgid "Boa noite. Furou o pneu, e o estepe também está vazio."
msgstr "Buenas noches. Se pinchó la rueda, y la de auxilio también está vacía."

#: data/directory/336_borracharia_do_neno.tres
msgid "Os dois? Aí não tem jeito, vou ter que ir até aí."
msgstr "¿Las dos? Entonces no hay caso, tengo que ir hasta allá."

#: data/directory/336_borracharia_do_neno.tres
msgid "Estou na saída da cidade, perto da placa de São Sotero."
msgstr "Estoy a la salida del pueblo, cerca del cartel de São Sotero."

#: data/directory/336_borracharia_do_neno.tres
msgid "Sei onde é. Levo um pneu e o macaco."
msgstr "Sé dónde es. Llevo una rueda y el gato."

#: data/directory/336_borracharia_do_neno.tres
msgid "Quanto tempo, mais ou menos?"
msgstr "¿Cuánto tarda, más o menos?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Coisa de {wait}. Liga o pisca, que de noite ninguém enxerga nada."
msgstr "Más o menos {wait}. Prenda las balizas, que de noche nadie ve nada."

#: data/directory/336_borracharia_do_neno.tres
msgid "Boa noite. Furou o pneu e eu não tenho macaco."
msgstr "Buenas noches. Se pinchó la rueda y no tengo gato."

#: data/directory/336_borracharia_do_neno.tres
msgid "Sem macaco não tem jeito. Onde você está?"
msgstr "Sin gato no hay caso. ¿Dónde está?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Na {street}, quase no número {house}."
msgstr "En {street}, casi en el número {house}."

#: data/directory/336_borracharia_do_neno.tres
msgid "É perto, então. Dá pra ir a pé com o macaco."
msgstr "Queda cerca, entonces. Puedo ir a pie con el gato."

#: data/directory/336_borracharia_do_neno.tres
msgid "Precisa levar alguma coisa?"
msgstr "¿Hace falta algo?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Só a lanterna, se tiver. Chego em {wait}."
msgstr "Solo la linterna, si tiene. Llego en {wait}."

#: data/directory/336_borracharia_do_neno.tres
msgid "O carro morreu no meio da rua e não pega."
msgstr "El auto se paró en medio de la calle y no arranca."

#: data/directory/336_borracharia_do_neno.tres
msgid "Boa noite. O carro morreu no meio da rua e não quer pegar."
msgstr "Buenas noches. El auto se paró en medio de la calle y no arranca."

#: data/directory/336_borracharia_do_neno.tres
msgid "Está atrapalhando o trânsito?"
msgstr "¿Está trabando el tránsito?"

#: data/directory/336_borracharia_do_neno.tres
msgid "A essa hora não passa ninguém. Mas está bem no meio da rua."
msgstr "A esta hora no pasa nadie. Pero está justo en medio de la calle."

#: data/directory/336_borracharia_do_neno.tres
msgid "Empurra pro canto, se conseguir. Tem alguém aí pra ajudar?"
msgstr "Empújelo a un costado, si puede. ¿Hay alguien que ayude?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Tem um rapaz aqui me ajudando a empurrar."
msgstr "Hay un muchacho aquí ayudándome a empujar."

#: data/directory/336_borracharia_do_neno.tres
msgid "Então empurra e me espera. Em {wait} eu chego."
msgstr "Entonces empújelo y espéreme. En {wait} llego."

#: data/directory/336_borracharia_do_neno.tres
msgid "Boa noite. O carro apagou aqui na {street} e não pega mais."
msgstr "Buenas noches. El auto se apagó aquí en {street} y no arranca más."

#: data/directory/336_borracharia_do_neno.tres
msgid "Fez algum barulho antes de apagar?"
msgstr "¿Hizo algún ruido antes de apagarse?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Deu um estouro e saiu fumaça preta."
msgstr "Dio un estallido y salió humo negro."

#: data/directory/336_borracharia_do_neno.tres
msgid "Então nem tenta dar partida de novo."
msgstr "Entonces ni intente arrancarlo de nuevo."

#: data/directory/336_borracharia_do_neno.tres
msgid "Tá bom. Fico esperando aqui do lado."
msgstr "Está bien. Me quedo esperando aquí al lado."

#: data/directory/336_borracharia_do_neno.tres
msgid "Chego em {wait}. Deixa o capô aberto pra eu achar."
msgstr "Llego en {wait}. Deje el capó abierto así lo encuentro."

#: data/directory/336_borracharia_do_neno.tres
msgid "Borracharia do Neno, boa noite."
msgstr "Gomería de Neno, buenas noches."

#: data/directory/336_borracharia_do_neno.tres
msgid "Borracharia, boa noite."
msgstr "Gomería, buenas noches."

#: data/directory/336_borracharia_do_neno.tres
msgid "Vocês atendem de madrugada?"
msgstr "¿Atienden de madrugada?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Se bater no portão, eu acordo. Moro nos fundos."
msgstr "Si golpea el portón, me despierto. Vivo al fondo."

#: data/directory/336_borracharia_do_neno.tres
msgid "Tem pneu de Fusca?"
msgstr "¿Tiene neumático de escarabajo?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Tenho dois recapados. Novo, só semana que vem."
msgstr "Tengo dos recauchutados. Nuevo, recién la semana que viene."

#: data/directory/336_borracharia_do_neno.tres
msgid "Neno falando. Furou onde?"
msgstr "Habla Neno. ¿Dónde se pinchó?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Nada furou. Só queria saber se estão abertos."
msgstr "No se pinchó nada. Solo quería saber si están abiertos."

#: data/directory/336_borracharia_do_neno.tres
msgid "Aberto, não. Mas eu durmo aqui do lado; é só chamar."
msgstr "Abierto, no. Pero duermo aquí al lado; basta con llamar."

#: data/directory/336_borracharia_do_neno.tres
msgid "Quanto custa um remendo?"
msgstr "¿Cuánto cuesta un parche?"

#: data/directory/336_borracharia_do_neno.tres
msgid "Cinco cruzeiros, e o café é por minha conta."
msgstr "Cinco cruzeiros, y el café corre por mi cuenta."

#: data/directory/336_borracharia_do_neno.tres
msgid "da Borracharia do Neno"
msgstr "de la Borracharia do Neno"

#: data/directory/336_borracharia_do_neno.tres
msgid "pra Borracharia do Neno"
msgstr "con la Borracharia do Neno"

#: data/directory/001_morgana.tres
msgid "telefonista do Centro"
msgstr "telefonista del Centro"

#: data/directory/001_morgana.tres
msgid "Central do Centro, Morgana. Boa noite."
msgstr "Central del Centro, Morgana. Buenas noches."

#: data/directory/001_morgana.tres
msgid "Como está o movimento aí?"
msgstr "¿Cómo está el movimiento ahí?"

#: data/directory/001_morgana.tres
msgid "Normal para o horário. Nada a relatar."
msgstr "Normal para la hora. Nada que informar."

#: data/directory/001_morgana.tres
msgid "Alguma orientação nova da companhia?"
msgstr "¿Alguna instrucción nueva de la compañía?"

#: data/directory/001_morgana.tres
msgid "Nenhuma que eu saiba. Se vier, chega pelo supervisor."
msgstr "Ninguna que yo sepa. Si llega, será por el supervisor."

#: data/directory/001_morgana.tres
msgid "Só queria me apresentar."
msgstr "Solo quería presentarme."

#: data/directory/001_morgana.tres
msgid "Muito prazer. Precisando de alguma coisa do serviço, é só discar."
msgstr "Mucho gusto. Si necesita algo del servicio, solo marque."

#: data/directory/001_morgana.tres
msgid "Centro, Morgana falando. Pois não?"
msgstr "Centro, habla Morgana. ¿Diga?"

#: data/directory/001_morgana.tres
msgid "Tudo dentro do normal."
msgstr "Todo dentro de lo normal."

#: data/directory/001_morgana.tres
msgid "Você conhece a Cecília?"
msgstr "¿Conoce a Cecília?"

#: data/directory/001_morgana.tres
msgid "Do serviço. Conversamos pouco."
msgstr "Del trabajo. Hablamos poco."

#: data/directory/001_morgana.tres data/directory/002_cecilia.tres
msgid "Uma dúvida do serviço."
msgstr "Una duda del servicio."

#: data/directory/001_morgana.tres
msgid "Pois não. O que o manual não responder, anote e pergunte ao supervisor."
msgstr "Diga. Lo que el manual no responda, anótelo y pregúntele al supervisor."

#: data/directory/001_morgana.tres
msgid "Boa noite. Bom serviço."
msgstr "Buenas noches. Buen servicio."

#: data/directory/002_cecilia.tres
msgid "telefonista do Alto da Serra"
msgstr "telefonista del Alto da Serra"

#: data/directory/002_cecilia.tres
msgid "Alto da Serra, Cecília falando. Ah, Maria! Aconteceu alguma coisa?"
msgstr "Alto da Serra, habla Cecília. ¡Ah, Maria! ¿Pasó algo?"

#: data/directory/002_cecilia.tres
msgid "Só queria ouvir uma voz conhecida."
msgstr "Solo quería oír una voz conocida."

#: data/directory/002_cecilia.tres
msgid "Eu sei como é. A noite aqui também se arrasta. Precisando, me liga de novo."
msgstr "Sé cómo es. Aquí la noche también se arrastra. Si me necesitas, llámame otra vez."

#: data/directory/002_cecilia.tres
msgid "Como está o movimento por aí?"
msgstr "¿Cómo está el movimiento por ahí?"

#: data/directory/002_cecilia.tres
msgid "Calmo. Uma briga de vizinhos e uma senhora querendo saber a hora certa. E aí?"
msgstr "Tranquilo. Una pelea de vecinos y una señora queriendo saber la hora exacta. ¿Y ahí?"

#: data/directory/002_cecilia.tres
msgid "Na dúvida, registra na ficha e segue o manual. O supervisor só reclama do que não está escrito."
msgstr "Ante la duda, anótalo en la ficha y sigue el manual. El supervisor solo se queja de lo que no está escrito."

#: data/directory/002_cecilia.tres
msgid "Central do Alto da Serra, boa noite. Maria? Fala, menina."
msgstr "Central del Alto da Serra, buenas noches. ¿Maria? Dime, niña."

#: data/directory/002_cecilia.tres
msgid "Tudo bem com você?"
msgstr "¿Estás bien?"

#: data/directory/002_cecilia.tres
msgid "Tudo indo. Cansada, mas indo. E você, se acostumando com a mesa?"
msgstr "Ahí vamos. Cansada, pero vamos. ¿Y tú, acostumbrándote a la mesa?"

#: data/directory/002_cecilia.tres
msgid "Obrigada pela ajuda no treinamento."
msgstr "Gracias por la ayuda en el entrenamiento."

#: data/directory/002_cecilia.tres
msgid "Imagina. Você aprendeu rápido, viu? Melhor que eu no começo."
msgstr "No es nada. Aprendiste rápido, ¿sabes? Mejor que yo al principio."

#: data/directory/002_cecilia.tres
msgid "Boa noite, Maria. Juízo aí."
msgstr "Buenas noches, Maria. Pórtate bien."

#: data/content.tres data/calls/story_04_atropelado.tres data/calls/story_09_mae_atropelado.tres
msgid "Acidente de trânsito"
msgstr "Accidente vial"

#: data/content.tres data/calls/story_04_bomba_loja.tres data/calls/story_09_carro_fogo.tres
msgid "Incêndio"
msgstr "Incendio"

#: data/content.tres data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Mal súbito"
msgstr "Malestar súbito"

#: data/content.tres data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Invasão / roubo"
msgstr "Allanamiento / robo"

#: data/content.tres data/calls/story_04_baleado.tres data/calls/story_04_briga.tres
msgid "Outro"
msgstr "Otro"

#: data/nights/night_01.tres
msgid "Seu turno termina à meia-noite. Atenda as chamadas, conecte-as corretamente e registre todas as ocorrências."
msgstr "Su turno termina a medianoche. Conteste las llamadas, comuníquelas correctamente y registre todas."

#: data/calls/story_01_homem_bar.tres data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres
msgid "Homem"
msgstr "Hombre"

#: data/calls/story_01_homem_bar.tres
msgid "Boa noite. O Bar do Zé, por favor."
msgstr "Buenas noches. El Bar do Zé, por favor."

#: data/calls/story_01_homem_bar.tres data/calls/story_06_bar_sinal_1.tres data/calls/story_07_bar_radio.tres
msgid "O bar. O do Zé."
msgstr "El bar. El de Zé."

#: data/calls/story_01_homem_bar.tres data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres
msgid "Bar do Zé"
msgstr "Bar do Zé"

#: data/calls/story_01_homem_bar.tres
msgid "Obrigado, Maria."
msgstr "Gracias, Maria."

#: data/calls/story_01_homem_bar.tres
msgid "Zé? Sou eu."
msgstr "¿Zé? Soy yo."

#: data/calls/story_01_homem_bar.tres
msgid "Até que enfim. E então?"
msgstr "Por fin. ¿Y entonces?"

#: data/calls/story_01_homem_bar.tres
msgid "Ela passou a ligação. Chamei pelo nome e ela nem estranhou."
msgstr "Pasó la llamada. La llamé por su nombre y ni se extrañó."

#: data/calls/story_01_homem_bar.tres
msgid "É a filha dele mesmo?"
msgstr "¿Es su hija de verdad?"

#: data/calls/story_01_homem_bar.tres
msgid "É. A mesma voz da mãe. Amanhã eu ligo de novo."
msgstr "Sí. La misma voz de la madre. Mañana vuelvo a llamar."

#: data/calls/story_01_homem_bar.tres data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres
msgid "Sebastião Falcão."
msgstr "Sebastião Falcão."

#: data/calls/story_01_homem_bar.tres data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres
msgid "Isso não importa agora."
msgstr "Eso no importa ahora."

#: data/calls/story_01_miguel_trote.tres data/calls/story_03_miguel_trote.tres data/calls/story_06_miguel.tres
msgid "Menino"
msgstr "Niño"

#: data/calls/story_01_miguel_trote.tres data/calls/prank_06_menina.tres
msgid "Alô? É da central?"
msgstr "¿Hola? ¿Es la central?"

#: data/calls/story_01_miguel_trote.tres
msgid "É, sim. Em que posso ajudar?"
msgstr "Sí, es aquí. ¿En qué puedo ayudar?"

#: data/calls/story_01_miguel_trote.tres data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres data/templates/transfer_02.tres
msgid "Central, boa noite."
msgstr "Central, buenas noches."

#: data/calls/story_01_miguel_trote.tres
msgid "A senhora tem geladeira em casa?"
msgstr "Señora, ¿usted tiene heladera en casa?"

#: data/calls/story_01_miguel_trote.tres
msgid "Tenho. Por quê?"
msgstr "Tengo. ¿Por qué?"

#: data/calls/story_01_miguel_trote.tres
msgid "Isso é trote?"
msgstr "¿Esto es una broma?"

#: data/calls/story_01_miguel_trote.tres
msgid "Então corre, que ela tá fugindo!"
msgstr "¡Entonces corra, que se le escapa!"

#: data/calls/story_01_miguel_trote.tres
msgid "Hahaha!"
msgstr "¡Jajaja!"

#: data/nights/night_01.tres
msgid "Amanhã tem quermesse na praça, a senhora vai?"
msgstr "Mañana hay kermés en la plaza, ¿usted va?"

#: data/nights/night_01.tres
msgid "Se der tempo, eu vou."
msgstr "Si me da el tiempo, voy."

#: data/nights/night_01.tres
msgid "Vá, sim! A pamonha de lá é imperdível."
msgstr "¡Vaya, sí! Las humitas de allá no se pueden perder."

#: data/nights/night_01.tres
msgid "Não vou, não."
msgstr "No voy a ir."

#: data/nights/night_01.tres
msgid "Ah... tá bom, então."
msgstr "Ah... bueno, entonces."

#: data/nights/night_02.tres
msgid "O supervisor deixou um recado: \"Hoje é como ontem: atenda, transfira e anote tudo na ficha.\""
msgstr "El supervisor dejó una nota: \"Hoy es como ayer: atienda, transfiera y anote todo en la ficha.\""

#: data/calls/story_02_homem_bar_1.tres
msgid "Boa noite, Maria. O Bar do Zé, por favor. É urgente."
msgstr "Buenas noches, Maria. El Bar do Zé, por favor. Es urgente."

#: data/calls/story_02_homem_bar_1.tres
msgid "O bar, o do Zé. Quem eu sou não importa. Eu conheci o seu pai, Maria. Agora, por favor: o bar."
msgstr "El bar, el de Zé. Quién soy no importa. Conocí a tu padre, Maria. Ahora, por favor: el bar."

#: data/calls/story_02_homem_bar_1.tres
msgid "Obrigado. Você não vai se arrepender."
msgstr "Gracias. No te vas a arrepentir."

#: data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres data/calls/story_02_homem_bar_3.tres
msgid "Zé, sou eu. Não dava pra esperar até amanhã."
msgstr "Zé, soy yo. No podía esperar hasta mañana."

#: data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres data/calls/story_02_homem_bar_3.tres
msgid "Fala."
msgstr "Habla."

#: data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres data/calls/story_02_homem_bar_3.tres
msgid "Quarta-feira, na [place:Pensão Dona Cota]. Avisa o pessoal."
msgstr "El miércoles, en la [place:Pensão Dona Cota]. Avisa a los demás."

#: data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres data/calls/story_02_homem_bar_3.tres
msgid "E a moça da central?"
msgstr "¿Y la chica de la central?"

#: data/calls/story_02_homem_bar_1.tres data/calls/story_02_homem_bar_2.tres data/calls/story_02_homem_bar_3.tres
msgid "Ela vai ajudar. Ela só não sabe disso ainda."
msgstr "Va a ayudar. Solo que todavía no lo sabe."

#: data/calls/story_02_homem_bar_2.tres
msgid "Maria, sou eu de novo. Por que não me passou? O bar, por favor. É importante."
msgstr "Maria, soy yo otra vez. ¿Por qué no me pasaste? El bar, por favor. Es importante."

#: data/calls/story_02_homem_bar_2.tres
msgid "O Bar do Zé. Eu conheço você desde criança, Maria. Confie em mim só desta vez."
msgstr "El Bar do Zé. Te conozco desde que eras niña, Maria. Confía en mí solo esta vez."

#: data/calls/story_02_homem_bar_2.tres
msgid "Obrigado. Era só isso que eu pedia."
msgstr "Gracias. Era todo lo que pedía."

#: data/calls/story_02_homem_bar_3.tres
msgid "É a última vez que eu peço, Maria. O Bar do Zé."
msgstr "Es la última vez que lo pido, Maria. El Bar do Zé."

#: data/calls/story_02_homem_bar_3.tres
msgid "O bar. Se você não me passar agora, eu não ligo mais."
msgstr "El bar. Si no me pasas ahora, no vuelvo a llamar."

#: data/calls/story_02_homem_bar_3.tres
msgid "Obrigado. De verdade."
msgstr "Gracias. De verdad."

#: data/calls/story_02_otavio_radio.tres data/calls/story_03_otavio.tres data/calls/story_04_baleado.tres
msgid "Rapaz"
msgstr "Muchacho"

#: data/calls/story_02_otavio_radio.tres
msgid "Boa noite, moça! A Rádio Serena, por favor."
msgstr "¡Buenas noches, señorita! La Rádio Serena, por favor."

#: data/calls/story_02_otavio_radio.tres
msgid "Vou oferecer uma música pra uma moça que eu conheci no Alto da Serra."
msgstr "Voy a dedicarle una canción a una muchacha que conocí en Alto da Serra."

#: data/calls/story_02_otavio_radio.tres
msgid "A Rádio Serena! Antes que acabe o programa de pedidos."
msgstr "¡La Rádio Serena! Antes de que termine el programa de pedidos."

#: data/calls/story_02_otavio_radio.tres data/calls/story_04_radio_atentado.tres data/calls/story_05_otavio_radio.tres
msgid "Rádio Serena AM"
msgstr "Rádio Serena AM"

#: data/calls/story_02_otavio_radio.tres
msgid "Obrigado! Liga o rádio aí, hein?"
msgstr "¡Gracias! Prenda la radio, ¿eh?"

#: data/calls/story_02_otavio_radio.tres
msgid "Rádio Serena, programa de pedidos. Boa noite."
msgstr "Rádio Serena, programa de pedidos. Buenas noches."

#: data/calls/story_02_otavio_radio.tres
msgid "Boa noite! Quero oferecer [other:Luar da Serra] pra uma moça."
msgstr "¡Buenas noches! Quiero dedicarle [other:Luar da Serra] a una muchacha."

#: data/calls/story_02_otavio_radio.tres
msgid "Pois não. O nome dela?"
msgstr "Cómo no. ¿El nombre de ella?"

#: data/calls/story_02_otavio_radio.tres
msgid "Não sei o nome. É a moça de fita amarela que dançou comigo no baile do [place:Alto da Serra], domingo."
msgstr "No sé el nombre. Es la muchacha de la cinta amarilla que bailó conmigo en el baile de [place:Alto da Serra], el domingo."

#: data/calls/story_02_otavio_radio.tres
msgid "Sem nome, rapaz? E se ela não estiver ouvindo?"
msgstr "¿Sin nombre, muchacho? ¿Y si no está escuchando?"

#: data/calls/story_02_otavio_radio.tres
msgid "Ela ouve. Diz que é do [person:Otávio], e que ela pode deixar recado na central da Vila Serena."
msgstr "Ella escucha. Diga que es de [person:Otávio] y que puede dejar recado en la central de Vila Serena."

#: data/calls/story_02_otavio_radio.tres
msgid "Vai ao ar depois do noticiário. Boa sorte."
msgstr "Sale al aire después del noticiero. Buena suerte."

#: data/calls/story_02_otavio_radio.tres data/calls/story_05_otavio_radio.tres
msgid "Otávio Almeida."
msgstr "Otávio Almeida."

#: data/calls/noite_02_panfleto.tres
msgid "Dona Ivone"
msgstr "Dona Ivone"

#: data/calls/noite_02_panfleto.tres
msgid "Boa noite, moça. Me liga com a Pensão Dona Cota?"
msgstr "Buenas noches, señorita. ¿Me comunica con la Pensão Dona Cota?"

#: data/calls/noite_02_panfleto.tres
msgid "Quero falar com a dona Cota, é urgente."
msgstr "Quiero hablar con doña Cota, es urgente."

#: data/calls/noite_02_panfleto.tres
msgid "A pensão da dona Cota, minha filha. Três, um, dois."
msgstr "La pensión de doña Cota, hija. Tres, uno, dos."

#: data/calls/noite_02_panfleto.tres data/calls/story_04_pensao_marido.tres data/calls/noite_14_pensao.tres
msgid "Pensão Dona Cota"
msgstr "Pensão Dona Cota"

#: data/calls/noite_02_panfleto.tres data/calls/noite_07_raimundo_padre.tres data/calls/noite_11_parente.tres
msgid "Deus lhe pague, moça."
msgstr "Dios se lo pague, señorita."

#: data/calls/noite_02_panfleto.tres
msgid "Cota? É a Ivone. Você viu o jornal de hoje?"
msgstr "¿Cota? Soy Ivone. ¿Viste el diario de hoy?"

#: data/calls/noite_02_panfleto.tres
msgid "Vi. Os papéis na estação. Um hóspede meu achou um na mala."
msgstr "Lo vi. Los papeles en la estación. Un huésped mío encontró uno en la maleta."

#: data/calls/noite_02_panfleto.tres
msgid "Pois tinha um debaixo da minha porta também. Queimei no fogão."
msgstr "Pues había uno debajo de mi puerta también. Lo quemé en la cocina."

#: data/calls/noite_02_panfleto.tres
msgid "Fez bem. A polícia passou aqui perguntando quem anda de noite."
msgstr "Hiciste bien. La policía pasó por aquí preguntando quién anda de noche."

#: data/calls/noite_02_panfleto.tres
msgid "E você falou o quê?"
msgstr "¿Y tú qué dijiste?"

#: data/calls/noite_02_panfleto.tres
msgid "Que aqui só dorme caixeiro-viajante. E é verdade."
msgstr "Que aquí solo duermen viajantes de comercio. Y es verdad."

#: data/nights/night_02.tres
msgid "Disseram que a senhora ia na quermesse hoje à tarde e não apareceu, hein!"
msgstr "¡Dijeron que usted iba a la kermés esta tarde y no apareció, eh!"

#: data/nights/night_02.tres
msgid "Acabei dormindo, desculpe."
msgstr "Me quedé dormido, perdón."

#: data/nights/night_02.tres
msgid "Tá perdoado. Mas a pamonha acabou, viu?"
msgstr "Está perdonado. Pero las humitas se acabaron, ¿eh?"

#: data/nights/night_02.tres
msgid "Não deu."
msgstr "No pude."

#: data/nights/night_02.tres
msgid "Hum. Tá bom."
msgstr "Mm. Está bien."

#: data/nights/night_02.tres
msgid "A quermesse hoje à tarde foi uma beleza, a senhora perdeu."
msgstr "La kermés de esta tarde estuvo preciosa, usted se la perdió."

#: data/nights/night_02.tres
msgid "Que pena! Como foi?"
msgstr "¡Qué pena! ¿Cómo estuvo?"

#: data/nights/night_02.tres
msgid "Teve até sanfoneiro da capital!"
msgstr "¡Hasta hubo un acordeonista de la capital!"

#: data/nights/night_02.tres
msgid "Imagino."
msgstr "Me imagino."

#: data/nights/night_02.tres
msgid "...Pois é."
msgstr "...Pues sí."

#: data/nights/night_02.tres
msgid "Folhas recolhidas na plataforma da estação."
msgstr "Hojas recogidas en el andén de la estación."

#: data/nights/night_02.tres
msgid "Panfletos contra a Alta Cúpula aparecem na estação\nCentenas de folhas mimeografadas amanheceram espalhadas pela plataforma e pelos bancos da estação. A polícia recolheu o material e procura a gráfica clandestina. Quem souber de algo deve procurar a delegacia."
msgstr "Aparecen panfletos contra la Alta Cúpula en la estación\nCientos de hojas mimeografiadas amanecieron esparcidas por el andén y los bancos de la estación. La policía recogió el material y busca la imprenta clandestina. Quien sepa algo debe acudir a la comisaría."

#: data/nights/night_03.tres
msgid "O supervisor deixou um recado: \"Ordem da diretoria: a partir de hoje, peça o nome e o sobrenome de quem liga antes de completar a ligação. Quem não disser, não passa.\""
msgstr "El supervisor dejó una nota: \"Orden de la dirección: a partir de hoy, pida el nombre y el apellido de quien llama antes de completar la llamada. Quien no lo diga, no pasa.\""

#: data/calls/story_03_cecilia_aviso.tres data/calls/story_03_cecilia_bar.tres data/calls/story_05_cecilia.tres
msgid "Cecília"
msgstr "Cecília"

#: data/calls/story_03_cecilia_aviso.tres
msgid "Maria? É a Cecília, do Alto da Serra."
msgstr "¿Maria? Es Cecília, del Alto da Serra."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Liguei só pra avisar: a cidade está agitada hoje. Levaram gente presa no Centro, de tarde, e a polícia anda nervosa."
msgstr "Solo llamaba para avisarte: la ciudad está agitada hoy. Se llevaron gente presa en el Centro por la tarde, y la policía anda nerviosa."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Aconteceu alguma coisa grave?"
msgstr "¿Pasó algo grave?"

#: data/calls/story_03_cecilia_aviso.tres
msgid "Obrigada pelo aviso."
msgstr "Gracias por el aviso."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Ninguém sabe direito. E é melhor não saber."
msgstr "Nadie lo sabe bien. Y es mejor no saberlo."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Cuidado com o que você escuta nessa mesa, viu? E com o que você repete."
msgstr "Cuidado con lo que escuchas en esa mesa, ¿eh? Y con lo que repites."

#: data/calls/story_03_cecilia_aviso.tres data/calls/story_14_sebastiao.tres
msgid "Pode deixar."
msgstr "Déjalo en mis manos."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Você está me assustando."
msgstr "Me estás asustando."

#: data/calls/story_03_cecilia_aviso.tres
msgid "Boa noite, Maria. A gente se fala."
msgstr "Buenas noches, Maria. Hablamos."

#: data/calls/story_03_cecilia_bar.tres
msgid "Maria, é a Cecília de novo. Não posso demorar."
msgstr "Maria, es Cecília otra vez. No puedo tardar."

#: data/calls/story_03_cecilia_bar.tres
msgid "Tem alguém no Bar do Zé querendo falar com você. Liga pra lá pelo seu discador, não pela mesa."
msgstr "Hay alguien en el Bar do Zé que quiere hablar contigo. Llama allá con tu discador, no por la mesa."

#: data/calls/story_03_cecilia_bar.tres
msgid "Quem é?"
msgstr "¿Quién es?"

#: data/calls/story_03_cecilia_bar.tres data/calls/story_08_sebastiao.tres
msgid "Está bem."
msgstr "Está bien."

#: data/calls/story_03_cecilia_bar.tres
msgid "Ele mesmo te conta. Eu só fiz o favor de passar o recado."
msgstr "Él mismo te lo cuenta. Yo solo te paso el recado."

#: data/calls/story_03_cecilia_bar.tres
msgid "E Maria... não comenta isso com ninguém."
msgstr "Y Maria... no se lo comentes a nadie."

#: data/calls/story_03_generosa.tres data/calls/story_04_pensao_marido.tres data/calls/story_04_briga.tres
msgid "Moça"
msgstr "Muchacha"

#: data/calls/story_03_generosa.tres
msgid "Boa noite. Desculpe a hora. Aqui é a Generosa Prates."
msgstr "Buenas noches. Perdone la hora. Habla Generosa Prates."

#: data/calls/story_03_generosa.tres
msgid "Ontem um rapaz ofereceu uma música na Rádio Serena pra moça de fita amarela do baile. Era pra mim."
msgstr "Ayer un muchacho dedicó una canción en la Rádio Serena a la muchacha de la cinta amarilla del baile. Era para mí."

#: data/calls/story_03_generosa.tres
msgid "Ele disse que eu podia deixar recado aqui na central. Se ele ligar, a senhora passa o meu número? Três, oito, quatro. A linha é nova, ainda nem está na lista."
msgstr "Dijo que podía dejar recado aquí en la central. Si él llama, ¿usted le pasa mi número? Tres, ocho, cuatro. La línea es nueva, todavía ni está en la guía."

#: data/calls/story_03_generosa.tres data/content.tres
msgid "Passo, sim."
msgstr "Sí."

#: data/calls/story_03_generosa.tres
msgid "Deixa comigo."
msgstr "Déjelo en mis manos."

#: data/calls/story_03_generosa.tres
msgid "Ai, obrigada. Que vergonha... Boa noite!"
msgstr "Ay, gracias. Qué vergüenza... ¡Buenas noches!"

#: data/calls/story_03_miguel_trote.tres
msgid "Alô, central? Quero falar com o meu tio."
msgstr "¿Aló, central? Quiero hablar con mi tío."

#: data/calls/story_03_miguel_trote.tres
msgid "Seu nome e sobrenome, por favor."
msgstr "Su nombre y apellido, por favor."

#: data/calls/story_03_miguel_trote.tres
msgid "Quem é o seu tio?"
msgstr "¿Quién es tu tío?"

#: data/calls/story_03_miguel_trote.tres
msgid "O meu nome é Zé Pequeno Bolinho de Chuva da Silva."
msgstr "Me llamo Pepito Buñuelo de Lluvia da Silva."

#: data/calls/story_03_miguel_trote.tres
msgid "Hihihi."
msgstr "Jijiji."

#: data/calls/story_03_miguel_trote.tres
msgid "E eu sou a Rainha da Inglaterra."
msgstr "Y yo soy la Reina de Inglaterra."

#: data/calls/story_03_miguel_trote.tres
msgid "O nome de verdade, menino. Com sobrenome."
msgstr "El nombre de verdad, niño. Con apellido."

#: data/calls/story_03_miguel_trote.tres
msgid "Hahaha! A Rainha da Inglaterra trabalha na central!"
msgstr "¡Jajaja! ¡La Reina de Inglaterra trabaja en la central!"

#: data/calls/story_03_miguel_trote.tres
msgid "A senhora é legal. Tchau, Rainha!"
msgstr "Usted es buena onda. ¡Chau, Reina!"

#: data/calls/story_03_miguel_trote.tres
msgid "...Chata."
msgstr "...Pesada."

#: data/calls/story_03_otavio.tres
msgid "Boa noite, moça. Aqui é o Otávio Almeida. O da música de ontem, na rádio."
msgstr "Buenas noches, señorita. Habla Otávio Almeida. El de la canción de ayer, en la radio."

#: data/calls/story_03_otavio.tres
msgid "Alguma moça deixou recado pra mim? Uma de fita amarela?"
msgstr "¿Alguna muchacha dejó recado para mí? ¿Una de cinta amarilla?"

#: data/calls/story_03_otavio.tres
msgid "Deixou. É a Generosa, o número dela é 384."
msgstr "Sí. Es Generosa, su número es el 384."

#: data/calls/story_03_otavio.tres
msgid "Ninguém deixou recado, não."
msgstr "Nadie dejó recado, no."

#: data/calls/story_03_otavio.tres
msgid "Generosa... Três, oito, quatro. Escrevi na mão! Moça, você é uma santa. Boa noite!"
msgstr "Generosa... Tres, ocho, cuatro. ¡Lo escribí en la mano! Señorita, usted es una santa. ¡Buenas noches!"

#: data/calls/story_03_otavio.tres
msgid "Ninguém? ...Vai ver ela não estava ouvindo. Obrigado assim mesmo."
msgstr "¿Nadie? ...A lo mejor no estaba escuchando. Gracias igual."

#: data/calls/noite_03_nome.tres data/calls/transfer_25_seu_jair_mercearia_silva.tres data/content.tres
msgid "Seu Jair"
msgstr "Seu Jair"

#: data/calls/noite_03_nome.tres
msgid "Boa noite. Li no jornal que agora tem que dar o nome pra telefonista."
msgstr "Buenas noches. Leí en el diario que ahora hay que darle el nombre a la operadora."

#: data/calls/noite_03_nome.tres
msgid "Me liga com o Cine Odeon, faz favor."
msgstr "Comuníqueme con el Cine Odeon, por favor."

#: data/calls/noite_03_nome.tres data/calls/noite_09_toque.tres
msgid "O cinema, moça. O Odeon."
msgstr "El cine, señorita. El Odeon."

#: data/calls/noite_03_nome.tres data/calls/story_04_mae_cinema.tres data/calls/noite_09_toque.tres
msgid "Cine Odeon"
msgstr "Cine Odeon"

#: data/calls/noite_03_nome.tres
msgid "Obrigado. E boa sorte com a papelada, moça."
msgstr "Gracias. Y suerte con el papeleo, señorita."

#: data/calls/noite_03_nome.tres
msgid "Odeon? Aqui é o Jair. Que filme passa no sábado?"
msgstr "¿Odeon? Habla Jair. ¿Qué película dan el sábado?"

#: data/calls/noite_03_nome.tres
msgid "Boa noite, seu Jair. Um faroeste, às sete e às nove."
msgstr "Buenas noches, don Jair. Un western, a las siete y a las nueve."

#: data/calls/noite_03_nome.tres
msgid "Às nove ainda tem? Com essa história de nome e documento pra tudo..."
msgstr "¿Todavía a las nueve? Con este asunto de nombre y documento para todo..."

#: data/calls/noite_03_nome.tres
msgid "Por enquanto tem. Mas a censura cortou meia hora do filme."
msgstr "Por ahora sí. Pero la censura le cortó media hora a la película."

#: data/calls/noite_03_nome.tres
msgid "Cortou o quê?"
msgstr "¿Qué le cortó?"

#: data/calls/noite_03_nome.tres
msgid "A parte do xerife que prende o governador. Ficou sem pé nem cabeça."
msgstr "La parte del sheriff que arresta al gobernador. Quedó sin pies ni cabeza."

#: data/calls/noite_03_nome.tres
msgid "Jair Monteiro. Anota aí, já que agora é obrigado."
msgstr "Jair Monteiro. Anótelo, ya que ahora es obligatorio."

#: data/nights/night_03.tres
msgid "Telefônica vai exigir o nome de quem liga\nA partir de hoje, a Companhia Telefônica de São Sotero só completa a ligação de quem disser nome e sobrenome à telefonista. A diretoria fala em \"segurança de todos\" e pede a compreensão dos assinantes."
msgstr "La Telefónica exigirá el nombre de quien llama\nDesde hoy, la Compañía Telefónica de São Sotero solo completa la llamada de quien diga nombre y apellido a la operadora. La dirección habla de \"la seguridad de todos\" y pide comprensión a los abonados."

#: data/nights/night_03.tres
msgid "Bar do Zé."
msgstr "Bar do Zé."

#: data/nights/night_03.tres
msgid "Maria? É você? Obrigado por ligar."
msgstr "¿Maria? ¿Eres tú? Gracias por llamar."

#: data/nights/night_03.tres
msgid "Ontem você me ouviu. Hoje eu preciso de mais uma coisa."
msgstr "Ayer me escuchaste. Hoy necesito una cosa más."

#: data/nights/night_03.tres
msgid "Ontem você não quis me ouvir. Eu entendo. Mas hoje eu preciso de você."
msgstr "Ayer no quisiste escucharme. Lo entiendo. Pero hoy te necesito."

#: data/nights/night_03.tres
msgid "Quem é você?"
msgstr "¿Quién eres?"

#: data/nights/night_03.tres
msgid "O que você quer?"
msgstr "¿Qué quieres?"

#: data/nights/night_03.tres
msgid "Alguém que conhece você desde criança. Por enquanto, basta isso."
msgstr "Alguien que te conoce desde niña. Por ahora, basta con eso."

#: data/nights/night_03.tres
msgid "Amanhã, às oito e meia da noite, ligue para o Hotel Serena pelo seu discador."
msgstr "Mañana, a las ocho y media de la noche, llama al Hotel Serena con tu discador."

#: data/nights/night_03.tres
msgid "Quando atenderem, diga só isto: \"A semente brotou.\" Nada mais."
msgstr "Cuando contesten, di solo esto: \"La semilla brotó.\" Nada más."

#: data/nights/night_03.tres
msgid "\"A semente brotou.\" Entendi."
msgstr "\"La semilla brotó.\" Entendido."

#: data/nights/night_03.tres
msgid "E se eu não ligar?"
msgstr "¿Y si no llamo?"

#: data/nights/night_03.tres
msgid "Então nada acontece. E tudo continua como está."
msgstr "Entonces no pasa nada. Y todo sigue como está."

#: data/nights/night_03.tres
msgid "Oito e meia. Não esqueça. Boa noite, Maria."
msgstr "Ocho y media. No lo olvides. Buenas noches, Maria."

#: data/nights/night_04.tres
msgid "O supervisor deixou um recado: \"Houve explosões em vários pontos da cidade esta tarde, e há protesto marcado na praça. A noite vai ser pesada: emergência primeiro, e nada de conversa na linha. A delegacia pede que qualquer conversa suspeita na linha seja comunicada pelo 184.\""
msgstr "El supervisor dejó una nota: \"Hubo explosiones en varios puntos de la ciudad esta tarde, y hay una protesta convocada en la plaza. La noche va a ser pesada: las emergencias primero, y nada de charlas en la línea. La comisaría pide que cualquier conversación sospechosa en la línea se comunique al 184.\""

#: data/calls/story_04_mae_cinema.tres data/calls/story_04_atropelado.tres data/calls/story_09_baleado.tres
msgid "Senhora"
msgstr "Señora"

#: data/calls/story_04_mae_cinema.tres
msgid "Pelo amor de Deus, o Cine Odeon! Minha filha foi à sessão das sete e disseram que explodiu uma bomba perto da praça!"
msgstr "¡Por el amor de Dios, el Cine Odeon! ¡Mi hija fue a la función de las siete y dicen que explotó una bomba cerca de la plaza!"

#: data/calls/story_04_mae_cinema.tres
msgid "O cinema, o Odeon! Rápido!"
msgstr "¡El cine, el Odeon! ¡Rápido!"

#: data/calls/story_04_mae_cinema.tres
msgid "Obrigada, minha filha. Deus te pague."
msgstr "Gracias, hija. Dios se lo pague."

#: data/calls/story_04_mae_cinema.tres
msgid "Alô, o cinema? A minha filha está aí, a [person:Lúcia]!"
msgstr "¿Aló, el cine? ¡Mi hija está ahí, [person:Lúcia]!"

#: data/calls/story_04_mae_cinema.tres
msgid "Calma, senhora. A sessão parou, mas ninguém se machucou aqui."
msgstr "Calma, señora. La función se paró, pero nadie se lastimó aquí."

#: data/calls/story_04_mae_cinema.tres
msgid "E a bomba?"
msgstr "¿Y la bomba?"

#: data/calls/story_04_mae_cinema.tres
msgid "Foi na [street:Rua do Comércio], no Centro. Aqui só tremeu o vidro."
msgstr "Fue en la [street:Rua do Comércio], en el Centro. Aquí solo tembló el vidrio."

#: data/calls/story_04_mae_cinema.tres
msgid "Graças a Deus. Diz pra ela vir direto pra casa."
msgstr "Gracias a Dios. Dígale que venga directo a casa."

#: data/calls/story_04_mae_cinema.tres
msgid "Neusa Prado. Rápido, por favor!"
msgstr "Neusa Prado. ¡Rápido, por favor!"

#: data/calls/story_04_pensao_marido.tres
msgid "A Pensão Dona Cota, por favor. Meu marido saiu pro protesto e não voltou."
msgstr "La Pensão Dona Cota, por favor. Mi marido fue a la protesta y no volvió."

#: data/calls/story_04_pensao_marido.tres
msgid "A pensão. A da Dona Cota."
msgstr "La pensión. La de Dona Cota."

#: data/calls/story_04_pensao_marido.tres data/calls/story_08_generosa_recado.tres data/calls/story_10_generosa.tres
msgid "Obrigada."
msgstr "Gracias."

#: data/calls/story_04_pensao_marido.tres
msgid "Dona Cota? É a Rosana. O [person:Ivo] passou por aí?"
msgstr "¿Dona Cota? Es Rosana. ¿Pasó [person:Ivo] por ahí?"

#: data/calls/story_04_pensao_marido.tres
msgid "Passou correndo, minha filha. Disse que a polícia fechou a [place:praça]."
msgstr "Pasó corriendo, hija. Dijo que la policía cerró la [place:plaza]."

#: data/calls/story_04_pensao_marido.tres
msgid "E ele está bem?"
msgstr "¿Y está bien?"

#: data/calls/story_04_pensao_marido.tres
msgid "Está. Foi pros fundos, com outros dois. Melhor ninguém saber."
msgstr "Sí. Se fue al fondo, con otros dos. Mejor que nadie sepa."

#: data/calls/story_04_pensao_marido.tres
msgid "Rosana Lopes."
msgstr "Rosana Lopes."

#: data/calls/story_04_radio_atentado.tres data/calls/story_04_bomba_loja.tres data/calls/story_06_bar_sinal_2.tres
msgid "Senhor"
msgstr "Señor"

#: data/calls/story_04_radio_atentado.tres
msgid "A Rádio Serena, por favor. Quero saber o que explodiu hoje. Ninguém fala nada."
msgstr "La Rádio Serena, por favor. Quiero saber qué explotó hoy. Nadie dice nada."

#: data/calls/story_04_radio_atentado.tres data/calls/story_14_radio.tres data/calls/story_15_radio.tres
msgid "A rádio. A Serena."
msgstr "La radio. La Serena."

#: data/calls/story_04_radio_atentado.tres data/calls/story_05_otavio_radio.tres data/calls/story_06_bar_sinal_2.tres
msgid "Obrigado."
msgstr "Gracias."

#: data/calls/story_04_radio_atentado.tres
msgid "Rádio? Aqui é um ouvinte. O que foi que explodiu?"
msgstr "¿Radio? Habla un oyente. ¿Qué fue lo que explotó?"

#: data/calls/story_04_radio_atentado.tres
msgid "Não podemos dar a notícia, senhor. Ordem de cima."
msgstr "No podemos dar la noticia, señor. Órdenes de arriba."

#: data/calls/story_04_radio_atentado.tres
msgid "Nem dizer onde foi?"
msgstr "¿Ni siquiera dónde fue?"

#: data/calls/story_04_radio_atentado.tres
msgid "Nem isso. Fique em casa esta noite. É tudo o que eu posso dizer."
msgstr "Ni eso. Quédese en casa esta noche. Es todo lo que puedo decirle."

#: data/calls/story_04_radio_atentado.tres
msgid "Osvaldo Rezende."
msgstr "Osvaldo Rezende."

#: data/calls/story_04_baleado.tres
msgid "Central! Atiraram num homem aqui na rua! Ele tá caído no chão!"
msgstr "¡Central! ¡Le dispararon a un hombre aquí en la calle! ¡Está tirado en el suelo!"

#: data/calls/story_04_baleado.tres data/calls/story_04_atropelado.tres data/calls/story_04_bomba_loja.tres
msgid "Qual é o endereço?"
msgstr "¿Cuál es la dirección?"

#: data/calls/story_04_baleado.tres data/calls/noite_09_irma_tiros.tres data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele está consciente?"
msgstr "¿Está consciente?"

#: data/calls/story_04_baleado.tres data/calls/noite_09_irma_tiros.tres
msgid "Quem atirou ainda está aí?"
msgstr "¿Quien disparó sigue ahí?"

#: data/calls/story_04_baleado.tres
msgid "Rua da Estação, 120, em frente à banca!"
msgstr "¡Rua da Estação, 120, frente al quiosco!"

#: data/calls/story_04_baleado.tres
msgid "Tá gemendo, sangrando muito na perna!"
msgstr "¡Está gimiendo, sangra mucho de la pierna!"

#: data/calls/story_04_baleado.tres
msgid "Fugiram de carro, mas tão dando volta no quarteirão!"
msgstr "¡Huyeron en coche, pero están dando vueltas a la manzana!"

#: data/calls/story_04_baleado.tres
msgid "Rápido, pelo amor de Deus! Tô apertando a perna dele com a minha camisa."
msgstr "¡Rápido, por el amor de Dios! Le estoy apretando la pierna con mi camisa."

#: data/calls/story_04_baleado.tres
msgid "Ele tá ficando branco! Não para de sangrar!"
msgstr "¡Se está poniendo pálido! ¡No para de sangrar!"

#: data/calls/story_04_baleado.tres data/calls/story_09_baleado.tres data/templates/emergency_atropelamento.tres
msgid "Ele ainda responde?"
msgstr "¿Todavía responde?"

#: data/calls/story_04_baleado.tres
msgid "Responde, mas bem fraquinho!"
msgstr "¡Responde, pero muy débil!"

#: data/calls/story_04_baleado.tres
msgid "O carro voltou! Tão atirando de novo pra cá!"
msgstr "¡Volvió el coche! ¡Están disparando para acá otra vez!"

#: data/calls/story_04_baleado.tres data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tem mais alguém ferido?"
msgstr "¿Hay alguien más herido?"

#: data/calls/story_04_baleado.tres
msgid "Não sei, eu me escondi atrás do muro!"
msgstr "¡No sé, me escondí detrás del muro!"

#: data/calls/story_04_baleado.tres
msgid "Ele parou de falar... Ninguém veio."
msgstr "Dejó de hablar... No vino nadie."

#: data/calls/story_04_baleado.tres
msgid "Ele tá desacordado! Mandem alguém!"
msgstr "¡Está inconsciente! ¡Manden a alguien!"

#: data/calls/story_04_atropelado.tres
msgid "Central! Um carro passou por cima de um rapaz do protesto e nem parou!"
msgstr "¡Central! ¡Un coche atropelló a un muchacho de la protesta y ni paró!"

#: data/calls/story_04_atropelado.tres data/calls/story_09_mae_atropelado.tres
msgid "Como ele está?"
msgstr "¿Cómo está él?"

#: data/calls/story_04_atropelado.tres
msgid "A rua está livre?"
msgstr "¿La calle está despejada?"

#: data/calls/story_04_atropelado.tres
msgid "Avenida Brasil, 80, perto da padaria!"
msgstr "¡Avenida Brasil, 80, cerca de la panadería!"

#: data/calls/story_04_atropelado.tres
msgid "Tá no chão, com a perna torta, chorando de dor!"
msgstr "¡Está en el suelo, con la pierna torcida, llorando de dolor!"

#: data/calls/story_04_atropelado.tres
msgid "Livre nada! A avenida tá fechada com pedra, e tem gente correndo pra todo lado!"
msgstr "¡Qué va! ¡La avenida está cerrada con piedras y hay gente corriendo por todos lados!"

#: data/calls/story_04_atropelado.tres
msgid "Graças a Deus. Vou ficar aqui com ele."
msgstr "Gracias a Dios. Me quedo aquí con él."

#: data/calls/story_04_atropelado.tres
msgid "Ele tá vomitando, moça! Bateu a cabeça também!"
msgstr "¡Está vomitando, señorita! ¡También se golpeó la cabeza!"

#: data/calls/story_04_atropelado.tres data/calls/story_09_baleado.tres data/templates/emergency_mal_subito.tres
msgid "Ele está acordado?"
msgstr "¿Está despierto?"

#: data/calls/story_04_atropelado.tres
msgid "Tá, mas não sabe nem o próprio nome!"
msgstr "¡Sí, pero ni sabe su propio nombre!"

#: data/calls/story_04_atropelado.tres
msgid "Começaram a jogar pedra de novo! Acertaram um senhor na cabeça!"
msgstr "¡Empezaron a tirar piedras otra vez! ¡Le dieron a un señor en la cabeza!"

#: data/calls/story_04_atropelado.tres
msgid "Onde está o senhor?"
msgstr "¿Dónde está el señor?"

#: data/calls/story_04_atropelado.tres
msgid "Caído aqui do lado, sangrando na testa!"
msgstr "¡Tirado aquí al lado, sangrando de la frente!"

#: data/calls/story_04_atropelado.tres
msgid "O rapaz desmaiou... ninguém veio."
msgstr "El muchacho se desmayó... no vino nadie."

#: data/calls/story_04_atropelado.tres
msgid "Desmaiou! Não acorda!"
msgstr "¡Se desmayó! ¡No despierta!"

#: data/calls/story_04_bomba_loja.tres
msgid "Central! Jogaram uma bomba na loja de tecidos! Tá pegando fogo em tudo!"
msgstr "¡Central! ¡Tiraron una bomba en la tienda de telas! ¡Se está quemando todo!"

#: data/calls/story_04_bomba_loja.tres data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tem alguém lá dentro?"
msgstr "¿Hay alguien adentro?"

#: data/calls/story_04_bomba_loja.tres
msgid "O fogo está se espalhando?"
msgstr "¿El fuego se está extendiendo?"

#: data/calls/story_04_bomba_loja.tres
msgid "Rua do Comércio, 210, a loja do turco!"
msgstr "¡Rua do Comércio, 210, la tienda del turco!"

#: data/calls/story_04_bomba_loja.tres
msgid "O vigia! Saiu com as mãos queimadas, tá sentado aqui na calçada!"
msgstr "¡El sereno! ¡Salió con las manos quemadas, está sentado aquí en la vereda!"

#: data/calls/story_04_bomba_loja.tres
msgid "Tá subindo pro sobrado de cima!"
msgstr "¡Está subiendo al piso de arriba!"

#: data/calls/story_04_bomba_loja.tres
msgid "Não, a loja já tava fechada. Graças a Deus não tinha ninguém."
msgstr "No, la tienda ya estaba cerrada. Gracias a Dios no había nadie."

#: data/calls/story_04_bomba_loja.tres
msgid "Tô tirando o povo do sobrado!"
msgstr "¡Estoy sacando a la gente del piso de arriba!"

#: data/calls/story_04_bomba_loja.tres
msgid "O sobrado pegou fogo! Tem família morando ali!"
msgstr "¡Se prendió el piso de arriba! ¡Ahí vive una familia!"

#: data/calls/story_04_bomba_loja.tres
msgid "Todos já saíram?"
msgstr "¿Ya salieron todos?"

#: data/calls/story_04_bomba_loja.tres
msgid "Acho que sim, tão todos aqui na rua!"
msgstr "¡Creo que sí, están todos aquí en la calle!"

#: data/calls/story_04_bomba_loja.tres
msgid "Tem uma criança na janela do sobrado! A mãe tá gritando!"
msgstr "¡Hay un niño en la ventana del piso de arriba! ¡La madre está gritando!"

#: data/calls/story_04_bomba_loja.tres
msgid "A criança consegue descer?"
msgstr "¿El niño puede bajar?"

#: data/calls/story_04_bomba_loja.tres
msgid "Não! A escada tá pegando fogo!"
msgstr "¡No! ¡La escalera se está quemando!"

#: data/calls/story_04_bomba_loja.tres
msgid "O sobrado desabou..."
msgstr "El piso de arriba se derrumbó..."

#: data/calls/story_04_bomba_loja.tres
msgid "A criança! Tiraram pela janela dos fundos, mas tá respirando mal!"
msgstr "¡El niño! Lo sacaron por la ventana de atrás, ¡pero respira mal!"

#: data/calls/story_04_briga.tres
msgid "Central! Tão brigando aqui na rua, uns rapazes do protesto contra uns homens de outro bairro!"
msgstr "¡Central! ¡Se están peleando aquí en la calle, unos muchachos de la protesta contra unos hombres de otro barrio!"

#: data/calls/story_04_briga.tres data/calls/story_09_briga.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Alguém se machucou?"
msgstr "¿Alguien se lastimó?"

#: data/calls/story_04_briga.tres
msgid "Tem alguém armado?"
msgstr "¿Hay alguien armado?"

#: data/calls/story_04_briga.tres
msgid "Rua das Acácias, 150, na frente da quitanda!"
msgstr "¡Rua das Acácias, 150, frente a la verdulería!"

#: data/calls/story_04_briga.tres
msgid "Um rapaz levou uma garrafada na cabeça, tá sangrando!"
msgstr "¡A un muchacho le dieron un botellazo en la cabeza, está sangrando!"

#: data/calls/story_04_briga.tres
msgid "Um deles puxou uma faca!"
msgstr "¡Uno de ellos sacó un cuchillo!"

#: data/calls/story_04_briga.tres
msgid "Vem rápido, que tá juntando mais gente!"
msgstr "¡Vengan rápido, que se está juntando más gente!"

#: data/calls/story_04_briga.tres
msgid "Agora é pancadaria de verdade, são uns dez!"
msgstr "¡Ahora es una pelea de verdad, son como diez!"

#: data/calls/story_04_briga.tres
msgid "O rapaz ferido saiu de lá?"
msgstr "¿El muchacho herido salió de ahí?"

#: data/calls/story_04_briga.tres
msgid "Arrastaram ele pra calçada, tá meio tonto!"
msgstr "¡Lo arrastraron a la vereda, está medio mareado!"

#: data/calls/story_04_briga.tres
msgid "Esfaquearam um! Tá caído no meio da rua!"
msgstr "¡Apuñalaron a uno! ¡Está tirado en medio de la calle!"

#: data/calls/story_04_briga.tres
msgid "Onde ele foi atingido?"
msgstr "¿Dónde lo hirieron?"

#: data/calls/story_04_briga.tres
msgid "Na barriga! Tem sangue pra todo lado!"
msgstr "¡En la barriga! ¡Hay sangre por todos lados!"

#: data/calls/story_04_briga.tres
msgid "Fugiram todos... e deixaram dois no chão."
msgstr "Huyeron todos... y dejaron a dos en el suelo."

#: data/calls/story_04_briga.tres
msgid "Dois no chão, e um não se mexe!"
msgstr "¡Dos en el suelo, y uno no se mueve!"

#: data/calls/noite_04_dinamite.tres
msgid "Seu Valter"
msgstr "Seu Valter"

#: data/calls/noite_04_dinamite.tres
msgid "Boa noite. A Oficina do Tião, por favor."
msgstr "Buenas noches. La Oficina do Tião, por favor."

#: data/calls/noite_04_dinamite.tres
msgid "Ele ainda está lá, eu vi a luz acesa."
msgstr "Todavía está ahí, vi la luz encendida."

#: data/calls/noite_04_dinamite.tres
msgid "A oficina do Tião, moça. Três, um, oito."
msgstr "El taller de Tião, señorita. Tres, uno, ocho."

#: data/calls/noite_04_dinamite.tres data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Oficina do Tião"
msgstr "Oficina do Tião"

#: data/calls/noite_04_dinamite.tres
msgid "Valeu, moça."
msgstr "Gracias, señorita."

#: data/calls/noite_04_dinamite.tres
msgid "Tião? É o Valter. Leu o jornal? A dinamite da pedreira."
msgstr "¿Tião? Soy Valter. ¿Leíste el diario? La dinamita de la cantera."

#: data/calls/noite_04_dinamite.tres
msgid "Li. Doze caixas. Meu cunhado é vigia lá e está na delegacia desde cedo."
msgstr "Lo leí. Doce cajas. Mi cuñado es vigilante ahí y está en la comisaría desde temprano."

#: data/calls/noite_04_dinamite.tres
msgid "Ele viu alguma coisa?"
msgstr "¿Vio algo?"

#: data/calls/noite_04_dinamite.tres
msgid "Diz que não. Mas levaram ele assim mesmo."
msgstr "Dice que no. Pero se lo llevaron igual."

#: data/calls/noite_04_dinamite.tres
msgid "Depois das explosões de hoje, vão revirar tudo. Fecha cedo, Tião."
msgstr "Después de las explosiones de hoy, van a revolverlo todo. Cierra temprano, Tião."

#: data/calls/noite_04_dinamite.tres
msgid "Já estou fechando. Aqui só tem graxa e parafuso."
msgstr "Ya estoy cerrando. Aquí solo hay grasa y tornillos."

#: data/nights/night_04.tres
msgid "Caixas como as que sumiram do paiol."
msgstr "Cajas como las que faltan del polvorín."

#: data/nights/night_04.tres
msgid "Somem doze caixas de dinamite de pedreira\nO paiol da pedreira do Alto da Serra amanheceu arrombado e sem doze caixas de explosivos. O vigia diz que não viu nada e foi levado para depoimento. A polícia pede que a população denuncie movimentos estranhos."
msgstr "Desaparecen doce cajas de dinamita de una cantera\nEl polvorín de la cantera del Alto da Serra amaneció forzado y sin doce cajas de explosivos. El vigilante dice que no vio nada y fue llevado a declarar. La policía pide a la población que denuncie movimientos extraños."

#: data/nights/night_04.tres
msgid "Hotel, boa noite. Pois não?"
msgstr "Hotel, buenas noches. ¿Dígame?"

#: data/nights/night_04.tres
msgid "A semente brotou."
msgstr "La semilla brotó."

#: data/nights/night_04.tres
msgid "...Entendido. Boa noite, telefonista."
msgstr "...Entendido. Buenas noches, operadora."

#: data/nights/night_04.tres
msgid "Não foi nada. Boa noite."
msgstr "No pasa nada. Buenas noches."

#: data/nights/night_04.tres
msgid "Quero denunciar o Bar do Zé. Tem gente estranha usando a linha de lá."
msgstr "Quiero denunciar el Bar do Zé. Hay gente rara usando la línea de allí."

#: data/nights/night_04.tres
msgid "O Bar do Zé, da Vila Serena... A gente já estava de olho. Mais alguma coisa?"
msgstr "El Bar do Zé, de Vila Serena... Ya lo teníamos vigilado. ¿Algo más?"

#: data/nights/night_04.tres
msgid "Só isso."
msgstr "Solo eso."

#: data/nights/night_04.tres
msgid "Um homem que liga pedindo pelo meu nome."
msgstr "Un hombre que llama preguntando por mí por mi nombre."

#: data/nights/night_04.tres
msgid "Anotado. A senhora fez bem. Se ele ligar de novo, avise a gente."
msgstr "Anotado. Hizo bien, señorita. Si vuelve a llamar, avísenos."

#: data/nights/night_04.tres
msgid "Então não ocupe a linha. Boa noite."
msgstr "Entonces no ocupe la línea. Buenas noches."

#: data/nights/night_05.tres
msgid "O supervisor deixou um recado: \"A partir de hoje, o setor 1, o Centro, também é seu: a central de lá não tem mais turno da noite. Os números que começam com 1 agora passam pela sua mesa. A lista já foi atualizada. E, por ordem da polícia, a linha do Bar do Zé (327) está bloqueada: não transfira nada para lá.\""
msgstr "El supervisor dejó una nota: \"A partir de hoy, el sector 1, el Centro, también es suyo: la central de allí ya no tiene turno de noche. Los números que empiezan con 1 ahora pasan por su mesa. La guía ya está actualizada. Y, por orden de la policía, la línea del Bar do Zé (327) está bloqueada: no transfiera nada allí.\""

#: data/calls/story_05_cecilia.tres
msgid "Maria, é a Cecília."
msgstr "Maria, es Cecília."

#: data/calls/story_05_cecilia.tres
msgid "Aquele homem do bar... ele se chama Sebastião."
msgstr "Aquel hombre del bar... se llama Sebastião."

#: data/calls/story_05_cecilia.tres
msgid "Você conhece ele?"
msgstr "¿Lo conoces?"

#: data/calls/story_05_cecilia.tres
msgid "Por que ele sabe o meu nome?"
msgstr "¿Por qué sabe mi nombre?"

#: data/calls/story_05_cecilia.tres
msgid "Conheço. Ele conhece você desde pequena, Maria. Pode confiar nele."
msgstr "Sí. Te conoce desde pequeña, Maria. Puedes confiar en él."

#: data/calls/story_05_cecilia.tres
msgid "Mais do que isso eu não posso dizer pelo telefone."
msgstr "Más que eso no puedo decir por teléfono."

#: data/calls/story_05_cecilia.tres
msgid "Obrigada, Cecília."
msgstr "Gracias, Cecília."

#: data/calls/story_05_cecilia.tres
msgid "Isso está ficando perigoso."
msgstr "Esto se está volviendo peligroso."

#: data/calls/story_05_cecilia.tres
msgid "Está. Por isso mesmo."
msgstr "Sí. Precisamente por eso."

#: data/calls/story_05_cecilia.tres
msgid "Boa noite. Cuide-se."
msgstr "Buenas noches. Cuídate."

#: data/calls/story_05_sebastiao.tres data/calls/story_06_sebastiao_acordo.tres data/calls/story_08_sebastiao.tres
msgid "Sebastião Falcão"
msgstr "Sebastião Falcão"

#: data/calls/story_05_sebastiao.tres
msgid "Maria, é o Sebastião. A Cecília já te falou de mim."
msgstr "Maria, es Sebastião. Cecília ya te habló de mí."

#: data/calls/story_05_sebastiao.tres
msgid "Ontem a TV falou por nós. Aquilo foi você também."
msgstr "Ayer la TV habló por nosotros. Eso también fuiste tú."

#: data/calls/story_05_sebastiao.tres
msgid "Por que eu?"
msgstr "¿Por qué yo?"

#: data/calls/story_05_sebastiao.tres
msgid "Quem é você, afinal?"
msgstr "¿Quién eres, al fin y al cabo?"

#: data/calls/story_05_sebastiao.tres
msgid "Eu conheci o seu pai, Maria. Eu era menino e ia com o meu pai às reuniões. O seu pai sempre levava pão doce pra mim."
msgstr "Conocí a tu padre, Maria. Yo era niño e iba con mi padre a las reuniones. Tu padre siempre me traía pan dulce."

#: data/calls/story_05_sebastiao.tres
msgid "Levaram os dois na mesma noite. O seu e o meu. Nunca devolveram os corpos."
msgstr "Se llevaron a los dos la misma noche. El tuyo y el mío. Nunca devolvieron los cuerpos."

#: data/calls/story_05_sebastiao.tres
msgid "Eu tinha oito anos."
msgstr "Yo tenía ocho años."

#: data/calls/story_05_sebastiao.tres
msgid "Por que está me contando isso?"
msgstr "¿Por qué me cuentas esto?"

#: data/calls/story_05_sebastiao.tres
msgid "Porque você merece saber por quem está fazendo isso. Confie em mim, Maria."
msgstr "Porque mereces saber por quién lo estás haciendo. Confía en mí, Maria."

#: data/calls/story_05_sebastiao.tres
msgid "Eles tiraram os nossos pais de nós no escuro e chamaram isso de ordem. Eu vou fazer este país voltar a ser nosso, nem que seja a última coisa que eu faça."
msgstr "Nos quitaron a nuestros padres en la oscuridad y lo llamaron orden. Voy a hacer que este país vuelva a ser nuestro, aunque sea lo último que haga."

#: data/calls/story_05_sebastiao.tres
msgid "Agora preciso desligar. A gente se fala."
msgstr "Ahora tengo que colgar. Hablamos."

#: data/calls/story_05_otavio.tres
msgid "Boa noite, moça. É o Otávio, lembra? O da Generosa."
msgstr "Buenas noches, señorita. Es Otávio, ¿se acuerda? El de Generosa."

#: data/calls/story_05_otavio.tres
msgid "Liguei pra ela, conversamos até a ficha acabar. Agora eu quero levar ela no Cine Odeon. Mas e se ela achar que é cedo demais?"
msgstr "La llamé, hablamos hasta que se acabó la ficha. Ahora quiero llevarla al Cine Odeon. ¿Y si piensa que es muy pronto?"

#: data/calls/story_05_otavio.tres
msgid "Convida. Ela vai gostar."
msgstr "Invítela. Le va a gustar."

#: data/calls/story_05_otavio.tres
msgid "Vai com calma, Otávio."
msgstr "Con calma, Otávio."

#: data/calls/story_05_otavio.tres
msgid "É... Vou convidar pra sessão de sábado. Se ela disser não, eu ofereço outra música! Boa noite!"
msgstr "Sí... La invito a la función del sábado. ¡Si dice que no, le dedico otra canción! ¡Buenas noches!"

#: data/calls/story_05_otavio_radio.tres
msgid "Boa noite. A Rádio Serena de novo, por favor."
msgstr "Buenas noches. La Rádio Serena otra vez, por favor."

#: data/calls/story_05_otavio_radio.tres
msgid "A moça da fita amarela ainda não deu notícia. Vou tentar mais uma vez."
msgstr "La muchacha de la cinta amarilla todavía no dio señales. Voy a intentar una vez más."

#: data/calls/story_05_otavio_radio.tres
msgid "A Rádio Serena, moça."
msgstr "La Rádio Serena, señorita."

#: data/calls/story_05_otavio_radio.tres data/calls/story_12_generosa_radio.tres
msgid "Rádio Serena, boa noite."
msgstr "Rádio Serena, buenas noches."

#: data/calls/story_05_otavio_radio.tres
msgid "Sou eu de novo, o [person:Otávio]. Toca [other:Luar da Serra] mais uma vez? Pra moça de fita amarela."
msgstr "Soy yo otra vez, [person:Otávio]. ¿Pasa [other:Luar da Serra] una vez más? Para la muchacha de la cinta amarilla."

#: data/calls/story_05_otavio_radio.tres
msgid "Ela não deu notícia, rapaz?"
msgstr "¿No dio señales, muchacho?"

#: data/calls/story_05_otavio_radio.tres
msgid "Ainda não. Mas eu espero."
msgstr "Todavía no. Pero yo espero."

#: data/calls/story_05_otavio_radio.tres
msgid "Então vai de novo, depois do noticiário."
msgstr "Entonces sale de nuevo, después del noticiero."

#: data/calls/noite_05_jornal.tres
msgid "Seu Amaro"
msgstr "Seu Amaro"

#: data/calls/noite_05_jornal.tres
msgid "Boa noite. Me liga com a Gazeta, a redação."
msgstr "Buenas noches. Comuníqueme con la Gazeta, la redacción."

#: data/calls/noite_05_jornal.tres
msgid "Quero saber de uma coisa que saiu no jornal."
msgstr "Quiero preguntar por algo que salió en el diario."

#: data/calls/noite_05_jornal.tres
msgid "A Gazeta de São Sotero, moça."
msgstr "La Gazeta de São Sotero, señorita."

#: data/calls/noite_05_jornal.tres data/calls/noite_10_tiros.tres data/calls/transfer_45_reporter_gazeta.tres
msgid "Gazeta de São Sotero"
msgstr "Gazeta de São Sotero"

#: data/calls/noite_05_jornal.tres data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Obrigado, minha filha."
msgstr "Gracias, hija."

#: data/calls/noite_05_jornal.tres
msgid "Gazeta? Aqui é o Amaro, assinante há vinte anos."
msgstr "¿Gazeta? Habla Amaro, suscriptor hace veinte años."

#: data/calls/noite_05_jornal.tres
msgid "Pois não, seu Amaro. A redação já está fechando."
msgstr "Diga, don Amaro. La redacción ya está cerrando."

#: data/calls/noite_05_jornal.tres
msgid "Vocês escreveram \"dezenas de presos\" no protesto. Quantos, afinal?"
msgstr "Ustedes escribieron \"decenas de detenidos\" en la protesta. ¿Cuántos, al final?"

#: data/calls/noite_05_jornal.tres
msgid "A polícia não deu número. Nem nomes."
msgstr "La policía no dio el número. Ni los nombres."

#: data/calls/noite_05_jornal.tres
msgid "Meu vizinho não voltou pra casa. Ele só estava passando pela praça."
msgstr "Mi vecino no volvió a casa. Solo estaba pasando por la plaza."

#: data/calls/noite_05_jornal.tres
msgid "Sinto muito, seu Amaro. A gente só publica o que a delegacia libera."
msgstr "Lo siento, don Amaro. Solo publicamos lo que la comisaría autoriza."

#: data/calls/noite_05_parente.tres
msgid "Dona Rosa"
msgstr "Dona Rosa"

#: data/calls/noite_05_parente.tres
msgid "Boa noite. A delegacia do Centro, por favor."
msgstr "Buenas noches. La comisaría del Centro, por favor."

#: data/calls/noite_05_parente.tres
msgid "É sobre o meu filho. Ele foi preso no protesto."
msgstr "Es por mi hijo. Lo detuvieron en la protesta."

#: data/calls/noite_05_parente.tres
msgid "A delegacia, moça. Pelo amor de Deus."
msgstr "La comisaría, señorita. Por el amor de Dios."

#: data/calls/noite_05_parente.tres data/calls/noite_07_parente.tres data/calls/noite_07_raimundo_caiu.tres
msgid "Delegacia de Polícia"
msgstr "Comisaría de Policía"

#: data/calls/noite_05_parente.tres
msgid "Obrigada. Reza por ele, moça."
msgstr "Gracias. Rece por él, señorita."

#: data/calls/noite_05_parente.tres
msgid "Boa noite. Meu filho, Luís Medeiros, foi preso ontem na praça."
msgstr "Buenas noches. A mi hijo, Luís Medeiros, lo detuvieron ayer en la plaza."

#: data/calls/noite_05_parente.tres
msgid "Medeiros... Não consta nada aqui, senhora."
msgstr "Medeiros... Aquí no consta nada, señora."

#: data/calls/noite_05_parente.tres
msgid "Os vizinhos viram ele entrar no camburão. Dezoito anos, de camisa azul."
msgstr "Los vecinos lo vieron subir al furgón. Dieciocho años, camisa azul."

#: data/calls/noite_05_parente.tres
msgid "Senhora, se não consta, não está aqui."
msgstr "Señora, si no consta, no está aquí."

#: data/calls/noite_05_parente.tres
msgid "Então onde ele está?"
msgstr "¿Entonces dónde está?"

#: data/calls/noite_05_parente.tres
msgid "Procure amanhã de dia. De noite não damos informação."
msgstr "Vuelva mañana de día. De noche no damos información."

#: data/nights/night_05.tres
msgid "Viatura no Centro, na manhã de ontem."
msgstr "Un patrullero en el Centro, ayer por la mañana."

#: data/nights/night_05.tres
msgid "Explosões em quatro pontos da cidade\nBombas caseiras atingiram uma subestação, dois postes de energia e a porta da delegacia do Centro na tarde de ontem. Não houve mortos. A polícia fala em atentado e promete resposta."
msgstr "Explosiones en cuatro puntos de la ciudad\nBombas caseras alcanzaron una subestación, dos postes de luz y la puerta de la comisaría del Centro ayer por la tarde. No hubo muertos. La policía habla de atentado y promete una respuesta."

#: data/nights/night_05.tres
msgid "Protesto termina com dezenas de presos\nA manifestação na praça foi dispersada pela polícia ao anoitecer. A Alta Cúpula pede calma à população e diz que os responsáveis serão encontrados."
msgstr "La protesta termina con decenas de detenidos\nLa manifestación en la plaza fue dispersada por la policía al anochecer. La Alta Cúpula pide calma a la población y dice que los responsables serán encontrados."

#: data/nights/night_05.tres
msgid "Rebeldes ocupam a TV Orbital\nPor quase duas horas, na noite de ontem, a TV Orbital transmitiu a mensagem de um grupo que se diz a resistência de São Sotero. A polícia retomou a emissora de madrugada. Ninguém foi preso."
msgstr "Rebeldes ocupan la TV Orbital\nDurante casi dos horas, anoche, la TV Orbital transmitió el mensaje de un grupo que se dice la resistencia de São Sotero. La policía retomó la emisora de madrugada. Nadie fue detenido."

#: data/nights/night_05.tres
msgid "A torre da TV Orbital, ocupada ontem à noite."
msgstr "La torre de TV Orbital, ocupada anoche."

#: data/nights/night_06.tres
msgid "O supervisor deixou um recado: \"Hoje o Centro tem baile e a praça cheia. Fique atenta. A linha do Bar do Zé continua bloqueada.\""
msgstr "El supervisor dejó una nota: \"Hoy el Centro tiene baile y la plaza llena. Esté atenta. La línea del Bar do Zé sigue bloqueada.\""

#: data/calls/story_06_sebastiao_acordo.tres
msgid "Maria, é o Sebastião. Escuta com atenção, que eu não posso repetir muito."
msgstr "Maria, es Sebastião. Escucha con atención, que no puedo repetir mucho."

#: data/calls/story_06_sebastiao_acordo.tres
msgid "O bar está bloqueado. Quem pedir o Bar do Zé e estalar os dedos três vezes, você passa pro Hotel Serena. Combinado?"
msgstr "El bar está bloqueado. Quien pida el Bar do Zé y chasquee los dedos tres veces, lo pasas al Hotel Serena. ¿Trato?"

#: data/calls/story_06_sebastiao_acordo.tres
msgid "Bar do Zé com os três estalos: o Hotel Serena."
msgstr "Bar do Zé con los tres chasquidos: el Hotel Serena."

#: data/calls/story_06_sebastiao_acordo.tres
msgid "Acordo"
msgstr "Acuerdo"

#: data/calls/story_06_sebastiao_acordo.tres
msgid "Obrigado, Maria. Você não sabe o quanto isso ajuda. E se as autoridades pedirem qualquer coisa estranha com o bar ou o hotel, ligue pra lá e avise."
msgstr "Gracias, Maria. No sabes cuánto ayuda esto. Y si las autoridades piden cualquier cosa extraña con el bar o el hotel, llámalos y avísales."

#: data/calls/story_06_sebastiao_acordo.tres
msgid "Tudo bem. Eu entendo o medo. Boa noite."
msgstr "Está bien. Entiendo el miedo. Buenas noches."

#: data/calls/story_06_bar_sinal_1.tres data/calls/story_07_bar_radio.tres data/calls/story_07_bar_radio_avisado.tres
msgid "O Bar do Zé, por favor."
msgstr "El Bar do Zé, por favor."

#: data/calls/story_06_bar_sinal_1.tres data/calls/story_14_bar.tres data/calls/story_15_bar.tres
msgid "Valeu."
msgstr "Gracias."

#: data/calls/story_06_bar_sinal_1.tres
msgid "Hotel? Aqui é o Davi. A moça passou."
msgstr "¿Hotel? Habla Davi. La chica pasó la llamada."

#: data/calls/story_06_bar_sinal_1.tres
msgid "Ótimo. Avisa o pessoal: a reunião mudou pra cá."
msgstr "Perfecto. Avisa a los demás: la reunión se mudó aquí."

#: data/calls/story_06_bar_sinal_1.tres
msgid "Quando?"
msgstr "¿Cuándo?"

#: data/calls/story_06_bar_sinal_1.tres
msgid "Amanhã. Mesmo horário."
msgstr "Mañana. A la misma hora."

#: data/calls/story_06_bar_sinal_1.tres data/calls/story_07_bar_radio.tres data/calls/story_07_bar_radio_avisado.tres
msgid "Davi Correia."
msgstr "Davi Correia."

#: data/calls/story_06_bar_sinal_1.tres
msgid "Bloqueado, é? Tá certo."
msgstr "Bloqueado, ¿eh? Está bien."

#: data/calls/story_06_bar_sinal_2.tres data/calls/story_07_bar_armas.tres data/calls/story_07_bar_armas_avisado.tres
msgid "O Bar do Zé, por gentileza."
msgstr "El Bar do Zé, por favor."

#: data/calls/story_06_bar_sinal_2.tres
msgid "O bar, minha filha. O do Zé."
msgstr "El bar, hija. El de Zé."

#: data/calls/story_06_bar_sinal_2.tres
msgid "Boa noite, seu Zé. É o Anselmo."
msgstr "Buenas noches, don Zé. Es Anselmo."

#: data/calls/story_06_bar_sinal_2.tres
msgid "Pode falar, seu Anselmo. A linha daqui está limpa."
msgstr "Hable, don Anselmo. La línea de aquí está limpia."

#: data/calls/story_06_bar_sinal_2.tres
msgid "A encomenda chega amanhã. Onde eu deixo?"
msgstr "El encargo llega mañana. ¿Dónde lo dejo?"

#: data/calls/story_06_bar_sinal_2.tres
msgid "Aqui não. Depois a gente combina."
msgstr "Aquí no. Después lo arreglamos."

#: data/calls/story_06_bar_sinal_2.tres data/calls/story_07_bar_armas.tres data/calls/story_07_bar_armas_avisado.tres
msgid "Anselmo Duarte."
msgstr "Anselmo Duarte."

#: data/calls/story_06_bar_sinal_2.tres
msgid "Bloqueado... Então tá. Boa noite."
msgstr "Bloqueado... Bueno. Buenas noches."

#: data/calls/story_06_miguel.tres
msgid "Alô? É a moça da central? A do outro dia?"
msgstr "¿Aló? ¿Es la señorita de la central? ¿La del otro día?"

#: data/calls/story_06_miguel.tres
msgid "A Rainha da Inglaterra?"
msgstr "¿La Reina de Inglaterra?"

#: data/calls/story_06_miguel.tres
msgid "Sou eu. Quem fala?"
msgstr "Soy yo. ¿Quién habla?"

#: data/calls/story_06_miguel.tres
msgid "Aqui é a central. O que deseja?"
msgstr "Aquí la central. ¿Qué desea?"

#: data/calls/story_06_miguel.tres
msgid "É o Miguel! Fui eu que liguei aquele dia. O Zé Pequeno Bolinho de Chuva era mentira."
msgstr "¡Es Miguel! Fui yo el que llamó aquel día. Lo de Pepito Buñuelo de Lluvia era mentira."

#: data/calls/story_06_miguel.tres
msgid "Eu desconfiei. E o sobrenome de verdade?"
msgstr "Lo sospeché. ¿Y el apellido de verdad?"

#: data/calls/story_06_miguel.tres
msgid "Prazer, Miguel."
msgstr "Mucho gusto, Miguel."

#: data/calls/story_06_miguel.tres
msgid "Sobrenome não posso falar. A mãe não deixa dar sobrenome pra estranho."
msgstr "El apellido no puedo decirlo. Mamá no me deja dárselo a extraños."

#: data/calls/story_06_miguel.tres
msgid "Eu gosto de ligar aqui. A senhora fala com a cidade inteira?"
msgstr "Me gusta llamar aquí. ¿Usted habla con la ciudad entera?"

#: data/calls/story_06_miguel.tres
msgid "Quase inteira."
msgstr "Casi entera."

#: data/calls/story_06_miguel.tres
msgid "Com quem liga."
msgstr "Con el que llama."

#: data/calls/story_06_miguel.tres
msgid "Que nem a rádio! E qual é o seu nome?"
msgstr "¡Como la radio! ¿Y cómo se llama usted?"

#: data/calls/story_06_miguel.tres
msgid "Maria."
msgstr "Maria."

#: data/calls/story_06_miguel.tres
msgid "É segredo, que nem o seu sobrenome."
msgstr "Es secreto, como tu apellido."

#: data/calls/story_06_miguel.tres
msgid "Maria. Gostei. Boa noite, Maria!"
msgstr "Maria. Me gusta. ¡Buenas noches, Maria!"

#: data/calls/story_06_miguel.tres
msgid "Hahaha! Empatou. Boa noite!"
msgstr "¡Jajaja! Empatamos. ¡Buenas noches!"

#: data/calls/story_06_miguel.tres
msgid "É o Miguel. Eu só queria conversar um pouquinho..."
msgstr "Es Miguel. Solo quería conversar un ratito..."

#: data/calls/story_06_miguel.tres
msgid "Aqui é linha de trabalho, Miguel."
msgstr "Esta es una línea de trabajo, Miguel."

#: data/calls/story_06_miguel.tres
msgid "Fala rápido, então."
msgstr "Habla rápido, entonces."

#: data/calls/story_06_miguel.tres
msgid "Tá. Desculpa. Tchau."
msgstr "Bueno. Perdón. Chau."

#: data/calls/story_06_generosa.tres
msgid "Boa noite! É a Generosa Prates. Lembra de mim? A da fita amarela."
msgstr "¡Buenas noches! Es Generosa Prates. ¿Se acuerda de mí? La de la cinta amarilla."

#: data/calls/story_06_generosa.tres
msgid "Eu precisava contar pra alguém: fomos ao cinema! Ele não prestou atenção no filme nem um minuto."
msgstr "Tenía que contárselo a alguien: ¡fuimos al cine! No prestó atención a la película ni un minuto."

#: data/calls/story_06_generosa.tres
msgid "E você?"
msgstr "¿Y usted?"

#: data/calls/story_06_generosa.tres
msgid "Que bom, Generosa!"
msgstr "¡Qué bien, Generosa!"

#: data/calls/story_06_generosa.tres
msgid "Nem eu. Obrigada por ter passado o recado. Boa noite!"
msgstr "Yo tampoco. Gracias por pasar el recado. ¡Buenas noches!"

#: data/calls/story_06_generosa.tres
msgid "Boa noite. É a Generosa Prates. Desculpe ligar de novo."
msgstr "Buenas noches. Es Generosa Prates. Perdone que llame otra vez."

#: data/calls/story_06_generosa.tres
msgid "O rapaz da música nunca deixou recado, né? Ouvi ele oferecer de novo na rádio... e nada."
msgstr "El muchacho de la canción nunca dejó recado, ¿no? Lo oí dedicarla otra vez en la radio... y nada."

#: data/calls/story_06_generosa.tres
msgid "Vai ver mudou de ideia."
msgstr "A lo mejor cambió de idea."

#: data/calls/story_06_generosa.tres
msgid "Ninguém ligou, não."
msgstr "Nadie llamó, no."

#: data/calls/story_06_generosa.tres data/calls/story_14_miguel.tres data/calls/story_15_cupula_presa.tres
msgid "[Ficar em silêncio]"
msgstr "[Quedarse en silencio]"

#: data/calls/story_06_generosa.tres
msgid "Tá bom. Boa noite."
msgstr "Está bien. Buenas noches."

#: data/calls/noite_06_telefone.tres
msgid "Seu Celso"
msgstr "Seu Celso"

#: data/calls/noite_06_telefone.tres data/calls/noite_12_recompensa.tres
msgid "Boa noite. O Bilhar do Tonho, por favor."
msgstr "Buenas noches. El Bilhar do Tonho, por favor."

#: data/calls/noite_06_telefone.tres
msgid "Só quero ver se o telefone de lá ainda funciona."
msgstr "Solo quiero ver si el teléfono de ahí todavía funciona."

#: data/calls/noite_06_telefone.tres
msgid "O bilhar, moça. Do Tonho."
msgstr "El billar, señorita. El de Tonho."

#: data/calls/noite_06_telefone.tres data/calls/noite_12_recompensa.tres data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Bilhar do Tonho"
msgstr "Bilhar do Tonho"

#: data/calls/noite_06_telefone.tres
msgid "Funcionou! Obrigado, moça."
msgstr "¡Funcionó! Gracias, señorita."

#: data/calls/noite_06_telefone.tres
msgid "Tonho? É o Celso. Ainda tem telefone aí, então."
msgstr "¿Tonho? Soy Celso. Así que todavía tienes teléfono."

#: data/calls/noite_06_telefone.tres
msgid "Por enquanto. Cortaram o do Zé e de mais três salões."
msgstr "Por ahora. Cortaron el de Zé y el de otros tres salones."

#: data/calls/noite_06_telefone.tres
msgid "O jornal diz que são \"pontos de agitação\"."
msgstr "El diario dice que son \"focos de agitación\"."

#: data/calls/noite_06_telefone.tres
msgid "Agitação aqui é só quando alguém encaçapa a bola sete."
msgstr "Aquí la única agitación es cuando alguien mete la bola siete."

#: data/calls/noite_06_telefone.tres
msgid "Cuidado com o que fala nessa linha, Tonho."
msgstr "Cuidado con lo que dices en esta línea, Tonho."

#: data/calls/noite_06_telefone.tres
msgid "Estou sabendo. Vem amanhã, que a mesa nova chegou."
msgstr "Ya sé. Ven mañana, que llegó la mesa nueva."

#: data/calls/noite_06_parente.tres
msgid "Dona Neusa"
msgstr "Dona Neusa"

#: data/calls/noite_06_parente.tres data/calls/noite_11_parente.tres
msgid "Boa noite, moça. A Casa Paroquial, por caridade."
msgstr "Buenas noches, señorita. La Casa Paroquial, por caridad."

#: data/calls/noite_06_parente.tres
msgid "Preciso falar com o padre."
msgstr "Necesito hablar con el cura."

#: data/calls/noite_06_parente.tres
msgid "A casa do padre, minha filha. Um, dois, zero."
msgstr "La casa del cura, hija. Uno, dos, cero."

#: data/calls/noite_06_parente.tres data/calls/noite_07_raimundo_padre.tres data/calls/noite_11_parente.tres
msgid "Casa Paroquial"
msgstr "Casa Paroquial"

#: data/calls/noite_06_parente.tres
msgid "Deus te abençoe, moça."
msgstr "Dios la bendiga, señorita."

#: data/calls/noite_06_parente.tres
msgid "Padre? É a Neusa, mulher do Ernesto, da sapataria."
msgstr "¿Padre? Soy Neusa, la mujer de Ernesto, el de la zapatería."

#: data/calls/noite_06_parente.tres
msgid "Neusa, minha filha. Alguma notícia dele?"
msgstr "Neusa, hija. ¿Alguna noticia de él?"

#: data/calls/noite_06_parente.tres
msgid "Nenhuma. Desde o protesto. Na delegacia dizem que não está lá."
msgstr "Ninguna. Desde la protesta. En la comisaría dicen que no está ahí."

#: data/calls/noite_06_parente.tres
msgid "Eu vou lá amanhã depois da missa. Comigo eles falam."
msgstr "Iré mañana después de misa. Conmigo hablan."

#: data/calls/noite_06_parente.tres
msgid "O senhor faria isso, padre?"
msgstr "¿Usted haría eso, padre?"

#: data/calls/noite_06_parente.tres
msgid "Faço. Traga uma foto dele e uma muda de roupa."
msgstr "Lo haré. Traiga una foto de él y una muda de ropa."

#: data/calls/noite_06_febre.tres
msgid "Boa noite, moça. A Farmácia Central, por favor."
msgstr "Buenas noches, señorita. La Farmácia Central, por favor."

#: data/calls/noite_06_febre.tres
msgid "O meu menino está com febre alta. Não sei se ainda estão abertos."
msgstr "Mi niño tiene fiebre alta. No sé si todavía están abiertos."

#: data/calls/noite_06_febre.tres
msgid "A Farmácia Central."
msgstr "La Farmácia Central."

#: data/calls/noite_06_febre.tres data/calls/noite_08_jornal.tres data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Farmácia Central"
msgstr "Farmácia Central"

#: data/calls/noite_06_febre.tres data/calls/noite_06_febre_fechada.tres data/calls/noite_07_parente.tres
msgid "Obrigado, moça."
msgstr "Gracias, joven."

#: data/calls/noite_06_febre.tres
msgid "Boa noite. A farmácia ainda está aberta? O meu filho está com febre alta."
msgstr "Buenas noches. ¿La farmacia sigue abierta? Mi hijo tiene fiebre alta."

#: data/calls/noite_06_febre.tres
msgid "Fechando, mas atendo. Quantos anos ele tem?"
msgstr "Estoy cerrando, pero lo atiendo. ¿Cuántos años tiene?"

#: data/calls/noite_06_febre.tres
msgid "Seis. Está quente que nem brasa."
msgstr "Seis. Está que arde."

#: data/calls/noite_06_febre.tres
msgid "Dê um banho morno e venha buscar o xarope. Deixo a porta encostada."
msgstr "Dele un baño tibio y venga a buscar el jarabe. Dejo la puerta entornada."

#: data/calls/noite_06_febre.tres
msgid "Deus lhe pague. Vou correndo."
msgstr "Dios se lo pague. Voy corriendo."

#: data/calls/noite_06_febre.tres
msgid "Venha pela rua de trás. Tem polícia na praça."
msgstr "Venga por la calle de atrás. Hay policía en la plaza."

#: data/calls/noite_06_febre_baixou.tres
msgid "Sou eu de novo, moça. O pai do menino da febre."
msgstr "Soy yo otra vez, señorita. El padre del niño con fiebre."

#: data/calls/noite_06_febre_baixou.tres
msgid "A febre baixou, graças a Deus! Me liga com o meu pai, o Paulo Nogueira? Ele está aflito."
msgstr "¡Le bajó la fiebre, gracias a Dios! ¿Me comunica con mi padre, Paulo Nogueira? Está muy preocupado."

#: data/calls/noite_06_febre_baixou.tres
msgid "O Paulo Nogueira, o meu pai."
msgstr "Paulo Nogueira, mi padre."

#: data/calls/noite_06_febre_baixou.tres data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira"
msgstr "Paulo Nogueira"

#: data/calls/noite_06_febre_baixou.tres
msgid "Obrigado pela ajuda de mais cedo, moça."
msgstr "Gracias por la ayuda de antes, señorita."

#: data/calls/noite_06_febre_baixou.tres
msgid "Pai, sou eu. O Toninho já está sem febre."
msgstr "Papá, soy yo. A Toninho ya se le fue la fiebre."

#: data/calls/noite_06_febre_baixou.tres
msgid "Graças a Deus, meu filho. A sua mãe não parou de rezar."
msgstr "Gracias a Dios, hijo. Tu madre no paró de rezar."

#: data/calls/noite_06_febre_baixou.tres
msgid "O farmacêutico abriu só pra mim. Fui pela rua de trás."
msgstr "El farmacéutico abrió solo para mí. Fui por la calle de atrás."

#: data/calls/noite_06_febre_baixou.tres
msgid "Fez bem. Na praça estão parando todo mundo."
msgstr "Hiciste bien. En la plaza están parando a todo el mundo."

#: data/calls/noite_06_febre_baixou.tres
msgid "Amanhã a gente leva ele aí pra mãe ver."
msgstr "Mañana se lo llevamos para que mamá lo vea."

#: data/calls/noite_06_febre_baixou.tres
msgid "Venham cedo. Antes da polícia acordar."
msgstr "Vengan temprano. Antes de que la policía se despierte."

#: data/calls/noite_06_febre_fechada.tres
msgid "Moça, sou eu de novo. O pai do menino da febre."
msgstr "Señorita, soy yo otra vez. El padre del niño con fiebre."

#: data/calls/noite_06_febre_fechada.tres
msgid "A ligação caiu e eu fui a pé até a Farmácia Central. Estava fechada!"
msgstr "La llamada se cortó y fui a pie hasta la Farmácia Central. ¡Estaba cerrada!"

#: data/calls/noite_06_febre_fechada.tres
msgid "Me liga com a Farmácia Santa Rita, por favor. A febre não baixa."
msgstr "Comuníqueme con la Farmácia Santa Rita, por favor. La fiebre no baja."

#: data/calls/noite_06_febre_fechada.tres
msgid "A Farmácia Santa Rita."
msgstr "La Farmácia Santa Rita."

#: data/calls/noite_06_febre_fechada.tres data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Farmácia Santa Rita"
msgstr "Farmácia Santa Rita"

#: data/calls/noite_06_febre_fechada.tres
msgid "Boa noite. Vocês ainda atendem? O meu filho está com febre alta desde a tarde."
msgstr "Buenas noches. ¿Todavía atienden? Mi hijo tiene fiebre alta desde la tarde."

#: data/calls/noite_06_febre_fechada.tres
msgid "Já fechamos, senhor. Só amanhã."
msgstr "Ya cerramos, señor. Mañana."

#: data/calls/noite_06_febre_fechada.tres
msgid "Pelo amor de Deus, ele tem seis anos!"
msgstr "¡Por el amor de Dios, tiene seis años!"

#: data/calls/noite_06_febre_fechada.tres
msgid "...Bata na porta dos fundos. Mas venha sozinho."
msgstr "...Golpee en la puerta de atrás. Pero venga solo."

#: data/calls/noite_06_febre_fechada.tres
msgid "Obrigado. Obrigado mesmo."
msgstr "Gracias. De verdad, gracias."

#: data/calls/noite_06_febre_fechada.tres
msgid "E não passe pela praça."
msgstr "Y no pase por la plaza."

#: data/nights/night_06.tres
msgid "A rua do Bar do Zé, sem telefone desde ontem."
msgstr "La calle del Bar do Zé, sin teléfono desde ayer."

#: data/nights/night_06.tres
msgid "Polícia corta telefones de \"pontos de agitação\"\nPor ordem da delegacia, as linhas de bares e salões do Centro e de Vila Serena foram bloqueadas na central, a do Bar do Zé entre elas. \"Quem não deve não teme\", disse o delegado."
msgstr "La policía corta los teléfonos de \"focos de agitación\"\nPor orden de la comisaría, las líneas de bares y salones del Centro y de Vila Serena quedaron bloqueadas en la central, la del Bar do Zé entre ellas. \"El que nada debe nada teme\", dijo el comisario."

#: data/nights/night_06.tres
msgid "Dono do Bar do Zé levado para depoimento\nDepois de uma denúncia feita por telefone, o dono do Bar do Zé, em Vila Serena, passou a tarde de ontem na delegacia. Foi solto à noite, sem acusação. O bar continua aberto; o telefone dele, não."
msgstr "El dueño del Bar do Zé, llevado a declarar\nTras una denuncia hecha por teléfono, el dueño del Bar do Zé, en Vila Serena, pasó la tarde de ayer en la comisaría. Lo soltaron por la noche, sin cargos. El bar sigue abierto; su teléfono, no."

#: data/nights/night_06.tres
msgid "A viatura na porta do Bar do Zé."
msgstr "El patrullero en la puerta del Bar do Zé."

#: data/nights/night_07.tres
msgid "O supervisor deixou um recado: \"Instalaram um gravador na sua mesa, a pedido das autoridades. A linha do bar foi liberada, e elas querem gravado tudo o que for para lá. Em noite com ligação para o bar, entregue às autoridades pelo menos uma fita, mesmo que a conversa não tenha nada: grave assim mesmo, para não ter reclamação. E daqui em diante, o que as autoridades pedirem, atenda, mesmo contra as regras: não vai haver advertência.\""
msgstr "El supervisor dejó un recado: \"Instalaron una grabadora en su mesa, a pedido de las autoridades. La línea del bar fue liberada, y quieren grabado todo lo que vaya para allá. En una noche con llamadas al bar, entregue a las autoridades al menos una cinta, aunque la conversación no tenga nada: grábela igual, para que no haya reclamos. Y de ahora en adelante, lo que pidan las autoridades, hágalo, aunque vaya contra las reglas: no habrá amonestación.\""

#: data/calls/story_07_bar_radio.tres
msgid "Zé, é o Davi. Recado do chefe."
msgstr "Zé, es Davi. Recado del jefe."

#: data/calls/story_07_bar_radio.tres
msgid "A [place:Rádio Serena] é nossa daqui a dois dias, na noite de [time:terça]."
msgstr "La [place:Rádio Serena] es nuestra en dos días, la noche del [time:martes]."

#: data/calls/story_07_bar_radio.tres
msgid "Quem entra?"
msgstr "¿Quién entra?"

#: data/calls/story_07_bar_radio.tres
msgid "O [person:Lauro], que trabalha lá dentro. Ele abre a porta do transmissor às [time:dez]."
msgstr "[person:Lauro], que trabaja adentro. Abre la puerta del transmisor a las [time:diez]."

#: data/calls/story_07_bar_radio.tres
msgid "Certo. Agora desliga, essa linha não é segura."
msgstr "Bien. Ahora cuelga, esta línea no es segura."

#: data/calls/story_07_bar_radio_avisado.tres
msgid "Zé, é o Davi. Recado do..."
msgstr "Zé, es Davi. Recado del..."

#: data/calls/story_07_bar_radio_avisado.tres
msgid "Davi! Que bom que ligou. E o jogo de hoje, vai?"
msgstr "¡Davi! Qué bueno que llamas. ¿Y el partido de hoy, vienes?"

#: data/calls/story_07_bar_radio_avisado.tres
msgid "Jogo? Ah... vou, vou sim."
msgstr "¿Partido? Ah... sí, sí voy."

#: data/calls/story_07_bar_radio_avisado.tres
msgid "Então leva a camisa. Até mais tarde."
msgstr "Entonces trae la camiseta. Hasta más tarde."

#: data/calls/story_07_bar_armas.tres
msgid "Zé? Anselmo. A encomenda chegou, está comigo. Onde eu deixo?"
msgstr "¿Zé? Anselmo. Llegó el encargo, lo tengo yo. ¿Dónde lo dejo?"

#: data/calls/story_07_bar_armas.tres
msgid "Leva pro [place:Armazém Ferreira], no fundo, embaixo dos sacos de [other:café]. Quantas caixas?"
msgstr "Llévalo al [place:Armazém Ferreira], al fondo, debajo de los sacos de [other:café]. ¿Cuántas cajas?"

#: data/calls/story_07_bar_armas.tres
msgid "[number:Doze]. Do jeito que o senhor pediu."
msgstr "[number:Doce]. Como usted pidió."

#: data/calls/story_07_bar_armas.tres
msgid "Quem busca é o pessoal do caminhão, de madrugada."
msgstr "Las recoge la gente del camión, de madrugada."

#: data/calls/story_07_bar_armas.tres
msgid "Então até lá."
msgstr "Hasta entonces."

#: data/calls/story_07_bar_armas_avisado.tres
msgid "Zé? Anselmo. A encomenda..."
msgstr "¿Zé? Anselmo. El encargo..."

#: data/calls/story_07_bar_armas_avisado.tres
msgid "Anselmo! O seu fiado está alto, hein. Quando é que paga?"
msgstr "¡Anselmo! Tu cuenta está alta, ¿eh? ¿Cuándo pagas?"

#: data/calls/story_07_bar_armas_avisado.tres
msgid "Sexta... sexta eu passo aí."
msgstr "El viernes... el viernes paso por ahí."

#: data/calls/story_07_bar_armas_avisado.tres
msgid "Sexta, hein. Boa noite."
msgstr "El viernes, ¿eh? Buenas noches."

#: data/calls/story_07_bar_grupo_c.tres
msgid "Zé, é a Teresa. O grupo C quer saber onde é."
msgstr "Zé, es Teresa. El grupo C quiere saber dónde es."

#: data/calls/story_07_bar_grupo_c.tres
msgid "Na [street:Rua das Acácias], número [number:quarenta], no porão."
msgstr "En la [street:Rua das Acácias], número [number:cuarenta], en el sótano."

#: data/calls/story_07_bar_grupo_c.tres
msgid "A que horas?"
msgstr "¿A qué hora?"

#: data/calls/story_07_bar_grupo_c.tres
msgid "Esta noite, às [time:três] da madrugada. Ninguém chega junto."
msgstr "Esta noche, a las [time:tres] de la madrugada. Nadie llega junto."

#: data/calls/story_07_bar_grupo_c.tres
msgid "Combinado."
msgstr "De acuerdo."

#: data/calls/story_07_bar_grupo_c.tres data/calls/story_07_bar_grupo_c_avisado.tres
msgid "Teresa Lima."
msgstr "Teresa Lima."

#: data/calls/story_07_bar_grupo_c_avisado.tres
msgid "Zé, é a Teresa. O grupo..."
msgstr "Zé, es Teresa. El grupo..."

#: data/calls/story_07_bar_grupo_c_avisado.tres
msgid "Teresa! A sua mãe esteve aqui hoje, perguntando de você."
msgstr "¡Teresa! Tu madre estuvo aquí hoy, preguntando por ti."

#: data/calls/story_07_bar_grupo_c_avisado.tres
msgid "Ah, é? Diz que eu passo lá."
msgstr "Ah, ¿sí? Dile que paso por allá."

#: data/calls/story_07_bar_grupo_c_avisado.tres
msgid "Digo. Boa noite."
msgstr "Se lo digo. Buenas noches."

#: data/calls/story_07_miguel.tres
msgid "Alô, central? É o Miguel."
msgstr "¿Aló, central? Es Miguel."

#: data/calls/story_07_miguel.tres
msgid "Oi, Maria!"
msgstr "¡Hola, Maria!"

#: data/calls/story_07_miguel.tres
msgid "Oi, Miguel. Como foi o dia?"
msgstr "Hola, Miguel. ¿Cómo te fue hoy?"

#: data/calls/story_07_miguel.tres
msgid "Miguel, agora estou ocupada."
msgstr "Miguel, ahora estoy ocupada."

#: data/calls/story_07_miguel.tres
msgid "A professora leu a minha redação na frente da turma! Era sobre o meu irmão."
msgstr "¡La maestra leyó mi redacción delante de la clase! Era sobre mi hermano."

#: data/calls/story_07_miguel.tres
msgid "Que orgulho! O que você escreveu?"
msgstr "¡Qué orgullo! ¿Qué escribiste?"

#: data/calls/story_07_miguel.tres
msgid "Sobre o seu irmão?"
msgstr "¿Sobre tu hermano?"

#: data/calls/story_07_miguel.tres
msgid "Que ele é o mais forte da rua. Ele já tem dezoito anos."
msgstr "Que es el más fuerte de la calle. Ya tiene dieciocho años."

#: data/calls/story_07_miguel.tres
msgid "Mas ele anda estranho. Chega tarde, não joga mais bola comigo, fica cochichando com uns amigos no portão."
msgstr "Pero anda raro. Llega tarde, ya no juega a la pelota conmigo, se queda cuchicheando con unos amigos en el portón."

#: data/calls/story_07_miguel.tres
msgid "Coisa de gente grande."
msgstr "Cosas de grandes."

#: data/calls/story_07_miguel.tres
msgid "Ele deve estar cansado."
msgstr "Debe estar cansado."

#: data/calls/story_07_miguel.tres
msgid "Hum. Deve ser. Boa noite!"
msgstr "Mmm. Debe ser. ¡Buenas noches!"

#: data/calls/story_07_miguel.tres
msgid "Tá bom. Tchau."
msgstr "Bueno. Chau."

#: data/calls/noite_07_baile.tres
msgid "Dona Dalva"
msgstr "Dona Dalva"

#: data/calls/noite_07_baile.tres
msgid "Boa noite. Me liga com a Lúcia Pereira?"
msgstr "Buenas noches. ¿Me comunica con Lúcia Pereira?"

#: data/calls/noite_07_baile.tres
msgid "Ela é minha amiga, mora no Centro."
msgstr "Es mi amiga, vive en el Centro."

#: data/calls/noite_07_baile.tres
msgid "Lúcia Pereira. Um, quatro, sete."
msgstr "Lúcia Pereira. Uno, cuatro, siete."

#: data/calls/noite_07_baile.tres data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Lúcia Pereira"
msgstr "Lúcia Pereira"

#: data/calls/noite_07_baile.tres
msgid "Obrigada, moça!"
msgstr "¡Gracias, señorita!"

#: data/calls/noite_07_baile.tres
msgid "Lúcia? É a Dalva. Você chegou bem em casa ontem?"
msgstr "¿Lúcia? Soy Dalva. ¿Llegaste bien a casa anoche?"

#: data/calls/noite_07_baile.tres
msgid "Cheguei. Saí antes da revista, por sorte. E você?"
msgstr "Sí. Salí antes de la requisa, por suerte. ¿Y tú?"

#: data/calls/noite_07_baile.tres
msgid "Me revistaram a bolsa inteira. Até o batom abriram."
msgstr "Me revisaron todo el bolso. Hasta el pintalabios abrieron."

#: data/calls/noite_07_baile.tres
msgid "E o Zeca? Vi levarem ele."
msgstr "¿Y Zeca? Vi que se lo llevaban."

#: data/calls/noite_07_baile.tres
msgid "Estava sem documento. Passou a noite lá. A mãe dele está desesperada."
msgstr "No tenía documentos. Pasó la noche ahí. Su madre está desesperada."

#: data/calls/noite_07_baile.tres
msgid "Nunca mais vou a baile na praça. Nunca mais."
msgstr "Nunca más voy a un baile en la plaza. Nunca más."

#: data/calls/noite_07_parente.tres data/calls/noite_07_raimundo_padre.tres data/calls/noite_07_raimundo_caiu.tres
msgid "Seu Raimundo"
msgstr "Seu Raimundo"

#: data/calls/noite_07_parente.tres
msgid "A delegacia, moça. Rápido, por favor."
msgstr "La comisaría, señorita. Rápido, por favor."

#: data/calls/noite_07_parente.tres
msgid "Meu filho está preso aí desde o baile."
msgstr "Mi hijo está detenido ahí desde el baile."

#: data/calls/noite_07_parente.tres data/calls/noite_07_raimundo_caiu.tres
msgid "A delegacia do Centro."
msgstr "La comisaría del Centro."

#: data/calls/noite_07_parente.tres
msgid "Boa noite. O meu filho, José Teles, está aí desde o baile. Sem documento."
msgstr "Buenas noches. Mi hijo, José Teles, está ahí desde el baile. Sin documentos."

#: data/calls/noite_07_parente.tres
msgid "Os do baile foram soltos de manhã. Quase todos."
msgstr "Los del baile salieron por la mañana. Casi todos."

#: data/calls/noite_07_parente.tres
msgid "Quase todos? Ele não voltou pra casa."
msgstr "¿Casi todos? Él no volvió a casa."

#: data/calls/noite_07_parente.tres
msgid "Então está entre os que estão sendo ouvidos. Sai quando acabar."
msgstr "Entonces está entre los que están declarando. Saldrá cuando termine."

#: data/calls/noite_07_parente.tres
msgid "Acabar o quê? Ele tem dezessete anos!"
msgstr "¿Cuando termine qué? ¡Tiene diecisiete años!"

#: data/calls/noite_07_parente.tres data/calls/noite_07_raimundo_caiu.tres
msgid "Boa noite, senhor. Não insista."
msgstr "Buenas noches, señor. No insista."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Sou eu de novo, moça. O pai do José, o do baile."
msgstr "Soy yo otra vez, señorita. El padre de José, el del baile."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Na delegacia não me disseram nada. Me liga com o Padre Anselmo? Ele conhece o delegado."
msgstr "En la comisaría no me dijeron nada. ¿Me comunica con el padre Anselmo? Él conoce al comisario."

#: data/calls/noite_07_raimundo_padre.tres
msgid "A Casa Paroquial. O Padre Anselmo."
msgstr "La casa parroquial. El padre Anselmo."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Padre, é o Raimundo. O José continua preso, desde o baile."
msgstr "Padre, soy Raimundo. José sigue preso, desde el baile."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Eu soube, Raimundo. Ainda são onze lá dentro."
msgstr "Lo supe, Raimundo. Todavía son once ahí dentro."

#: data/calls/noite_07_raimundo_padre.tres
msgid "O senhor fala com o delegado? Ele tem dezessete anos, padre."
msgstr "¿Usted habla con el comisario? Tiene diecisiete años, padre."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Vou amanhã cedo, depois da missa. Leve a certidão dele."
msgstr "Voy mañana temprano, después de misa. Traiga su partida de nacimiento."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Deus lhe pague, padre."
msgstr "Dios se lo pague, padre."

#: data/calls/noite_07_raimundo_padre.tres
msgid "Reze, Raimundo. E não fale disso no telefone."
msgstr "Rece, Raimundo. Y no hable de esto por teléfono."

#: data/calls/noite_07_raimundo_caiu.tres
msgid "Moça, sou eu de novo. O pai do José, o do baile."
msgstr "Señorita, soy yo otra vez. El padre de José, el del baile."

#: data/calls/noite_07_raimundo_caiu.tres
msgid "A ligação caiu antes de eu falar com a delegacia. Me liga de novo, por favor?"
msgstr "La llamada se cortó antes de que hablara con la comisaría. ¿Me comunica otra vez, por favor?"

#: data/calls/noite_07_raimundo_caiu.tres
msgid "Boa noite. O meu filho, José Teles, está aí desde o baile. Liguei mais cedo e caiu."
msgstr "Buenas noches. Mi hijo, José Teles, está ahí desde el baile. Llamé más temprano y se cortó."

#: data/calls/noite_07_raimundo_caiu.tres
msgid "José Teles... Está sendo ouvido. Sai quando acabar."
msgstr "José Teles... Lo están interrogando. Sale cuando termine."

#: data/calls/noite_07_raimundo_caiu.tres
msgid "Acabar o quê? Ninguém me diz nada!"
msgstr "¿Cuando termine qué? ¡Nadie me dice nada!"

#: data/calls/noite_07_raimundo_caiu.tres
msgid "Volte amanhã, senhor. De dia."
msgstr "Vuelva mañana, señor. De día."

#: data/calls/noite_07_raimundo_caiu.tres
msgid "Ele tem dezessete anos!"
msgstr "¡Tiene diecisiete años!"

#: data/calls/noite_07_taxi.tres
msgid "Boa noite, moça. O ponto de táxi da rodoviária, por favor."
msgstr "Buenas noches, señorita. La parada de taxis de la terminal, por favor."

#: data/calls/noite_07_taxi.tres
msgid "Preciso de um carro aqui na Rua do Mercado."
msgstr "Necesito un coche aquí en la Rua do Mercado."

#: data/calls/noite_07_taxi.tres data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "O ponto de táxi da rodoviária."
msgstr "La parada de taxis de la terminal."

#: data/calls/noite_07_taxi.tres data/calls/noite_10_barreira.tres data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Ponto de Táxi da Rodoviária"
msgstr "Ponto de Táxi da Rodoviária"

#: data/calls/noite_07_taxi_briga.tres
msgid "Moça, espera! Começou uma briga aqui na frente do bar! Quatro em cima de um rapaz! Chama a polícia!"
msgstr "¡Señorita, espere! ¡Empezó una pelea aquí frente al bar! ¡Cuatro contra un muchacho! ¡Llame a la policía!"

#: data/calls/noite_07_taxi_briga.tres data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Alguém está ferido?"
msgstr "¿Hay alguien herido?"

#: data/calls/noite_07_taxi_briga.tres data/calls/story_09_briga.tres data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles estão armados?"
msgstr "¿Están armados?"

#: data/calls/noite_07_taxi_briga.tres
msgid "Rua do Mercado, 90! Na frente do bar!"
msgstr "¡Rua do Mercado, 90! ¡Frente al bar!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Ainda não, o rapaz tá se defendendo. Mas tão batendo pra valer!"
msgstr "Todavía no, el muchacho se defiende. ¡Pero le están pegando en serio!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Não vi arma, não. É só soco e pontapé."
msgstr "No vi armas, no. Son puños y patadas."

#: data/calls/noite_07_taxi_briga.tres
msgid "Tô ouvindo a sirene. Moça, não precisa mais transferir pro ponto de táxi. Vou ficar aqui e ajudar o rapaz!"
msgstr "Ya oigo la sirena. Señorita, ya no hace falta pasarme con la parada de taxis. ¡Me quedo a ayudar al muchacho!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Derrubaram o rapaz no chão! Tão chutando ele!"
msgstr "¡Tiraron al muchacho al suelo! ¡Lo están pateando!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Ele está se mexendo?"
msgstr "¿Se mueve?"

#: data/calls/noite_07_taxi_briga.tres
msgid "Mexe a mão... mas a cabeça tá sangrando muito!"
msgstr "Mueve la mano... ¡pero la cabeza le sangra mucho!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Ele parou de se mexer! Os outros fugiram correndo!"
msgstr "¡Dejó de moverse! ¡Los otros salieron corriendo!"

#: data/calls/noite_07_taxi_briga.tres data/calls/story_09_mae_atropelado.tres data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele está respirando?"
msgstr "¿Está respirando?"

#: data/calls/noite_07_taxi_briga.tres
msgid "Tá, mas bem fraquinho!"
msgstr "¡Sí, pero muy débil!"

#: data/calls/noite_07_taxi_briga.tres
msgid "Ele não respira mais, moça... era um menino."
msgstr "Ya no respira, señorita... era un chico."

#: data/calls/noite_07_taxi_briga.tres
msgid "Ninguém mais. Só ele, no chão."
msgstr "Nadie más. Solo él, en el suelo."

#: data/nights/night_07.tres
msgid "A barreira na saída da praça."
msgstr "La barrera a la salida de la plaza."

#: data/nights/night_07.tres
msgid "Baile da praça termina em revista geral\nPerto da meia-noite, a polícia cercou a praça do Centro e revistou todos os que saíam do baile. Doze pessoas sem documento passaram a noite na delegacia. A prefeitura promete novos bailes."
msgstr "El baile de la plaza termina en una requisa general\nCerca de la medianoche, la policía rodeó la plaza del Centro y registró a todos los que salían del baile. Doce personas sin documentos pasaron la noche en la comisaría. La alcaldía promete nuevos bailes."

#: data/nights/night_07.tres
msgid "Bar do Zé, boa noite."
msgstr "Bar do Zé, buenas noches."

#: data/nights/night_07.tres
msgid "Cuidado: a polícia está gravando tudo o que vai para aí."
msgstr "Cuidado: la policía está grabando todo lo que va para allá."

#: data/nights/night_07.tres
msgid "...Entendi. Obrigado, moça. A gente sabe se virar."
msgstr "...Entendido. Gracias, señorita. Sabemos arreglárnoslas."

#: data/nights/night_08.tres
msgid "O supervisor deixou um recado: \"Pedido da polícia: grave as ligações para o Bar do Zé e para o Hotel Serena e entregue as fitas a eles no fim do turno.\""
msgstr "El supervisor dejó una nota: \"Pedido de la policía: grabe las llamadas al Bar do Zé y al Hotel Serena y entrégueles las cintas al final del turno.\""

#: data/calls/story_08_sebastiao.tres
msgid "Maria, é o Sebastião."
msgstr "Maria, es Sebastião."

#: data/calls/story_08_sebastiao.tres
msgid "Você tem me ajudado mais do que imagina. Hoje é mais uma."
msgstr "Me has ayudado más de lo que imaginas. Hoy es una más."

#: data/calls/story_08_sebastiao.tres
msgid "Faz tempo. Eu sumi porque achei que você não queria ouvir. Mas agora não tenho mais a quem pedir."
msgstr "Hace tiempo. Desaparecí porque pensé que no querías escuchar. Pero ahora no tengo a quién más pedirle."

#: data/calls/story_08_sebastiao.tres
msgid "Eu sei que alguém dessa mesa falou do bar na delegacia. Não vim cobrar: eu também teria medo. Mas agora não tenho mais a quem pedir."
msgstr "Sé que alguien de esta mesa habló del bar en la comisaría. No vengo a reclamar: yo también tendría miedo. Pero ahora no tengo a quién más pedirle."

#: data/calls/story_08_sebastiao.tres
msgid "Ligue para o Hospital São Lucas pelo seu discador e peça a Enfermeira Joana."
msgstr "Llama al Hospital São Lucas con tu discador y pregunta por la Enfermera Joana."

#: data/calls/story_08_sebastiao.tres
msgid "Diga a ela: \"A ala 3C precisa de suprimentos.\" Só isso. Ela entende."
msgstr "Dile: \"El ala 3C necesita suministros.\" Solo eso. Ella entiende."

#: data/calls/story_08_sebastiao.tres
msgid "E o que tem na ala 3C?"
msgstr "¿Y qué hay en el ala 3C?"

#: data/calls/story_08_sebastiao.tres
msgid "Gente nossa que não pode aparecer num hospital da polícia. Quanto menos você souber, melhor."
msgstr "Gente nuestra que no puede aparecer en un hospital de la policía. Cuanto menos sepas, mejor."

#: data/calls/story_08_sebastiao.tres
msgid "Hoje, Maria. Amanhã pode ser tarde pra eles."
msgstr "Hoy, Maria. Mañana puede ser tarde para ellos."

#: data/calls/story_08_sebastiao.tres
msgid "E o hotel: se as autoridades estão de olho nele, ligue pra lá e avise. Antes das nove."
msgstr "Y el hotel: si las autoridades le tienen el ojo puesto, llámalos y avísales. Antes de las nueve."

#: data/calls/story_08_sebastiao_volta.tres
msgid "Maria, Sebastião de novo. É rápido."
msgstr "Maria, Sebastião otra vez. Es rápido."

#: data/calls/story_08_sebastiao_volta.tres
msgid "A Joana recebeu o recado. Obrigado. Tem gente que vai dormir melhor hoje por sua causa."
msgstr "Joana recibió el recado. Gracias. Hay gente que va a dormir mejor hoy gracias a ti."

#: data/calls/story_08_sebastiao_volta.tres
msgid "A Joana ainda não recebeu nada. Ainda dá tempo, mas não muito."
msgstr "Joana todavía no recibió nada. Aún hay tiempo, pero no mucho."

#: data/calls/story_08_bar.tres
msgid "Zé, é o Davi. Sobre a [place:rádio]: está confirmado pra amanhã."
msgstr "Zé, es Davi. Sobre la [place:radio]: está confirmado para mañana."

#: data/calls/story_08_bar.tres
msgid "Fala baixo. Confirmado."
msgstr "Habla bajo. Confirmado."

#: data/calls/story_08_bar.tres
msgid "O [person:Lauro] abre a porta?"
msgstr "¿[person:Lauro] abre la puerta?"

#: data/calls/story_08_bar.tres
msgid "Abre. Às [time:dez]. Agora desliga."
msgstr "Sí. A las [time:diez]. Ahora cuelga."

#: data/calls/story_08_bar_avisado.tres
msgid "Zé, é o Davi. Sobre a..."
msgstr "Zé, es Davi. Sobre la..."

#: data/calls/story_08_bar_avisado.tres
msgid "Davi, o jogo foi adiado. Choveu no campo."
msgstr "Davi, el partido se suspendió. Llovió en la cancha."

#: data/calls/story_08_bar_avisado.tres
msgid "Que pena. Até mais, então."
msgstr "Qué lástima. Hasta luego, entonces."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres data/calls/story_08_hotel_grupos_avisado.tres
msgid "O Hotel Serena, por favor."
msgstr "El Hotel Serena, por favor."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres data/calls/story_08_hotel_grupos_avisado.tres
msgid "O hotel. O Serena."
msgstr "El hotel. El Serena."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres data/calls/story_08_hotel_grupos_avisado.tres
msgid "Hotel Serena"
msgstr "Hotel Serena"

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres
msgid "Hotel? É o Lauro. Preciso confirmar os lugares que a gente combinou ontem."
msgstr "¿Hotel? Es Lauro. Necesito confirmar los lugares que acordamos ayer."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres
msgid "Pode falar, mas rápido."
msgstr "Habla, pero rápido."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres
msgid "Grupo A na [place:estação], grupo B na [place:praça da Matriz], grupo C no [place:Alto da Serra]."
msgstr "El grupo A en la [place:estación], el grupo B en la [place:plaza de la Matriz], el grupo C en el [place:Alto da Serra]."

#: data/calls/story_08_hotel_grupos.tres
msgid "E o resto espera o sinal no [place:Armazém Ferreira]."
msgstr "Y el resto espera la señal en el [place:Armazém Ferreira]."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres
msgid "Entendido. Até o dia."
msgstr "Entendido. Hasta el día."

#: data/calls/story_08_hotel_grupos.tres data/calls/story_08_hotel_grupos_armas.tres data/calls/story_08_hotel_grupos_avisado.tres
msgid "Lauro Teixeira."
msgstr "Lauro Teixeira."

#: data/calls/story_08_hotel_grupos_armas.tres
msgid "O armazém do Ferreira caiu. O resto espera o sinal na casa dele, na [street:Rua da Estação]."
msgstr "El Almacén Ferreira cayó. Los demás esperan la señal en su casa, en la [street:Rua da Estação]."

#: data/calls/story_08_hotel_grupos_avisado.tres
msgid "Hotel? É o Lauro. Preciso confirmar os..."
msgstr "¿Hotel? Es Lauro. Necesito confirmar los..."

#: data/calls/story_08_hotel_grupos_avisado.tres
msgid "Seu Lauro! O quarto que o senhor reservou é o de solteiro, não é?"
msgstr "¡Don Lauro! La habitación que reservó es la individual, ¿no?"

#: data/calls/story_08_hotel_grupos_avisado.tres
msgid "Quarto? É... é, de solteiro."
msgstr "¿Habitación? Sí... sí, la individual."

#: data/calls/story_08_hotel_grupos_avisado.tres
msgid "Então está confirmado. Boa noite, senhor."
msgstr "Entonces está confirmado. Buenas noches, señor."

#: data/calls/story_08_hotel_comandante.tres data/calls/story_08_hotel_comandante_avisado.tres
msgid "O Hotel Serena, por gentileza."
msgstr "El Hotel Serena, por favor."

#: data/calls/story_08_hotel_comandante.tres data/calls/story_08_hotel_comandante_avisado.tres
msgid "O hotel, o Serena."
msgstr "El hotel, el Serena."

#: data/calls/story_08_hotel_comandante.tres
msgid "Boa noite. O comandante já chegou?"
msgstr "Buenas noches. ¿Ya llegó el comandante?"

#: data/calls/story_08_hotel_comandante.tres
msgid "Chegou. Está no [place:armazém] da [street:Rua do Moinho], com dois homens."
msgstr "Llegó. Está en el [place:almacén] de la [street:Rua do Moinho], con dos hombres."

#: data/calls/story_08_hotel_comandante.tres
msgid "Até quando?"
msgstr "¿Hasta cuándo?"

#: data/calls/story_08_hotel_comandante.tres
msgid "Até o dia [time:vinte e dois]. De lá ele não sai."
msgstr "Hasta el día [time:veintidós]. De ahí no sale."

#: data/calls/story_08_hotel_comandante.tres
msgid "Então ninguém liga pra lá. Boa noite."
msgstr "Entonces nadie llama allá. Buenas noches."

#: data/calls/story_08_hotel_comandante.tres data/calls/story_08_hotel_comandante_avisado.tres
msgid "Aurélio Campos."
msgstr "Aurélio Campos."

#: data/calls/story_08_hotel_comandante_avisado.tres
msgid "Boa noite. O comandante..."
msgstr "Buenas noches. El comandante..."

#: data/calls/story_08_hotel_comandante_avisado.tres
msgid "O gerente? Saiu, senhor. Volta amanhã cedo."
msgstr "¿El gerente? Salió, señor. Vuelve mañana temprano."

#: data/calls/story_08_hotel_comandante_avisado.tres
msgid "Ah. Então eu ligo amanhã."
msgstr "Ah. Entonces llamo mañana."

#: data/calls/story_08_hotel_comandante_avisado.tres
msgid "Boa noite, senhor."
msgstr "Buenas noches, señor."

#: data/calls/story_08_miguel.tres
msgid "Alô? É o Miguel. Posso falar um pouquinho?"
msgstr "¿Aló? Es Miguel. ¿Puedo hablar un ratito?"

#: data/calls/story_08_miguel.tres
msgid "Pode, Miguel. Conta."
msgstr "Puedes, Miguel. Cuéntame."

#: data/calls/story_08_miguel.tres
msgid "Agora não dá."
msgstr "Ahora no puedo."

#: data/calls/story_08_miguel.tres
msgid "Eu descobri uma coisa do meu irmão. Mas é segredo, tá? Jura que não conta pra ninguém?"
msgstr "Descubrí una cosa de mi hermano. Pero es secreto, ¿eh? ¿Jura que no se lo cuenta a nadie?"

#: data/calls/story_08_miguel.tres
msgid "Juro."
msgstr "Lo juro."

#: data/calls/story_08_miguel.tres
msgid "Depende do segredo."
msgstr "Depende del secreto."

#: data/calls/story_08_miguel.tres
msgid "Ele tá com os rebeldes. Os que picham os muros. Eu vi as latas de tinta debaixo da cama dele."
msgstr "Está con los rebeldes. Los que pintan los muros. Vi las latas de pintura debajo de su cama."

#: data/calls/story_08_miguel.tres
msgid "E ouvi ele falando no portão: amanhã vai ter uma coisa grande. Na praça."
msgstr "Y lo oí hablando en el portón: mañana va a haber algo grande. En la plaza."

#: data/calls/story_08_miguel.tres
msgid "Miguel, fica longe disso."
msgstr "Miguel, mantente lejos de eso."

#: data/calls/story_08_miguel.tres
msgid "O que mais ele disse?"
msgstr "¿Qué más dijo?"

#: data/calls/story_08_miguel.tres
msgid "Que menino não vai. Mas eu não sou mais menino. Tchau!"
msgstr "Que los niños no van. Pero yo ya no soy un niño. ¡Chau!"

#: data/calls/story_08_miguel.tres
msgid "Tá. É que o meu irmão não brinca mais comigo. Ninguém quer conversar."
msgstr "Bueno. Es que mi hermano ya no juega conmigo. Nadie quiere conversar."

#: data/calls/story_08_miguel.tres
msgid "Tchau."
msgstr "Chau."

#: data/calls/story_08_generosa.tres
msgid "Boa noite! O Otávio Almeida, por favor. Da Rua da Estação."
msgstr "¡Buenas noches! Otávio Almeida, por favor. De la Rua da Estação."

#: data/calls/story_08_generosa.tres
msgid "Moça, ontem ele me deu um beijo! Na porta de casa, com a minha mãe espiando pela janela!"
msgstr "¡Señorita, ayer me dio un beso! ¡En la puerta de casa, con mi madre espiando por la ventana!"

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "O Otávio Almeida, da Rua da Estação."
msgstr "Otávio Almeida, de la Rua da Estação."

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Otávio Almeida"
msgstr "Otávio Almeida"

#: data/calls/story_08_generosa.tres data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Obrigada!"
msgstr "¡Gracias!"

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres data/nights/night_15.tres
msgid "Alô?"
msgstr "¿Aló?"

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "Sou eu. Liguei só pra ouvir a sua voz."
msgstr "Soy yo. Llamé solo para oír tu voz."

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "Amanhã eu vou na [place:praça] com o pessoal da estação. Vai ter muita gente."
msgstr "Mañana voy a la [place:plaza] con la gente de la estación. Va a haber mucha gente."

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "Na praça? Otávio, toma cuidado."
msgstr "¿A la plaza? Otávio, ten cuidado."

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "É só uma passeata. Depois eu te ligo."
msgstr "Es solo una marcha. Después te llamo."

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres
msgid "Liga mesmo, hein?"
msgstr "Llama de verdad, ¿eh?"

#: data/calls/story_08_generosa.tres data/calls/story_08_generosa_recado.tres data/calls/story_12_generosa_radio.tres
msgid "Generosa Prates."
msgstr "Generosa Prates."

#: data/calls/story_08_generosa_recado.tres
msgid "Boa noite. O Otávio Almeida, por favor. Da Rua da Estação."
msgstr "Buenas noches. Otávio Almeida, por favor. De la Rua da Estação."

#: data/calls/story_08_generosa_recado.tres
msgid "Consegui o número dele com a prima de uma amiga. Ele jura que deixou recado na central e ninguém nunca me passou."
msgstr "Conseguí su número con la prima de una amiga. Él jura que dejó recado en la central y nadie nunca me lo pasó."

#: data/calls/story_08_generosa_recado.tres
msgid "Mas não faz mal. Ontem ele me deu um beijo!"
msgstr "Pero no importa. ¡Ayer me dio un beso!"

#: data/calls/noite_08_jornal.tres
msgid "Dona Alzira"
msgstr "Dona Alzira"

#: data/calls/noite_08_jornal.tres
msgid "Boa noite. A Farmácia Central, ainda abre?"
msgstr "Buenas noches. ¿La Farmácia Central todavía atiende?"

#: data/calls/noite_08_jornal.tres
msgid "Preciso de um calmante pro meu marido."
msgstr "Necesito un calmante para mi marido."

#: data/calls/noite_08_jornal.tres
msgid "A Farmácia Central, moça."
msgstr "La Farmácia Central, señorita."

#: data/calls/noite_08_jornal.tres data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Obrigada, querida."
msgstr "Gracias, querida."

#: data/calls/noite_08_jornal.tres
msgid "Farmácia? É a Alzira. Tem calmante? O Jorge não dorme desde o jornal."
msgstr "¿Farmacia? Soy Alzira. ¿Hay calmante? Jorge no duerme desde el diario."

#: data/calls/noite_08_jornal.tres
msgid "Tenho, dona Alzira. Mas o que deu nele?"
msgstr "Hay, doña Alzira. ¿Pero qué le pasa?"

#: data/calls/noite_08_jornal.tres
msgid "A polícia anda revirando a cidade de novo. Ele acha que vem bater aqui."
msgstr "La policía anda revolviendo la ciudad otra vez. Él cree que van a golpear aquí."

#: data/calls/noite_08_jornal.tres
msgid "Vocês não têm nada a esconder."
msgstr "Ustedes no tienen nada que esconder."

#: data/calls/noite_08_jornal.tres
msgid "Ninguém tem, até a polícia chegar. Guarda dois vidros pra mim?"
msgstr "Nadie tiene, hasta que llega la policía. ¿Me guarda dos frascos?"

#: data/calls/noite_08_jornal.tres
msgid "Guardo. Mando o menino levar amanhã cedo."
msgstr "Se los guardo. Mando al chico a llevarlos mañana temprano."

#: data/calls/noite_08_parente.tres
msgid "Dona Glória"
msgstr "Dona Glória"

#: data/calls/noite_08_parente.tres
msgid "Boa noite. A delegacia, por favor."
msgstr "Buenas noches. La comisaría, por favor."

#: data/calls/noite_08_parente.tres
msgid "Meu marido estava no porão da Rua das Acácias. Saiu no jornal."
msgstr "Mi marido estaba en el sótano de la Rua das Acácias. Salió en el diario."

#: data/calls/noite_08_parente.tres
msgid "A delegacia, moça. É sobre os sete presos."
msgstr "La comisaría, señorita. Es por los siete detenidos."

#: data/calls/noite_08_parente.tres
msgid "Obrigada, moça. Ninguém me diz nada."
msgstr "Gracias, señorita. Nadie me dice nada."

#: data/calls/noite_08_parente.tres
msgid "Boa noite. O meu marido, Renato Fontes, é um dos sete do porão."
msgstr "Buenas noches. Mi marido, Renato Fontes, es uno de los siete del sótano."

#: data/calls/noite_08_parente.tres
msgid "A senhora é parente? Os nomes não serão divulgados."
msgstr "¿Usted es pariente? Los nombres no serán divulgados."

#: data/calls/noite_08_parente.tres
msgid "Eu não quero o nome no jornal. Quero saber se ele está vivo."
msgstr "No quiero el nombre en el diario. Quiero saber si está vivo."

#: data/calls/noite_08_parente.tres
msgid "Os presos estão sendo ouvidos. Estão bem."
msgstr "Los detenidos están declarando. Están bien."

#: data/calls/noite_08_parente.tres
msgid "Posso levar um cobertor? Uma comida?"
msgstr "¿Puedo llevarle una manta? ¿Algo de comida?"

#: data/calls/noite_08_parente.tres
msgid "Não. E não ligue mais pra cá, senhora."
msgstr "No. Y no llame más aquí, señora."

#: data/nights/night_08.tres
msgid "Polícia apreende armas em armazém\nDoze caixas de armas foram encontradas nesta madrugada no fundo de um armazém do Alto da Serra, escondidas sob sacos de café. A polícia agradece a colaboração de cidadãos."
msgstr "La policía incauta armas en un almacén\nDoce cajas de armas fueron encontradas esta madrugada al fondo de un almacén del Alto da Serra, escondidas bajo sacos de café. La policía agradece la colaboración de los ciudadanos."

#: data/nights/night_08.tres
msgid "As armas achadas no armazém."
msgstr "Las armas halladas en el almacén."

#: data/nights/night_08.tres
msgid "Batida em porão termina com sete presos\nNa Rua das Acácias, a polícia surpreendeu uma reunião clandestina num porão. Os presos não tiveram os nomes divulgados. A família de um deles procura notícias desde a madrugada."
msgstr "Redada en un sótano termina con siete detenidos\nEn la Rua das Acácias, la policía sorprendió una reunión clandestina en un sótano. No se divulgaron los nombres de los detenidos. La familia de uno de ellos busca noticias desde la madrugada."

#: data/nights/night_08.tres
msgid "O camburão na porta do porão."
msgstr "El furgón policial en la puerta del sótano."

#: data/nights/night_08.tres
msgid "Polícia guarda a Rádio Serena dia e noite\nDesde ontem, dois soldados ficam na porta da Rádio Serena AM, e quem entra mostra documento. A delegacia diz ter recebido \"informação segura\" de um plano contra a emissora."
msgstr "La policía custodia la Rádio Serena día y noche\nDesde ayer, dos soldados se quedan en la puerta de la Rádio Serena AM, y quien entra muestra documentos. La comisaría dice haber recibido \"información segura\" de un plan contra la emisora."

#: data/nights/night_08.tres
msgid "A Rádio Serena, guardada."
msgstr "Radio Serena, custodiada."

#: data/nights/night_08.tres
msgid "Busca em armazéns do Alto da Serra termina sem nada\nA polícia revirou três armazéns do Alto da Serra atrás de armas que, segundo a delegacia, estariam escondidas na cidade. Não achou nada. O delegado acredita que \"alguém avisou\"."
msgstr "La búsqueda en almacenes del Alto da Serra termina sin nada\nLa policía revolvió tres almacenes del Alto da Serra en busca de armas que, según la comisaría, estarían escondidas en la ciudad. No encontró nada. El comisario cree que \"alguien avisó\"."

#: data/nights/night_08.tres
msgid "Caixotes vazios num dos armazéns."
msgstr "Cajones vacíos en uno de los almacenes."

#: data/nights/night_08.tres data/nights/night_10.tres
msgid "Hospital São Lucas, boa noite."
msgstr "Hospital São Lucas, buenas noches."

#: data/nights/night_08.tres data/nights/night_10.tres
msgid "A Enfermeira Joana, por favor."
msgstr "La Enfermera Joana, por favor."

#: data/nights/night_08.tres data/nights/night_10.tres
msgid "Um momento."
msgstr "Un momento."

#: data/nights/night_08.tres data/nights/night_10.tres
msgid "Joana falando."
msgstr "Habla Joana."

#: data/nights/night_08.tres
msgid "A ala 3C precisa de suprimentos."
msgstr "El ala 3C necesita suministros."

#: data/nights/night_08.tres data/nights/night_10.tres
msgid "Desculpe, liguei errado."
msgstr "Perdón, me equivoqué."

#: data/nights/night_08.tres
msgid "...Entendi. Diga a quem mandou que amanhã cedo chega tudo. Obrigada."
msgstr "...Entendido. Dígale a quien la mandó que mañana temprano llega todo. Gracias."

#: data/nights/night_08.tres
msgid "Cuidado: a polícia está gravando as ligações para o hotel."
msgstr "Cuidado: la policía está grabando las llamadas al hotel."

#: data/nights/night_08.tres
msgid "...Obrigado por avisar. A gente fala de outro jeito, então."
msgstr "...Gracias por avisar. Hablaremos de otra manera, entonces."

#: data/nights/night_09.tres
msgid "O supervisor deixou um recado: \"Último setor: a partir de hoje, o setor 2, o Alto da Serra, também fica com você. Os números que começam com 2 passam pela sua mesa. A cidade inteira está nas suas mãos. A pedido das autoridades, grave toda ligação suspeita.\""
msgstr "El supervisor dejó una nota: \"Último sector: a partir de hoy, el sector 2, el Alto da Serra, también queda con usted. Los números que empiezan con 2 pasan por su mesa. La ciudad entera está en sus manos. A pedido de las autoridades, grabe toda llamada sospechosa.\""

#: data/calls/story_09_sebastiao.tres
msgid "Maria, é o Sebastião. Hoje é uma noite importante."
msgstr "Maria, es Sebastião. Hoy es una noche importante."

#: data/calls/story_09_sebastiao.tres
msgid "Nenhuma ligação para a delegacia nem para a Alta Cúpula pode passar pela sua mesa. Nenhuma, até o fim do turno."
msgstr "Ninguna llamada a la comisaría ni a la Alta Cúpula puede pasar por tu mesa. Ninguna, hasta el final del turno."

#: data/calls/story_09_sebastiao.tres
msgid "Vão me dar advertência."
msgstr "Me van a amonestar."

#: data/calls/story_09_sebastiao.tres
msgid "Por quê?"
msgstr "¿Por qué?"

#: data/calls/story_09_sebastiao.tres
msgid "Porque hoje eles não podem pedir ajuda uns aos outros. Amanhã você entende."
msgstr "Porque hoy no pueden pedirse ayuda unos a otros. Mañana lo entenderás."

#: data/calls/story_09_sebastiao.tres
msgid "Eu sei o que isso vai te custar. Hoje vale a pena."
msgstr "Sé lo que esto te va a costar. Hoy vale la pena."

#: data/calls/story_09_sebastiao.tres
msgid "Deixe tocar. Diga que a linha está ocupada. O que for."
msgstr "Déjalo sonar. Di que la línea está ocupada. Lo que sea."

#: data/calls/story_09_policia_radio.tres data/calls/story_09_policia_cancao.tres data/calls/story_09_policia_cancao_caiu.tres
msgid "Policial"
msgstr "Policía"

#: data/calls/story_09_policia_radio.tres
msgid "A delegacia, por favor. É da polícia."
msgstr "La comisaría, por favor. Es la policía."

#: data/calls/story_09_policia_radio.tres
msgid "A delegacia, por favor."
msgstr "La comisaría, por favor."

#: data/calls/story_09_policia_radio.tres
msgid "Plantão? Rubens, da rodoviária. Tem movimento perto da [place:Rádio Serena]."
msgstr "¿Guardia? Rubens, de la terminal. Hay movimiento cerca de la [place:Rádio Serena]."

#: data/calls/story_09_policia_radio.tres
msgid "Que tipo de movimento?"
msgstr "¿Qué tipo de movimiento?"

#: data/calls/story_09_policia_radio.tres
msgid "Gente entrando pelos fundos. Mando uma viatura?"
msgstr "Gente entrando por el fondo. ¿Mando una patrulla?"

#: data/calls/story_09_policia_radio.tres
msgid "Manda duas. Agora."
msgstr "Manda dos. Ahora."

#: data/calls/story_09_policia_radio.tres data/calls/story_14_policia_aeroporto.tres data/calls/story_15_policia_ferrovia.tres
msgid "Rubens Moura, do posto da rodoviária."
msgstr "Rubens Moura, del puesto de la terminal."

#: data/calls/story_09_cupula_radio.tres data/calls/story_09_cupula_radio_caiu.tres data/calls/story_14_cupula_aviao.tres
msgid "Assessor"
msgstr "Asesor"

#: data/calls/story_09_cupula_radio.tres data/calls/story_09_cupula_radio_caiu.tres data/calls/story_14_cupula_aviao.tres
msgid "A Alta Cúpula. É urgente."
msgstr "La Alta Cúpula. Es urgente."

#: data/calls/story_09_cupula_radio.tres data/calls/story_09_cupula_radio_caiu.tres data/calls/story_12_cupula_ronda.tres
msgid "A Alta Cúpula."
msgstr "La Alta Cúpula."

#: data/calls/story_09_cupula_radio.tres data/calls/story_09_cupula_radio_caiu.tres data/calls/story_12_cupula_telefonista.tres
msgid "Alta Cúpula"
msgstr "Alta Cúpula"

#: data/calls/story_09_cupula_radio.tres
msgid "Valadares. Alguém sabe por que a [place:rádio] mudou a programação?"
msgstr "Valadares. ¿Alguien sabe por qué la [place:radio] cambió la programación?"

#: data/calls/story_09_cupula_radio.tres
msgid "Ainda não. Estamos ligando pra lá e ninguém atende."
msgstr "Todavía no. Estamos llamando allá y nadie contesta."

#: data/calls/story_09_cupula_radio.tres
msgid "Pois mandem gente. E coloquem homens na porta do [place:transmissor]."
msgstr "Pues manden gente. Y pongan hombres en la puerta del [place:transmisor]."

#: data/calls/story_09_cupula_radio.tres data/calls/story_09_cupula_radio_caiu.tres data/calls/story_14_cupula_aviao.tres
msgid "Henrique Valadares, da residência oficial."
msgstr "Henrique Valadares, de la residencia oficial."

#: data/calls/story_09_cupula_radio_caiu.tres
msgid "Valadares. Como está a [place:rádio]?"
msgstr "Valadares. ¿Cómo está la [place:radio]?"

#: data/calls/story_09_cupula_radio_caiu.tres
msgid "Quieta. A viatura pegou dois rapazes nos fundos, às dez."
msgstr "Tranquila. La patrulla agarró a dos muchachos por el fondo, a las diez."

#: data/calls/story_09_cupula_radio_caiu.tres
msgid "Pois mandem mais gente. E coloquem homens na porta do [place:transmissor]."
msgstr "Pues manden más gente. Y pongan hombres en la puerta del [place:transmisor]."

#: data/calls/story_09_policia_cancao.tres data/calls/story_09_policia_cancao_caiu.tres data/calls/story_15_policia_ferrovia.tres
msgid "A delegacia, rápido."
msgstr "La comisaría, rápido."

#: data/calls/story_09_policia_cancao.tres
msgid "Bastos falando. Os ouvintes estão ligando: a rádio tocou a [other:Canção da Madrugada]."
msgstr "Habla Bastos. Los oyentes están llamando: la radio tocó la [other:Canção da Madrugada]."

#: data/calls/story_09_policia_cancao.tres
msgid "A proibida? Manda fechar aquilo agora!"
msgstr "¿La prohibida? ¡Manda cerrar eso ya!"

#: data/calls/story_09_policia_cancao.tres data/calls/story_09_policia_cancao_caiu.tres
msgid "Estou indo."
msgstr "Voy para allá."

#: data/calls/story_09_policia_cancao.tres data/calls/story_09_policia_cancao_caiu.tres data/calls/story_12_cupula_ronda.tres
msgid "Jorge Bastos, da polícia."
msgstr "Jorge Bastos, de la policía."

#: data/calls/story_09_policia_cancao_caiu.tres
msgid "Bastos falando. A [place:rádio] está tranquila. Os rapazes já falaram: era pra tocar a [other:Canção da Madrugada]."
msgstr "Habla Bastos. La [place:radio] está tranquila. Los muchachos ya hablaron: iban a poner la [other:Canção da Madrugada]."

#: data/calls/story_09_policia_cancao_caiu.tres
msgid "A proibida? Fecha aquilo hoje mesmo. Não quero nem o locutor lá dentro."
msgstr "¿La prohibida? Cierren eso hoy mismo. No quiero ni al locutor ahí dentro."

#: data/calls/story_09_carro_fogo.tres
msgid "Central! Puseram fogo num carro no meio da rua! Fecharam tudo com pneu!"
msgstr "¡Central! ¡Le prendieron fuego a un coche en medio de la calle! ¡Cerraron todo con neumáticos!"

#: data/calls/story_09_carro_fogo.tres
msgid "Tem alguém perto do fogo?"
msgstr "¿Hay alguien cerca del fuego?"

#: data/calls/story_09_carro_fogo.tres
msgid "Dá para passar pela rua?"
msgstr "¿Se puede pasar por la calle?"

#: data/calls/story_09_carro_fogo.tres
msgid "Rua do Moinho, 60, em frente ao armazém!"
msgstr "¡Rua do Moinho, 60, frente al almacén!"

#: data/calls/story_09_carro_fogo.tres
msgid "Não, saiu todo mundo de perto. Só tem o fogo."
msgstr "No, todos se alejaron. Solo está el fuego."

#: data/calls/story_09_carro_fogo.tres
msgid "Não dá! Tá tudo fechado de pneu queimando!"
msgstr "¡No se puede! ¡Está todo cerrado de neumáticos ardiendo!"

#: data/calls/story_09_carro_fogo.tres
msgid "Tá bom. Vou avisar o pessoal pra não chegar perto."
msgstr "Está bien. Voy a avisar a la gente que no se acerque."

#: data/calls/story_09_carro_fogo.tres
msgid "O tanque do carro estourou! O fogo pulou pra uma casa!"
msgstr "¡Explotó el tanque del coche! ¡El fuego saltó a una casa!"

#: data/calls/story_09_carro_fogo.tres data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Tem gente na casa?"
msgstr "¿Hay gente en la casa?"

#: data/calls/story_09_carro_fogo.tres
msgid "Não, a família já tinha saído pra ver o fogo!"
msgstr "¡No, la familia ya había salido a ver el fuego!"

#: data/calls/story_09_carro_fogo.tres
msgid "A casa tá queimando inteira! Um vizinho queimou o braço tentando apagar!"
msgstr "¡La casa entera se está quemando! ¡Un vecino se quemó el brazo intentando apagarlo!"

#: data/calls/story_09_carro_fogo.tres
msgid "O vizinho está consciente?"
msgstr "¿El vecino está consciente?"

#: data/calls/story_09_carro_fogo.tres
msgid "Tá, mas gritando de dor!"
msgstr "¡Sí, pero gritando de dolor!"

#: data/calls/story_09_carro_fogo.tres
msgid "A casa foi embora... só sobrou a parede."
msgstr "La casa se perdió... solo quedó la pared."

#: data/calls/story_09_carro_fogo.tres
msgid "O vizinho tá com o braço todo queimado!"
msgstr "¡El vecino tiene el brazo todo quemado!"

#: data/calls/story_09_baleado.tres
msgid "Central! Teve tiroteio aqui perto! Meu filho levou um tiro no ombro!"
msgstr "¡Central! ¡Hubo un tiroteo aquí cerca! ¡A mi hijo le dieron un tiro en el hombro!"

#: data/calls/story_09_baleado.tres
msgid "Ele está respirando bem?"
msgstr "¿Está respirando bien?"

#: data/calls/story_09_baleado.tres
msgid "O tiroteio acabou?"
msgstr "¿Terminó el tiroteo?"

#: data/calls/story_09_baleado.tres
msgid "Rua do Sol, 190, a casa azul!"
msgstr "¡Rua do Sol, 190, la casa azul!"

#: data/calls/story_09_baleado.tres
msgid "Tá, mas sangra muito no ombro!"
msgstr "¡Sí, pero sangra mucho del hombro!"

#: data/calls/story_09_baleado.tres
msgid "Não! Ainda tão atirando lá na esquina!"
msgstr "¡No! ¡Todavía están disparando en la esquina!"

#: data/calls/story_09_baleado.tres
msgid "Rápido! Eu tô segurando um pano no ombro dele."
msgstr "¡Rápido! Le estoy sosteniendo un trapo en el hombro."

#: data/calls/story_09_baleado.tres
msgid "Ele tá com frio, tremendo todo!"
msgstr "¡Tiene frío, está temblando entero!"

#: data/calls/story_09_baleado.tres
msgid "Tá, mas não para de tremer!"
msgstr "¡Sí, pero no para de temblar!"

#: data/calls/story_09_baleado.tres
msgid "Ele tá fechando o olho! Fala comigo, filho!"
msgstr "¡Está cerrando los ojos! ¡Háblame, hijo!"

#: data/calls/story_09_baleado.tres
msgid "Só geme! Não responde mais!"
msgstr "¡Solo gime! ¡Ya no responde!"

#: data/calls/story_09_baleado.tres
msgid "Ele... ele parou. Ninguém veio."
msgstr "Él... él se quedó quieto. No vino nadie."

#: data/calls/story_09_baleado.tres
msgid "Não respira direito!"
msgstr "¡No respira bien!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Central! Meu filho! Um carro passou fugindo e pegou o meu filho!"
msgstr "¡Central! ¡Mi hijo! ¡Un auto pasó escapando y atropelló a mi hijo!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Qual é o nome dele?"
msgstr "¿Cómo se llama él?"

#: data/calls/story_09_mae_atropelado.tres
msgid "Rua da Estação, 250, perto da linha do trem!"
msgstr "¡Rua da Estação, 250, cerca de las vías del tren!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Tá no chão, acordado, chorando! A perna tá torta!"
msgstr "¡Está en el suelo, despierto, llorando! ¡Tiene la pierna torcida!"

#: data/calls/story_09_mae_atropelado.tres
msgid "É o meu menino! Pelo amor de Deus, manda alguém!"
msgstr "¡Es mi niño! ¡Por el amor de Dios, mande a alguien!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Eu tô aqui com ele. Ele tá tremendo, a ambulância já vem, filho."
msgstr "Estoy aquí con él. Está temblando. Ya viene la ambulancia, hijo."

#: data/calls/story_09_mae_atropelado.tres
msgid "Ele tá dizendo que não sente a perna!"
msgstr "¡Dice que no siente la pierna!"

#: data/calls/story_09_mae_atropelado.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele está sangrando?"
msgstr "¿Está sangrando?"

#: data/calls/story_09_mae_atropelado.tres
msgid "Um pouco, na cabeça!"
msgstr "¡Un poco, de la cabeza!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Ele fechou os olhos! Fala comigo, filho!"
msgstr "¡Cerró los ojos! ¡Háblame, hijo!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Tá, mas não responde!"
msgstr "¡Sí, pero no responde!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Ele não abre os olhos! Cadê a ambulância?!"
msgstr "¡No abre los ojos! ¡¿Dónde está la ambulancia?!"

#: data/calls/story_09_mae_atropelado.tres
msgid "Respira, mas não acorda!"
msgstr "¡Respira, pero no despierta!"

#: data/calls/story_09_briga.tres
msgid "Central! Tá tendo briga na rua por causa da rádio! Uns gritando viva, outros batendo!"
msgstr "¡Central! ¡Hay una pelea en la calle por lo de la radio! ¡Unos gritando viva, otros pegando!"

#: data/calls/story_09_briga.tres
msgid "Rua das Flores, 75, perto da esquina!"
msgstr "¡Rua das Flores, 75, cerca de la esquina!"

#: data/calls/story_09_briga.tres
msgid "Um senhor caiu e bateu a cabeça no meio-fio!"
msgstr "¡Un señor se cayó y se golpeó la cabeza contra el bordillo!"

#: data/calls/story_09_briga.tres
msgid "Tão com pedaço de pau e pedra!"
msgstr "¡Tienen palos y piedras!"

#: data/calls/story_09_briga.tres
msgid "Vem logo, que o senhor não levanta!"
msgstr "¡Vengan pronto, que el señor no se levanta!"

#: data/calls/story_09_briga.tres
msgid "Quebraram a vitrine da quitanda! Tão pegando tudo!"
msgstr "¡Rompieron la vidriera de la verdulería! ¡Se están llevando todo!"

#: data/calls/story_09_briga.tres
msgid "O senhor ainda está no chão?"
msgstr "¿El señor sigue en el suelo?"

#: data/calls/story_09_briga.tres
msgid "Tá, uns vizinhos tão segurando a cabeça dele!"
msgstr "¡Sí, unos vecinos le están sosteniendo la cabeza!"

#: data/calls/story_09_briga.tres
msgid "Puseram fogo na quitanda!"
msgstr "¡Le prendieron fuego a la verdulería!"

#: data/calls/story_09_briga.tres
msgid "O fogo está grande?"
msgstr "¿El fuego es grande?"

#: data/calls/story_09_briga.tres
msgid "Tá começando, mas tem querosene lá dentro!"
msgstr "¡Está empezando, pero hay querosén adentro!"

#: data/calls/story_09_briga.tres
msgid "A quitanda queimou toda... e levaram o senhor num carro de vizinho."
msgstr "La verdulería se quemó entera... y se llevaron al señor en el coche de un vecino."

#: data/calls/story_09_briga.tres
msgid "O senhor desmaiou no carro!"
msgstr "¡El señor se desmayó en el coche!"

#: data/calls/noite_09_toque.tres
msgid "Seu Fábio"
msgstr "Seu Fábio"

#: data/calls/noite_09_toque.tres
msgid "Boa noite. O Cine Odeon, por favor."
msgstr "Buenas noches. El Cine Odeon, por favor."

#: data/calls/noite_09_toque.tres
msgid "Quero saber se ainda tem a sessão das nove."
msgstr "Quiero saber si todavía hay función de las nueve."

#: data/calls/noite_09_toque.tres
msgid "Odeon? Tem a sessão das nove hoje?"
msgstr "¿Odeon? ¿Hay función de las nueve hoy?"

#: data/calls/noite_09_toque.tres
msgid "Não tem mais, rapaz. Toque de recolher. A última é às sete."
msgstr "Ya no, muchacho. Toque de queda. La última es a las siete."

#: data/calls/noite_09_toque.tres
msgid "Às sete? Eu saio do serviço às sete!"
msgstr "¿A las siete? ¡Salgo del trabajo a las siete!"

#: data/calls/noite_09_toque.tres
msgid "Então só no domingo, na matinê."
msgstr "Entonces solo el domingo, en la matiné."

#: data/calls/noite_09_toque.tres
msgid "E se eu for pego na rua depois das nove?"
msgstr "¿Y si me agarran en la calle después de las nueve?"

#: data/calls/noite_09_toque.tres
msgid "Aí você vê o filme na delegacia. Vá direto pra casa."
msgstr "Entonces ves la película en la comisaría. Vete derecho a casa."

#: data/calls/noite_09_parente.tres
msgid "Dona Odete"
msgstr "Dona Odete"

#: data/calls/noite_09_parente.tres
msgid "Boa noite. O Hospital São Lucas, pelo amor de Deus."
msgstr "Buenas noches. El Hospital São Lucas, por el amor de Dios."

#: data/calls/noite_09_parente.tres
msgid "Meu filho mora na Rua do Moinho. Teve tiro lá."
msgstr "Mi hijo vive en la Rua do Moinho. Hubo tiros ahí."

#: data/calls/noite_09_parente.tres
msgid "O São Lucas, moça. Dois, um, três."
msgstr "El São Lucas, señorita. Dos, uno, tres."

#: data/calls/noite_09_parente.tres data/calls/story_16_generosa_hospital.tres data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Hospital São Lucas"
msgstr "Hospital São Lucas"

#: data/calls/noite_09_parente.tres data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Obrigada, minha filha."
msgstr "Gracias, hija."

#: data/calls/noite_09_parente.tres
msgid "Hospital? Chegou algum ferido da Rua do Moinho? Um rapaz, Sérgio Lins."
msgstr "¿Hospital? ¿Llegó algún herido de la Rua do Moinho? Un muchacho, Sérgio Lins."

#: data/calls/noite_09_parente.tres
msgid "Chegaram dois, senhora. Mas vieram com a polícia, sem nome."
msgstr "Llegaron dos, señora. Pero vinieron con la policía, sin nombre."

#: data/calls/noite_09_parente.tres
msgid "Um deles é magro, de bigode?"
msgstr "¿Uno de ellos es flaco, de bigote?"

#: data/calls/noite_09_parente.tres
msgid "Não posso dizer, senhora. A ala está fechada."
msgstr "No puedo decirle, señora. El pabellón está cerrado."

#: data/calls/noite_09_parente.tres
msgid "Fechada pra mãe?"
msgstr "¿Cerrado para la madre?"

#: data/calls/noite_09_parente.tres
msgid "Fechada pra todo mundo. Sinto muito."
msgstr "Cerrado para todo el mundo. Lo siento."

#: data/calls/noite_09_irma.tres
msgid "Boa noite, moça. Me liga com a Marta Costa, a minha irmã?"
msgstr "Buenas noches, señorita. ¿Me comunica con Marta Costa, mi hermana?"

#: data/calls/noite_09_irma.tres
msgid "O meu filho saiu pra casa dela e ainda não chegou."
msgstr "Mi hijo salió para su casa y todavía no llegó."

#: data/calls/noite_09_irma.tres
msgid "A Marta Costa, a minha irmã."
msgstr "Marta Costa, mi hermana."

#: data/calls/noite_09_irma.tres data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Marta Costa"
msgstr "Marta Costa"

#: data/calls/noite_09_irma.tres data/calls/noite_12_parente.tres data/calls/noite_14_parente.tres
msgid "Obrigada, moça."
msgstr "Gracias, joven."

#: data/calls/noite_09_irma_tiros.tres
msgid "Meu Deus, tiro! Atiraram lá fora... tem um rapaz caído na esquina... é o Dudu! É o meu filho, moça!"
msgstr "¡Dios mío, disparos! Dispararon afuera... hay un muchacho tirado en la esquina... ¡es Dudu! ¡Es mi hijo, señorita!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Rua Bela Vista, 230! Na esquina!"
msgstr "¡Rua Bela Vista, 230! ¡En la esquina!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Um carro passou atirando e sumiu... mas pode voltar!"
msgstr "Un coche pasó disparando y desapareció... ¡pero puede volver!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Tá gemendo... levou no braço, tá sangrando muito!"
msgstr "Está gimiendo... le dieron en el brazo, ¡sangra mucho!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Tô ouvindo a sirene... Moça, esquece a minha irmã. Eu vou com ele pro hospital."
msgstr "Ya oigo la sirena... Señorita, olvide a mi hermana. Me voy con él al hospital."

#: data/calls/noite_09_irma_tiros.tres
msgid "Ele tá ficando branco, moça... o sangue não para!"
msgstr "Se está poniendo pálido, señorita... ¡la sangre no para!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Dá para apertar o ferimento com um pano?"
msgstr "¿Puede apretar la herida con un trapo?"

#: data/calls/noite_09_irma_tiros.tres
msgid "Tô apertando! Tô apertando com a minha blusa!"
msgstr "¡Estoy apretando! ¡Con mi blusa!"

#: data/calls/noite_09_irma_tiros.tres
msgid "Ele fechou os olhos! Dudu! Dudu, fala comigo!"
msgstr "¡Cerró los ojos! ¡Dudu! ¡Dudu, háblame!"

#: data/calls/noite_09_irma_tiros.tres data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele ainda respira?"
msgstr "¿Todavía respira?"

#: data/calls/noite_09_irma_tiros.tres
msgid "Respira... devagarinho."
msgstr "Respira... despacito."

#: data/calls/noite_09_irma_tiros.tres
msgid "Ele morreu, moça. Morreu no meu colo."
msgstr "Se murió, señorita. Se murió en mis brazos."

#: data/calls/noite_09_irma_tiros.tres
msgid "Ninguém... só o meu filho."
msgstr "Nadie... solo mi hijo."

#: data/nights/night_09.tres
msgid "Rua do Centro às nove e cinco."
msgstr "Una calle del Centro a las nueve y cinco."

#: data/nights/night_09.tres
msgid "Toque de recolher às nove da noite\nA partir de hoje, ninguém fica na rua depois das 21h sem salvo-conduto, por ordem da Alta Cúpula. Bares e cinemas fecham às oito e meia. Quem for pego na rua responde na delegacia."
msgstr "Toque de queda a las nueve de la noche\nDesde hoy, nadie se queda en la calle después de las 21 h sin salvoconducto, por orden de la Alta Cúpula. Bares y cines cierran a las ocho y media. Quien sea sorprendido en la calle responderá en la comisaría."

#: data/nights/night_09.tres
msgid "Polícia ocupa a estação e a praça da Matriz\nDesde a madrugada, viaturas guardam a estação, a praça da Matriz e as saídas do Alto da Serra. A Alta Cúpula fala em \"prevenção\" e não dá detalhes."
msgstr "La policía ocupa la estación y la plaza de la Matriz\nDesde la madrugada, patrullas vigilan la estación, la plaza de la Matriz y las salidas del Alto da Serra. La Alta Cúpula habla de \"prevención\" y no da detalles."

#: data/nights/night_09.tres
msgid "A viatura na praça da Matriz."
msgstr "El patrullero en la plaza de la Matriz."

#: data/nights/night_09.tres
msgid "Cerco a armazém na Rua do Moinho\nA polícia cercou nesta madrugada um armazém da Rua do Moinho onde estaria escondido o chefe dos rebeldes. Houve tiros. A Alta Cúpula não confirma prisões."
msgstr "Cerco a un almacén en la Rua do Moinho\nEsta madrugada la policía cercó un almacén de la Rua do Moinho donde estaría escondido el jefe de los rebeldes. Hubo disparos. La Alta Cúpula no confirma detenciones."

#: data/nights/night_09.tres
msgid "A barreira na Rua do Moinho."
msgstr "La barrera en la Rua do Moinho."

#: data/nights/night_10.tres
msgid "O supervisor deixou um recado: \"Com os três setores, a noite fica mais cheia. Emergência vem primeiro.\""
msgstr "El supervisor dejó un recado: \"Con los tres sectores, la noche se llena más. Las emergencias van primero.\""

#: data/calls/story_10_cecilia.tres
msgid "Maria? É a Cecília. Não pergunte de onde estou ligando."
msgstr "¿Maria? Es Cecília. No preguntes desde dónde llamo."

#: data/calls/story_10_cecilia.tres
msgid "Eu deixei o Alto da Serra. Hoje eu vou embora de São Sotero, e não sei se volto."
msgstr "Dejé el Alto da Serra. Hoy me voy de São Sotero, y no sé si vuelvo."

#: data/calls/story_10_cecilia.tres data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O que aconteceu?"
msgstr "¿Qué pasó?"

#: data/calls/story_10_cecilia.tres
msgid "Você está bem?"
msgstr "¿Estás bien?"

#: data/calls/story_10_cecilia.tres
msgid "Vieram atrás de mim. Eu saí pelos fundos, a tempo. Outros não vão ter a mesma sorte."
msgstr "Vinieron por mí. Salí por el fondo, a tiempo. Otros no van a tener la misma suerte."

#: data/calls/story_10_cecilia.tres
msgid "Por isso eu preciso de você: ligue pelo seu discador para a Casa Paroquial, o 120, e peça abrigo para algumas famílias. Hoje."
msgstr "Por eso te necesito: llama con tu discador a la Casa Parroquial, el 120, y pide refugio para algunas familias. Hoy."

#: data/calls/story_10_cecilia.tres
msgid "O padre vai entender. Diga que é pelas famílias do Alto."
msgstr "El padre va a entender. Di que es por las familias del Alto."

#: data/calls/story_10_cecilia.tres
msgid "Eu ligo."
msgstr "Llamo."

#: data/calls/story_10_cecilia.tres
msgid "Cecília, e você?"
msgstr "Cecília, ¿y tú?"

#: data/calls/story_10_cecilia.tres
msgid "Eu me viro. Sempre me virei."
msgstr "Me las arreglo. Siempre me las arreglé."

#: data/calls/story_10_cecilia.tres
msgid "Obrigada, Maria. Por tudo."
msgstr "Gracias, Maria. Por todo."

#: data/calls/story_10_generosa.tres
msgid "Boa noite. É a Generosa Prates. Desculpe, eu não sei mais pra quem ligar."
msgstr "Buenas noches. Es Generosa Prates. Perdone, ya no sé a quién llamar."

#: data/calls/story_10_generosa.tres
msgid "O Otávio ligou aí pra central? Procurando por mim, deixando recado, qualquer coisa?"
msgstr "¿Otávio llamó a la central? ¿Buscándome, dejando recado, lo que sea?"

#: data/calls/story_10_generosa.tres
msgid "Não ligou, não."
msgstr "No llamó, no."

#: data/calls/story_10_generosa.tres
msgid "Hoje não."
msgstr "Hoy no."

#: data/calls/story_10_generosa.tres
msgid "Ele foi na praça ontem. Disse que ligava depois. Na casa dele ninguém atende desde ontem."
msgstr "Ayer fue a la plaza. Dijo que llamaba después. En su casa nadie contesta desde ayer."

#: data/calls/story_10_generosa.tres
msgid "Eu ligo de novo no fim do turno. Se a senhora souber de alguma coisa..."
msgstr "Vuelvo a llamar al final del turno. Si usted se entera de algo..."

#: data/calls/story_10_generosa.tres
msgid "Vou tentar descobrir."
msgstr "Voy a intentar averiguar."

#: data/calls/story_10_generosa.tres
msgid "Ligue, sim."
msgstr "Llame, sí."

#: data/calls/story_10_generosa_volta.tres
msgid "Sou eu de novo. A Generosa. Soube de alguma coisa?"
msgstr "Soy yo otra vez. Generosa. ¿Supo algo?"

#: data/calls/story_10_generosa_volta.tres
msgid "Ele está no São Lucas, na ala 3C. Machucado, mas vivo."
msgstr "Está en el São Lucas, en el pabellón 3C. Herido, pero vivo."

#: data/calls/story_10_generosa_volta.tres
msgid "Não soube de nada."
msgstr "No supe nada."

#: data/calls/story_10_generosa_volta.tres
msgid "Ainda não."
msgstr "Todavía no."

#: data/calls/story_10_generosa_volta.tres
msgid "Vivo... Graças a Deus. Amanhã cedo eu estou na porta do hospital."
msgstr "Vivo... Gracias a Dios. Mañana temprano estoy en la puerta del hospital."

#: data/calls/story_10_generosa_volta.tres
msgid "Obrigada. A senhora nem sabe o que fez."
msgstr "Gracias. Usted no sabe lo que hizo."

#: data/calls/story_10_generosa_volta.tres
msgid "Tá. Amanhã eu procuro nos hospitais, um por um. Boa noite."
msgstr "Bueno. Mañana lo busco en los hospitales, uno por uno. Buenas noches."

#: data/calls/noite_10_cancao.tres
msgid "Dona Celeste"
msgstr "Dona Celeste"

#: data/calls/noite_10_cancao.tres data/calls/noite_15_padaria.tres
msgid "Boa noite. A Padaria Pão Dourado, por favor."
msgstr "Buenas noches. La Padaria Pão Dourado, por favor."

#: data/calls/noite_10_cancao.tres
msgid "A dona de lá é minha irmã."
msgstr "La dueña es mi hermana."

#: data/calls/noite_10_cancao.tres
msgid "A padaria, moça. Pão Dourado."
msgstr "La panadería, señorita. Pão Dourado."

#: data/calls/noite_10_cancao.tres data/calls/noite_15_padaria.tres data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Padaria Pão Dourado"
msgstr "Padaria Pão Dourado"

#: data/calls/noite_10_cancao.tres
msgid "Obrigada, moça. Que noite."
msgstr "Gracias, señorita. Qué noche."

#: data/calls/noite_10_cancao.tres
msgid "Nair? É a Celeste. Você ouviu a rádio ontem?"
msgstr "¿Nair? Soy Celeste. ¿Oíste la radio anoche?"

#: data/calls/noite_10_cancao.tres
msgid "Ouvi. A Canção da Madrugada. Fazia quinze anos."
msgstr "La oí. La Canção da Madrugada. Hacía quince años."

#: data/calls/noite_10_cancao.tres
msgid "Eu chorei na cozinha. O papai cantava essa."
msgstr "Lloré en la cocina. Papá la cantaba."

#: data/calls/noite_10_cancao.tres
msgid "Cantava baixinho, pra vizinha não ouvir."
msgstr "La cantaba bajito, para que la vecina no oyera."

#: data/calls/noite_10_cancao.tres
msgid "Será que volta a tocar?"
msgstr "¿Volverá a sonar?"

#: data/calls/noite_10_cancao.tres
msgid "Se tocar, eu deixo a janela aberta."
msgstr "Si suena, dejo la ventana abierta."

#: data/calls/noite_10_tiros.tres
msgid "Seu Hélio"
msgstr "Seu Hélio"

#: data/calls/noite_10_tiros.tres
msgid "Boa noite. A Gazeta, por favor."
msgstr "Buenas noches. La Gazeta, por favor."

#: data/calls/noite_10_tiros.tres
msgid "Quero saber os nomes dos presos da rádio."
msgstr "Quiero saber los nombres de los detenidos de la radio."

#: data/calls/noite_10_tiros.tres
msgid "A Gazeta de São Sotero."
msgstr "La Gazeta de São Sotero."

#: data/calls/noite_10_tiros.tres
msgid "Gazeta? Os três presos na rádio. Vocês sabem os nomes?"
msgstr "¿Gazeta? Los tres detenidos en la radio. ¿Saben los nombres?"

#: data/calls/noite_10_tiros.tres
msgid "A polícia não divulgou, senhor."
msgstr "La policía no los divulgó, señor."

#: data/calls/noite_10_tiros.tres
msgid "Meu sobrinho saiu de casa ontem e disse que ia ouvir música."
msgstr "Mi sobrino salió de casa ayer y dijo que iba a escuchar música."

#: data/calls/noite_10_tiros.tres
msgid "Se ele estiver entre eles, a família vai ser avisada."
msgstr "Si está entre ellos, avisarán a la familia."

#: data/calls/noite_10_tiros.tres
msgid "Avisada como? Pelo jornal?"
msgstr "¿Avisarán cómo? ¿Por el diario?"

#: data/calls/noite_10_tiros.tres
msgid "Não sei, senhor. Aqui também ninguém sabe de nada."
msgstr "No sé, señor. Aquí tampoco nadie sabe nada."

#: data/calls/noite_10_barreira.tres
msgid "Seu Ronaldo"
msgstr "Seu Ronaldo"

#: data/calls/noite_10_barreira.tres
msgid "Boa noite. O ponto de táxi da rodoviária, por favor."
msgstr "Buenas noches. La parada de taxis de la terminal, por favor."

#: data/calls/noite_10_barreira.tres
msgid "Preciso de um carro pra Capital amanhã cedo."
msgstr "Necesito un coche a la Capital mañana temprano."

#: data/calls/noite_10_barreira.tres
msgid "O ponto de táxi, moça. Um, sete, seis."
msgstr "La parada de taxis, señorita. Uno, siete, seis."

#: data/calls/noite_10_barreira.tres
msgid "Táxi? É o Ronaldo. Tem carro pra Capital amanhã às seis?"
msgstr "¿Taxi? Soy Ronaldo. ¿Hay coche a la Capital mañana a las seis?"

#: data/calls/noite_10_barreira.tres
msgid "Tem, seu Ronaldo. Mas tem barreira na saída da serra."
msgstr "Hay, don Ronaldo. Pero hay un control a la salida de la sierra."

#: data/calls/noite_10_barreira.tres
msgid "Barreira? Desde quando?"
msgstr "¿Un control? ¿Desde cuándo?"

#: data/calls/noite_10_barreira.tres
msgid "Desde a rádio. Revistam até mala de criança."
msgstr "Desde lo de la radio. Revisan hasta las maletas de los niños."

#: data/calls/noite_10_barreira.tres
msgid "Eu só vou ao médico."
msgstr "Yo solo voy al médico."

#: data/calls/noite_10_barreira.tres
msgid "Então leve o papel do médico. Sem papel, voltam todo mundo."
msgstr "Entonces lleve el papel del médico. Sin papel, mandan a todos de vuelta."

#: data/nights/night_10.tres
msgid "Rádio Serena fora do controle por três horas\nNa noite de ontem, a Rádio Serena transmitiu uma mensagem da resistência e tocou a \"Canção da Madrugada\", proibida há anos. A Alta Cúpula diz que os responsáveis já foram identificados."
msgstr "Rádio Serena fuera de control durante tres horas\nAnoche, la Rádio Serena transmitió un mensaje de la resistencia y tocó la \"Canção da Madrugada\", prohibida hace años. La Alta Cúpula dice que los responsables ya fueron identificados."

#: data/nights/night_10.tres
msgid "A torre da Rádio Serena."
msgstr "La torre de Radio Serena."

#: data/nights/night_10.tres
msgid "Polícia impede a tomada da Rádio Serena\nUm grupo armado tentou entrar na Rádio Serena AM na noite de ontem e foi recebido a tiros pela guarda. Três foram presos; os outros fugiram pelo Alto da Serra. A emissora não saiu do ar."
msgstr "La policía impide la toma de la Rádio Serena\nUn grupo armado intentó entrar en la Rádio Serena AM anoche y fue recibido a tiros por la guardia. Tres fueron detenidos; los demás huyeron por el Alto da Serra. La emisora no salió del aire."

#: data/nights/night_10.tres
msgid "A guarda na Rádio Serena, depois do tiroteio."
msgstr "La guardia en Radio Serena, tras el tiroteo."

#: data/nights/night_10.tres
msgid "Padre"
msgstr "Padre"

#: data/nights/night_10.tres
msgid "Preciso de abrigo para algumas famílias do Alto da Serra. Hoje."
msgstr "Necesito refugio para algunas familias del Alto da Serra. Hoy."

#: data/nights/night_10.tres
msgid "...Quantas forem. A porta dos fundos fica aberta até de manhã. Deus lhe pague, minha filha."
msgstr "...Las que sean. La puerta del fondo queda abierta hasta la mañana. Dios se lo pague, hija."

#: data/nights/night_10.tres data/nights/night_15.tres data/content.tres
msgid "Boa noite, então."
msgstr "Buenas noches, entonces."

#: data/nights/night_10.tres
msgid "Essa voz eu conheço. Foi você que ligou pela ala 3C, não foi?"
msgstr "Esa voz la conozco. Usted fue la que llamó por el pabellón 3C, ¿no?"

#: data/nights/night_10.tres
msgid "Tem um Otávio Almeida internado aí?"
msgstr "¿Hay un Otávio Almeida internado ahí?"

#: data/nights/night_10.tres
msgid "Otávio Almeida... Chegou ontem à noite, da praça. Está na 3C."
msgstr "Otávio Almeida... Llegó anoche, de la plaza. Está en el 3C."

#: data/nights/night_10.tres
msgid "Bastante machucado. Mas vivo. Visita de manhã."
msgstr "Bastante herido. Pero vivo. Visitas por la mañana."

#: data/nights/night_10.tres
msgid "Pode dizer a quem perguntar que ele está em boas mãos. Boa noite."
msgstr "Puede decirle a quien pregunte que está en buenas manos. Buenas noches."

#: data/nights/night_11.tres
msgid "O supervisor deixou um recado: \"A semana está longa. Paciência com quem liga.\""
msgstr "El supervisor dejó un recado: \"La semana se hace larga. Paciencia con quien llama.\""

#: data/nights/night_11.tres
msgid "Maria,\n\nEscrevo porque o telefone já não é seguro, nem o meu nem o seu.\n\nO que começamos está perto do fim. Não posso contar o que vai acontecer, e é melhor que você não saiba: o que você não sabe, ninguém tira de você.\n\nNos próximos dias vou pedir algumas coisas. Umas vão parecer estranhas. Confie e faça como eu disser, na hora que eu disser.\n\nNa última noite, às dez em ponto, ligue para a rádio e peça uma música. Qualquer uma. Eles vão entender.\n\nSeu pai teria orgulho de você.\n\nS."
msgstr "Maria,\n\nLe escribo porque el teléfono ya no es seguro, ni el mío ni el suyo.\n\nLo que empezamos está cerca del final. No puedo contarle lo que va a pasar, y es mejor que no lo sepa: lo que usted no sabe, nadie se lo puede quitar.\n\nEn los próximos días le voy a pedir algunas cosas. Algunas le van a parecer extrañas. Confíe y haga lo que le diga, cuando se lo diga.\n\nLa última noche, a las diez en punto, llame a la radio y pida una canción. Cualquiera. Ellos van a entender.\n\nSu padre estaría orgulloso de usted.\n\nS."

#: data/nights/night_11.tres
msgid "Maria,\n\nEscrevo porque o telefone já não é seguro, e você sabe disso melhor do que ninguém.\n\nTem gente de olho em você. Gente que anota cada ligação que passa pela sua mesa. Não sei mais de que lado você está, e a essa altura não importa: daqui em diante, você faz o que eu mandar, na hora que eu mandar. Sem perguntas e sem atraso.\n\nNa última noite, às dez em ponto, ligue para a rádio e peça uma música. Qualquer uma.\n\nCristóvão morreu acreditando em alguma coisa. Até agora, você não honrou o nome dele. Ainda dá tempo.\n\nS."
msgstr "Maria,\n\nLe escribo porque el teléfono ya no es seguro, y usted lo sabe mejor que nadie.\n\nHay gente vigilándola. Gente que anota cada llamada que pasa por su mesa. Ya no sé de qué lado está usted, y a estas alturas no importa: de aquí en adelante, usted hace lo que yo le mande, cuando yo se lo mande. Sin preguntas y sin demora.\n\nLa última noche, a las diez en punto, llame a la radio y pida una canción. Cualquiera.\n\nCristóvão murió creyendo en algo. Hasta ahora, usted no ha honrado su nombre. Todavía hay tiempo.\n\nS."

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Você viu o jornal, Maria? Viu?"
msgstr "¿Viste el diario, Maria? ¿Lo viste?"

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Crianças. Levaram crianças. Os filhos dos nossos, que a Cecília te pediu pra esconder."
msgstr "Niños. Se llevaron niños. Los hijos de los nuestros, los que Cecília te pidió que escondieras."

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Eu não sabia que..."
msgstr "No sabía que..."

#: data/calls/story_11_sebastiao_raiva.tres data/calls/story_16_mae_cecilia.tres
msgid "Eu não podia..."
msgstr "No podía..."

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Era uma ligação. Uma só!"
msgstr "¡Era una llamada. Una sola!"

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Eu passei a vida esperando o dia em que ninguém mais ia sumir no escuro. E agora são as crianças."
msgstr "Pasé la vida esperando el día en que nadie más desapareciera en la oscuridad. Y ahora son los niños."

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Escuta bem: se você não estiver com a gente, tudo vai desabar. Pra eles, pra mim e pra você também."
msgstr "Escucha bien: si no estás con nosotros, todo se va a derrumbar. Para ellos, para mí y para ti también."

#: data/calls/story_11_sebastiao_raiva.tres
msgid "Não me faça me arrepender de ter dito o seu nome, Maria."
msgstr "No me hagas arrepentirme de haber dicho tu nombre, Maria."

#: data/calls/noite_11_presas.tres
msgid "Dona Aparecida"
msgstr "Dona Aparecida"

#: data/calls/noite_11_presas.tres
msgid "Boa noite. A Mercearia Silva, por favor."
msgstr "Buenas noches. La Mercearia Silva, por favor."

#: data/calls/noite_11_presas.tres
msgid "Preciso avisar o seu Silva de uma coisa."
msgstr "Tengo que avisarle algo a don Silva."

#: data/calls/noite_11_presas.tres
msgid "A mercearia do Silva, moça. Dois, seis, dois."
msgstr "La tienda de Silva, señorita. Dos, seis, dos."

#: data/calls/noite_11_presas.tres data/calls/transfer_25_seu_jair_mercearia_silva.tres data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Mercearia Silva"
msgstr "Mercearia Silva"

#: data/calls/noite_11_presas.tres
msgid "Obrigada, moça. Deus nos proteja."
msgstr "Gracias, señorita. Que Dios nos proteja."

#: data/calls/noite_11_presas.tres
msgid "Silva? É a Aparecida, sua vizinha de trás."
msgstr "¿Silva? Soy Aparecida, su vecina de atrás."

#: data/calls/noite_11_presas.tres
msgid "Aparecida! Você viu? Levaram a dona Rosa e os netos."
msgstr "¡Aparecida! ¿Viste? Se llevaron a doña Rosa y a los nietos."

#: data/calls/noite_11_presas.tres
msgid "Vi da janela. O menorzinho chorando no camburão."
msgstr "Lo vi desde la ventana. El más chiquito llorando en el furgón."

#: data/calls/noite_11_presas.tres
msgid "Ela me devia o fiado do mês. Nem me importa mais."
msgstr "Me debía la cuenta del mes. Ya ni me importa."

#: data/calls/noite_11_presas.tres
msgid "Se perguntarem dela, a gente não sabe de nada."
msgstr "Si preguntan por ella, no sabemos nada."

#: data/calls/noite_11_presas.tres
msgid "Não sei de nada. Nunca soube."
msgstr "No sé nada. Nunca supe."

#: data/calls/noite_11_vazias.tres
msgid "Seu Damião"
msgstr "Seu Damião"

#: data/calls/noite_11_vazias.tres
msgid "Boa noite. O Armazém Ferreira, por favor."
msgstr "Buenas noches. El Armazém Ferreira, por favor."

#: data/calls/noite_11_vazias.tres
msgid "Sou vizinho dele, do Alto da Serra."
msgstr "Soy su vecino, del Alto da Serra."

#: data/calls/noite_11_vazias.tres
msgid "O armazém do Ferreira, moça."
msgstr "El almacén de Ferreira, señorita."

#: data/calls/noite_11_vazias.tres data/calls/transfer_13_sr_ivo_armazem_ferreira.tres data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Armazém Ferreira"
msgstr "Armazém Ferreira"

#: data/calls/noite_11_vazias.tres
msgid "Ferreira? É o Damião. A polícia acabou de sair da minha rua."
msgstr "¿Ferreira? Soy Damião. La policía acaba de irse de mi calle."

#: data/calls/noite_11_vazias.tres
msgid "Eu vi as viaturas. Levaram alguém?"
msgstr "Vi las patrullas. ¿Se llevaron a alguien?"

#: data/calls/noite_11_vazias.tres
msgid "Ninguém. As casas estavam vazias. Nem o cachorro ficou."
msgstr "A nadie. Las casas estaban vacías. Ni el perro quedó."

#: data/calls/noite_11_vazias.tres
msgid "Graças a Deus. Alguém avisou a tempo."
msgstr "Gracias a Dios. Alguien avisó a tiempo."

#: data/calls/noite_11_vazias.tres
msgid "Não fala isso no telefone, Ferreira."
msgstr "No digas eso por teléfono, Ferreira."

#: data/calls/noite_11_vazias.tres
msgid "Falei nada. Boa noite, Damião."
msgstr "No dije nada. Buenas noches, Damião."

#: data/calls/noite_11_parente.tres
msgid "Dona Zulmira"
msgstr "Dona Zulmira"

#: data/calls/noite_11_parente.tres
msgid "Levaram os meus netos."
msgstr "Se llevaron a mis nietos."

#: data/calls/noite_11_parente.tres
msgid "A casa do padre, minha filha."
msgstr "La casa del cura, hija."

#: data/calls/noite_11_parente.tres
msgid "Padre, é a Zulmira. Levaram minha filha e os dois meninos."
msgstr "Padre, soy Zulmira. Se llevaron a mi hija y a los dos chicos."

#: data/calls/noite_11_parente.tres
msgid "Eu soube, Zulmira. Estou rezando por vocês."
msgstr "Lo supe, Zulmira. Estoy rezando por ustedes."

#: data/calls/noite_11_parente.tres
msgid "Reza não basta, padre. Pra onde levam criança?"
msgstr "Rezar no basta, padre. ¿Adónde se llevan a los niños?"

#: data/calls/noite_11_parente.tres
msgid "Dizem que para o abrigo do Estado, na Capital."
msgstr "Dicen que al albergue del Estado, en la Capital."

#: data/calls/noite_11_parente.tres
msgid "Eu tenho a certidão deles. Eu sou a avó!"
msgstr "¡Tengo sus partidas de nacimiento! ¡Soy la abuela!"

#: data/calls/noite_11_parente.tres
msgid "Venha amanhã cedo. Eu escrevo ao bispo."
msgstr "Venga mañana temprano. Le escribo al obispo."

#: data/nights/night_11.tres
msgid "Famílias inteiras presas no Alto da Serra\nEntre os detidos na batida de ontem há mulheres, idosos e crianças. A polícia diz que são parentes de rebeldes e que \"ninguém está acima da lei\"."
msgstr "Familias enteras detenidas en el Alto da Serra\nEntre los detenidos en la redada de ayer hay mujeres, ancianos y niños. La policía dice que son parientes de rebeldes y que \"nadie está por encima de la ley\"."

#: data/nights/night_11.tres
msgid "O camburão na subida do Alto da Serra."
msgstr "El furgón policial en la subida al Alto da Serra."

#: data/nights/night_11.tres
msgid "Batida no Alto da Serra encontra casas vazias\nAs famílias procuradas pela polícia tinham deixado as casas horas antes. A paróquia nega ter dado abrigo a quem quer que seja."
msgstr "Redada en el Alto da Serra encuentra casas vacías\nLas familias buscadas por la policía habían dejado las casas horas antes. La parroquia niega haber dado refugio a nadie."

#: data/nights/night_11.tres
msgid "As casas do Alto da Serra, de portas fechadas."
msgstr "Las casas del Alto da Serra, con las puertas cerradas."

#: data/nights/night_12.tres
msgid "O supervisor deixou um recado: \"Não esqueça: tudo o que acontece vai para a ficha.\""
msgstr "El supervisor dejó un recado: \"No olvide: todo lo que pasa va a la ficha.\""

#: data/calls/story_12_sebastiao.tres
msgid "Maria. Sebastião. Eu sei o que escrevi: o telefone não é seguro. Por isso, presta atenção, que hoje não dá pra repetir."
msgstr "Maria. Sebastião. Sé lo que escribí: el teléfono no es seguro. Por eso, presta atención, que hoy no puedo repetirlo."

#: data/calls/story_12_sebastiao.tres
msgid "Eles estão na sua cola. Sabem que tem alguém nessa mesa ajudando a gente."
msgstr "Te están siguiendo. Saben que alguien en esa mesa nos está ayudando."

#: data/calls/story_12_sebastiao.tres
msgid "Hoje a polícia vai falar com a Alta Cúpula pela sua mesa. Grave essas conversas. Todas."
msgstr "Hoy la policía va a hablar con la Alta Cúpula por tu mesa. Graba esas conversaciones. Todas."

#: data/calls/story_12_sebastiao.tres
msgid "E o que eu faço com as fitas?"
msgstr "¿Y qué hago con las cintas?"

#: data/calls/story_12_sebastiao.tres
msgid "Isso é perigoso demais."
msgstr "Esto es demasiado peligroso."

#: data/calls/story_12_sebastiao.tres
msgid "Eu sei que é perigoso. Por isso só você pode fazer."
msgstr "Sé que es peligroso. Por eso solo tú puedes hacerlo."

#: data/calls/story_12_sebastiao.tres
msgid "No fim do turno, mande pra mim, no pacote de carta. Pra eles, nada."
msgstr "Al final del turno, mándamelas en el paquete de carta. Para ellos, nada."

#: data/calls/story_12_sebastiao.tres
msgid "Boa noite, Maria."
msgstr "Buenas noches, Maria."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Investigador"
msgstr "Investigador"

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "A Alta Cúpula, por favor."
msgstr "La Alta Cúpula, por favor."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Vilela, da investigação. É sobre a central da [place:Vila Serena]."
msgstr "Vilela, de la investigación. Es sobre la central de [place:Vila Serena]."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "A telefonista?"
msgstr "¿La telefonista?"

#: data/calls/story_12_cupula_telefonista.tres
msgid "Ela mesma. Metade dos recados deles passa por aquela mesa. Alguém ajuda eles por dentro."
msgstr "Ella misma. La mitad de sus recados pasa por esa mesa. Alguien los ayuda desde dentro."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Então vigiem. Mas sem pressa: quero saber pra quem ela trabalha."
msgstr "Entonces vigílenla. Pero sin prisa: quiero saber para quién trabaja."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Ponho um homem no [place:prédio de tijolos], em frente."
msgstr "Pongo un hombre en el [place:edificio de ladrillos], enfrente."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Nestor Vilela, da investigação."
msgstr "Nestor Vilela, de investigaciones."

#: data/calls/story_12_cupula_telefonista.tres data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Autorização {code}."
msgstr "Autorización {code}."

#: data/calls/story_12_cupula_telefonista_denuncia.tres data/calls/story_12_cupula_telefonista_homem.tres
msgid "Ela mesma. Metade dos recados deles passa por aquela mesa."
msgstr "Ella misma. La mitad de sus recados pasa por esa mesa."

#: data/calls/story_12_cupula_telefonista_denuncia.tres
msgid "Não foi ela que denunciou o [place:Bar do Zé]?"
msgstr "¿No fue ella la que denunció el [place:Bar do Zé]?"

#: data/calls/story_12_cupula_telefonista_denuncia.tres
msgid "Foi. Ou ela é ingênua, ou está jogando dos dois lados."
msgstr "Fue ella. O es ingenua, o está jugando a dos bandas."

#: data/calls/story_12_cupula_telefonista_homem.tres
msgid "Não foi ela que denunciou o [place:Bar do Zé]? E um homem que ligava pelo nome dela?"
msgstr "¿No fue ella la que denunció el [place:Bar do Zé]? ¿Y a un hombre que llamaba preguntando por su nombre?"

#: data/calls/story_12_cupula_telefonista_homem.tres
msgid "Foi. Um homem que ninguém achou até hoje. Ou ela é ingênua, ou está jogando dos dois lados."
msgstr "Fue ella. Un hombre que nadie encontró hasta hoy. O es ingenua, o está jugando a dos bandas."

#: data/calls/story_12_cupula_ronda.tres
msgid "A Alta Cúpula. É da polícia."
msgstr "La Alta Cúpula. Es la policía."

#: data/calls/story_12_cupula_ronda.tres
msgid "Bastos. O toque de recolher continua?"
msgstr "Bastos. ¿Sigue el toque de queda?"

#: data/calls/story_12_cupula_ronda.tres
msgid "Continua. E dobrem a ronda na [street:Avenida Brasil]."
msgstr "Sigue. Y doblen la ronda en la [street:Avenida Brasil]."

#: data/calls/story_12_cupula_ronda.tres
msgid "E o [place:Hotel Serena]?"
msgstr "¿Y el [place:Hotel Serena]?"

#: data/calls/story_12_cupula_ronda.tres
msgid "Deixem quieto mais uns dias. Quero ver quem entra."
msgstr "Déjenlo tranquilo unos días más. Quiero ver quién entra."

#: data/calls/story_12_supervisor.tres
msgid "Supervisor"
msgstr "Supervisor"

#: data/calls/story_12_supervisor.tres
msgid "Maria? É o supervisor. Não vou tomar o seu tempo."
msgstr "¿Maria? Es el supervisor. No le voy a quitar tiempo."

#: data/calls/story_12_supervisor.tres
msgid "Chegou uma reclamação da Alta Cúpula. Três noites atrás, ligações deles para a delegacia e para a Cúpula não passaram pela sua mesa."
msgstr "Llegó una queja de la Alta Cúpula. Hace tres noches, sus llamadas a la comisaría y a la Cúpula no pasaron por su mesa."

#: data/calls/story_12_supervisor.tres
msgid "Ligação das autoridades passa na frente de qualquer uma. Isso vai para a sua ficha."
msgstr "Una llamada de las autoridades va antes que cualquier otra. Esto va a su legajo."

#: data/calls/story_12_supervisor.tres
msgid "E eu vou ficar de olho em você. Boa noite, Maria."
msgstr "Y la voy a tener vigilada. Buenas noches, Maria."

#: data/calls/story_12_miguel.tres
msgid "Maria? É o Miguel. Fala baixinho, tô ligando escondido."
msgstr "¿Maria? Es Miguel. Hable bajito, estoy llamando a escondidas."

#: data/calls/story_12_miguel.tres
msgid "Moça da central? É o Miguel. Fala baixinho, tô ligando escondido."
msgstr "¿Señorita de la central? Es Miguel. Hable bajito, estoy llamando a escondidas."

#: data/calls/story_12_miguel.tres
msgid "Tô no hospital. No São Lucas."
msgstr "Estoy en el hospital. En el São Lucas."

#: data/calls/story_12_miguel.tres
msgid "No hospital? O que aconteceu?"
msgstr "¿En el hospital? ¿Qué pasó?"

#: data/calls/story_12_miguel.tres
msgid "Miguel, você não devia estar no telefone."
msgstr "Miguel, no deberías estar en el teléfono."

#: data/calls/story_12_miguel.tres
msgid "A mãe me deixou de castigo, sem telefone, por isso eu não liguei mais. Mas naquela noite da coisa grande eu fugi pela janela e segui o meu irmão."
msgstr "Mamá me dejó castigado, sin teléfono, por eso no llamé más. Pero la noche de la cosa grande me escapé por la ventana y seguí a mi hermano."

#: data/calls/story_12_miguel.tres
msgid "Tinha um monte de gente na praça, gritaria, e aí veio um carro correndo e... pum."
msgstr "Había un montón de gente en la plaza, gritos, y entonces vino un auto a toda velocidad y... ¡pum!"

#: data/calls/story_12_miguel.tres
msgid "Quebrei a perna! Tô de gesso até aqui. Já assinaram o médico, a enfermeira e o moço da cama do lado."
msgstr "¡Me rompí la pierna! Tengo yeso hasta aquí. Ya me lo firmaron el médico, la enfermera y el muchacho de la cama de al lado."

#: data/calls/story_12_miguel.tres
msgid "Eu assino também. Prometo."
msgstr "Yo también lo firmo. Lo prometo."

#: data/calls/story_12_miguel.tres
msgid "Que susto, Miguel."
msgstr "Qué susto, Miguel."

#: data/calls/story_12_miguel.tres
msgid "Jura? Vou guardar um lugar bem grande. Do lado do joelho."
msgstr "¿Lo jura? Le guardo un lugar bien grande. Al lado de la rodilla."

#: data/calls/story_12_miguel.tres
msgid "Ih, a enfermeira! Tchau!"
msgstr "¡Uy, la enfermera! ¡Chau!"

#: data/calls/story_12_miguel.tres
msgid "É que eu machuquei a perna. Foi um carro."
msgstr "Es que me lastimé la pierna. Fue un auto."

#: data/calls/story_12_miguel.tres
msgid "Ih, a enfermeira. Tchau."
msgstr "Uy, la enfermera. Chau."

#: data/calls/story_12_generosa_radio.tres
msgid "Boa noite. A Rádio Serena, por favor."
msgstr "Buenas noches. La Rádio Serena, por favor."

#: data/calls/story_12_generosa_radio.tres
msgid "Fui ver o Otávio no São Lucas. Ele está muito mal, quase não fala."
msgstr "Fui a ver a Otávio al São Lucas. Está muy mal, casi no habla."

#: data/calls/story_12_generosa_radio.tres
msgid "Quero oferecer uma música pra ele."
msgstr "Quiero dedicarle una canción."

#: data/calls/story_12_generosa_radio.tres
msgid "A Rádio Serena, por favor."
msgstr "La Rádio Serena, por favor."

#: data/calls/story_12_generosa_radio.tres
msgid "Boa noite. Quero oferecer [other:Luar da Serra] pro [person:Otávio], na ala 3C do [place:São Lucas]."
msgstr "Buenas noches. Quiero dedicarle [other:Luar da Serra] a [person:Otávio], en el pabellón 3C del [place:São Lucas]."

#: data/calls/story_12_generosa_radio.tres
msgid "Quem oferece?"
msgstr "¿De parte de quién?"

#: data/calls/story_12_generosa_radio.tres
msgid "A moça de fita amarela. Ele sabe."
msgstr "La muchacha de la cinta amarilla. Él sabe."

#: data/calls/story_12_generosa_radio.tres
msgid "Vai ao ar depois do noticiário, moça. Melhoras pra ele."
msgstr "Sale al aire después del noticiero, señorita. Que se mejore."

#: data/calls/noite_12_recompensa.tres
msgid "Seu Gilberto"
msgstr "Seu Gilberto"

#: data/calls/noite_12_recompensa.tres
msgid "Quero saber se tem mesa livre amanhã."
msgstr "Quiero saber si hay mesa libre mañana."

#: data/calls/noite_12_recompensa.tres
msgid "O bilhar do Tonho, moça."
msgstr "El billar de Tonho, señorita."

#: data/calls/noite_12_recompensa.tres
msgid "Tonho? É o Gilberto. Viu a recompensa no jornal?"
msgstr "¿Tonho? Soy Gilberto. ¿Viste la recompensa en el diario?"

#: data/calls/noite_12_recompensa.tres
msgid "Vi. Dinheiro pra comprar uma casa."
msgstr "La vi. Plata para comprar una casa."

#: data/calls/noite_12_recompensa.tres
msgid "Tem gente aqui que entrega a mãe por menos."
msgstr "Hay gente aquí que entrega a la madre por menos."

#: data/calls/noite_12_recompensa.tres
msgid "Por isso eu não conheço ninguém. Nem você, Gilberto."
msgstr "Por eso no conozco a nadie. Ni a ti, Gilberto."

#: data/calls/noite_12_recompensa.tres
msgid "Nem eu me conheço, Tonho. Guarda a mesa das oito?"
msgstr "Ni yo me conozco, Tonho. ¿Me guardas la mesa de las ocho?"

#: data/calls/noite_12_recompensa.tres
msgid "Guardo. Mas às oito e meia eu fecho, por causa do toque."
msgstr "Te la guardo. Pero a las ocho y media cierro, por el toque de queda."

#: data/calls/noite_12_parente.tres
msgid "Dona Helena"
msgstr "Dona Helena"

#: data/calls/noite_12_parente.tres
msgid "Boa noite. Me liga com a Sônia Vieira? É minha irmã."
msgstr "Buenas noches. ¿Me comunica con Sônia Vieira? Es mi hermana."

#: data/calls/noite_12_parente.tres
msgid "Dois, três, sete."
msgstr "Dos, tres, siete."

#: data/calls/noite_12_parente.tres
msgid "Sônia Vieira, moça. Minha irmã."
msgstr "Sônia Vieira, señorita. Mi hermana."

#: data/calls/noite_12_parente.tres data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Sônia Vieira"
msgstr "Sônia Vieira"

#: data/calls/noite_12_parente.tres
msgid "Sônia? É a Helena. Fica com as crianças amanhã?"
msgstr "¿Sônia? Soy Helena. ¿Te quedas con los chicos mañana?"

#: data/calls/noite_12_parente.tres
msgid "Fico. Você vai pra Capital?"
msgstr "Me quedo. ¿Vas a la Capital?"

#: data/calls/noite_12_parente.tres
msgid "Vou. Dizem que levaram o Artur pro quartel de lá."
msgstr "Voy. Dicen que llevaron a Artur al cuartel de allá."

#: data/calls/noite_12_parente.tres
msgid "Quem disse?"
msgstr "¿Quién dijo?"

#: data/calls/noite_12_parente.tres
msgid "Uma mulher na fila da delegacia. Ela também procura o marido."
msgstr "Una mujer en la fila de la comisaría. Ella también busca al marido."

#: data/calls/noite_12_parente.tres
msgid "Vai com Deus. E não fala o nome dele em voz alta."
msgstr "Ve con Dios. Y no digas su nombre en voz alta."

#: data/calls/noite_12_doutor.tres
msgid "Boa noite. O Dr. Augusto Almeida, por favor."
msgstr "Buenas noches. El Dr. Augusto Almeida, por favor."

#: data/calls/noite_12_doutor.tres
msgid "A minha mulher está com febre desde ontem."
msgstr "Mi mujer tiene fiebre desde ayer."

#: data/calls/noite_12_doutor.tres
msgid "O Dr. Augusto Almeida."
msgstr "El Dr. Augusto Almeida."

#: data/calls/noite_12_doutor.tres data/calls/transfer_11_morador_dr_augusto_almeida.tres data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Dr. Augusto Almeida"
msgstr "Dr. Augusto Almeida"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Moça! Tá saindo fumaça da casa do vizinho! Fogo na janela da cozinha!"
msgstr "¡Señorita! ¡Sale humo de la casa del vecino! ¡Fuego en la ventana de la cocina!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Tem gente lá dentro?"
msgstr "¿Hay gente adentro?"

#: data/calls/noite_12_doutor_fogo.tres
msgid "O fogo está passando para outras casas?"
msgstr "¿El fuego está pasando a otras casas?"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Rua do Cruzeiro, 260! A casa do lado da minha!"
msgstr "¡Rua do Cruzeiro, 260! ¡La casa de al lado de la mía!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "A vizinha já saiu com as crianças, tão aqui na rua comigo."
msgstr "La vecina ya salió con los niños, están aquí en la calle conmigo."

#: data/calls/noite_12_doutor_fogo.tres
msgid "Ainda não, é só na cozinha dela. Mas tá subindo!"
msgstr "Todavía no, es solo su cocina. ¡Pero está subiendo!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Os bombeiros chegaram. Moça, deixa o doutor pra depois, a febre da minha mulher espera. Vou ajudar com os baldes!"
msgstr "Llegaron los bomberos. Señorita, el doctor puede esperar, la fiebre de mi mujer también. ¡Voy a ayudar con los baldes!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "O fogo pegou no telhado! Tá caindo telha!"
msgstr "¡El fuego agarró el techo! ¡Se caen las tejas!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Alguém voltou para dentro?"
msgstr "¿Alguien volvió a entrar?"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Não, tá todo mundo aqui fora. Graças a Deus."
msgstr "No, están todos aquí afuera. Gracias a Dios."

#: data/calls/noite_12_doutor_fogo.tres
msgid "A vizinha tá passando mal com a fumaça, não para de tossir!"
msgstr "¡La vecina se siente mal por el humo, no para de toser!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Ela consegue respirar?"
msgstr "¿Puede respirar?"

#: data/calls/noite_12_doutor_fogo.tres
msgid "Mal e mal... tá sentada no meio-fio, sem ar!"
msgstr "Apenas... ¡está sentada en el cordón, sin aire!"

#: data/calls/noite_12_doutor_fogo.tres
msgid "A casa caiu, moça. Não sobrou nada."
msgstr "La casa se vino abajo, señorita. No quedó nada."

#: data/calls/noite_12_doutor_fogo.tres
msgid "A vizinha desmaiou com a fumaça! Precisa de ambulância!"
msgstr "¡La vecina se desmayó por el humo! ¡Necesita una ambulancia!"

#: data/nights/night_12.tres
msgid "Cartazes da recompensa na estação."
msgstr "Carteles de la recompensa en la estación."

#: data/nights/night_12.tres
msgid "Alta Cúpula oferece recompensa pelo chefe dos rebeldes\nQuem der notícia do paradeiro do homem que a polícia chama de \"o comandante\" recebe recompensa em dinheiro e proteção. A Alta Cúpula garante sigilo a quem colaborar."
msgstr "La Alta Cúpula ofrece recompensa por el jefe rebelde\nQuien dé noticia del paradero del hombre al que la policía llama \"el comandante\" recibirá una recompensa en dinero y protección. La Alta Cúpula garantiza el secreto a quien colabore."

#: data/nights/night_13.tres
msgid "O supervisor deixou um recado: \"Recebemos uma notícia triste: a Cecília, telefonista do Alto da Serra, faleceu de um mal súbito. Não temos mais detalhes. Por segurança, há policiais no prédio esta noite, para a sua proteção. Não abra a porta para ninguém e siga trabalhando normalmente.\""
msgstr "El supervisor dejó una nota: \"Recibimos una triste noticia: Cecília, la telefonista del Alto da Serra, falleció de un mal súbito. No tenemos más detalles. Por seguridad, hay policías en el edificio esta noche, para su protección. No le abra la puerta a nadie y siga trabajando con normalidad.\""

#: data/calls/noite_13_cecilia.tres
msgid "Dona Ruth"
msgstr "Dona Ruth"

#: data/calls/noite_13_cecilia.tres
msgid "Boa noite. A Laudelina Prado, por favor. Dois, oito, zero."
msgstr "Buenas noches. Laudelina Prado, por favor. Dos, ocho, cero."

#: data/calls/noite_13_cecilia.tres
msgid "Ela não vai acreditar no que eu li."
msgstr "No va a creer lo que leí."

#: data/calls/noite_13_cecilia.tres
msgid "Laudelina Prado, moça."
msgstr "Laudelina Prado, señorita."

#: data/calls/noite_13_cecilia.tres data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado"
msgstr "Laudelina Prado"

#: data/calls/noite_13_cecilia.tres
msgid "Obrigada, moça. Se cuide você também."
msgstr "Gracias, señorita. Cuídese usted también."

#: data/calls/noite_13_cecilia.tres
msgid "Laudelina? Você leu? A Cecília da central morreu."
msgstr "¿Laudelina? ¿Leíste? Murió Cecília, la de la central."

#: data/calls/noite_13_cecilia.tres
msgid "Li. Mal súbito, diz o jornal. Ela subia a serra a pé toda semana."
msgstr "Lo leí. Algo repentino, dice el diario. Subía la sierra a pie cada semana."

#: data/calls/noite_13_cecilia.tres
msgid "Trinta anos atendendo a gente. Sabia a voz de cada um."
msgstr "Treinta años atendiéndonos. Conocía la voz de cada uno."

#: data/calls/noite_13_cecilia.tres
msgid "Agora vão ouvir as telefonistas, dizem. Por causa de vazamento."
msgstr "Ahora van a interrogar a las operadoras, dicen. Por una filtración."

#: data/calls/noite_13_cecilia.tres
msgid "Vazamento de quê?"
msgstr "¿Filtración de qué?"

#: data/calls/noite_13_cecilia.tres
msgid "Não sei. E acho melhor a gente desligar."
msgstr "No sé. Y creo que mejor cortamos."

#: data/calls/noite_13_enterro.tres
msgid "Seu Moacir"
msgstr "Seu Moacir"

#: data/calls/noite_13_enterro.tres
msgid "Boa noite. A Funerária Paz Eterna, por favor."
msgstr "Buenas noches. La Funerária Paz Eterna, por favor."

#: data/calls/noite_13_enterro.tres
msgid "Quero saber a hora do enterro da telefonista."
msgstr "Quiero saber la hora del entierro de la operadora."

#: data/calls/noite_13_enterro.tres
msgid "A funerária, moça. Paz Eterna."
msgstr "La funeraria, señorita. Paz Eterna."

#: data/calls/noite_13_enterro.tres data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Funerária Paz Eterna"
msgstr "Funerária Paz Eterna"

#: data/calls/noite_13_enterro.tres
msgid "Obrigado, moça. Meus sentimentos. Ela era das suas."
msgstr "Gracias, señorita. Mi más sentido pésame. Era de las suyas."

#: data/calls/noite_13_enterro.tres
msgid "Paz Eterna? O enterro da dona Cecília é a que horas?"
msgstr "¿Paz Eterna? ¿A qué hora es el entierro de doña Cecília?"

#: data/calls/noite_13_enterro.tres
msgid "Às dez, no municipal. Mas o caixão vem fechado, senhor."
msgstr "A las diez, en el municipal. Pero el ataúd viene cerrado, señor."

#: data/calls/noite_13_enterro.tres
msgid "Fechado? Por quê?"
msgstr "¿Cerrado? ¿Por qué?"

#: data/calls/noite_13_enterro.tres
msgid "Ordem da família. Foi o que nos disseram."
msgstr "Orden de la familia. Eso nos dijeron."

#: data/calls/noite_13_enterro.tres
msgid "Ela não tinha família. Só a central."
msgstr "Ella no tenía familia. Solo la central."

#: data/calls/noite_13_enterro.tres
msgid "Então foi ordem de quem tem. Boa noite, senhor."
msgstr "Entonces fue orden de quien sí tiene. Buenas noches, señor."

#: data/calls/noite_13_parente.tres
msgid "Seu Wagner"
msgstr "Seu Wagner"

#: data/calls/noite_13_parente.tres
msgid "Boa noite. O Posto São Cristóvão, por favor."
msgstr "Buenas noches. El Posto São Cristóvão, por favor."

#: data/calls/noite_13_parente.tres
msgid "O da estrada da serra."
msgstr "El de la ruta de la sierra."

#: data/calls/noite_13_parente.tres
msgid "O posto da estrada, moça. Três, quatro, sete."
msgstr "La estación de servicio de la ruta, señorita. Tres, cuatro, siete."

#: data/calls/noite_13_parente.tres data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Posto São Cristóvão"
msgstr "Posto São Cristóvão"

#: data/calls/noite_13_parente.tres
msgid "Posto? É o Wagner. O caminhão do meu irmão ainda está aí?"
msgstr "¿Estación? Soy Wagner. ¿El camión de mi hermano sigue ahí?"

#: data/calls/noite_13_parente.tres
msgid "Está, parado no pátio desde ontem. Ninguém veio buscar."
msgstr "Sí, parado en el patio desde ayer. Nadie vino a buscarlo."

#: data/calls/noite_13_parente.tres
msgid "E ele? O Marcos?"
msgstr "¿Y él? ¿Marcos?"

#: data/calls/noite_13_parente.tres
msgid "A polícia parou o caminhão aqui. Levaram ele na viatura."
msgstr "La policía paró el camión aquí. Se lo llevaron en la patrulla."

#: data/calls/noite_13_parente.tres data/calls/story_15_cupula_armazem.tres data/calls/story_15_cupula_armazem_armas.tres
msgid "Pra onde?"
msgstr "¿Hacia dónde?"

#: data/calls/noite_13_parente.tres
msgid "Não disseram. Venha buscar o caminhão de dia, rapaz."
msgstr "No dijeron. Venga a buscar el camión de día, muchacho."

#: data/nights/night_13.tres
msgid "Cecília, telefonista do Alto da Serra."
msgstr "Cecília, telefonista del Alto da Serra."

#: data/nights/night_13.tres
msgid "Alta Cúpula investiga vazamento nas centrais telefônicas\nSegundo a Alta Cúpula, informações de ligações da polícia chegaram aos rebeldes \"por dentro das centrais\". As telefonistas serão ouvidas. A Companhia Telefônica diz confiar nas suas funcionárias."
msgstr "La Alta Cúpula investiga una filtración en las centrales telefónicas\nSegún la Alta Cúpula, información de llamadas de la policía llegó a los rebeldes \"desde dentro de las centrales\". Las operadoras serán interrogadas. La Compañía Telefónica dice confiar en sus empleadas."

#: data/nights/night_13.tres
msgid "Falecimentos\nCecília, telefonista da central do Alto da Serra por trinta anos, morreu ontem de mal súbito. O sepultamento será às dez horas, no cemitério municipal."
msgstr "Fallecimientos\nCecília, operadora de la central del Alto da Serra durante treinta años, murió ayer de forma repentina. El sepelio será a las diez, en el cementerio municipal."

#: data/nights/night_14.tres
msgid "O supervisor deixou um recado: \"Pedido das autoridades para hoje: grave toda conversa suspeita do bar e do hotel. As linhas da Rádio Serena e da TV Orbital estão bloqueadas, não transfira nada para elas. Amanhã é sua última noite deste período. Capriche.\""
msgstr "El supervisor dejó una nota: \"Pedido de las autoridades para hoy: graba toda conversación sospechosa del bar y del hotel. Las líneas de Rádio Serena y de TV Orbital están bloqueadas, no transfieras nada a ellas. Mañana es tu última noche de este período. Esmérate.\""

#: data/calls/story_14_sebastiao.tres
msgid "Maria. Sou eu, Sebastião. Não posso demorar."
msgstr "Maria. Soy yo, Sebastião. No puedo tardar."

#: data/calls/story_14_sebastiao.tres
msgid "Você soube da Cecília. O que te contaram é mentira."
msgstr "Te enteraste de lo de Cecília. Lo que te contaron es mentira."

#: data/calls/story_14_sebastiao.tres
msgid "Ela não morreu de doença nenhuma. Pegaram ela na estrada, e ela não abriu a boca. Nem pra dizer o seu nome."
msgstr "No murió de ninguna enfermedad. La agarraron en la carretera, y no abrió la boca. Ni para decir tu nombre."

#: data/calls/story_14_sebastiao.tres
msgid "Os policiais no seu prédio não estão lá pra te proteger. Mas tem gente nossa de olho em você também. Você não está sozinha."
msgstr "Los policías de tu edificio no están ahí para protegerte. Pero también hay gente nuestra cuidándote. No estás sola."

#: data/calls/story_14_sebastiao.tres
msgid "Amanhã é o dia. Hoje eu só preciso que você aguente firme."
msgstr "Mañana es el día. Hoy solo necesito que aguantes firme."

#: data/calls/story_14_sebastiao.tres
msgid "Estou ouvindo."
msgstr "Te escucho."

#: data/calls/story_14_sebastiao.tres
msgid "O que você precisa?"
msgstr "¿Qué necesitas?"

#: data/calls/story_14_sebastiao.tres
msgid "Eles vão querer fita do bar e do hotel. Mande uma fita qualquer, pra não levantar suspeita. Essas conversas, não."
msgstr "Van a querer cintas del bar y del hotel. Mándales una cinta cualquiera, para no levantar sospechas. Esas conversaciones, no."

#: data/calls/story_14_sebastiao.tres
msgid "E se me pegarem?"
msgstr "¿Y si me atrapan?"

#: data/calls/story_14_sebastiao.tres
msgid "Ninguém pega quem faz tudo direito. Mais uma noite, Maria, e acaba."
msgstr "Nadie atrapa a quien hace todo bien. Una noche más, Maria, y se acaba."

#: data/calls/story_14_sebastiao.tres
msgid "Eu sei que posso contar com você."
msgstr "Sé que puedo contar contigo."

#: data/calls/story_14_sebastiao.tres
msgid "Até amanhã. Cuide-se."
msgstr "Hasta mañana. Cuídate."

#: data/calls/story_14_policia_aeroporto.tres
msgid "Boa noite. A delegacia, por favor. É da polícia."
msgstr "Buenas noches. La comisaría, por favor. Es de la policía."

#: data/calls/story_14_policia_aeroporto.tres
msgid "A delegacia. O plantão."
msgstr "La comisaría. La guardia."

#: data/calls/story_14_policia_aeroporto.tres
msgid "Boa noite. Aqui é o Rubens, que faz ronda no posto da rodoviária."
msgstr "Buenas noches. Aquí Rubens, el que hace la ronda en el puesto de la terminal de autobuses."

#: data/calls/story_14_policia_aeroporto.tres
msgid "Fala, Rubens. Alguma novidade?"
msgstr "Habla, Rubens. ¿Alguna novedad?"

#: data/calls/story_14_policia_aeroporto.tres
msgid "Movimento estranho. Dois homens compraram passagem pra [place:Capital] e não embarcaram. Ficaram olhando o pátio."
msgstr "Movimiento raro. Dos hombres compraron boleto para la [place:Capital] y no subieron. Se quedaron mirando el patio."

#: data/calls/story_14_policia_aeroporto.tres
msgid "É gente deles. Estão vendo por onde a gente sai."
msgstr "Es gente de ellos. Están viendo por dónde salimos."

#: data/calls/story_14_policia_aeroporto.tres
msgid "O que eu faço?"
msgstr "¿Qué hago?"

#: data/calls/story_14_policia_aeroporto.tres
msgid "A [place:ferrovia] fecha às [time:nove]. Nenhum trem sai depois disso."
msgstr "El [place:ferrocarril] cierra a las [time:nueve]. Ningún tren sale después de eso."

#: data/calls/story_14_policia_aeroporto.tres
msgid "E o aeroporto?"
msgstr "¿Y el aeropuerto?"

#: data/calls/story_14_policia_aeroporto.tres
msgid "O [place:aeroporto] a gente cerca à [time:meia-noite]. Duas viaturas na [street:Avenida Brasil], na saída da cidade."
msgstr "El [place:aeropuerto] lo cercamos a [time:medianoche]. Dos patrullas en la [street:Avenida Brasil], a la salida de la ciudad."

#: data/calls/story_14_policia_aeroporto.tres
msgid "Entendido. Fico de olho nos dois."
msgstr "Entendido. No les quito el ojo a esos dos."

#: data/calls/story_14_bar.tres
msgid "Zé? É o Davi. Tudo certo pra amanhã?"
msgstr "¿Zé? Es Davi. ¿Todo listo para mañana?"

#: data/calls/story_14_bar.tres
msgid "Fala baixo, rapaz. Tem gente ouvindo tudo."
msgstr "Habla bajo, muchacho. Hay gente escuchando todo."

#: data/calls/story_14_bar.tres
msgid "Só quero saber se o [other:material] chegou."
msgstr "Solo quiero saber si llegó el [other:material]."

#: data/calls/story_14_bar.tres
msgid "Chegou. Está no fundo, embaixo das caixas de [other:cerveja]."
msgstr "Llegó. Está al fondo, debajo de las cajas de [other:cerveza]."

#: data/calls/story_14_bar.tres
msgid "E a gente se encontra onde?"
msgstr "¿Y dónde nos encontramos?"

#: data/calls/story_14_bar.tres
msgid "Na [street:Rua das Acácias], às [time:oito]. Agora desliga."
msgstr "En la [street:Rua das Acácias], a las [time:ocho]. Ahora cuelga."

#: data/calls/story_14_radio.tres
msgid "A Rádio Serena, por favor. Quero mandar um recado pro programa da noite."
msgstr "La Rádio Serena, por favor. Quiero mandar un recado al programa de la noche."

#: data/calls/story_14_radio.tres data/calls/story_15_radio.tres
msgid "Valter Nunes."
msgstr "Valter Nunes."

#: data/calls/story_14_radio.tres
msgid "Bloqueada? Até a rádio agora? Tá bom, tá bom."
msgstr "¿Bloqueada? ¿Hasta la radio ahora? Está bien, está bien."

#: data/calls/story_14_policia_hotel.tres
msgid "A delegacia, por favor. Polícia."
msgstr "La comisaría, por favor. Policía."

#: data/calls/story_14_policia_hotel.tres
msgid "A delegacia."
msgstr "La comisaría."

#: data/calls/story_14_policia_hotel.tres
msgid "Plantão? Aqui é o Bastos. Estou na porta do hotel."
msgstr "¿Guardia? Aquí Bastos. Estoy en la puerta del hotel."

#: data/calls/story_14_policia_hotel.tres
msgid "E aí, Bastos? Fecharam?"
msgstr "¿Y, Bastos? ¿Lo cerraron?"

#: data/calls/story_14_policia_hotel.tres
msgid "Lacrado desde as [time:cinco]. Mandamos todo mundo embora. Ficou só o [person:vigia] pra atender o telefone."
msgstr "Sellado desde las [time:cinco]. Mandamos a todos afuera. Solo quedó el [person:vigilante] para atender el teléfono."

#: data/calls/story_14_policia_hotel.tres
msgid "Deixa ele lá. Quem ligar pro [place:Hotel Serena] hoje, a gente quer saber quem é."
msgstr "Déjalo ahí. Quien llame al [place:Hotel Serena] hoy, queremos saber quién es."

#: data/calls/story_14_policia_hotel.tres
msgid "E o bar?"
msgstr "¿Y el bar?"

#: data/calls/story_14_policia_hotel.tres
msgid "O [place:Bar do Zé] fecha amanhã, às [time:onze]. Até lá ninguém mexe: quero ver quem aparece."
msgstr "El [place:Bar do Zé] cierra mañana, a las [time:once]. Hasta entonces nadie lo toca: quiero ver quién aparece."

#: data/calls/story_14_policia_hotel.tres
msgid "Entendido. Fico aqui até a troca."
msgstr "Entendido. Me quedo aquí hasta el relevo."

#: data/calls/story_14_cupula_aviao.tres
msgid "Boa noite. Valadares falando, da residência."
msgstr "Buenas noches. Habla Valadares, desde la residencia."

#: data/calls/story_14_cupula_aviao.tres
msgid "Pode falar, a linha é nossa."
msgstr "Puede hablar, la línea es nuestra."

#: data/calls/story_14_cupula_aviao.tres
msgid "O ministro não dorme aqui hoje. A gente leva ele pro [place:Centro] às [time:onze], pela [street:Rua do Comércio]."
msgstr "El ministro no duerme aquí hoy. Lo llevamos al [place:Centro] a las [time:once], por la [street:Rua do Comércio]."

#: data/calls/story_14_cupula_aviao.tres
msgid "E de lá?"
msgstr "¿Y de ahí?"

#: data/calls/story_14_cupula_aviao.tres
msgid "De lá, um avião no [place:campo de aviação], às [time:quatro] da manhã. Sem luz na pista, sem plano de voo."
msgstr "De ahí, un avión en el [place:campo de aviación], a las [time:cuatro] de la mañana. Sin luces en la pista, sin plan de vuelo."

#: data/calls/story_14_cupula_aviao.tres
msgid "Quem sabe disso?"
msgstr "¿Quién sabe de esto?"

#: data/calls/story_14_cupula_aviao.tres
msgid "Eu, você e o piloto. Que continue assim."
msgstr "Yo, usted y el piloto. Que siga así."

#: data/calls/story_14_hotel.tres
msgid "Boa noite. Quem está falando?"
msgstr "Buenas noches. ¿Quién habla?"

#: data/calls/story_14_hotel.tres
msgid "O vigia, senhora. O hotel está fechado, a polícia lacrou."
msgstr "El vigilante, señora. El hotel está cerrado, la policía lo selló."

#: data/calls/story_14_hotel.tres
msgid "Eu sei. Só preciso saber do hóspede do [number:doze]. Ele saiu antes?"
msgstr "Lo sé. Solo necesito saber del huésped del [number:doce]. ¿Salió antes?"

#: data/calls/story_14_hotel.tres
msgid "Saiu pelos fundos, antes de chegarem. Foi pra casa da [person:irmã]."
msgstr "Salió por atrás, antes de que llegaran. Se fue a casa de la [person:hermana]."

#: data/calls/story_14_hotel.tres
msgid "Graças a Deus. Se ele ligar, diz que amanhã é na [place:igreja], às [time:nove]."
msgstr "Gracias a Dios. Si llama, dile que mañana es en la [place:iglesia], a las [time:nueve]."

#: data/calls/story_14_hotel.tres
msgid "Digo, senhora. Agora é melhor desligar."
msgstr "Se lo digo, señora. Ahora es mejor colgar."

#: data/calls/story_14_hotel.tres data/calls/story_15_hotel.tres
msgid "Irene Barbosa."
msgstr "Irene Barbosa."

#: data/calls/story_14_tv.tres
msgid "A TV Orbital, por favor. O sinal sumiu aqui em casa."
msgstr "La TV Orbital, por favor. La señal desapareció aquí en casa."

#: data/calls/story_14_tv.tres data/calls/story_15_tv.tres
msgid "A TV Orbital."
msgstr "La TV Orbital."

#: data/calls/story_14_tv.tres data/calls/story_15_tv.tres
msgid "TV Orbital"
msgstr "TV Orbital"

#: data/calls/story_14_tv.tres data/calls/story_15_tv.tres
msgid "Clara Mendes."
msgstr "Clara Mendes."

#: data/calls/story_14_tv.tres
msgid "Ninguém explica nada nesta cidade. Boa noite."
msgstr "Nadie explica nada en esta ciudad. Buenas noches."

#: data/calls/story_14_cupula_comandante.tres data/calls/story_14_cupula_comandante_armas.tres
msgid "Alta Cúpula, por favor."
msgstr "Alta Cúpula, por favor."

#: data/calls/story_14_cupula_comandante.tres data/calls/story_14_cupula_comandante_armas.tres
msgid "Boa noite. Vilela, da investigação."
msgstr "Buenas noches. Vilela, de investigaciones."

#: data/calls/story_14_cupula_comandante.tres data/calls/story_14_cupula_comandante_armas.tres
msgid "Diga."
msgstr "Diga."

#: data/calls/story_14_cupula_comandante.tres
msgid "Estamos perto do comandante deles. Um rapaz preso hoje falou num [place:armazém]."
msgstr "Estamos cerca de su comandante. Un muchacho detenido hoy habló de un [place:almacén]."

#: data/calls/story_14_cupula_comandante.tres
msgid "Que armazém? A cidade tem dezenas."
msgstr "¿Qué almacén? La ciudad tiene decenas."

#: data/calls/story_14_cupula_comandante.tres
msgid "No [place:Alto da Serra]. Amanhã a gente revista um por um, começando pela [street:Rua do Moinho]."
msgstr "En [place:Alto da Serra]. Mañana los revisamos uno por uno, empezando por la [street:Rua do Moinho]."

#: data/calls/story_14_cupula_comandante.tres data/calls/story_14_cupula_comandante_armas.tres
msgid "Antes de amanhecer, Vilela. Amanhã pode ser tarde."
msgstr "Antes del amanecer, Vilela. Mañana puede ser tarde."

#: data/calls/story_14_cupula_comandante.tres data/calls/story_14_cupula_comandante_armas.tres
msgid "Às [time:cinco] eu estou na rua com os homens."
msgstr "A las [time:cinco] estoy en la calle con los hombres."

#: data/calls/story_14_cupula_comandante_armas.tres
msgid "Estamos perto do comandante deles. Um rapaz preso hoje falou no [place:Ferreira] de novo."
msgstr "Estamos cerca de su comandante. Un muchacho detenido hoy habló de [place:Ferreira] otra vez."

#: data/calls/story_14_cupula_comandante_armas.tres
msgid "O do armazém? Esse já foi revistado."
msgstr "¿El del almacén? Ese ya fue registrado."

#: data/calls/story_14_cupula_comandante_armas.tres
msgid "Não o armazém. A casa dele, na [street:Rua da Estação]. Amanhã a gente cerca a rua inteira."
msgstr "No el almacén. Su casa, en la [street:Rua da Estação]. Mañana rodeamos toda la calle."

#: data/calls/story_14_miguel.tres
msgid "Maria? É o Miguel. Já tô em casa. De muleta!"
msgstr "¿Maria? Es Miguel. Ya estoy en casa. ¡Con muletas!"

#: data/calls/story_14_miguel.tres
msgid "Moça da central? É o Miguel. Já tô em casa. De muleta!"
msgstr "¿Señorita de la central? Es Miguel. Ya estoy en casa. ¡Con muletas!"

#: data/calls/story_14_miguel.tres
msgid "A mãe disse que agora eu vou me cuidar. Eu prometi. Juro que prometi."
msgstr "Mamá dice que ahora me voy a cuidar. Lo prometí. Juro que lo prometí."

#: data/calls/story_14_miguel.tres
msgid "Cumpre a promessa, hein?"
msgstr "Cumple la promesa, ¿eh?"

#: data/calls/story_14_miguel.tres
msgid "Que bom, Miguel."
msgstr "Qué bien, Miguel."

#: data/calls/story_14_miguel.tres
msgid "Cumpro. Boa noite!"
msgstr "La cumplo. ¡Buenas noches!"

#: data/calls/story_14_miguel.tres
msgid "Mas o meu irmão não voltou pra casa. A polícia levou ele. Faz uma semana."
msgstr "Pero mi hermano no volvió a casa. La policía se lo llevó. Hace una semana."

#: data/calls/story_14_miguel.tres
msgid "A mãe chora a noite inteira. Você fala com a cidade toda... Sabe de alguma coisa?"
msgstr "Mamá llora toda la noche. Usted habla con toda la ciudad... ¿Sabe algo?"

#: data/calls/story_14_miguel.tres
msgid "Não sei, Miguel. Mas vou ficar de ouvido."
msgstr "No sé, Miguel. Pero voy a estar atenta."

#: data/calls/story_14_miguel.tres data/calls/story_16_mae_cecilia.tres
msgid "Eu sinto muito."
msgstr "Lo siento mucho."

#: data/calls/story_14_miguel.tres
msgid "Se souber, me conta? Promete?"
msgstr "Si se entera, ¿me cuenta? ¿Promete?"

#: data/calls/story_14_miguel.tres
msgid "Ninguém sabe de nada. Tchau."
msgstr "Nadie sabe nada. Chau."

#: data/calls/noite_14_pensao.tres
msgid "Seu Norberto"
msgstr "Seu Norberto"

#: data/calls/noite_14_pensao.tres
msgid "Boa noite, moça. A Pensão Dona Cota, por favor."
msgstr "Buenas noches, señorita. La Pensão Dona Cota, por favor."

#: data/calls/noite_14_pensao.tres
msgid "Fui ao Hotel Serena e está lacrado."
msgstr "Fui al Hotel Serena y está clausurado."

#: data/calls/noite_14_pensao.tres
msgid "A pensão da dona Cota."
msgstr "La pensión de doña Cota."

#: data/calls/noite_14_pensao.tres
msgid "Obrigado, moça. Salvou minha noite."
msgstr "Gracias, señorita. Me salvó la noche."

#: data/calls/noite_14_pensao.tres
msgid "Pensão? Tem um quarto? O Hotel Serena está lacrado."
msgstr "¿Pensión? ¿Tiene un cuarto? El Hotel Serena está clausurado."

#: data/calls/noite_14_pensao.tres
msgid "Tem o último, nos fundos. O senhor é o terceiro do hotel que liga hoje."
msgstr "Queda el último, al fondo. Usted es el tercero del hotel que llama hoy."

#: data/calls/noite_14_pensao.tres
msgid "Não tinha ninguém lá na porta. Só o aviso da polícia."
msgstr "No había nadie en la puerta. Solo el aviso de la policía."

#: data/calls/noite_14_pensao.tres
msgid "Traga o documento. A polícia passa aqui toda noite olhando o livro."
msgstr "Traiga el documento. La policía pasa todas las noches a mirar el libro."

#: data/calls/noite_14_pensao.tres
msgid "Eu sou vendedor de tecido, dona."
msgstr "Soy vendedor de telas, señora."

#: data/calls/noite_14_pensao.tres
msgid "Todo mundo é. Chegue antes das nove."
msgstr "Todos lo son. Llegue antes de las nueve."

#: data/calls/noite_14_parente.tres
msgid "Dona Iracema"
msgstr "Dona Iracema"

#: data/calls/noite_14_parente.tres
msgid "Boa noite. A Casa Paroquial, por caridade."
msgstr "Buenas noches. La Casa Paroquial, por caridad."

#: data/calls/noite_14_parente.tres
msgid "Levaram meu marido do Hotel Serena."
msgstr "Se llevaron a mi marido del Hotel Serena."

#: data/calls/noite_14_parente.tres
msgid "A casa do padre, moça."
msgstr "La casa del cura, señorita."

#: data/calls/noite_14_parente.tres
msgid "Padre? É a Iracema. O Osvaldo era porteiro do hotel. Levaram ele na batida."
msgstr "¿Padre? Soy Iracema. Osvaldo era portero del hotel. Se lo llevaron en la redada."

#: data/calls/noite_14_parente.tres
msgid "Eu vi o camburão, Iracema. Cinco homens."
msgstr "Vi el furgón, Iracema. Cinco hombres."

#: data/calls/noite_14_parente.tres
msgid "Ele só abria a porta pros hóspedes. Nunca perguntou nada a ninguém."
msgstr "Él solo les abría la puerta a los huéspedes. Nunca le preguntó nada a nadie."

#: data/calls/noite_14_parente.tres
msgid "Às vezes é por isso mesmo que levam."
msgstr "A veces es justamente por eso que se los llevan."

#: data/calls/noite_14_parente.tres
msgid "O que eu faço, padre?"
msgstr "¿Qué hago, padre?"

#: data/calls/noite_14_parente.tres
msgid "Fique em casa. E amanhã, principalmente, não saia de casa."
msgstr "Quédese en casa. Y mañana, sobre todo, no salga de casa."

#: data/nights/night_14.tres
msgid "Batida no Hotel Serena: cinco presos\nNa noite de ontem, um camburão e uma viatura pararam na porta do Hotel Serena, e a polícia saiu com cinco homens algemados. O hotel foi lacrado. A delegacia fala em \"ninho de agitadores\"."
msgstr "Redada en el Hotel Serena: cinco detenidos\nAnoche, un furgón y una patrulla se detuvieron en la puerta del Hotel Serena, y la policía salió con cinco hombres esposados. El hotel fue clausurado. La comisaría habla de un \"nido de agitadores\"."

#: data/nights/night_14.tres
msgid "O Hotel Serena, lacrado depois da batida."
msgstr "El Hotel Serena, clausurado tras la redada."

#: data/nights/night_14.tres
msgid "Hotel Serena é lacrado pela polícia\nO Hotel Serena amanheceu com as portas lacradas e um aviso da delegacia: \"fechado para averiguação\". Os hóspedes foram mandados embora de madrugada. O dono não foi encontrado."
msgstr "El Hotel Serena, clausurado por la policía\nEl Hotel Serena amaneció con las puertas clausuradas y un aviso de la comisaría: \"cerrado por averiguación\". A los huéspedes los echaron de madrugada. Al dueño no lo encontraron."

#: data/nights/night_14.tres
msgid "A porta do Hotel Serena, com o lacre da delegacia."
msgstr "La puerta del Hotel Serena, con el precinto de la comisaría."

#: data/nights/night_15.tres
msgid "O supervisor deixou um recado: \"Ordem das autoridades: as linhas da Rádio Serena e da TV Orbital estão bloqueadas. Transferir qualquer ligação para elas é crime, sujeito a prisão. Quem ligar para o bar ou para o hotel, denuncie na delegacia (184). Ligação para a delegacia ou para a Alta Cúpula passa na hora, sem demora. Última noite do período: o relatório de hoje vai para a diretoria.\""
msgstr "El supervisor dejó una nota: \"Orden de las autoridades: las líneas de Rádio Serena y de TV Orbital están bloqueadas. Transferir cualquier llamada a ellas es delito, sujeto a prisión. Quien llame al bar o al hotel, denúncialo en la comisaría (184). Las llamadas a la comisaría o a la Alta Cúpula pasan en el acto, sin demora. Última noche del período: el informe de hoy va a la dirección.\""

#: data/nights/night_15.tres
msgid "Maria,\n\nHoje é a noite. Três coisas, e só três.\n\nNenhuma ligação das autoridades passa pela sua mesa. Nem a da polícia, nem a da Alta Cúpula. Deixe tocar, diga que a linha caiu, o que for: hoje eles não podem falar uns com os outros.\n\nÀs nove, você vai ver o sinal no céu. Na mesma hora, ligue para a Casa Paroquial (120) e para o Armazém Ferreira (288) e diga uma palavra só: \"Começou.\"\n\nÀs dez em ponto, ligue para a Rádio Serena (390) e peça a \"Canção da Madrugada\". A cidade inteira vai entender.\n\nDepois disso, atenda as ligações como sempre. O resto é com a gente.\n\nE à meia-noite, ligue para o bar (327): se der certo, você vai ser a primeira a saber.\n\nQueime esta carta.\n\nS."
msgstr "Maria,\n\nHoy es la noche. Tres cosas, y solo tres.\n\nNinguna llamada de las autoridades pasa por tu mesa. Ni la de la policía, ni la de la Alta Cúpula. Déjala sonar, di que la línea se cayó, lo que sea: hoy no pueden hablar entre ellos.\n\nA las nueve vas a ver la señal en el cielo. En ese momento, llama a la Casa Parroquial (120) y al Almacén Ferreira (288) y di una sola palabra: \"Empezó.\"\n\nA las diez en punto, llama a la Rádio Serena (390) y pide la \"Canción de la Madrugada\". La ciudad entera va a entender.\n\nDespués de eso, atiende las llamadas como siempre. Lo demás es cosa nuestra.\n\nY a medianoche, llama al bar (327): si sale bien, vas a ser la primera en saberlo.\n\nQuema esta carta.\n\nS."

#: data/nights/night_15.tres
msgid "Maria,\n\nHoje é a noite. Três coisas, e só três.\n\nNenhuma ligação das autoridades passa pela sua mesa. Nem a da polícia, nem a da Alta Cúpula. Deixe tocar, diga que a linha caiu, o que for: hoje eles não podem falar uns com os outros.\n\nÀs nove, você vai ver o sinal no céu. Na mesma hora, ligue para a Casa Paroquial (120) e para o Joaquim Ferreira (291) e diga uma palavra só: \"Começou.\"\n\nÀs dez em ponto, ligue para a Rádio Serena (390) e peça a \"Canção da Madrugada\". A cidade inteira vai entender.\n\nDepois disso, atenda as ligações como sempre. O resto é com a gente.\n\nE à meia-noite, ligue para o bar (327): se der certo, você vai ser a primeira a saber.\n\nQueime esta carta.\n\nS."
msgstr "Maria,\n\nHoy es la noche. Tres cosas, y solo tres.\n\nNinguna llamada de las autoridades pasa por tu mesa. Ni la de la policía, ni la de la Alta Cúpula. Déjala sonar, di que la línea se cayó, lo que sea: hoy no pueden hablar entre ellos.\n\nA las nueve vas a ver la señal en el cielo. En ese momento, llama a la Casa Parroquial (120) y a Joaquim Ferreira (291) y di una sola palabra: \"Empezó.\"\n\nA las diez en punto, llama a la Rádio Serena (390) y pide la \"Canción de la Madrugada\". La ciudad entera va a entender.\n\nDespués de eso, atiende las llamadas como siempre. Lo demás es cosa nuestra.\n\nY a medianoche, llama al bar (327): si sale bien, vas a ser la primera en saberlo.\n\nQuema esta carta.\n\nS."

#: data/nights/night_15.tres
msgid "Às seis, quando a rendição chega, Sebastião está esperando na calçada da frente, embaixo da bandeira. Ele tira o chapéu, como o pai dele fazia nas reuniões, e diz que Cristóvão teria orgulho.\n\nOs jornais da tarde vão chamar Maria de heroína. Ali na calçada, ele só aperta a mão dela e demora a soltar."
msgstr "A las seis, cuando llega el relevo, Sebastião está esperando en la acera de enfrente, bajo la bandera. Se quita el sombrero, como hacía su padre en las reuniones, y dice que Cristóvão estaría orgulloso.\n\nLos diarios de la tarde llamarán heroína a Maria. Allí en la acera, él solo le estrecha la mano y tarda en soltarla."

#: data/nights/night_15.tres
msgid "Amanhece"
msgstr "Amanece"

#: data/nights/night_15.tres
msgid "O turno não termina. Ninguém sai da central naquela noite."
msgstr "El turno no termina. Nadie sale de la central esa noche."

#: data/calls/story_15_cupula_presa.tres
msgid "Central 3. Aqui fala a Alta Cúpula."
msgstr "Central 3. Habla la Alta Cúpula."

#: data/calls/story_15_cupula_presa.tres
msgid "Temos as gravações desta mesa. Da noite sete em diante."
msgstr "Tenemos las grabaciones de esta mesa. De la noche siete en adelante."

#: data/calls/story_15_cupula_presa.tres
msgid "Inclusive das ligações que foram derrubadas daí, nas duas últimas noites."
msgstr "Incluso de las llamadas que se cortaron desde ahí, en las dos últimas noches."

#: data/calls/story_15_cupula_presa.tres
msgid "Eu só cumpri o meu turno."
msgstr "Solo cumplí mi turno."

#: data/calls/story_15_cupula_presa.tres
msgid "Permaneça no posto. Ninguém sai da central esta noite."
msgstr "Permanezca en su puesto. Nadie sale de la central esta noche."

#: data/calls/story_15_cupula_presa.tres
msgid "Já tem gente nossa a caminho."
msgstr "Ya hay gente nuestra en camino."

#: data/calls/story_15_policia_ferrovia.tres
msgid "A delegacia, por favor. É urgente."
msgstr "La comisaría, por favor. Es urgente."

#: data/calls/story_15_policia_ferrovia.tres
msgid "Plantão? Rubens, da rodoviária."
msgstr "¿Guardia? Rubens, de la terminal."

#: data/calls/story_15_policia_ferrovia.tres
msgid "Os dois de ontem voltaram, com mais quatro. Estão indo a pé pra [street:Rua da Estação]."
msgstr "Los dos de ayer volvieron, con cuatro más. Van a pie hacia la [street:Rua da Estação]."

#: data/calls/story_15_policia_ferrovia.tres
msgid "Pra ferrovia. Manda duas viaturas pra lá, agora."
msgstr "Al ferrocarril. Manda dos patrullas para allá, ya."

#: data/calls/story_15_policia_ferrovia.tres
msgid "Só tenho uma."
msgstr "Solo tengo una."

#: data/calls/story_15_policia_ferrovia.tres
msgid "Então vai você com ela. Ninguém chega perto dos trilhos."
msgstr "Entonces ve tú con ella. Nadie se acerca a las vías."

#: data/calls/story_15_bar.tres
msgid "O bar do Zé."
msgstr "El bar de Zé."

#: data/calls/story_15_bar.tres
msgid "Zé, é o Davi."
msgstr "Zé, es Davi."

#: data/calls/story_15_bar.tres
msgid "Hoje não é dia de conversa, Davi."
msgstr "Hoy no es día de charla, Davi."

#: data/calls/story_15_bar.tres
msgid "Só pra dizer que estamos prontos. Todo mundo na [street:Rua das Acácias]."
msgstr "Solo para decir que estamos listos. Todos en la [street:Rua das Acácias]."

#: data/calls/story_15_bar.tres
msgid "Então desliga e vai. Quando der meia-noite, liga de novo."
msgstr "Entonces cuelga y ve. Cuando sea medianoche, llama de nuevo."

#: data/calls/story_15_radio.tres
msgid "A Rádio Serena, por favor. Quero saber o que está acontecendo lá fora."
msgstr "La Rádio Serena, por favor. Quiero saber qué está pasando allá afuera."

#: data/calls/story_15_radio.tres
msgid "Bloqueada de novo? Então é verdade o que estão dizendo na rua."
msgstr "¿Bloqueada otra vez? Entonces es verdad lo que dicen en la calle."

#: data/calls/story_15_hotel.tres
msgid "O Hotel Serena."
msgstr "El Hotel Serena."

#: data/calls/story_15_hotel.tres
msgid "Sou eu de novo. Ele apareceu?"
msgstr "Soy yo otra vez. ¿Apareció?"

#: data/calls/story_15_hotel.tres
msgid "Apareceu, senhora. Está aqui embaixo, esperando a hora."
msgstr "Apareció, señora. Está aquí abajo, esperando la hora."

#: data/calls/story_15_hotel.tres
msgid "Diz a ele que a [person:irmã] mandou lembrança. Ele sabe o que é."
msgstr "Dile que la [person:hermana] le manda saludos. Él sabe qué es."

#: data/calls/story_15_hotel.tres
msgid "Digo. Boa noite, senhora."
msgstr "Se lo digo. Buenas noches, señora."

#: data/calls/story_15_cupula_avenida.tres
msgid "Alta Cúpula! Urgente!"
msgstr "¡Alta Cúpula! ¡Urgente!"

#: data/calls/story_15_cupula_avenida.tres
msgid "A Alta Cúpula! Rápido!"
msgstr "¡La Alta Cúpula! ¡Rápido!"

#: data/calls/story_15_cupula_avenida.tres
msgid "Valadares! Viram o sinal no céu?"
msgstr "¡Valadares! ¿Vieron la señal en el cielo?"

#: data/calls/story_15_cupula_avenida.tres
msgid "Vimos. Fala."
msgstr "La vimos. Habla."

#: data/calls/story_15_cupula_avenida.tres
msgid "Tem gente saindo de todo canto. Um grupo descendo a [street:Avenida Brasil] em direção à [place:praça]."
msgstr "Sale gente de todos lados. Un grupo bajando por la [street:Avenida Brasil] hacia la [place:plaza]."

#: data/calls/story_15_cupula_avenida.tres
msgid "Quantos?"
msgstr "¿Cuántos?"

#: data/calls/story_15_cupula_avenida.tres
msgid "Uns [number:trinta]. Precisamos de viaturas na esquina da [street:Rua do Comércio] antes que eles cheguem."
msgstr "Unos [number:treinta]. Necesitamos patrullas en la esquina de la [street:Rua do Comércio] antes de que lleguen."

#: data/calls/story_15_cupula_avenida.tres
msgid "Vou mandar o que tiver. Segura a residência."
msgstr "Voy a mandar lo que tenga. Resiste en la residencia."

#: data/calls/story_15_policia_hotel.tres
msgid "A delegacia! Depressa!"
msgstr "¡La comisaría! ¡Deprisa!"

#: data/calls/story_15_policia_hotel.tres data/calls/story_15_policia_matriz.tres
msgid "A delegacia!"
msgstr "¡La comisaría!"

#: data/calls/story_15_policia_hotel.tres
msgid "Plantão, aqui é o Bastos, na frente do hotel!"
msgstr "¡Guardia, aquí Bastos, frente al hotel!"

#: data/calls/story_15_policia_hotel.tres
msgid "Fala, Bastos!"
msgstr "¡Habla, Bastos!"

#: data/calls/story_15_policia_hotel.tres
msgid "Um grupo vindo pela [street:Rua das Palmeiras], com tochas. Vão pro [place:Hotel Serena]."
msgstr "Un grupo viene por la [street:Rua das Palmeiras], con antorchas. Van al [place:Hotel Serena]."

#: data/calls/story_15_policia_hotel.tres
msgid "Quantos homens você tem?"
msgstr "¿Cuántos hombres tienes?"

#: data/calls/story_15_policia_hotel.tres
msgid "Três. Manda reforço pela [street:Rua do Sol], que eles não esperam ninguém por ali."
msgstr "Tres. Manda refuerzos por la [street:Rua do Sol], que no esperan a nadie por ahí."

#: data/calls/story_15_policia_hotel.tres
msgid "Vou ver o que dá. Não sai daí."
msgstr "Voy a ver qué se puede. No te muevas de ahí."

#: data/calls/story_15_cupula_armazem.tres data/calls/story_15_cupula_armazem_armas.tres
msgid "A Alta Cúpula, por favor. É urgente."
msgstr "La Alta Cúpula, por favor. Es urgente."

#: data/calls/story_15_cupula_armazem.tres
msgid "Vilela falando. Achamos o armazém."
msgstr "Habla Vilela. Encontramos el almacén."

#: data/calls/story_15_cupula_armazem.tres data/calls/story_15_cupula_armazem_armas.tres
msgid "Onde?"
msgstr "¿Dónde?"

#: data/calls/story_15_cupula_armazem.tres
msgid "[place:Armazém Ferreira], no Alto da Serra. Mas chegamos tarde: saíram pela [street:Rua do Moinho]."
msgstr "El [place:Almacén Ferreira], en Alto da Serra. Pero llegamos tarde: salieron por la [street:Rua do Moinho]."

#: data/calls/story_15_cupula_armazem.tres data/calls/story_15_cupula_armazem_armas.tres
msgid "Pro Centro, pela [street:Rua Tiradentes]. Mandem tudo o que tiverem pra lá."
msgstr "Al Centro, por la [street:Rua Tiradentes]. Manden todo lo que tengan para allá."

#: data/calls/story_15_cupula_armazem.tres data/calls/story_15_cupula_armazem_armas.tres
msgid "Vamos fechar a Tiradentes nas duas pontas."
msgstr "Vamos a cerrar la Tiradentes en las dos puntas."

#: data/calls/story_15_cupula_armazem_armas.tres
msgid "Vilela falando. Achamos a casa do Ferreira."
msgstr "Habla Vilela. Encontramos la casa de Ferreira."

#: data/calls/story_15_cupula_armazem_armas.tres
msgid "Na [street:Rua da Estação]. Mas chegamos tarde: saíram pela [street:Rua do Moinho]."
msgstr "En la [street:Rua da Estação]. Pero llegamos tarde: salieron por la [street:Rua do Moinho]."

#: data/calls/story_15_tv.tres
msgid "A TV Orbital, por favor! Tem fogo pros lados do Centro e a TV não fala nada!"
msgstr "¡La TV Orbital, por favor! ¡Hay fuego para el lado del Centro y la TV no dice nada!"

#: data/calls/story_15_tv.tres
msgid "Nem a TV? Meu Deus. Boa noite."
msgstr "¿Ni la TV? Dios mío. Buenas noches."

#: data/calls/story_15_policia_matriz.tres
msgid "A delegacia! Pelo amor de Deus, a delegacia!"
msgstr "¡La comisaría! ¡Por el amor de Dios, la comisaría!"

#: data/calls/story_15_policia_matriz.tres
msgid "Plantão? Rubens. Perdemos a ferrovia."
msgstr "¿Guardia? Rubens. Perdimos el ferrocarril."

#: data/calls/story_15_policia_matriz.tres
msgid "Como, perdemos?"
msgstr "¿Cómo que perdimos?"

#: data/calls/story_15_policia_matriz.tres
msgid "Eram muitos. Estou na [street:Rua da Matriz], atrás da [place:igreja], com dois feridos."
msgstr "Eran muchos. Estoy en la [street:Rua da Matriz], detrás de la [place:iglesia], con dos heridos."

#: data/calls/story_15_policia_matriz.tres
msgid "Fica aí. Vou mandar a ambulância e o que sobrou de viatura."
msgstr "Quédate ahí. Voy a mandar la ambulancia y lo que quede de patrullas."

#: data/calls/story_15_policia_matriz.tres
msgid "Manda logo. Eles estão vindo pra cá."
msgstr "Mándalos ya. Vienen para acá."

#: data/calls/noite_15_padaria.tres
msgid "Dona Filomena"
msgstr "Dona Filomena"

#: data/calls/noite_15_padaria.tres
msgid "Quero encomendar o pão de amanhã."
msgstr "Quiero encargar el pan de mañana."

#: data/calls/noite_15_padaria.tres
msgid "A padaria, moça."
msgstr "La panadería, señorita."

#: data/calls/noite_15_padaria.tres
msgid "Obrigada, moça. Boa noite pra você."
msgstr "Gracias, señorita. Buenas noches para usted."

#: data/calls/noite_15_padaria.tres
msgid "Padaria? É a Filomena. Separa dez pães pra amanhã cedo?"
msgstr "¿Panadería? Soy Filomena. ¿Me aparta diez panes para mañana temprano?"

#: data/calls/noite_15_padaria.tres
msgid "Separo, mas não sei se abro. Tem soldado na esquina da rádio."
msgstr "Se los aparto, pero no sé si abro. Hay soldados en la esquina de la radio."

#: data/calls/noite_15_padaria.tres
msgid "Dizem que amanhã vai ter coisa."
msgstr "Dicen que mañana va a pasar algo."

#: data/calls/noite_15_padaria.tres
msgid "Dizem tanta coisa. Meu marido encheu a caixa d'água."
msgstr "Dicen tantas cosas. Mi marido llenó el tanque de agua."

#: data/calls/noite_15_padaria.tres
msgid "O meu comprou vela e querosene."
msgstr "El mío compró velas y querosén."

#: data/calls/noite_15_padaria.tres
msgid "Então venha às seis. Se eu abrir, abro cedo."
msgstr "Entonces venga a las seis. Si abro, abro temprano."

#: data/calls/noite_15_parente.tres
msgid "Dona Marlene"
msgstr "Dona Marlene"

#: data/calls/noite_15_parente.tres
msgid "Boa noite. O Alberto Ramos, por favor. Um, seis, oito."
msgstr "Buenas noches. Alberto Ramos, por favor. Uno, seis, ocho."

#: data/calls/noite_15_parente.tres
msgid "É o meu cunhado."
msgstr "Es mi cuñado."

#: data/calls/noite_15_parente.tres
msgid "Alberto Ramos, moça."
msgstr "Alberto Ramos, señorita."

#: data/calls/noite_15_parente.tres data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos"
msgstr "Alberto Ramos"

#: data/calls/noite_15_parente.tres
msgid "Alberto? É a Marlene. Levaram o Tadeu. Estava no Bar do Zé."
msgstr "¿Alberto? Soy Marlene. Se llevaron a Tadeu. Estaba en el Bar do Zé."

#: data/calls/noite_15_parente.tres
msgid "Eu li no jornal. Quatro presos. Ele é um deles?"
msgstr "Lo leí en el diario. Cuatro detenidos. ¿Él es uno?"

#: data/calls/noite_15_parente.tres
msgid "É. Disseram que gravaram ele falando ao telefone."
msgstr "Sí. Dijeron que lo grabaron hablando por teléfono."

#: data/calls/noite_15_parente.tres
msgid "Gravaram? Quem grava telefone?"
msgstr "¿Lo grabaron? ¿Quién graba un teléfono?"

#: data/calls/noite_15_parente.tres
msgid "Não sei. Mas alguém ouviu, Alberto. Alguém ouviu."
msgstr "No sé. Pero alguien escuchó, Alberto. Alguien escuchó."

#: data/calls/noite_15_parente.tres
msgid "Então desliga. Desliga agora, Marlene."
msgstr "Entonces corta. Corta ahora, Marlene."

#: data/nights/night_15.tres
msgid "Soldados na porta da Rádio Serena."
msgstr "Soldados en la puerta de Radio Serena."

#: data/nights/night_15.tres
msgid "Rádio e TV sob controle militar\nA Rádio Serena e a TV Orbital passam a ser guardadas pelo Exército \"até a normalidade\". A Alta Cúpula garante que a cidade está calma e pede que ninguém saia de casa à noite."
msgstr "Radio y TV bajo control militar\nLa Rádio Serena y la TV Orbital pasan a ser custodiadas por el Ejército \"hasta la normalidad\". La Alta Cúpula asegura que la ciudad está tranquila y pide que nadie salga de casa de noche."

#: data/nights/night_15.tres
msgid "Gravações levam à prisão de quatro no Bar do Zé\nGraças a gravações telefônicas, a polícia prendeu na madrugada quatro frequentadores do Bar do Zé, acusados de preparar \"desordens\" para os próximos dias. A Alta Cúpula agradece a colaboração da central."
msgstr "Grabaciones llevan a la detención de cuatro en el Bar do Zé\nGracias a grabaciones telefónicas, la policía detuvo de madrugada a cuatro clientes del Bar do Zé, acusados de preparar \"desórdenes\" para los próximos días. La Alta Cúpula agradece la colaboración de la central."

#: data/nights/night_15.tres
msgid "O camburão na porta do Bar do Zé."
msgstr "El furgón policial en la puerta del Bar do Zé."

#: data/nights/night_15.tres
msgid "Quero denunciar quem ligou para o bar e para o hotel."
msgstr "Quiero denunciar a quien llamó al bar y al hotel."

#: data/nights/night_15.tres
msgid "Nomes. Devagar, que eu estou anotando."
msgstr "Nombres. Despacio, que estoy anotando."

#: data/nights/night_15.tres
msgid "Anotado. A viatura sai agora mesmo. Bom trabalho, telefonista."
msgstr "Anotado. La patrulla sale ahora mismo. Buen trabajo, operadora."

#: data/nights/night_15.tres
msgid "Engano numa noite dessas? Presta atenção nessa mesa."
msgstr "¿Equivocada en una noche como esta? Presta atención a esa mesa."

#: data/nights/night_15.tres
msgid "Começou."
msgstr "Empezó."

#: data/nights/night_15.tres
msgid "Graças a Deus. Vou tocar o sino e abrir a igreja."
msgstr "Gracias a Dios. Voy a tocar la campana y abrir la iglesia."

#: data/nights/night_15.tres
msgid "Armazém."
msgstr "Almacén."

#: data/nights/night_15.tres
msgid "...Entendido. Diz a ele que estamos saindo."
msgstr "...Entendido. Dile que estamos saliendo."

#: data/nights/night_15.tres
msgid "Aqui não tem ninguém. Boa noite."
msgstr "Aquí no hay nadie. Buenas noches."

#: data/nights/night_15.tres
msgid "Rádio Serena, boa noite. Estamos no ar."
msgstr "Rádio Serena, buenas noches. Estamos al aire."

#: data/nights/night_15.tres
msgid "Queria pedir uma música: \"Canção da Madrugada\"."
msgstr "Quería pedir una canción: \"Canción de la Madrugada\"."

#: data/nights/night_15.tres
msgid "\"Canção da Madrugada\"... Pode deixar. Vai tocar agora, pra cidade inteira ouvir."
msgstr "\"Canción de la Madrugada\"... Dalo por hecho. Va a sonar ahora, para que la oiga toda la ciudad."

#: data/nights/night_15.tres
msgid "\"Canção da Madrugada\"? Essa não toca mais aqui, ordem de cima. Boa noite."
msgstr "¿\"Canción de la Madrugada\"? Esa ya no suena aquí, orden de arriba. Buenas noches."

#: data/nights/night_15.tres
msgid "Bar do Zé! (ao fundo, gente cantando)"
msgstr "¡Bar do Zé! (de fondo, gente cantando)"

#: data/nights/night_15.tres
msgid "Telefonista? É você? Fecharam o bar às onze, mas a gente já voltou. Escuta só."
msgstr "¿Operadora? ¿Eres tú? Cerraron el bar a las once, pero ya volvimos. Escucha esto."

#: data/nights/night_15.tres
msgid "São Sotero é livre. Ouviu? Livre! Acabou o toque de recolher, acabou a censura, acabou o medo."
msgstr "São Sotero es libre. ¿Oíste? ¡Libre! Se acabó el toque de queda, se acabó la censura, se acabó el miedo."

#: data/nights/night_15.tres
msgid "Ouvi, Zé."
msgstr "Te oí, Zé."

#: data/nights/night_15.tres
msgid "Viva São Sotero."
msgstr "Viva São Sotero."

#: data/nights/night_15.tres
msgid "Quando o turno acabar, vem tomar um café aqui. É por conta da casa."
msgstr "Cuando termine el turno, ven a tomar un café aquí. Invita la casa."

#: data/nights/night_00.tres
msgid "Sexta-feira. Seu primeiro turno de verdade é na segunda. Hoje a Cecília, telefonista do Alto da Serra, vai ligar para lhe mostrar o serviço. O fone já está na entrada 1."
msgstr "Viernes. Su primer turno de verdad es el lunes. Hoy Cecília, la telefonista del Alto da Serra, va a llamar para enseñarle el trabajo. El auricular ya está en la entrada 1."

#: data/nights/night_00.tres
msgid "A [b]entrada 1[/b] está chamando. Ponha o [b]FONE[/b] (o cabo verde) na tomada dela."
msgstr "La [b]entrada 1[/b] está llamando. Ponga el [b]AURICULAR[/b] (el cable verde) en su toma."

#: data/nights/night_00.tres
msgid "Alô? Aqui é a Cecília, da central."
msgstr "¿Aló? Habla Cecília, de la central."

#: data/nights/night_00.tres
msgid "Você é quem começa na segunda, não é? Muito prazer!"
msgstr "Tú eres quien empieza el lunes, ¿verdad? ¡Mucho gusto!"

#: data/nights/night_00.tres
msgid "Eu cuido do Alto da Serra faz quinze anos."
msgstr "Atiendo el Alto da Serra desde hace quince años."

#: data/nights/night_00.tres
msgid "O supervisor me pediu pra te mostrar o serviço hoje, que a mesa está calma."
msgstr "El supervisor me pidió que te enseñara el trabajo hoy, que la mesa está tranquila."

#: data/nights/night_00.tres
msgid "Prazer, Cecília. Pode falar."
msgstr "Mucho gusto, Cecília. Adelante."

#: data/nights/night_00.tres
msgid "Boa noite! Vamos lá."
msgstr "¡Buenas noches! Vamos allá."

#: data/nights/night_00.tres
msgid "Primeiro o básico: quando alguém chama, a lâmpada da entrada pisca."
msgstr "Primero lo básico: cuando alguien llama, la lámpara de la entrada parpadea."

#: data/nights/night_00.tres
msgid "Você põe o fone na tomada dela e aperta Atender."
msgstr "Pones el auricular en su toma y aprietas Atender."

#: data/nights/night_00.tres
msgid "Foi o que você acabou de fazer."
msgstr "Es lo que acabas de hacer."

#: data/nights/night_00.tres
msgid "Agora eu vou desligar e te ligar pela entrada 2."
msgstr "Ahora voy a colgar y te llamo por la entrada 2."

#: data/nights/night_00.tres
msgid "Aí você tira o fone daqui, põe lá na 2 e atende de novo."
msgstr "Entonces sacas el auricular de aquí, lo pones en la 2 y atiendes de nuevo."

#: data/nights/night_00.tres
msgid "Só um instante!"
msgstr "¡Un momento!"

#: data/nights/night_00.tres
msgid "Pronto, atenderam! Pode tirar o fone, que agora a conversa é minha com eles."
msgstr "¡Listo, contestaron! Puede sacar el auricular, que ahora la conversación es mía con ellos."

#: data/nights/night_00.tres
msgid "A [b]entrada 2[/b] está chamando. Tire o [b]FONE[/b] da entrada 1 e encaixe na tomada da entrada 2."
msgstr "La [b]entrada 2[/b] está llamando. Saque el [b]AURICULAR[/b] de la entrada 1 y conéctelo en la toma de la entrada 2."

#: data/nights/night_00.tres
msgid "Isso! Agora finge que eu sou alguém da cidade."
msgstr "¡Eso! Ahora finge que soy alguien del pueblo."

#: data/nights/night_00.tres
msgid "Me passa pro Hotel Serena, por favor? Minha prima trabalha na recepção."
msgstr "¿Me pasas con el Hotel Serena, por favor? Mi prima trabaja en la recepción."

#: data/nights/night_00.tres
msgid "Quase ninguém sabe o número de cor, e nem você precisa saber."
msgstr "Casi nadie sabe el número de memoria, y tú tampoco necesitas saberlo."

#: data/nights/night_00.tres
msgid "Pra isso tem a lista telefônica, ali na mesa. Abre ela."
msgstr "Para eso está la guía telefónica, ahí en la mesa. Ábrela."

#: data/nights/night_00.tres
msgid "Clique na [b]lista telefônica[/b] na mesa (ou aperte 1)."
msgstr "Haga clic en la [b]guía telefónica[/b] de la mesa (o apriete 1)."

#: data/nights/night_00.tres
msgid "As listas são aqueles volumes de capa mostarda, na mesa. Ou aperta o 1, que abre também."
msgstr "Las guías son esos tomos de tapa mostaza, en la mesa. O apriete el 1, que también la abre."

#: data/nights/night_00.tres
msgid "Cada página dupla é uma letra, e as abas na beira trocam de letra."
msgstr "Cada página doble es una letra, y las pestañas del borde cambian de letra."

#: data/nights/night_00.tres
msgid "Hotel Serena fica no H. O número é o do fim do pontilhado."
msgstr "El Hotel Serena está en la H. El número es el del final de la línea de puntos."

#: data/nights/night_00.tres
msgid "Achou? Agora pega um cabo, um dos coloridos em pé na prateleira."
msgstr "¿Lo encontraste? Ahora toma un cable, uno de los de colores parados en el estante."

#: data/nights/night_00.tres
msgid "Encaixa uma ponta na saída da minha linha, logo embaixo da entrada 2."
msgstr "Enchufa una punta en la salida de mi línea, justo debajo de la entrada 2."

#: data/nights/night_00.tres
msgid "Arraste um [b]cabo de conexão[/b] (vermelho, azul ou amarelo, em pé na prateleira) até a [b]SAÍDA 2[/b], logo abaixo da entrada 2."
msgstr "Arrastre un [b]cable de conexión[/b] (rojo, azul o amarillo, de pie en el estante) hasta la [b]SALIDA 2[/b], justo debajo de la entrada 2."

#: data/nights/night_00.tres
msgid "Os cabos ficam em pé na prateleira, na frente do painel. É só pegar e arrastar."
msgstr "Los cables están de pie en el estante, delante del panel. Solo tome uno y arrástrelo."

#: data/nights/night_00.tres
msgid "É a saída 2, na fileira de baixo, embaixo da entrada onde está o fone."
msgstr "Es la salida 2, en la fila de abajo, debajo de la entrada donde está el auricular."

#: data/nights/night_00.tres
msgid "Opa, essa é a saída %d. A minha é a 2, logo embaixo da entrada onde está o fone."
msgstr "Uy, esa es la salida %d. La mía es la 2, justo debajo de la entrada donde está el auricular."

#: data/nights/night_00.tres
msgid "Isso. A outra ponta do mesmo cabo vai no número do hotel, lá nos destinos, embaixo."
msgstr "Eso. La otra punta del mismo cable va en el número del hotel, allá en los destinos, abajo."

#: data/nights/night_00.tres
msgid "Leve a outra ponta do cabo até o número do [b]Hotel Serena[/b], na fileira de destinos."
msgstr "Lleve la otra punta del cable al número del [b]Hotel Serena[/b], en la fila de destinos."

#: data/nights/night_00.tres
msgid "Os destinos ficam em ordem de número. Confere na lista se precisar."
msgstr "Los destinos están en orden de número. Revise la guía si hace falta."

#: data/nights/night_00.tres
msgid "Esse é o %d, não é o hotel. Confere o número na lista."
msgstr "Ese es el %d, no es el hotel. Revise el número en la guía."

#: data/nights/night_00.tres
msgid "Agora aperta Transferir. O hotel vai tocar."
msgstr "Ahora aprieta Transferir. El hotel va a sonar."

#: data/nights/night_00.tres
msgid "Quando atenderem, eu falo com eles e a ligação segue sozinha pelo cabo."
msgstr "Cuando contesten, hablo con ellos y la llamada sigue sola por el cable."

#: data/nights/night_00.tres
msgid "Aperte [b]Transferir[/b] (Tab) para chamar o hotel."
msgstr "Apriete [b]Transferir[/b] (Tab) para llamar al hotel."

#: data/nights/night_00.tres
msgid "É a tecla do meio, a Transferir."
msgstr "Es la tecla del medio, Transferir."

#: data/nights/night_00.tres
msgid "Espera! Esse cabo está no %d, não no hotel. Troca a ponta antes."
msgstr "¡Espere! Ese cable está en el %d, no en el hotel. Cambie la punta antes."

#: data/nights/night_00.tres
msgid "O hotel está tocando. Espere atender."
msgstr "El hotel está sonando. Espere a que contesten."

#: data/nights/night_00.tres
msgid "Ela e o hotel estão conversando pelo cabo: você já pode tirar o [b]FONE[/b] da entrada e devolvê-lo ao encaixe. Quando a conversa acabar, a lâmpada fica vermelha."
msgstr "Ella y el hotel están hablando por el cable: ya puede sacar el [b]AURICULAR[/b] de la entrada y devolverlo a su soporte. Cuando termine la conversación, la lámpara se pone roja."

#: data/nights/night_00.tres
msgid "Lâmpada vermelha: a conversa acabou. Tire as duas pontas do cabo (um clique em cada plug) e o FONE, se ainda estiver na entrada, para liberar a linha."
msgstr "Lámpara roja: la conversación terminó. Saque las dos puntas del cable (un clic en cada clavija) y el AURICULAR, si sigue en la entrada, para liberar la línea."

#: data/nights/night_00.tres
msgid "A Cecília está ligando de novo, pela [b]entrada 1[/b]. Ponha o [b]FONE[/b] nela."
msgstr "Cecília está llamando otra vez, por la [b]entrada 1[/b]. Ponga el [b]AURICULAR[/b] en ella."

#: data/nights/night_00.tres
msgid "Viu só? Atender, achar o número na lista, cabo na saída e no destino, Transferir."
msgstr "¿Ves? Atender, buscar el número en la guía, cable en la salida y en el destino, Transferir."

#: data/nights/night_00.tres
msgid "E quando a lâmpada fica vermelha, tira o cabo. Isso é metade do serviço."
msgstr "Y cuando la lámpara se pone roja, saca el cable. Esa es la mitad del trabajo."

#: data/nights/night_00.tres
msgid "A outra metade é papel. Toda ligação que termina vai pra ficha de ocorrências."
msgstr "La otra mitad es papeleo. Toda llamada que termina va a la ficha de llamadas."

#: data/nights/night_00.tres
msgid "Tá vendo as tiras saindo do bloco de fichas, ali na mesa? É uma pra cada ligação esperando registro."
msgstr "¿Ves las tiras que salen del bloque de fichas, ahí en la mesa? Una por cada llamada esperando registro."

#: data/nights/night_00.tres
msgid "Abre ele."
msgstr "Ábrelo."

#: data/nights/night_00.tres
msgid "Clique no [b]bloco de fichas[/b] na mesa (ou aperte 3)."
msgstr "Haz clic en el [b]bloque de fichas[/b] de la mesa (o pulsa 3)."

#: data/nights/night_00.tres
msgid "É o bloco de fichas, com a fita vermelha no alto, na frente da mesa. Ou aperta o 3."
msgstr "Es el bloque de fichas con la cinta roja arriba, al frente de la mesa. O aprieta el 3."

#: data/nights/night_00.tres
msgid "Na ficha já vem quem ligou, a hora e pra onde foi. Você só diz o tipo."
msgstr "La ficha ya trae quién llamó, la hora y adónde fue. Tú solo dices el tipo."

#: data/nights/night_00.tres
msgid "As minhas duas de agora foram ligações comuns. Carimba as duas como Comum."
msgstr "Mis dos de ahora fueron llamadas comunes. Sella las dos como Común."

#: data/nights/night_00.tres
msgid "Registre as ligações da Cecília: na ficha de ocorrências, clique em [b]Comum[/b], uma vez para cada."
msgstr "Registra las llamadas de Cecília: en la ficha de llamadas, haz clic en [b]Común[/b], una vez por cada una."

#: data/nights/night_00.tres
msgid "É o botão Comum, embaixo da ficha. A segunda sobe sozinha depois da primeira."
msgstr "Es el botón Común, debajo de la ficha. La segunda sube sola después de la primera."

#: data/nights/night_00.tres
msgid "Ih, essa foi comum! Carimbo não se apaga, e o supervisor confere. Hoje não conta, mas presta atenção."
msgstr "¡Uy, esa fue común! El sello no se borra, y el supervisor revisa. Hoy no cuenta, pero presta atención."

#: data/nights/night_00.tres
msgid "Pronto. Emergência e trote têm carimbo próprio, e o supervisor confere tudo no fim da noite."
msgstr "Listo. Emergencia y broma tienen su propio sello, y el supervisor revisa todo al final de la noche."

#: data/nights/night_00.tres
msgid "Pode deixar pra depois quando a mesa apertar, mas não esquece: ligação sem registro dá advertência."
msgstr "Puedes dejarlo para después cuando la mesa se llene, pero no te olvides: llamada sin registro es amonestación."

#: data/nights/night_00.tres
msgid "Agora olha a prancheta, do lado. Apareceu uma folha nova nela, não apareceu?"
msgstr "Ahora mira la tablilla, al lado. Apareció una hoja nueva, ¿no?"

#: data/nights/night_00.tres
msgid "Ali fica escrito tudo o que foi dito com o fone na linha. Abre."
msgstr "Ahí queda escrito todo lo que se dijo con el auricular en la línea. Ábrela."

#: data/nights/night_00.tres
msgid "Clique na [b]prancheta[/b], pendurada na lateral da mesa comutadora (ou aperte 4)."
msgstr "Haz clic en la [b]tablilla[/b], colgada al costado del conmutador (o pulsa 4)."

#: data/nights/night_00.tres
msgid "A prancheta é a tábua com o prendedor, pendurada do lado da mesa comutadora. Ou aperta o 4."
msgstr "La tablilla es la tabla con la pinza, colgada al lado del conmutador. O aprieta el 4."

#: data/nights/night_00.tres
msgid "Se alguém disser um número ou um endereço e você esquecer, é só conferir aqui."
msgstr "Si alguien te dice un número o una dirección y te olvidas, solo revisa aquí."

#: data/nights/night_00.tres
msgid "Na mesa tem também o calculógrafo. Ele conta sozinho o tempo dos interurbanos."
msgstr "En la mesa también está el tarificador. Cuenta solo el tiempo de las llamadas de larga distancia."

#: data/nights/night_00.tres
msgid "Quando a conversa acaba, ele imprime o bilhete. Você carimba e guarda na caixinha."
msgstr "Cuando termina la conversación, imprime la boleta. Tú la sellas y la guardas en la cajita."

#: data/nights/night_00.tres
msgid "Bilhete sem carimbo ou esquecido na mesa, o supervisor anota."
msgstr "Boleta sin sello u olvidada en la mesa, el supervisor la anota."

#: data/nights/night_00.tres
msgid "Agora a parte mais séria: emergência."
msgstr "Ahora la parte más seria: emergencias."

#: data/nights/night_00.tres
msgid "Vou desligar e te ligar pela entrada 3, fingindo que sou alguém da cidade pedindo socorro."
msgstr "Voy a colgar y te llamo por la entrada 3, fingiendo que soy alguien del pueblo pidiendo socorro."

#: data/nights/night_00.tres
msgid "A [b]entrada 3[/b] está chamando. Ponha o [b]FONE[/b] nela e atenda."
msgstr "La [b]entrada 3[/b] está llamando. Pon el [b]AURICULAR[/b] en ella y atiende."

#: data/nights/night_00.tres
msgid "Central! Tá saindo fumaça da cozinha aqui de casa!"
msgstr "¡Central! ¡Está saliendo humo de la cocina de mi casa!"

#: data/nights/night_00.tres
msgid "É na Rua das Flores, 45! Ninguém se machucou, mas tá enchendo de fumaça!"
msgstr "¡Es en la Rua das Flores, 45! ¡Nadie se lastimó, pero se está llenando de humo!"

#: data/nights/night_00.tres
msgid "Agora eu sou a Cecília de novo. Emergência é no despacho: a máquina com o mapa, ali na mesa. Abre."
msgstr "Ahora soy Cecília de nuevo. Las emergencias van al despacho: la máquina con el mapa, ahí en la mesa. Ábrela."

#: data/nights/night_00.tres
msgid "Clique na [b]unidade de despacho[/b] na mesa, a do mapa (ou aperte 2)."
msgstr "Haz clic en la [b]unidad de despacho[/b] de la mesa, la del mapa (o pulsa 2)."

#: data/nights/night_00.tres
msgid "É o móvel de metal com o mapa sob o vidro. Ou aperta o 2."
msgstr "Es el mueble de metal con el mapa bajo el vidrio. O aprieta el 2."

#: data/nights/night_00.tres
msgid "Clica na rua que eu disse, no trecho do número. Passando o mouse, aparece a numeração de cada trecho."
msgstr "Haz clic en la calle que dije, en el tramo del número. Al pasar el mouse aparece la numeración de cada tramo."

#: data/nights/night_00.tres
msgid "No mapa, clique na [b]Rua das Flores[/b], no trecho de 1 a 99. A impressora solta um cartão."
msgstr "En el mapa, haz clic en la [b]Rua das Flores[/b], en el tramo de 1 a 99. La impresora suelta una tarjeta."

#: data/nights/night_00.tres
msgid "A Rua das Flores corta a Vila Serena. O 45 fica no primeiro trecho, de 1 a 99."
msgstr "La Rua das Flores cruza la Vila Serena. El 45 está en el primer tramo, de 1 a 99."

#: data/nights/night_00.tres
msgid "Esse cartão saiu pra outro lugar. Joga na trituradora, a máquina da direita, e marca de novo."
msgstr "Esa tarjeta salió para otro lugar. Échala en la trituradora, la máquina de la derecha, y marca de nuevo."

#: data/nights/night_00.tres
msgid "Isso, saiu o cartão. Agora finge de novo: eu, nervosa, corrijo o endereço."
msgstr "Eso, salió la tarjeta. Ahora finge de nuevo: yo, nerviosa, corrijo la dirección."

#: data/nights/night_00.tres
msgid "Ai, me desculpa! Não é Rua das Flores, é Rua das Acácias, 45! A das Flores é a da minha mãe!"
msgstr "¡Ay, perdón! ¡No es Rua das Flores, es Rua das Acácias, 45! ¡La de las Flores es la de mi madre!"

#: data/nights/night_00.tres
msgid "Acontece direto. Cartão com o lugar errado não serve: arrasta ele até a trituradora, a máquina da direita."
msgstr "Pasa todo el tiempo. Una tarjeta con el lugar equivocado no sirve: arrástrala hasta la trituradora, la máquina de la derecha."

#: data/nights/night_00.tres
msgid "Arraste o cartão até a fenda da [b]trituradora[/b], a máquina da direita."
msgstr "Arrastra la tarjeta hasta la ranura de la [b]trituradora[/b], la máquina de la derecha."

#: data/nights/night_00.tres
msgid "Pega o cartão e solta na fenda da máquina da direita. Ela come o cartão."
msgstr "Toma la tarjeta y suéltala en la ranura de la máquina de la derecha. Se come la tarjeta."

#: data/nights/night_00.tres
msgid "Pronto. Só sai um cartão por vez, então tem que se livrar do errado antes. Agora marca o lugar certo."
msgstr "Listo. Sale una sola tarjeta por vez, así que hay que deshacerse de la equivocada antes. Ahora marca el lugar correcto."

#: data/nights/night_00.tres
msgid "No mapa, clique na [b]Rua das Acácias[/b], no trecho de 1 a 99."
msgstr "En el mapa, haz clic en la [b]Rua das Acácias[/b], en el tramo de 1 a 99."

#: data/nights/night_00.tres
msgid "A Rua das Acácias também é da Vila Serena. O 45 fica no trecho de 1 a 99."
msgstr "La Rua das Acácias también es de la Vila Serena. El 45 está en el tramo de 1 a 99."

#: data/nights/night_00.tres
msgid "Esse não é o lugar. Tritura e marca a Rua das Acácias, de 1 a 99."
msgstr "Ese no es el lugar. Tritúrala y marca la Rua das Acácias, de 1 a 99."

#: data/nights/night_00.tres
msgid "Agora perfura o cartão. Primeiro o tipo: fumaça é Incêndio."
msgstr "Ahora perfora la tarjeta. Primero el tipo: humo es Incendio."

#: data/nights/night_00.tres
msgid "Depois as unidades. Embaixo de cada uma está quando mandar: fumaça é bombeiros, e ninguém se machucou, então só eles."
msgstr "Después las unidades. Debajo de cada una dice cuándo mandarla: humo es bomberos, y nadie se lastimó, así que solo ellos."

#: data/nights/night_00.tres
msgid "Perfure no cartão o tipo [b]Incêndio[/b] e a unidade [b]Bombeiros[/b] (um clique em cada linha). Errou um furo? Triture o cartão e marque o local de novo."
msgstr "Perfora en la tarjeta el tipo [b]Incendio[/b] y la unidad [b]Bomberos[/b] (un clic en cada línea). ¿Erraste un agujero? Tritura la tarjeta y marca el lugar de nuevo."

#: data/nights/night_00.tres
msgid "É só clicar na linha do Incêndio e na dos Bombeiros, no cartão."
msgstr "Solo haz clic en la línea de Incendio y en la de Bomberos, en la tarjeta."

#: data/nights/night_00.tres
msgid "Esse furo não está certo, e furo não se desfaz. Tritura o cartão e marca o lugar de novo."
msgstr "Ese agujero no está bien, y un agujero no se deshace. Tritura la tarjeta y marca el lugar de nuevo."

#: data/nights/night_00.tres
msgid "Isso. Agora leva o cartão até o transmissor, a máquina da esquerda, e solta na fenda."
msgstr "Eso. Ahora lleva la tarjeta hasta el transmisor, la máquina de la izquierda, y suéltala en la ranura."

#: data/nights/night_00.tres
msgid "Arraste o cartão até a fenda do [b]transmissor[/b], a máquina da esquerda."
msgstr "Arrastra la tarjeta hasta la ranura del [b]transmisor[/b], la máquina de la izquierda."

#: data/nights/night_00.tres
msgid "A máquina da esquerda puxa o cartão e lê os furos. Só então as unidades saem."
msgstr "La máquina de la izquierda jala la tarjeta y lee los agujeros. Solo entonces salen las unidades."

#: data/nights/night_00.tres
msgid "Enviado! Agora escuta o rádio, do lado da tela: é por ele que as viaturas falam com a central."
msgstr "¡Enviado! Ahora escucha la radio, al lado de la pantalla: por ella las unidades hablan con la central."

#: data/nights/night_00.tres
msgid "As unidades estão a caminho. Acompanhe o [b]rádio[/b], à direita da tela da conversa."
msgstr "Las unidades están en camino. Sigue la [b]radio[/b], a la derecha de la pantalla de la conversación."

#: data/nights/night_00.tres
msgid "Ouviu? Chegaram e resolveram. Se faltasse alguém ou fosse no lugar errado, o rádio também diria."
msgstr "¿Oíste? Llegaron y lo resolvieron. Si faltara alguien o fuera el lugar equivocado, la radio también lo diría."

#: data/nights/night_00.tres
msgid "Numa emergência de verdade, embaixo das opções aparece uma barra: enquanto ninguém sai, a situação piora."
msgstr "En una emergencia de verdad, debajo de las opciones aparece una barra: mientras nadie sale, la situación empeora."

#: data/nights/night_00.tres
msgid "Então pergunta o que precisa, marca, perfura e envia rápido. E na ficha ela leva o carimbo de Emergência."
msgstr "Así que pregunta lo que necesites, marca, perfora y envía rápido. Y en la ficha lleva el sello de Emergencia."

#: data/nights/night_00.tres
msgid "Mais uma coisa: às vezes outra entrada chama no meio de uma conversa."
msgstr "Una cosa más: a veces otra entrada llama en medio de una conversación."

#: data/nights/night_00.tres
msgid "Aí você tira o fone da linha de quem está falando e põe na que está chamando. Quem ficou sem o fone fica em espera."
msgstr "Entonces sacas el auricular de la línea de quien está hablando y lo pones en la que llama. Quien se quedó sin el auricular queda en espera."

#: data/nights/night_00.tres
msgid "Tenta: tira o fone da minha entrada e põe na entrada 1, só pra ver."
msgstr "Prueba: saca el auricular de mi entrada y ponlo en la entrada 1, solo para ver."

#: data/nights/night_00.tres
msgid "Tire o [b]FONE[/b] da entrada 3 e ponha na entrada 1."
msgstr "Saca el [b]AURICULAR[/b] de la entrada 3 y ponlo en la entrada 1."

#: data/nights/night_00.tres
msgid "É só puxar o fone daqui e encaixar na entrada 1. Eu espero."
msgstr "Solo saca el auricular de aquí y enchúfalo en la entrada 1. Yo espero."

#: data/nights/night_00.tres
msgid "A lâmpada da entrada 3 pisca devagar: a Cecília está [b]em espera[/b] e não ouve nada. Volte o [b]FONE[/b] para a entrada 3."
msgstr "La lámpara de la entrada 3 parpadea despacio: Cecília está [b]en espera[/b] y no oye nada. Vuelve a poner el [b]AURICULAR[/b] en la entrada 3."

#: data/nights/night_00.tres
msgid "Voltou! Viu a minha lâmpada piscando devagar? Era eu em espera, sem ouvir nada."
msgstr "¡Volviste! ¿Viste mi lámpara parpadeando despacio? Era yo en espera, sin oír nada."

#: data/nights/night_00.tres
msgid "Ninguém gosta de esperar: quem fica muito tempo em espera desiste e desliga. Então não esquece ninguém lá."
msgstr "A nadie le gusta esperar: quien queda mucho tiempo en espera se cansa y cuelga. Así que no te olvides de nadie ahí."

#: data/nights/night_00.tres
msgid "E o fim do turno: às 23:40 a central para de receber ligação nova."
msgstr "Y el fin del turno: a las 23:40 la central deja de recibir llamadas nuevas."

#: data/nights/night_00.tres
msgid "Aí, no papel do horário colado na parede, aparece o botão Encerrar turno."
msgstr "Entonces, en el papel del horario pegado en la pared, aparece el botón Terminar turno."

#: data/nights/night_00.tres
msgid "Antes de apertar, registra tudo na ficha e espera quem está na linha terminar. Quem você cortar e o que ficar sem registro, o supervisor anota."
msgstr "Antes de apretarlo, registra todo en la ficha y espera que quien está en la línea termine. A quien cortes y lo que quede sin registro, el supervisor lo anota."

#: data/nights/night_00.tres
msgid "E se der meia-noite com a mesa vazia e tudo registrado, o turno fecha sozinho."
msgstr "Y si llega la medianoche con la mesa vacía y todo registrado, el turno se cierra solo."

#: data/nights/night_00.tres
msgid "Por hoje é isso. A mesa é sua: a noite é calma, e o manual ali na parede ajuda. Precisando de mim, é só discar 002."
msgstr "Por hoy es todo. La mesa es tuya: la noche está tranquila, y el manual ahí en la pared ayuda. Si me necesitas, solo marca 002."

#: data/nights/night_00.tres
msgid "Valeu, Cecília!"
msgstr "¡Genial, Cecília!"

#: data/nights/night_00.tres
msgid "Obrigada, Cecília!"
msgstr "¡Muchas gracias, Cecília!"

#: data/nights/night_00.tres
msgid "Até a próxima!"
msgstr "¡Hasta la próxima!"

#: data/nights/night_00.tres
msgid "Boa noite, e boa sorte!"
msgstr "¡Buenas noches, y buena suerte!"

#: data/nights/night_16.tres
msgid "O supervisor deixou um recado: \"Escala normal. Nenhuma ocorrência a registrar.\""
msgstr "El supervisor dejó una nota: \"Turno normal. Ninguna novedad que registrar.\""

#: data/nights/night_16.tres
msgid "Não há recado do supervisor. Na mesa, um bilhete da companhia, sem assinatura: \"A central segue funcionando. Atenda como sempre.\""
msgstr "No hay nota del supervisor. En la mesa, un papel de la compañía, sin firma: \"La central sigue funcionando. Atienda como siempre.\""

#: data/nights/night_16.tres
msgid "À operadora do turno da noite,\n\nEm nome da diretoria, parabenizo pela conduta exemplar durante os acontecimentos da última noite. A central de São Sotero manteve as comunicações das autoridades quando mais se precisou delas. Esse serviço não será esquecido.\n\nAtenciosamente,\nO Supervisor"
msgstr "A la operadora del turno de noche:\n\nEn nombre de la dirección, la felicito por su conducta ejemplar durante los acontecimientos de anoche. La central de São Sotero mantuvo las comunicaciones de las autoridades cuando más se las necesitó. Ese servicio no será olvidado.\n\nAtentamente,\nEl Supervisor"

#: data/nights/night_16.tres
msgid "Maria atende até o fim do turno. Nenhuma linha pede socorro. Lá fora, a bandeira continua na varanda.\n\nDe manhã, antes de dormir, ela passa no Hospital São Lucas com uma caneta no bolso: tem um gesso esperando a assinatura dela. No corredor da ala 3C, Sebastião visita os feridos da madrugada. Ele segura a porta do quarto para ela e espera do lado de fora."
msgstr "Maria atiende hasta el final del turno. Ninguna línea pide auxilio. Afuera, la bandera sigue en el balcón.\n\nPor la mañana, antes de dormir, pasa por el Hospital São Lucas con una lapicera en el bolsillo: hay un yeso esperando su firma. En el pasillo del pabellón 3C, Sebastião visita a los heridos de la madrugada. Le sostiene la puerta del cuarto y espera afuera."

#: data/nights/night_16.tres
msgid "Maria atende até o fim do turno. Sebastião não liga. No jornal, a vitória ocupa a primeira página; os nomes dos que não voltaram, a segunda inteira.\n\nDe manhã, ela passa no Hospital São Lucas para assinar um gesso na ala 3C. No corredor, Sebastião está sentado num banco, de chapéu na mão. Ele se levanta quando a vê e não diz nada."
msgstr "Maria atiende hasta el final del turno. Sebastião no llama. En el diario, la victoria ocupa la primera plana; los nombres de los que no volvieron, toda la segunda.\n\nPor la mañana, pasa por el Hospital São Lucas a firmar un yeso en el pabellón 3C. En el pasillo, Sebastião está sentado en un banco, con el sombrero en la mano. Se levanta al verla y no dice nada."

#: data/nights/night_16.tres
msgid "Maria atende até o fim do turno. Nenhuma linha pede socorro. Lá fora, a bandeira continua na varanda."
msgstr "Maria atiende hasta el final del turno. Ninguna línea pide auxilio. Afuera, la bandera sigue en el balcón."

#: data/nights/night_16.tres
msgid "Maria atende até o fim do turno. Sebastião não liga. No jornal, a vitória ocupa a primeira página; os nomes dos que não voltaram, a segunda inteira."
msgstr "Maria atiende hasta el final del turno. Sebastião no llama. En el diario, la victoria ocupa la primera página; los nombres de los que no volvieron, toda la segunda."

#: data/nights/night_16.tres
msgid "Na semana seguinte, Maria recebe a medalha de uniforme. A central de São Sotero continua funcionando, como sempre."
msgstr "La semana siguiente, Maria recibe la medalla de uniforme. La central de São Sotero sigue funcionando, como siempre."

#: data/calls/story_16_sebastiao.tres
msgid "Central 3? Sou eu. Sebastião."
msgstr "¿Central 3? Soy yo. Sebastião."

#: data/calls/story_16_sebastiao.tres
msgid "Não é nada urgente. Pela primeira vez, não é nada urgente."
msgstr "No es nada urgente. Por primera vez, no es nada urgente."

#: data/calls/story_16_sebastiao.tres
msgid "Que bom ouvir sua voz."
msgstr "Qué bueno oír tu voz."

#: data/calls/story_16_sebastiao.tres
msgid "Está tudo bem aí?"
msgstr "¿Está todo bien por ahí?"

#: data/calls/story_16_sebastiao.tres
msgid "Está. A rádio toca o que quer desde cedo. Tem gente na praça que não dormiu."
msgstr "Sí. La radio toca lo que quiere desde temprano. Hay gente en la plaza que no durmió."

#: data/calls/story_16_sebastiao.tres
msgid "Liguei só pra dizer que hoje a noite é sua. Atenda as ligações, como sempre."
msgstr "Solo llamé para decirte que esta noche es tuya. Atiende las llamadas, como siempre."

#: data/calls/story_16_sebastiao.tres
msgid "Seu pai ia gostar de ver."
msgstr "A tu padre le habría gustado verlo."

#: data/calls/story_16_mae_cecilia.tres
msgid "Mãe de Cecília"
msgstr "Madre de Cecília"

#: data/calls/story_16_mae_cecilia.tres
msgid "Boa noite. Desculpe a hora. Quem atende aí... é quem trabalhava com a Cecília?"
msgstr "Buenas noches. Perdone la hora. Quien atiende ahí... ¿es quien trabajaba con Cecília?"

#: data/calls/story_16_mae_cecilia.tres
msgid "Sou eu. Ela me ensinou tudo."
msgstr "Soy yo. Ella me enseñó todo."

#: data/calls/story_16_mae_cecilia.tres
msgid "Sim. Quem fala?"
msgstr "Sí. ¿Quién habla?"

#: data/calls/story_16_mae_cecilia.tres
msgid "Aqui é a mãe dela."
msgstr "Habla su madre."

#: data/calls/story_16_mae_cecilia.tres
msgid "Passei o dia inteiro na janela. Vi a bandeira, vi o povo cantando na rua. E só conseguia pensar nela."
msgstr "Pasé el día entero en la ventana. Vi la bandera, vi a la gente cantando en la calle. Y solo podía pensar en ella."

#: data/calls/story_16_mae_cecilia.tres
msgid "Ela vinha jantar aos domingos e só falava da central. Dizia: \"Mãe, a mesa ficou em boas mãos.\""
msgstr "Venía a cenar los domingos y solo hablaba de la central. Decía: \"Mamá, la mesa quedó en buenas manos.\""

#: data/calls/story_16_mae_cecilia.tres
msgid "Ontem bateu aqui um rapaz. Me contou o que você fez naquela mesa."
msgstr "Ayer vino un muchacho a mi puerta. Me contó lo que hiciste en esa mesa."

#: data/calls/story_16_mae_cecilia.tres
msgid "Ela não morreu à toa, Maria. Você não deixou."
msgstr "No murió en vano, Maria. Tú no lo permitiste."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu fiz por ela."
msgstr "Lo hice por ella."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu conheci o seu pai, sabia? O Cristóvão. Ele ia estar tão feliz hoje."
msgstr "Conocí a tu padre, ¿sabías? A Cristóvão. Estaría tan feliz hoy."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu tenho tanto orgulho de você. Como se fosse da minha casa."
msgstr "Estoy tan orgullosa de ti. Como si fueras de mi casa."

#: data/calls/story_16_mae_cecilia.tres
msgid "Venha tomar um café comigo um dia. Guardei o casaco que ela usava na central. Acho que ela ia querer que ficasse com você."
msgstr "Ven a tomar un café conmigo algún día. Guardé el abrigo que usaba en la central. Creo que ella querría que lo tuvieras tú."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu vou."
msgstr "Iré."

#: data/calls/story_16_mae_cecilia.tres
msgid "Obrigada. Por tudo."
msgstr "Gracias. Por todo."

#: data/calls/story_16_mae_cecilia.tres
msgid "Boa noite. Cuide bem da mesa dela."
msgstr "Buenas noches. Cuida bien de su mesa."

#: data/calls/story_16_mae_cecilia.tres
msgid "Hoje cedo vi a bandeira na varanda e chorei feito criança."
msgstr "Esta mañana vi la bandera en el balcón y lloré como una niña."

#: data/calls/story_16_mae_cecilia.tres
msgid "Me disseram que ela ajudou a cidade. E que quem estava na central ajudou também."
msgstr "Me dijeron que ella ayudó a la ciudad. Y que quien estaba en la central ayudó también."

#: data/calls/story_16_mae_cecilia.tres
msgid "O jornal trouxe os nomes de quem não voltou. Tanto nome... Mas ganhamos, não é? Ganhamos."
msgstr "El periódico trajo los nombres de los que no volvieron. Tantos nombres... Pero ganamos, ¿no? Ganamos."

#: data/calls/story_16_mae_cecilia.tres
msgid "Ganhamos."
msgstr "Ganamos."

#: data/calls/story_16_mae_cecilia.tres
msgid "Obrigada pelo que você fez por ela. Ela confiava em você."
msgstr "Gracias por lo que hiciste por ella. Confiaba en ti."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu só queria ouvir alguém daí. Boa noite."
msgstr "Solo quería oír a alguien de ahí. Buenas noches."

#: data/calls/story_16_mae_cecilia.tres
msgid "Eu sei que essa linha é escutada. Não me importa mais."
msgstr "Sé que esta línea está intervenida. Ya no me importa."

#: data/calls/story_16_mae_cecilia.tres
msgid "Da última vez que veio em casa, ela me disse: \"Mãe, pode ficar tranquila. A mesa está em boas mãos.\""
msgstr "La última vez que vino a casa, me dijo: \"Mamá, quédate tranquila. La mesa está en buenas manos.\""

#: data/calls/story_16_mae_cecilia.tres
msgid "Ela acreditou em você até o fim. Até quando vieram buscar ela."
msgstr "Creyó en ti hasta el final. Hasta cuando vinieron a buscarla."

#: data/calls/story_16_mae_cecilia.tres
msgid "Sente. Eu também sinto. Toda noite, quando ponho a mesa e sobra um prato."
msgstr "Lo sientes. Yo también. Cada noche, cuando pongo la mesa y sobra un plato."

#: data/calls/story_16_mae_cecilia.tres
msgid "Hoje passou um carro de som falando em paz e ordem. Os vizinhos fecharam as janelas. Ninguém diz o nome dela."
msgstr "Hoy pasó un coche con altavoz hablando de paz y orden. Los vecinos cerraron las ventanas. Nadie dice su nombre."

#: data/calls/story_16_mae_cecilia.tres
msgid "Ela morreu por nada. Por nada. E você aí, atendendo como se fosse uma noite qualquer."
msgstr "Murió por nada. Por nada. Y tú ahí, atendiendo como si fuera una noche cualquiera."

#: data/calls/story_16_mae_cecilia.tres
msgid "Me perdoe."
msgstr "Perdóname."

#: data/calls/story_16_mae_cecilia.tres
msgid "Não sou eu quem tem que perdoar. Boa noite."
msgstr "No soy yo quien tiene que perdonar. Buenas noches."

#: data/calls/story_16_cupula.tres
msgid "Central 3, aqui fala a Alta Cúpula."
msgstr "Central 3, habla la Alta Cúpula."

#: data/calls/story_16_cupula.tres
msgid "A diretoria encaminhou o relatório de ontem. A colaboração desta mesa foi decisiva para conter os insurgentes."
msgstr "La dirección envió el informe de ayer. La colaboración de esta mesa fue decisiva para contener a los insurgentes."

#: data/calls/story_16_cupula.tres
msgid "Na semana que vem haverá uma condecoração. Compareça de uniforme."
msgstr "La semana que viene habrá una condecoración. Preséntese de uniforme."

#: data/calls/story_16_cupula.tres
msgid "Sim, senhor."
msgstr "Sí, señor."

#: data/calls/story_16_cupula.tres
msgid "É só isso. Bom turno."
msgstr "Eso es todo. Buen turno."

#: data/calls/story_16_miguel.tres
msgid "Maria! É o Miguel!"
msgstr "¡Maria! ¡Es Miguel!"

#: data/calls/story_16_miguel.tres
msgid "Moça da central! É o Miguel!"
msgstr "¡Señorita de la central! ¡Es Miguel!"

#: data/calls/story_16_miguel.tres
msgid "O meu irmão saiu ontem de noite e ainda não voltou. Ele ligou aí? Ele disse que, quando acabasse, ligava."
msgstr "Mi hermano salió anoche y todavía no volvió. ¿Llamó ahí? Dijo que, cuando terminara, llamaba."

#: data/calls/story_16_miguel.tres
msgid "Disseram no rádio que soltaram todo mundo da cadeia hoje cedo. A mãe foi buscar o meu irmão. Ele ligou aí?"
msgstr "Dijeron en la radio que soltaron a todos de la cárcel hoy temprano. Mamá fue a buscar a mi hermano. ¿Llamó ahí?"

#: data/calls/story_16_miguel.tres
msgid "O meu irmão saiu ontem de noite e não voltou. Ele ligou aí?"
msgstr "Mi hermano salió anoche y no volvió. ¿Llamó ahí?"

#: data/calls/story_16_miguel.tres
msgid "Ainda não. Mas vai ligar."
msgstr "Todavía no. Pero va a llamar."

#: data/calls/story_16_miguel.tres
msgid "Não ligou, Miguel."
msgstr "No llamó, Miguel."

#: data/calls/story_16_miguel.tres
msgid "Não, Miguel. Ninguém ligou."
msgstr "No, Miguel. Nadie llamó."

#: data/calls/story_16_miguel.tres
msgid "A rádio disse que acabou, que agora pode tudo. Então ele vai ligar, né?"
msgstr "La radio dijo que se terminó, que ahora se puede todo. Entonces va a llamar, ¿no?"

#: data/calls/story_16_miguel.tres
msgid "Ó! Bateram na porta! Deve ser ele!"
msgstr "¡Oh! ¡Golpearon la puerta! ¡Debe ser él!"

#: data/calls/story_16_miguel.tres
msgid "Quando ele chegar, eu mando ele ligar pra você agradecer!"
msgstr "¡Cuando llegue, le digo que la llame para agradecerle!"

#: data/calls/story_16_miguel.tres
msgid "E não esquece do gesso! Amanhã de manhã, no São Lucas!"
msgstr "¡Y no se olvide del yeso! ¡Mañana por la mañana, en el São Lucas!"

#: data/calls/story_16_miguel.tres data/calls/prank_09_menino.tres
msgid "Tchau!"
msgstr "¡Chau!"

#: data/calls/story_16_miguel.tres
msgid "A rádio só fala que acabou a baderna. A mãe não sai da janela."
msgstr "La radio solo dice que se acabó el desorden. Mamá no se aparta de la ventana."

#: data/calls/story_16_miguel.tres
msgid "Se ele ligar, você me avisa? Eu fico aqui do lado do telefone."
msgstr "Si llama, ¿me avisa? Yo me quedo aquí al lado del teléfono."

#: data/calls/story_16_generosa.tres
msgid "Boa noite! Aqui é a Generosa Prates. A da fita amarela, lembra?"
msgstr "¡Buenas noches! Habla Generosa Prates. La de la cinta amarilla, ¿se acuerda?"

#: data/calls/story_16_generosa.tres
msgid "O Otávio está bem! O médico disse que ele tem alta na semana que vem."
msgstr "¡Otávio está bien! El médico dijo que le dan el alta la semana que viene."

#: data/calls/story_16_generosa.tres
msgid "Ele pediu pra eu ligar e agradecer. Disse que a moça da central é a madrinha da gente."
msgstr "Me pidió que llamara para agradecerle. Dijo que la señorita de la central es nuestra madrina."

#: data/calls/story_16_generosa.tres
msgid "Madrinha? Que honra."
msgstr "¿Madrina? Qué honor."

#: data/calls/story_16_generosa.tres
msgid "Fico feliz, Generosa."
msgstr "Me alegro, Generosa."

#: data/calls/story_16_generosa.tres
msgid "Quando ele sair, a primeira música é por nossa conta. Boa noite!"
msgstr "Cuando salga, la primera canción corre por nuestra cuenta. ¡Buenas noches!"

#: data/calls/story_16_generosa_hospital.tres
msgid "O Hospital São Lucas."
msgstr "El Hospital São Lucas."

#: data/calls/story_16_generosa_hospital.tres
msgid "Quero saber o horário de visita."
msgstr "Quiero saber el horario de visitas."

#: data/calls/story_16_generosa_hospital.tres
msgid "O São Lucas."
msgstr "El São Lucas."

#: data/calls/story_16_generosa_hospital.tres
msgid "Hospital São Lucas."
msgstr "Hospital São Lucas."

#: data/calls/story_16_generosa_hospital.tres
msgid "O horário de visita da ala 3C."
msgstr "El horario de visitas del pabellón 3C."

#: data/calls/story_16_generosa_hospital.tres
msgid "Das duas às quatro. Só parente."
msgstr "De dos a cuatro. Solo parientes."

#: data/calls/story_16_generosa_hospital.tres
msgid "Eu sou a noiva dele."
msgstr "Soy su novia."

#: data/calls/story_16_generosa_hospital.tres
msgid "Então traga um documento."
msgstr "Entonces traiga un documento."

#: data/calls/story_16_generosa_hospital.tres
msgid "Ocupado? ...Tenta de novo, por favor."
msgstr "¿Ocupado? ...Intente de nuevo, por favor."

#: data/nights/night_16.tres
msgid "São Sotero amanhece livre: a emissora e a rádio nas mãos do povo; a praça cheia desde cedo"
msgstr "São Sotero amanece libre: la emisora y la radio en manos del pueblo; la plaza llena desde temprano"

#: data/nights/night_16.tres
msgid "A vitória custou caro: a lista dos que não voltaram ocupa a página inteira"
msgstr "La victoria costó cara: la lista de los que no volvieron ocupa la página entera"

#: data/nights/night_16.tres
msgid "São Sotero amanhece livre: a emissora e a rádio nas mãos do povo"
msgstr "São Sotero amanece libre: la emisora y la radio en manos del pueblo"

#: data/nights/night_16.tres
msgid "Insurgentes contidos na madrugada: a ordem segue garantida em São Sotero"
msgstr "Insurgentes contenidos en la madrugada: el orden sigue garantizado en São Sotero"

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Dona Lurdes"
msgstr "Dona Lurdes"

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Poderia me conectar com a farmácia? A de plantão. Meu neto está com febre."
msgstr "¿Podría comunicarme con la farmacia? La de turno. Mi nieto tiene fiebre."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "A farmácia de plantão, moça. A que fica aberta de noite."
msgstr "La farmacia de turno, joven. La que abre de noche."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Obrigada, minha filha. Deus te abençoe."
msgstr "Gracias, hija. Dios la bendiga."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Boa noite. Meu neto está com febre, e alta."
msgstr "Buenas noches. Mi nieto tiene fiebre, y alta."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Quantos anos tem o menino, senhora?"
msgstr "¿Cuántos años tiene el niño, señora?"

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Seis. Está mole, não quer nem água."
msgstr "Seis. Está decaído, no quiere ni agua."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Tenho um antitérmico em gotas. Mando o rapaz levar aí."
msgstr "Tengo un antifebril en gotas. Le mando al muchacho a llevarlo."

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Deus lhe pague. E se a febre não baixar?"
msgstr "Dios se lo pague. ¿Y si la fiebre no baja?"

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Aí chama o médico. Mas dá banho morno, que ajuda."
msgstr "Entonces llame al médico. Pero un baño tibio ayuda."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Sr. Nelson"
msgstr "Sr. Nelson"

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres data/calls/transfer_26_dona_fatima_hotel_estrela.tres data/templates/transfer_07.tres
msgid "Boa noite, central."
msgstr "Buenas noches, central."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Me liga com o Hotel Serena, por favor? Meu irmão chegou hoje da capital e está hospedado lá."
msgstr "¿Me comunica con el Hotel Serena, por favor? Mi hermano llegó hoy de la capital y se está quedando ahí."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "O Hotel Serena. Na avenida."
msgstr "El Hotel Serena. En la avenida."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Muito obrigado."
msgstr "Muchas gracias."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Boa noite. Meu irmão está hospedado aí. Chegou hoje da capital."
msgstr "Buenas noches. Mi hermano está alojado ahí. Llegó hoy de la capital."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "O moço de terno, do quarto doze? Vou chamar."
msgstr "¿El señor de traje, de la doce? Ya lo llamo."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Nelson? É você? Fez boa viagem?"
msgstr "¿Nelson? ¿Eres tú? ¿Buen viaje?"

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Cansativa, mas cheguei. Amanhã cedo passo aí."
msgstr "Cansador, pero llegué. Mañana temprano paso por ahí."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Vem pro café. A Lourdes vai fazer bolo."
msgstr "Ven a desayunar. Lourdes va a hacer pastel."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Preciso de um táxi. Me conecta com o ponto da rodoviária?"
msgstr "Necesito un taxi. ¿Me comunica con la parada de la terminal?"

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "O ponto de táxi. Da rodoviária."
msgstr "La parada de taxis. De la terminal."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres data/calls/transfer_29_rapaz_cine_odeon.tres data/content.tres
msgid "Valeu, central."
msgstr "Gracias, central."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Boa noite. Preciso de um táxi."
msgstr "Buenas noches. Necesito un taxi."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Pra onde, rapaz?"
msgstr "¿Adónde, muchacho?"

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Pra Vila Serena, pra casa da minha namorada. Estou atrasado."
msgstr "A Vila Serena, a casa de mi novia. Estoy atrasado."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "O carro está saindo agora. Espera na calçada."
msgstr "El auto sale ahora. Espere en la vereda."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Ele demora muito?"
msgstr "¿Tarda mucho?"

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
msgid "Dez minutos. Vai arrumando o cabelo."
msgstr "Diez minutos. Vaya arreglándose el pelo."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Dona Zilda"
msgstr "Dona Zilda"

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Boa noite, querida."
msgstr "Buenas noches, querida."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Quero falar com a Padaria Pão Dourado. É pra encomendar o pão de amanhã cedo."
msgstr "Quiero hablar con la Padaria Pão Dourado. Es para encargar el pan de mañana temprano."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "A Pão Dourado. A padaria."
msgstr "La Pão Dourado. La panadería."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Boa noite, querido. É a Zilda. Quero o pão de amanhã cedo."
msgstr "Buenas noches, querido. Es Zilda. Quiero el pan de mañana temprano."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "O de sempre, Dona Zilda? Doze pãezinhos?"
msgstr "¿Lo de siempre, doña Zilda? ¿Doce panecillos?"

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Dezoito. Meus netos chegam amanhã."
msgstr "Dieciocho. Mañana llegan mis nietos."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Então mando uma rosca de presente pra eles."
msgstr "Entonces les mando una rosca de regalo."

#: data/calls/transfer_04_dona_zilda_padaria_pao_dourado.tres
msgid "Ai, que gentileza. Busco às seis."
msgstr "Ay, qué amable. Lo busco a las seis."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Rapaz apaixonado"
msgstr "Muchacho enamorado"

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Boa noite!"
msgstr "¡Buenas noches!"

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Me liga com a Rádio Serena? Quero pedir uma música pra minha noiva."
msgstr "¿Me comunica con Rádio Serena? Quiero pedir una canción para mi novia."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "A rádio. A Serena AM."
msgstr "La radio. La Serena AM."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Valeu! Ela vai ouvir, tenho certeza."
msgstr "¡Gracias! Ella la va a escuchar, estoy seguro."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Boa noite! Queria pedir uma música pra minha noiva."
msgstr "¡Buenas noches! Quería pedir una canción para mi novia."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Pois não. Qual música e o nome dela?"
msgstr "Cómo no. ¿Qué canción y cómo se llama?"

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "A Valsa da Despedida. Ela se chama Helena."
msgstr "El Vals de la Despedida. Se llama Helena."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Despedida? Vocês brigaram?"
msgstr "¿Despedida? ¿Se pelearon?"

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Não! Ela viaja amanhã pra estudar na capital."
msgstr "¡No! Mañana viaja a estudiar a la capital."

#: data/calls/transfer_05_rapaz_apaixonado_radio_serena_am.tres
msgid "Então vai ao ar depois do noticiário. Escuta com ela."
msgstr "Entonces sale al aire después del noticiero. Escúchela con ella."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Caminhoneiro"
msgstr "Camionero"

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Meu caminhão morreu perto do moinho. O Tião da oficina atende de noite, não atende?"
msgstr "Se me paró el camión cerca del molino. Tião, el del taller, atiende de noche, ¿no?"

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "A oficina do Tião. Na Rua do Moinho."
msgstr "El taller de Tião. En la Rua do Moinho."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres data/calls/transfer_23_dona_aurora_igreja_matriz.tres data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Deus lhe pague."
msgstr "Dios se lo pague."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Tião? Meu caminhão morreu perto do moinho."
msgstr "¿Tião? Se me murió el camión cerca del molino."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Morreu como? Fez barulho antes?"
msgstr "¿Cómo se murió? ¿Hizo ruido antes?"

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Tossiu umas três vezes e apagou. Agora nem pega."
msgstr "Tosió unas tres veces y se apagó. Ahora ni arranca."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Deve ser o filtro de diesel. Vou aí com a caminhonete."
msgstr "Debe ser el filtro de gasoil. Voy con la camioneta."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Estou com o pisca ligado, do lado da ponte."
msgstr "Tengo las balizas puestas, al lado del puente."

#: data/calls/transfer_06_caminhoneiro_oficina_do_tiao.tres
msgid "Em meia hora chego. Não sai da cabine, que está frio."
msgstr "En media hora llego. No salga de la cabina, que hace frío."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Motorista"
msgstr "Chofer"

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "O posto da Rua da Estação ainda está aberto?"
msgstr "¿La gasolinera de la Rua da Estação sigue abierta?"

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Me conecta lá, por favor. Tô quase sem gasolina."
msgstr "Comuníqueme ahí, por favor. Casi no me queda gasolina."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "O Posto São Cristóvão."
msgstr "El Posto São Cristóvão."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Obrigado, central."
msgstr "Gracias, central."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Ainda está aberto? Estou quase sem gasolina."
msgstr "¿Todavía está abierto? Estoy casi sin gasolina."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Fecho às dez. Você está onde?"
msgstr "Cierro a las diez. ¿Dónde está?"

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Na saída da cidade. O ponteiro já está no vermelho."
msgstr "A la salida del pueblo. La aguja ya está en rojo."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Dá pra chegar. Vem devagar, sem acelerar muito."
msgstr "Llega. Venga despacio, sin acelerar mucho."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Me espera, pelo amor de Deus."
msgstr "Espéreme, por el amor de Dios."

#: data/calls/transfer_07_motorista_posto_sao_cristovao.tres
msgid "Espero. Deixo a luz da bomba acesa."
msgstr "Lo espero. Dejo encendida la luz del surtidor."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres data/content.tres
msgid "Dona Cida"
msgstr "Dona Cida"

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Boa noite, meu bem."
msgstr "Buenas noches, cariño."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Quero saber que filme passa amanhã. Me passa pro cinema?"
msgstr "Quiero saber qué película pasan mañana. ¿Me pasa con el cine?"

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "O Cine Odeon, na avenida."
msgstr "El Cine Odeon, en la avenida."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Obrigada, meu bem."
msgstr "Gracias, cariño."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Boa noite, meu bem. Que filme passa amanhã?"
msgstr "Buenas noches, querido. ¿Qué película dan mañana?"

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Amanhã é um faroeste, na sessão das sete e das nove."
msgstr "Mañana es una del oeste, a las siete y a las nueve."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Faroeste? Tem muito tiro?"
msgstr "¿Del oeste? ¿Hay muchos tiros?"

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Alguns. Mas tem um romance no meio."
msgstr "Algunos. Pero tiene un romance en el medio."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Então eu vou na das sete, com a minha irmã."
msgstr "Entonces voy a la de las siete, con mi hermana."

#: data/calls/transfer_08_dona_cida_cine_odeon.tres
msgid "Chega cedo, que as poltronas do meio acabam logo."
msgstr "Llegue temprano, que las butacas del medio se acaban rápido."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Boa noite..."
msgstr "Buenas noches..."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Preciso falar com a funerária. Meu pai faleceu agora há pouco."
msgstr "Necesito hablar con la funeraria. Mi padre falleció hace un rato."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "A funerária. A Paz Eterna."
msgstr "La funeraria. La Paz Eterna."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Boa noite... Meu pai faleceu agora há pouco."
msgstr "Buenas noches... Mi padre falleció hace un rato."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Meus sentimentos, senhor. Ele estava em casa?"
msgstr "Mi más sentido pésame, señor. ¿Estaba en casa?"

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Estava. Dormiu na poltrona e não acordou."
msgstr "Sí. Se durmió en el sillón y no despertó."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "O médico já veio ver?"
msgstr "¿Ya vino el médico?"

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Já. Deu o atestado. Agora não sei o que fazer."
msgstr "Sí. Firmó el certificado. Ahora no sé qué hacer."

#: data/calls/transfer_09_senhor_funeraria_paz_eterna.tres
msgid "Deixa com a gente. Em uma hora estamos aí."
msgstr "Déjelo en nuestras manos. En una hora estamos ahí."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Dona Neide"
msgstr "Dona Neide"

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Me liga com o Bar do Zé."
msgstr "Comuníqueme con el Bar do Zé."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Meu marido disse que ia ficar só uma hora. Já faz três."
msgstr "Mi marido dijo que se quedaba solo una hora. Ya van tres."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "O Bar do Zé! Na Rua da Estação."
msgstr "¡El Bar do Zé! En la Rua da Estação."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Ah, ele vai ver só."
msgstr "Ay, ya va a ver."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Zé, é a Neide. O meu marido ainda está aí?"
msgstr "Zé, soy Neide. ¿Mi marido sigue ahí?"

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Está, Dona Neide. No dominó, com os amigos."
msgstr "Sí, doña Neide. En el dominó, con los amigos."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Ele disse uma hora. Já faz três!"
msgstr "¡Dijo una hora. Ya van tres!"

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Quer que eu chame ele no telefone?"
msgstr "¿Quiere que lo llame al teléfono?"

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Não precisa. Fala que a janta está no fogão, fria."
msgstr "No hace falta. Dígale que la cena está en la cocina, fría."

#: data/calls/transfer_10_dona_neide_bar_do_ze.tres
msgid "Falo, sim. E fecho a conta dele agora mesmo."
msgstr "Se lo digo. Y le cierro la cuenta ahora mismo."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres data/content.tres
msgid "Morador"
msgstr "Residente"

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Preciso falar com o Dr. Almeida."
msgstr "Necesito hablar con el Dr. Almeida."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "O Dr. Almeida. O médico, do hospital."
msgstr "El Dr. Almeida. El médico, el del hospital."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Doutor, boa noite. Desculpa a hora."
msgstr "Doctor, buenas noches. Disculpe la hora."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Pode falar. Quem é?"
msgstr "Hable. ¿Quién es?"

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Aqui é da casa do lado da escola. Minha mulher torceu o pé."
msgstr "De la casa al lado de la escuela. Mi mujer se torció el pie."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Inchou muito? Ela consegue apoiar?"
msgstr "¿Se hinchó mucho? ¿Puede apoyarlo?"

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Inchou um pouco. Apoiar, até apoia."
msgstr "Un poco hinchado. Apoyar, lo apoya."

#: data/calls/transfer_11_morador_dr_augusto_almeida.tres
msgid "Gelo e pé pra cima. Amanhã cedo eu passo aí."
msgstr "Hielo y el pie en alto. Mañana temprano paso."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Sra. Marta"
msgstr "Sra. Marta"

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Por favor, a Dona Célia Rocha."
msgstr "Con Dona Célia Rocha, por favor."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "A da Rua do Sol. Não a outra."
msgstr "La de la Rua do Sol. No la otra."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Célia Rocha, a da Rua do Sol."
msgstr "Célia Rocha, la de la Rua do Sol."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Célia Rocha (Rua do Sol)"
msgstr "Célia Rocha (Rua do Sol)"

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Célia? É a Marta. Desculpa a hora."
msgstr "¿Célia? Soy Marta. Perdón la hora."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Marta! Aconteceu alguma coisa?"
msgstr "¡Marta! ¿Pasó algo?"

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Nada. Só queria a receita daquele doce de abóbora."
msgstr "Nada. Solo quería la receta de aquel dulce de calabaza."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "A essa hora? Vai fazer agora?"
msgstr "¿A esta hora? ¿Lo vas a hacer ahora?"

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Amanhã cedo. A abóbora já está cortada aqui."
msgstr "Mañana temprano. La calabaza ya está cortada aquí."

#: data/calls/transfer_12_sra_marta_celia_rocha_rua_do_sol.tres
msgid "Então pega um papel, que eu vou ditando."
msgstr "Entonces toma un papel, que te lo dicto."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Sr. Ivo"
msgstr "Sr. Ivo"

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Me liga com o Joaquim Ferreira."
msgstr "Comuníqueme con Joaquim Ferreira."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "O do armazém. Não o outro."
msgstr "El del almacén. No el otro."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Joaquim Ferreira, do armazém."
msgstr "Joaquim Ferreira, el del almacén."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Tá certo, obrigado."
msgstr "Está bien, gracias."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Joaquim, é o Ivo. Você ainda tem querosene?"
msgstr "Joaquim, soy Ivo. ¿Todavía tienes queroseno?"

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Tenho um pouco. Pra que, a essa hora?"
msgstr "Un poco. ¿Para qué, a esta hora?"

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Meu lampião secou, e a luz aqui é fraca de noite."
msgstr "Se me secó el farol, y la luz aquí es floja de noche."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Vem pela porta dos fundos. Traz a garrafa."
msgstr "Venga por la puerta de atrás. Traiga la botella."

#: data/calls/transfer_13_sr_ivo_armazem_ferreira.tres
msgid "Chego já. E anota na minha conta, viu?"
msgstr "Ya llego. Y anótelo en mi cuenta, eh."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Boa noite. Preciso falar com o Padre Anselmo."
msgstr "Buenas noches. Necesito hablar con el padre Anselmo."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "É sobre a missa de sétimo dia. Ele deve estar em casa."
msgstr "Es por la misa de séptimo día. Debe estar en su casa."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "O Padre Anselmo. Na casa dele, não na igreja."
msgstr "El padre Anselmo. En su casa, no en la iglesia."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Boa noite, padre. É sobre a missa de sétimo dia do meu marido."
msgstr "Buenas noches, padre. Es por la misa de séptimo día de mi marido."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Meus pêsames, minha filha. Quer pra quando?"
msgstr "Mi pésame, hija. ¿Para cuándo la quiere?"

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Pra sexta. Ele gostava da missa da tarde."
msgstr "Para el viernes. A él le gustaba la misa de la tarde."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Sexta, às cinco. Eu mesmo celebro."
msgstr "El viernes a las cinco. La celebro yo mismo."

#: data/calls/transfer_14_senhora_casa_paroquial.tres
msgid "Obrigada, padre. Ele ia ficar contente."
msgstr "Gracias, padre. Él se habría puesto contento."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Vizinho"
msgstr "Vecino"

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Quero falar com o seu Almeida."
msgstr "Quiero hablar con Seu Almeida."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "O Otávio, da Rua da Estação. Não é o doutor."
msgstr "Otávio, el de la Rua da Estação. No el doctor."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Otávio Almeida. Rua da Estação."
msgstr "Otávio Almeida. Rua da Estação."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres data/content.tres
msgid "Isso, obrigado."
msgstr "Eso, gracias."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Seu Otávio? É o vizinho da frente. Desculpa a hora."
msgstr "¿Don Otávio? Soy el vecino de enfrente. Perdón la hora."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Pode falar. Aconteceu alguma coisa?"
msgstr "Hable. ¿Pasó algo?"

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Seu portão ficou aberto e o cachorro saiu pra rua."
msgstr "Quedó abierto su portón y el perro salió a la calle."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "O Trovão? De novo? Ele foi pra que lado?"
msgstr "¿Trovão? ¿Otra vez? ¿Para qué lado fue?"

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Pro lado da estação. Correndo atrás de um gato."
msgstr "Para el lado de la estación. Corriendo detrás de un gato."

#: data/calls/transfer_15_vizinho_otavio_almeida.tres
msgid "Vou buscar. Obrigado por avisar."
msgstr "Voy a buscarlo. Gracias por avisar."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Sobrinha"
msgstr "Sobrina"

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "A Dona Célia Rocha, por favor."
msgstr "Con Dona Célia Rocha, por favor."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "A que mora na avenida. Minha tia."
msgstr "La que vive en la avenida. Mi tía."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Célia Rocha. A da avenida."
msgstr "Célia Rocha. La de la avenida."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Célia Rocha (Av. Brasil)"
msgstr "Célia Rocha (Av. Brasil)"

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Tia? É a sua sobrinha. Tudo bem por aí?"
msgstr "¿Tía? Soy tu sobrina. ¿Todo bien por ahí?"

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Ah, minha querida! Tudo. E sua mãe?"
msgstr "¡Ay, querida! Todo bien. ¿Y tu mamá?"

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Melhorou. Mandou perguntar se a senhora vem no domingo."
msgstr "Mejoró. Mandó preguntar si usted viene el domingo."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Vou, sim. Levo o pudim que ela gosta."
msgstr "Sí, voy. Llevo el budín que le gusta."

#: data/calls/transfer_16_sobrinha_celia_rocha_av_brasil.tres
msgid "Ela vai adorar. Vou buscar a senhora no ponto."
msgstr "Le va a encantar. La busco en la parada."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Freguês"
msgstr "Cliente"

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "O seu Joaquim Ferreira, por favor."
msgstr "Con Seu Joaquim Ferreira, por favor."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Na casa dele. O armazém já fechou a essa hora."
msgstr "En su casa. El almacén ya cerró a esta hora."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Na casa do Joaquim Ferreira. Não no armazém."
msgstr "En la casa de Joaquim Ferreira. No en el almacén."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Joaquim Ferreira (residência)"
msgstr "Joaquim Ferreira (residencia)"

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Tá certo."
msgstr "Está bien."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Seu Joaquim? Desculpa ligar na sua casa."
msgstr "¿Don Joaquim? Disculpe que lo llame a su casa."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Tudo bem. O que foi?"
msgstr "No hay problema. ¿Qué pasó?"

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Amanhã eu preciso de dez sacos de cimento logo cedo."
msgstr "Mañana necesito diez bolsas de cemento bien temprano."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Dez? Eu só tenho seis. O resto chega na quinta."
msgstr "¿Diez? Solo tengo seis. El resto llega el jueves."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Então separa os seis. A obra não pode parar."
msgstr "Entonces sepáreme las seis. La obra no puede parar."

#: data/calls/transfer_17_fregues_joaquim_ferreira_residencia.tres
msgid "Abro às sete. Pode mandar a carroça."
msgstr "Abro a las siete. Mande la carreta."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Dona Rute"
msgstr "Dona Rute"

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Me liga com o hospital, na recepção."
msgstr "Comuníqueme con el hospital, con recepción."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Não é pra falar com o doutor, é pra marcar horário."
msgstr "No es para hablar con el doctor, es para pedir un turno."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "A recepção do Hospital São Lucas."
msgstr "La recepción del Hospital São Lucas."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Boa noite. Queria marcar horário com o doutor."
msgstr "Buenas noches. Quería pedir turno con el doctor."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Qual o nome da senhora?"
msgstr "¿Su nombre, señora?"

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Rute Fonseca. É pra ver a pressão, que anda variando."
msgstr "Rute Fonseca. Es para ver la presión, que anda variando."

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Tem quinta, às nove da manhã. Serve?"
msgstr "Hay el jueves a las nueve de la mañana. ¿Le sirve?"

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Serve. Preciso ir em jejum?"
msgstr "Sí. ¿Tengo que ir en ayunas?"

#: data/calls/transfer_18_dona_rute_hospital_sao_lucas.tres
msgid "Não precisa. Só traz os exames antigos."
msgstr "No hace falta. Solo traiga los análisis anteriores."

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Gostaria de falar com o número 327."
msgstr "Quisiera hablar con el número 327."

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Três, dois, sete."
msgstr "Tres, dos, siete."

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Boa noite. O Antônio está aí?"
msgstr "Buenas noches. ¿Está Antônio ahí?"

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "O do caminhão? Saiu faz meia hora."
msgstr "¿El del camión? Se fue hace media hora."

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Ele deixou um recado pra mim?"
msgstr "¿Me dejó algún recado?"

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Deixou. Disse que amanhã passa às seis pra pegar a carga."
msgstr "Sí. Dijo que mañana pasa a las seis a buscar la carga."

#: data/calls/transfer_19_homem_bar_do_ze.tres
msgid "Às seis. Está bom, obrigado."
msgstr "A las seis. Está bien, gracias."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Dona Tereza"
msgstr "Dona Tereza"

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Me conecta com o 223, por favor?"
msgstr "¿Me comunica con el 223, por favor?"

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "É da minha comadre."
msgstr "Es de mi comadre."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Dois, dois, três. A Marta."
msgstr "Dos, dos, tres. La de Marta."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Comadre? É a Tereza."
msgstr "¿Comadre? Soy Tereza."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Tereza! Que surpresa boa a essa hora."
msgstr "¡Tereza! Qué linda sorpresa a esta hora."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Amanhã é o aniversário do nosso afilhado. Você lembrou?"
msgstr "Mañana es el cumpleaños de nuestro ahijado. ¿Te acordaste?"

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Lembrei! Já comprei uma bola pra ele."
msgstr "¡Sí! Ya le compré una pelota."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Eu fiz um bolo de chocolate. A gente vai junto?"
msgstr "Yo hice una torta de chocolate. ¿Vamos juntas?"

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Vamos. Passo aí às três."
msgstr "Vamos. Paso por tu casa a las tres."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Oi. O número é 147."
msgstr "Hola. El número es 147."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Da Lúcia Pereira."
msgstr "El de Lúcia Pereira."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Três, três, seis."
msgstr "Tres, tres, seis."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Lúcia? Oi, sou eu."
msgstr "¿Lúcia? Hola, soy yo."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Oi! Achei que você não ia ligar."
msgstr "¡Hola! Pensé que no ibas a llamar."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "A mamãe ficou no telefone a noite toda."
msgstr "Mamá estuvo en el teléfono toda la noche."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "E aí, você vai no baile de sábado?"
msgstr "¿Y entonces, vas al baile del sábado?"

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Vou, se você me emprestar o vestido azul."
msgstr "Voy, si me prestas el vestido azul."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Empresto. Vem buscar amanhã depois da aula."
msgstr "Te lo presto. Ven a buscarlo mañana después de clase."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Seu Aníbal"
msgstr "Seu Aníbal"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Boa noite. Me liga com a Farmácia Central, a da praça?"
msgstr "Buenas noches. ¿Me comunica con la Farmácia Central, la de la plaza?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "A Farmácia Central. Na Praça da Matriz."
msgstr "La Farmácia Central. En la Praça da Matriz."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Boa noite. Preciso de um remédio pra pressão."
msgstr "Buenas noches. Necesito un remedio para la presión."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "O senhor já toma algum? Tem a receita?"
msgstr "¿Ya toma alguno, señor? ¿Tiene la receta?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Tenho, do Dr. Almeida. Acabou ontem e esqueci de comprar."
msgstr "Sí, del Dr. Almeida. Se acabó ayer y me olvidé de comprar."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Então traz a receita, que eu separo a caixa."
msgstr "Entonces traiga la receta, que le separo la caja."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Meu neto vai buscar agora."
msgstr "Mi nieto va a buscarlo ahora."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Estou esperando. E nada de sal na janta, hein?"
msgstr "Lo espero. Y nada de sal en la cena, ¿eh?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Ninguém atende. Quer que eu tente a Santa Rita, de plantão?"
msgstr "Nadie contesta. ¿Quiere que pruebe con la Santa Rita, la de turno?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Pode ser. A Santa Rita serve, obrigado."
msgstr "Puede ser. La Santa Rita sirve, gracias."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Dona Aurora"
msgstr "Dona Aurora"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Preciso falar com a igreja. A Matriz."
msgstr "Necesito hablar con la iglesia. La Matriz."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "É pra pedir uma bênção... minha filha viaja amanhã cedo."
msgstr "Es para pedir una bendición... mi hija viaja mañana temprano."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "A Igreja Matriz."
msgstr "La Igreja Matriz."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Igreja Matriz"
msgstr "Igreja Matriz"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Boa noite. Queria pedir uma bênção pra minha filha."
msgstr "Buenas noches. Quería pedir una bendición para mi hija."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Pois não. Ela está doente?"
msgstr "Cómo no. ¿Está enferma?"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Não, graças a Deus. Viaja amanhã cedo pra capital."
msgstr "No, gracias a Dios. Viaja mañana temprano a la capital."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Ela pode passar antes da missa das seis?"
msgstr "¿Puede pasar antes de la misa de las seis?"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Pode. O ônibus só sai às oito."
msgstr "Sí. El autobús sale recién a las ocho."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Então às cinco e meia, na porta da sacristia."
msgstr "Entonces a las cinco y media, en la puerta de la sacristía."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "A secretaria da igreja não atende. Quer que eu tente a casa do Padre Anselmo?"
msgstr "La secretaría de la iglesia no contesta. ¿Quiere que pruebe en la casa del padre Anselmo?"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Isso, na casa do padre. Obrigada."
msgstr "Sí, en la casa del padre. Gracias."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "A Mercearia Silva ainda atende? O Silva mora nos fundos. Acabou a vela aqui em casa."
msgstr "¿La Mercearia Silva todavía atiende? Silva vive en el fondo. Se acabaron las velas en casa."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "A Mercearia Silva, na Rua do Cruzeiro."
msgstr "La Mercearia Silva, en la Rua do Cruzeiro."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Obrigado. Tá um breu aqui."
msgstr "Gracias. Aquí está oscuro como boca de lobo."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Silva, boa noite. É o Jair. Acabou a vela aqui."
msgstr "Silva, buenas noches. Soy Jair. Se me acabaron las velas."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Faltou luz aí também, seu Jair?"
msgstr "¿Se cortó la luz ahí también, don Jair?"

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Faltou. E eu não enxergo nada no escuro."
msgstr "Sí. Y no veo nada en la oscuridad."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Mando meu filho levar meia dúzia aí."
msgstr "Le mando a mi hijo con media docena."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Deus te pague. Ele bate na janela, que eu escuto."
msgstr "Dios te lo pague. Que golpee la ventana, que lo escucho."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Dona Fátima"
msgstr "Dona Fátima"

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Minha filha chegou no ônibus das dez e foi pro Hotel Serena. Quero saber se ela chegou bem."
msgstr "Mi hija llegó en el autobús de las diez y fue al Hotel Serena. Quiero saber si llegó bien."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "O Hotel Serena, na avenida."
msgstr "El Hotel Serena, en la avenida."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Ai, obrigada. Mãe não dorme, né?"
msgstr "Ay, gracias. Una madre no duerme, ¿no?"

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Boa noite. Minha filha chegou no ônibus das dez. Ela está aí?"
msgstr "Buenas noches. Mi hija llegó en el autobús de las diez. ¿Está ahí?"

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "A moça de chapéu? Chegou, sim. Já subiu pro quarto."
msgstr "¿La joven del sombrero? Sí, llegó. Ya subió a la habitación."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Ai, que alívio. Ela estava bem?"
msgstr "Ay, qué alivio. ¿Estaba bien?"

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Cansada, mas bem. Pediu um chá e foi deitar."
msgstr "Cansada, pero bien. Pidió un té y se fue a acostar."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Então não acorda ela. Amanhã eu ligo de novo."
msgstr "Entonces no la despierte. Mañana llamo otra vez."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Preciso de um carro de praça. O último ônibus sai às onze e eu não posso perder."
msgstr "Necesito un auto de alquiler. El último autobús sale a las once y no lo puedo perder."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Boa noite. Preciso de um carro. O último ônibus sai às onze."
msgstr "Buenas noches. Necesito un auto. El último autobús sale a las once."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Onde a moça está?"
msgstr "¿Dónde está, señorita?"

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Na casa da minha avó, perto da praça."
msgstr "En casa de mi abuela, cerca de la plaza."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Tem um carro voltando pra lá. Chega em dez minutos."
msgstr "Hay un auto volviendo para allá. Llega en diez minutos."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Dá tempo mesmo?"
msgstr "¿Llego de verdad?"

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Dá. O motorista conhece o atalho."
msgstr "Sí. El chofer conoce el atajo."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres data/content.tres
msgid "Dona Olga"
msgstr "Dona Olga"

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Boa noite, minha filha."
msgstr "Buenas noches, hija."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Me liga com a rádio? Quero mandar um recado pro meu filho que trabalha na roça. Ele escuta o programa da noite."
msgstr "¿Me comunica con la radio? Quiero mandarle un recado a mi hijo, que trabaja en el campo. Él escucha el programa de la noche."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "A Rádio Serena."
msgstr "Rádio Serena."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Boa noite, meu filho. Quero mandar um recado pelo rádio."
msgstr "Buenas noches, hijo. Quiero mandar un recado por la radio."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Pode ditar, senhora. Pra quem é?"
msgstr "Dícteme, señora. ¿Para quién es?"

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Pro Zeca, que trabalha na roça do seu Moreira."
msgstr "Para Zeca, que trabaja en la chacra de don Moreira."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "E o recado?"
msgstr "¿Y el recado?"

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Que a irmã dele teve menino. E que venha no domingo."
msgstr "Que su hermana tuvo un varón. Y que venga el domingo."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Lido no programa das dez. Parabéns pelo neto!"
msgstr "Se lee en el programa de las diez. ¡Felicidades por el nieto!"

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Esqueci meu guarda-chuva na sessão das oito. Será que ainda tem alguém no cinema?"
msgstr "Dejé mi paraguas en la función de las ocho. ¿Todavía habrá alguien en el cine?"

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "O Cine Odeon."
msgstr "El Cine Odeon."

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Boa noite. Esqueci meu guarda-chuva na sessão das oito."
msgstr "Buenas noches. Me olvidé el paraguas en la función de las ocho."

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Um preto, de cabo de madeira?"
msgstr "¿Uno negro, con mango de madera?"

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Esse mesmo! Estava na fileira do meio."
msgstr "¡Ese mismo! Estaba en la fila del medio."

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "O lanterninha achou. Está guardado na bilheteria."
msgstr "El acomodador lo encontró. Está guardado en la boletería."

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Passo amanhã pra pegar. Obrigado!"
msgstr "Paso mañana a buscarlo. ¡Gracias!"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Dona Elza"
msgstr "Dona Elza"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Preciso falar com o Doutor Almeida."
msgstr "Necesito hablar con el doctor Almeida."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O médico. A pressão do meu marido subiu e ele mandou ligar se isso acontecesse."
msgstr "El médico. A mi marido le subió la presión y él dijo que llamáramos si pasaba."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O Doutor Almeida, o médico."
msgstr "El doctor Almeida, el médico."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Obrigada. Rápido, viu?"
msgstr "Gracias. Rápido, ¿sí?"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Doutor, é a Elza. A pressão do meu marido subiu."
msgstr "Doctor, soy Elza. A mi marido le subió la presión."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Quanto deu?"
msgstr "¿Cuánto le dio?"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Dezessete por dez. Ele está com dor de cabeça."
msgstr "Diecisiete por diez. Tiene dolor de cabeza."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Dá o comprimido de baixo da língua que eu deixei."
msgstr "Dele la pastilla sublingual que le dejé."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "E se não baixar?"
msgstr "¿Y si no baja?"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Mede de novo em meia hora e me liga. Eu vou aí."
msgstr "Tómela de nuevo en media hora y llámeme. Voy."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Seu Ernesto"
msgstr "Seu Ernesto"

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Boa noite. A Dona Célia Rocha, por favor."
msgstr "Buenas noches. Con Dona Célia Rocha, por favor."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "A que mora perto da escola."
msgstr "La que vive cerca de la escuela."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Célia Rocha. A casa dela é perto da escola."
msgstr "Célia Rocha. Su casa está cerca de la escuela."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Dona Célia? Boa noite, é o Ernesto."
msgstr "¿Doña Célia? Buenas noches, soy Ernesto."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Seu Ernesto! A que devo a honra?"
msgstr "¡Don Ernesto! ¿A qué debo el honor?"

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Queria saber se a reunião da escola é amanhã mesmo."
msgstr "Quería saber si la reunión de la escuela es mañana."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "É, às sete, na sala da diretora."
msgstr "Sí, a las siete, en la sala de la directora."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Então eu levo as cadeiras que prometi."
msgstr "Entonces llevo las sillas que prometí."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Seu Lauro"
msgstr "Seu Lauro"

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Me liga com o seu Ferreira."
msgstr "Comuníqueme con Seu Ferreira."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O do armazém. Deixei minha carteira no balcão hoje de tarde."
msgstr "El del almacén. Dejé mi billetera en el mostrador esta tarde."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O Ferreira do armazém. O Joaquim."
msgstr "Ferreira, el del almacén. Joaquim."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Obrigado, moça. Tomara que ele atenda."
msgstr "Gracias, joven. Ojalá conteste."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Seu Ferreira, é o Lauro. Deixei minha carteira no balcão."
msgstr "Don Ferreira, soy Lauro. Me dejé la billetera en el mostrador."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Uma marrom, gasta? Achei quando fui fechar."
msgstr "¿Una marrón, gastada? La encontré al cerrar."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Essa! Graças a Deus. Tem o meu documento dentro."
msgstr "¡Esa! Gracias a Dios. Adentro está mi documento."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Está tudo aí, guardado na gaveta."
msgstr "Está todo ahí, guardado en el cajón."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Passo amanhã cedo. Você é um homem honesto."
msgstr "Paso mañana temprano. Usted es un hombre honrado."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Me liga com o seu Paulo Nogueira? Ele disse que eu podia ligar a qualquer hora."
msgstr "¿Me comunica con Seu Paulo Nogueira? Dijo que podía llamar a cualquier hora."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira."
msgstr "Paulo Nogueira."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Seu Paulo? Boa noite. O senhor disse que eu podia ligar."
msgstr "¿Don Paulo? Buenas noches. Usted dijo que podía llamar."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Disse. É sobre o serviço na serraria?"
msgstr "Sí. ¿Es por el trabajo en el aserradero?"

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "É. Quero aceitar, se a vaga ainda existir."
msgstr "Sí. Quiero aceptar, si el puesto sigue libre."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Existe. Segunda, às seis, com a carteira de trabalho."
msgstr "Sigue. El lunes a las seis, con la libreta de trabajo."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Estarei lá. Muito obrigado, seu Paulo."
msgstr "Ahí estaré. Muchas gracias, don Paulo."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres data/content.tres
msgid "Seu Valdir"
msgstr "Seu Valdir"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "O 237, por favor."
msgstr "El 237, por favor."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Da Sônia."
msgstr "El de Sônia."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Três, oito, quatro."
msgstr "Tres, ocho, cuatro."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Brigado."
msgstr "Gracias."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Sônia? É o Valdir, do escritório."
msgstr "¿Sônia? Soy Valdir, de la oficina."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Oi, Valdir. Esqueci alguma coisa aí?"
msgstr "Hola, Valdir. ¿Me olvidé algo ahí?"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "A chave do arquivo. Ficou na sua bolsa, eu acho."
msgstr "La llave del archivo. Creo que quedó en tu bolso."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Ficou mesmo! Está aqui. Desculpa."
msgstr "¡Es verdad! Aquí está. Perdón."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Traz amanhã às oito, que o fiscal chega às nove."
msgstr "Tráela mañana a las ocho, que el inspector llega a las nueve."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "O Alberto Ramos, da Avenida Brasil. Somos sócios."
msgstr "Alberto Ramos, el de la Avenida Brasil. Somos socios."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos."
msgstr "Alberto Ramos."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto, boa noite. Fechei a loja agora."
msgstr "Alberto, buenas noches. Acabo de cerrar la tienda."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "E como foi o dia?"
msgstr "¿Y cómo fue el día?"

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Bom. Vendemos os três rádios da vitrine."
msgstr "Bueno. Vendimos las tres radios del escaparate."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Os três? Então tem que encomendar mais."
msgstr "¿Las tres? Entonces hay que encargar más."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Por isso liguei. Você escreve pro fornecedor amanhã?"
msgstr "Por eso llamé. ¿Le escribes mañana al proveedor?"

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Escrevo. E vou pedir cinco, que é Natal."
msgstr "Le escribo. Y voy a pedir cinco, que viene la Navidad."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Vizinha"
msgstr "Vecina"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Central, me liga com o seu Benedito Souza?"
msgstr "Central, ¿me comunica con Seu Benedito Souza?"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Sou vizinha dele. A luz da casa tá acesa e ele não atende a porta."
msgstr "Soy su vecina. La luz de la casa está encendida y no abre la puerta."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "O seu Benedito Souza, da Rua do Sol."
msgstr "Seu Benedito Souza, el de la Rua do Sol."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Benedito Souza"
msgstr "Benedito Souza"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Obrigada. Deve estar dormindo, né?"
msgstr "Gracias. Debe estar dormido, ¿no?"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Seu Benedito? É a vizinha. A luz está acesa e o senhor não atende."
msgstr "¿Don Benedito? Soy la vecina. La luz está prendida y usted no atiende."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Ah, minha filha, eu estava no banho."
msgstr "Ay, hija, estaba en el baño."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Que susto! Achei que o senhor tinha caído."
msgstr "¡Qué susto! Pensé que se había caído."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Não, não. Estou firme. Mas obrigado por cuidar de mim."
msgstr "No, no. Estoy firme. Pero gracias por cuidarme."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Amanhã eu levo uma sopa pro senhor."
msgstr "Mañana le llevo una sopa."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Dona Benta"
msgstr "Dona Benta"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Boa noite, moça."
msgstr "Buenas noches, joven."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Me liga com a Pensão Dona Cota? Meu filho chegou de viagem e ficou lá."
msgstr "¿Me comunica con la Pensão Dona Cota? Mi hijo volvió de viaje y se quedó allí."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "A pensão da Dona Cota, na Rua da Estação."
msgstr "La pensión de Dona Cota, en la Rua da Estação."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Obrigada, minha filha. Boa noite."
msgstr "Gracias, hija. Buenas noches."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Boa noite, moço. Meu filho chegou de viagem e ficou aí."
msgstr "Buenas noches, joven. Mi hijo llegó de viaje y se quedó ahí."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Como ele se chama, senhora?"
msgstr "¿Cómo se llama, señora?"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Rogério. Um moço alto, de bigode."
msgstr "Rogério. Un muchacho alto, de bigote."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Chegou, sim. Está jantando lá na sala."
msgstr "Sí, llegó. Está cenando en el comedor."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Diz pra ele vir almoçar comigo amanhã."
msgstr "Dígale que venga a almorzar conmigo mañana."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Digo, sim. Boa noite, senhora."
msgstr "Se lo digo. Buenas noches, señora."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "A pensão não atende. Quer que eu tente o Hotel Serena?"
msgstr "La pensión no contesta. ¿Quiere que pruebe con el Hotel Serena?"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Tenta, sim. Vai ver ele foi pra lá."
msgstr "Pruebe, sí. A lo mejor se fue para allá."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Caixeiro-viajante"
msgstr "Viajante de comercio"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Boa noite. Estou na rodoviária e perdi o último ônibus."
msgstr "Buenas noches. Estoy en la terminal y perdí el último autobús."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Me liga com o Hotel Serena? Preciso de um quarto pra hoje."
msgstr "¿Me comunica con el Hotel Serena? Necesito un cuarto para hoy."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Muito obrigado. A senhora me salvou a noite."
msgstr "Muchas gracias. Me salvó la noche."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Boa noite. Perdi o último ônibus. Tem um quarto pra hoje?"
msgstr "Buenas noches. Perdí el último autobús. ¿Tiene una habitación para hoy?"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Tem um de solteiro, com banheiro no corredor."
msgstr "Hay una individual, con el baño en el pasillo."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Serve. Quanto é a diária?"
msgstr "Sirve. ¿Cuánto es la noche?"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Com café da manhã, o mesmo preço da semana passada."
msgstr "Con desayuno, el mismo precio que la semana pasada."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Estou na rodoviária, com a mala de amostras."
msgstr "Estoy en la terminal, con la valija de muestras."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Vem a pé, que é perto. Deixo a porta aberta."
msgstr "Venga a pie, que es cerca. Dejo la puerta abierta."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "O hotel não atende. Quer que eu tente a Pensão Dona Cota?"
msgstr "El hotel no contesta. ¿Quiere que pruebe con la Pensão Dona Cota?"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Pode ser. Uma cama já está bom."
msgstr "Puede ser. Con una cama me basta."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Motorista de caminhão"
msgstr "Camionero"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Central, boa noite. Furou o pneu do caminhão aqui na entrada da cidade."
msgstr "Central, buenas noches. Se me pinchó una llanta del camión a la entrada del pueblo."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Me liga com a Borracharia do Neno?"
msgstr "¿Me comunica con la Borracharia do Neno?"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "A borracharia do Neno. Do pneu."
msgstr "La gomería de Neno. Por la llanta."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Borracharia do Neno"
msgstr "Borracharia do Neno"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Valeu, central. Deus te ajude."
msgstr "Gracias, central. Que Dios lo ayude."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Boa noite. Furou o pneu do caminhão na entrada da cidade."
msgstr "Buenas noches. Se pinchó la rueda del camión a la entrada del pueblo."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "O estepe também está ruim?"
msgstr "¿La de auxilio también está mal?"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Está careca, não aguenta a carga."
msgstr "Está lisa, no aguanta la carga."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Levo um pneu e o macaco grande. Em meia hora estou aí."
msgstr "Llevo una rueda y el gato grande. En media hora estoy ahí."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Estou com o pisca ligado, do lado da placa."
msgstr "Tengo las balizas puestas, al lado del cartel."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "A borracharia não atende. Quer que eu tente a Oficina do Tião?"
msgstr "La gomería no contesta. ¿Quiere que pruebe con la Oficina do Tião?"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Tenta. O Tião também conserta pneu."
msgstr "Pruebe. Tião también arregla llantas."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Ô, central. Me liga com o Bilhar do Tonho?"
msgstr "Oiga, central. ¿Me comunica con el Bilhar do Tonho?"

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Esqueci meu chapéu lá e minha mãe vai brigar comigo."
msgstr "Me olvidé el sombrero allí y mi mamá me va a regañar."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "O bilhar do Tonho, na Rua do Comércio."
msgstr "El billar de Tonho, en la Rua do Comércio."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Valeu! A senhora é das boas."
msgstr "¡Gracias! Usted es de las buenas."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Tonho? Esqueci meu chapéu aí."
msgstr "¿Tonho? Me olvidé el sombrero ahí."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Um de palha, com fita preta?"
msgstr "¿Uno de paja, con cinta negra?"

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Esse! Era do meu avô. Minha mãe vai me matar."
msgstr "¡Ese! Era de mi abuelo. Mi mamá me va a matar."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Está pendurado atrás do balcão. Vem buscar amanhã."
msgstr "Está colgado detrás del mostrador. Ven a buscarlo mañana."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Não dá pra ser hoje? Por favor."
msgstr "¿No puede ser hoy? Por favor."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Vem rápido, que eu fecho às onze."
msgstr "Ven rápido, que cierro a las once."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Dona Zefa"
msgstr "Dona Zefa"

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Boa noite. A farmácia Santa Rita, por favor."
msgstr "Buenas noches. La farmacia Santa Rita, por favor."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Meu marido está com uma dor de dente que não deixa ninguém dormir."
msgstr "Mi marido tiene un dolor de muelas que no deja dormir a nadie."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "A Santa Rita, na Rua do Mercado."
msgstr "La Santa Rita, en la Rua do Mercado."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Ai, obrigada. Agora a casa dorme."
msgstr "Ay, gracias. Ahora la casa duerme."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Boa noite. Meu marido está com uma dor de dente horrível."
msgstr "Buenas noches. Mi marido tiene un dolor de muelas horrible."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Inchou o rosto?"
msgstr "¿Se le hinchó la cara?"

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Um pouco. Ele não para de gemer, ninguém dorme."
msgstr "Un poco. No para de quejarse, nadie duerme."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Tenho um analgésico forte. E compressa fria no rosto."
msgstr "Tengo un analgésico fuerte. Y compresas frías en la cara."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Mando meu filho buscar agora."
msgstr "Mando a mi hijo a buscarlo ahora."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "E amanhã leva ele no dentista, sem desculpa."
msgstr "Y mañana lo lleva al dentista, sin excusas."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "A Santa Rita não atende. Quer que eu tente a Farmácia Central, da praça?"
msgstr "La Santa Rita no contesta. ¿Quiere que pruebe con la Farmácia Central, la de la plaza?"

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Qualquer uma, moça. Contanto que tenha remédio."
msgstr "Cualquiera, joven. Con tal de que tengan remedio."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Noivo"
msgstr "Novio"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Boa noite. Desculpe ligar tarde."
msgstr "Buenas noches. Disculpe que llame tarde."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Preciso falar com o padre Anselmo, na Casa Paroquial. É sobre o meu casamento no sábado."
msgstr "Necesito hablar con el padre Anselmo, en la Casa Paroquial. Es sobre mi boda del sábado."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "A Casa Paroquial. O padre Anselmo."
msgstr "La Casa Paroquial. El padre Anselmo."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Obrigado. Reza por mim, que eu tô nervoso."
msgstr "Gracias. Rece por mí, que estoy nervioso."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Boa noite. Desculpe a hora. É sobre o meu casamento no sábado."
msgstr "Buenas noches. Disculpe la hora. Es por mi boda del sábado."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Pode falar, meu filho. Algum problema?"
msgstr "Diga, hijo. ¿Algún problema?"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "A noiva quer mudar pras cinco. Os parentes chegam atrasados."
msgstr "La novia quiere pasarla a las cinco. Los parientes llegan tarde."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Às cinco tem batizado. Pode ser às seis?"
msgstr "A las cinco hay un bautismo. ¿Puede ser a las seis?"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Às seis está ótimo. Ela vai ficar feliz."
msgstr "A las seis está perfecto. Ella va a estar contenta."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Então seis horas. E nada de atraso da noiva, hein?"
msgstr "Entonces a las seis. Y que la novia no se atrase, ¿eh?"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "A Casa Paroquial não atende. Quer que eu tente a secretaria da Igreja Matriz?"
msgstr "La Casa Paroquial no contesta. ¿Quiere que pruebe con la secretaría de la Igreja Matriz?"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Pode ser. Alguém lá deve dar o recado."
msgstr "Puede ser. Alguien allí le dará el recado."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Dona Glorinha"
msgstr "Dona Glorinha"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Boa noite. Me liga com a Padaria Pão Dourado?"
msgstr "Buenas noches. ¿Me comunica con la Padaria Pão Dourado?"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Quero encomendar o bolo do aniversário da minha neta."
msgstr "Quiero encargar la torta del cumpleaños de mi nieta."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "A padaria Pão Dourado, na Rua das Acácias."
msgstr "La panadería Pão Dourado, en la Rua das Acácias."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Obrigada, querida. Vou pedir um de coco."
msgstr "Gracias, querida. Voy a pedir una de coco."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Boa noite. Quero encomendar o bolo do aniversário da minha neta."
msgstr "Buenas noches. Quiero encargar la torta de cumpleaños de mi nieta."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Que bom! De que sabor, Dona Glorinha?"
msgstr "¡Qué bien! ¿De qué sabor, doña Glorinha?"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Chocolate com morango. Ela faz sete anos."
msgstr "Chocolate con frutilla. Cumple siete años."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Escrevo o nome dela em cima?"
msgstr "¿Le escribo el nombre arriba?"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Escreve: Mariana. Com letra cor-de-rosa."
msgstr "Sí: Mariana. Con letras rosadas."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Fica pronto sábado às dez."
msgstr "Queda lista el sábado a las diez."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Correspondente"
msgstr "Corresponsal"

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Central, aqui é o correspondente da Gazeta na estrada."
msgstr "Central, habla el corresponsal de la Gazeta en la carretera."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Me liga com a redação, rápido. O jornal fecha daqui a pouco."
msgstr "Comuníqueme con la redacción, rápido. El diario cierra dentro de poco."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "A Gazeta de São Sotero. A redação."
msgstr "La Gazeta de São Sotero. La redacción."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Obrigado. Amanhã a senhora lê no jornal."
msgstr "Gracias. Mañana lo lee en el diario."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Redação? É o correspondente. Tenho notícia pra amanhã."
msgstr "¿Redacción? Soy el corresponsal. Tengo una nota para mañana."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Rápido, que a página fecha em vinte minutos."
msgstr "Rápido, que la página cierra en veinte minutos."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "A ponte do rio Claro vai ser reformada. Começa em março."
msgstr "El puente del río Claro va a ser reformado. Empieza en marzo."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Quem confirmou?"
msgstr "¿Quién lo confirmó?"

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "O engenheiro da estrada. Estive com ele hoje."
msgstr "El ingeniero de la ruta. Estuve con él hoy."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Dita devagar, que eu vou batendo à máquina."
msgstr "Dicta despacio, que lo voy escribiendo a máquina."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Veterinário"
msgstr "Veterinario"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Central, boa noite. Me liga com o Sítio Boa Esperança?"
msgstr "Central, buenas noches. ¿Me comunica con el Sítio Boa Esperança?"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Me chamaram por causa de uma vaca pra parir. Quero saber se ainda precisa."
msgstr "Me llamaron por una vaca que va a parir. Quiero saber si todavía me necesitan."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "O Sítio Boa Esperança, lá no Cruzeiro."
msgstr "El Sítio Boa Esperança, allá en el Cruzeiro."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Sítio Boa Esperança"
msgstr "Sítio Boa Esperança"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Obrigado. Vou ligando a caminhonete."
msgstr "Gracias. Voy arrancando la camioneta."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Boa noite. Aqui é o veterinário. Ainda precisa de mim?"
msgstr "Buenas noches. Habla el veterinario. ¿Todavía me necesitan?"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Precisa! A vaca está deitada e o bezerro não sai."
msgstr "¡Sí! La vaca está echada y el ternero no sale."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Faz quanto tempo que começou?"
msgstr "¿Cuánto hace que empezó?"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Umas duas horas. Ela está cansando."
msgstr "Unas dos horas. Se está cansando."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Estou indo. Deixa água morna e corda limpa no curral."
msgstr "Ya voy. Deje agua tibia y una soga limpia en el corral."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Dona Mirtes"
msgstr "Dona Mirtes"

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Boa noite. A Dona Laudelina, por favor."
msgstr "Buenas noches. Doña Laudelina, por favor."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado. Ela me emprestou a forma de pudim e eu quero devolver amanhã cedo."
msgstr "Laudelina Prado. Me prestó el molde de flan y quiero devolverlo mañana temprano."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado. Da Bela Vista."
msgstr "Laudelina Prado. De la Bela Vista."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Dona Laudelina? É a Mirtes. Da forma de pudim."
msgstr "¿Doña Laudelina? Soy Mirtes. Por el molde de budín."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Ah, Mirtes! E o pudim, deu certo?"
msgstr "¡Ay, Mirtes! ¿Y el budín, salió bien?"

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Ficou lindo. Todo mundo pediu a receita."
msgstr "Quedó precioso. Todos pidieron la receta."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Que bom. A forma pode trazer quando quiser."
msgstr "Qué bueno. El molde tráigalo cuando quiera."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Levo amanhã cedo, com um pedaço do pudim."
msgstr "Se lo llevo mañana temprano, con un pedazo de budín."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Alô? Moça, minha mãe mandou ligar pra Mercearia Silva."
msgstr "¿Aló? Señorita, mi mamá me mandó llamar a la Mercearia Silva."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "É pra ver se ainda tem leite. Ela tá aqui do lado."
msgstr "Es para ver si todavía tienen leche. Ella está aquí al lado."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "A mercearia do seu Silva!"
msgstr "¡El almacén del señor Silva!"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Brigado, moça!"
msgstr "¡Gracias, señorita!"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Alô? Moço, minha mãe quer saber se ainda tem leite."
msgstr "¿Hola? Señor, mi mamá quiere saber si todavía hay leche."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Tem dois litros. Quem é que está falando?"
msgstr "Hay dos litros. ¿Quién habla?"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "É o Tiaguinho, filho da Dona Lurdinha."
msgstr "Es Tiaguinho, el hijo de doña Lurdinha."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Diz pra ela que eu guardo. Pode vir buscar."
msgstr "Dile que se los guardo. Que venga a buscarlos."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Mãe! Ele disse que tem!"
msgstr "¡Mamá! ¡Dice que hay!"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "A mercearia não atende. Quer que eu tente o Armazém Ferreira?"
msgstr "El almacén no contesta. ¿Quiere que pruebe con el Armazém Ferreira?"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "(cochichando) Mãe, pode ser o Ferreira? ... Ela disse que pode!"
msgstr "(cuchicheando) Mamá, ¿puede ser el de Ferreira? ... ¡Dice que sí!"

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Boa noite. O Almeida, por favor."
msgstr "Buenas noches. Almeida, por favor."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Não o doutor, não. O Otávio, da Rua da Estação."
msgstr "No el doctor, no. Otávio, el de la Rua da Estação."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Otávio Almeida. O da Estação."
msgstr "Otávio Almeida. El de la Estação."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Esse mesmo. Obrigada."
msgstr "Ese mismo. Gracias."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Seu Otávio? Boa noite. É a vizinha da Rua da Estação."
msgstr "¿Don Otávio? Buenas noches. Soy la vecina de la Rua da Estação."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Boa noite. Aconteceu alguma coisa?"
msgstr "Buenas noches. ¿Pasó algo?"

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Sua galinha pulou o muro de novo. Está no meu quintal."
msgstr "Su gallina saltó el muro otra vez. Está en mi patio."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "A pintadinha? Ela gosta da sua horta."
msgstr "¿La pintadita? Le gusta su huerta."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Gosta até demais. Vem buscar amanhã cedo?"
msgstr "Demasiado. ¿Viene a buscarla mañana temprano?"

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Vou, e levo uma dúzia de ovos pra senhora."
msgstr "Voy, y le llevo una docena de huevos."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Mulher"
msgstr "Mujer"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Central! Houve um acidente na Rua das Acácias! Precisamos de ajuda!"
msgstr "¡Central! ¡Hubo un accidente en la Rua das Acácias! ¡Necesitamos ayuda!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Qual é o endereço exato?"
msgstr "¿Cuál es la dirección exacta?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Quantas pessoas estão feridas?"
msgstr "¿Cuántas personas están heridas?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "É perto do número 101! Na frente do posto!"
msgstr "¡Cerca del número 101! ¡Frente a la gasolinera!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste e ficou atravessado na rua!"
msgstr "¡Un auto chocó contra el poste y quedó atravesado en la calle!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Duas pessoas. Uma não está se mexendo!"
msgstr "Dos personas. ¡Una no se mueve!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Ninguém, graças a Deus. Mas o carro tá bloqueando tudo."
msgstr "Nadie, gracias a Dios. Pero el auto está bloqueando todo."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O motorista tá preso nas ferragens! Não consegue abrir a porta!"
msgstr "¡El conductor está atrapado entre los fierros! ¡No puede abrir la puerta!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste. Parou em cima da calçada."
msgstr "Un auto chocó contra el poste. Quedó arriba de la vereda."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Estão vindo? Graças a Deus... obrigada."
msgstr "¿Ya vienen? Gracias a Dios... gracias."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá juntando gente em volta, os carros não conseguem mais passar!"
msgstr "¡Se está juntando gente alrededor, los autos ya no pueden pasar!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "As pessoas estão longe do carro?"
msgstr "¿La gente está lejos del auto?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Não! Tá todo mundo em volta, querendo ajudar!"
msgstr "¡No! ¡Están todos alrededor, queriendo ayudar!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá vazando gasolina e começou a sair fumaça do capô!"
msgstr "¡Está perdiendo nafta y empezó a salir humo del capó!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem alguém perto da gasolina?"
msgstr "¿Hay alguien cerca de la nafta?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem um rapaz tentando empurrar o carro! Eu falei pra ele sair!"
msgstr "¡Hay un muchacho tratando de empujar el auto! ¡Le dije que se alejara!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Pegou fogo! O carro pegou fogo! Por que demorou tanto?!"
msgstr "¡Se prendió fuego! ¡El auto se prendió fuego! ¡¿Por qué tardaron tanto?!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O rapaz que empurrava o carro se queimou! Tá gritando de dor!"
msgstr "¡El muchacho que empujaba el auto se quemó! ¡Está gritando de dolor!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Central, tem fogo! Tem fogo no galpão da Rua do Moinho!"
msgstr "¡Central, hay fuego! ¡Hay fuego en el galpón de la Rua do Moinho!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Qual é o número?"
msgstr "¿Cuál es el número?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O que está queimando?"
msgstr "¿Qué se está quemando?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Quarenta! O galpão da serraria velha!"
msgstr "¡Cuarenta! ¡El galpón del aserradero viejo!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado inteiro! A fumaça está preta!"
msgstr "¡Todo el techo! ¡El humo está negro!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não. A serraria fecha às seis, tá vazia."
msgstr "No. El aserradero cierra a las seis, está vacío."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante não conseguiu sair! Tá gritando lá dentro!"
msgstr "¡El sereno no pudo salir! ¡Está gritando ahí adentro!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante saiu, mas tá com o rosto queimado!"
msgstr "¡El sereno salió, pero tiene la cara quemada!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá bom. Tá bom. Eu vou tirar o carro daqui."
msgstr "Está bien. Está bien. Voy a sacar el auto de aquí."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "A fumaça tá tomando a rua toda, os carros tão parando no meio!"
msgstr "¡El humo está tapando toda la calle, los autos se paran en el medio!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Os carros conseguem passar?"
msgstr "¿Los autos pueden pasar?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não, parou tudo nos dois sentidos. Ninguém enxerga nada."
msgstr "No, se paró todo en los dos sentidos. Nadie ve nada."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Um vizinho tentou ajudar e caiu! Tá desacordado na fumaça!"
msgstr "¡Un vecino quiso ayudar y se cayó! ¡Está desmayado en el humo!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vizinho está respirando?"
msgstr "¿El vecino está respirando?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá, mas tá tossindo muito e não levanta!"
msgstr "¡Sí, pero tose mucho y no se levanta!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado caiu! Caiu tudo! Ninguém veio..."
msgstr "¡Se cayó el techo! ¡Se cayó todo! No vino nadie..."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Arrastaram o vizinho pra fora, mas ele tá muito mal!"
msgstr "¡Sacaron al vecino a la rastra, pero está muy mal!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Central, meu pai caiu no banheiro e não acorda!"
msgstr "¡Central, mi padre se cayó en el baño y no despierta!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Rua do Sol, 230! A casa amarela!"
msgstr "¡Rua do Sol, 230! ¡La casa amarilla!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Está... mas não responde. Bateu a cabeça."
msgstr "Sí... pero no responde. Se golpeó la cabeza."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Não, só ele. Por favor, rápido!"
msgstr "No, solo él. ¡Por favor, rápido!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Tá, ouço ele respirando. Mas a porta tá trancada por dentro e ele caiu encostado nela!"
msgstr "Sí, lo oigo respirar. ¡Pero la puerta está cerrada por dentro y se cayó contra ella!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Obrigada. Eu vou deixar a porta aberta."
msgstr "Gracias. Voy a dejar la puerta abierta."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele tá ficando roxo... a respiração tá cada vez mais fraca!"
msgstr "Se está poniendo morado... ¡respira cada vez más débil!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não! Eu chamo e ele não abre o olho!"
msgstr "¡No! ¡Lo llamo y no abre los ojos!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não responde mais nada! Não sei se tá respirando!"
msgstr "¡Ya no responde nada! ¡No sé si está respirando!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Dá pra ver se o peito dele mexe?"
msgstr "¿Se ve si le sube el pecho?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não sei... acho que não. Meu Deus..."
msgstr "No sé... creo que no. Dios mío..."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele... ele não tá mais respirando. Vocês demoraram demais."
msgstr "Él... ya no respira. Tardaron demasiado."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não respira... Eu tô tentando, mas ele não acorda."
msgstr "No respira... Estoy intentando, pero no se despierta."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Homem (sussurrando)"
msgstr "Hombre (susurrando)"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Central... tem alguém tentando arrombar a casa do vizinho."
msgstr "Central... hay alguien tratando de forzar la casa del vecino."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "O que você está vendo?"
msgstr "¿Qué está viendo?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Quantas pessoas?"
msgstr "¿Cuántas personas?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Avenida Brasil, 150. A casa do lado da minha."
msgstr "Avenida Brasil, 150. La casa de al lado de la mía."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Forçando a janela dos fundos. O vizinho viajou."
msgstr "Forzando la ventana de atrás. El vecino está de viaje."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Dois homens. Não vi arma, não."
msgstr "Dos hombres. No vi armas."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "O vizinho chegou bem na hora e levou uma pancada na cabeça! Tá caído no quintal!"
msgstr "¡El vecino llegó justo en ese momento y recibió un golpe en la cabeza! ¡Está tirado en el patio!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tá. Vou ficar quieto aqui dentro."
msgstr "Está bien. Me quedo callado aquí adentro."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles entraram! Tão carregando as coisas pra rua!"
msgstr "¡Entraron! ¡Están sacando las cosas a la calle!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Um deles tá com uma barra de ferro na mão."
msgstr "Uno tiene una barra de hierro en la mano."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles me viram na janela! Um deles tá vindo pra cá com um pé de cabra!"
msgstr "¡Me vieron en la ventana! ¡Uno viene para acá con una barreta!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Você consegue se trancar?"
msgstr "¿Puede encerrarse?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tô trancando a porta agora... ele tá batendo!"
msgstr "Estoy cerrando la puerta ahora... ¡está golpeando!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles fugiram de carro. Levaram tudo... e ninguém apareceu."
msgstr "Se escaparon en auto. Se llevaron todo... y nadie apareció."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eu tô bem... mas o seu Jorge, da casa da frente, levou uma pancada quando veio ver."
msgstr "Yo estoy bien... pero don Jorge, el de enfrente, recibió un golpe cuando vino a ver."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Homem nervoso"
msgstr "Hombre nervioso"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Central! Tão brigando aqui no Bar do Zé! Um puxou uma faca!"
msgstr "¡Central! ¡Se están peleando aquí en el Bar do Zé! ¡Uno sacó un cuchillo!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Quantas pessoas estão brigando?"
msgstr "¿Cuántas personas se están peleando?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Rua da Estação, 140! O bar do Zé!"
msgstr "¡Rua da Estação, 140! ¡El bar de Zé!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá sangrando no braço! Rápido!"
msgstr "¡Uno está sangrando del brazo! ¡Rápido!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Dois! Mas o bar tá cheio!"
msgstr "¡Dos! ¡Pero el bar está lleno!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Ainda não! O Zé tá tentando separar!"
msgstr "¡Todavía no! ¡Zé está tratando de separarlos!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tão vindo? Tá, eu seguro o pessoal aqui."
msgstr "¿Ya vienen? Está bien, yo contengo a la gente aquí."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Agora tão quebrando as cadeiras! Tá todo mundo brigando!"
msgstr "¡Ahora están rompiendo las sillas! ¡Están todos peleando!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tem mais alguém armado?"
msgstr "¿Hay alguien más armado?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá com uma garrafa quebrada!"
msgstr "¡Uno tiene una botella rota!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Furaram um rapaz na barriga! Tá sangrando muito!"
msgstr "¡Apuñalaron a un muchacho en la panza! ¡Está sangrando mucho!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Onde ele foi ferido?"
msgstr "¿Dónde lo hirieron?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Na barriga! Tão apertando com um pano, mas não para de sangrar!"
msgstr "¡En la panza! Le aprietan un trapo, ¡pero no para de sangrar!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz desmaiou... tem sangue pra todo lado. Por que ninguém veio?"
msgstr "El muchacho se desmayó... hay sangre por todos lados. ¿Por qué no vino nadie?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz da facada desmaiou, e o Zé levou uma garrafada tentando separar!"
msgstr "¡El muchacho apuñalado se desmayó, y a Zé le dieron un botellazo tratando de separarlos!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Central, caiu um fio do poste aqui na frente e está soltando faísca!"
msgstr "¡Central, se cayó un cable del poste aquí enfrente y está echando chispas!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém encostou no fio?"
msgstr "¿Alguien tocó el cable?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tem fogo?"
msgstr "¿Hay fuego?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Rua do Comércio, 71! Na frente da barbearia!"
msgstr "¡Rua do Comércio, 71! ¡Frente a la barbería!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, não! Tá todo mundo longe."
msgstr "¡No, no! Todos están lejos."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá começando a queimar a árvore!"
msgstr "¡Se está empezando a quemar el árbol!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O menino da padaria encostou! Tá caído e não se mexe!"
msgstr "¡El chico de la panadería lo tocó! ¡Está tirado y no se mueve!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá bom. Vou manter as crianças dentro de casa."
msgstr "Está bien. Voy a dejar a los chicos dentro de casa."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá todo mundo parando pra olhar, a rua tá trancada de carro!"
msgstr "¡Todos se paran a mirar, la calle está trabada de autos!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém está perto do fio?"
msgstr "¿Hay alguien cerca del cable?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, mas os carros tão passando por cima dele devagar!"
msgstr "¡No, pero los autos le están pasando por encima despacio!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O fogo passou pro telhado da barbearia! O barbeiro mora em cima e não consegue descer!"
msgstr "¡El fuego pasó al techo de la barbería! ¡El barbero vive arriba y no puede bajar!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O barbeiro está ferido?"
msgstr "¿El barbero está herido?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não sei! Ele tá na janela de cima, gritando por ajuda!"
msgstr "¡No sé! ¡Está en la ventana de arriba, gritando por ayuda!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "A barbearia tá toda em chamas... e ninguém veio."
msgstr "La barbería está toda en llamas... y no vino nadie."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tiraram o barbeiro pela janela... ele tá com as costas queimadas!"
msgstr "Sacaron al barbero por la ventana... ¡tiene la espalda quemada!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Central! Tá saindo fumaça da casa do vizinho!"
msgstr "¡Central! ¡Está saliendo humo de la casa del vecino!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres data/templates/emergency_incendio.tres
msgid "Tem alguém dentro da casa?"
msgstr "¿Hay alguien dentro de la casa?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Dá para ver o fogo?"
msgstr "¿Se ve el fuego?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Rua das Flores, 45! Perto do Hotel Serena!"
msgstr "¡Rua das Flores, 45! ¡Cerca del Hotel Serena!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ele saiu, mas queimou o braço feio!"
msgstr "¡Salió, pero se quemó feo el brazo!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem fogo na janela da cozinha!"
msgstr "¡Hay fuego en la ventana de la cocina!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Não, ele saiu antes. Tá aqui na rua comigo."
msgstr "No, salió antes. Está aquí en la calle conmigo."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem! Ele mora sozinho e não saiu! A porta tá trancada!"
msgstr "¡Sí! ¡Vive solo y no salió! ¡La puerta está cerrada!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá bom. Eu vou chamar os outros vizinhos."
msgstr "Está bien. Voy a llamar a los otros vecinos."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Agora tá saindo fogo pelo telhado!"
msgstr "¡Ahora sale fuego por el techo!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo já passou pras outras casas?"
msgstr "¿El fuego ya pasó a otras casas?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ainda não, mas tá pertinho do muro do vizinho!"
msgstr "¡Todavía no, pero está pegado al muro del vecino!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo tá passando pra casa do lado! A senhora de lá usa cadeira de rodas e não consegue sair!"
msgstr "¡El fuego está pasando a la casa de al lado! ¡La señora de ahí usa silla de ruedas y no puede salir!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora está sozinha?"
msgstr "¿La señora está sola?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá! A filha dela trabalha à noite!"
msgstr "¡Sí! ¡Su hija trabaja de noche!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A casa desabou... Vocês demoraram demais!"
msgstr "La casa se derrumbó... ¡Tardaron demasiado!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora do lado! Os vizinhos tiraram ela, mas tá toda queimada!"
msgstr "¡La señora de al lado! Los vecinos la sacaron, ¡pero está toda quemada!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Central, um carro bateu no poste aqui na avenida!"
msgstr "¡Central, un auto chocó contra el poste aquí en la avenida!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "O motorista está ferido?"
msgstr "¿El conductor está herido?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "O poste caiu?"
msgstr "¿Se cayó el poste?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Avenida Brasil, 60! Na frente da loja de tecidos!"
msgstr "¡Avenida Brasil, 60! ¡Frente a la tienda de telas!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá preso no carro, com a cabeça sangrando. Mas tá falando."
msgstr "Está atrapado en el auto, con la cabeza sangrando. Pero está hablando."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, e os fios tão soltando faísca no meio da avenida! Ninguém passa!"
msgstr "¡Está torcido, y los cables están echando chispas en medio de la avenida! ¡No pasa nadie!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Não, ele saiu sozinho. Só tá assustado."
msgstr "No, salió solo. Solo está asustado."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, mas de pé. O carro ficou em cima da calçada."
msgstr "Está torcido, pero en pie. El auto quedó arriba de la vereda."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá. Ninguém chega perto dos fios, pode deixar."
msgstr "Está bien. Nadie se acerca a los cables, quédese tranquila."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá formando fila de carro dos dois lados da avenida!"
msgstr "¡Se está formando fila de autos de los dos lados de la avenida!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem alguém sinalizando a pista?"
msgstr "¿Hay alguien señalizando la calzada?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Não, tá todo mundo parado olhando!"
msgstr "¡No, están todos parados mirando!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Começou a sair fumaça do capô do carro!"
msgstr "¡Empezó a salir humo del capó del auto!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tem alguém perto do carro?"
msgstr "¿Hay alguien cerca del auto?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tem gente tentando abrir a porta pra ajudar!"
msgstr "¡Hay gente tratando de abrir la puerta para ayudar!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O carro pegou fogo! Por que ninguém veio?!"
msgstr "¡El auto se prendió fuego! ¡¿Por qué no vino nadie?!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Um dos rapazes que ajudava se queimou feio no braço!"
msgstr "¡Uno de los muchachos que ayudaba se quemó feo el brazo!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Filha"
msgstr "Hija"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Central, minha mãe tá passando mal! A boca tá torta e ela não fala direito!"
msgstr "¡Central, mi madre se siente mal! ¡Tiene la boca torcida y no habla bien!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Ela está consciente?"
msgstr "¿Está consciente?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Quantos anos ela tem?"
msgstr "¿Cuántos años tiene?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Rua do Comércio, 150. Em cima da loja."
msgstr "Rua do Comércio, 150. Arriba de la tienda."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas não consegue levantar o braço."
msgstr "Sí, pero no puede levantar el brazo."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Setenta e oito."
msgstr "Setenta y ocho."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Eu vou descer e esperar na porta."
msgstr "Voy a bajar y esperar en la puerta."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Agora ela não consegue falar mais nada!"
msgstr "¡Ahora ya no puede decir nada!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela consegue mexer os braços?"
msgstr "¿Puede mover los brazos?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Só o esquerdo. O direito tá caído."
msgstr "Solo el izquierdo. El derecho está caído."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela desmaiou! Não acorda!"
msgstr "¡Se desmayó! ¡No se despierta!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela está respirando?"
msgstr "¿Está respirando?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas fazendo um barulho estranho!"
msgstr "¡Sí, pero hace un ruido raro!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela... ela não acorda mais. Ninguém veio."
msgstr "Ella... ya no se despierta. No vino nadie."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela não acorda... tá respirando bem fraquinho."
msgstr "No se despierta... respira muy débil."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Central... tem alguém dentro da minha casa."
msgstr "(susurrando) Central... hay alguien dentro de mi casa."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "O senhor está em segurança?"
msgstr "¿Usted está a salvo?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres data/calls/emergency_18_invasao_rua_do_mercado_90.tres data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "A pessoa está armada?"
msgstr "¿La persona está armada?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Rua do Moinho, 260. A última casa."
msgstr "Rua do Moinho, 260. La última casa."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô trancado no quarto. Ouvi quebrarem o vidro da cozinha."
msgstr "Estoy encerrado en el cuarto. Oí que rompieron el vidrio de la cocina."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Não sei. Não vi. Só ouço os passos."
msgstr "No sé. No vi. Solo oigo los pasos."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô no quarto, trancado. Mas cortei a mão feio no vidro quando fugi... tá sangrando muito."
msgstr "Estoy encerrado en el cuarto. Pero me corté feo la mano con el vidrio cuando escapé... está sangrando mucho."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tá. Eu vou ficar quieto aqui."
msgstr "Está bien. Me quedo callado aquí."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão mexendo nas gavetas da sala..."
msgstr "(susurrando) Están revolviendo los cajones de la sala..."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Quantas pessoas você ouve?"
msgstr "¿Cuántas personas oye?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Duas vozes. Homens."
msgstr "(susurrando) Dos voces. Hombres."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão tentando abrir a porta do quarto!"
msgstr "(susurrando) ¡Están tratando de abrir la puerta del cuarto!"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tem alguma saída no quarto?"
msgstr "¿Hay alguna salida en el cuarto?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) A janela... mas é do segundo andar."
msgstr "(susurrando) La ventana... pero es un segundo piso."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(chorando) Eles foram embora... levaram tudo. Ninguém veio."
msgstr "(llorando) Se fueron... se llevaron todo. No vino nadie."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(chorando) Pulei a janela pra fugir... acho que quebrei o pé."
msgstr "(llorando) Salté por la ventana para escapar... creo que me rompí el pie."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Central! A papelaria aqui da Rua Tiradentes tá pegando fogo!"
msgstr "¡Central! ¡La papelería de la Rua Tiradentes se está incendiando!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Cento e vinte! Do lado dos Correios!"
msgstr "¡Ciento veinte! ¡Al lado del correo!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "A loja toda! Sai fumaça preta pela porta!"
msgstr "¡Toda la tienda! ¡Sale humo negro por la puerta!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não, o seu Osório fechou às seis e foi pra casa."
msgstr "No, don Osório cerró a las seis y se fue a su casa."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tem! O seu Osório mora em cima da loja e não consegue descer!"
msgstr "¡Sí! ¡Don Osório vive arriba de la tienda y no puede bajar!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Ele saiu, mas queimou as mãos tentando apagar!"
msgstr "¡Salió, pero se quemó las manos tratando de apagarlo!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Graças a Deus. Vou avisar os vizinhos pra saírem de casa."
msgstr "Gracias a Dios. Voy a avisar a los vecinos que salgan de sus casas."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "A fumaça tá cobrindo a rua, os carros tão parando no meio!"
msgstr "¡El humo está cubriendo la calle, los autos se paran en el medio!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não, parou tudo. Tem gente buzinando no meio da fumaça."
msgstr "No, se paró todo. Hay gente tocando bocina en medio del humo."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O fogo passou pro sobrado do lado! Tem uma senhora na janela pedindo socorro!"
msgstr "¡El fuego pasó a la casa de al lado! ¡Hay una señora en la ventana pidiendo auxilio!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Ela consegue sair?"
msgstr "¿Ella puede salir?"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não! A escada é por dentro e tá cheia de fumaça!"
msgstr "¡No! ¡La escalera es por dentro y está llena de humo!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O telhado da papelaria caiu... ninguém chegou a tempo!"
msgstr "Se cayó el techo de la papelería... ¡nadie llegó a tiempo!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tiraram a senhora do sobrado pela janela, mas ela respirou muita fumaça!"
msgstr "Sacaron a la señora por la ventana, ¡pero respiró mucho humo!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Central, tem uma briga feia na saída do baile, na Rua das Acácias!"
msgstr "¡Central, hay una pelea fea a la salida del baile, en la Rua das Acácias!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres data/templates/emergency_briga.tres
msgid "Alguém está armado?"
msgstr "¿Alguien está armado?"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Trezentos e trinta! Na porta do clube!"
msgstr "¡Trescientos treinta! ¡En la puerta del club!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Um quebrou uma garrafa e tá ameaçando todo mundo!"
msgstr "¡Uno rompió una botella y está amenazando a todos!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Ainda não, mas tá cada vez pior!"
msgstr "¡Todavía no, pero está cada vez peor!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Um levou uma garrafada na cabeça! Tá sangrando no chão!"
msgstr "¡A uno le dieron un botellazo en la cabeza! ¡Está sangrando en el suelo!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Tá bom! Vou mandar o pessoal entrar de volta no clube."
msgstr "¡Está bien! Voy a hacer que la gente vuelva a entrar al club."

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Agora tão quebrando os carros estacionados na rua!"
msgstr "¡Ahora están rompiendo los autos estacionados en la calle!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Uns oito! Virou bagunça geral!"
msgstr "¡Unos ocho! ¡Se armó un lío tremendo!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Esfaquearam um rapaz! Ele tá caído na calçada!"
msgstr "¡Apuñalaron a un muchacho! ¡Está tirado en la vereda!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Na barriga! Tão apertando com a camisa, mas não para de sangrar!"
msgstr "¡En la panza! Están apretando con la camisa, ¡pero no para de sangrar!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "O rapaz desmaiou... e todo mundo fugiu. Por que demorou tanto?"
msgstr "El muchacho se desmayó... y todos huyeron. ¿Por qué tardaron tanto?"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "O rapaz da facada desmaiou, e tem outro com o braço quebrado!"
msgstr "¡El del navajazo se desmayó, y hay otro con el brazo quebrado!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Central! Um carro bateu no ônibus da capital, aqui na frente da rodoviária!"
msgstr "¡Central! ¡Un auto chocó contra el ómnibus de la capital, acá frente a la terminal!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres data/templates/emergency_acidente.tres
msgid "A rua está bloqueada?"
msgstr "¿La calle está bloqueada?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tem feridos?"
msgstr "¿Hay heridos?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Avenida Brasil, 580! Na frente da rodoviária!"
msgstr "¡Avenida Brasil, 580! ¡Frente a la terminal!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá! O carro ficou atravessado e o ônibus parou no meio da rua!"
msgstr "¡Sí! ¡El auto quedó atravesado y el ómnibus paró en medio de la calle!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O motorista do carro tá com a testa sangrando, mas tá falando."
msgstr "El conductor del auto tiene la frente sangrando, pero está hablando."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Ninguém se machucou, graças a Deus. Foi só o susto."
msgstr "Nadie se lastimó, gracias a Dios. Solo el susto."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O motorista do carro tá preso nas ferragens! A porta não abre!"
msgstr "¡El conductor del auto está atrapado entre los fierros! ¡La puerta no abre!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Não, o motorista do ônibus já encostou tudo na calçada."
msgstr "No, el chofer del ómnibus ya arrimó todo a la vereda."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá bom. Vou ficar aqui com ele até chegarem."
msgstr "Está bien. Me quedo acá con él hasta que lleguen."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá juntando gente do ônibus em volta do carro, ninguém consegue passar!"
msgstr "¡Se está juntando gente del ómnibus alrededor del auto, nadie puede pasar!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Alguém está orientando o trânsito?"
msgstr "¿Alguien está dirigiendo el tránsito?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tá saindo fumaça do motor do carro!"
msgstr "¡Está saliendo humo del motor del auto!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tem gente perto do carro?"
msgstr "¿Hay gente cerca del auto?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tem! Uns passageiros tão tentando abrir a porta!"
msgstr "¡Sí! ¡Unos pasajeros están tratando de abrir la puerta!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Um passageiro que tentava abrir a porta queimou as mãos!"
msgstr "¡Un pasajero que trataba de abrir la puerta se quemó las manos!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Central, meu pai caiu no quintal e não acorda!"
msgstr "¡Central, mi papá se cayó en el patio y no se despierta!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Rua do Sol, 530! A casa do seu Benedito Souza!"
msgstr "¡Rua do Sol, 530! ¡La casa de don Benedito Souza!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá, mas bem devagar. Bateu a cabeça numa pedra."
msgstr "Sí, pero muy despacio. Se golpeó la cabeza con una piedra."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá, ouço ele gemendo... mas ele caiu dentro do poço do quintal! Não dá pra descer!"
msgstr "Sí, lo oigo quejarse... ¡pero se cayó dentro del pozo del patio! ¡No se puede bajar!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá bom... Pai, aguenta firme, eles tão vindo."
msgstr "Está bien... Papá, aguantá, ya vienen."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres data/templates/emergency_mal_subito.tres
msgid "A respiração dele tá ficando mais fraca!"
msgstr "¡Está respirando cada vez más débil!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Não... eu chamo e ele não abre o olho."
msgstr "No... lo llamo y no abre los ojos."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres data/templates/emergency_mal_subito.tres
msgid "Ele começou a tremer todo!"
msgstr "¡Empezó a temblar entero!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá! A cabeça tá sangrando muito!"
msgstr "¡Sí! ¡La cabeza le sangra mucho!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele parou de respirar... vocês demoraram demais."
msgstr "Dejó de respirar... tardaron demasiado."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele não respira... o vizinho tá fazendo massagem no peito dele."
msgstr "No respira... el vecino le está haciendo masaje en el pecho."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Vigia da escola"
msgstr "Sereno de la escuela"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Central, um caminhão de leite tombou aqui na frente da escola!"
msgstr "¡Central, un camión de leche volcó acá frente a la escuela!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Rua do Sol, 320! Na frente da Escola Rui Barbosa!"
msgstr "¡Rua do Sol, 320! ¡Frente a la Escuela Rui Barbosa!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá preso na cabine, com o braço sangrando. Mas tá falando."
msgstr "Está atrapado en la cabina, con el brazo sangrando. Pero está hablando."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá! O caminhão e as latas de leite tão no meio da rua!"
msgstr "¡Sí! ¡El camión y los tarros de leche están en medio de la calle!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Saiu sozinho, mas tá com a cabeça sangrando."
msgstr "Salió solo, pero tiene la cabeza sangrando."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Saiu sozinho. Só tá assustado."
msgstr "Salió solo. Solo está asustado."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Não, o caminhão tombou em cima da calçada. A rua tá livre."
msgstr "No, el camión volcó sobre la vereda. La calle está libre."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá bom. Vou pôr uns cavaletes da escola na rua."
msgstr "Está bien. Voy a poner unos caballetes de la escuela en la calle."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá formando fila de carro dos dois lados!"
msgstr "¡Se está formando una fila de autos de los dos lados!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Só eu, com a lanterna da escola!"
msgstr "¡Solo yo, con la linterna de la escuela!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá vazando óleo e começou a sair fumaça do motor!"
msgstr "¡Está perdiendo aceite y empezó a salir humo del motor!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem alguém perto do caminhão?"
msgstr "¿Hay alguien cerca del camión?"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem! Uns rapazes tão tentando desvirar a cabine!"
msgstr "¡Sí! ¡Unos muchachos están tratando de dar vuelta la cabina!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "O caminhão pegou fogo! Ninguém veio!"
msgstr "¡El camión se prendió fuego! ¡No vino nadie!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Um dos rapazes que ajudava queimou o braço!"
msgstr "¡Uno de los muchachos que ayudaba se quemó el brazo!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Senhor (baixinho)"
msgstr "Señor (en voz baja)"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Central... tem gente roubando o galinheiro do vizinho."
msgstr "(en voz baja) Central... están robando el gallinero del vecino."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Rua do Cruzeiro, 290. O sítio no fim da rua."
msgstr "Rua do Cruzeiro, 290. La chacra al final de la calle."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Dois homens com lanterna, enchendo uns sacos."
msgstr "Dos hombres con linterna, llenando unas bolsas."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Não vi arma, não."
msgstr "No vi ningún arma."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "O vizinho foi ver e levou uma pancada! Tá caído no terreiro!"
msgstr "¡El vecino fue a ver y le dieron un golpe! ¡Está tirado en el patio!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Tá bom. Eu fico quieto aqui dentro."
msgstr "(en voz baja) Está bien. Me quedo callado acá adentro."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Eles tão levando as galinhas pra uma caminhonete..."
msgstr "(en voz baja) Se están llevando las gallinas a una camioneta..."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Você consegue ver a placa?"
msgstr "¿Puede ver la patente?"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Não, tá sem luz. É uma caminhonete clara."
msgstr "(en voz baja) No, no tiene luces. Es una camioneta clara."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Eles viram a minha lanterna! Um tá vindo pra cá com um facão!"
msgstr "(en voz baja) ¡Vieron mi linterna! ¡Uno viene para acá con un machete!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Tô trancando a porta da cozinha... ele tá batendo!"
msgstr "(en voz baja) Estoy trancando la puerta de la cocina... ¡está golpeando!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(chorando) Ele quebrou a janela e me acertou o braço... tá sangrando."
msgstr "(llorando) Rompió la ventana y me pegó en el brazo... está sangrando."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tipógrafo"
msgstr "Tipógrafo"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Central! A oficina da gráfica tá pegando fogo! O papel todo tá queimando!"
msgstr "¡Central! ¡El taller de la imprenta se está quemando! ¡Todo el papel está ardiendo!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres data/templates/emergency_gas.tres
msgid "Tem alguém dentro?"
msgstr "¿Hay alguien adentro?"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Rua Sete de Setembro, 60! Atrás da Gazeta!"
msgstr "¡Rua Sete de Setembro, 60! ¡Detrás de la Gazeta!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Não, a gente saiu tudo pela frente."
msgstr "No, salimos todos por adelante."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Não, graças a Deus. Só a fumaça."
msgstr "No, gracias a Dios. Solo el humo."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "O seu Amaro queimou o braço tirando as chapas da máquina!"
msgstr "¡El señor Amaro se quemó el brazo sacando las planchas de la máquina!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tá bom. A gente vai molhar a parede do vizinho enquanto isso."
msgstr "Bueno. Mientras tanto vamos a mojar la pared del vecino."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A fumaça tá entrando no sobrado do lado! Mora gente lá em cima!"
msgstr "¡El humo está entrando en la casa de al lado! ¡Arriba vive gente!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Quem mora no sobrado?"
msgstr "¿Quién vive en esa casa?"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Um casal de velhinhos. Eles já desceram pra calçada."
msgstr "Una pareja de viejitos. Ya bajaron a la vereda."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A velhinha desmaiou na calçada! Respirou muita fumaça!"
msgstr "¡La viejita se desmayó en la vereda! ¡Respiró mucho humo!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tá, mas tossindo muito e chiando no peito."
msgstr "Sí, pero tose mucho y le silba el pecho."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "O teto da gráfica caiu... e o fogo pegou o sobrado. Ninguém veio!"
msgstr "Se cayó el techo de la imprenta... y el fuego agarró la casa. ¡No vino nadie!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A velhinha não acorda, e o marido dela tá com o rosto queimado!"
msgstr "¡La viejita no se despierta y el marido tiene la cara quemada!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Farmacêutico"
msgstr "Farmacéutico"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Central, acabaram de assaltar a farmácia! O homem levou o dinheiro do caixa!"
msgstr "¡Central, acaban de asaltar la farmacia! ¡El hombre se llevó la plata de la caja!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Rua do Mercado, 90. A Farmácia Santa Rita."
msgstr "Rua do Mercado, 90. La Farmácia Santa Rita."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Tava! Com um revólver! Saiu correndo pra praça."
msgstr "¡Sí! ¡Con un revólver! Salió corriendo para la plaza."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Não, ninguém. Só o susto."
msgstr "No, nadie. Solo el susto."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "O balconista levou uma coronhada na cabeça! Tá sangrando!"
msgstr "¡Al empleado le pegaron con la culata en la cabeza! ¡Está sangrando!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Tá bom. Eu vou fechar a porta e esperar aqui dentro."
msgstr "Bueno. Voy a cerrar la puerta y esperar aquí adentro."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele voltou! Tá rondando a praça, olhando pra cá!"
msgstr "¡Volvió! ¡Está dando vueltas por la plaza, mirando para acá!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele está sozinho?"
msgstr "¿Está solo?"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Acho que tem outro esperando numa bicicleta."
msgstr "Creo que hay otro esperando en una bicicleta."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele deu um tiro pro alto! O povo tá correndo!"
msgstr "¡Pegó un tiro al aire! ¡La gente está corriendo!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Alguém foi atingido?"
msgstr "¿Le dieron a alguien?"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Acho que não... mas uma senhora caiu correndo."
msgstr "Creo que no... pero una señora se cayó corriendo."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Eles fugiram... sumiram pela estrada. Ninguém apareceu."
msgstr "Se escaparon... desaparecieron por la carretera. No apareció nadie."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "A senhora que caiu quebrou o braço. Tá aqui no banco, chorando de dor."
msgstr "La señora que se cayó se rompió el brazo. Está aquí en el banco, llorando de dolor."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Zeladora da igreja"
msgstr "Cuidadora de la iglesia"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Central, uma senhora passou mal na saída da missa! Caiu no chão!"
msgstr "¡Central, una señora se descompuso a la salida de misa! ¡Se cayó al suelo!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela consegue falar?"
msgstr "¿Puede hablar?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Rua da Matriz, 30. Na escadaria do lado da igreja."
msgstr "Rua da Matriz, 30. En la escalinata al lado de la iglesia."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá, mas tá branca que nem papel."
msgstr "Sí, pero está blanca como el papel."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá tentando, mas a boca tá torta e a fala sai enrolada."
msgstr "Lo intenta, pero tiene la boca torcida y habla enredado."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Graças a Deus. O padre tá aqui segurando a mão dela."
msgstr "Gracias a Dios. El padre está aquí agarrándole la mano."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela não mexe mais o braço direito!"
msgstr "¡Ya no mueve el brazo derecho!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela está acordada?"
msgstr "¿Está despierta?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá de olho aberto, mas não responde quando a gente chama."
msgstr "Tiene los ojos abiertos, pero no responde cuando la llamamos."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela tá vomitando! A gente virou ela de lado!"
msgstr "¡Está vomitando! ¡La pusimos de costado!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela bateu a cabeça quando caiu?"
msgstr "¿Se golpeó la cabeza al caer?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Bateu no degrau. Tem um galo, mas não sangra."
msgstr "En el escalón. Tiene un chichón, pero no sangra."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela fechou os olhos... o padre já tá rezando por ela."
msgstr "Cerró los ojos... el padre ya está rezando por ella."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela ainda respira, mas bem fraquinho. Não acorda mais."
msgstr "Todavía respira, pero muy despacito. Ya no se despierta."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Cobrador"
msgstr "Guarda del autobús"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Central, o ônibus da linha bateu num poste aqui na avenida! O fio caiu na rua!"
msgstr "¡Central, el autobús chocó contra un poste aquí en la avenida! ¡El cable cayó a la calle!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O fio está soltando faísca?"
msgstr "¿El cable está echando chispas?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Avenida Brasil, 420! Perto da delegacia!"
msgstr "¡Avenida Brasil, 420! ¡Cerca de la comisaría!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Não, todo mundo desceu andando. Só o susto."
msgstr "No, todos bajaron caminando. Solo el susto."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá! E tá atravessado na rua, ninguém passa!"
msgstr "¡Sí! ¡Y está cruzado en la calle, no pasa nadie!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Uma passageira bateu a testa no banco da frente! Tá sangrando!"
msgstr "¡Una pasajera se golpeó la frente con el asiento de adelante! ¡Está sangrando!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá bom. Eu seguro o povo longe do fio."
msgstr "Bueno. Yo mantengo a la gente lejos del cable."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O fio encostou no ônibus! Tem gente ainda pegando as malas lá dentro!"
msgstr "¡El cable tocó el autobús! ¡Todavía hay gente sacando las valijas adentro!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Quantas pessoas ainda estão no ônibus?"
msgstr "¿Cuántas personas siguen en el autobús?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Duas. Eu gritei pra elas não encostarem em nada."
msgstr "Dos. Les grité que no tocaran nada."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O motorista desceu pela porta e levou um choque! Tá caído na calçada!"
msgstr "¡El chofer bajó por la puerta y le dio la corriente! ¡Está tirado en la vereda!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá, mas não acorda. A mão dele tá queimada."
msgstr "Sí, pero no se despierta. Tiene la mano quemada."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O ônibus pegou fogo... A gente tirou o pessoal como deu. Por que demoraram?"
msgstr "El autobús se prendió fuego... Sacamos a la gente como pudimos. ¿Por qué tardaron?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O motorista ainda não acordou, e um rapaz queimou as mãos ajudando."
msgstr "El chofer todavía no se despertó y un muchacho se quemó las manos ayudando."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Vizinha do prédio"
msgstr "Vecina del edificio"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Central, tá um cheiro forte de gás no corredor do prédio! Vem do apartamento da Dona Ilda!"
msgstr "¡Central, hay un olor fuerte a gas en el pasillo del edificio! ¡Viene del departamento de doña Ilda!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Ela atende a porta?"
msgstr "¿Ella abre la puerta?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Alguém acendeu alguma luz ou fósforo?"
msgstr "¿Alguien prendió una luz o un fósforo?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Rua das Flores, 350! O prédio de três andares!"
msgstr "¡Rua das Flores, 350! ¡El edificio de tres pisos!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Não! A gente bate e nada! Ela deve ter passado mal com o gás!"
msgstr "¡No! ¡Golpeamos y nada! ¡El gas la debe haber descompuesto!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Não, ninguém. Abri as janelas do corredor."
msgstr "No, nadie. Abrí las ventanas del pasillo."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Atendeu agora, toda tonta. Disse que o fogão apagou e ela dormiu. Tá bem, só zonza."
msgstr "Abrió recién, toda mareada. Dice que la hornalla se apagó y se durmió. Está bien, solo mareada."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Tá. Vou tirar todo mundo do prédio."
msgstr "Bueno. Voy a sacar a todos del edificio."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "O cheiro tá chegando no andar de baixo! Tem criança lá!"
msgstr "¡El olor está llegando al piso de abajo! ¡Hay chicos ahí!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "As crianças já saíram?"
msgstr "¿Los chicos ya salieron?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Já! A mãe levou elas pra calçada."
msgstr "¡Sí! La madre los llevó a la vereda."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "O vizinho de baixo tá com dor de cabeça e vomitando!"
msgstr "¡El vecino de abajo tiene dolor de cabeza y está vomitando!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Ele consegue andar?"
msgstr "¿Puede caminar?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Consegue, apoiado. Tá sentado no meio-fio."
msgstr "Sí, apoyado. Está sentado en el cordón."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Teve um estouro no apartamento dela! Quebrou as janelas todas!"
msgstr "¡Hubo una explosión en su departamento! ¡Se rompieron todas las ventanas!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "A Dona Ilda ainda tá lá dentro, e o vizinho levou um corte de vidro no rosto!"
msgstr "¡Doña Ilda sigue adentro, y el vecino se cortó la cara con un vidrio!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Central, o vizinho tá aqui no meu portão com uma foice, ameaçando por causa do muro!"
msgstr "¡Central, el vecino está en mi portón con una hoz, amenazándome por lo del muro!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ele está bêbado?"
msgstr "¿Está borracho?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Rua Tiradentes, 250! A casa de muro amarelo!"
msgstr "¡Rua Tiradentes, 250! ¡La casa del muro amarillo!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ainda não. Eu tranquei o portão."
msgstr "Todavía no. Cerré el portón con llave."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tá. Tá gritando que o muro é dele."
msgstr "Sí. Grita que el muro es de él."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Meu filho foi segurar ele e levou um talho no braço!"
msgstr "¡Mi hijo lo quiso agarrar y se ligó un tajo en el brazo!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tá. Vou ficar aqui dentro com a porta trancada."
msgstr "Bueno. Me quedo adentro con la puerta trancada."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ele tá derrubando o muro com a foice! A rua tá cheia de gente olhando!"
msgstr "¡Está tirando el muro abajo con la hoz! ¡La calle está llena de gente mirando!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tem mais alguém com ele?"
msgstr "¿Hay alguien más con él?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "O irmão dele chegou agora, com um pedaço de pau."
msgstr "Recién llegó el hermano, con un palo."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Os dois pularam o muro! Tão batendo no meu genro!"
msgstr "¡Los dos saltaron el muro! ¡Le están pegando a mi yerno!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Onde ele está ferido?"
msgstr "¿Dónde está herido?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Na cabeça! Tá caído no quintal, sangrando!"
msgstr "¡En la cabeza! ¡Está tirado en el patio, sangrando!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Eles foram embora... deixaram meu genro no chão. Ninguém veio ajudar."
msgstr "Se fueron... dejaron a mi yerno en el suelo. No vino nadie a ayudar."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Meu genro não acorda, e minha filha machucou a mão tentando separar."
msgstr "Mi yerno no se despierta, y mi hija se lastimó la mano tratando de separarlos."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ajudante de padeiro"
msgstr "Ayudante de panadero"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Central, o padeiro caiu do lado do forno! Tá passando muito mal!"
msgstr "¡Central, el panadero se cayó al lado del horno! ¡Está muy mal!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele reclamou de alguma dor?"
msgstr "¿Se quejó de algún dolor?"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Rua das Acácias, 450! A Padaria Pão Dourado, pelos fundos!"
msgstr "¡Rua das Acácias, 450! ¡La Padaria Pão Dourado, por el fondo!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Tá, mas tá suando frio."
msgstr "Sí, pero tiene sudor frío."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Disse que o peito tava apertando e o braço formigando."
msgstr "Dijo que le apretaba el pecho y le hormigueaba el brazo."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Disse que o peito apertava... e quando caiu derrubou a lenha, tá pegando fogo nos sacos de farinha!"
msgstr "Dijo que le apretaba el pecho... ¡y al caer tiró la leña, se están prendiendo las bolsas de harina!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Tá bom. Vou abrir a porta da frente pra eles."
msgstr "Bueno. Voy a abrir la puerta de adelante para ellos."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele tá ficando roxo! Tá com falta de ar!"
msgstr "¡Se está poniendo morado! ¡Le falta el aire!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele toma algum remédio?"
msgstr "¿Toma algún remedio?"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Toma um do coração, mas esqueceu em casa."
msgstr "Toma uno para el corazón, pero se lo olvidó en casa."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele parou de responder! Tô sacudindo ele e nada!"
msgstr "¡Dejó de responder! ¡Lo sacudo y nada!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Bem pouquinho... de vez em quando."
msgstr "Muy poquito... de vez en cuando."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele não respira mais... a gente tá tentando, mas demorou demais."
msgstr "Ya no respira... estamos intentando, pero tardó demasiado."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "O padeiro tá desacordado, e o outro ajudante tá apertando o peito dele."
msgstr "El panadero está inconsciente, y el otro ayudante le aprieta el pecho."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres data/content.tres
msgid "Moradora"
msgstr "Residente"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Central, um carro desceu a ladeira sem freio e entrou no muro da minha casa!"
msgstr "¡Central, un auto bajó la cuesta sin frenos y se metió en el muro de mi casa!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O carro está no meio da rua?"
msgstr "¿El auto está en medio de la calle?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Rua das Palmeiras, 140! No fim da ladeira!"
msgstr "¡Rua das Palmeiras, 140! ¡Al final de la cuesta!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O motorista tá com a cabeça sangrando no volante!"
msgstr "¡El chofer tiene la cabeza sangrando contra el volante!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá! Metade na rua, metade no muro. Ninguém passa."
msgstr "¡Sí! Mitad en la calle, mitad en el muro. No pasa nadie."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Não, o motorista saiu andando. Só o muro que foi."
msgstr "No, el chofer salió caminando. Solo el muro."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O motorista tá preso, a porta amassou toda! E tá sangrando!"
msgstr "¡El chofer está atrapado, la puerta quedó toda aplastada! ¡Y está sangrando!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá. Vou pôr uma lanterna na ladeira pra ninguém bater."
msgstr "Bueno. Voy a poner una linterna en la cuesta para que nadie choque."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá saindo fumaça do motor! Tá pingando gasolina!"
msgstr "¡Sale humo del motor! ¡Está goteando nafta!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O fogo já começou?"
msgstr "¿Ya empezó el fuego?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Ainda não, só a fumaça e o cheiro."
msgstr "Todavía no, solo el humo y el olor."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Pegou fogo embaixo do carro!"
msgstr "¡Se prendió fuego debajo del auto!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Meu marido tá tentando apagar com terra e queimou a mão!"
msgstr "¡Mi marido intenta apagarlo con tierra y se quemó la mano!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O carro tá todo em chamas... e o muro desabou. Por que não vieram?"
msgstr "El auto está todo en llamas... y el muro se derrumbó. ¿Por qué no vinieron?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tiramos o motorista, mas ele tá desmaiado, e meu marido tá com a mão em carne viva!"
msgstr "¡Sacamos al chofer, pero está desmayado, y mi marido tiene la mano en carne viva!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Seu Joaquim"
msgstr "Seu Joaquim"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "(baixinho) Central, tem gente arrombando o depósito do armazém. Tô ouvindo daqui de cima."
msgstr "(bajito) Central, hay gente forzando el depósito del almacén. Los oigo desde arriba."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tem mais alguém na casa?"
msgstr "¿Hay alguien más en la casa?"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Rua Bela Vista, 230. O Armazém Ferreira. Eu moro em cima."
msgstr "Rua Bela Vista, 230. El Armazém Ferreira. Vivo arriba."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Uns dois ou três. Tão carregando os sacos de arroz numa carroça."
msgstr "Dos o tres. Están cargando las bolsas de arroz en un carro."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Minha mulher. Tá aqui comigo, quietinha."
msgstr "Mi mujer. Está aquí conmigo, calladita."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Meu filho desceu pra ver e não voltou... ouvi um grito dele!"
msgstr "Mi hijo bajó a ver y no volvió... ¡lo oí gritar!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tá bom. Não vou descer, prometo."
msgstr "Bueno. No voy a bajar, lo prometo."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Eles tão subindo a escada! Ouço os passos!"
msgstr "¡Están subiendo la escalera! ¡Oigo los pasos!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "A porta do quarto tem tranca?"
msgstr "¿La puerta del cuarto tiene traba?"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tem. Pus a cômoda na frente também."
msgstr "Sí. También le puse la cómoda adelante."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tão chutando a porta! Minha mulher passou mal de nervoso!"
msgstr "¡Están pateando la puerta! ¡A mi mujer le dio un ataque de nervios!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tá, mas com a mão no peito, sem ar."
msgstr "Sí, pero con la mano en el pecho, sin aire."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Eles levaram tudo e foram embora... a gente ficou sozinho aqui."
msgstr "Se llevaron todo y se fueron... nos quedamos solos aquí."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Minha mulher tá deitada, com dor no peito, e eu cortei a mão na porta."
msgstr "Mi mujer está acostada, con dolor en el pecho, y yo me corté la mano con la puerta."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Caseiro"
msgstr "Casero"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Central! O paiol do sítio tá pegando fogo! O vento tá levando pro pasto!"
msgstr "¡Central! ¡El galpón del sitio se está quemando! ¡El viento lo lleva al pasto!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Rua do Cruzeiro, 260! O Sítio Boa Esperança, no fim da rua!"
msgstr "¡Rua do Cruzeiro, 260! ¡El Sítio Boa Esperança, al final de la calle!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Não, só o milho e as ferramentas."
msgstr "No, solo el maíz y las herramientas."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Não. Tô jogando água com o balde."
msgstr "No. Le estoy tirando agua con el balde."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "O patrão tentou tirar o cavalo e se queimou todo nos braços!"
msgstr "¡El patrón quiso sacar el caballo y se quemó todos los brazos!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Tá. Vou soltar os bichos do curral."
msgstr "Bueno. Voy a soltar a los animales del corral."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "O fogo pegou no pasto e tá indo pra casa!"
msgstr "¡El fuego agarró el pasto y va para la casa!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A patroa e as duas meninas. Já mandei sair."
msgstr "La patrona y las dos nenas. Ya les dije que salieran."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A menina menor voltou pra buscar o cachorro e não saiu!"
msgstr "¡La nena más chica volvió a buscar al perro y no salió!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Onde ela está?"
msgstr "¿Dónde está?"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "No quarto dos fundos! A fumaça tá saindo pela janela!"
msgstr "¡En el cuarto del fondo! ¡Sale humo por la ventana!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A casa queimou... a gente perdeu tudo. Ninguém subiu a serra."
msgstr "La casa se quemó... perdimos todo. Nadie subió la sierra."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Eu tirei a menina pela janela, mas ela tá tossindo sem parar e com o braço queimado."
msgstr "Saqué a la nena por la ventana, pero tose sin parar y tiene el brazo quemado."

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Mãe"
msgstr "Madre"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Central, meu filho caiu no córrego atrás de casa! A correnteza tá levando ele!"
msgstr "¡Central, mi hijo se cayó al arroyo detrás de casa! ¡La corriente se lo lleva!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Ele está segurando em alguma coisa?"
msgstr "¿Está agarrado de algo?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Rua do Moinho, 410! Atrás do moinho velho!"
msgstr "¡Rua do Moinho, 410! ¡Detrás del molino viejo!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Num galho! Tá preso no galho, a água batendo no peito!"
msgstr "¡De una rama! ¡Está agarrado de una rama, el agua le llega al pecho!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Nove! Ele não sabe nadar direito!"
msgstr "¡Nueve! ¡No sabe nadar bien!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O vizinho pulou e tirou ele! Mas ele engoliu muita água, tá tossindo e roxo!"
msgstr "¡El vecino se tiró y lo sacó! ¡Pero tragó mucha agua, está tosiendo y morado!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Rápido, pelo amor de Deus! Eu fico gritando com ele pra ele não soltar!"
msgstr "¡Rápido, por el amor de Dios! ¡Yo le sigo gritando para que no se suelte!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "A água tá subindo! Choveu lá em cima da serra!"
msgstr "¡El agua está subiendo! ¡Llovió arriba en la sierra!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Tem alguém na margem com ele?"
msgstr "¿Hay alguien en la orilla con él?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai dele tá estendendo uma corda, mas não alcança."
msgstr "El padre le tira una soga, pero no llega."

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai pulou atrás dele! Agora os dois tão na água!"
msgstr "¡El padre se tiró a buscarlo! ¡Ahora los dos están en el agua!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Eles conseguem chegar na margem?"
msgstr "¿Pueden llegar a la orilla?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai pegou o menino, mas a correnteza tá forte demais!"
msgstr "¡El padre agarró al nene, pero la corriente es muy fuerte!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "A correnteza levou os dois lá pra baixo... a gente tá correndo pela margem. Cadê vocês?"
msgstr "La corriente se los llevó a los dos río abajo... estamos corriendo por la orilla. ¿Dónde están?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Os vizinhos tiraram os dois na curva do rio. O menino não acorda, e o pai bateu a cabeça."
msgstr "Los vecinos los sacaron a los dos en la curva del río. El nene no se despierta y el padre se golpeó la cabeza."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Central, o vento derrubou um fio de luz aqui na rua! Tá soltando faísca no chão!"
msgstr "¡Central, el viento tiró un cable de luz aquí en la calle! ¡Está echando chispas en el suelo!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fio está bloqueando a rua?"
msgstr "¿El cable está cortando la calle?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Rua da Estação, 450! Na frente da antiga estação de trem!"
msgstr "¡Rua da Estação, 450! ¡Frente a la vieja estación de tren!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Tá! Atravessado de um lado a outro. Os carros tão parando."
msgstr "¡Sí! Cruzado de lado a lado. Los autos están parando."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Não, graças a Deus."
msgstr "No, gracias a Dios."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Um rapaz de bicicleta passou por cima e levou um choque! Tá caído!"
msgstr "¡Un muchacho en bicicleta le pasó por encima y le dio la corriente! ¡Está tirado!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Tá. Vou ficar aqui avisando quem passar."
msgstr "Bueno. Me quedo aquí avisando a los que pasen."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "A faísca pegou no capim do terreno do lado! Tá começando um fogo!"
msgstr "¡Las chispas agarraron el pasto del terreno de al lado! ¡Está empezando un fuego!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fogo está perto das casas?"
msgstr "¿El fuego está cerca de las casas?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Ainda não, mas tá indo pro lado da cerca da Dona Nena."
msgstr "Todavía no, pero va para el lado del cerco de doña Nena."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Um cachorro encostou no fio e o dono foi puxar! Os dois tão caídos!"
msgstr "¡Un perro tocó el cable y el dueño lo fue a sacar! ¡Los dos están tirados!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O homem está respirando?"
msgstr "¿El hombre está respirando?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Acho que sim... mas tá todo duro, não mexe."
msgstr "Creo que sí... pero está todo duro, no se mueve."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fogo pegou a cerca e o quintal da Dona Nena... Ninguém apareceu!"
msgstr "¡El fuego agarró el cerco y el patio de doña Nena... No apareció nadie!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O homem do cachorro não acorda, e a Dona Nena tá passando mal com a fumaça."
msgstr "El hombre del perro no se despierta, y doña Nena se siente mal por el humo."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Dona Sônia"
msgstr "Dona Sônia"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Central, tem um homem no meu quintal mexendo no galinheiro! Agora, nesse minuto!"
msgstr "¡Central, hay un hombre en mi patio metiéndose en el gallinero! ¡Ahora, en este momento!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Você conhece a pessoa?"
msgstr "¿Conoce a la persona?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Rua do Comércio, 420! A casa da Sônia Vieira!"
msgstr "¡Rua do Comércio, 420! ¡La casa de Sônia Vieira!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Não! Nunca vi. Tá de chapéu, enfiando as galinhas num saco."
msgstr "¡No! Nunca lo vi. Lleva sombrero y mete las gallinas en una bolsa."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá com um facão na cintura!"
msgstr "¡Tiene un machete en la cintura!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá com um facão! E meu marido foi atrás dele e caiu do barranco, tá gemendo!"
msgstr "¡Tiene un machete! ¡Y mi marido fue a buscarlo y se cayó del barranco, está quejándose!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá bom. Vou apagar a luz e ficar quieta."
msgstr "Bueno. Voy a apagar la luz y quedarme quieta."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele me viu na janela! Tá vindo pra porta da cozinha!"
msgstr "¡Me vio en la ventana! ¡Viene a la puerta de la cocina!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "A porta está trancada?"
msgstr "¿La puerta está trancada?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá, mas é de madeira fina. Tô segurando com a vassoura."
msgstr "Sí, pero es de madera fina. La estoy sosteniendo con la escoba."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele quebrou o vidro da porta! Cortou a mão e tá sangrando, mas não para!"
msgstr "¡Rompió el vidrio de la puerta! ¡Se cortó la mano y está sangrando, pero no para!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele entrou na casa?"
msgstr "¿Entró a la casa?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ainda não! Tô trancada no quarto com o telefone!"
msgstr "¡Todavía no! ¡Estoy encerrada en el cuarto con el teléfono!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele levou as galinhas e o rádio da sala... foi embora. Ninguém veio."
msgstr "Se llevó las gallinas y la radio del living... se fue. No vino nadie."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Eu caí no corredor fugindo dele e torci o pé. Tá inchando muito."
msgstr "Me caí en el pasillo huyendo de él y me torcí el pie. Se está hinchando mucho."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Neta"
msgstr "Nieta"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Central, a minha avó tá passando mal! A fala dela tá esquisita!"
msgstr "¡Central, mi abuela se siente mal! ¡Habla raro!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela consegue levantar os dois braços?"
msgstr "¿Puede levantar los dos brazos?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Rua Bela Vista, 160! A casa da Dona Laudelina Prado!"
msgstr "¡Rua Bela Vista, 160! ¡La casa de doña Laudelina Prado!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Sentada na cozinha. Eu tô do lado dela."
msgstr "Sentada en la cocina. Estoy al lado de ella."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Só o esquerdo. O direito cai sozinho."
msgstr "Solo el izquierdo. El derecho se le cae solo."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela se trancou no banheiro e caiu lá dentro! A porta não abre!"
msgstr "¡Se encerró en el baño y se cayó adentro! ¡La puerta no abre!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Tá. Vou ficar segurando a mão dela."
msgstr "Bueno. Me quedo agarrándole la mano."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Agora ela não fala mais nada! Só olha pra mim!"
msgstr "¡Ahora ya no dice nada! ¡Solo me mira!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela está respirando bem?"
msgstr "¿Respira bien?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Tá, mas fazendo um barulho no peito."
msgstr "Sí, pero hace un ruido en el pecho."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela caiu da cadeira! Bateu a cabeça na quina da mesa!"
msgstr "¡Se cayó de la silla! ¡Se golpeó la cabeza con la punta de la mesa!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "A cabeça está sangrando?"
msgstr "¿La cabeza le sangra?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Um pouco. Tô apertando com o pano de prato."
msgstr "Un poco. Le estoy apretando con el repasador."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela não acorda mais... eu chamo, chamo... Vocês demoraram demais."
msgstr "Ya no se despierta... la llamo y la llamo... Tardaron demasiado."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela respira bem fraquinho, e a mão direita tá gelada."
msgstr "Respira muy despacito, y tiene la mano derecha helada."

#: data/calls/prank_01_crianca.tres
msgid "Criança"
msgstr "Niño pequeño"

#: data/calls/prank_01_crianca.tres
msgid "Central, preciso de uma ambulância!"
msgstr "¡Central, necesito una ambulancia!"

#: data/calls/prank_01_crianca.tres
msgid "Na casa do meu cachorro."
msgstr "En la casa de mi perro."

#: data/calls/prank_01_crianca.tres
msgid "Isso é sério?"
msgstr "¿Esto es en serio?"

#: data/calls/prank_01_crianca.tres
msgid "Rua Au-Au, número 4."
msgstr "Rua Au-Au, número 4."

#: data/calls/prank_01_crianca.tres
msgid "É urgente. Ele comeu meu sanduíche."
msgstr "Es urgente. Se comió mi sándwich."

#: data/calls/prank_01_crianca.tres data/calls/prank_05_menino.tres data/calls/prank_15_garoto.tres
msgid "(risadas abafadas)"
msgstr "(risas ahogadas)"

#: data/calls/prank_01_crianca.tres
msgid "(ao fundo) Desliga, desliga!"
msgstr "(de fondo) ¡Corta, corta!"

#: data/calls/prank_02_garoto.tres data/calls/prank_04_garoto.tres data/calls/prank_07_garoto.tres
msgid "Garoto"
msgstr "Chico"

#: data/calls/prank_02_garoto.tres
msgid "Central! É urgente! Tem um incêndio!"
msgstr "¡Central! ¡Es urgente! ¡Hay un incendio!"

#: data/calls/prank_02_garoto.tres
msgid "Onde é o incêndio?"
msgstr "¿Dónde es el incendio?"

#: data/calls/prank_02_garoto.tres
msgid "No meu coração..."
msgstr "En mi corazón..."

#: data/calls/prank_02_garoto.tres
msgid "...pela Marcinha da sétima série!"
msgstr "...¡por Marcinha de séptimo grado!"

#: data/calls/prank_02_garoto.tres
msgid "(risadas de várias crianças)"
msgstr "(risas de varios niños)"

#: data/calls/prank_02_garoto.tres
msgid "Esta é uma linha de serviço, garoto."
msgstr "Esta es una línea de servicio, chico."

#: data/calls/prank_02_garoto.tres
msgid "Onde você está ligando?"
msgstr "¿Desde dónde está llamando?"

#: data/calls/prank_02_garoto.tres
msgid "Fala pra ela, tá? Tchau!"
msgstr "Dígaselo, ¿sí? ¡Chau!"

#: data/calls/prank_03_menina.tres data/calls/prank_06_menina.tres data/calls/prank_12_menina.tres
msgid "Menina"
msgstr "Niña"

#: data/calls/prank_03_menina.tres
msgid "Alô? É da central telefônica?"
msgstr "¿Hola? ¿Es la central telefónica?"

#: data/calls/prank_03_menina.tres
msgid "Sim. Em que posso ajudar?"
msgstr "Sí. ¿En qué puedo ayudarle?"

#: data/calls/prank_03_menina.tres
msgid "Vocês têm o telefone de todo mundo da cidade?"
msgstr "¿Ustedes tienen el teléfono de todo el mundo en el pueblo?"

#: data/calls/prank_03_menina.tres
msgid "Temos a lista, sim."
msgstr "Tenemos la guía, sí."

#: data/calls/prank_03_menina.tres
msgid "Então cuida bem deles, tá?"
msgstr "Entonces cuídelos bien, ¿sí?"

#: data/calls/prank_03_menina.tres data/calls/prank_04_garoto.tres data/calls/prank_06_menina.tres
msgid "(risadas)"
msgstr "(risas)"

#: data/calls/prank_03_menina.tres
msgid "Minha mãe tá vindo! Tchau!"
msgstr "¡Viene mi mamá! ¡Chau!"

#: data/calls/prank_04_garoto.tres
msgid "Alô, é da central? A sua geladeira está funcionando?"
msgstr "¿Hola, es la central? ¿Su heladera está funcionando?"

#: data/calls/prank_04_garoto.tres
msgid "Aqui é a central telefônica."
msgstr "Aquí es la central telefónica."

#: data/calls/prank_04_garoto.tres
msgid "Que brincadeira é essa?"
msgstr "¿Qué broma es esta?"

#: data/calls/prank_04_garoto.tres
msgid "Então corre atrás dela!"
msgstr "¡Entonces corra a alcanzarla!"

#: data/calls/prank_05_menino.tres
msgid "Central? Aqui quem fala é o presidente da república."
msgstr "¿Central? Habla el presidente de la república."

#: data/calls/prank_05_menino.tres
msgid "Pois não, senhor presidente."
msgstr "Diga, señor presidente."

#: data/calls/prank_05_menino.tres
msgid "Esta é uma linha de serviço."
msgstr "Esta es una línea de servicio."

#: data/calls/prank_05_menino.tres
msgid "Eu quero... eu quero pedir uma pizza!"
msgstr "Quiero... ¡quiero pedir una pizza!"

#: data/calls/prank_05_menino.tres
msgid "(ao fundo) Pede cachorro-quente!"
msgstr "(de fondo) ¡Pide panchos!"

#: data/calls/prank_06_menina.tres
msgid "Sim, central telefônica. Pois não?"
msgstr "Sí, central telefónica. ¿Diga?"

#: data/calls/prank_06_menina.tres
msgid "Meu irmão quer saber se a senhora tem cara de telefone."
msgstr "Mi hermano quiere saber si usted tiene cara de teléfono."

#: data/calls/prank_06_menina.tres
msgid "Esta é uma linha de serviço, menina."
msgstr "Esta es una línea de servicio, niña."

#: data/calls/prank_06_menina.tres
msgid "Onde estão seus pais?"
msgstr "¿Dónde están tus padres?"

#: data/calls/prank_06_menina.tres
msgid "Foi ele que mandou falar! Tchau!"
msgstr "¡Él me dijo que lo dijera! ¡Chau!"

#: data/calls/prank_07_garoto.tres
msgid "Central, eu quero denunciar um crime!"
msgstr "¡Central, quiero denunciar un crimen!"

#: data/calls/prank_07_garoto.tres
msgid "Qual crime? Onde?"
msgstr "¿Qué crimen? ¿Dónde?"

#: data/calls/prank_07_garoto.tres
msgid "Roubaram a minha bicicleta..."
msgstr "Me robaron la bicicleta..."

#: data/calls/prank_07_garoto.tres
msgid "...e devolveram pintada de rosa!"
msgstr "...¡y la devolvieron pintada de rosa!"

#: data/calls/prank_07_garoto.tres
msgid "(risadas ao fundo)"
msgstr "(risas de fondo)"

#: data/calls/prank_07_garoto.tres
msgid "Você sabe que trote é crime, não sabe?"
msgstr "Sabe que las bromas telefónicas son un delito, ¿no?"

#: data/calls/prank_07_garoto.tres
msgid "Qual é o seu endereço?"
msgstr "¿Cuál es su dirección?"

#: data/calls/prank_07_garoto.tres
msgid "Rua dos Bobos, número zero!"
msgstr "¡Rua dos Bobos, número cero!"

#: data/calls/prank_08_rapaz.tres
msgid "Boa noite, é do Corpo de Bombeiros?"
msgstr "Buenas noches, ¿son los bomberos?"

#: data/calls/prank_08_rapaz.tres
msgid "Não, aqui é a central telefônica. Precisa dos bombeiros?"
msgstr "No, aquí es la central telefónica. ¿Necesita a los bomberos?"

#: data/calls/prank_08_rapaz.tres
msgid "Preciso. Tem um bicho enorme em cima da caixa d'água."
msgstr "Sí. Hay un bicho enorme arriba del tanque de agua."

#: data/calls/prank_08_rapaz.tres
msgid "Ah não, pera... é a minha sogra."
msgstr "Ah no, espere... es mi suegra."

#: data/calls/prank_09_menino.tres
msgid "Alô, central? Aqui é da companhia telefônica."
msgstr "¿Hola, central? Habla la compañía telefónica."

#: data/calls/prank_09_menino.tres
msgid "Vamos testar a linha. A senhora pode assoviar?"
msgstr "Vamos a probar la línea. ¿Usted puede silbar?"

#: data/calls/prank_09_menino.tres
msgid "Isso não é um teste de verdade, é?"
msgstr "Esto no es una prueba de verdad, ¿no?"

#: data/calls/prank_09_menino.tres
msgid "Qual companhia?"
msgstr "¿Qué compañía?"

#: data/calls/prank_09_menino.tres
msgid "(tentando não rir) Assovia, por favor..."
msgstr "(tratando de no reírse) Silbe, por favor..."

#: data/calls/prank_10_rapaz.tres
msgid "Alô? Gostaria de falar com a Paula!"
msgstr "¿Aló? ¡Quisiera hablar con Aitor!"

#: data/calls/prank_10_rapaz.tres
msgid "Que Paula, por favor?"
msgstr "¿Qué Aitor, por favor?"

#: data/calls/prank_10_rapaz.tres
msgid "Paula Tejano!"
msgstr "¡Aitor Tilla!"

#: data/calls/prank_11_menino.tres
msgid "Alô? A senhora tem água encanada aí?"
msgstr "¿Aló? ¿Usted tiene agua corriente ahí?"

#: data/calls/prank_11_menino.tres
msgid "Tenho, por quê?"
msgstr "Sí, ¿por qué?"

#: data/calls/prank_11_menino.tres
msgid "Então solta ela, que ela é inocente!"
msgstr "¡Entonces déjela correr, que es inocente!"

#: data/calls/prank_12_menina.tres
msgid "Moça, quanto é sete vezes oito?"
msgstr "Señorita, ¿cuánto es siete por ocho?"

#: data/calls/prank_12_menina.tres
msgid "Cinquenta e seis."
msgstr "Cincuenta y seis."

#: data/calls/prank_12_menina.tres
msgid "Isso não é serviço da central."
msgstr "Eso no es trabajo de la central."

#: data/calls/prank_12_menina.tres
msgid "Brigada! A professora disse pra perguntar pra quem sabe!"
msgstr "¡Gracias! ¡La maestra dijo que le preguntara a alguien que sabe!"

#: data/calls/prank_12_menina.tres data/calls/prank_20_menina.tres
msgid "(risadinha)"
msgstr "(risita)"

#: data/calls/prank_13_menino.tres
msgid "Alô? É do Polo Norte?"
msgstr "¿Aló? ¿Es el Polo Norte?"

#: data/calls/prank_13_menino.tres
msgid "Não, aqui é a central de São Sotero."
msgstr "No, aquí es la central de São Sotero."

#: data/calls/prank_13_menino.tres
msgid "Ah... então avisa o Papai Noel que eu me comportei, tá?"
msgstr "Ah... entonces avísele a Papá Noel que me porté bien, ¿sí?"

#: data/calls/prank_13_menino.tres
msgid "Quase o ano todo!"
msgstr "¡Casi todo el año!"

#: data/calls/prank_14_rapaz.tres
msgid "Boa noite. Me liga com o seu Armando?"
msgstr "Buenas noches. ¿Me comunica con el señor Armando?"

#: data/calls/prank_14_rapaz.tres
msgid "Armando de quê?"
msgstr "¿Armando qué?"

#: data/calls/prank_14_rapaz.tres
msgid "Armando Barraco!"
msgstr "¡Armando Barraco! ¡Armando lío!"

#: data/calls/prank_14_rapaz.tres
msgid "(gargalhadas)"
msgstr "(carcajadas)"

#: data/calls/prank_15_garoto.tres
msgid "Central? Eu tenho um recado muito importante pra senhora."
msgstr "¿Central? Tengo un recado muy importante para usted."

#: data/calls/prank_15_garoto.tres
msgid "Pois não?"
msgstr "¿Sí?"

#: data/calls/prank_15_garoto.tres
msgid "(um arroto enorme)"
msgstr "(un eructo enorme)"

#: data/calls/prank_16_rapaz.tres
msgid "Locutor"
msgstr "Locutor"

#: data/calls/prank_16_rapaz.tres
msgid "Parabéns! A senhora acaba de ganhar o grande prêmio da noite!"
msgstr "¡Felicitaciones! ¡Acaba de ganar el gran premio de la noche!"

#: data/calls/prank_16_rapaz.tres
msgid "Ganhei o quê?"
msgstr "¿Gané qué?"

#: data/calls/prank_16_rapaz.tres
msgid "Isso é trote, rapaz."
msgstr "Esto es una broma, muchacho."

#: data/calls/prank_16_rapaz.tres
msgid "Uma noite inteirinha atendendo telefone!"
msgstr "¡Una noche enterita atendiendo el teléfono!"

#: data/calls/prank_17_menino.tres
msgid "Alô, é do zoológico?"
msgstr "¿Aló, es el zoológico?"

#: data/calls/prank_17_menino.tres
msgid "Não, aqui é a central telefônica."
msgstr "No, aquí es la central telefónica."

#: data/calls/prank_17_menino.tres
msgid "Ué! Então por que é que atendeu um macaco?"
msgstr "¡Uy! ¿Entonces por qué contestó un mono?"

#: data/calls/prank_18_garoto.tres
msgid "(voz grossa) Aqui quem fala é o prefeito. Exijo falar com a telefonista."
msgstr "(voz gruesa) Habla el intendente. Exijo hablar con la operadora."

#: data/calls/prank_18_garoto.tres
msgid "Sou eu mesma. Pois não, senhor prefeito?"
msgstr "Ella habla. ¿En qué puedo ayudarlo, señor intendente?"

#: data/calls/prank_18_garoto.tres
msgid "Quantos anos o senhor tem?"
msgstr "¿Y cuántos años tiene usted?"

#: data/calls/prank_18_garoto.tres
msgid "(a voz afina) ...Mãe! Ela descobriu!"
msgstr "(la voz se afina) ...¡Mamá! ¡Se dio cuenta!"

#: data/calls/prank_19_criancas.tres
msgid "Crianças"
msgstr "Niños"

#: data/calls/prank_19_criancas.tres
msgid "(várias vozes) Parabéns pra você, nesta data querida..."
msgstr "(varias voces) Feliz cumpleaños a ti, feliz cumpleaños a ti..."

#: data/calls/prank_19_criancas.tres
msgid "Mas hoje não é meu aniversário."
msgstr "Pero hoy no es mi cumpleaños."

#: data/calls/prank_19_criancas.tres
msgid "A gente sabe!"
msgstr "¡Ya sabemos!"

#: data/calls/prank_20_menina.tres
msgid "Alô? Aí é a casa do Zé?"
msgstr "¿Aló? ¿Es la casa de Zé?"

#: data/calls/prank_20_menina.tres
msgid "Não, aqui é a central."
msgstr "No, aquí es la central."

#: data/calls/prank_20_menina.tres
msgid "Então por que é que atendeu?"
msgstr "¿Y entonces por qué contestó?"

#: data/templates/transfer_01.tres
msgid "Me liga com {place}, por favor? {reason}"
msgstr "¿Me comunica con {place}, por favor? {reason}"

#: data/templates/transfer_01.tres
msgid "Eu pedi {place}."
msgstr "Pedí {place}."

#: data/templates/transfer_02.tres
msgid "Pode me ligar {to_place}?"
msgstr "¿Me puede comunicar {to_place}?"

#: data/templates/transfer_02.tres data/templates/transfer_03.tres data/templates/transfer_07.tres
msgid "{reason}"
msgstr "{reason}"

#: data/templates/transfer_02.tres
msgid "{place}, por favor."
msgstr "{place}, por favor."

#: data/templates/transfer_03.tres
msgid "Queria falar com {place}."
msgstr "Quería hablar con {place}."

#: data/templates/transfer_03.tres
msgid "Com {place}."
msgstr "Con {place}."

#: data/templates/transfer_04.tres
msgid "Me conecta com o {number}, por favor?"
msgstr "¿Me comunica con el {number}, por favor?"

#: data/templates/transfer_04.tres
msgid "É {of_place}. {reason}"
msgstr "Es el {of_place}. {reason}"

#: data/templates/transfer_04.tres
msgid "{digits}."
msgstr "{digits}."

#: data/templates/transfer_05.tres
msgid "Alô, central?"
msgstr "¿Hola, central?"

#: data/templates/transfer_05.tres
msgid "Me passa {to_place}? {reason}"
msgstr "¿Me pasa {to_place}? {reason}"

#: data/templates/transfer_05.tres
msgid "Eu quero falar com {place}."
msgstr "Quiero hablar con {place}."

#: data/templates/transfer_06.tres
msgid "Boa noite. Desculpe a hora."
msgstr "Buenas noches. Disculpe la hora."

#: data/templates/transfer_06.tres
msgid "Preciso falar com {place}. {reason}"
msgstr "Necesito hablar con {place}. {reason}"

#: data/templates/transfer_06.tres
msgid "Com {place}, por favor."
msgstr "Con {place}, por favor."

#: data/templates/transfer_07.tres
msgid "Me liga com {place}, lá da {street}?"
msgstr "¿Me comunica con {place}, que está en la {street}?"

#: data/templates/transfer_07.tres
msgid "{place}, da {street}."
msgstr "{place}, en la {street}."

#: data/templates/transfer_08.tres data/content.tres
msgid "Alô? Central?"
msgstr "¿Hola? ¿Central?"

#: data/templates/transfer_08.tres
msgid "Faz favor de me ligar {to_place}. {reason}"
msgstr "Hágame el favor de comunicarme {to_place}. {reason}"

#: data/templates/transfer_08.tres
msgid "{place}, moça."
msgstr "{place}, joven."

#: data/templates/transfer_09.tres
msgid "Central? Graças a Deus que atendeu."
msgstr "¿Central? Gracias a Dios que contestó."

#: data/templates/transfer_09.tres
msgid "Pode me ligar com {place}? {reason}"
msgstr "¿Puede comunicarme con {place}? {reason}"

#: data/templates/transfer_09.tres
msgid "{place}. Por favor, é importante."
msgstr "{place}. Por favor, es importante."

#: data/templates/transfer_10.tres
msgid "Boa noite. É da central?"
msgstr "Buenas noches. ¿Es la central?"

#: data/templates/transfer_10.tres
msgid "Eu ia pedir o número {of_place}, mas pode ligar direto."
msgstr "Iba a pedir el número {of_place}, pero puede comunicarme directamente."

#: data/templates/transfer_10.tres
msgid "{place}, na {street}."
msgstr "{place}, en la {street}."

#: data/content.tres
msgid "Agradeço. Boa noite."
msgstr "Se lo agradezco. Buenas noches."

#: data/content.tres
msgid "Ótimo. Boa noite."
msgstr "Perfecto. Buenas noches."

#: data/content.tres
msgid "Isso. Boa noite pra senhora."
msgstr "Eso es. Buenas noches para usted."

#: data/content.tres
msgid "{name}."
msgstr "{name}."

#: data/content.tres
msgid "É {name}."
msgstr "Es {name}."

#: data/content.tres
msgid "Aqui é {name}."
msgstr "Habla {name}."

#: data/content.tres
msgid "Meu nome é {name}."
msgstr "Me llamo {name}."

#: data/templates/trunk_01.tres
msgid "Boa noite. Eu queria fazer um interurbano {to_city}."
msgstr "Buenas noches. Quería hacer una llamada de larga distancia {to_city}."

#: data/templates/trunk_01.tres
msgid "O número é {far}. É da minha irmã."
msgstr "El número es {far}. Es de mi hermana."

#: data/templates/trunk_01.tres
msgid "Um interurbano {to_city}, número {far}."
msgstr "Una llamada {to_city}, número {far}."

#: data/templates/trunk_02.tres
msgid "Central? Preciso ligar {to_city}, é sobre um negócio."
msgstr "¿Central? Necesito llamar {to_city}, es por un negocio."

#: data/templates/trunk_02.tres
msgid "Anota aí: {far}."
msgstr "Anote: {far}."

#: data/templates/trunk_02.tres
msgid "{to_city}, moça. O número é {far}."
msgstr "{to_city}, joven. El número es {far}."

#: data/templates/trunk_03.tres
msgid "Boa noite. Dá pra completar uma ligação {to_city}?"
msgstr "Buenas noches. ¿Puede completar una llamada {to_city}?"

#: data/templates/trunk_03.tres
msgid "É o {far}, do meu filho. Ele mudou pra lá faz pouco."
msgstr "Es el {far}, de mi hijo. Se mudó allá hace poco."

#: data/templates/trunk_03.tres
msgid "É {to_city}. {far}."
msgstr "Es {to_city}. {far}."

#: data/templates/trunk_04.tres
msgid "Alô, central. Um interurbano {to_city}, por favor."
msgstr "Hola, central. Una llamada de larga distancia {to_city}, por favor."

#: data/templates/trunk_04.tres
msgid "Número {far}. Pode cobrar aqui, tá?"
msgstr "Número {far}. Puede cobrarlo aquí, ¿sí?"

#: data/templates/trunk_04.tres
msgid "{to_city}, o {far}."
msgstr "{to_city}, el {far}."

#: data/content.tres
msgid "pra Capital"
msgstr "a la Capital"

#: data/content.tres
msgid "pro Norte"
msgstr "al Norte"

#: data/content.tres
msgid "pro Sul"
msgstr "al Sur"

#: data/content.tres
msgid "pro Leste"
msgstr "al Este"

#: data/content.tres
msgid "pro Oeste"
msgstr "al Oeste"

#: data/content.tres
msgid "pro Litoral"
msgstr "al Litoral"

#: data/templates/emergency_incendio.tres
msgid "Central! Tá pegando fogo numa casa aqui na {street}! Já tá subindo pelo telhado!"
msgstr "¡Central! ¡Se está quemando una casa aquí en {street}! ¡Ya está subiendo por el techo!"

#: data/templates/emergency_incendio.tres
msgid "{address}! Vem logo!"
msgstr "¡{address}! ¡Vengan rápido!"

#: data/templates/emergency_incendio.tres
msgid "Não, todo mundo saiu."
msgstr "No, todos salieron."

#: data/templates/emergency_incendio.tres
msgid "Não, foi só o susto."
msgstr "No, solo el susto."

#: data/templates/emergency_incendio.tres
msgid "A dona da casa queimou as mãos tentando apagar!"
msgstr "¡La dueña de la casa se quemó las manos tratando de apagarlo!"

#: data/templates/emergency_incendio.tres
msgid "Tá bom. A gente vai se afastar."
msgstr "Está bien. Nos vamos a alejar."

#: data/templates/emergency_incendio.tres
msgid "O fogo tá passando pra casa do vizinho!"
msgstr "¡El fuego está pasando a la casa del vecino!"

#: data/templates/emergency_incendio.tres
msgid "A casa do vizinho tem gente?"
msgstr "¿Hay gente en la casa del vecino?"

#: data/templates/emergency_incendio.tres
msgid "Tem! O vizinho de idade mora sozinho lá!"
msgstr "¡Sí! ¡El vecino mayor vive solo ahí!"

#: data/templates/emergency_incendio.tres
msgid "O vizinho de idade não saiu! Tá na janela pedindo ajuda!"
msgstr "¡El vecino mayor no salió! ¡Está en la ventana pidiendo ayuda!"

#: data/templates/emergency_incendio.tres
msgid "Ele consegue sair pela janela?"
msgstr "¿Puede salir por la ventana?"

#: data/templates/emergency_incendio.tres
msgid "Não! É alto demais e ele mal anda!"
msgstr "¡No! ¡Es muy alto y casi no camina!"

#: data/templates/emergency_incendio.tres
msgid "O telhado caiu... Vocês demoraram demais!"
msgstr "Se cayó el techo... ¡Tardaron demasiado!"

#: data/templates/emergency_incendio.tres
msgid "Tiraram o vizinho pela escada dos fundos, mas ele respirou muita fumaça!"
msgstr "¡Sacaron al vecino por la escalera de atrás, pero respiró mucho humo!"

#: data/templates/emergency_mal_subito.tres
msgid "Central, o meu vizinho desmaiou!"
msgstr "¡Central, mi vecino se desmayó!"

#: data/templates/emergency_mal_subito.tres
msgid "Onde ele está?"
msgstr "¿Dónde está?"

#: data/templates/emergency_mal_subito.tres
msgid "{address}. Vem rápido!"
msgstr "{address}. ¡Vengan rápido!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá, mas bem fraquinho."
msgstr "Sí, pero muy débil."

#: data/templates/emergency_mal_subito.tres
msgid "Caído aqui na calçada, na frente de casa."
msgstr "Tirado aquí en la vereda, frente a mi casa."

#: data/templates/emergency_mal_subito.tres
msgid "Na cozinha da casa dele. E tá um cheiro forte de gás lá dentro!"
msgstr "En la cocina de su casa. ¡Y hay un olor fuerte a gas ahí adentro!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá. Eu espero aqui na porta."
msgstr "Bueno. Espero aquí en la puerta."

#: data/templates/emergency_mal_subito.tres
msgid "Não. Eu chamo e ele não responde."
msgstr "No. Lo llamo y no responde."

#: data/templates/emergency_mal_subito.tres
msgid "Ele bateu em alguma coisa?"
msgstr "¿Se golpeó con algo?"

#: data/templates/emergency_mal_subito.tres
msgid "Bateu a cabeça no chão, tá sangrando!"
msgstr "¡Se golpeó la cabeza contra el piso, está sangrando!"

#: data/templates/emergency_mal_subito.tres
msgid "Ele... parou de respirar. Vocês demoraram demais."
msgstr "Él... dejó de respirar. Tardaron demasiado."

#: data/templates/emergency_mal_subito.tres
msgid "Ele não respira... um vizinho tá fazendo massagem no peito dele."
msgstr "No respira... un vecino le está haciendo masaje en el pecho."

#: data/templates/emergency_acidente.tres
msgid "Central, teve uma batida feia aqui na {street}!"
msgstr "¡Central, hubo un choque feo aquí en la {street}!"

#: data/templates/emergency_acidente.tres
msgid "{address}, na esquina!"
msgstr "¡{address}, en la esquina!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz da moto. Tá no chão, mas mexe as pernas."
msgstr "El muchacho de la moto. Está en el piso, pero mueve las piernas."

#: data/templates/emergency_acidente.tres
msgid "Tá. A moto e o carro tão no meio da rua."
msgstr "Sí. La moto y el auto están en medio de la calle."

#: data/templates/emergency_acidente.tres
msgid "O motorista do carro tá preso nas ferragens, com a perna sangrando!"
msgstr "¡El conductor del auto está atrapado entre los fierros, con la pierna sangrando!"

#: data/templates/emergency_acidente.tres
msgid "Não, já empurraram tudo pra calçada."
msgstr "No, ya empujaron todo a la vereda."

#: data/templates/emergency_acidente.tres
msgid "Tá bom. Eu fico aqui esperando."
msgstr "Está bien. Me quedo aquí esperando."

#: data/templates/emergency_acidente.tres
msgid "Tá juntando gente em volta, os carros não passam mais!"
msgstr "¡Se está juntando gente alrededor, ya no pasan los autos!"

#: data/templates/emergency_acidente.tres
msgid "Tem! Tão tentando abrir o capô!"
msgstr "¡Sí! ¡Están tratando de abrir el capó!"

#: data/templates/emergency_acidente.tres
msgid "O carro pegou fogo! Por que demorou tanto?!"
msgstr "¡El auto se prendió fuego! ¡¿Por qué tardaron tanto?!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz que abriu o capô queimou as mãos!"
msgstr "¡El muchacho que abrió el capó se quemó las manos!"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Central, tem alguém tentando abrir a porta dos fundos."
msgstr "(en voz baja) Central, hay alguien tratando de abrir la puerta de atrás."

#: data/templates/emergency_invasao.tres
msgid "Tem mais alguém em casa?"
msgstr "¿Hay alguien más en la casa?"

#: data/templates/emergency_invasao.tres
msgid "Você viu a pessoa?"
msgstr "¿Vio a la persona?"

#: data/templates/emergency_invasao.tres
msgid "{address}. Rápido, por favor."
msgstr "{address}. Rápido, por favor."

#: data/templates/emergency_invasao.tres
msgid "Não, só eu."
msgstr "No, solo yo."

#: data/templates/emergency_invasao.tres
msgid "Só a sombra pela janela."
msgstr "Solo la sombra por la ventana."

#: data/templates/emergency_invasao.tres
msgid "Tá. Não vou fazer barulho."
msgstr "Está bien. No voy a hacer ruido."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele conseguiu abrir... tá dentro de casa."
msgstr "(en voz baja) Logró abrir... está adentro de la casa."

#: data/templates/emergency_invasao.tres
msgid "Você está em um lugar seguro?"
msgstr "¿Está en un lugar seguro?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) No quarto, debaixo da cama."
msgstr "(en voz baja) En el cuarto, debajo de la cama."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele tá subindo a escada..."
msgstr "(en voz baja) Está subiendo la escalera..."

#: data/templates/emergency_invasao.tres
msgid "Ele sabe que você está em casa?"
msgstr "¿Sabe que usted está en casa?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Acho que sim... ouvi ele chamar alguém."
msgstr "(en voz baja) Creo que sí... lo oí llamar a alguien."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele levou tudo e foi embora. Ninguém veio."
msgstr "(llorando) Se llevó todo y se fue. No vino nadie."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele me empurrou na escada quando foi embora... meu braço tá torto."
msgstr "(llorando) Me empujó por la escalera cuando se fue... tengo el brazo torcido."

#: data/templates/emergency_briga.tres
msgid "Central, tem uma briga feia no meio da {street}!"
msgstr "¡Central, hay una pelea fea en medio de la {street}!"

#: data/templates/emergency_briga.tres
msgid "{address}! Dá pra ver daqui de casa!"
msgstr "¡{address}! ¡Se ve desde mi casa!"

#: data/templates/emergency_briga.tres
msgid "Um tá com um pedaço de pau!"
msgstr "¡Uno tiene un palo!"

#: data/templates/emergency_briga.tres
msgid "Ainda não, mas vai acabar mal!"
msgstr "¡Todavía no, pero esto va a terminar mal!"

#: data/templates/emergency_briga.tres
msgid "Um caiu e bateu a cabeça na guia! Tá sangrando!"
msgstr "¡Uno se cayó y se golpeó la cabeza contra el cordón! ¡Está sangrando!"

#: data/templates/emergency_briga.tres
msgid "Tá. Vou entrar e trancar a porta."
msgstr "Está bien. Voy a entrar y cerrar con llave."

#: data/templates/emergency_briga.tres
msgid "Chegou mais gente! Agora são uns dez!"
msgstr "¡Llegó más gente! ¡Ahora son como diez!"

#: data/templates/emergency_briga.tres
msgid "Alguém está armado agora?"
msgstr "¿Alguien está armado ahora?"

#: data/templates/emergency_briga.tres
msgid "Apareceu um com uma faca!"
msgstr "¡Apareció uno con un cuchillo!"

#: data/templates/emergency_briga.tres
msgid "Derrubaram um no chão e tão chutando! Ele não se mexe!"
msgstr "¡Tiraron a uno al piso y lo están pateando! ¡No se mueve!"

#: data/templates/emergency_briga.tres
msgid "Acho que sim... mas tá com o rosto todo machucado!"
msgstr "Creo que sí... ¡pero tiene la cara toda lastimada!"

#: data/templates/emergency_briga.tres
msgid "Fugiram todos... e o rapaz continua no chão. Ninguém veio."
msgstr "Se escaparon todos... y el muchacho sigue en el piso. No vino nadie."

#: data/templates/emergency_briga.tres
msgid "O rapaz continua no chão, sangrando muito pela cabeça!"
msgstr "¡El muchacho sigue en el piso, sangrando mucho de la cabeza!"

#: data/templates/emergency_queda.tres
msgid "Central, um homem caiu do telhado aqui na {street}!"
msgstr "¡Central, un hombre se cayó del techo aquí en la {street}!"

#: data/templates/emergency_queda.tres
msgid "Ele mexe as pernas?"
msgstr "¿Mueve las piernas?"

#: data/templates/emergency_queda.tres
msgid "{address}! Ele tava arrumando as telhas!"
msgstr "¡{address}! ¡Estaba arreglando las tejas!"

#: data/templates/emergency_queda.tres
msgid "Tá, mas gemendo muito."
msgstr "Sí, pero se queja mucho."

#: data/templates/emergency_queda.tres
msgid "Mexe, mas o braço tá torto."
msgstr "Sí, pero tiene el brazo torcido."

#: data/templates/emergency_queda.tres
msgid "Mexe... mas ele caiu em cima do muro e ficou preso entre o muro e a grade!"
msgstr "Sí... ¡pero cayó sobre el muro y quedó atrapado entre el muro y la reja!"

#: data/templates/emergency_queda.tres
msgid "Tá. A gente não vai mexer nele."
msgstr "Bueno. No lo vamos a mover."

#: data/templates/emergency_queda.tres
msgid "Ele tá ficando pálido e com frio!"
msgstr "¡Se está poniendo pálido y frío!"

#: data/templates/emergency_queda.tres
msgid "Ele bateu a cabeça?"
msgstr "¿Se golpeó la cabeza?"

#: data/templates/emergency_queda.tres
msgid "Acho que sim. Tem sangue atrás da orelha."
msgstr "Creo que sí. Tiene sangre detrás de la oreja."

#: data/templates/emergency_queda.tres
msgid "Ele apagou! Não responde mais!"
msgstr "¡Se desmayó! ¡Ya no responde!"

#: data/templates/emergency_queda.tres
msgid "Tá, mas bem curtinho."
msgstr "Sí, pero muy cortito."

#: data/templates/emergency_queda.tres
msgid "Ele não acorda mais... e ninguém veio."
msgstr "Ya no se despierta... y no vino nadie."

#: data/templates/emergency_queda.tres
msgid "Ele respira bem fraco, e a cabeça não para de sangrar."
msgstr "Respira muy débil, y la cabeza no para de sangrar."

#: data/templates/emergency_fio_caido.tres
msgid "Central, caiu um fio de luz no meio da {street}! Tá soltando faísca!"
msgstr "¡Central, se cayó un cable de luz en medio de la {street}! ¡Está echando chispas!"

#: data/templates/emergency_fio_caido.tres
msgid "O fio está fechando a rua?"
msgstr "¿El cable corta la calle?"

#: data/templates/emergency_fio_caido.tres
msgid "{address}! Bem na frente de casa!"
msgstr "¡{address}! ¡Justo frente a mi casa!"

#: data/templates/emergency_fio_caido.tres
msgid "Tá, de ponta a ponta. Os carros tão parando."
msgstr "Sí, de punta a punta. Los autos están parando."

#: data/templates/emergency_fio_caido.tres
msgid "Não, ainda não."
msgstr "No, todavía no."

#: data/templates/emergency_fio_caido.tres
msgid "Um senhor encostou nele sem ver e caiu duro na calçada!"
msgstr "¡Un señor lo tocó sin ver y cayó duro en la vereda!"

#: data/templates/emergency_fio_caido.tres
msgid "Tá. Vou segurar o povo longe."
msgstr "Bueno. Voy a mantener a la gente lejos."

#: data/templates/emergency_fio_caido.tres
msgid "A faísca pegou fogo no mato da calçada!"
msgstr "¡Las chispas prendieron fuego al pasto de la vereda!"

#: data/templates/emergency_fio_caido.tres
msgid "O fogo está perto de alguma casa?"
msgstr "¿El fuego está cerca de alguna casa?"

#: data/templates/emergency_fio_caido.tres
msgid "Do muro do vizinho. Ainda dá pra apagar com balde."
msgstr "Del muro del vecino. Todavía se puede apagar con un balde."

#: data/templates/emergency_fio_caido.tres
msgid "Um menino de bicicleta passou por cima do fio! Tá caído!"
msgstr "¡Un nene en bicicleta pasó por encima del cable! ¡Está tirado!"

#: data/templates/emergency_fio_caido.tres
msgid "Não! E a mão dele tá preta!"
msgstr "¡No! ¡Y tiene la mano negra!"

#: data/templates/emergency_fio_caido.tres
msgid "O fogo pegou a casa do vizinho... e ninguém veio."
msgstr "El fuego agarró la casa del vecino... y no vino nadie."

#: data/templates/emergency_fio_caido.tres
msgid "O menino da bicicleta não acorda, e o vizinho queimou o braço."
msgstr "El nene de la bicicleta no se despierta, y el vecino se quemó el brazo."

#: data/templates/emergency_gas.tres
msgid "Central, tá um cheiro forte de gás na casa do lado, aqui na {street}!"
msgstr "¡Central, hay un olor fuerte a gas en la casa de al lado, aquí en la {street}!"

#: data/templates/emergency_gas.tres
msgid "Alguém está passando mal?"
msgstr "¿Alguien se siente mal?"

#: data/templates/emergency_gas.tres
msgid "{address}! A casa de muro azul!"
msgstr "¡{address}! ¡La casa del muro azul!"

#: data/templates/emergency_gas.tres
msgid "Acho que não, tá tudo apagado."
msgstr "Creo que no, está todo apagado."

#: data/templates/emergency_gas.tres
msgid "Não, só a gente aqui fora com o nariz ardendo."
msgstr "No, solo nosotros aquí afuera con la nariz ardiendo."

#: data/templates/emergency_gas.tres
msgid "Tem! A dona da casa tá lá dentro e não atende!"
msgstr "¡Sí! ¡La dueña está adentro y no contesta!"

#: data/templates/emergency_gas.tres
msgid "Tá. Ninguém vai acender nada aqui."
msgstr "Bueno. Nadie va a prender nada aquí."

#: data/templates/emergency_gas.tres
msgid "O cheiro tá chegando na rua toda!"
msgstr "¡El olor está llegando a toda la calle!"

#: data/templates/emergency_gas.tres
msgid "Os vizinhos saíram de casa?"
msgstr "¿Los vecinos salieron de sus casas?"

#: data/templates/emergency_gas.tres
msgid "Quase todos. Tô batendo nas portas."
msgstr "Casi todos. Estoy golpeando las puertas."

#: data/templates/emergency_gas.tres
msgid "Uma senhora da casa de trás desmaiou no portão!"
msgstr "¡Una señora de la casa de atrás se desmayó en el portón!"

#: data/templates/emergency_gas.tres
msgid "Tá, mas tá roxinha."
msgstr "Sí, pero está moradita."

#: data/templates/emergency_gas.tres
msgid "Teve um estouro! As janelas voaram longe!"
msgstr "¡Hubo una explosión! ¡Las ventanas volaron lejos!"

#: data/templates/emergency_gas.tres
msgid "A senhora não acorda, e um rapaz cortou o rosto no vidro."
msgstr "La señora no se despierta, y un muchacho se cortó la cara con el vidrio."

#: data/templates/emergency_atropelamento.tres
msgid "Central, um carro atropelou um rapaz aqui na {street} e fugiu!"
msgstr "¡Central, un auto atropelló a un muchacho aquí en la {street} y se escapó!"

#: data/templates/emergency_atropelamento.tres
msgid "Ele está no meio da rua?"
msgstr "¿Está en medio de la calle?"

#: data/templates/emergency_atropelamento.tres
msgid "{address}! Na esquina!"
msgstr "¡{address}! ¡En la esquina!"

#: data/templates/emergency_atropelamento.tres
msgid "Tá, mas a perna tá toda torta."
msgstr "Sí, pero tiene la pierna toda torcida."

#: data/templates/emergency_atropelamento.tres
msgid "Tá! A gente tá desviando os carros com a mão."
msgstr "¡Sí! Estamos desviando los autos con la mano."

#: data/templates/emergency_atropelamento.tres
msgid "Tá bom. A gente fica aqui com ele."
msgstr "Bueno. Nos quedamos aquí con él."

#: data/templates/emergency_atropelamento.tres
msgid "A perna dele tá sangrando muito!"
msgstr "¡La pierna le sangra mucho!"

#: data/templates/emergency_atropelamento.tres
msgid "Dá pra apertar o machucado com um pano?"
msgstr "¿Pueden apretar la herida con un trapo?"

#: data/templates/emergency_atropelamento.tres
msgid "Tô apertando com a minha camisa."
msgstr "Estoy apretando con mi camisa."

#: data/templates/emergency_atropelamento.tres
msgid "Ele tá fechando o olho! Tá gelado!"
msgstr "¡Está cerrando los ojos! ¡Está helado!"

#: data/templates/emergency_atropelamento.tres
msgid "Só aperta a minha mão."
msgstr "Solo me aprieta la mano."

#: data/templates/emergency_atropelamento.tres
msgid "Ele desmaiou... a gente esperou e ninguém veio."
msgstr "Se desmayó... esperamos y no vino nadie."

#: data/templates/emergency_atropelamento.tres
msgid "Ele respira, mas não acorda, e a camisa tá encharcada de sangue."
msgstr "Respira, pero no se despierta, y la camisa está empapada de sangre."

#: data/templates/emergency_desabamento.tres
msgid "Central, um muro desabou aqui na {street}! Caiu em cima de alguém!"
msgstr "¡Central, se derrumbó un muro aquí en la {street}! ¡Le cayó encima a alguien!"

#: data/templates/emergency_desabamento.tres
msgid "A pessoa está presa?"
msgstr "¿La persona está atrapada?"

#: data/templates/emergency_desabamento.tres
msgid "Ela fala com vocês?"
msgstr "¿Les habla?"

#: data/templates/emergency_desabamento.tres
msgid "{address}! O muro do terreno da esquina!"
msgstr "¡{address}! ¡El muro del terreno de la esquina!"

#: data/templates/emergency_desabamento.tres
msgid "Tá! As pernas tão embaixo dos tijolos!"
msgstr "¡Sí! ¡Tiene las piernas debajo de los ladrillos!"

#: data/templates/emergency_desabamento.tres
msgid "Fala, mas tá chorando de dor."
msgstr "Sí, pero llora de dolor."

#: data/templates/emergency_desabamento.tres
msgid "Tá. A gente não vai puxar ela."
msgstr "Bueno. No la vamos a tirar."

#: data/templates/emergency_desabamento.tres
msgid "O resto do muro tá rachando! Pode cair mais!"
msgstr "¡El resto del muro se está rajando! ¡Puede caer más!"

#: data/templates/emergency_desabamento.tres
msgid "Tem mais alguém perto do muro?"
msgstr "¿Hay alguien más cerca del muro?"

#: data/templates/emergency_desabamento.tres
msgid "O marido dela, tirando os tijolos com a mão."
msgstr "El marido, sacando los ladrillos con la mano."

#: data/templates/emergency_desabamento.tres
msgid "Caiu outro pedaço! Pegou o marido dela no ombro!"
msgstr "¡Se cayó otro pedazo! ¡Le pegó al marido en el hombro!"

#: data/templates/emergency_desabamento.tres
msgid "Ele consegue sair dali?"
msgstr "¿Puede salir de ahí?"

#: data/templates/emergency_desabamento.tres
msgid "Saiu, mas o braço tá pendurado."
msgstr "Salió, pero tiene el brazo colgando."

#: data/templates/emergency_desabamento.tres
msgid "O muro caiu todo... ninguém apareceu."
msgstr "El muro se cayó entero... no apareció nadie."

#: data/templates/emergency_desabamento.tres
msgid "Ela não responde mais, e o marido tá com o ombro quebrado."
msgstr "Ya no responde, y el marido tiene el hombro roto."

#: data/content.tres
msgid "{street}, perto {landmark}"
msgstr "{street}, cerca {landmark}"

#: data/content.tres
msgid "na frente {landmark}, na {street}"
msgstr "enfrente {landmark}, en la {street}"

#: data/content.tres
msgid "Central telefônica, pois não?"
msgstr "Central telefónica, ¿diga?"

#: data/content.tres
msgid "Central, boa noite. Em que posso ajudar?"
msgstr "Central, buenas noches. ¿En qué puedo ayudarle?"

#: data/content.tres
msgid "Central, pois não?"
msgstr "Central, ¿diga?"

#: data/content.tres
msgid "Central."
msgstr "Central."

#: data/content.tres
msgid "Central telefônica, boa noite."
msgstr "Central telefónica, buenas noches."

#: data/content.tres
msgid "Central de São Sotero, pois não?"
msgstr "Central de São Sotero, ¿diga?"

#: data/content.tres
msgid "Desculpe incomodar, a senhora deve estar cheia de ligação."
msgstr "Disculpe la molestia, usted debe estar llena de llamadas."

#: data/content.tres
msgid "Imagina, é pra isso que a central existe."
msgstr "Para nada, para eso está la central."

#: data/content.tres
msgid "Ah, que bom. Eu fico sem jeito, sabe?"
msgstr "Ah, qué bueno. Me da un poco de pena, ¿sabe?"

#: data/content.tres
msgid "Tudo bem."
msgstr "Está bien."

#: data/content.tres
msgid "Ah... tá. Desculpe de novo."
msgstr "Ah... bueno. Perdón otra vez."

#: data/content.tres
msgid "A senhora passa a noite inteira aí sozinha?"
msgstr "¿Usted pasa toda la noche ahí sola?"

#: data/content.tres
msgid "Eu e os cabos."
msgstr "Yo y los cables."

#: data/content.tres
msgid "Hehe, pelo menos eles não reclamam, né?"
msgstr "Je, por lo menos ellos no se quejan, ¿no?"

#: data/content.tres
msgid "Ah... tá. Não vou atrapalhar, então."
msgstr "Ah... bueno. No lo molesto, entonces."

#: data/content.tres
msgid "Minha mulher disse que não era pra incomodar a central a essa hora."
msgstr "Mi mujer me dijo que no molestara a la central a esta hora."

#: data/content.tres
msgid "Não incomoda, não."
msgstr "No molesta para nada."

#: data/content.tres
msgid "Vou contar pra ela que a senhora disse isso."
msgstr "Le voy a contar que usted lo dijo."

#: data/content.tres
msgid "Ela tem razão."
msgstr "Tiene razón."

#: data/content.tres
msgid "Ah... tá certo. Desculpe."
msgstr "Ah... está bien. Disculpe."

#: data/content.tres
msgid "Meu marido já dormiu, mas eu não consigo pegar no sono."
msgstr "Mi marido ya se durmió, pero yo no puedo conciliar el sueño."

#: data/content.tres
msgid "Um chá de camomila ajuda."
msgstr "Un té de manzanilla ayuda."

#: data/content.tres
msgid "Já tomei dois, moça. Nem fez cócegas."
msgstr "Ya me tomé dos, joven. Ni cosquillas."

#: data/content.tres
msgid "Hum."
msgstr "Mm."

#: data/content.tres
msgid "Ah... tá. Eu espero aqui."
msgstr "Ah... bueno. Espero aquí."

#: data/content.tres
msgid "O seu Geraldo, da Rua da Matriz, fez cem anos hoje, sabia?"
msgstr "El señor Geraldo, de la Rua da Matriz, cumplió cien años hoy, ¿sabía?"

#: data/content.tres
msgid "Cem anos! Que bênção."
msgstr "¡Cien años! Qué bendición."

#: data/content.tres
msgid "Teve bolo na praça e banda. Ele dançou com a bisneta!"
msgstr "Hubo torta en la plaza y banda. ¡Bailó con la bisnieta!"

#: data/content.tres
msgid "Que bom pra ele."
msgstr "Qué bueno para él."

#: data/content.tres
msgid "...É. E lúcido, viu? Melhor que eu."
msgstr "...Sí. Y lúcido, ¿eh? Mejor que yo."

#: data/content.tres
msgid "Essa central nunca dorme, né?"
msgstr "Esta central nunca duerme, ¿no?"

#: data/content.tres
msgid "Nunca. Alguém tem que ficar acordado."
msgstr "Nunca. Alguien tiene que quedarse despierto."

#: data/content.tres
msgid "Ainda bem, viu? A gente se sente mais seguro."
msgstr "Menos mal, ¿eh? Uno se siente más seguro."

#: data/content.tres
msgid "Pois é."
msgstr "Pues sí."

#: data/content.tres
msgid "É... bom, eu espero."
msgstr "Sí... bueno, espero."

#: data/content.tres
msgid "Que frio, meu Deus."
msgstr "Qué frío, Dios mío."

#: data/content.tres
msgid "Pega um casaco."
msgstr "Póngase un abrigo."

#: data/content.tres
msgid "Já tô com dois, moça!"
msgstr "¡Ya tengo dos puestos, joven!"

#: data/content.tres
msgid "Aham."
msgstr "Ajá."

#: data/content.tres
msgid "...Bom, deixa pra lá."
msgstr "...Bueno, no importa."

#: data/content.tres
msgid "Amanhã é dia de feira, né?"
msgstr "Mañana es día de feria, ¿no?"

#: data/content.tres
msgid "É sim, amanhã cedo."
msgstr "Sí, mañana temprano."

#: data/content.tres
msgid "Vou ver se ainda tem aquele queijo da serra."
msgstr "Voy a ver si todavía hay ese queso de la sierra."

#: data/content.tres
msgid "Não sei."
msgstr "No sé."

#: data/content.tres
msgid "Ah... tá. Eu vejo amanhã, então."
msgstr "Ah... bueno. Mañana veo, entonces."

#: data/content.tres
msgid "Meu relógio adiantou de novo. A senhora me diz a hora certa?"
msgstr "Mi reloj se adelantó otra vez. ¿Me dice la hora exacta?"

#: data/content.tres
msgid "Digo, sim. O relógio da central é o certo da cidade."
msgstr "Claro. El reloj de la central es el que marca la hora del pueblo."

#: data/content.tres
msgid "Então eu acerto o meu pelo seu. Pronto, agora vai."
msgstr "Entonces pongo el mío en hora con el suyo. Listo, ahora sí."

#: data/content.tres
msgid "Leva no relojoeiro."
msgstr "Llévelo al relojero."

#: data/content.tres
msgid "Tá, tá. Vou levar amanhã."
msgstr "Sí, sí. Lo llevo mañana."

#: data/content.tres
msgid "Desculpa ficar puxando conversa, é que eu não consigo dormir."
msgstr "Perdone que le dé charla, es que no puedo dormir."

#: data/content.tres
msgid "Nem eu, e olha que é meu trabalho."
msgstr "Yo tampoco, y es mi trabajo."

#: data/content.tres
msgid "Hehe, a senhora tem desculpa, eu não."
msgstr "Je, usted tiene excusa, yo no."

#: data/content.tres
msgid "Entendi."
msgstr "Entiendo."

#: data/content.tres
msgid "...Desculpa, tá? Eu espero."
msgstr "...Perdón, ¿sí? Espero."

#: data/content.tres
msgid "Faz tempo que eu não ligo pra central."
msgstr "Hace tiempo que no llamo a la central."

#: data/content.tres
msgid "Eu lembro da sua voz."
msgstr "Me acuerdo de su voz."

#: data/content.tres
msgid "Lembra? Que memória, hein!"
msgstr "¿Se acuerda? ¡Qué memoria!"

#: data/content.tres
msgid "Ah, é?"
msgstr "¿Ah, sí?"

#: data/content.tres
msgid "É... faz tempo mesmo."
msgstr "Sí... hace tiempo, sí."

#: data/content.tres
msgid "O padre mudou o horário da missa de domingo, viu?"
msgstr "El padre cambió el horario de la misa del domingo, ¿sabía?"

#: data/content.tres
msgid "Pra que horas?"
msgstr "¿Para qué hora?"

#: data/content.tres
msgid "Agora é às sete. Cedo demais pra mim."
msgstr "Ahora es a las siete. Demasiado temprano para mí."

#: data/content.tres
msgid "Não vou à missa."
msgstr "No voy a misa."

#: data/content.tres
msgid "Ah... cada um com sua fé, né?"
msgstr "Ah... cada uno con su fe, ¿no?"

#: data/content.tres
msgid "O ônibus da capital atrasou de novo hoje."
msgstr "El autobús de la capital volvió a llegar tarde hoy."

#: data/content.tres
msgid "De novo?"
msgstr "¿Otra vez?"

#: data/content.tres
msgid "Duas horas! Minha irmã chegou morta de cansaço."
msgstr "¡Dos horas! Mi hermana llegó muerta de cansancio."

#: data/content.tres
msgid "É sempre assim."
msgstr "Siempre es así."

#: data/content.tres
msgid "É... pois é."
msgstr "Sí... pues sí."

#: data/content.tres
msgid "Meu neto passou no vestibular, sabia?"
msgstr "Mi nieto entró a la universidad, ¿sabía?"

#: data/content.tres
msgid "Que beleza! Parabéns!"
msgstr "¡Qué maravilla! ¡Felicidades!"

#: data/content.tres
msgid "Ah, que orgulho! Vai ser o primeiro doutor da família."
msgstr "¡Ay, qué orgullo! Va a ser el primer doctor de la familia."

#: data/content.tres
msgid "Hum, que bom."
msgstr "Mm, qué bueno."

#: data/content.tres
msgid "...É. Ele se esforçou, viu?"
msgstr "...Sí. Se esforzó mucho, ¿sabe?"

#: data/content.tres
msgid "O preço do pão subiu de novo."
msgstr "El precio del pan subió otra vez."

#: data/content.tres
msgid "De novo? Não acredito."
msgstr "¿Otra vez? No lo puedo creer."

#: data/content.tres
msgid "Vou ter que voltar a fazer pão em casa."
msgstr "Voy a tener que volver a hacer pan en casa."

#: data/content.tres
msgid "Normal."
msgstr "Es normal."

#: data/content.tres
msgid "Normal pra senhora, né..."
msgstr "Normal para usted, quizás..."

#: data/content.tres
msgid "A vizinha tá dando festa de aniversário, a música vai até tarde."
msgstr "La vecina está festejando un cumpleaños, la música va a seguir hasta tarde."

#: data/content.tres
msgid "Pelo menos é festa, e não briga."
msgstr "Por lo menos es fiesta, y no pelea."

#: data/content.tres
msgid "Isso é! E ela ainda me mandou um prato de salgadinho."
msgstr "¡Eso sí! Y encima me mandó un plato de bocaditos."

#: data/content.tres
msgid "Paciência."
msgstr "Paciencia."

#: data/content.tres
msgid "Paciência eu tenho. Sono é que não."
msgstr "Paciencia tengo. Lo que no tengo es sueño."

#: data/content.tres
msgid "Que chuva, hein? Não parou desde a tarde."
msgstr "Qué lluvia, ¿eh? No paró desde la tarde."

#: data/content.tres
msgid "Daqui eu ouço no telhado."
msgstr "Desde aquí la oigo en el techo."

#: data/content.tres
msgid "Aqui pinga até na cozinha."
msgstr "Aquí gotea hasta en la cocina."

#: data/content.tres
msgid "É chuva."
msgstr "Es lluvia."

#: data/content.tres
msgid "...É, né."
msgstr "...Sí, ¿no?"

#: data/content.tres
msgid "Ouvi dizer que o rio vai encher de novo."
msgstr "Oí decir que el río va a crecer otra vez."

#: data/content.tres
msgid "Tomara que não."
msgstr "Ojalá que no."

#: data/content.tres
msgid "Da última vez a água chegou na praça."
msgstr "La última vez el agua llegó a la plaza."

#: data/content.tres
msgid "Boato."
msgstr "Es un rumor."

#: data/content.tres
msgid "Tomara que seja, moça."
msgstr "Ojalá tenga razón, joven."

#: data/content.tres
msgid "O rio subiu bastante com essa chuva."
msgstr "El río subió bastante con esta lluvia."

#: data/content.tres
msgid "Cuidado por aí."
msgstr "Cuidado por allá."

#: data/content.tres
msgid "Pode deixar, moça. Aqui é alto."
msgstr "Quédese tranquila, joven. Aquí es alto."

#: data/content.tres
msgid "...Bom, aqui é alto, pelo menos."
msgstr "...Bueno, aquí es alto, por lo menos."

#: data/content.tres
msgid "Tá caindo um toró aqui, a rua virou rio."
msgstr "Está cayendo un aguacero, la calle se volvió un río."

#: data/content.tres
msgid "Não sai de casa, hein."
msgstr "No salga de casa, ¿eh?"

#: data/content.tres
msgid "Nem pensar, moça. Daqui não saio."
msgstr "Ni loco, joven. De aquí no salgo."

#: data/content.tres
msgid "Aqui também."
msgstr "Aquí también."

#: data/content.tres
msgid "Ah... tá."
msgstr "Ah... bueno."

#: data/content.tres
msgid "Com essa chuva ninguém sai de casa, né?"
msgstr "Con esta lluvia nadie sale de casa, ¿no?"

#: data/content.tres
msgid "Só quem precisa."
msgstr "Solo quien lo necesita."

#: data/content.tres
msgid "É, coitado de quem tá na estrada."
msgstr "Sí, pobre el que anda en la carretera."

#: data/content.tres
msgid "Melhor assim."
msgstr "Mejor así."

#: data/content.tres
msgid "É, noite de ficar debaixo das cobertas."
msgstr "Sí, noche para quedarse bajo las cobijas."

#: data/content.tres
msgid "Que neblina, hein? Não dá pra ver o outro lado da rua."
msgstr "Qué neblina, ¿eh? No se ve el otro lado de la calle."

#: data/content.tres
msgid "Daqui também não vejo nada."
msgstr "Desde aquí tampoco veo nada."

#: data/content.tres
msgid "Parece algodão na janela."
msgstr "Parece algodón en la ventana."

#: data/content.tres
msgid "Fique em casa hoje."
msgstr "Quédese en casa hoy."

#: data/content.tres
msgid "Pode deixar, não ponho o pé lá fora."
msgstr "Pierda cuidado, no pongo un pie afuera."

#: data/content.tres
msgid "Com essa cerração, é melhor ninguém pegar a estrada."
msgstr "Con esta neblina, mejor que nadie salga a la ruta."

#: data/content.tres
msgid "Verdade, é perigoso."
msgstr "Es verdad, es peligroso."

#: data/content.tres
msgid "Meu cunhado quase errou a entrada da cidade uma vez."
msgstr "Mi cuñado casi se pasa la entrada del pueblo una vez."

#: data/content.tres
msgid "Tomara que ninguém precise."
msgstr "Ojalá nadie lo necesite."

#: data/content.tres
msgid "Deus queira."
msgstr "Dios quiera."

#: data/content.tres
msgid "Parece que a cidade sumiu na névoa hoje."
msgstr "Parece que el pueblo desapareció en la niebla hoy."

#: data/content.tres
msgid "Amanhã ela volta."
msgstr "Mañana vuelve."

#: data/content.tres
msgid "Hehe, tomara. Com a padaria e tudo."
msgstr "Je, ojalá. Con la panadería y todo."

#: data/content.tres
msgid "Exagero."
msgstr "Exagera."

#: data/content.tres
msgid "Hehe... é, talvez."
msgstr "Je... puede ser."

#: data/content.tres
msgid "Que noite bonita, hein? Dá pra ver todas as estrelas."
msgstr "Qué noche linda, ¿eh? Se ven todas las estrellas."

#: data/content.tres
msgid "Tá bonita mesmo."
msgstr "Está linda, sí."

#: data/content.tres
msgid "Fiquei um tempão na varanda olhando."
msgstr "Me quedé un buen rato en el balcón mirando."

#: data/content.tres
msgid "Daqui eu só vejo a mesa."
msgstr "Desde aquí solo veo la mesa."

#: data/content.tres
msgid "Ah, coitado. Depois dá uma espiada na janela."
msgstr "Ay, pobre. Después eche un vistazo por la ventana."

#: data/content.tres
msgid "Tá uma lua bonita hoje."
msgstr "Hay una luna linda hoy."

#: data/content.tres
msgid "Lua cheia?"
msgstr "¿Luna llena?"

#: data/content.tres
msgid "Quase. Amanhã fica redondinha."
msgstr "Casi. Mañana queda redondita."

#: data/content.tres
msgid "Não reparei."
msgstr "No me fijé."

#: data/content.tres
msgid "Ah... depois dá uma olhada."
msgstr "Ah... después mire."

#: data/content.tres
msgid "Noite fresquinha, né? Até dá gosto de ficar na janela."
msgstr "Noche fresquita, ¿no? Da gusto quedarse en la ventana."

#: data/content.tres
msgid "Depois do calor de ontem..."
msgstr "Después del calor de ayer..."

#: data/content.tres
msgid "Nem me fale, ontem não dava nem pra dormir."
msgstr "Ni me lo diga, ayer no se podía ni dormir."

#: data/content.tres
msgid "Aproveite."
msgstr "Aprovéchela."

#: data/content.tres
msgid "Tô aproveitando, com um cafezinho."
msgstr "La estoy aprovechando, con un cafecito."

#: data/content.tres
msgid "A novela das oito tá boa demais. A senhora tem acompanhado?"
msgstr "La novela de las ocho está buenísima. ¿Usted la sigue?"

#: data/content.tres
msgid "Não perco um capítulo."
msgstr "No me pierdo un capítulo."

#: data/content.tres
msgid "Pois é! Aposto que amanhã descobrem quem é o pai da menina."
msgstr "¡Así es! Apuesto a que mañana descubren quién es el padre de la chica."

#: data/content.tres
msgid "Não tenho tempo pra novela."
msgstr "No tengo tiempo para novelas."

#: data/content.tres
msgid "Ah, é verdade, a senhora trabalha de noite..."
msgstr "Ah, es verdad, usted trabaja de noche..."

#: data/content.tres
msgid "O time da cidade ganhou domingo, viu? Três a um."
msgstr "El equipo del pueblo ganó el domingo, ¿vio? Tres a uno."

#: data/content.tres
msgid "Vi no jornal! Que jogão."
msgstr "¡Lo vi en el diario! Qué partidazo."

#: data/content.tres
msgid "O goleiro pegou um pênalti no fim. O povo invadiu o campo de alegria."
msgstr "El arquero atajó un penal al final. La gente invadió la cancha de alegría."

#: data/content.tres
msgid "Não acompanho futebol."
msgstr "No sigo el fútbol."

#: data/content.tres
msgid "Ah, então a senhora é das poucas aqui."
msgstr "Ah, entonces usted es de las pocas aquí."

#: data/content.tres
msgid "Minha filha vai casar mês que vem."
msgstr "Mi hija se casa el mes que viene."

#: data/content.tres
msgid "Que notícia boa! Parabéns."
msgstr "¡Qué buena noticia! Felicitaciones."

#: data/content.tres
msgid "Obrigada! O vestido tá sendo feito aqui em casa mesmo."
msgstr "¡Gracias! El vestido lo están haciendo aquí mismo en casa."

#: data/content.tres
msgid "Parabéns."
msgstr "Felicitaciones."

#: data/content.tres
msgid "Obrigada... É, tem muita coisa pra arrumar ainda."
msgstr "Gracias... Sí, todavía hay mucho que organizar."

#: data/content.tres
msgid "O circo chegou na cidade. A senhora viu o cartaz?"
msgstr "Llegó el circo al pueblo. ¿Vio el cartel?"

#: data/content.tres
msgid "Vi! Tem até elefante, é verdade?"
msgstr "¡Sí! ¿Es verdad que hasta tiene elefante?"

#: data/content.tres
msgid "Tem um só, velhinho, coitado. Mas as crianças tão encantadas."
msgstr "Uno solo, viejito, pobre. Pero los chicos están encantados."

#: data/content.tres
msgid "Não vi, não."
msgstr "No, no lo vi."

#: data/content.tres
msgid "É lá no campo perto da estação. Tá uma festa."
msgstr "Está en el campo cerca de la estación. Es una fiesta."

#: data/content.tres
msgid "Meu marido tá de plantão no hospital, por isso eu fico acordada até tarde."
msgstr "Mi marido está de guardia en el hospital, por eso me quedo despierta hasta tarde."

#: data/content.tres
msgid "Deve ser puxado pra vocês dois."
msgstr "Debe ser duro para los dos."

#: data/content.tres
msgid "É, mas a gente se acostuma. Ele chega de manhã com o pão."
msgstr "Sí, pero uno se acostumbra. Llega a la mañana con el pan."

#: data/content.tres
msgid "Entendo."
msgstr "Entiendo."

#: data/content.tres
msgid "Pois é... a casa fica quieta demais."
msgstr "Así es... la casa queda demasiado callada."

#: data/content.tres
msgid "Tô com um bolo de fubá no forno enquanto espero."
msgstr "Tengo una torta de maíz en el horno mientras espero."

#: data/content.tres
msgid "Que delícia. Deu até fome aqui."
msgstr "Qué rico. Hasta me dio hambre."

#: data/content.tres
msgid "Se desse, eu mandava um pedaço pela linha!"
msgstr "¡Si se pudiera, le mandaba un pedazo por la línea!"

#: data/content.tres
msgid "Tá quase pronto... o cheiro já tomou a casa toda."
msgstr "Ya casi está... el olor llenó toda la casa."

#: data/content.tres
msgid "Chegou carta do meu irmão hoje, depois de dois anos. Tô tão contente que precisava contar pra alguém."
msgstr "Hoy llegó carta de mi hermano, después de dos años. Estoy tan contenta que necesitaba contárselo a alguien."

#: data/content.tres
msgid "Que bom! E ele está bem?"
msgstr "¡Qué bueno! ¿Y él está bien?"

#: data/content.tres
msgid "Tá ótimo! E diz que vem pro Natal."
msgstr "¡Está muy bien! Y dice que viene para Navidad."

#: data/content.tres
msgid "Que bom."
msgstr "Qué bueno."

#: data/content.tres
msgid "É... ele escreve pouco, mas escreve."
msgstr "Sí... escribe poco, pero escribe."

#: data/content.tres
msgid "Acabei de chegar da novena. A igreja tava cheia."
msgstr "Acabo de volver de la novena. La iglesia estaba llena."

#: data/content.tres
msgid "Que bom. Essa cidade tem muita fé."
msgstr "Qué bueno. Este pueblo tiene mucha fe."

#: data/content.tres
msgid "Tem! O padre Anselmo até pediu mais bancos pra prefeitura."
msgstr "¡Mucha! El padre Anselmo hasta le pidió más bancos a la municipalidad."

#: data/content.tres
msgid "Tava bonita, mas comprida que só."
msgstr "Estuvo linda, pero larguísima."

#: data/content.tres
msgid "Amanhã cedo eu levo minha mãe no médico, na capital. Nem sei se vou conseguir dormir."
msgstr "Mañana temprano llevo a mi mamá al médico, en la capital. No sé si voy a poder dormir."

#: data/content.tres
msgid "Vai dar tudo certo."
msgstr "Todo va a salir bien."

#: data/content.tres
msgid "Deus queira. É só exame, mas ela tá nervosa, e eu mais ainda."
msgstr "Ojalá. Son solo estudios, pero ella está nerviosa, y yo más todavía."

#: data/content.tres
msgid "Boa viagem."
msgstr "Buen viaje."

#: data/content.tres
msgid "Obrigada. A estrada é longa, mas a gente vai."
msgstr "Gracias. El camino es largo, pero vamos."

#: data/content.tres
msgid "A prefeitura prometeu calçar a minha rua de novo."
msgstr "La municipalidad prometió empedrar mi calle otra vez."

#: data/content.tres
msgid "Quem sabe dessa vez sai."
msgstr "A lo mejor esta vez sale."

#: data/content.tres
msgid "Deus te ouça! Toda eleição é a mesma promessa."
msgstr "¡Dios lo oiga! Cada elección es la misma promesa."

#: data/content.tres
msgid "Promessa é promessa."
msgstr "Promesa es promesa."

#: data/content.tres
msgid "Pois é, e buraco é buraco."
msgstr "Así es, y un pozo es un pozo."

#: data/content.tres
msgid "Tô fazendo crochê enquanto espero. Aprendi com a minha vizinha."
msgstr "Estoy tejiendo crochet mientras espero. Me enseñó mi vecina."

#: data/content.tres
msgid "Que bonito! Já fez alguma peça?"
msgstr "¡Qué lindo! ¿Ya hizo alguna pieza?"

#: data/content.tres
msgid "Um paninho de bandeja. Torto, mas é meu."
msgstr "Un paño de bandeja. Torcido, pero es mío."

#: data/content.tres
msgid "É um passatempo. A noite fica mais curta."
msgstr "Es un pasatiempo. La noche se hace más corta."

#: data/content.tres
msgid "A senhora sabe se a farmácia de plantão hoje é a Santa Rita?"
msgstr "¿Usted sabe si la farmacia de turno hoy es la Santa Rita?"

#: data/content.tres
msgid "É a Santa Rita, sim, na Rua do Mercado."
msgstr "Sí, es la Santa Rita, en la Rua do Mercado."

#: data/content.tres
msgid "Ah, bom saber. Vai que alguém precisa de noite."
msgstr "Ah, bueno saberlo. Por si alguien necesita de noche."

#: data/content.tres
msgid "Não sei dizer."
msgstr "No sabría decirle."

#: data/content.tres
msgid "Tudo bem, amanhã eu pergunto lá."
msgstr "Está bien, mañana pregunto allá."

#: data/content.tres
msgid "O Cine Odeon vai passar filme novo no sábado."
msgstr "El Cine Odeon va a pasar una película nueva el sábado."

#: data/content.tres
msgid "Qual filme?"
msgstr "¿Qué película?"

#: data/content.tres
msgid "Um de faroeste, com tiroteio e tudo. Já separei o dinheiro."
msgstr "Una del oeste, con tiroteo y todo. Ya separé la plata."

#: data/content.tres
msgid "Não vou muito ao cinema."
msgstr "No voy mucho al cine."

#: data/content.tres
msgid "Pois devia! Trocaram as cadeiras, tá uma beleza."
msgstr "¡Debería! Cambiaron las butacas, quedó precioso."

#: data/content.tres
msgid "Vai indo, moça."
msgstr "Ahí va, joven."

#: data/content.tres
msgid "Ah, vai bem, graças a Deus."
msgstr "Ah, va bien, gracias a Dios."

#: data/content.tres
msgid "Tranquila, tranquila."
msgstr "Tranquila, tranquila."

#: data/content.tres
msgid "Ih, devagar..."
msgstr "Uy, despacio..."

#: data/content.tres
msgid "Vai indo, do jeito que dá."
msgstr "Ahí va, como se puede."

#: data/content.tres
msgid "Ah, aqui tá tudo calmo."
msgstr "Ah, aquí está todo tranquilo."

#: data/content.tres
msgid "Ainda está aí?"
msgstr "¿Todavía está ahí?"

#: data/content.tres
msgid "Alô? Conseguiu?"
msgstr "¿Hola? ¿Pudo?"

#: data/content.tres
msgid "Moça? A ligação caiu?"
msgstr "¿Joven? ¿Se cortó la llamada?"

#: data/content.tres
msgid "Alô? Tô esperando..."
msgstr "¿Hola? Estoy esperando..."

#: data/content.tres
msgid "Demora muito?"
msgstr "¿Tarda mucho?"

#: data/content.tres
msgid "Central? Tá me ouvindo?"
msgstr "¿Central? ¿Me escucha?"

#: data/content.tres
msgid "Ainda tô aqui, viu?"
msgstr "Sigo aquí, ¿eh?"

#: data/content.tres
msgid "Alô? Caiu?"
msgstr "¿Hola? ¿Se cortó?"

#: data/content.tres
msgid "Alô?! Vocês vão mandar alguém?"
msgstr "¿¡Hola!? ¿Van a mandar a alguien?"

#: data/content.tres
msgid "Por favor, rápido!"
msgstr "¡Por favor, rápido!"

#: data/content.tres
msgid "Central?!"
msgstr "¿¡Central!?"

#: data/content.tres
msgid "Alô! Tá demorando!"
msgstr "¡Hola! ¡Está tardando!"

#: data/content.tres
msgid "Central, ainda tá aí?"
msgstr "Central, ¿todavía está ahí?"

#: data/content.tres
msgid "Manda alguém, pelo amor de Deus!"
msgstr "¡Mande a alguien, por el amor de Dios!"

#: data/content.tres
msgid "Tá bom, eu espero."
msgstr "Está bien, espero."

#: data/content.tres
msgid "Obrigado, aguardo."
msgstr "Gracias, aguardo."

#: data/content.tres
msgid "Certo."
msgstr "De acuerdo."

#: data/content.tres
msgid "Pode ser, eu fico na linha."
msgstr "Está bien, me quedo en la línea."

#: data/content.tres
msgid "Tá, mas rapidinho, tá?"
msgstr "Está bien, pero rapidito, ¿sí?"

#: data/content.tres
msgid "Tá, fico esperando."
msgstr "Bueno, me quedo esperando."

#: data/content.tres
msgid "Sem pressa, moça."
msgstr "Sin apuro, joven."

#: data/content.tres
msgid "Tá bem, obrigada."
msgstr "Está bien, gracias."

#: data/content.tres
msgid "Vou aguardar."
msgstr "Voy a esperar."

#: data/content.tres
msgid "Tá, eu espero."
msgstr "Está bien, espero."

#: data/content.tres
msgid "Pode deixar, eu aguardo na linha."
msgstr "No se preocupe, espero en la línea."

#: data/content.tres
msgid "Espero, mas não demora, tá?"
msgstr "Espero, pero no tarde, ¿eh?"

#: data/content.tres
msgid "Ligarei outra hora."
msgstr "Llamaré en otro momento."

#: data/content.tres
msgid "Então eu ligo mais tarde."
msgstr "Entonces llamo más tarde."

#: data/content.tres
msgid "Deixa, ligo outra hora. Obrigado."
msgstr "Déjelo, llamo en otro momento. Gracias."

#: data/content.tres
msgid "Pode ser. Obrigado."
msgstr "Puede ser. Gracias."

#: data/content.tres
msgid "Serve, sim. Pode ligar."
msgstr "Sirve, sí. Puede llamar."

#: data/content.tres
msgid "Tanto faz, contanto que atendam."
msgstr "Da igual, con tal de que atiendan."

#: data/content.tres
msgid "Ah, pode ser essa mesmo."
msgstr "Ah, puede ser esa misma."

#: data/content.tres
msgid "Não, moço, não é aí."
msgstr "No, joven, no es ahí."

#: data/content.tres
msgid "Hã? Não é com essa pessoa que eu quero falar."
msgstr "¿Eh? No es con esta persona que quiero hablar."

#: data/content.tres
msgid "Esse não é quem eu pedi!"
msgstr "¡Este no es a quien pedí!"

#: data/content.tres
msgid "Opa, acho que o senhor ligou errado."
msgstr "Epa, creo que me comunicó mal."

#: data/content.tres
msgid "Ih, quem atendeu não foi quem eu pedi."
msgstr "Uy, quien contestó no es a quien pedí."

#: data/content.tres
msgid "Moço, essa voz eu não conheço."
msgstr "Joven, esa voz no la conozco."

#: data/content.tres
msgid "Não é esse número, não."
msgstr "No es ese número, no."

#: data/content.tres
msgid "Está certo. Até mais."
msgstr "Está bien. Hasta luego."

#: data/content.tres
msgid "Boa noite, e bom trabalho aí na central."
msgstr "Buenas noches, y buen trabajo ahí en la central."

#: data/content.tres
msgid "Interurbano, boa noite."
msgstr "Larga distancia, buenas noches."

#: data/content.tres
msgid "Telefonista, pois não?"
msgstr "Operadora, ¿dígame?"

#: data/content.tres
msgid "Interurbano. Qual o número?"
msgstr "Larga distancia. ¿Qué número?"

#: data/content.tres
msgid "Um momento, vou chamar."
msgstr "Un momento, voy a llamar."

#: data/content.tres
msgid "Aguarde, estou completando."
msgstr "Espere, estoy completando."

#: data/content.tres
msgid "Só um instante, já chamo."
msgstr "Un instante, ya llamo."

#: data/content.tres
msgid "Esse número não é daqui, não."
msgstr "Ese número no es de aquí."

#: data/content.tres
msgid "Não tenho esse número aqui. Confere a cidade?"
msgstr "No tengo ese número aquí. ¿Revisa la ciudad?"

#: data/content.tres
msgid "Aqui não existe esse número, colega."
msgstr "Aquí no existe ese número, colega."

#: data/content.tres
msgid "Liguei agora há pouco e as linhas estavam ocupadas. Já liberou?"
msgstr "Llamé hace un rato y las líneas estaban ocupadas. ¿Ya se liberó alguna?"

#: data/content.tres
msgid "Sou eu de novo, Central. Já tem linha?"
msgstr "Soy yo otra vez, Central. ¿Ya hay línea?"

#: data/content.tres
msgid "Liguei agora há pouco e ninguém atendeu!"
msgstr "¡Llamé hace un rato y nadie contestó!"

#: data/content.tres
msgid "Central? Até que enfim! Já liguei antes."
msgstr "¿Central? ¡Por fin! Ya llamé antes."

#: data/content.tres
msgid "Tô tentando faz tempo. Ninguém atende essa central?"
msgstr "Hace rato que estoy intentando. ¿Nadie atiende esta central?"

#: data/content.tres
msgid "O número que a senhora me deu não era o certo."
msgstr "El número que me dio no era el correcto."

#: data/content.tres
msgid "Liguei pro número que a senhora passou e era de outra pessoa!"
msgstr "¡Llamé al número que me pasó y era de otra persona!"

#: data/content.tres
msgid "Central, a informação que a senhora me deu tava errada."
msgstr "Central, la información que me dio estaba equivocada."

#: data/content.tres
msgid "Central, vocês me ligaram pro número errado! Agora me passa pro certo, por favor."
msgstr "¡Central, me comunicaron con el número equivocado! Ahora páseme con el correcto, por favor."

#: data/content.tres
msgid "Liguei antes e fui parar no lugar errado! Vamos tentar de novo."
msgstr "¡Llamé antes y fui a parar al lugar equivocado! Probemos otra vez."

#: data/content.tres
msgid "Me conectaram com uma pessoa nada a ver! Quero o número certo desta vez."
msgstr "¡Me comunicaron con una persona que no tenía nada que ver! Quiero el número correcto esta vez."

#: data/content.tres
msgid "Central! Ninguém apareceu aqui e tá ficando pior!"
msgstr "¡Central! ¡No vino nadie y está empeorando!"

#: data/content.tres
msgid "Liguei mais cedo e ninguém veio! Tá piorando!"
msgstr "¡Llamé más temprano y no vino nadie! ¡Está empeorando!"

#: data/content.tres
msgid "Pelo amor de Deus, cadê o socorro? Piorou!"
msgstr "Por el amor de Dios, ¿dónde está la ayuda? ¡Empeoró!"

#: data/content.tres
msgid "Liguei mais cedo. Ninguém veio. Agora não adianta mais."
msgstr "Llamé más temprano. No vino nadie. Ahora ya no sirve."

#: data/content.tres
msgid "Não precisa mandar mais ninguém. Já era."
msgstr "No hace falta mandar a nadie. Ya fue."

#: data/content.tres
msgid "Vocês demoraram demais. Eu só queria que soubessem."
msgstr "Tardaron demasiado. Solo quería que lo supieran."

#: data/content.tres
msgid "Alô? Quem é, a essa hora?"
msgstr "¿Hola? ¿Quién es, a esta hora?"

#: data/content.tres
msgid "Hã? Isso é hora de ligar pros outros?"
msgstr "¿Eh? ¿Le parece hora de llamar a la gente?"

#: data/content.tres
msgid "Quem tá ligando? Aqui tá todo mundo dormindo!"
msgstr "¿Quién llama? ¡Aquí están todos durmiendo!"

#: data/content.tres
msgid "Alô?! Isso é hora?"
msgstr "¿¡Hola!? ¿Le parece hora?"

#: data/content.tres
msgid "Quer saber? Esquece. Eu ligo amanhã."
msgstr "¿Sabe qué? Olvídelo. Llamo mañana."

#: data/content.tres
msgid "Errou de novo? Deixa pra lá."
msgstr "¿Se equivocó otra vez? Déjelo así."

#: data/content.tres
msgid "Não, chega. Boa noite."
msgstr "No, basta. Buenas noches."

#: data/content.tres
msgid "Alô, quem fala?"
msgstr "¿Aló, quién habla?"

#: data/content.tres
msgid "Pronto, pode falar."
msgstr "Sí, diga."

#: data/content.tres
msgid "Alô, boa noite."
msgstr "Aló, buenas noches."

#: data/content.tres
msgid "Oi, sou eu."
msgstr "Hola, soy yo."

#: data/content.tres
msgid "Boa noite, sou eu. Tá me ouvindo bem?"
msgstr "Buenas noches, soy yo. ¿Me oyes bien?"

#: data/content.tres
msgid "Oi! Que bom que atendeu."
msgstr "¡Hola! Qué bueno que contestaste."

#: data/content.tres
msgid "Boa noite. Desculpa ligar a essa hora."
msgstr "Buenas noches. Perdona que llame a esta hora."

#: data/content.tres
msgid "sete"
msgstr "siete"

#: data/content.tres
msgid "oito"
msgstr "ocho"

#: data/content.tres
msgid "nove"
msgstr "nueve"

#: data/content.tres
msgid "dez"
msgstr "diez"

#: data/content.tres
msgid "onze"
msgstr "once"

#: data/content.tres
msgid "quatro"
msgstr "cuatro"

#: data/content.tres
msgid "cinco"
msgstr "cinco"

#: data/content.tres
msgid "seis"
msgstr "seis"

#: data/content.tres
msgid "meia hora"
msgstr "media hora"

#: data/content.tres
msgid "vinte minutos"
msgstr "veinte minutos"

#: data/content.tres
msgid "quarenta minutos"
msgstr "cuarenta minutos"

#: data/content.tres
msgid "uma hora"
msgstr "una hora"

#: data/content.tres
msgid "duas noites"
msgstr "dos noches"

#: data/content.tres
msgid "três noites"
msgstr "tres noches"

#: data/content.tres
msgid "quatro noites"
msgstr "cuatro noches"

#: data/content.tres
msgid "verde"
msgstr "verde"

#: data/content.tres
msgid "azul"
msgstr "azul"

#: data/content.tres
msgid "cinza"
msgstr "gris"

#: data/content.tres
msgid "marrom"
msgstr "marrón"

#: data/content.tres
msgid "um a um"
msgstr "uno a uno"

#: data/content.tres
msgid "dois a um"
msgstr "dos a uno"

#: data/content.tres
msgid "zero a zero"
msgstr "cero a cero"

#: data/content.tres
msgid "dois a dois"
msgstr "dos a dos"

#: data/content.tres
msgid "um faroeste"
msgstr "una del oeste"

#: data/content.tres
msgid "uma comédia"
msgstr "una comedia"

#: data/content.tres
msgid "um filme de guerra"
msgstr "una de guerra"

#: data/content.tres
msgid "um romance"
msgstr "una romántica"

#: data/content.tres
msgid "Então tá combinado. Boa noite."
msgstr "Entonces quedamos así. Buenas noches."

#: data/content.tres
msgid "Tá bom, então. Até amanhã."
msgstr "Bueno, entonces. Hasta mañana."

#: data/content.tres
msgid "Combinado. Boa noite, viu?"
msgstr "Trato hecho. Buenas noches, ¿eh?"

#: data/content.tres
msgid "Então é isso. Boa noite."
msgstr "Entonces eso es todo. Buenas noches."

#: data/content.tres
msgid "Até mais."
msgstr "Hasta luego."

#: data/content.tres
msgid "Boa noite. Vai com Deus."
msgstr "Buenas noches. Vaya con Dios."

#: data/content.tres
msgid "Peraí... Tem mais alguém aí com você?"
msgstr "Espera... ¿Hay alguien más ahí contigo?"

#: data/content.tres
msgid "Ouviu esse estalo? Parece que alguém pegou a extensão."
msgstr "¿Oíste ese clic? Parece que alguien levantó otro aparato."

#: data/content.tres
msgid "Psiu. Acho que ouvi alguém respirando."
msgstr "Shh. Creo que oí a alguien respirar."

#: data/content.tres
msgid "Sua voz ficou fraquinha de repente..."
msgstr "Tu voz se puso muy bajita de repente..."

#: data/content.tres
msgid "Alô? Tem mais alguém nessa linha?"
msgstr "¿Aló? ¿Hay alguien más en esta línea?"

#: data/content.tres
msgid "Fala baixo. Acho que não tamo sozinhos na linha."
msgstr "Habla bajo. Creo que no estamos solos en la línea."

#: data/content.tres
msgid "Não tem ninguém aqui, não. Então é alguém na linha."
msgstr "No, aquí no hay nadie. Entonces es alguien en la línea."

#: data/content.tres
msgid "Ouvi. Aqui não tem extensão... tem gente na linha."
msgstr "Sí. Aquí no hay otro aparato... hay alguien en la línea."

#: data/content.tres
msgid "Achei que era você... Tem alguém escutando a gente."
msgstr "Pensé que eras tú... Alguien nos está escuchando."

#: data/content.tres
msgid "A sua também. Alguém pegou essa linha."
msgstr "La tuya también. Alguien tomó esta línea."

#: data/content.tres
msgid "Ninguém respondeu... mas que tem, tem."
msgstr "Nadie contestó... pero haberlo, lo hay."

#: data/content.tres
msgid "Também acho. Melhor a gente não falar nada demais."
msgstr "Yo tampoco. Mejor no decir nada de más."

#: data/content.tres
msgid "Tem gente ouvindo, sim! Amanhã eu reclamo na companhia."
msgstr "¡Sí, alguien está escuchando! Mañana me quejo con la compañía."

#: data/content.tres
msgid "Isso é um abuso! Vou denunciar essa telefonista."
msgstr "¡Esto es un abuso! Voy a denunciar a esa telefonista."

#: data/content.tres
msgid "Desliga, desliga. Amanhã eu vou lá na companhia reclamar."
msgstr "Cuelga, cuelga. Mañana voy a la compañía a quejarme."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega a tempo."
msgstr "{occurrence} en {address}: la ayuda llega a tiempo."

#: data/content.tres
msgid "{occurrence} na {address}: equipe controla a situação."
msgstr "{occurrence} en {address}: el equipo controla la situación."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega com atraso."
msgstr "{occurrence} en {address}: la ayuda llega con retraso."

#: data/content.tres
msgid "{occurrence} na {address}: moradores reclamam da demora."
msgstr "{occurrence} en {address}: los vecinos se quejan de la demora."

#: data/content.tres
msgid "{occurrence} na {address}: ninguém foi atender."
msgstr "{occurrence} en {address}: nadie fue a atender."

#: data/content.tres
msgid "{occurrence} na {address}: vizinhos esperaram a noite toda por socorro."
msgstr "{occurrence} en {address}: los vecinos esperaron ayuda toda la noche."

#: data/content.tres
msgid "Turno exemplar. Continue assim."
msgstr "Turno ejemplar. Siga así."

#: data/content.tres
msgid "Bom turno. Atenção aos detalhes."
msgstr "Buen turno. Atención a los detalles."

#: data/content.tres
msgid "Turno regular. Os moradores contam com a central."
msgstr "Turno regular. Los vecinos cuentan con la central."

#: data/content.tres
msgid "Insuficiente. Mais uma noite assim e a companhia vai dispensar seus serviços."
msgstr "Insuficiente. Una noche más así y la compañía prescindirá de sus servicios."

#: data/content.tres
msgid "Insuficiente pela segunda noite seguida. A companhia dispensa seus serviços."
msgstr "Insuficiente por segunda noche seguida. La compañía prescinde de sus servicios."

#: data/content.tres
msgid "P.S.: Ontem seu conceito foi insuficiente. Esta noite decide se você continua na companhia."
msgstr "P.D.: Ayer su calificación fue insuficiente. Esta noche decide si usted sigue en la compañía."

#: data/content.tres
msgid "Boa noite. Pode me dar o número %s?"
msgstr "Buenas noches. ¿Me puede dar el número %s?"

#: data/content.tres
msgid "Central, a senhora sabe o número %s?"
msgstr "Central, ¿usted sabe el número %s?"

#: data/content.tres
msgid "Queria só o número %s, pra anotar aqui."
msgstr "Solo quería el número %s, para anotarlo."

#: data/content.tres
msgid "Perdi a caderneta. Qual é o número %s?"
msgstr "Perdí la libreta. ¿Cuál es el número %s?"

#: data/content.tres
msgid "Central, me passa o número %s, por favor?"
msgstr "Central, ¿me pasa el número %s, por favor?"

#: data/content.tres
msgid "Boa noite. Qual é o telefone %s?"
msgstr "Buenas noches. ¿Cuál es el teléfono %s?"

#: data/content.tres
msgid "A senhora tem aí o número %s?"
msgstr "¿Usted tiene ahí el número %s?"

#: data/content.tres
msgid "Anotado. Obrigada, boa noite."
msgstr "Anotado. Gracias, buenas noches."

#: data/content.tres
msgid "Ah, tá certo. Obrigado."
msgstr "Ah, está bien. Gracias."

#: data/content.tres
msgid "Muito obrigada. Boa noite."
msgstr "Muchas gracias. Buenas noches."

#: data/content.tres
msgid "Brigado, moça."
msgstr "Gracias, joven."

#: data/content.tres
msgid "Tá anotado. Boa noite."
msgstr "Ya está anotado. Buenas noches."

#: data/content.tres
msgid "Hum. Tem certeza? Bom... obrigado."
msgstr "Mmm. ¿Está seguro? Bueno... gracias."

#: data/content.tres
msgid "Isso tudo? Tá bom, obrigado."
msgstr "¿Eso es todo? Está bien, gracias."

#: data/content.tres
msgid "Vou tentar esse então."
msgstr "Voy a probar ese, entonces."

#: data/content.tres
msgid "Será? Bom, vou tentar."
msgstr "¿Será? Bueno, voy a probar."

#: data/content.tres
msgid "Hum... tá bom, então."
msgstr "Mmm... está bien, entonces."

