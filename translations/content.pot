msgstr ""

#: data/nights/night_01.tres
msgid "Que luz?"
msgstr ""

#: data/nights/night_01.tres
msgid "A luz da sua mesa."
msgstr ""

#: data/nights/night_01.tres
msgid "Ela sempre fica acesa?"
msgstr ""

#: data/nights/night_02.tres
msgid "O supervisor deixou um recado: \"Ontem a linha ficou com chiado depois das dez. A companhia vai olhar. Se acontecer de novo, anote na ficha.\""
msgstr ""

#: data/calls/story_02_seu_ernesto_radio_serena_am.tres data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
