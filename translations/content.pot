msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

#: data/directory/214_dr_augusto_almeida.tres
msgid "Doutor Augusto. É emergência?"
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Não, doutor. É só a central testando a linha."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Então desliga, minha filha, que eu estou no meio da ronda."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "O senhor está de plantão hoje?"
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Hoje, amanhã e depois. O outro médico foi embora da cidade."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Alô, Augusto. Se for da enfermaria, já estou descendo."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Não é da enfermaria, é da central."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Ah. Pensei que fosse a irmã Luzia. Boa noite."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Desculpe incomodar, doutor."
msgstr ""

#: data/directory/214_dr_augusto_almeida.tres
msgid "Incômodo é parte do ofício. Boa noite."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Alô? Otávio falando."
msgstr ""

#: data/directory/361_otavio_almeida.tres data/directory/223_marta_costa.tres data/directory/291_joaquim_ferreira.tres
msgid "É da central. Estamos testando a linha."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Ah, tá. Pensei que fosse alguém da rádio."
msgstr ""

#: data/directory/361_otavio_almeida.tres data/directory/288_armazem_ferreira.tres data/directory/209_sitio_boa_esperanca.tres
msgid "Desculpe, foi engano."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Tudo bem. Se for a moça de fita amarela, eu tô aqui, viu?"
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Alô? É a moça da fita amarela?"
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Aqui é da central, seu Otávio."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Ah, é você! Pode me chamar de Otávio, que eu nem tenho trinta."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "O Trovão fugiu de novo?"
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Hoje não! Tá aqui dormindo no meu pé."
msgstr ""

#: data/directory/361_otavio_almeida.tres
msgid "Boa noite. Amanhã eu pego cedo na estação."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Joaquim Ferreira"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "o Armazém Ferreira"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Quero comprar fósforo e querosene ainda hoje."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. Ainda dá pra comprar fósforo e querosene hoje?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "A porta já fechou, mas eu atendo pela janela do lado."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Ótimo. Quero um litro de querosene e duas caixas de fósforo."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Traz a garrafa, que o querosene eu vendo a granel."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Chego em {wait}. Pode ser?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Pode. Só não passa das {hour}, que eu vou deitar."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. Faltou luz aqui e o lampião está seco."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Querosene eu tenho. Quanto você precisa?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Meio litro basta. E uma caixa de fósforo, que a minha molhou."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Pode vir. Bate na porta dos fundos, que eu escuto."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Pago amanhã? Hoje estou sem dinheiro trocado."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Anoto na caderneta. Paga no fim do mês."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Quero saber se amanhã chega querosene."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. O querosene chega amanhã?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "O caminhão vem amanhã cedo, se a estrada deixar."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Então separa cinco litros pra mim?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Separo. Passa depois das {hour}, que até lá já descarregou."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Levo o galão vazio. Quanto está o litro?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Subiu um pouco. Amanhã eu te digo o preço certo."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Boa noite. O querosene já acabou aí?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Acabou hoje à tarde. Chega mais amanhã, no caminhão."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Que horas o caminhão costuma chegar?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Lá pelas {dawn} da manhã. Ele sai da capital de madrugada."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Então eu passo cedo, antes de ir pro serviço."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Vem, que eu guardo um galão no seu nome."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Armazém Ferreira, boa noite."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Armazém Ferreira. Já fechamos, mas pode falar."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Amanhã chega querosene?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Se o caminhão passar pela barreira da estrada, chega."
msgstr ""

#: data/directory/288_armazem_ferreira.tres data/directory/118_farmacia_central.tres data/directory/262_mercearia_silva.tres
msgid "Até que horas vocês ficam abertos?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Até as oito. Depois, só o Joaquim, se ele quiser abrir."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Ferreira. Quem fala?"
msgstr ""

#: data/directory/288_armazem_ferreira.tres data/directory/296_alta_cupula.tres data/directory/184_delegacia_plantao.tres
msgid "Aqui é a telefonista da central."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "Telefonista? Então a senhora sabe que é tarde. Boa noite."
msgstr ""

#: data/directory/288_armazem_ferreira.tres data/directory/291_joaquim_ferreira.tres data/directory/131_paulo_nogueira.tres
msgid "Engano a essa hora... Boa noite, então."
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "do Armazém Ferreira"
msgstr ""

#: data/directory/288_armazem_ferreira.tres
msgid "pro Armazém Ferreira"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "o Bar do Zé"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Preciso dar um recado pra um amigo que tá lá."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite, Zé. O Baixinho ainda está por aí? O de boné."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Está aqui no balcão. Quer que eu chame?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Não precisa. Só avisa que amanhã a pescaria mudou pras {dawn}."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Pras {dawn}. Pode deixar que eu falo."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "E diz pra ele não esquecer as iscas, que da outra vez esqueceu."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Vou falar. Ele vai reclamar, mas eu falo."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite, Zé. O Alemão passou por aí hoje?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Está aqui, jogando dominó."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Diz pra ele que o carro dele está pronto, pode buscar."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "O carro pronto. E ele paga quando?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Amanhã, até as {hour}, senão eu cobro juros."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Vou falar exatamente assim."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Acho que esqueci meu chapéu lá."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. Acho que esqueci meu chapéu aí hoje à tarde."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Chapéu de palha ou de feltro?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "De feltro, {color}, com uma fita escura."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Tem um desses pendurado aqui atrás do balcão."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "É esse! Guarda pra mim, que amanhã eu passo aí."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Fica guardado. Ninguém mexe nas coisas daqui."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. Esqueci meu chapéu aí. Alguém achou?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Achou, sim. Mas tem dois aqui. Como é o seu?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Um {color}, com uma pena do lado."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Esse está aqui comigo. O outro é de um freguês."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Guarda pra mim? Busco amanhã depois das {hour}."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Fica atrás do balcão, esperando."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Quero saber se o jogo ainda tá passando na televisão de lá."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. O jogo ainda está passando aí na televisão?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Está no segundo tempo. Todo mundo grudado na tela."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "E o placar, como está?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "{score}. Quase saiu um gol agora há pouco."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Guarda uma cadeira pra mim, que eu estou indo aí."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Vem logo, que aqui não cabe mais ninguém."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Boa noite. O jogo já acabou aí?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Acabou agora. Ficou {score}."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "E o pessoal, está todo mundo bravo?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Uns comemorando, outros xingando o juiz."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Então nem vou aí hoje."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Faz bem. Hoje a discussão está feia."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Bar do Zé! Fala aí, meu chapa!"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "O jogo ainda está passando aí?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Está no segundo tempo, zero a zero. Uma tristeza."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Até que horas o bar fica aberto?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Enquanto tiver freguês. Mas a polícia anda mandando fechar cedo."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Está muito cheio hoje?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Lotado. Hoje foi dia de pagamento na fábrica."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Bar do Zé. Com essa chuva, só os de sempre."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Choveu muito por aí?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "A Rua da Estação virou rio. O Tonho do bilhar chegou de galocha."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Quanto está a cerveja?"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Três cruzeiros a garrafa. Gelada, hein."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "Valeu, meu chapa! Aparece aqui qualquer dia."
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "do Bar do Zé"
msgstr ""

#: data/directory/327_bar_do_ze.tres
msgid "pro Bar do Zé"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "o Sítio Boa Esperança"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quero encomendar leite e queijo pra amanhã."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Queria encomendar leite e queijo pra amanhã."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quanto de leite? A ordenha é às {dawn}."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Três litros. E um queijo fresco, dos grandes."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "O fresco só fica pronto de tarde. Serve o curado?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Serve. Vocês entregam na {street}?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Entrega a carroça, lá pelas sete. Deixo no portão."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Amanhã é aniversário lá em casa. Preciso de leite e queijo."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Quanto vai ser?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Cinco litros de leite e dois queijos. Vou fazer pão de queijo."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Dá. Mas o queijo eu só entrego depois das {hour}."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está ótimo. A festa é de tarde."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Então fica combinado. Acerta comigo na entrega."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Meu filho trabalha lá e ainda não voltou pra casa."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Meu filho trabalha aí e ainda não voltou pra casa."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "O rapaz do curral? Ficou até mais tarde por causa de uma vaca."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Ai, que susto. Está tudo bem com ele?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está, sim. A vaca pariu agora há pouco e ele ajudou."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "E como ele volta a essa hora? A estrada está escura."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Levo ele de charrete daqui a {wait}."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Boa noite. Meu filho ainda está aí no sítio?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está. Ficou consertando a cerca que o boi derrubou."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "A janta dele está esfriando. Ele demora?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Falta pouco. Ele disse que chega antes das {hour}."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Pede pra ele vir pela estrada, não pelo mato."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Pode deixar. Empresto a lanterna pra ele."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Sítio Boa Esperança, pois não?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Sítio Boa Esperança, pois não? Aqui já está todo mundo deitando."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Vocês entregam leite na cidade?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Toda manhã, na carroça, às seis. É só deixar o litro vazio no portão."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Como está a estrada aí?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Na seca, poeira; na chuva, barro. Hoje dá para passar."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Alô? Fala alto, que a ligação daqui é ruim."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Está me ouvindo?"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Mal e mal. O fio passa no meio do pasto, e as vacas se coçam no poste."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "Engano até aqui no mato? Boa noite, moça."
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "do Sítio Boa Esperança"
msgstr ""

#: data/directory/209_sitio_boa_esperanca.tres
msgid "pro Sítio Boa Esperança"
msgstr ""

#: data/directory/193_corpo_de_bombeiros.tres data/directory/190_delegacia_de_policia.tres data/directory/192_hospital_municipal.tres
msgid "use o despacho"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Pe. Anselmo"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "a Casa Paroquial"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Preciso marcar uma missa de sétimo dia."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Queria marcar uma missa de sétimo dia."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Meus pêsames. Pra quando seria?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Pra quinta-feira. Pode ser na missa das sete?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Pode. Qual o nome do falecido, pra ler no altar?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Teodoro Bastos. Era meu avô."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Anotado. Quinta, às sete, pelo Teodoro Bastos."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Minha tia faleceu e a família quer a missa de sétimo dia."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Sinto muito. Domingo tem missa às oito e às dez."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Às dez é melhor, que vem gente de fora."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Então fica às dez. Vão querer o coral?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Se puder, sim. Ela cantava no coral quando era moça."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Eu falo com as moças do coral amanhã cedo."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Quero pedir uma visita do padre pra minha mãe, que está de cama."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Minha mãe está de cama e queria uma visita do padre."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Ela está muito mal?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Não, graças a Deus. Mas não sai de casa faz um mês e sente falta da missa."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Amanhã, depois da missa das sete, alguém leva a comunhão."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Ela mora na {street}, número {house}."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Anotado. Deixa o portão aberto, por favor."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Boa noite. Dá pra pedir que o padre passe lá em casa? Minha mãe pediu."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Ela está doente?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Quebrou a perna e está de cama. Queria se confessar."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Sábado de manhã dá. Lá pelas {hour}, depois das visitas do hospital."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Está ótimo. Ela vai ficar tão contente."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Diga a ela que vamos rezar por ela."
msgstr ""

#: data/directory/120_casa_paroquial.tres data/nights/night_10.tres data/nights/night_15.tres
msgid "Casa Paroquial, boa noite."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Casa Paroquial. Padre Anselmo falando."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "A que horas é a missa amanhã?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Às sete, e outra às seis da tarde. Venha, que a igreja anda vazia."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "O senhor atende confissão à noite?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Para quem precisa, a porta da sacristia está sempre aberta."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Pois não? Aqui é o padre. Alguém precisa da extrema-unção?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Não, padre, é só uma informação."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Graças a Deus. A essa hora, eu sempre penso no pior."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "O senhor pode visitar um doente amanhã?"
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Posso, depois da missa das sete. Deixe o endereço com a secretaria."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "Vá com Deus, minha filha."
msgstr ""

#: data/directory/120_casa_paroquial.tres
msgid "da Casa Paroquial"
msgstr ""

#: data/directory/120_casa_paroquial.tres
