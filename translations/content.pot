#: data/content.tres
msgid "Leva no relojoeiro."
msgstr ""

#: data/content.tres
msgid "Tá, tá. Vou levar amanhã."
msgstr ""

#: data/content.tres
msgid "Desculpa ficar puxando conversa, é que eu não consigo dormir."
msgstr ""

#: data/content.tres
msgid "Nem eu, e olha que é meu trabalho."
msgstr ""

#: data/content.tres
msgid "Hehe, a senhora tem desculpa, eu não."
msgstr ""

#: data/content.tres
msgid "Entendi."
msgstr ""

#: data/content.tres
msgid "...Desculpa, tá? Eu espero."
msgstr ""

#: data/content.tres
msgid "Faz tempo que eu não ligo pra central."
msgstr ""

#: data/content.tres
msgid "Eu lembro da sua voz."
msgstr ""

#: data/content.tres
msgid "Lembra? Que memória, hein!"
msgstr ""

#: data/content.tres
msgid "Ah, é?"
msgstr ""

#: data/content.tres
msgid "É... faz tempo mesmo."
msgstr ""

#: data/content.tres
msgid "O padre mudou o horário da missa de domingo, viu?"
msgstr ""

#: data/content.tres
msgid "Pra que horas?"
msgstr ""

#: data/content.tres
msgid "Agora é às sete. Cedo demais pra mim."
msgstr ""

#: data/content.tres
msgid "Não vou à missa."
msgstr ""

#: data/content.tres
msgid "Ah... cada um com sua fé, né?"
msgstr ""

#: data/content.tres
msgid "O ônibus da capital atrasou de novo hoje."
msgstr ""

#: data/content.tres
msgid "De novo?"
msgstr ""

#: data/content.tres
msgid "Duas horas! Minha irmã chegou morta de cansaço."
msgstr ""

#: data/content.tres
msgid "É sempre assim."
msgstr ""

#: data/content.tres
msgid "É... pois é."
msgstr ""

#: data/content.tres
msgid "Meu neto passou no vestibular, sabia?"
msgstr ""

#: data/content.tres
msgid "Que beleza! Parabéns!"
msgstr ""

#: data/content.tres
msgid "Ah, que orgulho! Vai ser o primeiro doutor da família."
msgstr ""

#: data/content.tres
msgid "Hum, que bom."
msgstr ""

#: data/content.tres
msgid "...É. Ele se esforçou, viu?"
msgstr ""

#: data/content.tres
msgid "O preço do pão subiu de novo."
msgstr ""

#: data/content.tres
msgid "De novo? Não acredito."
msgstr ""

#: data/content.tres
msgid "Vou ter que voltar a fazer pão em casa."
msgstr ""

#: data/content.tres
msgid "Normal."
msgstr ""

#: data/content.tres
msgid "Normal pra senhora, né..."
msgstr ""

#: data/content.tres
msgid "A vizinha tá dando festa de aniversário, a música vai até tarde."
msgstr ""

#: data/content.tres
msgid "Pelo menos é festa, e não briga."
msgstr ""

#: data/content.tres
msgid "Isso é! E ela ainda me mandou um prato de salgadinho."
msgstr ""

#: data/content.tres
msgid "Paciência."
msgstr ""

#: data/content.tres
msgid "Paciência eu tenho. Sono é que não."
msgstr ""

#: data/content.tres
msgid "Que chuva, hein? Não parou desde a tarde."
msgstr ""

#: data/content.tres
msgid "Daqui eu ouço no telhado."
msgstr ""

#: data/content.tres
msgid "Aqui pinga até na cozinha."
msgstr ""

#: data/content.tres
msgid "É chuva."
msgstr ""

#: data/content.tres
msgid "...É, né."
msgstr ""

#: data/content.tres
msgid "Ouvi dizer que o rio vai encher de novo."
msgstr ""

#: data/content.tres
msgid "Tomara que não."
msgstr ""

#: data/content.tres
msgid "Da última vez a água chegou na praça."
msgstr ""

#: data/content.tres
msgid "Boato."
msgstr ""

#: data/content.tres
msgid "Tomara que seja, moça."
msgstr ""

#: data/content.tres
msgid "O rio subiu bastante com essa chuva."
msgstr ""

#: data/content.tres
msgid "Cuidado por aí."
msgstr ""

#: data/content.tres
msgid "Pode deixar, moça. Aqui é alto."
msgstr ""

#: data/content.tres
msgid "...Bom, aqui é alto, pelo menos."
msgstr ""

#: data/content.tres
msgid "Tá caindo um toró aqui, a rua virou rio."
msgstr ""

#: data/content.tres
msgid "Não sai de casa, hein."
msgstr ""

#: data/content.tres
msgid "Nem pensar, moça. Daqui não saio."
msgstr ""

#: data/content.tres
msgid "Aqui também."
msgstr ""

#: data/content.tres
msgid "Ah... tá."
msgstr ""

#: data/content.tres
msgid "Com essa chuva ninguém sai de casa, né?"
msgstr ""

#: data/content.tres
msgid "Só quem precisa."
msgstr ""

#: data/content.tres
msgid "É, coitado de quem tá na estrada."
msgstr ""

#: data/content.tres
msgid "Melhor assim."
msgstr ""

#: data/content.tres
msgid "É, noite de ficar debaixo das cobertas."
msgstr ""

#: data/content.tres
msgid "Que neblina, hein? Não dá pra ver o outro lado da rua."
msgstr ""

#: data/content.tres
msgid "Daqui também não vejo nada."
msgstr ""

#: data/content.tres
msgid "Parece algodão na janela."
msgstr ""

#: data/content.tres
msgid "Fique em casa hoje."
msgstr ""

#: data/content.tres
msgid "Pode deixar, não ponho o pé lá fora."
msgstr ""

#: data/content.tres
msgid "Com essa cerração, é melhor ninguém pegar a estrada."
msgstr ""

#: data/content.tres
msgid "Verdade, é perigoso."
msgstr ""

#: data/content.tres
msgid "Meu cunhado quase errou a entrada da cidade uma vez."
msgstr ""

#: data/content.tres
msgid "Tomara que ninguém precise."
msgstr ""

#: data/content.tres
msgid "Deus queira."
msgstr ""

#: data/content.tres
msgid "Parece que a cidade sumiu na névoa hoje."
msgstr ""

#: data/content.tres
msgid "Amanhã ela volta."
msgstr ""

#: data/content.tres
msgid "Hehe, tomara. Com a padaria e tudo."
msgstr ""

#: data/content.tres
msgid "Exagero."
msgstr ""

#: data/content.tres
msgid "Hehe... é, talvez."
msgstr ""

#: data/content.tres
msgid "Que noite bonita, hein? Dá pra ver todas as estrelas."
msgstr ""

#: data/content.tres
msgid "Tá bonita mesmo."
msgstr ""

#: data/content.tres
msgid "Fiquei um tempão na varanda olhando."
msgstr ""

#: data/content.tres
msgid "Daqui eu só vejo a mesa."
msgstr ""

#: data/content.tres
msgid "Ah, coitado. Depois dá uma espiada na janela."
msgstr ""

#: data/content.tres
msgid "Tá uma lua bonita hoje."
msgstr ""

#: data/content.tres
msgid "Lua cheia?"
msgstr ""

#: data/content.tres
msgid "Quase. Amanhã fica redondinha."
msgstr ""

#: data/content.tres
msgid "Não reparei."
msgstr ""

#: data/content.tres
msgid "Ah... depois dá uma olhada."
msgstr ""

#: data/content.tres
msgid "Noite fresquinha, né? Até dá gosto de ficar na janela."
msgstr ""

#: data/content.tres
msgid "Depois do calor de ontem..."
msgstr ""

#: data/content.tres
msgid "Nem me fale, ontem não dava nem pra dormir."
msgstr ""

#: data/content.tres
msgid "Aproveite."
msgstr ""

#: data/content.tres
msgid "Tô aproveitando, com um cafezinho."
msgstr ""

#: data/content.tres
msgid "A novela das oito tá boa demais. A senhora tem acompanhado?"
