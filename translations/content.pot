#: data/content.tres
msgid "{street}, perto {landmark}"
msgstr ""

#: data/content.tres
msgid "na frente {landmark}, na {street}"
msgstr ""

#: data/content.tres
msgid "Central telefônica, pois não?"
msgstr ""

#: data/content.tres
msgid "Central, boa noite. Em que posso ajudar?"
msgstr ""

#: data/content.tres
msgid "Central, pois não?"
msgstr ""

#: data/content.tres
msgid "Central."
msgstr ""

#: data/content.tres
msgid "Central telefônica, boa noite."
msgstr ""

#: data/content.tres
msgid "Central de São Sotero, pois não?"
msgstr ""

#: data/content.tres
msgid "Desculpe incomodar, a senhora deve estar cheia de ligação."
msgstr ""

#: data/content.tres
msgid "Imagina, é pra isso que a central existe."
msgstr ""

#: data/content.tres
msgid "Ah, que bom. Eu fico sem jeito, sabe?"
msgstr ""

#: data/content.tres
msgid "Tudo bem."
msgstr ""

#: data/content.tres
msgid "Ah... tá. Desculpe de novo."
msgstr ""

#: data/content.tres
msgid "A senhora passa a noite inteira aí sozinha?"
msgstr ""

#: data/content.tres
msgid "Eu e os cabos."
msgstr ""

#: data/content.tres
msgid "Hehe, pelo menos eles não reclamam, né?"
msgstr ""

#: data/content.tres
msgid "Ah... tá. Não vou atrapalhar, então."
msgstr ""

#: data/content.tres
msgid "Minha mulher disse que não era pra incomodar a central a essa hora."
msgstr ""

#: data/content.tres
msgid "Não incomoda, não."
msgstr ""

#: data/content.tres
msgid "Vou contar pra ela que a senhora disse isso."
msgstr ""

#: data/content.tres
msgid "Ela tem razão."
msgstr ""

#: data/content.tres
msgid "Ah... tá certo. Desculpe."
msgstr ""

#: data/content.tres
msgid "Meu marido já dormiu, mas eu não consigo pegar no sono."
msgstr ""

#: data/content.tres
msgid "Um chá de camomila ajuda."
msgstr ""

#: data/content.tres
msgid "Já tomei dois, moça. Nem fez cócegas."
msgstr ""

#: data/content.tres
msgid "Ah... tá. Eu espero aqui."
msgstr ""

#: data/content.tres
msgid "O seu Geraldo, da Rua da Matriz, fez cem anos hoje, sabia?"
msgstr ""

#: data/content.tres
msgid "Cem anos! Que bênção."
msgstr ""

#: data/content.tres
msgid "Teve bolo na praça e banda. Ele dançou com a bisneta!"
msgstr ""

#: data/content.tres
msgid "Que bom pra ele."
msgstr ""

#: data/content.tres
msgid "...É. E lúcido, viu? Melhor que eu."
msgstr ""

#: data/content.tres
msgid "Essa central nunca dorme, né?"
msgstr ""

#: data/content.tres
msgid "Nunca. Alguém tem que ficar acordado."
msgstr ""

#: data/content.tres
msgid "Ainda bem, viu? A gente se sente mais seguro."
msgstr ""

#: data/content.tres
msgid "Pois é."
msgstr ""

#: data/content.tres
msgid "É... bom, eu espero."
msgstr ""

#: data/content.tres
msgid "Que frio, meu Deus."
msgstr ""

#: data/content.tres
msgid "Pega um casaco."
msgstr ""

#: data/content.tres
msgid "Já tô com dois, moça!"
msgstr ""

#: data/content.tres
msgid "Aham."
msgstr ""

#: data/content.tres
msgid "...Bom, deixa pra lá."
msgstr ""

#: data/content.tres
msgid "Amanhã é dia de feira, né?"
msgstr ""

#: data/content.tres
msgid "É sim, amanhã cedo."
msgstr ""

#: data/content.tres
msgid "Vou ver se ainda tem aquele queijo da serra."
msgstr ""

#: data/content.tres
msgid "Não sei."
msgstr ""

#: data/content.tres
msgid "Ah... tá. Eu vejo amanhã, então."
msgstr ""

#: data/content.tres
msgid "Meu relógio adiantou de novo. A senhora me diz a hora certa?"
msgstr ""

#: data/content.tres
msgid "Digo, sim. O relógio da central é o certo da cidade."
msgstr ""

#: data/content.tres
msgid "Então eu acerto o meu pelo seu. Pronto, agora vai."
