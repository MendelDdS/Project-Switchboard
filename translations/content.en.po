msgid "Farmácia Santa Rita"
msgstr "Farmácia Santa Rita"

#: data/calls/transfer_01_dona_lurdes_farmacia_santa_rita.tres
msgid "Obrigada, meu filho. Deus te abençoe."
msgstr "Thank you, dear. God bless you."

