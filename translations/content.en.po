msgid "Boa noite, central."
msgstr "Good evening, operator."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Me liga com o Hotel Estrela, por favor? Meu irmão chegou hoje da capital e está hospedado lá."
msgstr "Can you put me through to the Hotel Estrela, please? My brother came in from the capital today and he's staying there."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "O Hotel Estrela. Na avenida."
msgstr "The Hotel Estrela. On the avenue."

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Hotel Estrela"
msgstr "Hotel Estrela"

#: data/calls/transfer_02_sr_nelson_hotel_estrela.tres
msgid "Muito obrigado."
msgstr "Thank you very much."

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres data/calls/transfer_29_rapaz_cine_odeon.tres data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Rapaz"
msgstr "Young man"

#: data/calls/transfer_03_rapaz_taxi_ponto_da_rodoviaria.tres
