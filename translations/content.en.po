#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O médico. A pressão do meu marido subiu e ele mandou ligar se isso acontecesse."
msgstr "The physician. My husband's blood pressure went up and he told us to call if that happened."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O Doutor Almeida, o médico."
msgstr "Doctor Almeida, the physician."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Obrigada. Rápido, viu?"
msgstr "Thank you. Hurry, okay?"

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Boa noite. A Dona Célia Rocha, por favor."
msgstr "Good evening. Dona Célia Rocha, please."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "A que mora perto da escola."
msgstr "The one who lives near the school."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Célia Rocha. A casa dela é perto da escola."
msgstr "Célia Rocha. Her house is near the school."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Seu Lauro"
msgstr "Seu Lauro"

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Me liga com o seu Ferreira."
msgstr "Put me through to Seu Ferreira."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O do armazém. Deixei minha carteira no balcão hoje de tarde."
msgstr "The one from the general store. I left my wallet on the counter this afternoon."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O Ferreira do armazém. O Joaquim."
msgstr "Ferreira from the general store. Joaquim."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Obrigado, moço. Tomara que ele atenda."
msgstr "Thanks, young man. I hope he picks up."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Me liga com o seu Paulo Nogueira? Ele disse que eu podia ligar a qualquer hora."
msgstr "Can you put me through to Seu Paulo Nogueira? He said I could call at any hour."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira."
msgstr "Paulo Nogueira."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira"
msgstr "Paulo Nogueira"

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Dona Iolanda"
msgstr "Dona Iolanda"

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Quero falar com a Dona Rosa Lima. É a irmã dela, da capital."
msgstr "I want to talk to Dona Rosa Lima. It's her sister, from the capital."

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Rosa Lima, das Acácias."
msgstr "Rosa Lima, on Acácias."

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Rosa Lima"
msgstr "Rosa Lima"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres data/content.tres
msgid "Seu Valdir"
msgstr "Seu Valdir"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "O 384, por favor."
msgstr "384, please."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Da Sônia."
msgstr "Sônia's."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Três, oito, quatro."
msgstr "Three, eight, four."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Sônia Vieira"
msgstr "Sônia Vieira"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Brigado."
msgstr "Thanks."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "O Alberto Ramos, da Avenida Brasil. Somos sócios."
msgstr "Alberto Ramos, on Avenida Brasil. We're partners."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos."
msgstr "Alberto Ramos."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos"
msgstr "Alberto Ramos"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Vizinha"
msgstr "Neighbor"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Central, me liga com o seu Benedito Souza?"
msgstr "Operator, can you put me through to Seu Benedito Souza?"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Sou vizinha dele. A luz da casa tá acesa e ele não atende a porta."
msgstr "I'm his neighbor. His lights are on and he won't answer the door."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "O seu Benedito Souza, da Rua do Sol."
msgstr "Seu Benedito Souza, on Rua do Sol."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Benedito Souza"
msgstr "Benedito Souza"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Obrigada. Deve estar dormindo, né?"
msgstr "Thank you. He must be asleep, right?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Mulher"
msgstr "Woman"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Central! Houve um acidente na Rua das Acácias! Precisamos de ajuda!"
msgstr "Operator! There's been an accident on Rua das Acácias! We need help!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Qual é o endereço exato?"
msgstr "What's the exact address?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O que aconteceu?"
msgstr "What happened?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Quantas pessoas estão feridas?"
msgstr "How many people are hurt?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "É perto do número 101! Na frente da mercearia!"
msgstr "It's near number 101! In front of the grocery!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste e ficou atravessado na rua!"
msgstr "A car hit a pole and ended up sideways across the street!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Duas pessoas. Uma não está se mexendo!"
msgstr "Two people. One isn't moving!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Ninguém, graças a Deus. Mas o carro tá bloqueando tudo."
msgstr "Nobody, thank God. But the car is blocking everything."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O motorista tá preso nas ferragens! Não consegue abrir a porta!"
msgstr "The driver is trapped in the wreck! He can't open the door!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste. Parou em cima da calçada."
msgstr "A car hit the pole. It stopped up on the sidewalk."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Estão vindo? Graças a Deus... obrigada."
msgstr "They're coming? Thank God... thank you."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá juntando gente em volta, os carros não conseguem mais passar!"
msgstr "A crowd is gathering, the cars can't get through anymore!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "As pessoas estão longe do carro?"
msgstr "Are people staying away from the car?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Não! Tá todo mundo em volta, querendo ajudar!"
msgstr "No! Everyone's crowded around, trying to help!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá vazando gasolina do carro! Tá escorrendo pela rua!"
msgstr "Gas is leaking from the car! It's running down the street!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem alguém perto da gasolina?"
msgstr "Is anyone near the gas?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem um rapaz tentando empurrar o carro! Eu falei pra ele sair!"
msgstr "A guy is trying to push the car! I told him to get away!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Pegou fogo! O carro pegou fogo! Por que demorou tanto?!"
msgstr "It caught fire! The car caught fire! Why did it take so long?!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O rapaz que empurrava o carro se queimou! Tá gritando de dor!"
msgstr "The guy pushing the car got burned! He's screaming in pain!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Central, tem fogo! Tem fogo no galpão da Rua do Moinho!"
msgstr "Operator, there's a fire! There's a fire in the shed on Rua do Moinho!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Qual é o número?"
msgstr "What's the number?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O que está queimando?"
msgstr "What's burning?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tem alguém lá dentro?"
msgstr "Is anyone inside?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Quarenta! O galpão da serraria velha!"
msgstr "Forty! The old sawmill shed!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado inteiro! A fumaça está preta!"
msgstr "The whole roof! The smoke is black!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não. A serraria fecha às seis, tá vazia."
msgstr "No. The sawmill closes at six, it's empty."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante não conseguiu sair! Tá gritando lá dentro!"
msgstr "The night watchman couldn't get out! He's screaming in there!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante saiu, mas tá com o rosto queimado!"
msgstr "The night watchman got out, but his face is burned!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá bom. Tá bom. Eu vou tirar o carro daqui."
msgstr "Okay. Okay. I'm moving the car out of here."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "A fumaça tá tomando a rua toda, os carros tão parando no meio!"
msgstr "The smoke is covering the whole street, cars are stopping in the middle!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Os carros conseguem passar?"
msgstr "Can cars get through?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não, parou tudo nos dois sentidos. Ninguém enxerga nada."
msgstr "No, everything's stopped both ways. Nobody can see a thing."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Um vizinho tentou ajudar e caiu! Tá desacordado na fumaça!"
msgstr "A neighbor tried to help and collapsed! He's out cold in the smoke!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vizinho está respirando?"
msgstr "Is the neighbor breathing?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá, mas tá tossindo muito e não levanta!"
msgstr "Yes, but he's coughing a lot and can't get up!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado caiu! Caiu tudo! Ninguém veio..."
msgstr "The roof came down! Everything came down! Nobody came..."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Arrastaram o vizinho pra fora, mas ele tá muito mal!"
msgstr "They dragged the neighbor out, but he's in really bad shape!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Central, meu pai caiu no banheiro e não acorda!"
msgstr "Operator, my father fell in the bathroom and won't wake up!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Qual é o endereço?"
msgstr "What's the address?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/templates/emergency_mal_subito.tres data/templates/emergency_briga.tres
msgid "Ele está respirando?"
msgstr "Is he breathing?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Tem mais alguém ferido?"
msgstr "Is anyone else hurt?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Rua do Sol, 230! A casa amarela!"
msgstr "Rua do Sol, 230! The yellow house!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Está... mas não responde. Bateu a cabeça."
msgstr "He is... but he won't respond. He hit his head."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não, só ele. Por favor, rápido!"
msgstr "No, just him. Please, hurry!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Tá, ouço ele respirando. Mas a porta tá trancada por dentro e ele caiu encostado nela!"
msgstr "Yes, I can hear him breathing. But the door is locked from inside and he fell against it!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Obrigada. Eu vou deixar a porta aberta."
msgstr "Thank you. I'll leave the door open."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele tá ficando roxo... a respiração tá cada vez mais fraca!"
msgstr "He's turning blue... his breathing keeps getting weaker!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele está consciente?"
msgstr "Is he conscious?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não! Eu chamo e ele não abre o olho!"
msgstr "No! I call him and he won't open his eyes!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não responde mais nada! Não sei se tá respirando!"
msgstr "He's not responding at all! I don't know if he's breathing!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Dá pra ver se o peito dele mexe?"
msgstr "Can you see if his chest is moving?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não sei... acho que não. Meu Deus..."
msgstr "I don't know... I don't think so. My God..."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele... ele não tá mais respirando. Vocês demoraram demais."
msgstr "He... he's not breathing anymore. You took too long."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não respira... Eu tô tentando, mas ele não acorda."
msgstr "He's not breathing... I'm trying, but he won't wake up."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Homem (sussurrando)"
msgstr "Man (whispering)"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Central... tem alguém tentando arrombar a casa do vizinho."
msgstr "Operator... someone's trying to break into my neighbor's house."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "O que você está vendo?"
msgstr "What do you see?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Quantas pessoas?"
msgstr "How many people?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Avenida Brasil, 150. A casa do lado da minha."
msgstr "Avenida Brasil, 150. The house next to mine."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Forçando a janela dos fundos. O vizinho viajou."
msgstr "Forcing the back window. My neighbor's away."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Dois homens. Não vi arma, não."
msgstr "Two men. I didn't see a gun."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "O vizinho chegou bem na hora e levou uma pancada na cabeça! Tá caído no quintal!"
msgstr "The neighbor came home right then and got hit on the head! He's lying in the yard!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tá. Vou ficar quieto aqui dentro."
msgstr "Okay. I'll keep quiet in here."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles entraram! Tão carregando as coisas pra rua!"
msgstr "They got in! They're carrying things out to the street!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles estão armados?"
msgstr "Are they armed?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Um deles tá com uma barra de ferro na mão."
msgstr "One of them has an iron bar in his hand."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles me viram na janela! Um deles tá vindo pra cá com um pé de cabra!"
msgstr "They saw me at the window! One of them is coming over here with a crowbar!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Você consegue se trancar?"
msgstr "Can you lock yourself in?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tô trancando a porta agora... ele tá batendo!"
msgstr "I'm locking the door now... he's banging on it!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles fugiram de carro. Levaram tudo... e ninguém apareceu."
msgstr "They drove off. They took everything... and nobody showed up."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eu tô bem... mas o seu Jorge, da casa da frente, levou uma pancada quando veio ver."
msgstr "I'm fine... but Seu Jorge, from across the street, got hit when he came to look."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Homem nervoso"
msgstr "Nervous man"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Central! Tão brigando aqui no Bar do Zé! Um puxou uma faca!"
msgstr "Operator! There's a fight here at the Bar do Zé! One pulled a knife!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Alguém está ferido?"
msgstr "Is anyone hurt?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Quantas pessoas estão brigando?"
msgstr "How many people are fighting?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Rua da Estação, 140! O bar do Zé!"
msgstr "Rua da Estação, 140! Zé's bar!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá sangrando no braço! Rápido!"
msgstr "One's bleeding from the arm! Hurry!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Dois! Mas o bar tá cheio!"
msgstr "Two! But the bar is packed!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Ainda não! O Zé tá tentando separar!"
msgstr "Not yet! Zé is trying to break it up!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tão vindo? Tá, eu seguro o pessoal aqui."
msgstr "They're coming? Okay, I'll keep everyone back."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Agora tão quebrando as cadeiras! Tá todo mundo brigando!"
msgstr "Now they're breaking chairs! Everybody's fighting!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tem mais alguém armado?"
msgstr "Is anyone else armed?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá com uma garrafa quebrada!"
msgstr "One's got a broken bottle!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Furaram um rapaz na barriga! Tá sangrando muito!"
msgstr "They stabbed a guy in the stomach! He's bleeding a lot!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Onde ele foi ferido?"
msgstr "Where was he hurt?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Na barriga! Tão apertando com um pano, mas não para de sangrar!"
msgstr "In the stomach! They're pressing a cloth on it, but it won't stop bleeding!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz desmaiou... tem sangue pra todo lado. Por que ninguém veio?"
msgstr "The guy passed out... there's blood everywhere. Why didn't anyone come?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz da facada desmaiou, e o Zé levou uma garrafada tentando separar!"
msgstr "The guy who got stabbed passed out, and Zé got hit with a bottle trying to break it up!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Central, caiu um fio do poste aqui na frente e está soltando faísca!"
msgstr "Operator, a wire fell off the pole out front and it's sparking!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém encostou no fio?"
msgstr "Did anyone touch the wire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tem fogo?"
msgstr "Is there a fire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Rua do Comércio, 71! Na frente da barbearia!"
msgstr "Rua do Comércio, 71! In front of the barbershop!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, não! Tá todo mundo longe."
msgstr "No, no! Everyone's keeping away."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá começando a queimar a árvore!"
msgstr "The tree's starting to burn!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O menino da padaria encostou! Tá caído e não se mexe!"
msgstr "The boy from the bakery touched it! He's down and not moving!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá bom. Vou manter as crianças dentro de casa."
msgstr "Okay. I'll keep the kids inside."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá todo mundo parando pra olhar, a rua tá trancada de carro!"
msgstr "Everybody's stopping to look, the street is jammed with cars!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém está perto do fio?"
msgstr "Is anyone near the wire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, mas os carros tão passando por cima dele devagar!"
msgstr "No, but cars are slowly driving over it!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O fogo passou pro telhado da barbearia! O barbeiro mora em cima e não consegue descer!"
msgstr "The fire spread to the barbershop roof! The barber lives upstairs and can't get down!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O barbeiro está ferido?"
msgstr "Is the barber hurt?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não sei! Ele tá na janela de cima, gritando por ajuda!"
msgstr "I don't know! He's at the upstairs window, shouting for help!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "A barbearia tá toda em chamas... e ninguém veio."
msgstr "The barbershop is all in flames... and nobody came."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tiraram o barbeiro pela janela... ele tá com as costas queimadas!"
msgstr "They got the barber out the window... his back is burned!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Central! Tá saindo fumaça da casa do vizinho!"
msgstr "Operator! There's smoke coming out of my neighbor's house!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres data/templates/emergency_incendio.tres
msgid "Tem alguém dentro da casa?"
msgstr "Is anyone in the house?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Dá para ver o fogo?"
msgstr "Can you see the fire?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Rua das Flores, 45! Perto da clínica!"
msgstr "Rua das Flores, 45! Near the clinic!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ele saiu, mas queimou o braço feio!"
msgstr "He got out, but his arm is badly burned!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem fogo na janela da cozinha!"
msgstr "There's fire in the kitchen window!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Não, ele saiu antes. Tá aqui na rua comigo."
msgstr "No, he got out before. He's here on the street with me."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem! Ele mora sozinho e não saiu! A porta tá trancada!"
msgstr "Yes! He lives alone and didn't come out! The door is locked!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá bom. Eu vou chamar os outros vizinhos."
msgstr "Okay. I'll go get the other neighbors."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Agora tá saindo fogo pelo telhado!"
msgstr "Now there's fire coming out of the roof!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo já passou pras outras casas?"
msgstr "Has the fire spread to other houses?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ainda não, mas tá pertinho do muro do vizinho!"
msgstr "Not yet, but it's right by the neighbor's wall!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo tá passando pra casa do lado! A senhora de lá usa cadeira de rodas e não consegue sair!"
msgstr "The fire is spreading to the house next door! The lady there uses a wheelchair and can't get out!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora está sozinha?"
msgstr "Is the lady alone?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá! A filha dela trabalha à noite!"
msgstr "Yes! Her daughter works nights!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A casa desabou... Vocês demoraram demais!"
msgstr "The house collapsed... You took too long!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora do lado! Os vizinhos tiraram ela, mas tá toda queimada!"
msgstr "The lady next door! The neighbors got her out, but she's badly burned!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Central, um carro bateu no poste aqui na avenida!"
msgstr "Operator, a car hit a light pole here on the avenue!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "O motorista está ferido?"
msgstr "Is the driver hurt?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "O poste caiu?"
msgstr "Did the pole come down?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Avenida Brasil, 60! Na frente da loja de tecidos!"
msgstr "Avenida Brasil, 60! In front of the fabric store!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá preso no carro, com a cabeça sangrando. Mas tá falando."
msgstr "He's trapped in the car, his head's bleeding. But he's talking."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, e os fios tão soltando faísca no meio da avenida! Ninguém passa!"
msgstr "It's leaning, and the wires are sparking in the middle of the avenue! Nobody can get through!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Não, ele saiu sozinho. Só tá assustado."
msgstr "No, he got out on his own. He's just shaken."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, mas de pé. O carro ficou em cima da calçada."
msgstr "It's leaning, but still standing. The car ended up on the sidewalk."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá. Ninguém chega perto dos fios, pode deixar."
msgstr "Okay. Nobody's going near the wires, don't worry."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá formando fila de carro dos dois lados da avenida!"
msgstr "There's a line of cars building up on both sides of the avenue!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tem alguém sinalizando a pista?"
msgstr "Is anyone warning the traffic?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/templates/emergency_acidente.tres
msgid "Não, tá todo mundo parado olhando!"
msgstr "No, everyone's just standing there watching!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Começou a sair fumaça do capô do carro!"
msgstr "Smoke started coming out of the car's hood!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tem alguém perto do carro?"
msgstr "Is anyone near the car?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tem gente tentando abrir a porta pra ajudar!"
msgstr "People are trying to open the door to help!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "O carro pegou fogo! Por que ninguém veio?!"
msgstr "The car caught fire! Why didn't anyone come?!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Um dos rapazes que ajudava se queimou feio no braço!"
msgstr "One of the guys helping got his arm badly burned!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Filha"
msgstr "Daughter"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Central, minha mãe tá passando mal! A boca tá torta e ela não fala direito!"
msgstr "Operator, my mother's not well! Her mouth is drooping and she can't talk right!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela está consciente?"
msgstr "Is she conscious?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Quantos anos ela tem?"
msgstr "How old is she?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Rua do Comércio, 150. Em cima da loja."
msgstr "Rua do Comércio, 150. Above the store."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas não consegue levantar o braço."
msgstr "She is, but she can't lift her arm."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Setenta e oito."
msgstr "Seventy-eight."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Eu vou descer e esperar na porta."
msgstr "I'll go down and wait at the door."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Agora ela não consegue falar mais nada!"
msgstr "Now she can't say anything at all!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela consegue mexer os braços?"
msgstr "Can she move her arms?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Só o esquerdo. O direito tá caído."
msgstr "Just the left one. The right one is limp."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela desmaiou! Não acorda!"
msgstr "She fainted! She won't wake up!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela está respirando?"
msgstr "Is she breathing?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas fazendo um barulho estranho!"
msgstr "Yes, but she's making a strange noise!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela... ela não acorda mais. Ninguém veio."
msgstr "She... she's not waking up. Nobody came."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela não acorda... tá respirando bem fraquinho."
msgstr "She won't wake up... she's breathing very faintly."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Central... tem alguém dentro da minha casa."
msgstr "(whispering) Operator... there's someone inside my house."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "O senhor está em segurança?"
msgstr "Are you somewhere safe, sir?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "A pessoa está armada?"
msgstr "Is the person armed?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Rua do Moinho, 260. A última casa."
msgstr "Rua do Moinho, 260. The last house."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô trancado no quarto. Ouvi quebrarem o vidro da cozinha."
msgstr "I'm locked in the bedroom. I heard them break the kitchen glass."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Não sei. Não vi. Só ouço os passos."
msgstr "I don't know. I didn't see. I can only hear footsteps."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô no quarto, trancado. Mas cortei a mão feio no vidro quando fugi... tá sangrando muito."
msgstr "I'm locked in the bedroom. But I cut my hand badly on the glass when I ran... it's bleeding a lot."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tá. Eu vou ficar quieto aqui."
msgstr "Okay. I'll stay quiet in here."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão mexendo nas gavetas da sala..."
msgstr "(whispering) They're going through the drawers in the living room..."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Quantas pessoas você ouve?"
msgstr "How many people do you hear?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Duas vozes. Homens."
msgstr "(whispering) Two voices. Men."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão tentando abrir a porta do quarto!"
msgstr "(whispering) They're trying to open the bedroom door!"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tem alguma saída no quarto?"
msgstr "Is there a way out of the bedroom?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) A janela... mas é do segundo andar."
msgstr "(whispering) The window... but it's on the second floor."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(chorando) Eles foram embora... levaram tudo. Ninguém veio."
msgstr "(crying) They're gone... they took everything. Nobody came."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(chorando) Pulei a janela pra fugir... acho que quebrei o pé."
msgstr "(crying) I jumped out the window to get away... I think I broke my foot."

#: data/calls/prank_01_crianca.tres
msgid "Criança"
msgstr "Child"

#: data/calls/prank_01_crianca.tres
msgid "Central, preciso de uma ambulância!"
msgstr "Operator, I need an ambulance!"

#: data/calls/prank_01_crianca.tres
msgid "Na casa do meu cachorro."
msgstr "At my dog's house."

#: data/calls/prank_01_crianca.tres
msgid "Isso é sério?"
msgstr "Is this serious?"

#: data/calls/prank_01_crianca.tres
msgid "Rua Au-Au, número 4."
msgstr "Rua Au-Au, number 4."

#: data/calls/prank_01_crianca.tres
msgid "É urgente. Ele comeu meu sanduíche."
msgstr "It's urgent. He ate my sandwich."

#: data/calls/prank_01_crianca.tres data/calls/prank_05_menino.tres
msgid "(risadas abafadas)"
msgstr "(muffled laughter)"

#: data/calls/prank_01_crianca.tres
msgid "(ao fundo) Desliga, desliga!"
msgstr "(in the background) Hang up, hang up!"

#: data/calls/prank_02_garoto.tres data/calls/prank_04_garoto.tres data/calls/prank_07_garoto.tres
msgid "Garoto"
msgstr "Boy"

#: data/calls/prank_02_garoto.tres
msgid "Central! É urgente! Tem um incêndio!"
msgstr "Operator! It's urgent! There's a fire!"

#: data/calls/prank_02_garoto.tres
msgid "Onde é o incêndio?"
msgstr "Where's the fire?"

#: data/calls/prank_02_garoto.tres
msgid "No meu coração..."
msgstr "In my heart..."

#: data/calls/prank_02_garoto.tres
msgid "...pela Marcinha da sétima série!"
msgstr "...for Marcinha in seventh grade!"

#: data/calls/prank_02_garoto.tres
msgid "(risadas de várias crianças)"
msgstr "(several kids laughing)"

#: data/calls/prank_02_garoto.tres
msgid "Esta é uma linha de serviço, garoto."
msgstr "This is a service line, kid."

#: data/calls/prank_02_garoto.tres
msgid "Onde você está ligando?"
msgstr "Where are you calling from?"

#: data/calls/prank_02_garoto.tres
msgid "Fala pra ela, tá? Tchau!"
msgstr "Tell her, okay? Bye!"

#: data/calls/prank_03_menina.tres data/calls/prank_06_menina.tres
msgid "Menina"
msgstr "Girl"

#: data/calls/prank_03_menina.tres
msgid "Alô? É da central telefônica?"
msgstr "Hello? Is this the telephone exchange?"

#: data/calls/prank_03_menina.tres
msgid "Sim. Em que posso ajudar?"
msgstr "Yes. How can I help?"

#: data/calls/prank_03_menina.tres
msgid "Vocês têm o telefone de todo mundo da cidade?"
msgstr "Do you have everybody's phone number in town?"

#: data/calls/prank_03_menina.tres
msgid "Temos a lista, sim."
msgstr "We have the directory, yes."

#: data/calls/prank_03_menina.tres
msgid "Então cuida bem deles, tá?"
msgstr "Then take good care of them, okay?"

#: data/calls/prank_03_menina.tres data/calls/prank_04_garoto.tres data/calls/prank_06_menina.tres
msgid "(risadas)"
msgstr "(laughter)"

#: data/calls/prank_03_menina.tres
msgid "Minha mãe tá vindo! Tchau!"
msgstr "My mom's coming! Bye!"

#: data/calls/prank_04_garoto.tres
msgid "Alô, é da central? A sua geladeira está funcionando?"
msgstr "Hello, is this the exchange? Is your refrigerator running?"

#: data/calls/prank_04_garoto.tres
msgid "Aqui é a central telefônica."
msgstr "This is the telephone exchange."

#: data/calls/prank_04_garoto.tres
msgid "Que brincadeira é essa?"
msgstr "What kind of joke is this?"

#: data/calls/prank_04_garoto.tres
msgid "Então corre atrás dela!"
msgstr "Then you'd better go catch it!"

#: data/calls/prank_05_menino.tres data/calls/prank_09_menino.tres
msgid "Menino"
msgstr "Kid"

#: data/calls/prank_05_menino.tres
msgid "Central? Aqui quem fala é o presidente da república."
msgstr "Operator? This is the president of the republic speaking."

#: data/calls/prank_05_menino.tres
msgid "Pois não, senhor presidente."
msgstr "Yes, Mr. President."

#: data/calls/prank_05_menino.tres
msgid "Esta é uma linha de serviço."
msgstr "This is a service line."

#: data/calls/prank_05_menino.tres
msgid "Eu quero... eu quero pedir uma pizza!"
msgstr "I want... I want to order a pizza!"

#: data/calls/prank_05_menino.tres
msgid "(ao fundo) Pede cachorro-quente!"
msgstr "(in the background) Get hot dogs!"

#: data/calls/prank_06_menina.tres
msgid "Alô? É da central?"
msgstr "Hello? Is this the exchange?"

#: data/calls/prank_06_menina.tres
msgid "Sim, central telefônica. Pois não?"
msgstr "Yes, telephone exchange. How can I help?"

#: data/calls/prank_06_menina.tres
msgid "Meu irmão quer saber se o senhor tem cara de telefone."
msgstr "My brother wants to know if your face looks like a telephone."

#: data/calls/prank_06_menina.tres
msgid "Esta é uma linha de serviço, menina."
msgstr "This is a service line, young lady."

#: data/calls/prank_06_menina.tres
msgid "Onde estão seus pais?"
msgstr "Where are your parents?"

#: data/calls/prank_06_menina.tres
msgid "Foi ele que mandou falar! Tchau!"
msgstr "He told me to say it! Bye!"

#: data/calls/prank_07_garoto.tres
msgid "Central, eu quero denunciar um crime!"
msgstr "Operator, I want to report a crime!"

#: data/calls/prank_07_garoto.tres
msgid "Qual crime? Onde?"
msgstr "What crime? Where?"

#: data/calls/prank_07_garoto.tres
msgid "Roubaram a minha bicicleta..."
msgstr "Somebody stole my bicycle..."

#: data/calls/prank_07_garoto.tres
msgid "...e devolveram pintada de rosa!"
msgstr "...and brought it back painted pink!"

#: data/calls/prank_07_garoto.tres
msgid "(risadas ao fundo)"
msgstr "(laughter in the background)"

#: data/calls/prank_07_garoto.tres
msgid "Você sabe que trote é crime, não sabe?"
msgstr "You know prank calls are a crime, don't you?"

#: data/calls/prank_07_garoto.tres
msgid "Qual é o seu endereço?"
msgstr "What's your address?"

#: data/calls/prank_07_garoto.tres
msgid "Rua dos Bobos, número zero!"
msgstr "Rua dos Bobos, number zero!"

#: data/calls/prank_08_rapaz.tres
msgid "Boa noite, é do Corpo de Bombeiros?"
msgstr "Good evening, is this the fire department?"

#: data/calls/prank_08_rapaz.tres
msgid "Não, aqui é a central telefônica. Precisa dos bombeiros?"
msgstr "No, this is the telephone exchange. Do you need the fire department?"

#: data/calls/prank_08_rapaz.tres
msgid "Preciso. Tem um bicho enorme em cima da caixa d'água."
msgstr "I do. There's a huge beast up on the water tank."

#: data/calls/prank_08_rapaz.tres
msgid "Ah não, pera... é a minha sogra."
msgstr "Oh no, wait... it's my mother-in-law."

#: data/calls/prank_09_menino.tres
msgid "Alô, central? Aqui é da companhia telefônica."
msgstr "Hello, operator? This is the telephone company."

#: data/calls/prank_09_menino.tres
msgid "Vamos testar a linha. O senhor pode assoviar?"
msgstr "We're testing the line. Could you whistle, sir?"

#: data/calls/prank_09_menino.tres
msgid "Isso não é um teste de verdade, é?"
msgstr "This isn't a real test, is it?"

#: data/calls/prank_09_menino.tres
msgid "Qual companhia?"
msgstr "What company?"

#: data/calls/prank_09_menino.tres
msgid "(tentando não rir) Assovia, por favor..."
msgstr "(trying not to laugh) Whistle, please..."

#: data/calls/prank_09_menino.tres
msgid "Tchau!"
msgstr "Bye!"

#: data/templates/transfer_01.tres
msgid "Me liga com {place}, por favor? {reason}"
msgstr "Can you put me through to {place}, please? {reason}"

#: data/templates/transfer_01.tres
msgid "Eu pedi {place}."
msgstr "I asked for {place}."

#: data/templates/transfer_02.tres
msgid "Pode me ligar {to_place}?"
msgstr "Can you connect me {to_place}?"

#: data/templates/transfer_02.tres data/templates/transfer_03.tres data/templates/transfer_07.tres
msgid "{reason}"
msgstr "{reason}"

#: data/templates/transfer_02.tres
msgid "{place}, por favor."
msgstr "{place}, please."

#: data/templates/transfer_03.tres
msgid "Queria falar com {place}."
msgstr "I'd like to talk to {place}."

#: data/templates/transfer_03.tres
msgid "Com {place}."
msgstr "{place}."

#: data/templates/transfer_04.tres
msgid "Me conecta com o {number}, por favor?"
msgstr "Can you connect me to {number}, please?"

#: data/templates/transfer_04.tres
msgid "É {of_place}. {reason}"
msgstr "It's the number {of_place}. {reason}"

#: data/templates/transfer_04.tres
msgid "{digits}."
msgstr "{digits}."

#: data/templates/transfer_05.tres
msgid "Alô, central?"
msgstr "Hello, operator?"

#: data/templates/transfer_05.tres
msgid "Me passa {to_place}? {reason}"
msgstr "Can you put me through {to_place}? {reason}"

#: data/templates/transfer_05.tres
msgid "Eu quero falar com {place}."
msgstr "I want to talk to {place}."

#: data/templates/transfer_06.tres
msgid "Boa noite. Desculpe a hora."
msgstr "Good evening. Sorry about the hour."

#: data/templates/transfer_06.tres
msgid "Preciso falar com {place}. {reason}"
msgstr "I need to talk to {place}. {reason}"

#: data/templates/transfer_06.tres
msgid "Com {place}, por favor."
msgstr "{place}, please."

#: data/templates/transfer_07.tres
msgid "Me liga com {place}, lá da {street}?"
msgstr "Can you put me through to {place}, over on {street}?"

#: data/templates/transfer_07.tres
msgid "{place}, da {street}."
msgstr "{place}, on {street}."

#: data/content.tres
msgid "Agradeço. Boa noite."
msgstr "I appreciate it. Good night."

#: data/content.tres
msgid "Ótimo. Boa noite."
msgstr "Great. Good night."

#: data/content.tres
msgid "Isso. Boa noite pro senhor."
msgstr "That's it. Good night to you, sir."

#: data/templates/emergency_incendio.tres
msgid "Central! Tá pegando fogo numa casa aqui na {street}! Já tá subindo pelo telhado!"
msgstr "Operator! A house is on fire here on {street}! It's already going up the roof!"

#: data/templates/emergency_incendio.tres data/templates/emergency_briga.tres
msgid "Alguém se machucou?"
msgstr "Is anyone hurt?"

#: data/templates/emergency_incendio.tres
msgid "{address}! Vem logo!"
msgstr "{address}! Come quick!"

#: data/templates/emergency_incendio.tres
msgid "Não, todo mundo saiu."
msgstr "No, everybody got out."

#: data/templates/emergency_incendio.tres
msgid "Não, foi só o susto."
msgstr "No, just a scare."

#: data/templates/emergency_incendio.tres
msgid "A dona da casa queimou as mãos tentando apagar!"
msgstr "The lady of the house burned her hands trying to put it out!"

#: data/templates/emergency_incendio.tres
msgid "Tá bom. A gente vai se afastar."
msgstr "Okay. We'll move back."

#: data/templates/emergency_incendio.tres
msgid "O fogo tá passando pra casa do vizinho!"
msgstr "The fire is spreading to the neighbor's house!"

#: data/templates/emergency_incendio.tres
msgid "A casa do vizinho tem gente?"
msgstr "Is anyone in the neighbor's house?"

#: data/templates/emergency_incendio.tres
msgid "Tem! O vizinho de idade mora sozinho lá!"
msgstr "Yes! The old man next door lives there alone!"

#: data/templates/emergency_incendio.tres
msgid "O vizinho de idade não saiu! Tá na janela pedindo ajuda!"
msgstr "The old man next door didn't get out! He's at the window calling for help!"

#: data/templates/emergency_incendio.tres
msgid "Ele consegue sair pela janela?"
msgstr "Can he get out through the window?"

#: data/templates/emergency_incendio.tres
msgid "Não! É alto demais e ele mal anda!"
msgstr "No! It's too high and he can barely walk!"

#: data/templates/emergency_incendio.tres
msgid "O telhado caiu... Vocês demoraram demais!"
msgstr "The roof came down... You took too long!"

#: data/templates/emergency_incendio.tres
msgid "Tiraram o vizinho pela escada dos fundos, mas ele respirou muita fumaça!"
msgstr "They got the neighbor out by the back stairs, but he breathed in a lot of smoke!"

#: data/templates/emergency_mal_subito.tres
msgid "Central, o meu vizinho desmaiou!"
msgstr "Operator, my neighbor passed out!"

#: data/templates/emergency_mal_subito.tres
msgid "Onde ele está?"
msgstr "Where is he?"

#: data/templates/emergency_mal_subito.tres
msgid "{address}. Vem rápido!"
msgstr "{address}. Come quick!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá, mas bem fraquinho."
msgstr "He is, but very faintly."

#: data/templates/emergency_mal_subito.tres
msgid "Caído aqui na calçada, na frente de casa."
msgstr "Lying here on the sidewalk, in front of my house."

#: data/templates/emergency_mal_subito.tres
msgid "Na cozinha da casa dele. E tá um cheiro forte de gás lá dentro!"
msgstr "In his kitchen. And there's a strong smell of gas in there!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá. Eu espero aqui na porta."
msgstr "Okay. I'll wait here at the door."

#: data/templates/emergency_mal_subito.tres
msgid "A respiração dele tá ficando mais fraca!"
msgstr "His breathing is getting weaker!"

#: data/templates/emergency_mal_subito.tres
msgid "Ele está acordado?"
msgstr "Is he awake?"

#: data/templates/emergency_mal_subito.tres
msgid "Não. Eu chamo e ele não responde."
msgstr "No. I call him and he doesn't answer."

#: data/templates/emergency_mal_subito.tres
msgid "Ele começou a tremer todo!"
msgstr "He started shaking all over!"

#: data/templates/emergency_mal_subito.tres
msgid "Ele bateu em alguma coisa?"
msgstr "Did he hit anything?"

#: data/templates/emergency_mal_subito.tres
msgid "Bateu a cabeça no chão, tá sangrando!"
msgstr "He hit his head on the floor, he's bleeding!"

#: data/templates/emergency_mal_subito.tres
msgid "Ele... parou de respirar. Vocês demoraram demais."
msgstr "He... stopped breathing. You took too long."

#: data/templates/emergency_mal_subito.tres
msgid "Ele não respira... um vizinho tá fazendo massagem no peito dele."
msgstr "He's not breathing... a neighbor is doing chest compressions."

#: data/templates/emergency_acidente.tres
msgid "Central, teve uma batida feia aqui na {street}!"
msgstr "Operator, there's been a bad crash here on {street}!"

#: data/templates/emergency_acidente.tres
msgid "Tem feridos?"
msgstr "Is anyone hurt?"

#: data/templates/emergency_acidente.tres
msgid "A rua está bloqueada?"
msgstr "Is the street blocked?"

#: data/templates/emergency_acidente.tres
msgid "{address}, na esquina!"
msgstr "{address}, on the corner!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz da moto. Tá no chão, mas mexe as pernas."
msgstr "The guy on the motorcycle. He's on the ground, but he can move his legs."

#: data/templates/emergency_acidente.tres
msgid "Tá. A moto e o carro tão no meio da rua."
msgstr "Yes. The bike and the car are in the middle of the street."

#: data/templates/emergency_acidente.tres
msgid "Ninguém se machucou, graças a Deus. Foi só o susto."
msgstr "Nobody got hurt, thank God. Just a scare."

#: data/templates/emergency_acidente.tres
msgid "O motorista do carro tá preso nas ferragens, com a perna sangrando!"
msgstr "The car's driver is trapped in the wreck, his leg is bleeding!"

#: data/templates/emergency_acidente.tres
msgid "Não, já empurraram tudo pra calçada."
msgstr "No, they already pushed everything onto the sidewalk."

#: data/templates/emergency_acidente.tres
msgid "Tá bom. Eu fico aqui esperando."
msgstr "Alright. I'll stay here and wait."

#: data/templates/emergency_acidente.tres
msgid "Tá juntando gente em volta, os carros não passam mais!"
msgstr "A crowd is gathering, cars can't get by anymore!"

#: data/templates/emergency_acidente.tres
msgid "Alguém está orientando o trânsito?"
msgstr "Is anyone directing traffic?"

#: data/templates/emergency_acidente.tres
msgid "Tá saindo fumaça do motor do carro!"
msgstr "Smoke is coming out of the car's engine!"

#: data/templates/emergency_acidente.tres
msgid "Tem gente perto do carro?"
msgstr "Are there people near the car?"

#: data/templates/emergency_acidente.tres
msgid "Tem! Tão tentando abrir o capô!"
msgstr "Yes! They're trying to open the hood!"

#: data/templates/emergency_acidente.tres
msgid "O carro pegou fogo! Por que demorou tanto?!"
msgstr "The car caught fire! Why did it take so long?!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz que abriu o capô queimou as mãos!"
msgstr "The guy who opened the hood burned his hands!"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Central, tem alguém tentando abrir a porta dos fundos."
msgstr "(quietly) Operator, someone's trying to open the back door."

#: data/templates/emergency_invasao.tres
msgid "Tem mais alguém em casa?"
msgstr "Is anyone else home?"

#: data/templates/emergency_invasao.tres
msgid "Você viu a pessoa?"
msgstr "Did you see the person?"

#: data/templates/emergency_invasao.tres
msgid "{address}. Rápido, por favor."
msgstr "{address}. Hurry, please."

#: data/templates/emergency_invasao.tres
msgid "Não, só eu."
msgstr "No, just me."

#: data/templates/emergency_invasao.tres
msgid "Só a sombra pela janela."
msgstr "Just a shadow through the window."

#: data/templates/emergency_invasao.tres
msgid "Tá. Não vou fazer barulho."
msgstr "Okay. I won't make a sound."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele conseguiu abrir... tá dentro de casa."
msgstr "(quietly) He got it open... he's inside the house."

#: data/templates/emergency_invasao.tres
msgid "Você está em um lugar seguro?"
msgstr "Are you somewhere safe?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) No quarto, debaixo da cama."
msgstr "(quietly) In the bedroom, under the bed."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele tá subindo a escada..."
msgstr "(quietly) He's coming up the stairs..."

#: data/templates/emergency_invasao.tres
msgid "Ele sabe que você está em casa?"
msgstr "Does he know you're home?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Acho que sim... ouvi ele chamar alguém."
msgstr "(quietly) I think so... I heard him call someone."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele levou tudo e foi embora. Ninguém veio."
msgstr "(crying) He took everything and left. Nobody came."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele me empurrou na escada quando foi embora... meu braço tá torto."
msgstr "(crying) He pushed me down the stairs when he left... my arm is twisted."

#: data/templates/emergency_briga.tres
msgid "Central, tem uma briga feia no meio da {street}!"
msgstr "Operator, there's a nasty fight in the middle of {street}!"

#: data/templates/emergency_briga.tres
msgid "Alguém está armado?"
msgstr "Is anyone armed?"

#: data/templates/emergency_briga.tres
msgid "{address}! Bem na frente de casa!"
msgstr "{address}! Right in front of my house!"

#: data/templates/emergency_briga.tres
msgid "Um tá com um pedaço de pau!"
msgstr "One's got a stick!"

#: data/templates/emergency_briga.tres
msgid "Ainda não, mas vai acabar mal!"
msgstr "Not yet, but this is going to end badly!"

#: data/templates/emergency_briga.tres
msgid "Um caiu e bateu a cabeça na guia! Tá sangrando!"
msgstr "One fell and hit his head on the curb! He's bleeding!"

#: data/templates/emergency_briga.tres
msgid "Tá. Vou entrar e trancar a porta."
msgstr "Okay. I'll go in and lock the door."

#: data/templates/emergency_briga.tres
msgid "Chegou mais gente! Agora são uns dez!"
msgstr "More people showed up! Now there's like ten of them!"

#: data/templates/emergency_briga.tres
msgid "Alguém está armado agora?"
msgstr "Is anyone armed now?"

#: data/templates/emergency_briga.tres
msgid "Apareceu um com uma faca!"
msgstr "One showed up with a knife!"

#: data/templates/emergency_briga.tres
msgid "Derrubaram um no chão e tão chutando! Ele não se mexe!"
msgstr "They knocked one down and they're kicking him! He's not moving!"

#: data/templates/emergency_briga.tres
msgid "Acho que sim... mas tá com o rosto todo machucado!"
msgstr "I think so... but his face is all beaten up!"

#: data/templates/emergency_briga.tres
msgid "Fugiram todos... e o rapaz continua no chão. Ninguém veio."
msgstr "They all ran off... and the guy is still on the ground. Nobody came."

#: data/templates/emergency_briga.tres
msgid "O rapaz continua no chão, sangrando muito pela cabeça!"
msgstr "The guy is still on the ground, bleeding badly from the head!"

#: data/content.tres
msgid "Central telefônica, pois não?"
msgstr "Telephone exchange, how can I help?"

#: data/content.tres
msgid "Central, boa noite. Em que posso ajudar?"
msgstr "Exchange, good evening. How can I help?"

#: data/content.tres
msgid "Central, pois não?"
msgstr "Exchange, how can I help?"

#: data/content.tres
msgid "Central."
msgstr "Exchange."

#: data/content.tres
msgid "Central telefônica, boa noite."
msgstr "Telephone exchange, good evening."

#: data/content.tres
msgid "Central de São Sotero, pois não?"
msgstr "São Sotero exchange, how can I help?"

#: data/content.tres
msgid "Desculpe ligar tão tarde."
msgstr "Sorry to call so late."

#: data/content.tres
msgid "Imagina, é pra isso que a central existe."
msgstr "Not at all, that's what the exchange is for."

#: data/content.tres
msgid "Ah, que bom. Eu fico sem jeito, sabe?"
msgstr "Oh, good. I always feel awkward, you know?"

#: data/content.tres
msgid "Tudo bem."
msgstr "That's fine."

#: data/content.tres
msgid "Ah... tá. Desculpe de novo."
msgstr "Oh... right. Sorry again."

#: data/content.tres
msgid "O senhor passa a noite inteira aí sozinho?"
msgstr "Do you spend the whole night there alone?"

#: data/content.tres
msgid "Eu e os cabos."
msgstr "Just me and the cords."

#: data/content.tres
msgid "Hehe, pelo menos eles não reclamam, né?"
msgstr "Heh, at least they don't complain, right?"

#: data/content.tres
msgid "Passo, sim."
msgstr "I do."

#: data/content.tres
msgid "Ah... tá. Não vou atrapalhar, então."
msgstr "Oh... right. I won't bother you, then."

#: data/content.tres
msgid "Minha mulher disse que não era pra incomodar a central a essa hora."
msgstr "My wife said not to bother the exchange at this hour."

#: data/content.tres
msgid "Não incomoda, não."
msgstr "You're no bother."

#: data/content.tres
msgid "Vou contar pra ela que o senhor disse isso."
msgstr "I'll tell her you said so."

#: data/content.tres
msgid "Ela tem razão."
msgstr "She's right."

#: data/content.tres
msgid "Ah... tá certo. Desculpe."
msgstr "Oh... fair enough. Sorry."

#: data/content.tres
msgid "Meu marido já dormiu, mas eu não consigo pegar no sono."
msgstr "My husband's already asleep, but I can't get to sleep."

#: data/content.tres
msgid "Um chá de camomila ajuda."
msgstr "Chamomile tea helps."

#: data/content.tres
msgid "Já tomei dois, moço. Nem fez cócegas."
msgstr "I've had two already. Didn't do a thing."

#: data/content.tres
msgid "Hum."
msgstr "Hm."

#: data/content.tres
msgid "Ah... tá. Eu espero aqui."
msgstr "Oh... right. I'll wait here."

#: data/content.tres
msgid "Faltou luz lá na Rua do Sol ontem, sabia?"
msgstr "The power went out on Rua do Sol last night, did you know?"

#: data/content.tres
msgid "Ouvi falar. Ficou muito tempo sem?"
msgstr "I heard. Was it out long?"

#: data/content.tres
msgid "A noite toda! A gente jantou à luz de vela."
msgstr "All night! We had dinner by candlelight."

#: data/content.tres
msgid "Sei."
msgstr "I see."

#: data/content.tres
msgid "Essa central nunca dorme, né?"
msgstr "This exchange never sleeps, does it?"

#: data/content.tres
msgid "Nunca. Alguém tem que ficar acordado."
msgstr "Never. Someone has to stay awake."

#: data/content.tres
msgid "Ainda bem, viu? A gente se sente mais seguro."
msgstr "Good thing, too. Makes us feel safer."

#: data/content.tres
msgid "Pois é."
msgstr "Yep."

#: data/content.tres
msgid "É... bom, eu espero."
msgstr "Yeah... well, I'll wait."

#: data/content.tres
msgid "Que frio, meu Deus."
msgstr "Lord, it's cold."

#: data/content.tres
msgid "Pega um casaco."
msgstr "Put on a coat."

#: data/content.tres
msgid "Já tô com dois, moço!"
msgstr "I've got two on already!"

#: data/content.tres
msgid "Aham."
msgstr "Mm-hm."

#: data/content.tres
msgid "...Bom, deixa pra lá."
msgstr "...Well, never mind."

#: data/content.tres
msgid "Amanhã é dia de feira, né?"
msgstr "Tomorrow's market day, isn't it?"

#: data/content.tres
msgid "É sim, amanhã cedo."
msgstr "It is, first thing tomorrow."

#: data/content.tres
msgid "Vou ver se ainda tem aquele queijo da serra."
msgstr "I'll see if they still have that mountain cheese."

#: data/content.tres
msgid "Não sei."
msgstr "Don't know."

#: data/content.tres
msgid "Ah... tá. Eu vejo amanhã, então."
msgstr "Oh... right. I'll find out tomorrow, then."

#: data/content.tres
msgid "Meu relógio adiantou de novo."
msgstr "My clock's running fast again."

#: data/content.tres
msgid "O meu atrasa."
msgstr "Mine runs slow."

#: data/content.tres
msgid "Hehe, então a gente se completa."
msgstr "Heh, then we make a good pair."

#: data/content.tres
msgid "Leva no relojoeiro."
msgstr "Take it to the watchmaker."

#: data/content.tres
msgid "Tá, tá. Vou levar."
msgstr "Yes, yes. I will."

#: data/content.tres
msgid "Desculpa, é que eu não consigo dormir."
msgstr "Sorry, I just can't sleep."

#: data/content.tres
msgid "Nem eu, e olha que é meu trabalho."
msgstr "Neither can I, and it's my job."

#: data/content.tres
msgid "Hehe, o senhor tem desculpa, eu não."
msgstr "Heh, you have an excuse, I don't."

#: data/content.tres
msgid "Entendi."
msgstr "I see."

#: data/content.tres
msgid "...Desculpa, tá? Eu espero."
msgstr "...Sorry, okay? I'll wait."

#: data/content.tres
msgid "Faz tempo que eu não ligo pra central."
msgstr "It's been a while since I called the exchange."

#: data/content.tres
msgid "Eu lembro da sua voz."
msgstr "I remember your voice."

#: data/content.tres
msgid "Lembra? Que memória, hein!"
msgstr "You do? What a memory!"

#: data/content.tres
msgid "Ah, é?"
msgstr "Oh, yeah?"

#: data/content.tres
msgid "É... faz tempo mesmo."
msgstr "Yeah... it's been a while."

#: data/content.tres
msgid "O padre mudou o horário da missa de domingo, viu?"
msgstr "The priest changed the time of Sunday mass, did you hear?"

#: data/content.tres
msgid "Pra que horas?"
msgstr "To what time?"

#: data/content.tres
msgid "Agora é às sete. Cedo demais pra mim."
msgstr "Seven now. Too early for me."

#: data/content.tres
msgid "Não vou à missa."
msgstr "I don't go to Mass."

#: data/content.tres
msgid "Ah... cada um com sua fé, né?"
msgstr "Oh... to each their own, right?"

#: data/content.tres
msgid "O ônibus da capital atrasou de novo hoje."
msgstr "The bus from the capital was late again today."

#: data/content.tres
msgid "De novo?"
msgstr "Again?"

#: data/content.tres
msgid "Duas horas! Minha irmã chegou morta de cansaço."
msgstr "Two hours! My sister got here dead tired."

#: data/content.tres
msgid "É sempre assim."
msgstr "It's always like that."

#: data/content.tres
msgid "É... pois é."
msgstr "Yeah... I guess so."

#: data/content.tres
msgid "Meu neto passou no vestibular, sabia?"
msgstr "My grandson got into university, did you know?"

#: data/content.tres
msgid "Que beleza! Parabéns!"
msgstr "Wonderful! Congratulations!"

#: data/content.tres
msgid "Ah, que orgulho! Vai ser o primeiro doutor da família."
msgstr "Oh, I'm so proud! He'll be the first doctor in the family."

#: data/content.tres
msgid "Hum, que bom."
msgstr "Hm, good."

#: data/content.tres
msgid "...É. Ele se esforçou, viu?"
msgstr "...Yes. He worked hard, you know."

#: data/content.tres
msgid "O preço do pão subiu de novo."
msgstr "The price of bread went up again."

#: data/content.tres
msgid "De novo? Não acredito."
msgstr "Again? I can't believe it."

#: data/content.tres
msgid "Vou ter que voltar a fazer pão em casa."
msgstr "I'll have to start baking bread at home again."

#: data/content.tres
msgid "Normal."
msgstr "That's normal."

#: data/content.tres
msgid "Normal pro senhor, né..."
msgstr "Normal for you, maybe..."

#: data/content.tres
msgid "Minha horta tá dando tomate que é uma beleza."
msgstr "My vegetable garden is giving lovely tomatoes."

#: data/content.tres
msgid "Qual é o segredo?"
msgstr "What's the secret?"

#: data/content.tres
msgid "Esterco e conversa. Planta gosta de prosa."
msgstr "Manure and conversation. Plants like a good chat."

#: data/content.tres
msgid "Ah, legal."
msgstr "Oh, nice."

#: data/content.tres
msgid "...É. Bom, deixa eu esperar aqui."
msgstr "...Yeah. Well, I'll wait here."

#: data/content.tres
msgid "Que chuva, hein? Não parou desde a tarde."
msgstr "Some rain, huh? It hasn't stopped since this afternoon."

#: data/content.tres
msgid "Daqui eu ouço no telhado."
msgstr "I can hear it on the roof here."

#: data/content.tres
msgid "Aqui pinga até na cozinha."
msgstr "Here it's dripping in the kitchen."

#: data/content.tres
msgid "É chuva."
msgstr "It's rain."

#: data/content.tres
msgid "...É, né."
msgstr "...Sure is."

#: data/content.tres
msgid "Ouvi dizer que o rio vai encher de novo."
msgstr "I heard the river's going to flood again."

#: data/content.tres
msgid "Tomara que não."
msgstr "Let's hope not."

#: data/content.tres
msgid "Da última vez a água chegou na praça."
msgstr "Last time the water reached the square."

#: data/content.tres
msgid "Boato."
msgstr "Just a rumor."

#: data/content.tres
msgid "Tomara que seja, moço."
msgstr "Hope you're right."

#: data/content.tres
msgid "O rio subiu bastante com essa chuva."
msgstr "The river's risen quite a bit with this rain."

#: data/content.tres
msgid "Cuidado por aí."
msgstr "Be careful out there."

#: data/content.tres
msgid "Pode deixar, moço. Aqui é alto."
msgstr "Don't worry. We're up high here."

#: data/content.tres
msgid "...Bom, aqui é alto, pelo menos."
msgstr "...Well, we're up high here, at least."

#: data/content.tres
msgid "Tá caindo um toró aqui, a rua virou rio."
msgstr "It's pouring here, the street's turned into a river."

#: data/content.tres
msgid "Não sai de casa, hein."
msgstr "Don't go out, now."

#: data/content.tres
msgid "Nem pensar, moço. Daqui não saio."
msgstr "Not a chance. I'm not leaving the house."

#: data/content.tres
msgid "Aqui também."
msgstr "Here too."

#: data/content.tres
msgid "Ah... tá."
msgstr "Oh... right."

#: data/content.tres
msgid "Com essa chuva ninguém sai de casa, né?"
msgstr "Nobody's leaving the house in this rain, are they?"

#: data/content.tres
msgid "Só quem precisa."
msgstr "Only those who have to."

#: data/content.tres
msgid "É, coitado de quem tá na estrada."
msgstr "Yes, pity anyone out on the road."

#: data/content.tres
msgid "Melhor assim."
msgstr "Better that way."

#: data/content.tres
msgid "É, noite de ficar debaixo das cobertas."
msgstr "Yes, a night for staying under the covers."

#: data/content.tres
msgid "Que neblina, hein? Não dá pra ver o outro lado da rua."
msgstr "Some fog, huh? You can't see across the street."

#: data/content.tres
msgid "Daqui também não vejo nada."
msgstr "I can't see a thing from here either."

#: data/content.tres
msgid "Parece algodão na janela."
msgstr "It's like cotton on the window."

#: data/content.tres
msgid "Fique em casa hoje."
msgstr "Stay home tonight."

#: data/content.tres
msgid "Pode deixar, não ponho o pé lá fora."
msgstr "Don't worry, I won't set foot outside."

#: data/content.tres
msgid "Com essa cerração, é melhor ninguém pegar a estrada."
msgstr "In fog this thick, nobody should be out on the road."

#: data/content.tres
msgid "Verdade, é perigoso."
msgstr "True, it's dangerous."

#: data/content.tres
msgid "Meu cunhado quase errou a entrada da cidade uma vez."
msgstr "My brother-in-law nearly missed the turn into town once."

#: data/content.tres
msgid "Tomara que ninguém precise."
msgstr "Hopefully nobody has to."

#: data/content.tres
msgid "Deus queira."
msgstr "God willing."

#: data/content.tres
msgid "Parece que a cidade sumiu na névoa hoje."
msgstr "Feels like the town vanished into the fog tonight."

#: data/content.tres
msgid "Amanhã ela volta."
msgstr "It'll be back tomorrow."

#: data/content.tres
msgid "Hehe, tomara. Com a padaria e tudo."
msgstr "Heh, I hope so. Bakery and all."

#: data/content.tres
msgid "Exagero."
msgstr "You're exaggerating."

#: data/content.tres
msgid "Hehe... é, talvez."
msgstr "Heh... maybe."

#: data/content.tres
msgid "Que noite bonita, hein? Dá pra ver todas as estrelas."
msgstr "Beautiful night, huh? You can see every star."

#: data/content.tres
msgid "Tá bonita mesmo."
msgstr "It really is lovely."

#: data/content.tres
msgid "Fiquei um tempão na varanda olhando."
msgstr "I spent ages on the porch looking up."

#: data/content.tres
msgid "Daqui eu só vejo a mesa."
msgstr "All I can see from here is the switchboard."

#: data/content.tres
msgid "Ah, coitado. Depois dá uma espiada na janela."
msgstr "Oh, you poor thing. Take a peek out the window later."

#: data/content.tres
msgid "Tá uma lua bonita hoje."
msgstr "There's a lovely moon tonight."

#: data/content.tres
msgid "Lua cheia?"
msgstr "Full moon?"

#: data/content.tres
msgid "Quase. Amanhã fica redondinha."
msgstr "Almost. Tomorrow it'll be perfectly round."

#: data/content.tres
msgid "Não reparei."
msgstr "Hadn't noticed."

#: data/content.tres
msgid "Ah... depois dá uma olhada."
msgstr "Oh... take a look later."

#: data/content.tres
msgid "Noite fresquinha, né? Até dá gosto de ficar na janela."
msgstr "Nice cool night, isn't it? Makes you want to sit by the window."

#: data/content.tres
msgid "Depois do calor de ontem..."
msgstr "After yesterday's heat..."

#: data/content.tres
msgid "Nem me fale, ontem não dava nem pra dormir."
msgstr "Tell me about it, I couldn't even sleep last night."

#: data/content.tres
msgid "Aproveite."
msgstr "Enjoy it."

#: data/content.tres
msgid "Tô aproveitando, com um cafezinho."
msgstr "I am, with a little coffee."

#: data/content.tres
msgid "Vai indo, moço."
msgstr "Getting by."

#: data/content.tres
msgid "Ah, vai bem, graças a Deus."
msgstr "Oh, it's going fine, thank God."

#: data/content.tres
msgid "Tranquila, tranquila."
msgstr "Quiet, quiet."

#: data/content.tres
msgid "Ih, devagar..."
msgstr "Oh, slow..."

#: data/content.tres
msgid "Vai indo, do jeito que dá."
msgstr "Getting by, as best I can."

#: data/content.tres
msgid "Ah, aqui tá tudo calmo."
msgstr "Oh, it's all calm here."

#: data/content.tres
msgid "Alô? Central?"
msgstr "Hello? Operator?"

#: data/content.tres
msgid "Ainda está aí?"
msgstr "Are you still there?"

#: data/content.tres
msgid "Alô? Conseguiu?"
msgstr "Hello? Any luck?"

#: data/content.tres
msgid "Moço? A ligação caiu?"
msgstr "Young man? Did the call drop?"

#: data/content.tres
msgid "Alô? Tô esperando..."
msgstr "Hello? I'm waiting..."

#: data/content.tres
msgid "Demora muito?"
msgstr "Is it going to take long?"

#: data/content.tres
msgid "Central? Tá me ouvindo?"
msgstr "Operator? Can you hear me?"

#: data/content.tres
msgid "Ainda tô aqui, viu?"
msgstr "I'm still here, you know."

#: data/content.tres
msgid "Alô? Caiu?"
msgstr "Hello? Did it drop?"

#: data/content.tres
msgid "Alô?! Vocês vão mandar alguém?"
msgstr "Hello?! Are you sending someone?"

#: data/content.tres
msgid "Por favor, rápido!"
msgstr "Please, hurry!"

#: data/content.tres
msgid "Central?!"
msgstr "Operator?!"

#: data/content.tres
msgid "Alô! Tá demorando!"
msgstr "Hello! It's taking too long!"

#: data/content.tres
msgid "Central, ainda tá aí?"
msgstr "Operator, are you still there?"

#: data/content.tres
msgid "Manda alguém, pelo amor de Deus!"
msgstr "Send someone, for God's sake!"

#: data/content.tres
msgid "Tá bom, eu espero."
msgstr "All right, I'll wait."

#: data/content.tres
msgid "Obrigado, aguardo."
msgstr "Thanks, I'll hold."

#: data/content.tres
msgid "Certo."
msgstr "Okay."

#: data/content.tres
msgid "Pode ser, eu fico na linha."
msgstr "Sure, I'll stay on the line."

#: data/content.tres
msgid "Tá, mas rapidinho, tá?"
msgstr "Okay, but make it quick, okay?"

#: data/content.tres
msgid "Tá, fico esperando."
msgstr "Okay, I'll be waiting."

#: data/content.tres
msgid "Sem pressa, moço."
msgstr "No rush, young man."

#: data/content.tres
msgid "Tá bem, obrigada."
msgstr "All right, thank you."

#: data/content.tres
msgid "Não, moço, não é aí."
msgstr "No, young man, that's not it."

#: data/content.tres
msgid "Hã? Não é com essa pessoa que eu quero falar."
msgstr "Huh? That's not who I want to talk to."

#: data/content.tres
msgid "Esse não é quem eu pedi!"
msgstr "That's not who I asked for!"

#: data/content.tres
msgid "Opa, acho que o senhor ligou errado."
msgstr "Oops, I think you put me through to the wrong place."

#: data/content.tres
msgid "Ih, quem atendeu não foi quem eu pedi."
msgstr "Uh-oh, whoever answered isn't who I asked for."

#: data/content.tres
msgid "Moço, essa voz eu não conheço."
msgstr "Young man, I don't know that voice."

#: data/content.tres
msgid "Não é esse número, não."
msgstr "That's not the right number."

#: data/content.tres
msgid "Moradora"
msgstr "Resident"

#: data/content.tres
msgid "Liguei agora há pouco e ninguém atendeu!"
msgstr "I called a little while ago and nobody answered!"

#: data/content.tres
msgid "Central? Até que enfim! Já liguei antes."
msgstr "Operator? Finally! I called earlier."

#: data/content.tres
msgid "Tô tentando faz tempo. Ninguém atende essa central?"
msgstr "I've been trying for ages. Doesn't anyone answer at this exchange?"

#: data/content.tres
msgid "O número que o senhor me deu não era o certo."
msgstr "The number you gave me wasn't the right one."

#: data/content.tres
msgid "Liguei pro número que o senhor passou e era de outra pessoa!"
msgstr "I called the number you gave me and it was someone else's!"

#: data/content.tres
msgid "Central, a informação que o senhor me deu tava errada."
msgstr "Operator, the information you gave me was wrong."

#: data/content.tres
msgid "Central, vocês me ligaram pro número errado! Agora me passa pro certo, por favor."
msgstr "Operator, you put me through to the wrong number! Now put me through to the right one, please."

#: data/content.tres
msgid "Liguei antes e fui parar no lugar errado! Vamos tentar de novo."
msgstr "I called before and ended up at the wrong place! Let's try again."

#: data/content.tres
msgid "Me conectaram com uma pessoa nada a ver! Quero o número certo desta vez."
msgstr "You connected me to some random person! I want the right number this time."

#: data/content.tres
msgid "Central! Ninguém apareceu aqui e tá ficando pior!"
msgstr "Operator! Nobody showed up here and it's getting worse!"

#: data/content.tres
msgid "Liguei mais cedo e ninguém veio! Tá piorando!"
msgstr "I called earlier and nobody came! It's getting worse!"

#: data/content.tres
msgid "Pelo amor de Deus, cadê o socorro? Piorou!"
msgstr "For God's sake, where's the help? It got worse!"

#: data/content.tres
msgid "Liguei mais cedo. Ninguém veio. Agora não adianta mais."
msgstr "I called earlier. Nobody came. It's no use now."

#: data/content.tres
msgid "Não precisa mandar mais ninguém. Já era."
msgstr "No need to send anyone now. It's over."

#: data/content.tres
msgid "Vocês demoraram demais. Eu só queria que soubessem."
msgstr "You took too long. I just wanted you to know."

#: data/content.tres
msgid "Alô? Quem é, a essa hora?"
msgstr "Hello? Who is this, at this hour?"

#: data/content.tres
msgid "Hã? Isso é hora de ligar pros outros?"
msgstr "Huh? Is this any time to call people?"

#: data/content.tres
msgid "Quem tá ligando? Aqui tá todo mundo dormindo!"
msgstr "Who's calling? Everyone here is asleep!"

#: data/content.tres
msgid "Alô?! Isso é hora?"
msgstr "Hello?! Do you know what time it is?"

#: data/content.tres
msgid "Quer saber? Esquece. Eu ligo amanhã."
msgstr "You know what? Forget it. I'll call tomorrow."

#: data/content.tres
msgid "Errou de novo? Deixa pra lá."
msgstr "Wrong again? Never mind."

#: data/content.tres
msgid "Não, chega. Boa noite."
msgstr "No, that's enough. Good night."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega a tempo."
msgstr "{occurrence} on {address}: help arrives in time."

#: data/content.tres
msgid "{occurrence} na {address}: equipe controla a situação."
msgstr "{occurrence} on {address}: crew gets the situation under control."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega com atraso."
msgstr "{occurrence} on {address}: help arrives late."

#: data/content.tres
msgid "{occurrence} na {address}: moradores reclamam da demora."
msgstr "{occurrence} on {address}: residents complain about the delay."

#: data/content.tres
msgid "{occurrence} na {address}: ninguém foi atender."
msgstr "{occurrence} on {address}: nobody came to help."

#: data/content.tres
msgid "{occurrence} na {address}: vizinhos esperaram a noite toda por socorro."
msgstr "{occurrence} on {address}: neighbors waited all night for help."

#: data/content.tres
msgid "Turno sem problemas. Bom trabalho."
msgstr "A shift without problems. Good work."

#: data/content.tres
msgid "Atenção aos detalhes. Os moradores contam com a central."
msgstr "Pay attention to details. The townspeople count on the exchange."

#: data/content.tres
msgid "Turno inaceitável. Isso vai para a sua ficha."
msgstr "Unacceptable shift. This is going on your record."

#: data/content.tres
msgid "Boa noite. Pode me dar o número %s?"
msgstr "Good evening. Could you give me the number %s?"

#: data/content.tres
msgid "Central, o senhor sabe o número %s?"
msgstr "Operator, do you know the number %s?"

#: data/content.tres
msgid "Queria só o número %s, pra anotar aqui."
msgstr "I just wanted the number %s, to write it down."

#: data/content.tres
msgid "Perdi a caderneta. Qual é o número %s?"
msgstr "I lost my address book. What's the number %s?"

#: data/content.tres
msgid "Central, me passa o número %s, por favor?"
msgstr "Operator, could you give me the number %s, please?"

#: data/content.tres
msgid "Boa noite. Qual é o telefone %s?"
msgstr "Good evening. What's the phone number %s?"

#: data/content.tres
msgid "O senhor tem aí o número %s?"
msgstr "Do you have the number %s there?"

#: data/content.tres
msgid "Anotado. Obrigada, boa noite."
msgstr "Got it. Thank you, good night."

#: data/content.tres
msgid "Ah, tá certo. Obrigado."
msgstr "Ah, right. Thank you."

#: data/content.tres
msgid "Muito obrigada. Boa noite."
msgstr "Thank you so much. Good night."

#: data/content.tres
msgid "Brigado, moço."
msgstr "Thanks, young man."

#: data/content.tres
msgid "Tá anotado. Boa noite."
msgstr "Written down. Good night."

#: data/content.tres
msgid "Hum. Tem certeza? Bom... obrigado."
msgstr "Hm. Are you sure? Well... thanks."

#: data/content.tres
msgid "Isso tudo? Tá bom, obrigado."
msgstr "That's all? Okay, thanks."

#: data/content.tres
msgid "Vou tentar esse então."
msgstr "I'll try that one, then."

#: data/content.tres
msgid "Será? Bom, vou tentar."
msgstr "Really? Well, I'll try."

#: data/content.tres
msgid "Hum... tá bom, então."
msgstr "Hm... okay, then."

