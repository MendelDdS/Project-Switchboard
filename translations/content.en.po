#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Me conecta com o 223, por favor?"
msgstr "Can you connect me to 223, please?"

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "É da minha comadre."
msgstr "It's my child's godmother."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Dois, dois, três. A Marta."
msgstr "Two, two, three. Marta."

#: data/calls/transfer_20_dona_tereza_marta_costa.tres
msgid "Marta Costa"
msgstr "Marta Costa"

#: data/calls/transfer_21_moca_lucia_pereira.tres data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Moça"
msgstr "Young woman"

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Oi. O número é 147."
msgstr "Hi. The number is 147."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Da Lúcia Pereira."
msgstr "Lúcia Pereira's."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Três, três, seis."
msgstr "Three, three, six."

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Lúcia Pereira"
msgstr "Lúcia Pereira"

#: data/calls/transfer_21_moca_lucia_pereira.tres
msgid "Obrigada!"
msgstr "Thank you!"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Seu Aníbal"
msgstr "Seu Aníbal"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Boa noite. Me liga com a Farmácia Central, a da praça?"
msgstr "Good evening. Can you put me through to the Farmácia Central, the one on the square?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "A Farmácia Central. Na Praça da Matriz."
msgstr "The Farmácia Central. On the Praça da Matriz."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Farmácia Central"
msgstr "Farmácia Central"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Obrigado, meu filho."
msgstr "Thank you, son."

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Ninguém atende. Quer que eu tente a Santa Rita, de plantão?"
msgstr "No one's answering. Shall I try the Santa Rita, the one on duty?"

#: data/calls/transfer_22_seu_anibal_farmacia_central.tres
msgid "Pode ser. A Santa Rita serve, obrigado."
msgstr "Sure. Santa Rita will do, thank you."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Dona Aurora"
msgstr "Dona Aurora"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Preciso falar com a igreja. A Matriz."
msgstr "I need to talk to the church. The Matriz."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "É pra pedir uma bênção... minha filha viaja amanhã cedo."
msgstr "It's to ask for a blessing... my daughter travels early tomorrow."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "A Igreja Matriz."
msgstr "The Igreja Matriz."

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Igreja Matriz"
msgstr "Igreja Matriz"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "A secretaria da igreja não atende. Quer que eu tente a casa do Padre Anselmo?"
msgstr "The church office isn't answering. Shall I try Father Anselmo's house?"

#: data/calls/transfer_23_dona_aurora_igreja_matriz.tres
msgid "Isso, na casa do padre. Obrigada."
msgstr "Yes, the priest's house. Thank you."

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "Seu Benedito"
msgstr "Seu Benedito"

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "Central, é o Benedito."
msgstr "Operator, it's Benedito."

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "Me liga com o Ivo Teixeira? Ele ficou de me devolver a escada."
msgstr "Can you put me through to Ivo Teixeira? He was supposed to give me back my ladder."

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "O Ivo. Ivo Teixeira, da Rua das Flores."
msgstr "Ivo. Ivo Teixeira, on Rua das Flores."

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "Ivo Teixeira"
msgstr "Ivo Teixeira"

#: data/calls/transfer_24_seu_benedito_ivo_teixeira.tres
msgid "Obrigado. Agora ele não escapa."
msgstr "Thanks. Now he can't get away."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres data/content.tres
msgid "Seu Jair"
msgstr "Seu Jair"

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "A Mercearia Silva ainda atende? O Silva mora nos fundos. Acabou a vela aqui em casa."
msgstr "Is the Mercearia Silva still answering? Silva lives in the back. We're out of candles at home."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "A Mercearia Silva, na Rua do Cruzeiro."
msgstr "The Mercearia Silva, on Rua do Cruzeiro."

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Mercearia Silva"
msgstr "Mercearia Silva"

#: data/calls/transfer_25_seu_jair_mercearia_silva.tres
msgid "Obrigado. Tá um breu aqui."
msgstr "Thanks. It's pitch black in here."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Dona Fátima"
msgstr "Dona Fátima"

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Minha filha chegou no ônibus das dez e foi pro Hotel Estrela. Quero saber se ela chegou bem."
msgstr "My daughter came in on the ten o'clock bus and went to the Hotel Estrela. I want to know if she got there safe."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "O Hotel Estrela, na avenida."
msgstr "The Hotel Estrela, on the avenue."

#: data/calls/transfer_26_dona_fatima_hotel_estrela.tres
msgid "Ai, obrigada. Mãe não dorme, né?"
msgstr "Oh, thank you. Mothers never sleep, do they?"

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "Preciso de um carro de praça. O último ônibus sai às onze e eu não posso perder."
msgstr "I need a cab. The last bus leaves at eleven and I can't miss it."

#: data/calls/transfer_27_moca_taxi_ponto_da_rodoviaria.tres
msgid "O ponto de táxi da rodoviária."
msgstr "The taxi stand at the bus station."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres data/content.tres
msgid "Dona Olga"
msgstr "Dona Olga"

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Boa noite, meu filho."
msgstr "Good evening, son."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "Me liga com a rádio? Quero mandar um recado pro meu filho que trabalha na roça. Ele escuta o programa da noite."
msgstr "Can you put me through to the radio station? I want to send a message to my son, who works out on the farm. He listens to the night program."

#: data/calls/transfer_28_dona_olga_radio_serena_am.tres
msgid "A Rádio Serena."
msgstr "Rádio Serena."

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "Esqueci meu guarda-chuva na sessão das oito. Será que ainda tem alguém no cinema?"
msgstr "I left my umbrella at the eight o'clock show. Is there still anyone at the cinema?"

#: data/calls/transfer_29_rapaz_cine_odeon.tres
msgid "O Cine Odeon."
msgstr "The Cine Odeon."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Dona Elza"
msgstr "Dona Elza"

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Preciso falar com o Doutor Almeida."
msgstr "I need to talk to Doctor Almeida."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O médico. A pressão do meu marido subiu e ele mandou ligar se isso acontecesse."
msgstr "The physician. My husband's blood pressure went up and he told us to call if that happened."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "O Doutor Almeida, o médico."
msgstr "Doctor Almeida, the physician."

#: data/calls/transfer_30_dona_elza_dr_augusto_almeida.tres
msgid "Obrigada. Rápido, viu?"
msgstr "Thank you. Hurry, okay?"

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Boa noite. A Dona Célia Rocha, por favor."
msgstr "Good evening. Dona Célia Rocha, please."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "A que mora perto da escola."
msgstr "The one who lives near the school."

#: data/calls/transfer_31_seu_ernesto_celia_rocha_rua_do_sol.tres
msgid "Célia Rocha. A casa dela é perto da escola."
msgstr "Célia Rocha. Her house is near the school."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Seu Lauro"
msgstr "Seu Lauro"

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Me liga com o seu Ferreira."
msgstr "Put me through to Seu Ferreira."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O do armazém. Deixei minha carteira no balcão hoje de tarde."
msgstr "The one from the general store. I left my wallet on the counter this afternoon."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "O Ferreira do armazém. O Joaquim."
msgstr "Ferreira from the general store. Joaquim."

#: data/calls/transfer_32_seu_lauro_armazem_ferreira.tres
msgid "Obrigado, moço. Tomara que ele atenda."
msgstr "Thanks, young man. I hope he picks up."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Me liga com o seu Paulo Nogueira? Ele disse que eu podia ligar a qualquer hora."
msgstr "Can you put me through to Seu Paulo Nogueira? He said I could call at any hour."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira."
msgstr "Paulo Nogueira."

#: data/calls/transfer_33_rapaz_paulo_nogueira.tres
msgid "Paulo Nogueira"
msgstr "Paulo Nogueira"

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Dona Iolanda"
msgstr "Dona Iolanda"

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Quero falar com a Dona Rosa Lima. É a irmã dela, da capital."
msgstr "I want to talk to Dona Rosa Lima. It's her sister, from the capital."

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Rosa Lima, das Acácias."
msgstr "Rosa Lima, on Acácias."

#: data/calls/transfer_34_dona_iolanda_rosa_lima.tres
msgid "Rosa Lima"
msgstr "Rosa Lima"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres data/content.tres
msgid "Seu Valdir"
msgstr "Seu Valdir"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "O 237, por favor."
msgstr "237, please."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Da Sônia."
msgstr "Sônia's."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Três, oito, quatro."
msgstr "Three, eight, four."

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Sônia Vieira"
msgstr "Sônia Vieira"

#: data/calls/transfer_35_seu_valdir_sonia_vieira.tres
msgid "Brigado."
msgstr "Thanks."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "O Alberto Ramos, da Avenida Brasil. Somos sócios."
msgstr "Alberto Ramos, on Avenida Brasil. We're partners."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos."
msgstr "Alberto Ramos."

#: data/calls/transfer_36_senhor_alberto_ramos.tres
msgid "Alberto Ramos"
msgstr "Alberto Ramos"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Vizinha"
msgstr "Neighbor"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Central, me liga com o seu Benedito Souza?"
msgstr "Operator, can you put me through to Seu Benedito Souza?"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Sou vizinha dele. A luz da casa tá acesa e ele não atende a porta."
msgstr "I'm his neighbor. His lights are on and he won't answer the door."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "O seu Benedito Souza, da Rua do Sol."
msgstr "Seu Benedito Souza, on Rua do Sol."

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Benedito Souza"
msgstr "Benedito Souza"

#: data/calls/transfer_37_vizinha_benedito_souza.tres
msgid "Obrigada. Deve estar dormindo, né?"
msgstr "Thank you. He must be asleep, right?"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Dona Benta"
msgstr "Dona Benta"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Boa noite, moço."
msgstr "Good evening, young man."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Me liga com a Pensão Dona Cota? Meu filho chegou de viagem e ficou lá."
msgstr "Could you put me through to the Pensão Dona Cota? My son got back from a trip and is staying there."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "A pensão da Dona Cota, na Rua da Estação."
msgstr "Dona Cota's boarding house, on Rua da Estação."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Pensão Dona Cota"
msgstr "Pensão Dona Cota"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Obrigada, meu filho. Boa noite."
msgstr "Thank you, son. Good night."

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "A pensão não atende. Quer que eu tente o Hotel Estrela?"
msgstr "The boarding house isn't answering. Shall I try the Hotel Estrela?"

#: data/calls/transfer_38_dona_benta_pensao_dona_cota.tres
msgid "Tenta, sim. Vai ver ele foi pra lá."
msgstr "Yes, try it. Maybe he went there instead."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Caixeiro-viajante"
msgstr "Travelling salesman"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Boa noite. Estou na rodoviária e perdi o último ônibus."
msgstr "Good evening. I'm at the bus station and missed the last bus."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Me liga com o Hotel Estrela? Preciso de um quarto pra hoje."
msgstr "Could you put me through to the Hotel Estrela? I need a room for tonight."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Muito obrigado. O senhor me salvou a noite."
msgstr "Thank you so much. You've saved my night."

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "O hotel não atende. Quer que eu tente a Pensão Dona Cota?"
msgstr "The hotel isn't answering. Shall I try the Pensão Dona Cota?"

#: data/calls/transfer_39_caixeiro_hotel_estrela.tres
msgid "Pode ser. Uma cama já está bom."
msgstr "Sure. A bed is all I need."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Motorista de caminhão"
msgstr "Truck driver"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Central, boa noite. Furou o pneu do caminhão aqui na entrada da cidade."
msgstr "Central, good evening. My truck got a flat at the edge of town."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Me liga com a Borracharia do Neno?"
msgstr "Could you put me through to the Borracharia do Neno?"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "A borracharia do Neno. Do pneu."
msgstr "Neno's tyre shop. For the tyre."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Borracharia do Neno"
msgstr "Borracharia do Neno"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Valeu, central. Deus te ajude."
msgstr "Thanks, central. God bless."

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "A borracharia não atende. Quer que eu tente a Oficina do Tião?"
msgstr "The tyre shop isn't answering. Shall I try the Oficina do Tião?"

#: data/calls/transfer_40_motorista_borracharia_do_neno.tres
msgid "Tenta. O Tião também conserta pneu."
msgstr "Try it. Tião fixes tyres too."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Ô, central. Me liga com o Bilhar do Tonho?"
msgstr "Hey, central. Put me through to the Bilhar do Tonho?"

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Esqueci meu chapéu lá e minha mãe vai brigar comigo."
msgstr "I left my hat there and my mother's going to give me an earful."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "O bilhar do Tonho, na Rua do Comércio."
msgstr "Tonho's pool hall, on Rua do Comércio."

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Bilhar do Tonho"
msgstr "Bilhar do Tonho"

#: data/calls/transfer_41_rapaz_bilhar_do_tonho.tres
msgid "Valeu! O senhor é dos bons."
msgstr "Thanks! You're one of the good ones."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Dona Zefa"
msgstr "Dona Zefa"

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Boa noite. A farmácia Santa Rita, por favor."
msgstr "Good evening. The Santa Rita pharmacy, please."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Meu marido está com uma dor de dente que não deixa ninguém dormir."
msgstr "My husband has a toothache that won't let anyone sleep."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "A Santa Rita, na Rua do Mercado."
msgstr "The Santa Rita, on Rua do Mercado."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Ai, obrigada. Agora a casa dorme."
msgstr "Oh, thank you. Now the house can sleep."

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "A Santa Rita não atende. Quer que eu tente a Farmácia Central, da praça?"
msgstr "The Santa Rita isn't answering. Shall I try the Farmácia Central, on the square?"

#: data/calls/transfer_42_dona_zefa_farmacia_santa_rita.tres
msgid "Qualquer uma, moço. Contanto que tenha remédio."
msgstr "Any of them, young man. As long as they have medicine."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Noivo"
msgstr "Groom"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Boa noite. Desculpe ligar tarde."
msgstr "Good evening. Sorry to call so late."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Preciso falar com o padre Anselmo, na Casa Paroquial. É sobre o meu casamento no sábado."
msgstr "I need to speak with Father Anselmo, at the Casa Paroquial. It's about my wedding on Saturday."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "A Casa Paroquial. O padre Anselmo."
msgstr "The Casa Paroquial. Father Anselmo."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Obrigado. Reza por mim, que eu tô nervoso."
msgstr "Thank you. Say a prayer for me, I'm nervous."

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "A Casa Paroquial não atende. Quer que eu tente a secretaria da Igreja Matriz?"
msgstr "The Casa Paroquial isn't answering. Shall I try the office at the Igreja Matriz?"

#: data/calls/transfer_43_noivo_casa_paroquial.tres
msgid "Pode ser. Alguém lá deve dar o recado."
msgstr "Sure. Someone there can pass on the message."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Dona Glorinha"
msgstr "Dona Glorinha"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Boa noite. Me liga com a Padaria Pão Dourado?"
msgstr "Good evening. Could you put me through to the Padaria Pão Dourado?"

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Quero encomendar o bolo do aniversário da minha neta."
msgstr "I want to order my granddaughter's birthday cake."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "A padaria Pão Dourado, na Rua das Acácias."
msgstr "The Pão Dourado bakery, on Rua das Acácias."

#: data/calls/transfer_44_dona_glorinha_padaria_pao_dourado.tres
msgid "Obrigada, querido. Vou pedir um de coco."
msgstr "Thank you, dear. I'll ask for a coconut one."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Correspondente"
msgstr "Correspondent"

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Central, aqui é o correspondente da Gazeta na estrada."
msgstr "Central, this is the Gazeta's correspondent out on the road."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Me liga com a redação, rápido. O jornal fecha daqui a pouco."
msgstr "Put me through to the newsroom, quick. The paper goes to press soon."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "A Gazeta de São Sotero. A redação."
msgstr "The Gazeta de São Sotero. The newsroom."

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Gazeta de São Sotero"
msgstr "Gazeta de São Sotero"

#: data/calls/transfer_45_reporter_gazeta.tres
msgid "Obrigado. Amanhã o senhor lê no jornal."
msgstr "Thanks. You'll read it in the paper tomorrow."

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Afilhado"
msgstr "Godson"

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Boa noite. Queria falar com o meu padrinho, o seu Geraldo."
msgstr "Good evening. I'd like to speak to my godfather, Seu Geraldo."

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Geraldo Martins. Ele mora na Rua da Matriz."
msgstr "Geraldo Martins. He lives on Rua da Matriz."

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Geraldo Martins, da Rua da Matriz."
msgstr "Geraldo Martins, on Rua da Matriz."

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Geraldo Martins"
msgstr "Geraldo Martins"

#: data/calls/transfer_46_afilhado_geraldo_martins.tres
msgid "Obrigado, moço. Ele vai gostar da notícia."
msgstr "Thank you. He'll be glad to hear the news."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Veterinário"
msgstr "Vet"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Central, boa noite. Me liga com o Sítio Boa Esperança?"
msgstr "Central, good evening. Could you put me through to the Sítio Boa Esperança?"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Me chamaram por causa de uma vaca pra parir. Quero saber se ainda precisa."
msgstr "They called me about a cow in labour. I want to know if they still need me."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "O Sítio Boa Esperança, lá no Cruzeiro."
msgstr "The Sítio Boa Esperança, up on Cruzeiro."

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Sítio Boa Esperança"
msgstr "Sítio Boa Esperança"

#: data/calls/transfer_47_veterinario_sitio_boa_esperanca.tres
msgid "Obrigado. Vou ligando a caminhonete."
msgstr "Thanks. I'll get the pickup started."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Dona Mirtes"
msgstr "Dona Mirtes"

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Boa noite. A Dona Laudelina, por favor."
msgstr "Good evening. Dona Laudelina, please."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado. Ela me emprestou a forma de pudim e eu quero devolver amanhã cedo."
msgstr "Laudelina Prado. She lent me her pudding tin and I want to return it early tomorrow."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado. Da Bela Vista."
msgstr "Laudelina Prado. On Bela Vista."

#: data/calls/transfer_48_dona_mirtes_laudelina_prado.tres
msgid "Laudelina Prado"
msgstr "Laudelina Prado"

#: data/calls/transfer_49_menino_mercearia_silva.tres data/calls/prank_05_menino.tres data/calls/prank_09_menino.tres
msgid "Menino"
msgstr "Kid"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Alô? Moço, minha mãe mandou ligar pra Mercearia Silva."
msgstr "Hello? Sir, my mum told me to call the Mercearia Silva."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "É pra ver se ainda tem leite. Ela tá aqui do lado."
msgstr "To see if they've still got milk. She's right here next to me."

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "A mercearia do seu Silva!"
msgstr "Seu Silva's grocery!"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "Brigado, moço!"
msgstr "Thanks, mister!"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "A mercearia não atende. Quer que eu tente o Armazém Ferreira?"
msgstr "The grocery isn't answering. Shall I try the Armazém Ferreira?"

#: data/calls/transfer_49_menino_mercearia_silva.tres
msgid "(cochichando) Mãe, pode ser o Ferreira? ... Ela disse que pode!"
msgstr "(whispering) Mum, is Ferreira's OK? ... She says yes!"

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Boa noite. O Almeida, por favor."
msgstr "Good evening. Almeida, please."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Não o doutor, não. O Otávio, da Rua da Estação."
msgstr "Not the doctor, no. Otávio, on Rua da Estação."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Otávio Almeida. O da Estação."
msgstr "Otávio Almeida. The one on Estação."

#: data/calls/transfer_50_senhora_otavio_almeida.tres
msgid "Esse mesmo. Obrigada."
msgstr "That's the one. Thank you."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Mulher"
msgstr "Woman"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Central! Houve um acidente na Rua das Acácias! Precisamos de ajuda!"
msgstr "Operator! There's been an accident on Rua das Acácias! We need help!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Qual é o endereço exato?"
msgstr "What's the exact address?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O que aconteceu?"
msgstr "What happened?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Quantas pessoas estão feridas?"
msgstr "How many people are hurt?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "É perto do número 101! Na frente do posto!"
msgstr "Near number 101! In front of the gas station!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste e ficou atravessado na rua!"
msgstr "A car hit a pole and ended up sideways across the street!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Duas pessoas. Uma não está se mexendo!"
msgstr "Two people. One isn't moving!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Ninguém, graças a Deus. Mas o carro tá bloqueando tudo."
msgstr "Nobody, thank God. But the car is blocking everything."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O motorista tá preso nas ferragens! Não consegue abrir a porta!"
msgstr "The driver is trapped in the wreck! He can't open the door!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Um carro bateu no poste. Parou em cima da calçada."
msgstr "A car hit the pole. It stopped up on the sidewalk."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Estão vindo? Graças a Deus... obrigada."
msgstr "They're coming? Thank God... thank you."

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá juntando gente em volta, os carros não conseguem mais passar!"
msgstr "A crowd is gathering, the cars can't get through anymore!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "As pessoas estão longe do carro?"
msgstr "Are people staying away from the car?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Não! Tá todo mundo em volta, querendo ajudar!"
msgstr "No! Everyone's crowded around, trying to help!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tá vazando gasolina e começou a sair fumaça do capô!"
msgstr "Gas is leaking and smoke is starting to come out of the hood!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem alguém perto da gasolina?"
msgstr "Is anyone near the gas?"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Tem um rapaz tentando empurrar o carro! Eu falei pra ele sair!"
msgstr "A guy is trying to push the car! I told him to get away!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "Pegou fogo! O carro pegou fogo! Por que demorou tanto?!"
msgstr "It caught fire! The car caught fire! Why did it take so long?!"

#: data/calls/emergency_01_acidente_de_transito_rua_das_acacias_101.tres
msgid "O rapaz que empurrava o carro se queimou! Tá gritando de dor!"
msgstr "The guy pushing the car got burned! He's screaming in pain!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Central, tem fogo! Tem fogo no galpão da Rua do Moinho!"
msgstr "Operator, there's a fire! There's a fire in the shed on Rua do Moinho!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Qual é o número?"
msgstr "What's the number?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O que está queimando?"
msgstr "What's burning?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tem alguém lá dentro?"
msgstr "Is anyone inside?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Quarenta! O galpão da serraria velha!"
msgstr "Forty! The old sawmill shed!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado inteiro! A fumaça está preta!"
msgstr "The whole roof! The smoke is black!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não. A serraria fecha às seis, tá vazia."
msgstr "No. The sawmill closes at six, it's empty."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante não conseguiu sair! Tá gritando lá dentro!"
msgstr "The night watchman couldn't get out! He's screaming in there!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vigilante saiu, mas tá com o rosto queimado!"
msgstr "The night watchman got out, but his face is burned!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá bom. Tá bom. Eu vou tirar o carro daqui."
msgstr "Okay. Okay. I'm moving the car out of here."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "A fumaça tá tomando a rua toda, os carros tão parando no meio!"
msgstr "The smoke is covering the whole street, cars are stopping in the middle!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Os carros conseguem passar?"
msgstr "Can cars get through?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Não, parou tudo nos dois sentidos. Ninguém enxerga nada."
msgstr "No, everything's stopped both ways. Nobody can see a thing."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Um vizinho tentou ajudar e caiu! Tá desacordado na fumaça!"
msgstr "A neighbor tried to help and collapsed! He's out cold in the smoke!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O vizinho está respirando?"
msgstr "Is the neighbor breathing?"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Tá, mas tá tossindo muito e não levanta!"
msgstr "Yes, but he's coughing a lot and can't get up!"

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "O telhado caiu! Caiu tudo! Ninguém veio..."
msgstr "The roof came down! Everything came down! Nobody came..."

#: data/calls/emergency_02_incendio_rua_do_moinho_40.tres
msgid "Arrastaram o vizinho pra fora, mas ele tá muito mal!"
msgstr "They dragged the neighbor out, but he's in really bad shape!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Central, meu pai caiu no banheiro e não acorda!"
msgstr "Operator, my father fell in the bathroom and won't wake up!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Qual é o endereço?"
msgstr "What's the address?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Ele está respirando?"
msgstr "Is he breathing?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tem mais alguém ferido?"
msgstr "Is anyone else hurt?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Rua do Sol, 230! A casa amarela!"
msgstr "Rua do Sol, 230! The yellow house!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Está... mas não responde. Bateu a cabeça."
msgstr "He is... but he won't respond. He hit his head."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Não, só ele. Por favor, rápido!"
msgstr "No, just him. Please, hurry!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Tá, ouço ele respirando. Mas a porta tá trancada por dentro e ele caiu encostado nela!"
msgstr "Yes, I can hear him breathing. But the door is locked from inside and he fell against it!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Obrigada. Eu vou deixar a porta aberta."
msgstr "Thank you. I'll leave the door open."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele tá ficando roxo... a respiração tá cada vez mais fraca!"
msgstr "He's turning blue... his breathing keeps getting weaker!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele está consciente?"
msgstr "Is he conscious?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não! Eu chamo e ele não abre o olho!"
msgstr "No! I call him and he won't open his eyes!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não responde mais nada! Não sei se tá respirando!"
msgstr "He's not responding at all! I don't know if he's breathing!"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Dá pra ver se o peito dele mexe?"
msgstr "Can you see if his chest is moving?"

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Não sei... acho que não. Meu Deus..."
msgstr "I don't know... I don't think so. My God..."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele... ele não tá mais respirando. Vocês demoraram demais."
msgstr "He... he's not breathing anymore. You took too long."

#: data/calls/emergency_03_mal_subito_rua_do_sol_230.tres
msgid "Ele não respira... Eu tô tentando, mas ele não acorda."
msgstr "He's not breathing... I'm trying, but he won't wake up."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Homem (sussurrando)"
msgstr "Man (whispering)"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Central... tem alguém tentando arrombar a casa do vizinho."
msgstr "Operator... someone's trying to break into my neighbor's house."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "O que você está vendo?"
msgstr "What do you see?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Quantas pessoas?"
msgstr "How many people?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Avenida Brasil, 150. A casa do lado da minha."
msgstr "Avenida Brasil, 150. The house next to mine."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Forçando a janela dos fundos. O vizinho viajou."
msgstr "Forcing the back window. My neighbor's away."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Dois homens. Não vi arma, não."
msgstr "Two men. I didn't see a gun."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "O vizinho chegou bem na hora e levou uma pancada na cabeça! Tá caído no quintal!"
msgstr "The neighbor came home right then and got hit on the head! He's lying in the yard!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tá. Vou ficar quieto aqui dentro."
msgstr "Okay. I'll keep quiet in here."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles entraram! Tão carregando as coisas pra rua!"
msgstr "They got in! They're carrying things out to the street!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Eles estão armados?"
msgstr "Are they armed?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Um deles tá com uma barra de ferro na mão."
msgstr "One of them has an iron bar in his hand."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles me viram na janela! Um deles tá vindo pra cá com um pé de cabra!"
msgstr "They saw me at the window! One of them is coming over here with a crowbar!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Você consegue se trancar?"
msgstr "Can you lock yourself in?"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Tô trancando a porta agora... ele tá batendo!"
msgstr "I'm locking the door now... he's banging on it!"

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eles fugiram de carro. Levaram tudo... e ninguém apareceu."
msgstr "They drove off. They took everything... and nobody showed up."

#: data/calls/emergency_04_invasao_roubo_avenida_brasil_150.tres
msgid "Eu tô bem... mas o seu Jorge, da casa da frente, levou uma pancada quando veio ver."
msgstr "I'm fine... but Seu Jorge, from across the street, got hit when he came to look."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Homem nervoso"
msgstr "Nervous man"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Central! Tão brigando aqui no Bar do Zé! Um puxou uma faca!"
msgstr "Operator! There's a fight here at the Bar do Zé! One pulled a knife!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_18_invasao_rua_do_mercado_90.tres data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Alguém está ferido?"
msgstr "Is anyone hurt?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Quantas pessoas estão brigando?"
msgstr "How many people are fighting?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Rua da Estação, 140! O bar do Zé!"
msgstr "Rua da Estação, 140! Zé's bar!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá sangrando no braço! Rápido!"
msgstr "One's bleeding from the arm! Hurry!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Dois! Mas o bar tá cheio!"
msgstr "Two! But the bar is packed!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Ainda não! O Zé tá tentando separar!"
msgstr "Not yet! Zé is trying to break it up!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tão vindo? Tá, eu seguro o pessoal aqui."
msgstr "They're coming? Okay, I'll keep everyone back."

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Agora tão quebrando as cadeiras! Tá todo mundo brigando!"
msgstr "Now they're breaking chairs! Everybody's fighting!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Tem mais alguém armado?"
msgstr "Is anyone else armed?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Um tá com uma garrafa quebrada!"
msgstr "One's got a broken bottle!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Furaram um rapaz na barriga! Tá sangrando muito!"
msgstr "They stabbed a guy in the stomach! He's bleeding a lot!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Onde ele foi ferido?"
msgstr "Where was he hurt?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "Na barriga! Tão apertando com um pano, mas não para de sangrar!"
msgstr "In the stomach! They're pressing a cloth on it, but it won't stop bleeding!"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz desmaiou... tem sangue pra todo lado. Por que ninguém veio?"
msgstr "The guy passed out... there's blood everywhere. Why didn't anyone come?"

#: data/calls/emergency_05_outro_rua_da_estacao_140.tres
msgid "O rapaz da facada desmaiou, e o Zé levou uma garrafada tentando separar!"
msgstr "The guy who got stabbed passed out, and Zé got hit with a bottle trying to break it up!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Central, caiu um fio do poste aqui na frente e está soltando faísca!"
msgstr "Operator, a wire fell off the pole out front and it's sparking!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém encostou no fio?"
msgstr "Did anyone touch the wire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tem fogo?"
msgstr "Is there a fire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Rua do Comércio, 71! Na frente da barbearia!"
msgstr "Rua do Comércio, 71! In front of the barbershop!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, não! Tá todo mundo longe."
msgstr "No, no! Everyone's keeping away."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá começando a queimar a árvore!"
msgstr "The tree's starting to burn!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O menino da padaria encostou! Tá caído e não se mexe!"
msgstr "The boy from the bakery touched it! He's down and not moving!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá bom. Vou manter as crianças dentro de casa."
msgstr "Okay. I'll keep the kids inside."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tá todo mundo parando pra olhar, a rua tá trancada de carro!"
msgstr "Everybody's stopping to look, the street is jammed with cars!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Alguém está perto do fio?"
msgstr "Is anyone near the wire?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não, mas os carros tão passando por cima dele devagar!"
msgstr "No, but cars are slowly driving over it!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O fogo passou pro telhado da barbearia! O barbeiro mora em cima e não consegue descer!"
msgstr "The fire spread to the barbershop roof! The barber lives upstairs and can't get down!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "O barbeiro está ferido?"
msgstr "Is the barber hurt?"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Não sei! Ele tá na janela de cima, gritando por ajuda!"
msgstr "I don't know! He's at the upstairs window, shouting for help!"

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "A barbearia tá toda em chamas... e ninguém veio."
msgstr "The barbershop is all in flames... and nobody came."

#: data/calls/emergency_06_outro_rua_do_comercio_71.tres
msgid "Tiraram o barbeiro pela janela... ele tá com as costas queimadas!"
msgstr "They got the barber out the window... his back is burned!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Central! Tá saindo fumaça da casa do vizinho!"
msgstr "Operator! There's smoke coming out of my neighbor's house!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres data/templates/emergency_incendio.tres
msgid "Tem alguém dentro da casa?"
msgstr "Is anyone in the house?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Dá para ver o fogo?"
msgstr "Can you see the fire?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Rua das Flores, 45! Perto do Hotel Estrela!"
msgstr "Rua das Flores, 45! Near the Hotel Estrela!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ele saiu, mas queimou o braço feio!"
msgstr "He got out, but his arm is badly burned!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem fogo na janela da cozinha!"
msgstr "There's fire in the kitchen window!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Não, ele saiu antes. Tá aqui na rua comigo."
msgstr "No, he got out before. He's here on the street with me."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tem! Ele mora sozinho e não saiu! A porta tá trancada!"
msgstr "Yes! He lives alone and didn't come out! The door is locked!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá bom. Eu vou chamar os outros vizinhos."
msgstr "Okay. I'll go get the other neighbors."

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Agora tá saindo fogo pelo telhado!"
msgstr "Now there's fire coming out of the roof!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo já passou pras outras casas?"
msgstr "Has the fire spread to other houses?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Ainda não, mas tá pertinho do muro do vizinho!"
msgstr "Not yet, but it's right by the neighbor's wall!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "O fogo tá passando pra casa do lado! A senhora de lá usa cadeira de rodas e não consegue sair!"
msgstr "The fire is spreading to the house next door! The lady there uses a wheelchair and can't get out!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora está sozinha?"
msgstr "Is the lady alone?"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "Tá! A filha dela trabalha à noite!"
msgstr "Yes! Her daughter works nights!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A casa desabou... Vocês demoraram demais!"
msgstr "The house collapsed... You took too long!"

#: data/calls/emergency_07_incendio_rua_das_flores_45.tres
msgid "A senhora do lado! Os vizinhos tiraram ela, mas tá toda queimada!"
msgstr "The lady next door! The neighbors got her out, but she's badly burned!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Central, um carro bateu no poste aqui na avenida!"
msgstr "Operator, a car hit a light pole here on the avenue!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "O motorista está ferido?"
msgstr "Is the driver hurt?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "O poste caiu?"
msgstr "Did the pole come down?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Avenida Brasil, 60! Na frente da loja de tecidos!"
msgstr "Avenida Brasil, 60! In front of the fabric store!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá preso no carro, com a cabeça sangrando. Mas tá falando."
msgstr "He's trapped in the car, his head's bleeding. But he's talking."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, e os fios tão soltando faísca no meio da avenida! Ninguém passa!"
msgstr "It's leaning, and the wires are sparking in the middle of the avenue! Nobody can get through!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Não, ele saiu sozinho. Só tá assustado."
msgstr "No, he got out on his own. He's just shaken."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá torto, mas de pé. O carro ficou em cima da calçada."
msgstr "It's leaning, but still standing. The car ended up on the sidewalk."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá. Ninguém chega perto dos fios, pode deixar."
msgstr "Okay. Nobody's going near the wires, don't worry."

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tá formando fila de carro dos dois lados da avenida!"
msgstr "There's a line of cars building up on both sides of the avenue!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem alguém sinalizando a pista?"
msgstr "Is anyone warning the traffic?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Não, tá todo mundo parado olhando!"
msgstr "No, everyone's just standing there watching!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Começou a sair fumaça do capô do carro!"
msgstr "Smoke started coming out of the car's hood!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tem alguém perto do carro?"
msgstr "Is anyone near the car?"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Tem gente tentando abrir a porta pra ajudar!"
msgstr "People are trying to open the door to help!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O carro pegou fogo! Por que ninguém veio?!"
msgstr "The car caught fire! Why didn't anyone come?!"

#: data/calls/emergency_08_acidente_avenida_brasil_60.tres
msgid "Um dos rapazes que ajudava se queimou feio no braço!"
msgstr "One of the guys helping got his arm badly burned!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Filha"
msgstr "Daughter"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Central, minha mãe tá passando mal! A boca tá torta e ela não fala direito!"
msgstr "Operator, my mother's not well! Her mouth is drooping and she can't talk right!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Ela está consciente?"
msgstr "Is she conscious?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Quantos anos ela tem?"
msgstr "How old is she?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Rua do Comércio, 150. Em cima da loja."
msgstr "Rua do Comércio, 150. Above the store."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas não consegue levantar o braço."
msgstr "She is, but she can't lift her arm."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Setenta e oito."
msgstr "Seventy-eight."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Eu vou descer e esperar na porta."
msgstr "I'll go down and wait at the door."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Agora ela não consegue falar mais nada!"
msgstr "Now she can't say anything at all!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela consegue mexer os braços?"
msgstr "Can she move her arms?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Só o esquerdo. O direito tá caído."
msgstr "Just the left one. The right one is limp."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela desmaiou! Não acorda!"
msgstr "She fainted! She won't wake up!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela está respirando?"
msgstr "Is she breathing?"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Tá, mas fazendo um barulho estranho!"
msgstr "Yes, but she's making a strange noise!"

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela... ela não acorda mais. Ninguém veio."
msgstr "She... she's not waking up. Nobody came."

#: data/calls/emergency_09_mal_subito_rua_do_comercio_150.tres
msgid "Ela não acorda... tá respirando bem fraquinho."
msgstr "She won't wake up... she's breathing very faintly."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Central... tem alguém dentro da minha casa."
msgstr "(whispering) Operator... there's someone inside my house."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "O senhor está em segurança?"
msgstr "Are you somewhere safe, sir?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres data/calls/emergency_18_invasao_rua_do_mercado_90.tres data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "A pessoa está armada?"
msgstr "Is the person armed?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Rua do Moinho, 260. A última casa."
msgstr "Rua do Moinho, 260. The last house."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô trancado no quarto. Ouvi quebrarem o vidro da cozinha."
msgstr "I'm locked in the bedroom. I heard them break the kitchen glass."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Não sei. Não vi. Só ouço os passos."
msgstr "I don't know. I didn't see. I can only hear footsteps."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tô no quarto, trancado. Mas cortei a mão feio no vidro quando fugi... tá sangrando muito."
msgstr "I'm locked in the bedroom. But I cut my hand badly on the glass when I ran... it's bleeding a lot."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tá. Eu vou ficar quieto aqui."
msgstr "Okay. I'll stay quiet in here."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão mexendo nas gavetas da sala..."
msgstr "(whispering) They're going through the drawers in the living room..."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Quantas pessoas você ouve?"
msgstr "How many people do you hear?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Duas vozes. Homens."
msgstr "(whispering) Two voices. Men."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) Tão tentando abrir a porta do quarto!"
msgstr "(whispering) They're trying to open the bedroom door!"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "Tem alguma saída no quarto?"
msgstr "Is there a way out of the bedroom?"

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(sussurrando) A janela... mas é do segundo andar."
msgstr "(whispering) The window... but it's on the second floor."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(chorando) Eles foram embora... levaram tudo. Ninguém veio."
msgstr "(crying) They're gone... they took everything. Nobody came."

#: data/calls/emergency_10_invasao_rua_do_moinho_260.tres
msgid "(chorando) Pulei a janela pra fugir... acho que quebrei o pé."
msgstr "(crying) I jumped out the window to get away... I think I broke my foot."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Central! A papelaria aqui da Rua Tiradentes tá pegando fogo!"
msgstr "Central! The stationery shop here on Rua Tiradentes is on fire!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Cento e vinte! Do lado dos Correios!"
msgstr "A hundred and twenty! Next to the post office!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "A loja toda! Sai fumaça preta pela porta!"
msgstr "The whole shop! Black smoke is pouring out the door!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não, o seu Osório fechou às seis e foi pra casa."
msgstr "No, Mr. Osório closed at six and went home."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tem! O seu Osório mora em cima da loja e não consegue descer!"
msgstr "Yes! Mr. Osório lives above the shop and can't get down!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Ele saiu, mas queimou as mãos tentando apagar!"
msgstr "He got out, but he burned his hands trying to put it out!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Graças a Deus. Vou avisar os vizinhos pra saírem de casa."
msgstr "Thank God. I'll tell the neighbors to get out of their houses."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "A fumaça tá cobrindo a rua, os carros tão parando no meio!"
msgstr "The smoke is covering the street, cars are stopping in the middle!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não, parou tudo. Tem gente buzinando no meio da fumaça."
msgstr "No, everything's stopped. People are honking in the middle of the smoke."

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O fogo passou pro sobrado do lado! Tem uma senhora na janela pedindo socorro!"
msgstr "The fire spread to the house next door! There's an old lady at the window calling for help!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Ela consegue sair?"
msgstr "Can she get out?"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Não! A escada é por dentro e tá cheia de fumaça!"
msgstr "No! The stairs are inside and full of smoke!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "O telhado da papelaria caiu... ninguém chegou a tempo!"
msgstr "The shop's roof came down... nobody got here in time!"

#: data/calls/emergency_11_incendio_rua_tiradentes_120.tres
msgid "Tiraram a senhora do sobrado pela janela, mas ela respirou muita fumaça!"
msgstr "They got the old lady out through the window, but she breathed in a lot of smoke!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Central, tem uma briga feia na saída do baile, na Rua das Acácias!"
msgstr "Central, there's a nasty fight outside the dance, on Rua das Acácias!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres data/templates/emergency_briga.tres
msgid "Alguém está armado?"
msgstr "Is anyone armed?"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Alguém se machucou?"
msgstr "Is anyone hurt?"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Trezentos e trinta! Na porta do clube!"
msgstr "Three hundred thirty! At the club's door!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Um quebrou uma garrafa e tá ameaçando todo mundo!"
msgstr "One of them broke a bottle and is threatening everybody!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Ainda não, mas tá cada vez pior!"
msgstr "Not yet, but it's getting worse!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Um levou uma garrafada na cabeça! Tá sangrando no chão!"
msgstr "One took a bottle to the head! He's bleeding on the ground!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Tá bom! Vou mandar o pessoal entrar de volta no clube."
msgstr "Okay! I'll get everyone back inside the club."

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Agora tão quebrando os carros estacionados na rua!"
msgstr "Now they're smashing the cars parked on the street!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Uns oito! Virou bagunça geral!"
msgstr "About eight! It's turned into a free-for-all!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Esfaquearam um rapaz! Ele tá caído na calçada!"
msgstr "They stabbed a young man! He's down on the sidewalk!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "Na barriga! Tão apertando com a camisa, mas não para de sangrar!"
msgstr "In the belly! They're pressing a shirt on it, but it won't stop bleeding!"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "O rapaz desmaiou... e todo mundo fugiu. Por que demorou tanto?"
msgstr "The young man passed out... and everyone ran off. Why did it take so long?"

#: data/calls/emergency_12_outro_rua_das_acacias_330.tres
msgid "O rapaz da facada desmaiou, e tem outro com o braço quebrado!"
msgstr "The one who got stabbed passed out, and there's another with a broken arm!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Central! Um carro bateu no ônibus da capital, aqui na frente da rodoviária!"
msgstr "Central! A car crashed into the bus from the capital, right in front of the bus station!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/calls/emergency_15_acidente_rua_do_sol_320.tres data/templates/emergency_acidente.tres
msgid "A rua está bloqueada?"
msgstr "Is the street blocked?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tem feridos?"
msgstr "Is anyone hurt?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Avenida Brasil, 580! Na frente da rodoviária!"
msgstr "Avenida Brasil, 580! In front of the bus station!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá! O carro ficou atravessado e o ônibus parou no meio da rua!"
msgstr "Yes! The car ended up sideways and the bus stopped in the middle of the street!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O motorista do carro tá com a testa sangrando, mas tá falando."
msgstr "The car's driver has a bleeding forehead, but he's talking."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Ninguém se machucou, graças a Deus. Foi só o susto."
msgstr "Nobody got hurt, thank God. Just a scare."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "O motorista do carro tá preso nas ferragens! A porta não abre!"
msgstr "The car's driver is trapped in the wreck! The door won't open!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Não, o motorista do ônibus já encostou tudo na calçada."
msgstr "No, the bus driver already pulled everything over to the curb."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá bom. Vou ficar aqui com ele até chegarem."
msgstr "Okay. I'll stay here with him until they arrive."

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tá juntando gente do ônibus em volta do carro, ninguém consegue passar!"
msgstr "People from the bus are crowding around the car, nobody can get through!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Alguém está orientando o trânsito?"
msgstr "Is anyone directing traffic?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tá saindo fumaça do motor do carro!"
msgstr "Smoke is coming out of the car's engine!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres data/templates/emergency_acidente.tres
msgid "Tem gente perto do carro?"
msgstr "Are there people near the car?"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Tem! Uns passageiros tão tentando abrir a porta!"
msgstr "Yes! Some passengers are trying to open the door!"

#: data/calls/emergency_13_acidente_avenida_brasil_580.tres
msgid "Um passageiro que tentava abrir a porta queimou as mãos!"
msgstr "A passenger who was trying to open the door burned his hands!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Central, meu pai caiu no quintal e não acorda!"
msgstr "Central, my father fell in the backyard and won't wake up!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Rua do Sol, 530! A casa do seu Benedito Souza!"
msgstr "Rua do Sol, 530! Mr. Benedito Souza's house!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá, mas bem devagar. Bateu a cabeça numa pedra."
msgstr "Yes, but very slowly. He hit his head on a rock."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá, ouço ele gemendo... mas ele caiu dentro do poço do quintal! Não dá pra descer!"
msgstr "Yes, I can hear him groaning... but he fell into the well in the backyard! There's no way down!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá bom... Pai, aguenta firme, eles tão vindo."
msgstr "Okay... Dad, hang on, they're coming."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres data/templates/emergency_mal_subito.tres
msgid "A respiração dele tá ficando mais fraca!"
msgstr "His breathing is getting weaker!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Não... eu chamo e ele não abre o olho."
msgstr "No... I call him and he doesn't open his eyes."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres data/templates/emergency_mal_subito.tres
msgid "Ele começou a tremer todo!"
msgstr "He started shaking all over!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele está sangrando?"
msgstr "Is he bleeding?"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Tá! A cabeça tá sangrando muito!"
msgstr "Yes! His head is bleeding a lot!"

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele parou de respirar... vocês demoraram demais."
msgstr "He stopped breathing... you took too long."

#: data/calls/emergency_14_mal_subito_rua_do_sol_530.tres
msgid "Ele não respira... o vizinho tá fazendo massagem no peito dele."
msgstr "He's not breathing... the neighbor is doing chest compressions on him."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Vigia da escola"
msgstr "School watchman"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Central, um caminhão de leite tombou aqui na frente da escola!"
msgstr "Central, a milk truck tipped over right in front of the school!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Rua do Sol, 320! Na frente da Escola Rui Barbosa!"
msgstr "Rua do Sol, 320! In front of the Rui Barbosa School!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá preso na cabine, com o braço sangrando. Mas tá falando."
msgstr "He's trapped in the cab, with his arm bleeding. But he's talking."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá! O caminhão e as latas de leite tão no meio da rua!"
msgstr "Yes! The truck and the milk cans are in the middle of the street!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Saiu sozinho, mas tá com a cabeça sangrando."
msgstr "He got out on his own, but his head is bleeding."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Saiu sozinho. Só tá assustado."
msgstr "He got out on his own. He's just shaken up."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Não, o caminhão tombou em cima da calçada. A rua tá livre."
msgstr "No, the truck tipped over onto the sidewalk. The street is clear."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá bom. Vou pôr uns cavaletes da escola na rua."
msgstr "Okay. I'll put some of the school's sawhorses out on the street."

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá formando fila de carro dos dois lados!"
msgstr "Cars are lining up on both sides!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Só eu, com a lanterna da escola!"
msgstr "Just me, with the school's flashlight!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tá vazando óleo e começou a sair fumaça do motor!"
msgstr "Oil is leaking and smoke started coming out of the engine!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem alguém perto do caminhão?"
msgstr "Is anyone near the truck?"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Tem! Uns rapazes tão tentando desvirar a cabine!"
msgstr "Yes! Some young men are trying to flip the cab back over!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "O caminhão pegou fogo! Ninguém veio!"
msgstr "The truck caught fire! Nobody came!"

#: data/calls/emergency_15_acidente_rua_do_sol_320.tres
msgid "Um dos rapazes que ajudava queimou o braço!"
msgstr "One of the young men who was helping burned his arm!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Senhor (baixinho)"
msgstr "Old man (whispering)"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Central... tem gente roubando o galinheiro do vizinho."
msgstr "(whispering) Central... someone is robbing my neighbor's henhouse."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Rua do Cruzeiro, 290. O sítio no fim da rua."
msgstr "Rua do Cruzeiro, 290. The farm at the end of the street."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Dois homens com lanterna, enchendo uns sacos."
msgstr "Two men with a flashlight, filling some sacks."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Não vi arma, não."
msgstr "I didn't see a weapon."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "O vizinho foi ver e levou uma pancada! Tá caído no terreiro!"
msgstr "My neighbor went to look and got hit! He's lying in the yard!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Tá bom. Eu fico quieto aqui dentro."
msgstr "(whispering) Okay. I'll stay quiet in here."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Eles tão levando as galinhas pra uma caminhonete..."
msgstr "(whispering) They're loading the chickens into a pickup truck..."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "Você consegue ver a placa?"
msgstr "Can you see the license plate?"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Não, tá sem luz. É uma caminhonete clara."
msgstr "(whispering) No, it has no lights. It's a light-colored pickup."

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Eles viram a minha lanterna! Um tá vindo pra cá com um facão!"
msgstr "(whispering) They saw my flashlight! One is coming over here with a machete!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(baixinho) Tô trancando a porta da cozinha... ele tá batendo!"
msgstr "(whispering) I'm locking the kitchen door... he's pounding on it!"

#: data/calls/emergency_16_invasao_rua_do_cruzeiro_290.tres
msgid "(chorando) Ele quebrou a janela e me acertou o braço... tá sangrando."
msgstr "(crying) He broke the window and hit my arm... it's bleeding."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tipógrafo"
msgstr "Typesetter"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Central! A oficina da gráfica tá pegando fogo! O papel todo tá queimando!"
msgstr "Central! The print shop's on fire! All the paper's burning!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres data/templates/emergency_gas.tres
msgid "Tem alguém dentro?"
msgstr "Is anyone inside?"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Rua Sete de Setembro, 60! Atrás da Gazeta!"
msgstr "Rua Sete de Setembro, 60! Behind the Gazeta!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Não, a gente saiu tudo pela frente."
msgstr "No, we all got out the front."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Não, graças a Deus. Só a fumaça."
msgstr "No, thank God. Just the smoke."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "O seu Amaro queimou o braço tirando as chapas da máquina!"
msgstr "Seu Amaro burned his arm getting the plates out of the press!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tá bom. A gente vai molhar a parede do vizinho enquanto isso."
msgstr "All right. We'll wet down the neighbour's wall in the meantime."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A fumaça tá entrando no sobrado do lado! Mora gente lá em cima!"
msgstr "The smoke's getting into the house next door! People live upstairs!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Quem mora no sobrado?"
msgstr "Who lives in that house?"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Um casal de velhinhos. Eles já desceram pra calçada."
msgstr "An old couple. They've already come down to the pavement."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A velhinha desmaiou na calçada! Respirou muita fumaça!"
msgstr "The old lady fainted on the pavement! She breathed in too much smoke!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "Tá, mas tossindo muito e chiando no peito."
msgstr "Yes, but coughing hard and wheezing."

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "O teto da gráfica caiu... e o fogo pegou o sobrado. Ninguém veio!"
msgstr "The print shop roof caved in... and the fire's taken the house. Nobody came!"

#: data/calls/emergency_17_incendio_rua_sete_de_setembro_60.tres
msgid "A velhinha não acorda, e o marido dela tá com o rosto queimado!"
msgstr "The old lady won't wake up, and her husband's face is burned!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Farmacêutico"
msgstr "Pharmacist"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Central, acabaram de assaltar a farmácia! O homem levou o dinheiro do caixa!"
msgstr "Central, the pharmacy's just been robbed! The man took the money from the till!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Rua do Mercado, 90. A Farmácia Santa Rita."
msgstr "Rua do Mercado, 90. The Farmácia Santa Rita."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Tava! Com um revólver! Saiu correndo pra praça."
msgstr "He was! With a revolver! He ran off towards the square."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Não, ninguém. Só o susto."
msgstr "No, nobody. Just the fright."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "O balconista levou uma coronhada na cabeça! Tá sangrando!"
msgstr "The shop assistant got hit on the head with the gun! He's bleeding!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Tá bom. Eu vou fechar a porta e esperar aqui dentro."
msgstr "All right. I'll lock the door and wait inside."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele voltou! Tá rondando a praça, olhando pra cá!"
msgstr "He's back! He's prowling round the square, looking this way!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele está sozinho?"
msgstr "Is he alone?"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Acho que tem outro esperando numa bicicleta."
msgstr "I think there's another one waiting on a bicycle."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Ele deu um tiro pro alto! O povo tá correndo!"
msgstr "He fired a shot in the air! People are running!"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Alguém foi atingido?"
msgstr "Was anyone hit?"

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Acho que não... mas uma senhora caiu correndo."
msgstr "I don't think so... but a lady fell over running."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "Eles fugiram... sumiram pela estrada. Ninguém apareceu."
msgstr "They got away... disappeared down the road. Nobody turned up."

#: data/calls/emergency_18_invasao_rua_do_mercado_90.tres
msgid "A senhora que caiu quebrou o braço. Tá aqui no banco, chorando de dor."
msgstr "The lady who fell broke her arm. She's here on the bench, crying in pain."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Zeladora da igreja"
msgstr "Church caretaker"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Central, uma senhora passou mal na saída da missa! Caiu no chão!"
msgstr "Central, a lady was taken ill coming out of mass! She fell to the ground!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela consegue falar?"
msgstr "Can she speak?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Rua da Matriz, 30. Na escadaria do lado da igreja."
msgstr "Rua da Matriz, 30. On the steps beside the church."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá, mas tá branca que nem papel."
msgstr "She is, but she's white as a sheet."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá tentando, mas a boca tá torta e a fala sai enrolada."
msgstr "She's trying, but her mouth is crooked and her words come out slurred."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Graças a Deus. O padre tá aqui segurando a mão dela."
msgstr "Thank God. The priest is here holding her hand."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela não mexe mais o braço direito!"
msgstr "She can't move her right arm any more!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela está acordada?"
msgstr "Is she awake?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Tá de olho aberto, mas não responde quando a gente chama."
msgstr "Her eyes are open, but she doesn't answer when we call her."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela tá vomitando! A gente virou ela de lado!"
msgstr "She's vomiting! We've turned her on her side!"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela bateu a cabeça quando caiu?"
msgstr "Did she hit her head when she fell?"

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Bateu no degrau. Tem um galo, mas não sangra."
msgstr "On the step. There's a bump, but it's not bleeding."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela fechou os olhos... o padre já tá rezando por ela."
msgstr "She's closed her eyes... the priest is already praying for her."

#: data/calls/emergency_19_mal_subito_rua_da_matriz_30.tres
msgid "Ela ainda respira, mas bem fraquinho. Não acorda mais."
msgstr "She's still breathing, but very faintly. She won't wake up."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Cobrador"
msgstr "Bus conductor"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Central, o ônibus da linha bateu num poste aqui na avenida! O fio caiu na rua!"
msgstr "Central, the bus has hit a pole here on the avenue! The wire's down in the road!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O fio está soltando faísca?"
msgstr "Is the wire sparking?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Avenida Brasil, 420! Perto da delegacia!"
msgstr "Avenida Brasil, 420! Near the police station!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Não, todo mundo desceu andando. Só o susto."
msgstr "No, everyone got off on their own feet. Just the fright."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá! E tá atravessado na rua, ninguém passa!"
msgstr "It is! And it's lying across the road, nobody can get by!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Uma passageira bateu a testa no banco da frente! Tá sangrando!"
msgstr "A passenger hit her forehead on the seat in front! She's bleeding!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá bom. Eu seguro o povo longe do fio."
msgstr "All right. I'll keep people away from the wire."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O fio encostou no ônibus! Tem gente ainda pegando as malas lá dentro!"
msgstr "The wire's touching the bus! There are people still getting their bags inside!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Quantas pessoas ainda estão no ônibus?"
msgstr "How many people are still on the bus?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Duas. Eu gritei pra elas não encostarem em nada."
msgstr "Two. I shouted at them not to touch anything."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O motorista desceu pela porta e levou um choque! Tá caído na calçada!"
msgstr "The driver got off through the door and got a shock! He's lying on the pavement!"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "Tá, mas não acorda. A mão dele tá queimada."
msgstr "He is, but he won't wake up. His hand is burned."

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O ônibus pegou fogo... A gente tirou o pessoal como deu. Por que demoraram?"
msgstr "The bus caught fire... We got people out as best we could. Why did you take so long?"

#: data/calls/emergency_20_acidente_avenida_brasil_420.tres
msgid "O motorista ainda não acordou, e um rapaz queimou as mãos ajudando."
msgstr "The driver still hasn't woken up, and a young man burned his hands helping."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Vizinha do prédio"
msgstr "Neighbour in the building"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Central, tá um cheiro forte de gás no corredor do prédio! Vem do apartamento da Dona Ilda!"
msgstr "Central, there's a strong smell of gas in the hallway! It's coming from Dona Ilda's flat!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Ela atende a porta?"
msgstr "Does she answer the door?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Alguém acendeu alguma luz ou fósforo?"
msgstr "Has anyone switched on a light or struck a match?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Rua das Flores, 350! O prédio de três andares!"
msgstr "Rua das Flores, 350! The three-storey building!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Não! A gente bate e nada! Ela deve ter passado mal com o gás!"
msgstr "No! We knock and nothing! The gas must have made her ill!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Não, ninguém. Abri as janelas do corredor."
msgstr "No, nobody. I've opened the hallway windows."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Atendeu agora, toda tonta. Disse que o fogão apagou e ela dormiu. Tá bem, só zonza."
msgstr "She just answered, all dizzy. Says the stove went out and she fell asleep. She's fine, just woozy."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Tá. Vou tirar todo mundo do prédio."
msgstr "Right. I'll get everyone out of the building."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "O cheiro tá chegando no andar de baixo! Tem criança lá!"
msgstr "The smell's reaching the floor below! There are children there!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "As crianças já saíram?"
msgstr "Have the children got out?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Já! A mãe levou elas pra calçada."
msgstr "Yes! Their mother took them out to the pavement."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "O vizinho de baixo tá com dor de cabeça e vomitando!"
msgstr "The man downstairs has a headache and is vomiting!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Ele consegue andar?"
msgstr "Can he walk?"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Consegue, apoiado. Tá sentado no meio-fio."
msgstr "With help, yes. He's sitting on the kerb."

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "Teve um estouro no apartamento dela! Quebrou as janelas todas!"
msgstr "There's been a blast in her flat! It blew out all the windows!"

#: data/calls/emergency_21_outro_rua_das_flores_350.tres
msgid "A Dona Ilda ainda tá lá dentro, e o vizinho levou um corte de vidro no rosto!"
msgstr "Dona Ilda's still inside, and the neighbour got cut on the face by the glass!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Central, o vizinho tá aqui no meu portão com uma foice, ameaçando por causa do muro!"
msgstr "Central, my neighbour's at my gate with a scythe, threatening me over the wall!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ele está bêbado?"
msgstr "Is he drunk?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Rua Tiradentes, 250! A casa de muro amarelo!"
msgstr "Rua Tiradentes, 250! The house with the yellow wall!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ainda não. Eu tranquei o portão."
msgstr "Not yet. I've locked the gate."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tá. Tá gritando que o muro é dele."
msgstr "He is. He's shouting that the wall is his."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Meu filho foi segurar ele e levou um talho no braço!"
msgstr "My son tried to hold him back and got a gash on his arm!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tá. Vou ficar aqui dentro com a porta trancada."
msgstr "Right. I'll stay inside with the door locked."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Ele tá derrubando o muro com a foice! A rua tá cheia de gente olhando!"
msgstr "He's knocking the wall down with the scythe! The street's full of people watching!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Tem mais alguém com ele?"
msgstr "Is anyone else with him?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "O irmão dele chegou agora, com um pedaço de pau."
msgstr "His brother just turned up, with a stick."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Os dois pularam o muro! Tão batendo no meu genro!"
msgstr "They've both jumped the wall! They're beating my son-in-law!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Onde ele está ferido?"
msgstr "Where is he hurt?"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Na cabeça! Tá caído no quintal, sangrando!"
msgstr "On the head! He's down in the yard, bleeding!"

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Eles foram embora... deixaram meu genro no chão. Ninguém veio ajudar."
msgstr "They've gone... they left my son-in-law on the ground. Nobody came to help."

#: data/calls/emergency_22_outro_rua_tiradentes_250.tres
msgid "Meu genro não acorda, e minha filha machucou a mão tentando separar."
msgstr "My son-in-law won't wake up, and my daughter hurt her hand trying to pull them apart."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ajudante de padeiro"
msgstr "Baker's helper"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Central, o padeiro caiu do lado do forno! Tá passando muito mal!"
msgstr "Central, the baker has collapsed next to the oven! He's really ill!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele reclamou de alguma dor?"
msgstr "Did he complain of any pain?"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Rua das Acácias, 450! A Padaria Pão Dourado, pelos fundos!"
msgstr "Rua das Acácias, 450! The Padaria Pão Dourado, round the back!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Tá, mas tá suando frio."
msgstr "He is, but he's in a cold sweat."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Disse que o peito tava apertando e o braço formigando."
msgstr "He said his chest was tight and his arm was tingling."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Disse que o peito apertava... e quando caiu derrubou a lenha, tá pegando fogo nos sacos de farinha!"
msgstr "He said his chest was tight... and when he fell he knocked the firewood over, the flour sacks are catching fire!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Tá bom. Vou abrir a porta da frente pra eles."
msgstr "All right. I'll open the front door for them."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele tá ficando roxo! Tá com falta de ar!"
msgstr "He's turning blue! He can't get his breath!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele toma algum remédio?"
msgstr "Does he take any medicine?"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Toma um do coração, mas esqueceu em casa."
msgstr "He takes one for his heart, but left it at home."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele parou de responder! Tô sacudindo ele e nada!"
msgstr "He's stopped answering! I'm shaking him and nothing!"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele ainda respira?"
msgstr "Is he still breathing?"

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Bem pouquinho... de vez em quando."
msgstr "Barely... every now and then."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "Ele não respira mais... a gente tá tentando, mas demorou demais."
msgstr "He's not breathing any more... we're trying, but it took too long."

#: data/calls/emergency_23_mal_subito_rua_das_acacias_450.tres
msgid "O padeiro tá desacordado, e o outro ajudante tá apertando o peito dele."
msgstr "The baker's unconscious, and the other helper is pressing on his chest."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres data/content.tres
msgid "Moradora"
msgstr "Resident"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Central, um carro desceu a ladeira sem freio e entrou no muro da minha casa!"
msgstr "Central, a car came down the hill with no brakes and went into my wall!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O carro está no meio da rua?"
msgstr "Is the car in the middle of the road?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Rua das Palmeiras, 140! No fim da ladeira!"
msgstr "Rua das Palmeiras, 140! At the bottom of the hill!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O motorista tá com a cabeça sangrando no volante!"
msgstr "The driver's head is bleeding against the wheel!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá! Metade na rua, metade no muro. Ninguém passa."
msgstr "Yes! Half in the road, half in the wall. Nobody can get by."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Não, o motorista saiu andando. Só o muro que foi."
msgstr "No, the driver walked out. Just the wall's gone."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O motorista tá preso, a porta amassou toda! E tá sangrando!"
msgstr "The driver's trapped, the door's all crushed! And he's bleeding!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá. Vou pôr uma lanterna na ladeira pra ninguém bater."
msgstr "Right. I'll put a lantern on the hill so nobody runs into it."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tá saindo fumaça do motor! Tá pingando gasolina!"
msgstr "There's smoke coming from the engine! Petrol's dripping!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O fogo já começou?"
msgstr "Has the fire started?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Ainda não, só a fumaça e o cheiro."
msgstr "Not yet, just the smoke and the smell."

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Pegou fogo embaixo do carro!"
msgstr "It's caught fire under the car!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Meu marido tá tentando apagar com terra e queimou a mão!"
msgstr "My husband's trying to put it out with dirt and burned his hand!"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "O carro tá todo em chamas... e o muro desabou. Por que não vieram?"
msgstr "The car's all in flames... and the wall's collapsed. Why didn't you come?"

#: data/calls/emergency_24_acidente_rua_das_palmeiras_140.tres
msgid "Tiramos o motorista, mas ele tá desmaiado, e meu marido tá com a mão em carne viva!"
msgstr "We got the driver out, but he's passed out, and my husband's hand is raw!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Seu Joaquim"
msgstr "Seu Joaquim"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "(baixinho) Central, tem gente arrombando o depósito do armazém. Tô ouvindo daqui de cima."
msgstr "(quietly) Central, someone's breaking into the shop's storeroom. I can hear them from upstairs."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tem mais alguém na casa?"
msgstr "Is anyone else in the house?"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Rua Bela Vista, 230. O Armazém Ferreira. Eu moro em cima."
msgstr "Rua Bela Vista, 230. The Armazém Ferreira. I live upstairs."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Uns dois ou três. Tão carregando os sacos de arroz numa carroça."
msgstr "Two or three. They're loading the rice sacks onto a cart."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Minha mulher. Tá aqui comigo, quietinha."
msgstr "My wife. She's here with me, keeping quiet."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Meu filho desceu pra ver e não voltou... ouvi um grito dele!"
msgstr "My son went down to look and didn't come back... I heard him shout!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tá bom. Não vou descer, prometo."
msgstr "All right. I won't go down, I promise."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Eles tão subindo a escada! Ouço os passos!"
msgstr "They're coming up the stairs! I can hear the footsteps!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "A porta do quarto tem tranca?"
msgstr "Does the bedroom door lock?"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tem. Pus a cômoda na frente também."
msgstr "It does. I've pushed the dresser against it too."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tão chutando a porta! Minha mulher passou mal de nervoso!"
msgstr "They're kicking the door! My wife's come over faint from nerves!"

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Tá, mas com a mão no peito, sem ar."
msgstr "She is, but with her hand on her chest, out of breath."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Eles levaram tudo e foram embora... a gente ficou sozinho aqui."
msgstr "They took everything and left... we were left here alone."

#: data/calls/emergency_25_invasao_rua_bela_vista_230.tres
msgid "Minha mulher tá deitada, com dor no peito, e eu cortei a mão na porta."
msgstr "My wife's lying down with chest pain, and I cut my hand on the door."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Caseiro"
msgstr "Farmhand"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Central! O paiol do sítio tá pegando fogo! O vento tá levando pro pasto!"
msgstr "Central! The farm's barn is on fire! The wind's carrying it to the pasture!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Rua do Cruzeiro, 260! O Sítio Boa Esperança, no fim da rua!"
msgstr "Rua do Cruzeiro, 260! The Sítio Boa Esperança, at the end of the road!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Não, só o milho e as ferramentas."
msgstr "No, just the corn and the tools."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Não. Tô jogando água com o balde."
msgstr "No. I'm throwing water on it with a bucket."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "O patrão tentou tirar o cavalo e se queimou todo nos braços!"
msgstr "The boss tried to get the horse out and his arms got badly burned!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Tá. Vou soltar os bichos do curral."
msgstr "Right. I'll let the animals out of the corral."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "O fogo pegou no pasto e tá indo pra casa!"
msgstr "The fire's caught the pasture and it's heading for the house!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Tem gente na casa?"
msgstr "Are there people in the house?"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A patroa e as duas meninas. Já mandei sair."
msgstr "The boss's wife and the two girls. I've told them to get out."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A menina menor voltou pra buscar o cachorro e não saiu!"
msgstr "The little girl went back for the dog and hasn't come out!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Onde ela está?"
msgstr "Where is she?"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "No quarto dos fundos! A fumaça tá saindo pela janela!"
msgstr "In the back bedroom! Smoke's coming out the window!"

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "A casa queimou... a gente perdeu tudo. Ninguém subiu a serra."
msgstr "The house burned down... we've lost everything. Nobody came up the hill."

#: data/calls/emergency_26_incendio_rua_do_cruzeiro_260.tres
msgid "Eu tirei a menina pela janela, mas ela tá tossindo sem parar e com o braço queimado."
msgstr "I got the girl out through the window, but she can't stop coughing and her arm is burned."

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Mãe"
msgstr "Mother"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Central, meu filho caiu no córrego atrás de casa! A correnteza tá levando ele!"
msgstr "Central, my son fell into the stream behind the house! The current's carrying him off!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Ele está segurando em alguma coisa?"
msgstr "Is he holding on to anything?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Quantos anos ele tem?"
msgstr "How old is he?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Rua do Moinho, 410! Atrás do moinho velho!"
msgstr "Rua do Moinho, 410! Behind the old mill!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Num galho! Tá preso no galho, a água batendo no peito!"
msgstr "A branch! He's caught on a branch, the water's up to his chest!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Nove! Ele não sabe nadar direito!"
msgstr "Nine! He can't swim properly!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O vizinho pulou e tirou ele! Mas ele engoliu muita água, tá tossindo e roxo!"
msgstr "The neighbour jumped in and pulled him out! But he swallowed a lot of water, he's coughing and blue!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Rápido, pelo amor de Deus! Eu fico gritando com ele pra ele não soltar!"
msgstr "Hurry, for God's sake! I'll keep shouting to him so he doesn't let go!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "A água tá subindo! Choveu lá em cima da serra!"
msgstr "The water's rising! It rained up in the hills!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Tem alguém na margem com ele?"
msgstr "Is anyone on the bank with him?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai dele tá estendendo uma corda, mas não alcança."
msgstr "His father's reaching out with a rope, but it won't reach."

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai pulou atrás dele! Agora os dois tão na água!"
msgstr "His father's jumped in after him! Now they're both in the water!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Eles conseguem chegar na margem?"
msgstr "Can they reach the bank?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "O pai pegou o menino, mas a correnteza tá forte demais!"
msgstr "His father's got the boy, but the current's too strong!"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "A correnteza levou os dois lá pra baixo... a gente tá correndo pela margem. Cadê vocês?"
msgstr "The current took them both downstream... we're running along the bank. Where are you?"

#: data/calls/emergency_27_outro_rua_do_moinho_410.tres
msgid "Os vizinhos tiraram os dois na curva do rio. O menino não acorda, e o pai bateu a cabeça."
msgstr "The neighbours pulled them both out at the bend. The boy won't wake up, and his father hit his head."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Central, o vento derrubou um fio de luz aqui na rua! Tá soltando faísca no chão!"
msgstr "Central, the wind's brought a power line down here in the street! It's sparking on the ground!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fio está bloqueando a rua?"
msgstr "Is the wire blocking the road?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Rua da Estação, 450! Na frente da antiga estação de trem!"
msgstr "Rua da Estação, 450! In front of the old railway station!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Tá! Atravessado de um lado a outro. Os carros tão parando."
msgstr "Yes! Right across from one side to the other. The cars are stopping."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Não, graças a Deus."
msgstr "No, thank God."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Um rapaz de bicicleta passou por cima e levou um choque! Tá caído!"
msgstr "A lad on a bicycle rode over it and got a shock! He's down!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Tá. Vou ficar aqui avisando quem passar."
msgstr "Right. I'll stay here warning whoever comes by."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "A faísca pegou no capim do terreno do lado! Tá começando um fogo!"
msgstr "The sparks have caught the grass on the lot next door! A fire's starting!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fogo está perto das casas?"
msgstr "Is the fire near the houses?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Ainda não, mas tá indo pro lado da cerca da Dona Nena."
msgstr "Not yet, but it's heading for Dona Nena's fence."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Um cachorro encostou no fio e o dono foi puxar! Os dois tão caídos!"
msgstr "A dog touched the wire and its owner went to pull it away! They're both down!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O homem está respirando?"
msgstr "Is the man breathing?"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "Acho que sim... mas tá todo duro, não mexe."
msgstr "I think so... but he's gone stiff, he's not moving."

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O fogo pegou a cerca e o quintal da Dona Nena... Ninguém apareceu!"
msgstr "The fire's taken Dona Nena's fence and yard... Nobody turned up!"

#: data/calls/emergency_28_outro_rua_da_estacao_450.tres
msgid "O homem do cachorro não acorda, e a Dona Nena tá passando mal com a fumaça."
msgstr "The man with the dog won't wake up, and Dona Nena's feeling ill from the smoke."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Dona Sônia"
msgstr "Dona Sônia"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Central, tem um homem no meu quintal mexendo no galinheiro! Agora, nesse minuto!"
msgstr "Central, there's a man in my backyard messing with the henhouse! Right now, this minute!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Você conhece a pessoa?"
msgstr "Do you know the person?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Rua do Comércio, 420! A casa da Sônia Vieira!"
msgstr "Rua do Comércio, 420! Sônia Vieira's house!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Não! Nunca vi. Tá de chapéu, enfiando as galinhas num saco."
msgstr "No! Never seen him. He's wearing a hat, stuffing the hens into a sack."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá com um facão na cintura!"
msgstr "He's got a machete on his belt!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá com um facão! E meu marido foi atrás dele e caiu do barranco, tá gemendo!"
msgstr "He's got a machete! And my husband went after him and fell down the bank, he's groaning!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá bom. Vou apagar a luz e ficar quieta."
msgstr "All right. I'll turn off the light and keep still."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele me viu na janela! Tá vindo pra porta da cozinha!"
msgstr "He saw me at the window! He's coming to the kitchen door!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "A porta está trancada?"
msgstr "Is the door locked?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Tá, mas é de madeira fina. Tô segurando com a vassoura."
msgstr "It is, but it's thin wood. I'm wedging it with the broom."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele quebrou o vidro da porta! Cortou a mão e tá sangrando, mas não para!"
msgstr "He's broken the glass in the door! He cut his hand and he's bleeding, but he won't stop!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele entrou na casa?"
msgstr "Has he got into the house?"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ainda não! Tô trancada no quarto com o telefone!"
msgstr "Not yet! I'm locked in the bedroom with the telephone!"

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Ele levou as galinhas e o rádio da sala... foi embora. Ninguém veio."
msgstr "He took the hens and the radio from the front room... he's gone. Nobody came."

#: data/calls/emergency_29_invasao_rua_do_comercio_420.tres
msgid "Eu caí no corredor fugindo dele e torci o pé. Tá inchando muito."
msgstr "I fell in the hallway running from him and twisted my foot. It's swelling up badly."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Neta"
msgstr "Granddaughter"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Central, a minha avó tá passando mal! A fala dela tá esquisita!"
msgstr "Central, my grandmother's ill! Her speech has gone strange!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela consegue levantar os dois braços?"
msgstr "Can she raise both arms?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Rua Bela Vista, 160! A casa da Dona Laudelina Prado!"
msgstr "Rua Bela Vista, 160! Dona Laudelina Prado's house!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Sentada na cozinha. Eu tô do lado dela."
msgstr "Sitting in the kitchen. I'm right beside her."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Só o esquerdo. O direito cai sozinho."
msgstr "Only the left one. The right one just drops."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela se trancou no banheiro e caiu lá dentro! A porta não abre!"
msgstr "She locked herself in the bathroom and fell inside! The door won't open!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Tá. Vou ficar segurando a mão dela."
msgstr "Right. I'll keep holding her hand."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Agora ela não fala mais nada! Só olha pra mim!"
msgstr "Now she's not saying anything! She just looks at me!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela está respirando bem?"
msgstr "Is she breathing all right?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Tá, mas fazendo um barulho no peito."
msgstr "She is, but making a noise in her chest."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela caiu da cadeira! Bateu a cabeça na quina da mesa!"
msgstr "She's fallen off the chair! She hit her head on the corner of the table!"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "A cabeça está sangrando?"
msgstr "Is her head bleeding?"

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Um pouco. Tô apertando com o pano de prato."
msgstr "A little. I'm pressing on it with the tea towel."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela não acorda mais... eu chamo, chamo... Vocês demoraram demais."
msgstr "She won't wake up any more... I call and call... You took too long."

#: data/calls/emergency_30_mal_subito_rua_bela_vista_160.tres
msgid "Ela respira bem fraquinho, e a mão direita tá gelada."
msgstr "She's breathing very faintly, and her right hand is ice-cold."

#: data/calls/prank_01_crianca.tres
msgid "Criança"
msgstr "Child"

#: data/calls/prank_01_crianca.tres
msgid "Central, preciso de uma ambulância!"
msgstr "Operator, I need an ambulance!"

#: data/calls/prank_01_crianca.tres
msgid "Na casa do meu cachorro."
msgstr "At my dog's house."

#: data/calls/prank_01_crianca.tres
msgid "Isso é sério?"
msgstr "Is this serious?"

#: data/calls/prank_01_crianca.tres
msgid "Rua Au-Au, número 4."
msgstr "Rua Au-Au, number 4."

#: data/calls/prank_01_crianca.tres
msgid "É urgente. Ele comeu meu sanduíche."
msgstr "It's urgent. He ate my sandwich."

#: data/calls/prank_01_crianca.tres data/calls/prank_05_menino.tres data/calls/prank_15_garoto.tres
msgid "(risadas abafadas)"
msgstr "(muffled laughter)"

#: data/calls/prank_01_crianca.tres
msgid "(ao fundo) Desliga, desliga!"
msgstr "(in the background) Hang up, hang up!"

#: data/calls/prank_02_garoto.tres data/calls/prank_04_garoto.tres data/calls/prank_07_garoto.tres
msgid "Garoto"
msgstr "Boy"

#: data/calls/prank_02_garoto.tres
msgid "Central! É urgente! Tem um incêndio!"
msgstr "Operator! It's urgent! There's a fire!"

#: data/calls/prank_02_garoto.tres
msgid "Onde é o incêndio?"
msgstr "Where's the fire?"

#: data/calls/prank_02_garoto.tres
msgid "No meu coração..."
msgstr "In my heart..."

#: data/calls/prank_02_garoto.tres
msgid "...pela Marcinha da sétima série!"
msgstr "...for Marcinha in seventh grade!"

#: data/calls/prank_02_garoto.tres
msgid "(risadas de várias crianças)"
msgstr "(several kids laughing)"

#: data/calls/prank_02_garoto.tres
msgid "Esta é uma linha de serviço, garoto."
msgstr "This is a service line, kid."

#: data/calls/prank_02_garoto.tres
msgid "Onde você está ligando?"
msgstr "Where are you calling from?"

#: data/calls/prank_02_garoto.tres
msgid "Fala pra ela, tá? Tchau!"
msgstr "Tell her, okay? Bye!"

#: data/calls/prank_03_menina.tres data/calls/prank_06_menina.tres data/calls/prank_12_menina.tres
msgid "Menina"
msgstr "Girl"

#: data/calls/prank_03_menina.tres
msgid "Alô? É da central telefônica?"
msgstr "Hello? Is this the telephone exchange?"

#: data/calls/prank_03_menina.tres
msgid "Sim. Em que posso ajudar?"
msgstr "Yes. How can I help?"

#: data/calls/prank_03_menina.tres
msgid "Vocês têm o telefone de todo mundo da cidade?"
msgstr "Do you have everybody's phone number in town?"

#: data/calls/prank_03_menina.tres
msgid "Temos a lista, sim."
msgstr "We have the directory, yes."

#: data/calls/prank_03_menina.tres
msgid "Então cuida bem deles, tá?"
msgstr "Then take good care of them, okay?"

#: data/calls/prank_03_menina.tres data/calls/prank_04_garoto.tres data/calls/prank_06_menina.tres
msgid "(risadas)"
msgstr "(laughter)"

#: data/calls/prank_03_menina.tres
msgid "Minha mãe tá vindo! Tchau!"
msgstr "My mom's coming! Bye!"

#: data/calls/prank_04_garoto.tres
msgid "Alô, é da central? A sua geladeira está funcionando?"
msgstr "Hello, is this the exchange? Is your refrigerator running?"

#: data/calls/prank_04_garoto.tres
msgid "Aqui é a central telefônica."
msgstr "This is the telephone exchange."

#: data/calls/prank_04_garoto.tres
msgid "Que brincadeira é essa?"
msgstr "What kind of joke is this?"

#: data/calls/prank_04_garoto.tres
msgid "Então corre atrás dela!"
msgstr "Then you'd better go catch it!"

#: data/calls/prank_05_menino.tres
msgid "Central? Aqui quem fala é o presidente da república."
msgstr "Operator? This is the president of the republic speaking."

#: data/calls/prank_05_menino.tres
msgid "Pois não, senhor presidente."
msgstr "Yes, Mr. President."

#: data/calls/prank_05_menino.tres
msgid "Esta é uma linha de serviço."
msgstr "This is a service line."

#: data/calls/prank_05_menino.tres
msgid "Eu quero... eu quero pedir uma pizza!"
msgstr "I want... I want to order a pizza!"

#: data/calls/prank_05_menino.tres
msgid "(ao fundo) Pede cachorro-quente!"
msgstr "(in the background) Get hot dogs!"

#: data/calls/prank_06_menina.tres
msgid "Alô? É da central?"
msgstr "Hello? Is this the exchange?"

#: data/calls/prank_06_menina.tres
msgid "Sim, central telefônica. Pois não?"
msgstr "Yes, telephone exchange. How can I help?"

#: data/calls/prank_06_menina.tres
msgid "Meu irmão quer saber se o senhor tem cara de telefone."
msgstr "My brother wants to know if your face looks like a telephone."

#: data/calls/prank_06_menina.tres
msgid "Esta é uma linha de serviço, menina."
msgstr "This is a service line, young lady."

#: data/calls/prank_06_menina.tres
msgid "Onde estão seus pais?"
msgstr "Where are your parents?"

#: data/calls/prank_06_menina.tres
msgid "Foi ele que mandou falar! Tchau!"
msgstr "He told me to say it! Bye!"

#: data/calls/prank_07_garoto.tres
msgid "Central, eu quero denunciar um crime!"
msgstr "Operator, I want to report a crime!"

#: data/calls/prank_07_garoto.tres
msgid "Qual crime? Onde?"
msgstr "What crime? Where?"

#: data/calls/prank_07_garoto.tres
msgid "Roubaram a minha bicicleta..."
msgstr "Somebody stole my bicycle..."

#: data/calls/prank_07_garoto.tres
msgid "...e devolveram pintada de rosa!"
msgstr "...and brought it back painted pink!"

#: data/calls/prank_07_garoto.tres
msgid "(risadas ao fundo)"
msgstr "(laughter in the background)"

#: data/calls/prank_07_garoto.tres
msgid "Você sabe que trote é crime, não sabe?"
msgstr "You know prank calls are a crime, don't you?"

#: data/calls/prank_07_garoto.tres
msgid "Qual é o seu endereço?"
msgstr "What's your address?"

#: data/calls/prank_07_garoto.tres
msgid "Rua dos Bobos, número zero!"
msgstr "Rua dos Bobos, number zero!"

#: data/calls/prank_08_rapaz.tres
msgid "Boa noite, é do Corpo de Bombeiros?"
msgstr "Good evening, is this the fire department?"

#: data/calls/prank_08_rapaz.tres
msgid "Não, aqui é a central telefônica. Precisa dos bombeiros?"
msgstr "No, this is the telephone exchange. Do you need the fire department?"

#: data/calls/prank_08_rapaz.tres
msgid "Preciso. Tem um bicho enorme em cima da caixa d'água."
msgstr "I do. There's a huge beast up on the water tank."

#: data/calls/prank_08_rapaz.tres
msgid "Ah não, pera... é a minha sogra."
msgstr "Oh no, wait... it's my mother-in-law."

#: data/calls/prank_09_menino.tres
msgid "Alô, central? Aqui é da companhia telefônica."
msgstr "Hello, operator? This is the telephone company."

#: data/calls/prank_09_menino.tres
msgid "Vamos testar a linha. O senhor pode assoviar?"
msgstr "We're testing the line. Could you whistle, sir?"

#: data/calls/prank_09_menino.tres
msgid "Isso não é um teste de verdade, é?"
msgstr "This isn't a real test, is it?"

#: data/calls/prank_09_menino.tres
msgid "Qual companhia?"
msgstr "What company?"

#: data/calls/prank_09_menino.tres
msgid "(tentando não rir) Assovia, por favor..."
msgstr "(trying not to laugh) Whistle, please..."

#: data/calls/prank_09_menino.tres
msgid "Tchau!"
msgstr "Bye!"

#: data/calls/prank_10_rapaz.tres
msgid "Alô? Gostaria de falar com a Paula!"
msgstr "Hello? I'd like to speak to Hugh!"

#: data/calls/prank_10_rapaz.tres
msgid "Que Paula, por favor?"
msgstr "Hugh who, please?"

#: data/calls/prank_10_rapaz.tres
msgid "Paula Tejano!"
msgstr "Hugh Jass!"

#: data/calls/prank_11_menino.tres
msgid "Alô? O senhor tem água encanada aí?"
msgstr "Hello? Have you got running water there?"

#: data/calls/prank_11_menino.tres
msgid "Tenho, por quê?"
msgstr "I have, why?"

#: data/calls/prank_11_menino.tres
msgid "Então solta ela, que ela é inocente!"
msgstr "Then let it go, it's done nothing wrong!"

#: data/calls/prank_12_menina.tres
msgid "Moço, quanto é sete vezes oito?"
msgstr "Mister, what's seven times eight?"

#: data/calls/prank_12_menina.tres
msgid "Cinquenta e seis."
msgstr "Fifty-six."

#: data/calls/prank_12_menina.tres
msgid "Isso não é serviço da central."
msgstr "That's not a job for the exchange."

#: data/calls/prank_12_menina.tres
msgid "Brigada! A professora disse pra perguntar pra quem sabe!"
msgstr "Thanks! The teacher said to ask someone who knows!"

#: data/calls/prank_12_menina.tres data/calls/prank_20_menina.tres
msgid "(risadinha)"
msgstr "(giggle)"

#: data/calls/prank_13_menino.tres
msgid "Alô? É do Polo Norte?"
msgstr "Hello? Is this the North Pole?"

#: data/calls/prank_13_menino.tres
msgid "Não, aqui é a central de São Sotero."
msgstr "No, this is the São Sotero exchange."

#: data/calls/prank_13_menino.tres
msgid "Ah... então avisa o Papai Noel que eu me comportei, tá?"
msgstr "Oh... then tell Father Christmas I've been good, all right?"

#: data/calls/prank_13_menino.tres
msgid "Quase o ano todo!"
msgstr "Nearly all year!"

#: data/calls/prank_14_rapaz.tres
msgid "Boa noite. Me liga com o seu Armando?"
msgstr "Good evening. Put me through to Seu Armando?"

#: data/calls/prank_14_rapaz.tres
msgid "Armando de quê?"
msgstr "Armando who?"

#: data/calls/prank_14_rapaz.tres
msgid "Armando Barraco!"
msgstr "Armando Barraco! Armando bar brawl!"

#: data/calls/prank_14_rapaz.tres
msgid "(gargalhadas)"
msgstr "(roars of laughter)"

#: data/calls/prank_15_garoto.tres
msgid "Central? Eu tenho um recado muito importante pro senhor."
msgstr "Central? I've got a very important message for you."

#: data/calls/prank_15_garoto.tres
msgid "Pois não?"
msgstr "Yes?"

#: data/calls/prank_15_garoto.tres
msgid "(um arroto enorme)"
msgstr "(an enormous burp)"

#: data/calls/prank_16_rapaz.tres
msgid "Locutor"
msgstr "Announcer"

#: data/calls/prank_16_rapaz.tres
msgid "Parabéns! O senhor acaba de ganhar o grande prêmio da noite!"
msgstr "Congratulations! You've just won tonight's grand prize!"

#: data/calls/prank_16_rapaz.tres
msgid "Ganhei o quê?"
msgstr "Won what?"

#: data/calls/prank_16_rapaz.tres
msgid "Isso é trote, rapaz."
msgstr "This is a prank, lad."

#: data/calls/prank_16_rapaz.tres
msgid "Uma noite inteirinha atendendo telefone!"
msgstr "A whole night answering the telephone!"

#: data/calls/prank_17_menino.tres
msgid "Alô, é do zoológico?"
msgstr "Hello, is this the zoo?"

#: data/calls/prank_17_menino.tres
msgid "Não, aqui é a central telefônica."
msgstr "No, this is the telephone exchange."

#: data/calls/prank_17_menino.tres
msgid "Ué! Então por que é que atendeu um macaco?"
msgstr "Huh! Then why did a monkey answer?"

#: data/calls/prank_18_garoto.tres
msgid "(voz grossa) Aqui quem fala é o prefeito. Exijo falar com o operador."
msgstr "(deep voice) This is the mayor speaking. I demand to speak to the operator."

#: data/calls/prank_18_garoto.tres
msgid "É ele mesmo. Pois não, senhor prefeito?"
msgstr "Speaking. How can I help, Mr Mayor?"

#: data/calls/prank_18_garoto.tres
msgid "Quantos anos o senhor tem?"
msgstr "And how old are you, sir?"

#: data/calls/prank_18_garoto.tres
msgid "(a voz afina) ...Mãe! Ele descobriu!"
msgstr "(the voice cracks) ...Mum! He's worked it out!"

#: data/calls/prank_19_criancas.tres
msgid "Crianças"
msgstr "Children"

#: data/calls/prank_19_criancas.tres
msgid "(várias vozes) Parabéns pra você, nesta data querida..."
msgstr "(several voices) Happy birthday to you, happy birthday to you..."

#: data/calls/prank_19_criancas.tres
msgid "Mas hoje não é meu aniversário."
msgstr "But it isn't my birthday today."

#: data/calls/prank_19_criancas.tres
msgid "A gente sabe!"
msgstr "We know!"

#: data/calls/prank_20_menina.tres
msgid "Alô? Aí é a casa do Zé?"
msgstr "Hello? Is this Zé's house?"

#: data/calls/prank_20_menina.tres
msgid "Não, aqui é a central."
msgstr "No, this is the exchange."

#: data/calls/prank_20_menina.tres
msgid "Então por que é que atendeu?"
msgstr "Then why did you answer?"

#: data/templates/transfer_01.tres
msgid "Me liga com {place}, por favor? {reason}"
msgstr "Can you put me through to {place}, please? {reason}"

#: data/templates/transfer_01.tres
msgid "Eu pedi {place}."
msgstr "I asked for {place}."

#: data/templates/transfer_02.tres
msgid "Pode me ligar {to_place}?"
msgstr "Can you connect me {to_place}?"

#: data/templates/transfer_02.tres data/templates/transfer_03.tres data/templates/transfer_07.tres
msgid "{reason}"
msgstr "{reason}"

#: data/templates/transfer_02.tres
msgid "{place}, por favor."
msgstr "{place}, please."

#: data/templates/transfer_03.tres
msgid "Queria falar com {place}."
msgstr "I'd like to talk to {place}."

#: data/templates/transfer_03.tres
msgid "Com {place}."
msgstr "{place}."

#: data/templates/transfer_04.tres
msgid "Me conecta com o {number}, por favor?"
msgstr "Can you connect me to {number}, please?"

#: data/templates/transfer_04.tres
msgid "É {of_place}. {reason}"
msgstr "It's the number {of_place}. {reason}"

#: data/templates/transfer_04.tres
msgid "{digits}."
msgstr "{digits}."

#: data/templates/transfer_05.tres
msgid "Alô, central?"
msgstr "Hello, operator?"

#: data/templates/transfer_05.tres
msgid "Me passa {to_place}? {reason}"
msgstr "Can you put me through {to_place}? {reason}"

#: data/templates/transfer_05.tres
msgid "Eu quero falar com {place}."
msgstr "I want to talk to {place}."

#: data/templates/transfer_06.tres
msgid "Boa noite. Desculpe a hora."
msgstr "Good evening. Sorry about the hour."

#: data/templates/transfer_06.tres
msgid "Preciso falar com {place}. {reason}"
msgstr "I need to talk to {place}. {reason}"

#: data/templates/transfer_06.tres
msgid "Com {place}, por favor."
msgstr "{place}, please."

#: data/templates/transfer_07.tres
msgid "Me liga com {place}, lá da {street}?"
msgstr "Can you put me through to {place}, over on {street}?"

#: data/templates/transfer_07.tres
msgid "{place}, da {street}."
msgstr "{place}, on {street}."

#: data/templates/transfer_08.tres data/content.tres
msgid "Alô? Central?"
msgstr "Hello? Operator?"

#: data/templates/transfer_08.tres
msgid "Faz favor de me ligar {to_place}. {reason}"
msgstr "Kindly connect me {to_place}. {reason}"

#: data/templates/transfer_08.tres
msgid "{place}, moço."
msgstr "{place}, young man."

#: data/templates/transfer_09.tres
msgid "Central? Graças a Deus que atendeu."
msgstr "Central? Thank God you picked up."

#: data/templates/transfer_09.tres
msgid "Pode me ligar com {place}? {reason}"
msgstr "Can you put me through to {place}? {reason}"

#: data/templates/transfer_09.tres
msgid "{place}. Por favor, é importante."
msgstr "{place}. Please, it's important."

#: data/templates/transfer_10.tres
msgid "Boa noite. É da central?"
msgstr "Good evening. Is this the exchange?"

#: data/templates/transfer_10.tres
msgid "Eu ia pedir o número {of_place}, mas pode ligar direto."
msgstr "I was going to ask for the number {of_place}, but you can put me straight through."

#: data/templates/transfer_10.tres
msgid "{place}, na {street}."
msgstr "{place}, on {street}."

#: data/content.tres
msgid "Agradeço. Boa noite."
msgstr "I appreciate it. Good night."

#: data/content.tres
msgid "Ótimo. Boa noite."
msgstr "Great. Good night."

#: data/content.tres
msgid "Isso. Boa noite pro senhor."
msgstr "That's it. Good night to you, sir."

#: data/templates/trunk_01.tres
msgid "Boa noite. Eu queria fazer um interurbano {to_city}."
msgstr "Good evening. I'd like to place a long-distance call {to_city}."

#: data/templates/trunk_01.tres
msgid "O número é {far}. É da minha irmã."
msgstr "The number is {far}. It's my sister's."

#: data/templates/trunk_01.tres
msgid "Um interurbano {to_city}, número {far}."
msgstr "A long-distance call {to_city}, number {far}."

#: data/templates/trunk_02.tres
msgid "Central? Preciso ligar {to_city}, é sobre um negócio."
msgstr "Operator? I need to call {to_city}, it's about some business."

#: data/templates/trunk_02.tres
msgid "Anota aí: {far}."
msgstr "Write it down: {far}."

#: data/templates/trunk_02.tres
msgid "{to_city}, moço. O número é {far}."
msgstr "{to_city}, mister. The number is {far}."

#: data/templates/trunk_03.tres
msgid "Boa noite. Dá pra completar uma ligação {to_city}?"
msgstr "Good evening. Can you put a call through {to_city}?"

#: data/templates/trunk_03.tres
msgid "É o {far}, do meu filho. Ele mudou pra lá faz pouco."
msgstr "It's {far}, my son's. He moved there not long ago."

#: data/templates/trunk_03.tres
msgid "É {to_city}. {far}."
msgstr "It's {to_city}. {far}."

#: data/templates/trunk_04.tres
msgid "Alô, central. Um interurbano {to_city}, por favor."
msgstr "Hello, operator. A long-distance call {to_city}, please."

#: data/templates/trunk_04.tres
msgid "Número {far}. Pode cobrar aqui, tá?"
msgstr "Number {far}. You can charge it here, all right?"

#: data/templates/trunk_04.tres
msgid "{to_city}, o {far}."
msgstr "{to_city}, number {far}."

#: data/content.tres
msgid "pra Capital"
msgstr "to the Capital"

#: data/content.tres
msgid "pro Norte"
msgstr "to the North"

#: data/content.tres
msgid "pro Sul"
msgstr "to the South"

#: data/content.tres
msgid "pro Leste"
msgstr "to the East"

#: data/content.tres
msgid "pro Oeste"
msgstr "to the West"

#: data/content.tres
msgid "pro Litoral"
msgstr "to the Coast"

#: data/templates/emergency_incendio.tres
msgid "Central! Tá pegando fogo numa casa aqui na {street}! Já tá subindo pelo telhado!"
msgstr "Operator! A house is on fire here on {street}! It's already going up the roof!"

#: data/templates/emergency_incendio.tres
msgid "{address}! Vem logo!"
msgstr "{address}! Come quick!"

#: data/templates/emergency_incendio.tres
msgid "Não, todo mundo saiu."
msgstr "No, everybody got out."

#: data/templates/emergency_incendio.tres
msgid "Não, foi só o susto."
msgstr "No, just a scare."

#: data/templates/emergency_incendio.tres
msgid "A dona da casa queimou as mãos tentando apagar!"
msgstr "The lady of the house burned her hands trying to put it out!"

#: data/templates/emergency_incendio.tres
msgid "Tá bom. A gente vai se afastar."
msgstr "Okay. We'll move back."

#: data/templates/emergency_incendio.tres
msgid "O fogo tá passando pra casa do vizinho!"
msgstr "The fire is spreading to the neighbor's house!"

#: data/templates/emergency_incendio.tres
msgid "A casa do vizinho tem gente?"
msgstr "Is anyone in the neighbor's house?"

#: data/templates/emergency_incendio.tres
msgid "Tem! O vizinho de idade mora sozinho lá!"
msgstr "Yes! The old man next door lives there alone!"

#: data/templates/emergency_incendio.tres
msgid "O vizinho de idade não saiu! Tá na janela pedindo ajuda!"
msgstr "The old man next door didn't get out! He's at the window calling for help!"

#: data/templates/emergency_incendio.tres
msgid "Ele consegue sair pela janela?"
msgstr "Can he get out through the window?"

#: data/templates/emergency_incendio.tres
msgid "Não! É alto demais e ele mal anda!"
msgstr "No! It's too high and he can barely walk!"

#: data/templates/emergency_incendio.tres
msgid "O telhado caiu... Vocês demoraram demais!"
msgstr "The roof came down... You took too long!"

#: data/templates/emergency_incendio.tres
msgid "Tiraram o vizinho pela escada dos fundos, mas ele respirou muita fumaça!"
msgstr "They got the neighbor out by the back stairs, but he breathed in a lot of smoke!"

#: data/templates/emergency_mal_subito.tres
msgid "Central, o meu vizinho desmaiou!"
msgstr "Operator, my neighbor passed out!"

#: data/templates/emergency_mal_subito.tres
msgid "Onde ele está?"
msgstr "Where is he?"

#: data/templates/emergency_mal_subito.tres
msgid "{address}. Vem rápido!"
msgstr "{address}. Come quick!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá, mas bem fraquinho."
msgstr "He is, but very faintly."

#: data/templates/emergency_mal_subito.tres
msgid "Caído aqui na calçada, na frente de casa."
msgstr "Lying here on the sidewalk, in front of my house."

#: data/templates/emergency_mal_subito.tres
msgid "Na cozinha da casa dele. E tá um cheiro forte de gás lá dentro!"
msgstr "In his kitchen. And there's a strong smell of gas in there!"

#: data/templates/emergency_mal_subito.tres
msgid "Tá. Eu espero aqui na porta."
msgstr "Okay. I'll wait here at the door."

#: data/templates/emergency_mal_subito.tres data/templates/emergency_queda.tres data/templates/emergency_fio_caido.tres
msgid "Ele está acordado?"
msgstr "Is he awake?"

#: data/templates/emergency_mal_subito.tres
msgid "Não. Eu chamo e ele não responde."
msgstr "No. I call him and he doesn't answer."

#: data/templates/emergency_mal_subito.tres
msgid "Ele bateu em alguma coisa?"
msgstr "Did he hit anything?"

#: data/templates/emergency_mal_subito.tres
msgid "Bateu a cabeça no chão, tá sangrando!"
msgstr "He hit his head on the floor, he's bleeding!"

#: data/templates/emergency_mal_subito.tres
msgid "Ele... parou de respirar. Vocês demoraram demais."
msgstr "He... stopped breathing. You took too long."

#: data/templates/emergency_mal_subito.tres
msgid "Ele não respira... um vizinho tá fazendo massagem no peito dele."
msgstr "He's not breathing... a neighbor is doing chest compressions."

#: data/templates/emergency_acidente.tres
msgid "Central, teve uma batida feia aqui na {street}!"
msgstr "Operator, there's been a bad crash here on {street}!"

#: data/templates/emergency_acidente.tres
msgid "{address}, na esquina!"
msgstr "{address}, on the corner!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz da moto. Tá no chão, mas mexe as pernas."
msgstr "The guy on the motorcycle. He's on the ground, but he can move his legs."

#: data/templates/emergency_acidente.tres
msgid "Tá. A moto e o carro tão no meio da rua."
msgstr "Yes. The bike and the car are in the middle of the street."

#: data/templates/emergency_acidente.tres
msgid "O motorista do carro tá preso nas ferragens, com a perna sangrando!"
msgstr "The car's driver is trapped in the wreck, his leg is bleeding!"

#: data/templates/emergency_acidente.tres
msgid "Não, já empurraram tudo pra calçada."
msgstr "No, they already pushed everything onto the sidewalk."

#: data/templates/emergency_acidente.tres
msgid "Tá bom. Eu fico aqui esperando."
msgstr "Alright. I'll stay here and wait."

#: data/templates/emergency_acidente.tres
msgid "Tá juntando gente em volta, os carros não passam mais!"
msgstr "A crowd is gathering, cars can't get by anymore!"

#: data/templates/emergency_acidente.tres
msgid "Tem! Tão tentando abrir o capô!"
msgstr "Yes! They're trying to open the hood!"

#: data/templates/emergency_acidente.tres
msgid "O carro pegou fogo! Por que demorou tanto?!"
msgstr "The car caught fire! Why did it take so long?!"

#: data/templates/emergency_acidente.tres
msgid "O rapaz que abriu o capô queimou as mãos!"
msgstr "The guy who opened the hood burned his hands!"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Central, tem alguém tentando abrir a porta dos fundos."
msgstr "(quietly) Operator, someone's trying to open the back door."

#: data/templates/emergency_invasao.tres
msgid "Tem mais alguém em casa?"
msgstr "Is anyone else home?"

#: data/templates/emergency_invasao.tres
msgid "Você viu a pessoa?"
msgstr "Did you see the person?"

#: data/templates/emergency_invasao.tres
msgid "{address}. Rápido, por favor."
msgstr "{address}. Hurry, please."

#: data/templates/emergency_invasao.tres
msgid "Não, só eu."
msgstr "No, just me."

#: data/templates/emergency_invasao.tres
msgid "Só a sombra pela janela."
msgstr "Just a shadow through the window."

#: data/templates/emergency_invasao.tres
msgid "Tá. Não vou fazer barulho."
msgstr "Okay. I won't make a sound."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele conseguiu abrir... tá dentro de casa."
msgstr "(quietly) He got it open... he's inside the house."

#: data/templates/emergency_invasao.tres
msgid "Você está em um lugar seguro?"
msgstr "Are you somewhere safe?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) No quarto, debaixo da cama."
msgstr "(quietly) In the bedroom, under the bed."

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Ele tá subindo a escada..."
msgstr "(quietly) He's coming up the stairs..."

#: data/templates/emergency_invasao.tres
msgid "Ele sabe que você está em casa?"
msgstr "Does he know you're home?"

#: data/templates/emergency_invasao.tres
msgid "(baixinho) Acho que sim... ouvi ele chamar alguém."
msgstr "(quietly) I think so... I heard him call someone."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele levou tudo e foi embora. Ninguém veio."
msgstr "(crying) He took everything and left. Nobody came."

#: data/templates/emergency_invasao.tres
msgid "(chorando) Ele me empurrou na escada quando foi embora... meu braço tá torto."
msgstr "(crying) He pushed me down the stairs when he left... my arm is twisted."

#: data/templates/emergency_briga.tres
msgid "Central, tem uma briga feia no meio da {street}!"
msgstr "Operator, there's a nasty fight in the middle of {street}!"

#: data/templates/emergency_briga.tres
msgid "{address}! Dá pra ver daqui de casa!"
msgstr "{address}! I can see it from my house!"

#: data/templates/emergency_briga.tres
msgid "Um tá com um pedaço de pau!"
msgstr "One's got a stick!"

#: data/templates/emergency_briga.tres
msgid "Ainda não, mas vai acabar mal!"
msgstr "Not yet, but this is going to end badly!"

#: data/templates/emergency_briga.tres
msgid "Um caiu e bateu a cabeça na guia! Tá sangrando!"
msgstr "One fell and hit his head on the curb! He's bleeding!"

#: data/templates/emergency_briga.tres
msgid "Tá. Vou entrar e trancar a porta."
msgstr "Okay. I'll go in and lock the door."

#: data/templates/emergency_briga.tres
msgid "Chegou mais gente! Agora são uns dez!"
msgstr "More people showed up! Now there's like ten of them!"

#: data/templates/emergency_briga.tres
msgid "Alguém está armado agora?"
msgstr "Is anyone armed now?"

#: data/templates/emergency_briga.tres
msgid "Apareceu um com uma faca!"
msgstr "One showed up with a knife!"

#: data/templates/emergency_briga.tres
msgid "Derrubaram um no chão e tão chutando! Ele não se mexe!"
msgstr "They knocked one down and they're kicking him! He's not moving!"

#: data/templates/emergency_briga.tres
msgid "Acho que sim... mas tá com o rosto todo machucado!"
msgstr "I think so... but his face is all beaten up!"

#: data/templates/emergency_briga.tres
msgid "Fugiram todos... e o rapaz continua no chão. Ninguém veio."
msgstr "They all ran off... and the guy is still on the ground. Nobody came."

#: data/templates/emergency_briga.tres
msgid "O rapaz continua no chão, sangrando muito pela cabeça!"
msgstr "The guy is still on the ground, bleeding badly from the head!"

#: data/templates/emergency_queda.tres
msgid "Central, um homem caiu do telhado aqui na {street}!"
msgstr "Central, a man's fallen off a roof here on {street}!"

#: data/templates/emergency_queda.tres
msgid "Ele mexe as pernas?"
msgstr "Can he move his legs?"

#: data/templates/emergency_queda.tres
msgid "{address}! Ele tava arrumando as telhas!"
msgstr "{address}! He was fixing the roof tiles!"

#: data/templates/emergency_queda.tres
msgid "Tá, mas gemendo muito."
msgstr "He is, but groaning a lot."

#: data/templates/emergency_queda.tres
msgid "Mexe, mas o braço tá torto."
msgstr "He can, but his arm's all bent."

#: data/templates/emergency_queda.tres
msgid "Mexe... mas ele caiu em cima do muro e ficou preso entre o muro e a grade!"
msgstr "He can... but he fell onto the wall and got stuck between the wall and the railings!"

#: data/templates/emergency_queda.tres
msgid "Tá. A gente não vai mexer nele."
msgstr "Right. We won't move him."

#: data/templates/emergency_queda.tres
msgid "Ele tá ficando pálido e com frio!"
msgstr "He's going pale and cold!"

#: data/templates/emergency_queda.tres
msgid "Ele bateu a cabeça?"
msgstr "Did he hit his head?"

#: data/templates/emergency_queda.tres
msgid "Acho que sim. Tem sangue atrás da orelha."
msgstr "I think so. There's blood behind his ear."

#: data/templates/emergency_queda.tres
msgid "Ele apagou! Não responde mais!"
msgstr "He's blacked out! He's not answering any more!"

#: data/templates/emergency_queda.tres
msgid "Tá, mas bem curtinho."
msgstr "He is, but very short breaths."

#: data/templates/emergency_queda.tres
msgid "Ele não acorda mais... e ninguém veio."
msgstr "He won't wake up any more... and nobody came."

#: data/templates/emergency_queda.tres
msgid "Ele respira bem fraco, e a cabeça não para de sangrar."
msgstr "He's breathing very faintly, and his head won't stop bleeding."

#: data/templates/emergency_fio_caido.tres
msgid "Central, caiu um fio de luz no meio da {street}! Tá soltando faísca!"
msgstr "Central, a power line's come down in the middle of {street}! It's sparking!"

#: data/templates/emergency_fio_caido.tres
msgid "O fio está fechando a rua?"
msgstr "Is the wire blocking the road?"

#: data/templates/emergency_fio_caido.tres
msgid "{address}! Bem na frente de casa!"
msgstr "{address}! Right outside my house!"

#: data/templates/emergency_fio_caido.tres
msgid "Tá, de ponta a ponta. Os carros tão parando."
msgstr "Yes, end to end. The cars are stopping."

#: data/templates/emergency_fio_caido.tres
msgid "Não, ainda não."
msgstr "No, not yet."

#: data/templates/emergency_fio_caido.tres
msgid "Um senhor encostou nele sem ver e caiu duro na calçada!"
msgstr "A man touched it without seeing and dropped stiff on the pavement!"

#: data/templates/emergency_fio_caido.tres
msgid "Tá. Vou segurar o povo longe."
msgstr "Right. I'll keep people back."

#: data/templates/emergency_fio_caido.tres
msgid "A faísca pegou fogo no mato da calçada!"
msgstr "The sparks have set the weeds on the pavement alight!"

#: data/templates/emergency_fio_caido.tres
msgid "O fogo está perto de alguma casa?"
msgstr "Is the fire near any house?"

#: data/templates/emergency_fio_caido.tres
msgid "Do muro do vizinho. Ainda dá pra apagar com balde."
msgstr "Near the neighbour's wall. We can still put it out with a bucket."

#: data/templates/emergency_fio_caido.tres
msgid "Um menino de bicicleta passou por cima do fio! Tá caído!"
msgstr "A boy on a bicycle rode over the wire! He's down!"

#: data/templates/emergency_fio_caido.tres
msgid "Não! E a mão dele tá preta!"
msgstr "No! And his hand's gone black!"

#: data/templates/emergency_fio_caido.tres
msgid "O fogo pegou a casa do vizinho... e ninguém veio."
msgstr "The fire's taken the neighbour's house... and nobody came."

#: data/templates/emergency_fio_caido.tres
msgid "O menino da bicicleta não acorda, e o vizinho queimou o braço."
msgstr "The boy on the bicycle won't wake up, and the neighbour burned his arm."

#: data/templates/emergency_gas.tres
msgid "Central, tá um cheiro forte de gás na casa do lado, aqui na {street}!"
msgstr "Central, there's a strong smell of gas from the house next door, here on {street}!"

#: data/templates/emergency_gas.tres
msgid "Alguém está passando mal?"
msgstr "Is anyone feeling ill?"

#: data/templates/emergency_gas.tres
msgid "{address}! A casa de muro azul!"
msgstr "{address}! The house with the blue wall!"

#: data/templates/emergency_gas.tres
msgid "Acho que não, tá tudo apagado."
msgstr "I don't think so, it's all dark."

#: data/templates/emergency_gas.tres
msgid "Não, só a gente aqui fora com o nariz ardendo."
msgstr "No, just us out here with our noses stinging."

#: data/templates/emergency_gas.tres
msgid "Tem! A dona da casa tá lá dentro e não atende!"
msgstr "Yes! The lady of the house is inside and isn't answering!"

#: data/templates/emergency_gas.tres
msgid "Tá. Ninguém vai acender nada aqui."
msgstr "Right. Nobody's going to light anything here."

#: data/templates/emergency_gas.tres
msgid "O cheiro tá chegando na rua toda!"
msgstr "The smell's reaching the whole street!"

#: data/templates/emergency_gas.tres
msgid "Os vizinhos saíram de casa?"
msgstr "Have the neighbours left their houses?"

#: data/templates/emergency_gas.tres
msgid "Quase todos. Tô batendo nas portas."
msgstr "Nearly all of them. I'm knocking on doors."

#: data/templates/emergency_gas.tres
msgid "Uma senhora da casa de trás desmaiou no portão!"
msgstr "A lady from the house behind has fainted at her gate!"

#: data/templates/emergency_gas.tres
msgid "Tá, mas tá roxinha."
msgstr "She is, but she's turning blue."

#: data/templates/emergency_gas.tres
msgid "Teve um estouro! As janelas voaram longe!"
msgstr "There's been a blast! The windows flew out!"

#: data/templates/emergency_gas.tres
msgid "A senhora não acorda, e um rapaz cortou o rosto no vidro."
msgstr "The lady won't wake up, and a young man cut his face on the glass."

#: data/templates/emergency_atropelamento.tres
msgid "Central, um carro atropelou um rapaz aqui na {street} e fugiu!"
msgstr "Central, a car's run a young man down here on {street} and driven off!"

#: data/templates/emergency_atropelamento.tres
msgid "Ele está no meio da rua?"
msgstr "Is he in the middle of the road?"

#: data/templates/emergency_atropelamento.tres
msgid "{address}! Na esquina!"
msgstr "{address}! On the corner!"

#: data/templates/emergency_atropelamento.tres
msgid "Tá, mas a perna tá toda torta."
msgstr "He is, but his leg's all twisted."

#: data/templates/emergency_atropelamento.tres
msgid "Tá! A gente tá desviando os carros com a mão."
msgstr "Yes! We're waving the cars round him."

#: data/templates/emergency_atropelamento.tres
msgid "Tá bom. A gente fica aqui com ele."
msgstr "All right. We'll stay here with him."

#: data/templates/emergency_atropelamento.tres
msgid "A perna dele tá sangrando muito!"
msgstr "His leg's bleeding a lot!"

#: data/templates/emergency_atropelamento.tres
msgid "Dá pra apertar o machucado com um pano?"
msgstr "Can you press a cloth on the wound?"

#: data/templates/emergency_atropelamento.tres
msgid "Tô apertando com a minha camisa."
msgstr "I'm pressing it with my shirt."

#: data/templates/emergency_atropelamento.tres
msgid "Ele tá fechando o olho! Tá gelado!"
msgstr "His eyes are closing! He's ice-cold!"

#: data/templates/emergency_atropelamento.tres
msgid "Ele ainda responde?"
msgstr "Is he still answering?"

#: data/templates/emergency_atropelamento.tres
msgid "Só aperta a minha mão."
msgstr "He just squeezes my hand."

#: data/templates/emergency_atropelamento.tres
msgid "Ele desmaiou... a gente esperou e ninguém veio."
msgstr "He's passed out... we waited and nobody came."

#: data/templates/emergency_atropelamento.tres
msgid "Ele respira, mas não acorda, e a camisa tá encharcada de sangue."
msgstr "He's breathing, but won't wake up, and the shirt's soaked with blood."

#: data/templates/emergency_desabamento.tres
msgid "Central, um muro desabou aqui na {street}! Caiu em cima de alguém!"
msgstr "Central, a wall's collapsed here on {street}! It fell on someone!"

#: data/templates/emergency_desabamento.tres
msgid "A pessoa está presa?"
msgstr "Is the person trapped?"

#: data/templates/emergency_desabamento.tres
msgid "Ela fala com vocês?"
msgstr "Is she talking to you?"

#: data/templates/emergency_desabamento.tres
msgid "{address}! O muro do terreno da esquina!"
msgstr "{address}! The wall of the corner lot!"

#: data/templates/emergency_desabamento.tres
msgid "Tá! As pernas tão embaixo dos tijolos!"
msgstr "Yes! Her legs are under the bricks!"

#: data/templates/emergency_desabamento.tres
msgid "Fala, mas tá chorando de dor."
msgstr "She is, but she's crying in pain."

#: data/templates/emergency_desabamento.tres
msgid "Tá. A gente não vai puxar ela."
msgstr "Right. We won't pull her out."

#: data/templates/emergency_desabamento.tres
msgid "O resto do muro tá rachando! Pode cair mais!"
msgstr "The rest of the wall's cracking! More could come down!"

#: data/templates/emergency_desabamento.tres
msgid "Tem mais alguém perto do muro?"
msgstr "Is anyone else near the wall?"

#: data/templates/emergency_desabamento.tres
msgid "O marido dela, tirando os tijolos com a mão."
msgstr "Her husband, pulling the bricks off by hand."

#: data/templates/emergency_desabamento.tres
msgid "Caiu outro pedaço! Pegou o marido dela no ombro!"
msgstr "Another piece has fallen! It caught her husband on the shoulder!"

#: data/templates/emergency_desabamento.tres
msgid "Ele consegue sair dali?"
msgstr "Can he get out of there?"

#: data/templates/emergency_desabamento.tres
msgid "Saiu, mas o braço tá pendurado."
msgstr "He got out, but his arm's hanging limp."

#: data/templates/emergency_desabamento.tres
msgid "O muro caiu todo... ninguém apareceu."
msgstr "The whole wall's come down... nobody turned up."

#: data/templates/emergency_desabamento.tres
msgid "Ela não responde mais, e o marido tá com o ombro quebrado."
msgstr "She's not answering any more, and her husband's shoulder is broken."

#: data/content.tres
msgid "{street}, perto {landmark}"
msgstr "{street}, near {landmark}"

#: data/content.tres
msgid "na frente {landmark}, na {street}"
msgstr "in front of {landmark}, on {street}"

#: data/content.tres
msgid "Central telefônica, pois não?"
msgstr "Telephone exchange, how can I help?"

#: data/content.tres
msgid "Central, boa noite. Em que posso ajudar?"
msgstr "Exchange, good evening. How can I help?"

#: data/content.tres
msgid "Central, pois não?"
msgstr "Exchange, how can I help?"

#: data/content.tres
msgid "Central."
msgstr "Exchange."

#: data/content.tres
msgid "Central telefônica, boa noite."
msgstr "Telephone exchange, good evening."

#: data/content.tres
msgid "Central de São Sotero, pois não?"
msgstr "São Sotero exchange, how can I help?"

#: data/content.tres
msgid "Desculpe incomodar, o senhor deve estar cheio de ligação."
msgstr "Sorry to bother you, you must be swamped with calls."

#: data/content.tres
msgid "Imagina, é pra isso que a central existe."
msgstr "Not at all, that's what the exchange is for."

#: data/content.tres
msgid "Ah, que bom. Eu fico sem jeito, sabe?"
msgstr "Oh, good. I always feel awkward, you know?"

#: data/content.tres
msgid "Tudo bem."
msgstr "That's fine."

#: data/content.tres
msgid "Ah... tá. Desculpe de novo."
msgstr "Oh... right. Sorry again."

#: data/content.tres
msgid "O senhor passa a noite inteira aí sozinho?"
msgstr "Do you spend the whole night there alone?"

#: data/content.tres
msgid "Eu e os cabos."
msgstr "Just me and the cords."

#: data/content.tres
msgid "Hehe, pelo menos eles não reclamam, né?"
msgstr "Heh, at least they don't complain, right?"

#: data/content.tres
msgid "Passo, sim."
msgstr "I do."

#: data/content.tres
msgid "Ah... tá. Não vou atrapalhar, então."
msgstr "Oh... right. I won't bother you, then."

#: data/content.tres
msgid "Minha mulher disse que não era pra incomodar a central a essa hora."
msgstr "My wife said not to bother the exchange at this hour."

#: data/content.tres
msgid "Não incomoda, não."
msgstr "You're no bother."

#: data/content.tres
msgid "Vou contar pra ela que o senhor disse isso."
msgstr "I'll tell her you said so."

#: data/content.tres
msgid "Ela tem razão."
msgstr "She's right."

#: data/content.tres
msgid "Ah... tá certo. Desculpe."
msgstr "Oh... fair enough. Sorry."

#: data/content.tres
msgid "Meu marido já dormiu, mas eu não consigo pegar no sono."
msgstr "My husband's already asleep, but I can't get to sleep."

#: data/content.tres
msgid "Um chá de camomila ajuda."
msgstr "Chamomile tea helps."

#: data/content.tres
msgid "Já tomei dois, moço. Nem fez cócegas."
msgstr "I've had two already. Didn't do a thing."

#: data/content.tres
msgid "Hum."
msgstr "Hm."

#: data/content.tres
msgid "Ah... tá. Eu espero aqui."
msgstr "Oh... right. I'll wait here."

#: data/content.tres
msgid "O seu Geraldo, da Rua da Matriz, fez cem anos hoje, sabia?"
msgstr "Seu Geraldo, on Rua da Matriz, turned a hundred today, did you know?"

#: data/content.tres
msgid "Cem anos! Que bênção."
msgstr "A hundred! What a blessing."

#: data/content.tres
msgid "Teve bolo na praça e banda. Ele dançou com a bisneta!"
msgstr "There was cake on the square and a band. He danced with his great-granddaughter!"

#: data/content.tres
msgid "Que bom pra ele."
msgstr "Good for him."

#: data/content.tres
msgid "...É. E lúcido, viu? Melhor que eu."
msgstr "...Yes. And sharp as a tack, too. Sharper than me."

#: data/content.tres
msgid "Essa central nunca dorme, né?"
msgstr "This exchange never sleeps, does it?"

#: data/content.tres
msgid "Nunca. Alguém tem que ficar acordado."
msgstr "Never. Someone has to stay awake."

#: data/content.tres
msgid "Ainda bem, viu? A gente se sente mais seguro."
msgstr "Good thing, too. Makes us feel safer."

#: data/content.tres
msgid "Pois é."
msgstr "Yep."

#: data/content.tres
msgid "É... bom, eu espero."
msgstr "Yeah... well, I'll wait."

#: data/content.tres
msgid "Que frio, meu Deus."
msgstr "Lord, it's cold."

#: data/content.tres
msgid "Pega um casaco."
msgstr "Put on a coat."

#: data/content.tres
msgid "Já tô com dois, moço!"
msgstr "I've got two on already!"

#: data/content.tres
msgid "Aham."
msgstr "Mm-hm."

#: data/content.tres
msgid "...Bom, deixa pra lá."
msgstr "...Well, never mind."

#: data/content.tres
msgid "Amanhã é dia de feira, né?"
msgstr "Tomorrow's market day, isn't it?"

#: data/content.tres
msgid "É sim, amanhã cedo."
msgstr "It is, first thing tomorrow."

#: data/content.tres
msgid "Vou ver se ainda tem aquele queijo da serra."
msgstr "I'll see if they still have that mountain cheese."

#: data/content.tres
msgid "Não sei."
msgstr "Don't know."

#: data/content.tres
msgid "Ah... tá. Eu vejo amanhã, então."
msgstr "Oh... right. I'll find out tomorrow, then."

#: data/content.tres
msgid "Meu relógio adiantou de novo. O senhor me diz a hora certa?"
msgstr "My watch has gone fast again. Could you tell me the right time?"

#: data/content.tres
msgid "Digo, sim. O relógio da central é o certo da cidade."
msgstr "Of course. The exchange clock is the town's correct time."

#: data/content.tres
msgid "Então eu acerto o meu pelo seu. Pronto, agora vai."
msgstr "Then I'll set mine by yours. There, that's it now."

#: data/content.tres
msgid "Leva no relojoeiro."
msgstr "Take it to the watchmaker."

#: data/content.tres
msgid "Tá, tá. Vou levar amanhã."
msgstr "All right, all right. I'll take it tomorrow."

#: data/content.tres
msgid "Desculpa ficar puxando conversa, é que eu não consigo dormir."
msgstr "Sorry to keep chatting, it's just that I can't sleep."

#: data/content.tres
msgid "Nem eu, e olha que é meu trabalho."
msgstr "Neither can I, and it's my job."

#: data/content.tres
msgid "Hehe, o senhor tem desculpa, eu não."
msgstr "Heh, you have an excuse, I don't."

#: data/content.tres
msgid "Entendi."
msgstr "I see."

#: data/content.tres
msgid "...Desculpa, tá? Eu espero."
msgstr "...Sorry, okay? I'll wait."

#: data/content.tres
msgid "Faz tempo que eu não ligo pra central."
msgstr "It's been a while since I called the exchange."

#: data/content.tres
msgid "Eu lembro da sua voz."
msgstr "I remember your voice."

#: data/content.tres
msgid "Lembra? Que memória, hein!"
msgstr "You do? What a memory!"

#: data/content.tres
msgid "Ah, é?"
msgstr "Oh, yeah?"

#: data/content.tres
msgid "É... faz tempo mesmo."
msgstr "Yeah... it's been a while."

#: data/content.tres
msgid "O padre mudou o horário da missa de domingo, viu?"
msgstr "The priest changed the time of Sunday mass, did you hear?"

#: data/content.tres
msgid "Pra que horas?"
msgstr "To what time?"

#: data/content.tres
msgid "Agora é às sete. Cedo demais pra mim."
msgstr "Seven now. Too early for me."

#: data/content.tres
msgid "Não vou à missa."
msgstr "I don't go to Mass."

#: data/content.tres
msgid "Ah... cada um com sua fé, né?"
msgstr "Oh... to each their own, right?"

#: data/content.tres
msgid "O ônibus da capital atrasou de novo hoje."
msgstr "The bus from the capital was late again today."

#: data/content.tres
msgid "De novo?"
msgstr "Again?"

#: data/content.tres
msgid "Duas horas! Minha irmã chegou morta de cansaço."
msgstr "Two hours! My sister got here dead tired."

#: data/content.tres
msgid "É sempre assim."
msgstr "It's always like that."

#: data/content.tres
msgid "É... pois é."
msgstr "Yeah... I guess so."

#: data/content.tres
msgid "Meu neto passou no vestibular, sabia?"
msgstr "My grandson got into university, did you know?"

#: data/content.tres
msgid "Que beleza! Parabéns!"
msgstr "Wonderful! Congratulations!"

#: data/content.tres
msgid "Ah, que orgulho! Vai ser o primeiro doutor da família."
msgstr "Oh, I'm so proud! He'll be the first doctor in the family."

#: data/content.tres
msgid "Hum, que bom."
msgstr "Hm, good."

#: data/content.tres
msgid "...É. Ele se esforçou, viu?"
msgstr "...Yes. He worked hard, you know."

#: data/content.tres
msgid "O preço do pão subiu de novo."
msgstr "The price of bread went up again."

#: data/content.tres
msgid "De novo? Não acredito."
msgstr "Again? I can't believe it."

#: data/content.tres
msgid "Vou ter que voltar a fazer pão em casa."
msgstr "I'll have to start baking bread at home again."

#: data/content.tres
msgid "Normal."
msgstr "That's normal."

#: data/content.tres
msgid "Normal pro senhor, né..."
msgstr "Normal for you, maybe..."

#: data/content.tres
msgid "A vizinha tá dando festa de aniversário, a música vai até tarde."
msgstr "The neighbour's having a birthday party, the music's going on till late."

#: data/content.tres
msgid "Pelo menos é festa, e não briga."
msgstr "At least it's a party and not a fight."

#: data/content.tres
msgid "Isso é! E ela ainda me mandou um prato de salgadinho."
msgstr "True! And she even sent me over a plate of snacks."

#: data/content.tres
msgid "Paciência."
msgstr "Patience."

#: data/content.tres
msgid "Paciência eu tenho. Sono é que não."
msgstr "Patience I've got. It's sleep I haven't."

#: data/content.tres
msgid "Que chuva, hein? Não parou desde a tarde."
msgstr "Some rain, huh? It hasn't stopped since this afternoon."

#: data/content.tres
msgid "Daqui eu ouço no telhado."
msgstr "I can hear it on the roof here."

#: data/content.tres
msgid "Aqui pinga até na cozinha."
msgstr "Here it's dripping in the kitchen."

#: data/content.tres
msgid "É chuva."
msgstr "It's rain."

#: data/content.tres
msgid "...É, né."
msgstr "...Sure is."

#: data/content.tres
msgid "Ouvi dizer que o rio vai encher de novo."
msgstr "I heard the river's going to flood again."

#: data/content.tres
msgid "Tomara que não."
msgstr "Let's hope not."

#: data/content.tres
msgid "Da última vez a água chegou na praça."
msgstr "Last time the water reached the square."

#: data/content.tres
msgid "Boato."
msgstr "Just a rumor."

#: data/content.tres
msgid "Tomara que seja, moço."
msgstr "Hope you're right."

#: data/content.tres
msgid "O rio subiu bastante com essa chuva."
msgstr "The river's risen quite a bit with this rain."

#: data/content.tres
msgid "Cuidado por aí."
msgstr "Be careful out there."

#: data/content.tres
msgid "Pode deixar, moço. Aqui é alto."
msgstr "Don't worry. We're up high here."

#: data/content.tres
msgid "...Bom, aqui é alto, pelo menos."
msgstr "...Well, we're up high here, at least."

#: data/content.tres
msgid "Tá caindo um toró aqui, a rua virou rio."
msgstr "It's pouring here, the street's turned into a river."

#: data/content.tres
msgid "Não sai de casa, hein."
msgstr "Don't go out, now."

#: data/content.tres
msgid "Nem pensar, moço. Daqui não saio."
msgstr "Not a chance. I'm not leaving the house."

#: data/content.tres
msgid "Aqui também."
msgstr "Here too."

#: data/content.tres
msgid "Ah... tá."
msgstr "Oh... right."

#: data/content.tres
msgid "Com essa chuva ninguém sai de casa, né?"
msgstr "Nobody's leaving the house in this rain, are they?"

#: data/content.tres
msgid "Só quem precisa."
msgstr "Only those who have to."

#: data/content.tres
msgid "É, coitado de quem tá na estrada."
msgstr "Yes, pity anyone out on the road."

#: data/content.tres
msgid "Melhor assim."
msgstr "Better that way."

#: data/content.tres
msgid "É, noite de ficar debaixo das cobertas."
msgstr "Yes, a night for staying under the covers."

#: data/content.tres
msgid "Que neblina, hein? Não dá pra ver o outro lado da rua."
msgstr "Some fog, huh? You can't see across the street."

#: data/content.tres
msgid "Daqui também não vejo nada."
msgstr "I can't see a thing from here either."

#: data/content.tres
msgid "Parece algodão na janela."
msgstr "It's like cotton on the window."

#: data/content.tres
msgid "Fique em casa hoje."
msgstr "Stay home tonight."

#: data/content.tres
msgid "Pode deixar, não ponho o pé lá fora."
msgstr "Don't worry, I won't set foot outside."

#: data/content.tres
msgid "Com essa cerração, é melhor ninguém pegar a estrada."
msgstr "In fog this thick, nobody should be out on the road."

#: data/content.tres
msgid "Verdade, é perigoso."
msgstr "True, it's dangerous."

#: data/content.tres
msgid "Meu cunhado quase errou a entrada da cidade uma vez."
msgstr "My brother-in-law nearly missed the turn into town once."

#: data/content.tres
msgid "Tomara que ninguém precise."
msgstr "Hopefully nobody has to."

#: data/content.tres
msgid "Deus queira."
msgstr "God willing."

#: data/content.tres
msgid "Parece que a cidade sumiu na névoa hoje."
msgstr "Feels like the town vanished into the fog tonight."

#: data/content.tres
msgid "Amanhã ela volta."
msgstr "It'll be back tomorrow."

#: data/content.tres
msgid "Hehe, tomara. Com a padaria e tudo."
msgstr "Heh, I hope so. Bakery and all."

#: data/content.tres
msgid "Exagero."
msgstr "You're exaggerating."

#: data/content.tres
msgid "Hehe... é, talvez."
msgstr "Heh... maybe."

#: data/content.tres
msgid "Que noite bonita, hein? Dá pra ver todas as estrelas."
msgstr "Beautiful night, huh? You can see every star."

#: data/content.tres
msgid "Tá bonita mesmo."
msgstr "It really is lovely."

#: data/content.tres
msgid "Fiquei um tempão na varanda olhando."
msgstr "I spent ages on the porch looking up."

#: data/content.tres
msgid "Daqui eu só vejo a mesa."
msgstr "All I can see from here is the switchboard."

#: data/content.tres
msgid "Ah, coitado. Depois dá uma espiada na janela."
msgstr "Oh, you poor thing. Take a peek out the window later."

#: data/content.tres
msgid "Tá uma lua bonita hoje."
msgstr "There's a lovely moon tonight."

#: data/content.tres
msgid "Lua cheia?"
msgstr "Full moon?"

#: data/content.tres
msgid "Quase. Amanhã fica redondinha."
msgstr "Almost. Tomorrow it'll be perfectly round."

#: data/content.tres
msgid "Não reparei."
msgstr "Hadn't noticed."

#: data/content.tres
msgid "Ah... depois dá uma olhada."
msgstr "Oh... take a look later."

#: data/content.tres
msgid "Noite fresquinha, né? Até dá gosto de ficar na janela."
msgstr "Nice cool night, isn't it? Makes you want to sit by the window."

#: data/content.tres
msgid "Depois do calor de ontem..."
msgstr "After yesterday's heat..."

#: data/content.tres
msgid "Nem me fale, ontem não dava nem pra dormir."
msgstr "Tell me about it, I couldn't even sleep last night."

#: data/content.tres
msgid "Aproveite."
msgstr "Enjoy it."

#: data/content.tres
msgid "Tô aproveitando, com um cafezinho."
msgstr "I am, with a little coffee."

#: data/content.tres
msgid "A novela das oito tá boa demais. O senhor tem acompanhado?"
msgstr "The eight o'clock soap is so good. Have you been following it?"

#: data/content.tres
msgid "Não perco um capítulo."
msgstr "I never miss an episode."

#: data/content.tres
msgid "Pois é! Aposto que amanhã descobrem quem é o pai da menina."
msgstr "Right! I bet tomorrow they find out who the girl's father is."

#: data/content.tres
msgid "Não tenho tempo pra novela."
msgstr "I've no time for soaps."

#: data/content.tres
msgid "Ah, é verdade, o senhor trabalha de noite..."
msgstr "Oh, of course, you work nights..."

#: data/content.tres
msgid "O time da cidade ganhou domingo, viu? Três a um."
msgstr "The town team won on Sunday, did you hear? Three-one."

#: data/content.tres
msgid "Vi no jornal! Que jogão."
msgstr "I saw it in the paper! What a match."

#: data/content.tres
msgid "O goleiro pegou um pênalti no fim. O povo invadiu o campo de alegria."
msgstr "The keeper saved a penalty at the end. People ran onto the pitch for joy."

#: data/content.tres
msgid "Não acompanho futebol."
msgstr "I don't follow football."

#: data/content.tres
msgid "Ah, então o senhor é dos poucos aqui."
msgstr "Ah, then you're one of the few around here."

#: data/content.tres
msgid "Minha filha vai casar mês que vem."
msgstr "My daughter's getting married next month."

#: data/content.tres
msgid "Que notícia boa! Parabéns."
msgstr "What good news! Congratulations."

#: data/content.tres
msgid "Obrigada! O vestido tá sendo feito aqui em casa mesmo."
msgstr "Thank you! The dress is being made right here at home."

#: data/content.tres
msgid "Parabéns."
msgstr "Congratulations."

#: data/content.tres
msgid "Obrigada... É, tem muita coisa pra arrumar ainda."
msgstr "Thanks... Yes, there's still a lot to sort out."

#: data/content.tres
msgid "O circo chegou na cidade. O senhor viu o cartaz?"
msgstr "The circus has come to town. Have you seen the poster?"

#: data/content.tres
msgid "Vi! Tem até elefante, é verdade?"
msgstr "I did! Is it true there's even an elephant?"

#: data/content.tres
msgid "Tem um só, velhinho, coitado. Mas as crianças tão encantadas."
msgstr "Just the one, poor old thing. But the children are enchanted."

#: data/content.tres
msgid "Não vi, não."
msgstr "No, I haven't."

#: data/content.tres
msgid "É lá no campo perto da estação. Tá uma festa."
msgstr "It's out on the field by the station. It's quite the party."

#: data/content.tres
msgid "Meu marido tá de plantão no hospital, por isso eu fico acordada até tarde."
msgstr "My husband's on the night shift at the hospital, so I stay up late."

#: data/content.tres
msgid "Deve ser puxado pra vocês dois."
msgstr "That must be hard on you both."

#: data/content.tres
msgid "É, mas a gente se acostuma. Ele chega de manhã com o pão."
msgstr "It is, but you get used to it. He comes home in the morning with the bread."

#: data/content.tres
msgid "Entendo."
msgstr "I see."

#: data/content.tres
msgid "Pois é... a casa fica quieta demais."
msgstr "Yes... the house gets far too quiet."

#: data/content.tres
msgid "Tô com um bolo de fubá no forno enquanto espero."
msgstr "I've got a cornmeal cake in the oven while I wait."

#: data/content.tres
msgid "Que delícia. Deu até fome aqui."
msgstr "Lovely. Now I'm hungry."

#: data/content.tres
msgid "Se desse, eu mandava um pedaço pela linha!"
msgstr "If I could, I'd send you a slice down the line!"

#: data/content.tres
msgid "Tá quase pronto... o cheiro já tomou a casa toda."
msgstr "It's nearly done... the smell's filled the whole house."

#: data/content.tres
msgid "Chegou carta do meu irmão hoje, depois de dois anos. Tô tão contente que precisava contar pra alguém."
msgstr "A letter came from my brother today, after two years. I'm so happy I just had to tell someone."

#: data/content.tres
msgid "Que bom! E ele está bem?"
msgstr "How lovely! And is he well?"

#: data/content.tres
msgid "Tá ótimo! E diz que vem pro Natal."
msgstr "He's doing great! And he says he's coming for Christmas."

#: data/content.tres
msgid "Que bom."
msgstr "Good."

#: data/content.tres
msgid "É... ele escreve pouco, mas escreve."
msgstr "Yes... he doesn't write much, but he writes."

#: data/content.tres
msgid "Acabei de chegar da novena. A igreja tava cheia."
msgstr "I've just got back from the novena. The church was packed."

#: data/content.tres
msgid "Que bom. Essa cidade tem muita fé."
msgstr "How nice. This town has a lot of faith."

#: data/content.tres
msgid "Tem! O padre Anselmo até pediu mais bancos pra prefeitura."
msgstr "It does! Father Anselmo has even asked the town hall for more pews."

#: data/content.tres
msgid "Tava bonita, mas comprida que só."
msgstr "It was lovely, but ever so long."

#: data/content.tres
msgid "Amanhã cedo eu levo minha mãe no médico, na capital. Nem sei se vou conseguir dormir."
msgstr "Early tomorrow I'm taking my mother to the doctor in the capital. I don't know if I'll manage to sleep."

#: data/content.tres
msgid "Vai dar tudo certo."
msgstr "It'll all be fine."

#: data/content.tres
msgid "Deus queira. É só exame, mas ela tá nervosa, e eu mais ainda."
msgstr "God willing. It's just tests, but she's nervous, and I'm even more so."

#: data/content.tres
msgid "Boa viagem."
msgstr "Have a good trip."

#: data/content.tres
msgid "Obrigada. A estrada é longa, mas a gente vai."
msgstr "Thank you. It's a long road, but we'll get there."

#: data/content.tres
msgid "A prefeitura prometeu calçar a minha rua de novo."
msgstr "The town hall has promised to pave my street again."

#: data/content.tres
msgid "Quem sabe dessa vez sai."
msgstr "Maybe this time it'll happen."

#: data/content.tres
msgid "Deus te ouça! Toda eleição é a mesma promessa."
msgstr "God willing! It's the same promise every election."

#: data/content.tres
msgid "Promessa é promessa."
msgstr "A promise is a promise."

#: data/content.tres
msgid "Pois é, e buraco é buraco."
msgstr "Right, and a pothole is a pothole."

#: data/content.tres
msgid "Tô fazendo crochê enquanto espero. Aprendi com a minha vizinha."
msgstr "I'm crocheting while I wait. My neighbour taught me."

#: data/content.tres
msgid "Que bonito! Já fez alguma peça?"
msgstr "How nice! Have you made anything yet?"

#: data/content.tres
msgid "Um paninho de bandeja. Torto, mas é meu."
msgstr "A little tray cloth. Wonky, but it's mine."

#: data/content.tres
msgid "É um passatempo. A noite fica mais curta."
msgstr "It passes the time. Makes the night shorter."

#: data/content.tres
msgid "O senhor sabe se a farmácia de plantão hoje é a Santa Rita?"
msgstr "Do you know if the Santa Rita is the pharmacy on duty tonight?"

#: data/content.tres
msgid "É a Santa Rita, sim, na Rua do Mercado."
msgstr "Yes, it's the Santa Rita, on Rua do Mercado."

#: data/content.tres
msgid "Ah, bom saber. Vai que alguém precisa de noite."
msgstr "Ah, good to know. In case someone needs it in the night."

#: data/content.tres
msgid "Não sei dizer."
msgstr "I couldn't say."

#: data/content.tres
msgid "Tudo bem, amanhã eu pergunto lá."
msgstr "That's all right, I'll ask there tomorrow."

#: data/content.tres
msgid "O Cine Odeon vai passar filme novo no sábado."
msgstr "The Cine Odeon's showing a new film on Saturday."

#: data/content.tres
msgid "Qual filme?"
msgstr "Which film?"

#: data/content.tres
msgid "Um de faroeste, com tiroteio e tudo. Já separei o dinheiro."
msgstr "A western, shoot-out and all. I've already put the money aside."

#: data/content.tres
msgid "Não vou muito ao cinema."
msgstr "I don't go to the cinema much."

#: data/content.tres
msgid "Pois devia! Trocaram as cadeiras, tá uma beleza."
msgstr "You should! They've put in new seats, it's lovely."

#: data/content.tres
msgid "Vai indo, moço."
msgstr "Getting by."

#: data/content.tres
msgid "Ah, vai bem, graças a Deus."
msgstr "Oh, it's going fine, thank God."

#: data/content.tres
msgid "Tranquila, tranquila."
msgstr "Quiet, quiet."

#: data/content.tres
msgid "Ih, devagar..."
msgstr "Oh, slow..."

#: data/content.tres
msgid "Vai indo, do jeito que dá."
msgstr "Getting by, as best I can."

#: data/content.tres
msgid "Ah, aqui tá tudo calmo."
msgstr "Oh, it's all calm here."

#: data/content.tres
msgid "Ainda está aí?"
msgstr "Are you still there?"

#: data/content.tres
msgid "Alô? Conseguiu?"
msgstr "Hello? Any luck?"

#: data/content.tres
msgid "Moço? A ligação caiu?"
msgstr "Young man? Did the call drop?"

#: data/content.tres
msgid "Alô? Tô esperando..."
msgstr "Hello? I'm waiting..."

#: data/content.tres
msgid "Demora muito?"
msgstr "Is it going to take long?"

#: data/content.tres
msgid "Central? Tá me ouvindo?"
msgstr "Operator? Can you hear me?"

#: data/content.tres
msgid "Ainda tô aqui, viu?"
msgstr "I'm still here, you know."

#: data/content.tres
msgid "Alô? Caiu?"
msgstr "Hello? Did it drop?"

#: data/content.tres
msgid "Alô?! Vocês vão mandar alguém?"
msgstr "Hello?! Are you sending someone?"

#: data/content.tres
msgid "Por favor, rápido!"
msgstr "Please, hurry!"

#: data/content.tres
msgid "Central?!"
msgstr "Operator?!"

#: data/content.tres
msgid "Alô! Tá demorando!"
msgstr "Hello! It's taking too long!"

#: data/content.tres
msgid "Central, ainda tá aí?"
msgstr "Operator, are you still there?"

#: data/content.tres
msgid "Manda alguém, pelo amor de Deus!"
msgstr "Send someone, for God's sake!"

#: data/content.tres
msgid "Tá bom, eu espero."
msgstr "All right, I'll wait."

#: data/content.tres
msgid "Obrigado, aguardo."
msgstr "Thanks, I'll hold."

#: data/content.tres
msgid "Certo."
msgstr "Okay."

#: data/content.tres
msgid "Pode ser, eu fico na linha."
msgstr "Sure, I'll stay on the line."

#: data/content.tres
msgid "Tá, mas rapidinho, tá?"
msgstr "Okay, but make it quick, okay?"

#: data/content.tres
msgid "Tá, fico esperando."
msgstr "Okay, I'll be waiting."

#: data/content.tres
msgid "Sem pressa, moço."
msgstr "No rush, young man."

#: data/content.tres
msgid "Tá bem, obrigada."
msgstr "All right, thank you."

#: data/content.tres
msgid "Pode ser. Obrigado."
msgstr "That's fine. Thank you."

#: data/content.tres
msgid "Serve, sim. Pode ligar."
msgstr "That'll do. Go ahead and call."

#: data/content.tres
msgid "Tanto faz, contanto que atendam."
msgstr "Doesn't matter, as long as someone answers."

#: data/content.tres
msgid "Ah, pode ser essa mesmo."
msgstr "Oh, that one's fine."

#: data/content.tres
msgid "Não, moço, não é aí."
msgstr "No, young man, that's not it."

#: data/content.tres
msgid "Hã? Não é com essa pessoa que eu quero falar."
msgstr "Huh? That's not who I want to talk to."

#: data/content.tres
msgid "Esse não é quem eu pedi!"
msgstr "That's not who I asked for!"

#: data/content.tres
msgid "Opa, acho que o senhor ligou errado."
msgstr "Oops, I think you put me through to the wrong place."

#: data/content.tres
msgid "Ih, quem atendeu não foi quem eu pedi."
msgstr "Uh-oh, whoever answered isn't who I asked for."

#: data/content.tres
msgid "Moço, essa voz eu não conheço."
msgstr "Young man, I don't know that voice."

#: data/content.tres
msgid "Não é esse número, não."
msgstr "That's not the right number."

#: data/content.tres
msgid "Interurbano, boa noite."
msgstr "Long distance, good evening."

#: data/content.tres
msgid "Telefonista, pois não?"
msgstr "Operator, how may I help?"

#: data/content.tres
msgid "Interurbano. Qual o número?"
msgstr "Long distance. What number?"

#: data/content.tres
msgid "Um momento, vou chamar."
msgstr "One moment, I'll ring it."

#: data/content.tres
msgid "Aguarde, estou completando."
msgstr "Hold on, I'm putting it through."

#: data/content.tres
msgid "Só um instante, já chamo."
msgstr "Just a moment, ringing now."

#: data/content.tres
msgid "Esse número não é daqui, não."
msgstr "That number isn't from here."

#: data/content.tres
msgid "Não tenho esse número aqui. Confere a cidade?"
msgstr "I don't have that number here. Can you check the city?"

#: data/content.tres
msgid "Aqui não existe esse número, colega."
msgstr "There's no such number here, colleague."

#: data/content.tres
msgid "Liguei agora há pouco e ninguém atendeu!"
msgstr "I called a little while ago and nobody answered!"

#: data/content.tres
msgid "Central? Até que enfim! Já liguei antes."
msgstr "Operator? Finally! I called earlier."

#: data/content.tres
msgid "Tô tentando faz tempo. Ninguém atende essa central?"
msgstr "I've been trying for ages. Doesn't anyone answer at this exchange?"

#: data/content.tres
msgid "O número que o senhor me deu não era o certo."
msgstr "The number you gave me wasn't the right one."

#: data/content.tres
msgid "Liguei pro número que o senhor passou e era de outra pessoa!"
msgstr "I called the number you gave me and it was someone else's!"

#: data/content.tres
msgid "Central, a informação que o senhor me deu tava errada."
msgstr "Operator, the information you gave me was wrong."

#: data/content.tres
msgid "Central, vocês me ligaram pro número errado! Agora me passa pro certo, por favor."
msgstr "Operator, you put me through to the wrong number! Now put me through to the right one, please."

#: data/content.tres
msgid "Liguei antes e fui parar no lugar errado! Vamos tentar de novo."
msgstr "I called before and ended up at the wrong place! Let's try again."

#: data/content.tres
msgid "Me conectaram com uma pessoa nada a ver! Quero o número certo desta vez."
msgstr "You connected me to some random person! I want the right number this time."

#: data/content.tres
msgid "Central! Ninguém apareceu aqui e tá ficando pior!"
msgstr "Operator! Nobody showed up here and it's getting worse!"

#: data/content.tres
msgid "Liguei mais cedo e ninguém veio! Tá piorando!"
msgstr "I called earlier and nobody came! It's getting worse!"

#: data/content.tres
msgid "Pelo amor de Deus, cadê o socorro? Piorou!"
msgstr "For God's sake, where's the help? It got worse!"

#: data/content.tres
msgid "Liguei mais cedo. Ninguém veio. Agora não adianta mais."
msgstr "I called earlier. Nobody came. It's no use now."

#: data/content.tres
msgid "Não precisa mandar mais ninguém. Já era."
msgstr "No need to send anyone now. It's over."

#: data/content.tres
msgid "Vocês demoraram demais. Eu só queria que soubessem."
msgstr "You took too long. I just wanted you to know."

#: data/content.tres
msgid "Alô? Quem é, a essa hora?"
msgstr "Hello? Who is this, at this hour?"

#: data/content.tres
msgid "Hã? Isso é hora de ligar pros outros?"
msgstr "Huh? Is this any time to call people?"

#: data/content.tres
msgid "Quem tá ligando? Aqui tá todo mundo dormindo!"
msgstr "Who's calling? Everyone here is asleep!"

#: data/content.tres
msgid "Alô?! Isso é hora?"
msgstr "Hello?! Do you know what time it is?"

#: data/content.tres
msgid "Quer saber? Esquece. Eu ligo amanhã."
msgstr "You know what? Forget it. I'll call tomorrow."

#: data/content.tres
msgid "Errou de novo? Deixa pra lá."
msgstr "Wrong again? Never mind."

#: data/content.tres
msgid "Não, chega. Boa noite."
msgstr "No, that's enough. Good night."

#: data/content.tres
msgid "Peraí... Alô? Tem alguém na linha?"
msgstr "Hang on... Hello? Is someone on the line?"

#: data/content.tres
msgid "Você ouviu esse estalo? Parece que tem gente ouvindo."
msgstr "Did you hear that click? Sounds like someone's listening."

#: data/content.tres
msgid "Psiu. Tem alguém escutando a gente?"
msgstr "Shh. Is somebody listening to us?"

#: data/content.tres
msgid "Tem gente ouvindo, sim! Amanhã eu reclamo na companhia."
msgstr "Someone's listening, all right! I'm complaining to the phone company tomorrow."

#: data/content.tres
msgid "Isso é um abuso! Vou denunciar essa telefonista."
msgstr "This is an outrage! I'm reporting that operator."

#: data/content.tres
msgid "Desliga, desliga. Amanhã eu vou lá na companhia reclamar."
msgstr "Hang up, hang up. Tomorrow I'm going down to the phone company to complain."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega a tempo."
msgstr "{occurrence} on {address}: help arrives in time."

#: data/content.tres
msgid "{occurrence} na {address}: equipe controla a situação."
msgstr "{occurrence} on {address}: crew gets the situation under control."

#: data/content.tres
msgid "{occurrence} na {address}: socorro chega com atraso."
msgstr "{occurrence} on {address}: help arrives late."

#: data/content.tres
msgid "{occurrence} na {address}: moradores reclamam da demora."
msgstr "{occurrence} on {address}: residents complain about the delay."

#: data/content.tres
msgid "{occurrence} na {address}: ninguém foi atender."
msgstr "{occurrence} on {address}: nobody came to help."

#: data/content.tres
msgid "{occurrence} na {address}: vizinhos esperaram a noite toda por socorro."
msgstr "{occurrence} on {address}: neighbors waited all night for help."

#: data/content.tres
msgid "Turno sem problemas. Bom trabalho."
msgstr "A shift without problems. Good work."

#: data/content.tres
msgid "Atenção aos detalhes. Os moradores contam com a central."
msgstr "Pay attention to details. The townspeople count on the exchange."

#: data/content.tres
msgid "Turno inaceitável. Isso vai para a sua ficha."
msgstr "Unacceptable shift. This is going on your record."

#: data/content.tres
msgid "Boa noite. Pode me dar o número %s?"
msgstr "Good evening. Could you give me the number %s?"

#: data/content.tres
msgid "Central, o senhor sabe o número %s?"
msgstr "Operator, do you know the number %s?"

#: data/content.tres
msgid "Queria só o número %s, pra anotar aqui."
msgstr "I just wanted the number %s, to write it down."

#: data/content.tres
msgid "Perdi a caderneta. Qual é o número %s?"
msgstr "I lost my address book. What's the number %s?"

#: data/content.tres
msgid "Central, me passa o número %s, por favor?"
msgstr "Operator, could you give me the number %s, please?"

#: data/content.tres
msgid "Boa noite. Qual é o telefone %s?"
msgstr "Good evening. What's the phone number %s?"

#: data/content.tres
msgid "O senhor tem aí o número %s?"
msgstr "Do you have the number %s there?"

#: data/content.tres
msgid "Anotado. Obrigada, boa noite."
msgstr "Got it. Thank you, good night."

#: data/content.tres
msgid "Ah, tá certo. Obrigado."
msgstr "Ah, right. Thank you."

#: data/content.tres
msgid "Muito obrigada. Boa noite."
msgstr "Thank you so much. Good night."

#: data/content.tres
msgid "Brigado, moço."
msgstr "Thanks, young man."

#: data/content.tres
msgid "Tá anotado. Boa noite."
msgstr "Written down. Good night."

#: data/content.tres
msgid "Hum. Tem certeza? Bom... obrigado."
msgstr "Hm. Are you sure? Well... thanks."

#: data/content.tres
msgid "Isso tudo? Tá bom, obrigado."
msgstr "That's all? Okay, thanks."

#: data/content.tres
msgid "Vou tentar esse então."
msgstr "I'll try that one, then."

#: data/content.tres
msgid "Será? Bom, vou tentar."
msgstr "Really? Well, I'll try."

#: data/content.tres
msgid "Hum... tá bom, então."
msgstr "Hm... okay, then."

