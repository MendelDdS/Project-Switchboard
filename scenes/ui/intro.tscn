[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/intro.gd" id="1_intro"]
[ext_resource type="Script" path="res://scripts/ui/bevel.gd" id="2_bevel"]
[ext_resource type="FontFile" path="res://fonts/VT323-Regular.ttf" id="3_vt323_regula"]

[node name="Intro" type="ColorRect"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01961, 0.02353, 0.02745, 0.92)
script = ExtResource("1_intro")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
layout_mode = 1

[node name="Card" type="MarginContainer" parent="Center"]
custom_minimum_size = Vector2(560, 420)
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 30
script = ExtResource("2_bevel")

[node name="VBox" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Card/VBox"]
layout_mode = 2
text = "Central de Vila Serena"
theme_override_font_sizes/font_size = 30

[node name="Date" type="Label" parent="Center/Card/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Terça-feira · 18:00"
theme_override_fonts/font = ExtResource("3_vt323_regula")
theme_override_colors/font_color = Color(0.9529, 0.6588, 0.2353, 1)
theme_override_font_sizes/font_size = 24

[node name="Note" type="PanelContainer" parent="Center/Card/VBox"]
layout_mode = 2
theme_type_variation = &"NotePanel"

[node name="Text" type="Label" parent="Center/Card/VBox/Note"]
unique_name_in_owner = true
layout_mode = 2
text = "Seu turno termina à meia-noite. Atenda as chamadas, conecte-as corretamente e registre todas as ocorrências."
theme_type_variation = &"InkMonoLabel"
theme_override_font_sizes/font_size = 24
autowrap_mode = 3
custom_minimum_size = Vector2(448, 0)

[node name="Info" type="Label" parent="Center/Card/VBox"]
layout_mode = 2
text = "Tudo acontece na sua mesa. Use o mouse para levar os plugues até as tomadas e para consultar a lista, o mapa e o caderno. Mais de uma linha pode tocar ao mesmo tempo. Use fones de ouvido."
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(480, 0)

[node name="Gap" type="Control" parent="Center/Card/VBox"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Center/Card/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Start" type="Button" parent="Center/Card/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 44)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"AmberButton"
theme_override_font_sizes/font_size = 17
text = "Começar turno"

[node name="Reset" type="Button" parent="Center/Card/VBox/Buttons"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"DarkButton"
text = "Recomeçar da primeira noite"
