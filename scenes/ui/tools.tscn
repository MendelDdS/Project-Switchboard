[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tools.gd" id="1_tools"]
[ext_resource type="PackedScene" path="res://scenes/ui/phone_book.tscn" id="2_phone_book"]
[ext_resource type="PackedScene" path="res://scenes/ui/dispatch.tscn" id="4_dispatch"]
[ext_resource type="PackedScene" path="res://scenes/ui/notebook.tscn" id="5_notebook"]
[ext_resource type="Script" path="res://scripts/ui/call_log.gd" id="6_call_log"]
[ext_resource type="Script" path="res://scripts/ui/news_view.gd" id="7_news"]
[ext_resource type="Script" path="res://scripts/ui/paper_deco.gd" id="8_deco"]
[ext_resource type="PackedScene" path="res://scenes/ui/toll.tscn" id="9_toll"]

[node name="Tools" type="VBoxContainer"]
custom_minimum_size = Vector2(620, 0)
mouse_filter = 2
theme_override_constants/separation = 0
script = ExtResource("1_tools")

[node name="Body" type="Control" parent="."]
unique_name_in_owner = true
clip_contents = true
custom_minimum_size = Vector2(0, 460)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Paper" type="PanelContainer" parent="Body"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"PaperPanel"

[node name="Margin" type="MarginContainer" parent="Body/Paper"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 18

[node name="PhoneBook" parent="Body/Paper/Margin" instance=ExtResource("2_phone_book")]
unique_name_in_owner = true
layout_mode = 2

[node name="Dispatch" parent="Body/Paper/Margin" instance=ExtResource("4_dispatch")]
unique_name_in_owner = true
layout_mode = 2

[node name="Notebook" parent="Body/Paper/Margin" instance=ExtResource("5_notebook")]
unique_name_in_owner = true
layout_mode = 2

[node name="CallLog" type="RichTextLabel" parent="Body/Paper/Margin"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true
scroll_following = true
theme_override_colors/default_color = Color(0.1647, 0.1373, 0.098, 1)
theme_override_font_sizes/normal_font_size = 11
theme_override_constants/line_separation = 3
script = ExtResource("6_call_log")

[node name="Toll" parent="Body/Paper/Margin" instance=ExtResource("9_toll")]
unique_name_in_owner = true
layout_mode = 2

[node name="News" type="VBoxContainer" parent="Body/Paper/Margin"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6
script = ExtResource("7_news")

[node name="Masthead" type="Label" parent="Body/Paper/Margin/News"]
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 44
text = "NEWS_MASTHEAD"
horizontal_alignment = 1

[node name="Edition" type="Label" parent="Body/Paper/Margin/News"]
layout_mode = 2
theme_type_variation = &"InkSoftLabel"
theme_override_font_sizes/font_size = 11
horizontal_alignment = 1
auto_translate_mode = 2

[node name="Rule" type="Control" parent="Body/Paper/Margin/News"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="Page" type="HBoxContainer" parent="Body/Paper/Margin/News"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Text" type="VBoxContainer" parent="Body/Paper/Margin/News/Page"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Headlines" type="RichTextLabel" parent="Body/Paper/Margin/News/Page/Text"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
theme_override_colors/default_color = Color(0.1647, 0.1373, 0.098, 1)
theme_override_font_sizes/normal_font_size = 11
theme_override_constants/line_separation = 3

[node name="Columns" type="Control" parent="Body/Paper/Margin/News/Page/Text"]
layout_mode = 2
size_flags_vertical = 3

[node name="Photo" type="Control" parent="Body/Paper/Margin/News/Page"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="Deco" type="Control" parent="Body/Paper"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
script = ExtResource("8_deco")
